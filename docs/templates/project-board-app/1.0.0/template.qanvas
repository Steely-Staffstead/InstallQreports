        {
          "id": "start-app",
          "kind": "app",
          "title": "Get started",
          "x": 24,
          "y": 64,
          "width": 720,
          "height": 640,
          "sourceId": "main",
          "showHeader": false,
          "background": "#ffffff",
          "borderColor": "#d5dce8",
          "borderThickness": 1,
          "rounding": 4,
          "filters": [],
          "app": {
            "appId": "project-board-start-app",
