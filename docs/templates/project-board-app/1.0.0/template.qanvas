          "htmlDocument": "<!doctype html><html><head><meta charset=\"utf-8\"><style>html,body{margin:0;background:transparent;color:#1d2939;font:14px/1.3 Segoe UI,system-ui,sans-serif}h1{margin:0;font-size:22px}p{margin:2px 0 0;color:#5d6b82}</style></head><body><h1>Project plan</h1><p>Plan tasks, owners and dates. The Kanban board and report use the same tasks.</p></body></html>"
        },
        {
          "id": "project-gantt",
          "kind": "gantt",
          "title": "Project plan",
          "x": 24,
          "y": 64,
          "width": 1232,
          "height": 640,
          "sourceId": "main",
          "showHeader": false,
          "background": "#ffffff",
          "borderColor": "#d5dce8",
          "borderThickness": 1,
          "filters": [],
          "design": {
            "ganttSpec": {
              "task": "Task",
              "id": "Task ID",
              "start": "Start",
              "end": "End",
              "group": "Project / Group",
              "owner": "Owner",
              "tags": "Tags",
              "progress": "Progress",
              "plannedHours": "Planned hours",
              "registeredHours": "Hours used",
              "status": "Status",
              "priority": "Priority",
              "description": "Description",
              "milestone": "Milestone",
              "dependsOn": "Depends on",
              "defaultStatus": "Open",
              "defaultPriority": "Normal",
              "dataStorage": "embedded",
              "editable": true,
              "publishAsSource": true,
              "publishedSourceName": "Project tasks",
              "publishedSourceId": "gantt:project-gantt",
              "groupByGroup": true,
              "ownerListMode": true,
              "statusListMode": true,
              "groupListMode": true,
              "autoStatusFromProgress": true,
              "useThemeColors": true,
              "ownerOptions": [
                {
                  "value": "Anna Berg",
                  "label": "Anna Berg",
                  "badge": true,
                  "colorMode": "theme",
                  "themeRole": "color1",
                  "color": "#4f6ee8"
                },
                {
                  "value": "Jonas Lie",
                  "label": "Jonas Lie",
                  "badge": true,
                  "colorMode": "theme",
                  "themeRole": "color2",
                  "color": "#4f6ee8"
                },
                {
                  "value": "Sara Holm",
                  "label": "Sara Holm",
                  "badge": true,
                  "colorMode": "theme",
                  "themeRole": "color3",
                  "color": "#4f6ee8"
                },
                {
                  "value": "Ola Nygård",
                  "label": "Ola Nygård",
