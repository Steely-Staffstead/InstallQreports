{"apps":[{"assets":[],"bindings":[],"currentSpec":"Forenklet anbudsoppfølging basert på anbudsprosessen i reportportal. Anbudsliste med søk og filter på status/selskap, skjema for å registrere og endre anbud (ID A-ÅÅ-nnn tildeles automatisk), sannsynlighet fra status med mulighet for overstyring, vektet verdi og estimert DB, tapt-årsak og avgjort dato. Enkel rapport (per status, per forventet beslutningskvartal, per selskap, tapsårsaker) og register for selskaper. Datofelt har egen kalender (dd.mm.åååå), og avgjort dato settes til i dag ved Vunnet/Tapt. Opsjoner-arket lagrer standard selskap, ansvarlig, prosjekttype og kontraktstype, og om feltet Entreprenør skal vises. Data lagres i embedded tabellene anbud, anbud_status, anbud_selskap og anbud_innstillinger.","designHistory":[],"entry":"index.html","files":[{"content":"<!doctype html>\n<html lang=\"nb\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <main id=\"app\"></main>\n  <script src=\"app.js\"></script>\n</body>\n</html>","path":"index.html","type":"text/html"},{"content":":root {\n  --surface: #142a3b;\n  --text: #e9f2ff;\n  --accent: #69b8ff;\n  --on-accent: #0c1a29;\n  --grid: #365367;\n  --positive: #63d9b0;\n  --negative: #ff8b91;\n  --warn: #f7c978;\n  --muted: color-mix(in srgb, var(--text) 62%, transparent);\n  --soft: color-mix(in srgb, var(--text) 6%, transparent);\n  --field-bg: color-mix(in srgb, var(--surface) 85%, #000);\n  font-family: 'Segoe UI', system-ui, sans-serif;\n  font-size: 13px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  margin: 0;\n  height: 100%;\n  background: var(--surface);\n  color: var(--text);\n}\n\n#app {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  padding: 14px 16px;\n  gap: 12px;\n  overflow: hidden;\n}\n\n/* Topp og faner */\n\n.top {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n\n.brand h1 {\n  margin: 0;\n  font-size: 20px;\n}\n\n.brand span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.tabs {\n  display: flex;\n  gap: 4px;\n  margin-left: 12px;\n  flex: 1;\n}\n\n.tab {\n  background: transparent;\n  border: 1px solid transparent;\n  color: var(--muted);\n}\n\n.tab:hover {\n  color: var(--text);\n  background: var(--soft);\n}\n\n.tab.active {\n  color: var(--text);\n  border-color: var(--grid);\n  background: var(--soft);\n  font-weight: 600;\n}\n\nbutton {\n  font: inherit;\n  cursor: pointer;\n  border-radius: 4px;\n  padding: 7px 14px;\n  border: 1px solid var(--grid);\n}\n\nbutton:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.primary {\n  background: var(--accent);\n  color: var(--on-accent);\n  border-color: var(--accent);\n  font-weight: 600;\n}\n\n.secondary {\n  background: transparent;\n  color: var(--text);\n}\n\n.danger {\n  background: transparent;\n  color: var(--negative);\n  border-color: var(--negative);\n}\n\n.icon {\n  background: transparent;\n  border: none;\n  color: var(--muted);\n  font-size: 22px;\n  line-height: 1;\n  padding: 2px 8px;\n}\n\n/* Nøkkeltall */\n\n.kpis {\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.kpi {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  padding: 10px 12px;\n  border: 1px solid var(--grid);\n  border-radius: 4px;\n  background: var(--soft);\n}\n\n.kpi-label {\n  color: var(--muted);\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.kpi strong {\n  font-size: 20px;\n}\n\n.kpi-note {\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.msg {\n  padding: 8px 12px;\n  border-radius: 4px;\n  border: 1px solid var(--grid);\n}\n\n.msg-ok {\n  border-color: var(--positive);\n  color: var(--positive);\n}\n\n.msg-warn {\n  border-color: var(--warn);\n  color: var(--warn);\n}\n\n.msg-error {\n  border-color: var(--negative);\n  color: var(--negative);\n}\n\n/* Liste */\n\n.body {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  overflow: auto;\n}\n\n.toolbar {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\ninput,\nselect,\ntextarea {\n  font: inherit;\n  color: var(--text);\n  background: var(--field-bg);\n  border: 1px solid var(--grid);\n  border-radius: 4px;\n  padding: 6px 8px;\n}\n\ninput:focus,\nselect:focus,\ntextarea:focus,\nbutton:focus-visible,\ntr:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 1px;\n}\n\n#search {\n  flex: 1;\n  max-width: 420px;\n}\n\n.count,\n.hint {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.spacer {\n  flex: 1;\n}\n\n.table-wrap {\n  flex: 1;\n  min-height: 0;\n  overflow: auto;\n  border: 1px solid var(--grid);\n  border-radius: 4px;\n}\n\n.grid {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.grid th {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  padding: 8px 10px;\n  text-align: left;\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--muted);\n  background: var(--field-bg);\n  border-bottom: 1px solid var(--grid);\n}\n\n.grid td {\n  padding: 7px 10px;\n  vertical-align: top;\n  border-bottom: 1px solid color-mix(in srgb, var(--grid) 55%, transparent);\n}\n\n.grid tbody tr[data-action] {\n  cursor: pointer;\n}\n\n.grid tbody tr[data-action]:hover {\n  background: var(--soft);\n}\n\n.num {\n  text-align: right !important;\n  white-space: nowrap;\n}\n\n.mono {\n  font-family: Consolas, monospace;\n  font-size: 12px;\n  white-space: nowrap;\n}\n\n.muted-line {\n  display: block;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.empty {\n  color: var(--muted);\n  text-align: center;\n  padding: 24px;\n}\n\n.override {\n  color: var(--warn);\n}\n\n.badge {\n  display: inline-block;\n  padding: 2px 8px;\n  border: 1px solid currentColor;\n  border-radius: 999px;\n  font-size: 11px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n\n.badge-active {\n  color: var(--accent);\n}\n\n.badge-won {\n  color: var(--positive);\n}\n\n.badge-lost {\n  color: var(--negative);\n}\n\n.badge-idle {\n  color: var(--muted);\n}\n\n/* Skjema */\n\n.overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  background: rgba(0, 0, 0, 0.45);\n}\n\n.dialog {\n  width: min(860px, 100%);\n  max-height: 100%;\n  display: flex;\n  flex-direction: column;\n  background: var(--surface);\n  color: var(--text);\n  border: 1px solid var(--grid);\n  border-radius: 6px;\n  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.4);\n}\n\n.dialog-small {\n  width: min(520px, 100%);\n}\n\n.dialog-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  padding: 14px 18px 8px;\n  border-bottom: 1px solid var(--grid);\n}\n\n.dialog-head h2 {\n  margin: 2px 0 0;\n  font-size: 17px;\n}\n\n.kicker {\n  color: var(--muted);\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.dialog-body {\n  flex: 1;\n  min-height: 0;\n  overflow: auto;\n  padding: 12px 18px;\n}\n\n.dialog-foot {\n  display: flex;\n  gap: 8px;\n  padding: 10px 18px 14px;\n  border-top: 1px solid var(--grid);\n}\n\nfieldset {\n  border: none;\n  margin: 0 0 12px;\n  padding: 0;\n}\n\nlegend {\n  margin-bottom: 6px;\n  color: var(--accent);\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 10px 12px;\n}\n\n.dialog-small .form-grid {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: 12px;\n  color: var(--muted);\n}\n\n.span-2 {\n  grid-column: span 2;\n}\n\n.hidden {\n  display: none !important;\n}\n\ntextarea {\n  width: 100%;\n  resize: vertical;\n}\n\n.derived {\n  grid-column: span 2;\n  display: flex;\n  gap: 12px;\n  align-items: flex-end;\n}\n\n.derived div {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 160px;\n  padding: 6px 10px;\n  border-radius: 4px;\n  background: var(--soft);\n}\n\n.derived span {\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.form-error {\n  min-height: 1em;\n  margin: 4px 0 0;\n  color: var(--negative);\n}\n\n/* Rapport */\n\n.report {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.panel {\n  min-width: 0;\n  padding: 12px 14px;\n  border: 1px solid var(--grid);\n  border-radius: 4px;\n  background: var(--soft);\n}\n\n.panel h3 {\n  margin: 0 0 10px;\n  font-size: 13px;\n}\n\n.bars {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n}\n\n.bar-row {\n  display: grid;\n  grid-template-columns: 110px 1fr 190px;\n  gap: 8px;\n  align-items: center;\n  font-size: 12px;\n}\n\n.bar-track {\n  position: relative;\n  height: 12px;\n  overflow: hidden;\n  border-radius: 3px;\n  background: color-mix(in srgb, var(--grid) 45%, transparent);\n}\n\n.bar-fill {\n  position: absolute;\n  left: 0;\n  top: 0;\n  bottom: 0;\n  border-radius: 3px;\n}\n\n.bar-inner {\n  position: absolute;\n  left: 0;\n  top: 4px;\n  bottom: 4px;\n  border-radius: 2px;\n  background: var(--text);\n  opacity: 0.55;\n}\n\n.tone-active {\n  background: var(--accent);\n}\n\n.tone-won {\n  background: var(--positive);\n}\n\n.tone-lost {\n  background: var(--negative);\n}\n\n.tone-idle {\n  background: var(--muted);\n}\n\n.bar-value {\n  color: var(--muted);\n  text-align: right;\n  white-space: nowrap;\n}\n\n.mini {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 12px;\n}\n\n.mini th,\n.mini td {\n  padding: 5px 6px;\n  text-align: left;\n  border-bottom: 1px solid color-mix(in srgb, var(--grid) 55%, transparent);\n}\n\n.mini th {\n  color: var(--muted);\n  font-weight: 600;\n}\n\n/* Datofelt og kalender */\n\n.date-field {\n  display: flex;\n}\n\n.date-field .date-text {\n  flex: 1;\n  min-width: 0;\n  border-top-right-radius: 0;\n  border-bottom-right-radius: 0;\n  cursor: pointer;\n}\n\n.date-button {\n  display: flex;\n  align-items: center;\n  padding: 0 10px;\n  color: var(--text);\n  background: var(--field-bg);\n  border-left: none;\n  border-top-left-radius: 0;\n  border-bottom-left-radius: 0;\n}\n\n.date-button:hover {\n  background: var(--soft);\n  color: var(--accent);\n}\n\n.calendar {\n  position: fixed;\n  z-index: 20;\n  width: 256px;\n  padding: 10px;\n  color: var(--text);\n  background: var(--surface);\n  border: 1px solid var(--grid);\n  border-radius: 6px;\n  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);\n}\n\n.calendar-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 6px;\n}\n\n.calendar-grid {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 2px;\n}\n\n.weekday {\n  padding: 4px 0;\n  text-align: center;\n  font-size: 11px;\n  color: var(--muted);\n}\n\n.day {\n  padding: 5px 0;\n  color: var(--text);\n  background: transparent;\n  border: 1px solid transparent;\n}\n\n.day:hover {\n  background: var(--soft);\n}\n\n.day.today {\n  border-color: var(--accent);\n}\n\n.day.selected {\n  color: var(--on-accent);\n  background: var(--accent);\n  font-weight: 600;\n}\n\n.calendar-foot {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 8px;\n}\n\n.small {\n  padding: 4px 10px;\n  font-size: 12px;\n}\n\n.icon.small {\n  padding: 2px 10px;\n  font-size: 20px;\n}\n\n/* Opsjoner */\n\n.settings {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  max-width: 900px;\n}\n\n.panel .hint {\n  display: block;\n  margin: -4px 0 12px;\n}\n\n.form-grid-2 {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.check {\n  display: flex;\n  gap: 10px;\n  align-items: flex-start;\n  cursor: pointer;\n}\n\n.check input {\n  margin-top: 3px;\n}\n\n.check small {\n  display: block;\n  margin-top: 2px;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.settings-foot {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n@media (max-width: 900px) {\n  .kpis {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .report {\n    grid-template-columns: 1fr;\n  }\n\n  .form-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n","path":"styles.css","type":"text/css"},{"content":"// Embedded tabeller som appen leser og skriver til.\nconst SRC = {\n  anbud: 'local-anbud',\n  status: 'local-anbud-status',\n  selskap: 'local-anbud-selskap',\n  innstillinger: 'local-anbud-innstillinger'\n};\n\nconst ANBUD_FIELDS = [\n  'anbud_id', 'selskap_id', 'prosjektnavn', 'prosjekttype', 'kunde', 'entreprenor', 'ansvarlig',\n  'prioritet', 'kontraktstype', 'status', 'sannsynlighet_pct', 'estimert_omsetning', 'estimert_db_pct',\n  'forventet_beslutning', 'forventet_oppstart', 'tapt_arsak', 'tapt_til', 'kommentar', 'avgjort_dato',\n  'opprettet', 'oppdatert'\n];\nconst NUMBER_FIELDS = ['sannsynlighet_pct', 'estimert_omsetning', 'estimert_db_pct'];\nconst PRIORITIES = ['Høy', 'Medium', 'Lav'];\nconst CONTRACT_TYPES = ['Fast', 'Variabel', 'Ramme'];\nconst LOST_REASONS = ['Pris', 'Kapasitet/tidspunkt', 'Teknisk løsning', 'Kunden valgte annen', 'Avlyst/utsatt', 'Trakk oss', 'Annet'];\n\n// Brukes bare hvis statustabellen ikke kan leses. Samme satser som i reportportal.\nconst FALLBACK_STATUSES = [\n  { status: 'Ikke startet', rekkefolge: 1, sannsynlighet_pct: 0, gruppe: 'Ikke startet' },\n  { status: 'Under arbeid', rekkefolge: 2, sannsynlighet_pct: 10, gruppe: 'Aktiv' },\n  { status: 'Levert', rekkefolge: 3, sannsynlighet_pct: 25, gruppe: 'Aktiv' },\n  { status: 'I forhandling', rekkefolge: 4, sannsynlighet_pct: 50, gruppe: 'Aktiv' },\n  { status: 'Muntlig tilsagn', rekkefolge: 5, sannsynlighet_pct: 90, gruppe: 'Aktiv' },\n  { status: 'Vunnet', rekkefolge: 6, sannsynlighet_pct: 100, gruppe: 'Vunnet' },\n  { status: 'Tapt', rekkefolge: 7, sannsynlighet_pct: 0, gruppe: 'Tapt' }\n];\nconst OPEN_GROUPS = ['Ikke startet', 'Aktiv'];\nconst DECIDED_GROUPS = ['Vunnet', 'Tapt'];\n\n// Opsjoner lagres som nøkkel/verdi i tabellen anbud_innstillinger.\nconst DEFAULT_SETTINGS = {\n  standard_selskap: '',\n  standard_ansvarlig: '',\n  standard_prosjekttype: '',\n  standard_kontraktstype: '',\n  vis_entreprenor: 'true'\n};\nconst MONTHS = ['Januar', 'Februar', 'Mars', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Desember'];\nconst WEEKDAYS = ['Ma', 'Ti', 'On', 'To', 'Fr', 'Lø', 'Sø'];\n\nconst state = {\n  payload: null,\n  loaded: false,\n  anbud: [],\n  statuses: FALLBACK_STATUSES,\n  selskaper: [],\n  settings: { ...DEFAULT_SETTINGS },\n  settingsRows: [],\n  datePicker: null,\n  view: 'anbud',\n  search: '',\n  statusFilter: 'apne',\n  selskapFilter: '',\n  editing: null,\n  editingSelskap: null,\n  pendingRender: false,\n  message: null,\n  busy: false\n};\n\nconst app = document.getElementById('app');\n\n// ---------- Hjelpefunksjoner ----------\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === '') return null;\n  if (typeof value === 'number') return Number.isFinite(value) ? value : null;\n  const cleaned = Array.from(String(value))\n    .filter(ch => ch !== ' ' && ch.charCodeAt(0) !== 160 && ch.charCodeAt(0) !== 8239)\n    .join('')\n    .replace(',', '.');\n  if (cleaned === '') return null;\n  const parsed = Number(cleaned);\n  return Number.isFinite(parsed) ? parsed : null;\n}\n\nfunction text(value) {\n  const trimmed = String(value ?? '').trim();\n  return trimmed === '' ? null : trimmed;\n}\n\nfunction esc(value) {\n  return String(value ?? '')\n    .replaceAll('&', '&amp;')\n    .replaceAll('<', '&lt;')\n    .replaceAll('>', '&gt;')\n    .replaceAll('\"', '&quot;')\n    .replaceAll(\"'\", '&#39;');\n}\n\nfunction formatKr(value) {\n  const n = toNumber(value);\n  return n === null ? '–' : Math.round(n).toLocaleString('nb-NO') + ' kr';\n}\n\nfunction formatMnok(value) {\n  const n = toNumber(value) || 0;\n  return (n / 1000000).toLocaleString('nb-NO', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' MNOK';\n}\n\nfunction formatPct(value) {\n  const n = toNumber(value);\n  return n === null ? '–' : n.toLocaleString('nb-NO', { maximumFractionDigits: 1 }) + ' %';\n}\n\nfunction formatDate(value) {\n  const parts = String(value || '').slice(0, 10).split('-');\n  return parts.length === 3 ? parts[2] + '.' + parts[1] + '.' + parts[0] : '–';\n}\n\nfunction isoFromParts(year, month, day) {\n  return String(year).padStart(4, '0') + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');\n}\n\nfunction today() {\n  const now = new Date();\n  return isoFromParts(now.getFullYear(), now.getMonth() + 1, now.getDate());\n}\n\n// Godtar dd.mm.åååå, d.m.åå og åååå-mm-dd. Returnerer ISO-dato eller null.\nfunction parseDateInput(value) {\n  const raw = String(value || '').trim();\n  if (!raw) return null;\n  let year;\n  let month;\n  let day;\n  if (raw.includes('-')) {\n    [year, month, day] = raw.split('-').map(part => parseInt(part, 10));\n  } else {\n    [day, month, year] = raw.split(/[./]/).map(part => parseInt(part, 10));\n    if (year < 100) year += 2000;\n  }\n  if (![year, month, day].every(Number.isFinite)) return null;\n  const date = new Date(Date.UTC(year, month - 1, day));\n  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) return null;\n  return isoFromParts(year, month, day);\n}\n\nfunction sum(rows, fn) {\n  return rows.reduce((total, row) => total + (fn(row) || 0), 0);\n}\n\nfunction options(pairs, selected) {\n  return pairs\n    .map(([value, label]) => `<option value='${esc(value)}'${String(value ?? '') === String(selected ?? '') ? ' selected' : ''}>${esc(label)}</option>`)\n    .join('');\n}\n\n// ---------- Forretningsregler ----------\n\nfunction statusInfo(status) {\n  return state.statuses.find(item => item.status === status) || null;\n}\n\nfunction statusGroup(status) {\n  return statusInfo(status)?.gruppe || 'Aktiv';\n}\n\nfunction toneForGroup(group) {\n  if (group === 'Vunnet') return 'won';\n  if (group === 'Tapt') return 'lost';\n  if (group === 'Ikke startet') return 'idle';\n  return 'active';\n}\n\nfunction defaultProbability(status) {\n  return toNumber(statusInfo(status)?.sannsynlighet_pct);\n}\n\n// Avgjorte anbud har ingen sannsynlighet. Ellers brukes overstyrt verdi eller satsen for status.\nfunction probability(row) {\n  if (DECIDED_GROUPS.includes(statusGroup(row.status))) return null;\n  return toNumber(row.sannsynlighet_pct) ?? defaultProbability(row.status) ?? 0;\n}\n\nfunction weighted(row) {\n  const p = probability(row);\n  const revenue = toNumber(row.estimert_omsetning);\n  return p === null || revenue === null ? null : revenue * p / 100;\n}\n\nfunction isOpen(row) {\n  return OPEN_GROUPS.includes(statusGroup(row.status));\n}\n\nfunction showEntreprenor() {\n  return state.settings.vis_entreprenor !== 'false';\n}\n\nfunction distinctValues(field, extra) {\n  const values = new Set(state.anbud.map(row => text(row[field])).filter(Boolean));\n  if (text(extra)) values.add(text(extra));\n  return [...values].sort((a, b) => a.localeCompare(b, 'nb'));\n}\n\n// Forslagslister for ansvarlig og prosjekttype, hentet fra registrerte anbud.\nfunction datalists() {\n  const list = (id, values) => `<datalist id='${id}'>${values.map(value => `<option value='${esc(value)}'></option>`).join('')}</datalist>`;\n  return list('ansvarlige', distinctValues('ansvarlig', state.settings.standard_ansvarlig))\n    + list('prosjekttyper', distinctValues('prosjekttype', state.settings.standard_prosjekttype));\n}\n\nfunction selskapName(id) {\n  return state.selskaper.find(item => item.selskap_id === id)?.selskap_navn || id || '–';\n}\n\n// Fast anbuds-ID på formen A-ÅÅ-nnn, som i reportportal.\nfunction nextAnbudId() {\n  const yy = String(new Date().getFullYear() % 100).padStart(2, '0');\n  const prefix = 'A-' + yy + '-';\n  const max = state.anbud\n    .map(row => String(row.anbud_id || ''))\n    .filter(id => id.startsWith(prefix))\n    .map(id => parseInt(id.slice(prefix.length), 10))\n    .filter(Number.isFinite)\n    .reduce((a, b) => Math.max(a, b), 0);\n  return prefix + String(max + 1).padStart(3, '0');\n}\n\n// ---------- Data ----------\n\nfunction canWrite() {\n  return Boolean(globalThis.qanvas?.tables?.insert);\n}\n\nfunction normalizeRows(source) {\n  if (!source) return [];\n  const columns = source.schema?.columns || source.columns || source.data?.columns || [];\n  const rows = Array.isArray(source) ? source : (source.rows || source.data?.rows || []);\n  return rows.map(row => Array.isArray(row)\n    ? Object.fromEntries(columns.map((column, index) => [column, row[index]]))\n    : { ...row });\n}\n\nfunction findSource(id) {\n  const sources = state.payload?.sources;\n  if (!sources) return null;\n  const list = Array.isArray(sources) ? sources : Object.values(sources);\n  return list.find(source => source && (source.id === id || source.sourceId === id))\n    || (Array.isArray(sources) ? null : sources[id] || null);\n}\n\nasync function readTable(id) {\n  if (globalThis.qanvas?.tables?.read) {\n    try {\n      return normalizeRows(await qanvas.tables.read(id));\n    } catch (error) {\n      console.warn('Kunne ikke lese tabellen ' + id, error);\n    }\n  }\n  return normalizeRows(findSource(id));\n}\n\nasync function loadAll() {\n  const [anbud, statuses, selskaper, settingsRows] = await Promise.all([\n    readTable(SRC.anbud),\n    readTable(SRC.status),\n    readTable(SRC.selskap),\n    readTable(SRC.innstillinger)\n  ]);\n  state.anbud = anbud;\n  state.settingsRows = settingsRows;\n  state.settings = {\n    ...DEFAULT_SETTINGS,\n    ...Object.fromEntries(settingsRows.filter(row => row.innstilling).map(row => [row.innstilling, row.verdi ?? '']))\n  };\n  state.statuses = (statuses.length ? statuses : FALLBACK_STATUSES)\n    .slice()\n    .sort((a, b) => (toNumber(a.rekkefolge) ?? 99) - (toNumber(b.rekkefolge) ?? 99));\n  state.selskaper = selskaper\n    .slice()\n    .sort((a, b) => String(a.selskap_navn || '').localeCompare(String(b.selskap_navn || ''), 'nb'));\n  state.loaded = true;\n  // Et åpent skjema skal ikke miste det brukeren har skrevet.\n  if (state.editing || state.editingSelskap) {\n    state.pendingRender = true;\n    return;\n  }\n  render();\n}\n\nfunction filteredAnbud() {\n  const query = state.search.trim().toLowerCase();\n  return state.anbud\n    .filter(row => {\n      const group = statusGroup(row.status);\n      if (state.statusFilter === 'apne' && !OPEN_GROUPS.includes(group)) return false;\n      if (state.statusFilter === 'avgjort' && !DECIDED_GROUPS.includes(group)) return false;\n      if (!['alle', 'apne', 'avgjort'].includes(state.statusFilter) && row.status !== state.statusFilter) return false;\n      if (state.selskapFilter && row.selskap_id !== state.selskapFilter) return false;\n      if (!query) return true;\n      return [row.anbud_id, row.prosjektnavn, row.kunde, row.entreprenor, row.ansvarlig, row.prosjekttype, selskapName(row.selskap_id)]\n        .some(value => String(value || '').toLowerCase().includes(query));\n    })\n    .sort((a, b) => String(b.anbud_id || '').localeCompare(String(a.anbud_id || '')));\n}\n\n// ---------- Visning ----------\n\nfunction render() {\n  state.pendingRender = false;\n  state.datePicker = null;\n  let body;\n  if (!state.loaded) body = `<p class='empty'>Laster anbud …</p>`;\n  else if (state.view === 'rapport') body = renderReport();\n  else if (state.view === 'selskaper') body = renderSelskaper();\n  else if (state.view === 'opsjoner') body = renderOpsjoner();\n  else body = renderList();\n\n  app.innerHTML = `\n    <header class='top'>\n      <div class='brand'>\n        <h1>Anbud</h1>\n        <span>Registrering og oppfølging av anbud</span>\n      </div>\n      <nav class='tabs' role='tablist'>\n        ${tabButton('anbud', 'Anbudsliste')}\n        ${tabButton('rapport', 'Rapport')}\n        ${tabButton('selskaper', 'Selskaper')}\n        ${tabButton('opsjoner', 'Opsjoner')}\n      </nav>\n      <button type='button' class='primary' data-action='new-anbud'>+ Nytt anbud</button>\n    </header>\n    ${renderKpis()}\n    ${renderMessage()}\n    <section class='body'>${body}</section>\n    ${state.editing ? renderAnbudEditor() : ''}\n    ${state.editingSelskap ? renderSelskapEditor() : ''}\n  `;\n\n  const form = app.querySelector('#anbud-form');\n  if (form) updateDerived(form);\n  const focusTarget = app.querySelector('[data-autofocus]');\n  if (focusTarget) focusTarget.focus();\n}\n\nfunction tabButton(view, label) {\n  const active = state.view === view;\n  return `<button type='button' role='tab' aria-selected='${active}' class='tab${active ? ' active' : ''}' data-action='view' data-view='${view}'>${label}</button>`;\n}\n\nfunction renderMessage() {\n  const notes = [];\n  if (state.loaded && !canWrite()) {\n    notes.push(`<div class='msg msg-warn'>Lagring er ikke tilgjengelig i denne visningen. Åpne rapporten i Qanvas for å legge til eller endre anbud.</div>`);\n  }\n  if (state.message) {\n    notes.push(`<div class='msg msg-${state.message.tone}' role='status'>${esc(state.message.text)}</div>`);\n  }\n  return notes.join('');\n}\n\nfunction kpi(label, value, note) {\n  return `<div class='kpi'><span class='kpi-label'>${label}</span><strong>${value}</strong><span class='kpi-note'>${note}</span></div>`;\n}\n\nfunction renderKpis() {\n  const open = state.anbud.filter(isOpen);\n  const won = state.anbud.filter(row => statusGroup(row.status) === 'Vunnet');\n  const lost = state.anbud.filter(row => statusGroup(row.status) === 'Tapt');\n  const decided = won.length + lost.length;\n  const hitRate = decided ? Math.round(won.length / decided * 100) + ' %' : '–';\n  return `\n    <section class='kpis'>\n      ${kpi('Åpne anbud', open.length.toLocaleString('nb-NO'), 'Ikke startet og aktive')}\n      ${kpi('Pipeline', formatMnok(sum(open, row => toNumber(row.estimert_omsetning))), 'Estimert omsetning, åpne')}\n      ${kpi('Vektet pipeline', formatMnok(sum(open, weighted)), 'Omsetning × sannsynlighet')}\n      ${kpi('Vunnet', formatMnok(sum(won, row => toNumber(row.estimert_omsetning))), won.length + ' anbud')}\n      ${kpi('Treffprosent', hitRate, decided + ' avgjorte anbud')}\n    </section>`;\n}\n\nfunction statusBadge(status) {\n  return `<span class='badge badge-${toneForGroup(statusGroup(status))}'>${esc(status || '–')}</span>`;\n}\n\nfunction rowCountText(count) {\n  return count + ' av ' + state.anbud.length + ' anbud';\n}\n\nfunction renderList() {\n  const statusOptions = [\n    ['apne', 'Åpne anbud'],\n    ['avgjort', 'Avgjorte'],\n    ['alle', 'Alle statuser'],\n    ...state.statuses.map(item => [item.status, item.status])\n  ];\n  const selskapOptions = [['', 'Alle selskaper'], ...state.selskaper.map(item => [item.selskap_id, item.selskap_navn])];\n  const rows = filteredAnbud();\n  return `\n    <div class='toolbar'>\n      <input id='search' type='search' placeholder='Søk i prosjekt, kunde, entreprenør, ID …' value='${esc(state.search)}' aria-label='Søk' />\n      <select id='status-filter' aria-label='Statusfilter'>${options(statusOptions, state.statusFilter)}</select>\n      <select id='selskap-filter' aria-label='Selskapsfilter'>${options(selskapOptions, state.selskapFilter)}</select>\n      <span id='row-count' class='count'>${rowCountText(rows.length)}</span>\n    </div>\n    <div class='table-wrap'>\n      <table class='grid'>\n        <thead>\n          <tr>\n            <th>ID</th>\n            <th>Prosjekt</th>\n            <th>Selskap</th>\n            <th>${showEntreprenor() ? 'Kunde / entreprenør' : 'Kunde'}</th>\n            <th>Status</th>\n            <th class='num'>Omsetning</th>\n            <th class='num'>Sanns.</th>\n            <th class='num'>Vektet</th>\n            <th>Beslutning</th>\n          </tr>\n        </thead>\n        <tbody id='rows'>${renderRows(rows)}</tbody>\n      </table>\n    </div>`;\n}\n\nfunction renderRows(rows) {\n  if (!rows.length) {\n    const note = state.anbud.length ? 'Ingen anbud passer filteret.' : 'Ingen anbud ennå. Klikk «+ Nytt anbud» for å legge til det første.';\n    return `<tr><td colspan='9' class='empty'>${note}</td></tr>`;\n  }\n  return rows.map(row => {\n    const p = probability(row);\n    const overridden = p !== null && toNumber(row.sannsynlighet_pct) !== null;\n    const decided = DECIDED_GROUPS.includes(statusGroup(row.status));\n    return `\n      <tr data-action='edit-anbud' data-id='${esc(row.anbud_id)}' tabindex='0'>\n        <td class='mono'>${esc(row.anbud_id)}</td>\n        <td><strong>${esc(row.prosjektnavn || '–')}</strong><span class='muted-line'>${esc(row.prosjekttype || '')}</span></td>\n        <td>${esc(selskapName(row.selskap_id))}</td>\n        <td>${esc(row.kunde || '–')}${showEntreprenor() ? `<span class='muted-line'>${esc(row.entreprenor || '')}</span>` : ''}</td>\n        <td>${statusBadge(row.status)}</td>\n        <td class='num'>${formatKr(row.estimert_omsetning)}</td>\n        <td class='num'>${p === null ? '–' : formatPct(p)}${overridden ? ` <span class='override' title='Overstyrt sannsynlighet'>*</span>` : ''}</td>\n        <td class='num'>${formatKr(weighted(row))}</td>\n        <td>${formatDate(decided ? row.avgjort_dato : row.forventet_beslutning)}</td>\n      </tr>`;\n  }).join('');\n}\n\nfunction updateRows() {\n  const rows = filteredAnbud();\n  const body = app.querySelector('#rows');\n  const count = app.querySelector('#row-count');\n  if (body) body.innerHTML = renderRows(rows);\n  if (count) count.textContent = rowCountText(rows.length);\n}\n\n// ---------- Anbudsskjema ----------\n\nfunction renderAnbudEditor() {\n  const { mode, row } = state.editing;\n  const isNew = mode === 'new';\n  const field = (name, label, control, extra = '') => `<label class='field ${extra}' data-field='${name}'><span>${label}</span>${control}</label>`;\n  const input = (name, attrs = '') => `<input name='${name}' value='${esc(row[name] ?? '')}' ${attrs} />`;\n  const select = (name, pairs) => `<select name='${name}'>${options(pairs, row[name] ?? '')}</select>`;\n  const plain = values => values.map(value => [value, value]);\n  const numberInput = name => {\n    const n = toNumber(row[name]);\n    return `<input name='${name}' inputmode='decimal' value='${n === null ? '' : String(n).replace('.', ',')}' />`;\n  };\n  // Datofelt: skjult ISO-verdi, synlig dd.mm.åååå og knapp som åpner kalenderen.\n  const dateField = (name, label, extra = '') => `\n    <div class='field ${extra}' data-field='${name}'>\n      <span>${label}</span>\n      <span class='date-field' data-date-field='${name}'>\n        <input type='hidden' name='${name}' value='${esc(row[name] ?? '')}' />\n        <input type='text' class='date-text' data-date-text='${name}' value='${row[name] ? formatDate(row[name]) : ''}' placeholder='dd.mm.åååå' autocomplete='off' aria-label='${label}' />\n        <button type='button' class='date-button' data-action='toggle-date' data-field='${name}' aria-label='Åpne kalender for ${label}'>\n          <svg viewBox='0 0 16 16' width='14' height='14' aria-hidden='true'><rect x='1.5' y='3' width='13' height='11.5' rx='1.5' fill='none' stroke='currentColor' stroke-width='1.4'/><path d='M1.5 6.5h13M5 1.5v3M11 1.5v3' stroke='currentColor' stroke-width='1.4'/></svg>\n        </button>\n      </span>\n    </div>`;\n  const selskapOptions = [['', 'Velg selskap'], ...state.selskaper.map(item => [item.selskap_id, item.selskap_navn])];\n\n  return `\n    <div class='overlay'>\n      <div id='anbud-form' class='dialog' role='dialog' aria-modal='true' aria-label='Anbud'>\n        <header class='dialog-head'>\n          <div>\n            <span class='kicker'>${isNew ? 'Nytt anbud' : esc(row.anbud_id)}</span>\n            <h2>${isNew ? 'Registrer anbud' : esc(row.prosjektnavn || 'Rediger anbud')}</h2>\n          </div>\n          <button type='button' class='icon' data-action='close' aria-label='Lukk'>×</button>\n        </header>\n        <div class='dialog-body'>\n          <fieldset>\n            <legend>Prosjekt</legend>\n            <div class='form-grid'>\n              ${field('prosjektnavn', 'Prosjektnavn *', input('prosjektnavn', 'data-autofocus'), 'span-2')}\n              ${field('selskap_id', 'Selskap *', select('selskap_id', selskapOptions))}\n              ${field('prosjekttype', 'Prosjekttype', input('prosjekttype', `list='prosjekttyper' placeholder='F.eks. nybygg, rehab, service'`))}\n              ${field('kunde', 'Kunde', input('kunde'))}\n              ${showEntreprenor() ? field('entreprenor', 'Entreprenør', input('entreprenor')) : ''}\n              ${field('ansvarlig', 'Ansvarlig', input('ansvarlig', `list='ansvarlige'`))}\n              ${field('kontraktstype', 'Kontraktstype', select('kontraktstype', [['', '–'], ...plain(CONTRACT_TYPES)]))}\n              ${field('prioritet', 'Prioritet', select('prioritet', [['', '–'], ...plain(PRIORITIES)]))}\n            </div>\n          </fieldset>\n          <fieldset>\n            <legend>Status og verdi</legend>\n            <div class='form-grid'>\n              ${field('status', 'Status *', select('status', state.statuses.map(item => [item.status, item.status])))}\n              ${field('sannsynlighet_pct', 'Sannsynlighet %', numberInput('sannsynlighet_pct'))}\n              ${field('estimert_omsetning', 'Estimert omsetning (kr)', numberInput('estimert_omsetning'))}\n              ${field('estimert_db_pct', 'Estimert DB %', numberInput('estimert_db_pct'))}\n              <div class='derived' id='derived'></div>\n              ${dateField('forventet_beslutning', 'Forventet beslutning')}\n              ${dateField('forventet_oppstart', 'Forventet oppstart')}\n              ${dateField('avgjort_dato', 'Avgjort dato', 'decided-only')}\n              ${field('tapt_arsak', 'Tapt – årsak', select('tapt_arsak', [['', 'Velg årsak'], ...plain(LOST_REASONS)]), 'lost-only')}\n              ${field('tapt_til', 'Tapt til', input('tapt_til', `placeholder='Konkurrent'`), 'lost-only')}\n            </div>\n          </fieldset>\n          <fieldset>\n            <legend>Kommentar</legend>\n            <textarea name='kommentar' rows='3'>${esc(row.kommentar ?? '')}</textarea>\n          </fieldset>\n          <p class='form-error' id='form-error' role='alert'></p>\n          ${datalists()}\n        </div>\n        <footer class='dialog-foot'>\n          ${isNew ? '' : `<button type='button' class='danger' data-action='delete-anbud'>Slett anbud</button>`}\n          <span class='spacer'></span>\n          <button type='button' class='secondary' data-action='close'>Avbryt</button>\n          <button type='button' class='primary' data-action='save-anbud' ${canWrite() ? '' : 'disabled'}>${isNew ? 'Lagre anbud' : 'Lagre endringer'}</button>\n        </footer>\n      </div>\n    </div>`;\n}\n\nfunction formControl(form, name) {\n  return form.querySelector(`[name='${name}']`);\n}\n\n// Oppdaterer felt som avhenger av status uten å tegne skjemaet på nytt.\nfunction updateDerived(form) {\n  const status = formControl(form, 'status').value;\n  const group = statusGroup(status);\n  const decided = DECIDED_GROUPS.includes(group);\n  form.querySelectorAll('.lost-only').forEach(element => element.classList.toggle('hidden', group !== 'Tapt'));\n  form.querySelectorAll('.decided-only').forEach(element => element.classList.toggle('hidden', !decided));\n\n  const probabilityInput = formControl(form, 'sannsynlighet_pct');\n  const standard = defaultProbability(status);\n  probabilityInput.disabled = decided;\n  probabilityInput.placeholder = decided ? 'Avgjort' : (standard ?? 0) + ' (fra status)';\n\n  const revenue = toNumber(formControl(form, 'estimert_omsetning').value);\n  const margin = toNumber(formControl(form, 'estimert_db_pct').value);\n  const p = decided ? null : (toNumber(probabilityInput.value) ?? standard ?? 0);\n  form.querySelector('#derived').innerHTML = `\n    <div><span>Vektet verdi</span><strong>${p === null || revenue === null ? '–' : formatKr(revenue * p / 100)}</strong></div>\n    <div><span>Estimert DB</span><strong>${revenue === null || margin === null ? '–' : formatKr(revenue * margin / 100)}</strong></div>`;\n}\n\n// ---------- Kalender ----------\n\nfunction setDateValue(form, fieldName, iso) {\n  formControl(form, fieldName).value = iso || '';\n  const display = form.querySelector(`[data-date-text='${fieldName}']`);\n  if (display) display.value = iso ? formatDate(iso) : '';\n}\n\n// Tolker det brukeren har skrevet i et datofelt. Ugyldig dato gir melding og beholdes.\nfunction commitDateText(input) {\n  const form = input.closest('#anbud-form');\n  const fieldName = input.dataset.dateText;\n  const raw = input.value.trim();\n  if (!raw) {\n    setDateValue(form, fieldName, '');\n    return true;\n  }\n  const iso = parseDateInput(raw);\n  if (!iso) {\n    showFormError('Ugyldig dato: ' + raw + '. Bruk dd.mm.åååå.');\n    return false;\n  }\n  setDateValue(form, fieldName, iso);\n  showFormError('');\n  return true;\n}\n\nfunction openDatePicker(fieldName) {\n  const form = app.querySelector('#anbud-form');\n  if (!form) return;\n  const current = parseDateInput(form.querySelector(`[data-date-text='${fieldName}']`)?.value) || formControl(form, fieldName).value || today();\n  const [year, month] = current.split('-').map(part => parseInt(part, 10));\n  state.datePicker = { field: fieldName, year, month };\n  drawDatePicker();\n}\n\nfunction closeDatePicker() {\n  state.datePicker = null;\n  app.querySelectorAll('.calendar').forEach(element => element.remove());\n}\n\nfunction drawDatePicker() {\n  app.querySelectorAll('.calendar').forEach(element => element.remove());\n  const picker = state.datePicker;\n  const form = app.querySelector('#anbud-form');\n  const host = picker && form ? form.querySelector(`[data-date-field='${picker.field}']`) : null;\n  if (!host) return;\n  const selected = formControl(form, picker.field).value;\n  const todayIso = today();\n  const offset = (new Date(picker.year, picker.month - 1, 1).getDay() + 6) % 7;\n  const daysInMonth = new Date(picker.year, picker.month, 0).getDate();\n  const cells = [];\n  for (let i = 0; i < offset; i += 1) cells.push('<span></span>');\n  for (let day = 1; day <= daysInMonth; day += 1) {\n    const iso = isoFromParts(picker.year, picker.month, day);\n    const classes = ['day', iso === selected ? 'selected' : '', iso === todayIso ? 'today' : ''].filter(Boolean).join(' ');\n    cells.push(`<button type='button' class='${classes}' data-action='pick-date' data-date='${iso}'>${day}</button>`);\n  }\n\n  const calendar = document.createElement('div');\n  calendar.className = 'calendar';\n  calendar.setAttribute('role', 'dialog');\n  calendar.setAttribute('aria-label', 'Velg dato');\n  calendar.innerHTML = `\n    <div class='calendar-head'>\n      <button type='button' class='icon small' data-action='date-month' data-step='-1' aria-label='Forrige måned'>‹</button>\n      <strong>${MONTHS[picker.month - 1]} ${picker.year}</strong>\n      <button type='button' class='icon small' data-action='date-month' data-step='1' aria-label='Neste måned'>›</button>\n    </div>\n    <div class='calendar-grid'>\n      ${WEEKDAYS.map(day => `<span class='weekday'>${day}</span>`).join('')}\n      ${cells.join('')}\n    </div>\n    <div class='calendar-foot'>\n      <button type='button' class='secondary small' data-action='pick-date' data-date='${todayIso}'>I dag</button>\n      <button type='button' class='secondary small' data-action='pick-date' data-date=''>Tøm</button>\n    </div>`;\n  host.appendChild(calendar);\n\n  // Plasseres under feltet, eller over hvis det ikke er plass nederst.\n  const rect = host.getBoundingClientRect();\n  let top = rect.bottom + 4;\n  if (top + calendar.offsetHeight > window.innerHeight - 8) top = Math.max(8, rect.top - calendar.offsetHeight - 4);\n  const left = Math.max(8, Math.min(rect.left, window.innerWidth - calendar.offsetWidth - 8));\n  calendar.style.top = top + 'px';\n  calendar.style.left = left + 'px';\n}\n\nfunction showFormError(message) {\n  const box = app.querySelector('#form-error');\n  if (box) box.textContent = message;\n}\n\nasync function saveAnbud() {\n  const form = app.querySelector('#anbud-form');\n  if (!form || state.busy) return;\n  for (const input of form.querySelectorAll('.date-text')) {\n    if (!commitDateText(input)) return;\n  }\n  const values = {};\n  form.querySelectorAll('[name]').forEach(element => {\n    values[element.name] = NUMBER_FIELDS.includes(element.name) ? toNumber(element.value) : text(element.value);\n  });\n\n  if (!values.prosjektnavn) return showFormError('Prosjektnavn må fylles ut.');\n  if (!values.selskap_id) return showFormError('Velg selskap.');\n  if (!values.status) return showFormError('Velg status.');\n  if (values.sannsynlighet_pct !== null && (values.sannsynlighet_pct < 0 || values.sannsynlighet_pct > 100)) {\n    return showFormError('Sannsynlighet må være mellom 0 og 100.');\n  }\n\n  const group = statusGroup(values.status);\n  if (group !== 'Tapt') {\n    values.tapt_arsak = null;\n    values.tapt_til = null;\n  }\n  if (DECIDED_GROUPS.includes(group)) {\n    values.sannsynlighet_pct = null;\n    values.avgjort_dato = values.avgjort_dato || today();\n  } else {\n    values.avgjort_dato = null;\n    // Lik standardsats lagres som tom, slik at endret sats på status slår gjennom.\n    if (values.sannsynlighet_pct === defaultProbability(values.status)) values.sannsynlighet_pct = null;\n  }\n\n  const now = new Date().toISOString().slice(0, 19);\n  values.oppdatert = now;\n  state.busy = true;\n  try {\n    let id;\n    if (state.editing.mode === 'new') {\n      const row = Object.fromEntries(ANBUD_FIELDS.map(name => [name, null]));\n      Object.assign(row, values, { anbud_id: nextAnbudId(), opprettet: now });\n      id = row.anbud_id;\n      await qanvas.tables.insert(SRC.anbud, row);\n      state.message = { tone: 'ok', text: 'Anbud ' + id + ' er lagret.' };\n    } else {\n      id = state.editing.row.anbud_id;\n      await qanvas.tables.update(SRC.anbud, { anbud_id: id }, values);\n      state.message = { tone: 'ok', text: 'Endringene på ' + id + ' er lagret.' };\n    }\n    state.editing = null;\n    await loadAll();\n  } catch (error) {\n    showFormError('Kunne ikke lagre: ' + (error?.message || error));\n  } finally {\n    state.busy = false;\n  }\n}\n\nasync function deleteAnbud() {\n  const id = state.editing?.row?.anbud_id;\n  if (!id || state.busy) return;\n  state.busy = true;\n  try {\n    await qanvas.tables.delete(SRC.anbud, { anbud_id: id });\n    state.message = { tone: 'ok', text: 'Anbud ' + id + ' er slettet.' };\n    state.editing = null;\n    await loadAll();\n  } catch (error) {\n    showFormError('Kunne ikke slette: ' + (error?.message || error));\n  } finally {\n    state.busy = false;\n  }\n}\n\nfunction openAnbud(id) {\n  const existing = id ? state.anbud.find(row => row.anbud_id === id) : null;\n  if (id && !existing) return;\n  const settings = state.settings;\n  const standardSelskap = state.selskaper.some(item => item.selskap_id === settings.standard_selskap) ? settings.standard_selskap : null;\n  const defaultSelskap = state.selskapFilter || standardSelskap || (state.selskaper.length === 1 ? state.selskaper[0].selskap_id : null);\n  state.message = null;\n  state.editing = existing\n    ? { mode: 'edit', row: { ...existing } }\n    : {\n      mode: 'new',\n      row: {\n        status: 'Under arbeid',\n        selskap_id: defaultSelskap,\n        ansvarlig: text(settings.standard_ansvarlig),\n        prosjekttype: text(settings.standard_prosjekttype),\n        kontraktstype: text(settings.standard_kontraktstype)\n      }\n    };\n  render();\n}\n\n// ---------- Selskaper ----------\n\nfunction renderSelskaper() {\n  const rows = state.selskaper.map(item => {\n    const count = state.anbud.filter(row => row.selskap_id === item.selskap_id).length;\n    return `\n      <tr data-action='edit-selskap' data-id='${esc(item.selskap_id)}' tabindex='0'>\n        <td class='mono'>${esc(item.selskap_id)}</td>\n        <td><strong>${esc(item.selskap_navn || '–')}</strong></td>\n        <td>${esc(item.region || '–')}</td>\n        <td class='num'>${count}</td>\n      </tr>`;\n  }).join('');\n  return `\n    <div class='toolbar'>\n      <span class='hint'>Selskapene brukes som valgliste i anbudene og er koblet til anbudstabellen med en relasjon på selskap_id.</span>\n      <span class='spacer'></span>\n      <button type='button' class='secondary' data-action='new-selskap'>+ Nytt selskap</button>\n    </div>\n    <div class='table-wrap'>\n      <table class='grid'>\n        <thead><tr><th>ID</th><th>Selskap</th><th>Region</th><th class='num'>Anbud</th></tr></thead>\n        <tbody>${rows || `<tr><td colspan='4' class='empty'>Ingen selskaper registrert.</td></tr>`}</tbody>\n      </table>\n    </div>`;\n}\n\nfunction renderSelskapEditor() {\n  const { mode, row } = state.editingSelskap;\n  const isNew = mode === 'new';\n  return `\n    <div class='overlay'>\n      <div id='selskap-form' class='dialog dialog-small' role='dialog' aria-modal='true' aria-label='Selskap'>\n        <header class='dialog-head'>\n          <div>\n            <span class='kicker'>Selskap</span>\n            <h2>${isNew ? 'Nytt selskap' : esc(row.selskap_navn || row.selskap_id)}</h2>\n          </div>\n          <button type='button' class='icon' data-action='close' aria-label='Lukk'>×</button>\n        </header>\n        <div class='dialog-body'>\n          <div class='form-grid'>\n            <label class='field'><span>Selskaps-ID *</span><input name='selskap_id' value='${esc(row.selskap_id ?? '')}' ${isNew ? 'data-autofocus' : 'readonly'} /></label>\n            <label class='field'><span>Navn *</span><input name='selskap_navn' value='${esc(row.selskap_navn ?? '')}' ${isNew ? '' : 'data-autofocus'} /></label>\n            <label class='field span-2'><span>Region</span><input name='region' value='${esc(row.region ?? '')}' /></label>\n          </div>\n          <p class='form-error' id='form-error' role='alert'></p>\n        </div>\n        <footer class='dialog-foot'>\n          ${isNew ? '' : `<button type='button' class='danger' data-action='delete-selskap'>Slett selskap</button>`}\n          <span class='spacer'></span>\n          <button type='button' class='secondary' data-action='close'>Avbryt</button>\n          <button type='button' class='primary' data-action='save-selskap' ${canWrite() ? '' : 'disabled'}>Lagre</button>\n        </footer>\n      </div>\n    </div>`;\n}\n\nasync function saveSelskap() {\n  const form = app.querySelector('#selskap-form');\n  if (!form || state.busy) return;\n  const values = {\n    selskap_id: text(formControl(form, 'selskap_id').value),\n    selskap_navn: text(formControl(form, 'selskap_navn').value),\n    region: text(formControl(form, 'region').value)\n  };\n  if (!values.selskap_id || !values.selskap_navn) return showFormError('Selskaps-ID og navn må fylles ut.');\n  const isNew = state.editingSelskap.mode === 'new';\n  if (isNew && state.selskaper.some(item => item.selskap_id === values.selskap_id)) {\n    return showFormError('Selskaps-ID-en finnes allerede.');\n  }\n  state.busy = true;\n  try {\n    if (isNew) {\n      await qanvas.tables.insert(SRC.selskap, values);\n    } else {\n      await qanvas.tables.update(SRC.selskap, { selskap_id: values.selskap_id }, { selskap_navn: values.selskap_navn, region: values.region });\n    }\n    state.message = { tone: 'ok', text: 'Selskapet ' + values.selskap_navn + ' er lagret.' };\n    state.editingSelskap = null;\n    await loadAll();\n  } catch (error) {\n    showFormError('Kunne ikke lagre: ' + (error?.message || error));\n  } finally {\n    state.busy = false;\n  }\n}\n\nasync function deleteSelskap() {\n  const id = state.editingSelskap?.row?.selskap_id;\n  if (!id || state.busy) return;\n  const used = state.anbud.filter(row => row.selskap_id === id).length;\n  if (used) return showFormError('Selskapet brukes av ' + used + ' anbud og kan ikke slettes.');\n  state.busy = true;\n  try {\n    await qanvas.tables.delete(SRC.selskap, { selskap_id: id });\n    state.message = { tone: 'ok', text: 'Selskapet ' + id + ' er slettet.' };\n    state.editingSelskap = null;\n    await loadAll();\n  } catch (error) {\n    showFormError('Kunne ikke slette: ' + (error?.message || error));\n  } finally {\n    state.busy = false;\n  }\n}\n\n// ---------- Opsjoner ----------\n\nfunction renderOpsjoner() {\n  const settings = state.settings;\n  const selskapOptions = [['', 'Ingen standard'], ...state.selskaper.map(item => [item.selskap_id, item.selskap_navn])];\n  const contractOptions = [['', 'Ingen standard'], ...CONTRACT_TYPES.map(value => [value, value])];\n  return `\n    <div id='opsjoner-form' class='settings'>\n      <article class='panel'>\n        <h3>Standardverdier for nye anbud</h3>\n        <p class='hint'>Fylles inn automatisk når du registrerer et nytt anbud, og kan endres i hvert anbud.</p>\n        <div class='form-grid form-grid-2'>\n          <label class='field'><span>Standard selskap</span><select name='standard_selskap'>${options(selskapOptions, settings.standard_selskap)}</select></label>\n          <label class='field'><span>Standard ansvarlig</span><input name='standard_ansvarlig' list='ansvarlige' value='${esc(settings.standard_ansvarlig)}' /></label>\n          <label class='field'><span>Standard prosjekttype</span><input name='standard_prosjekttype' list='prosjekttyper' value='${esc(settings.standard_prosjekttype)}' /></label>\n          <label class='field'><span>Standard kontraktstype</span><select name='standard_kontraktstype'>${options(contractOptions, settings.standard_kontraktstype)}</select></label>\n        </div>\n      </article>\n      <article class='panel'>\n        <h3>Felt i anbudsskjemaet</h3>\n        <label class='check'>\n          <input type='checkbox' name='vis_entreprenor' ${showEntreprenor() ? 'checked' : ''} />\n          <span>Ta med feltet Entreprenør<small>Slå av hvis dere vanligvis ikke registrerer entreprenør. Verdier som allerede er lagret, beholdes.</small></span>\n        </label>\n      </article>\n      ${datalists()}\n      <div class='settings-foot'>\n        <span class='hint'>Opsjonene lagres i rapporten og er tilgjengelige neste gang filen åpnes.</span>\n        <span class='spacer'></span>\n        <button type='button' class='primary' data-action='save-settings' ${canWrite() ? '' : 'disabled'}>Lagre opsjoner</button>\n      </div>\n    </div>`;\n}\n\nasync function saveSettings() {\n  const form = app.querySelector('#opsjoner-form');\n  if (!form || state.busy) return;\n  const next = {\n    standard_selskap: formControl(form, 'standard_selskap').value,\n    standard_ansvarlig: formControl(form, 'standard_ansvarlig').value.trim(),\n    standard_prosjekttype: formControl(form, 'standard_prosjekttype').value.trim(),\n    standard_kontraktstype: formControl(form, 'standard_kontraktstype').value,\n    vis_entreprenor: formControl(form, 'vis_entreprenor').checked ? 'true' : 'false'\n  };\n  state.busy = true;\n  try {\n    for (const [key, value] of Object.entries(next)) {\n      const verdi = value === '' ? null : value;\n      if (state.settingsRows.some(row => row.innstilling === key)) {\n        await qanvas.tables.update(SRC.innstillinger, { innstilling: key }, { verdi });\n      } else {\n        await qanvas.tables.insert(SRC.innstillinger, { innstilling: key, verdi });\n      }\n    }\n    state.message = { tone: 'ok', text: 'Opsjonene er lagret.' };\n    await loadAll();\n  } catch (error) {\n    state.message = { tone: 'error', text: 'Kunne ikke lagre opsjonene: ' + (error?.message || error) };\n    render();\n  } finally {\n    state.busy = false;\n  }\n}\n\n// ---------- Rapport ----------\n\nfunction quarterKey(value) {\n  const parts = String(value || '').split('-');\n  const month = parseInt(parts[1], 10);\n  if (parts.length < 2 || !Number.isFinite(month)) return 'Uten dato';\n  return parts[0] + ' K' + Math.ceil(month / 3);\n}\n\nfunction bar(label, value, max, caption, tone, inner) {\n  const width = Math.max(0, Math.round(value / max * 100));\n  const innerBar = inner === undefined ? '' : `<span class='bar-inner' style='width:${Math.max(0, Math.round(inner / max * 100))}%'></span>`;\n  return `\n    <div class='bar-row'>\n      <span class='bar-label'>${esc(label)}</span>\n      <span class='bar-track'><span class='bar-fill tone-${tone}' style='width:${width}%'></span>${innerBar}</span>\n      <span class='bar-value'>${esc(caption)}</span>\n    </div>`;\n}\n\nfunction renderReport() {\n  const rows = state.anbud;\n  if (!rows.length) return `<p class='empty'>Ingen anbud å rapportere på ennå.</p>`;\n  const revenueOf = row => toNumber(row.estimert_omsetning);\n\n  const byStatus = state.statuses.map(item => {\n    const list = rows.filter(row => row.status === item.status);\n    return { label: item.status, group: item.gruppe, count: list.length, revenue: sum(list, revenueOf) };\n  });\n  const maxStatus = Math.max(1, ...byStatus.map(item => item.revenue));\n\n  const quarters = new Map();\n  rows.filter(isOpen).forEach(row => {\n    const key = quarterKey(row.forventet_beslutning);\n    const entry = quarters.get(key) || { revenue: 0, weighted: 0 };\n    entry.revenue += revenueOf(row) || 0;\n    entry.weighted += weighted(row) || 0;\n    quarters.set(key, entry);\n  });\n  const quarterList = [...quarters.entries()].sort((a, b) => a[0].localeCompare(b[0]));\n  const maxQuarter = Math.max(1, ...quarterList.map(([, entry]) => entry.revenue));\n\n  const bySelskap = state.selskaper.map(item => {\n    const list = rows.filter(row => row.selskap_id === item.selskap_id);\n    const open = list.filter(isOpen);\n    const won = list.filter(row => statusGroup(row.status) === 'Vunnet');\n    const lost = list.filter(row => statusGroup(row.status) === 'Tapt');\n    const decided = won.length + lost.length;\n    return {\n      name: item.selskap_navn,\n      count: list.length,\n      pipeline: sum(open, revenueOf),\n      weighted: sum(open, weighted),\n      won: sum(won, revenueOf),\n      hit: decided ? Math.round(won.length / decided * 100) + ' %' : '–'\n    };\n  }).filter(item => item.count);\n\n  const lostCounts = new Map();\n  rows.filter(row => statusGroup(row.status) === 'Tapt').forEach(row => {\n    const key = row.tapt_arsak || 'Ikke oppgitt';\n    lostCounts.set(key, (lostCounts.get(key) || 0) + 1);\n  });\n  const lostList = [...lostCounts.entries()].sort((a, b) => b[1] - a[1]);\n  const maxLost = Math.max(1, ...lostList.map(([, count]) => count));\n\n  return `\n    <div class='report'>\n      <article class='panel'>\n        <h3>Estimert omsetning per status</h3>\n        <div class='bars'>\n          ${byStatus.map(item => bar(item.label, item.revenue, maxStatus, item.count + ' stk · ' + formatMnok(item.revenue), toneForGroup(item.group))).join('')}\n        </div>\n      </article>\n      <article class='panel'>\n        <h3>Åpen pipeline per forventet beslutning (lys stripe = vektet)</h3>\n        <div class='bars'>\n          ${quarterList.length\n            ? quarterList.map(([key, entry]) => bar(key, entry.revenue, maxQuarter, formatMnok(entry.revenue) + ' · vektet ' + formatMnok(entry.weighted), 'active', entry.weighted)).join('')\n            : `<p class='empty'>Ingen åpne anbud.</p>`}\n        </div>\n      </article>\n      <article class='panel'>\n        <h3>Per selskap</h3>\n        <table class='mini'>\n          <thead><tr><th>Selskap</th><th class='num'>Anbud</th><th class='num'>Pipeline</th><th class='num'>Vektet</th><th class='num'>Vunnet</th><th class='num'>Treff</th></tr></thead>\n          <tbody>\n            ${bySelskap.map(item => `<tr><td>${esc(item.name)}</td><td class='num'>${item.count}</td><td class='num'>${formatMnok(item.pipeline)}</td><td class='num'>${formatMnok(item.weighted)}</td><td class='num'>${formatMnok(item.won)}</td><td class='num'>${item.hit}</td></tr>`).join('')}\n          </tbody>\n        </table>\n      </article>\n      <article class='panel'>\n        <h3>Tapsårsaker</h3>\n        <div class='bars'>\n          ${lostList.length\n            ? lostList.map(([reason, count]) => bar(reason, count, maxLost, count + ' anbud', 'lost')).join('')\n            : `<p class='empty'>Ingen tapte anbud.</p>`}\n        </div>\n      </article>\n    </div>`;\n}\n\n// ---------- Hendelser ----------\n\nfunction closeDialogs() {\n  state.editing = null;\n  state.editingSelskap = null;\n  render();\n}\n\napp.addEventListener('click', event => {\n  // Klikk utenfor kalenderen lukker den.\n  if (state.datePicker && !event.target.closest('.calendar') && !event.target.closest('.date-field')) closeDatePicker();\n  if (event.target.matches?.('.date-text') && state.datePicker?.field !== event.target.dataset.dateText) {\n    openDatePicker(event.target.dataset.dateText);\n    return;\n  }\n  const target = event.target.closest('[data-action]');\n  if (!target || !app.contains(target)) return;\n  const action = target.dataset.action;\n  if (action === 'toggle-date') {\n    if (state.datePicker?.field === target.dataset.field) closeDatePicker();\n    else openDatePicker(target.dataset.field);\n  } else if (action === 'date-month' && state.datePicker) {\n    const picker = state.datePicker;\n    const index = picker.year * 12 + (picker.month - 1) + Number(target.dataset.step);\n    picker.year = Math.floor(index / 12);\n    picker.month = (index % 12) + 1;\n    drawDatePicker();\n  } else if (action === 'pick-date' && state.datePicker) {\n    const form = app.querySelector('#anbud-form');\n    if (form) setDateValue(form, state.datePicker.field, target.dataset.date);\n    showFormError('');\n    closeDatePicker();\n  } else if (action === 'save-settings') {\n    void saveSettings();\n  } else if (action === 'view') {\n    state.view = target.dataset.view;\n    state.message = null;\n    render();\n  } else if (action === 'new-anbud') {\n    openAnbud(null);\n  } else if (action === 'edit-anbud') {\n    openAnbud(target.dataset.id);\n  } else if (action === 'save-anbud') {\n    void saveAnbud();\n  } else if (action === 'new-selskap') {\n    state.message = null;\n    state.editingSelskap = { mode: 'new', row: {} };\n    render();\n  } else if (action === 'edit-selskap') {\n    const row = state.selskaper.find(item => item.selskap_id === target.dataset.id);\n    if (!row) return;\n    state.message = null;\n    state.editingSelskap = { mode: 'edit', row: { ...row } };\n    render();\n  } else if (action === 'save-selskap') {\n    void saveSelskap();\n  } else if (action === 'close') {\n    closeDialogs();\n  } else if (action === 'delete-anbud' || action === 'delete-selskap') {\n    // To klikk i stedet for confirm(), som kan være blokkert i sandkassen.\n    if (target.dataset.confirm !== 'true') {\n      target.dataset.confirm = 'true';\n      target.textContent = 'Klikk igjen for å bekrefte';\n      return;\n    }\n    void (action === 'delete-anbud' ? deleteAnbud() : deleteSelskap());\n  }\n});\n\napp.addEventListener('keydown', event => {\n  if (event.key === 'Escape' && state.datePicker) {\n    closeDatePicker();\n    return;\n  }\n  if (event.key === 'Enter' && event.target.matches?.('.date-text')) {\n    event.preventDefault();\n    if (commitDateText(event.target)) closeDatePicker();\n    return;\n  }\n  if (event.key === 'Escape' && (state.editing || state.editingSelskap)) {\n    closeDialogs();\n    return;\n  }\n  if (event.key !== 'Enter') return;\n  if (event.target.matches?.('tr[data-action]')) {\n    event.target.click();\n  } else if (event.target.matches?.('input') && event.target.closest('#anbud-form')) {\n    event.preventDefault();\n    void saveAnbud();\n  } else if (event.target.matches?.('input') && event.target.closest('#selskap-form')) {\n    event.preventDefault();\n    void saveSelskap();\n  }\n});\n\napp.addEventListener('input', event => {\n  if (event.target.id === 'search') {\n    state.search = event.target.value;\n    updateRows();\n    return;\n  }\n  const form = event.target.closest('#anbud-form');\n  if (form) updateDerived(form);\n});\n\napp.addEventListener('change', event => {\n  if (event.target.id === 'status-filter') {\n    state.statusFilter = event.target.value;\n    updateRows();\n  } else if (event.target.id === 'selskap-filter') {\n    state.selskapFilter = event.target.value;\n    updateRows();\n  } else {\n    const form = event.target.closest('#anbud-form');\n    if (!form) return;\n    if (event.target.matches('.date-text')) commitDateText(event.target);\n    // Vunnet/Tapt: dagens dato som avgjort dato hvis feltet er tomt.\n    if (event.target.name === 'status' && DECIDED_GROUPS.includes(statusGroup(event.target.value)) && !formControl(form, 'avgjort_dato').value) {\n      setDateValue(form, 'avgjort_dato', today());\n    }\n    updateDerived(form);\n  }\n});\n\n// Kalenderen er fast plassert og lukkes når skjemaet rulles.\napp.addEventListener('scroll', event => {\n  if (state.datePicker && !event.target.closest?.('.calendar')) closeDatePicker();\n}, true);\n\n// ---------- Qanvas-bro ----------\n\nfunction applyTheme(theme) {\n  if (!theme) return;\n  const roles = theme.roles || theme;\n  const map = [\n    ['surface', '--surface'],\n    ['text', '--text'],\n    ['accent', '--accent'],\n    ['onAccent', '--on-accent'],\n    ['grid', '--grid'],\n    ['positive', '--positive'],\n    ['negative', '--negative'],\n    ['muted', '--muted']\n  ];\n  for (const [role, cssName] of map) {\n    const value = roles[role];\n    if (typeof value === 'string' && value) document.documentElement.style.setProperty(cssName, value);\n  }\n}\n\nfunction handlePayload(payload) {\n  state.payload = payload || {};\n  applyTheme(state.payload.theme);\n  loadAll().catch(error => {\n    state.loaded = true;\n    state.message = { tone: 'error', text: 'Kunne ikke laste anbud: ' + (error?.message || error) };\n    render();\n  });\n}\n\nwindow.addEventListener('message', event => {\n  const message = event.data;\n  if (!message || typeof message !== 'object') return;\n  if (message.type === 'qanvas.init' || message.type === 'qanvas.update') handlePayload(message.payload);\n});\n\nrender();\nparent.postMessage({ type: 'qanvas.ready' }, '*');\n","path":"app.js","type":"text/javascript"}],"id":"app-anbud","name":"Anbud","permissions":{"actions":["localTable.appendRow","localTable.updateRow","localTable.deleteRow"],"data":"write","external":{"openLinks":false,"remoteImages":false,"linkHosts":[],"imageHosts":[]},"filters":"read","measures":"read","navigation":"read","network":"none","parameterAccess":[],"parameters":"read","sourceRefresh":[],"storage":"none","tables":[{"sourceId":"local-anbud","operations":["read","insert","update","upsert","delete"],"key":"anbud_id"},{"sourceId":"local-anbud-status","operations":["read"],"key":"status"},{"sourceId":"local-anbud-selskap","operations":["read","insert","update","upsert","delete"],"key":"selskap_id"},{"sourceId":"local-anbud-innstillinger","operations":["read","insert","update","upsert","delete"],"key":"innstilling"}]},"runtime":"sandboxed-html","template":"blank","version":1}],"localSources":[{"name":"anbud_innstillinger","sourceId":"local-anbud-innstillinger","scope":"document","embedded":true,"definition":{"Id":"local-anbud-innstillinger","Name":"anbud_innstillinger","SourceMode":"Manual","Comment":"Embedded Qanvas local table","Columns":[{"Name":"innstilling","SourceName":"innstilling","DataType":"System.String","AllowNull":true},{"Name":"verdi","SourceName":"verdi","DataType":"System.String","AllowNull":true}]},"jsonl":"{\"innstilling\":\"standard_selskap\",\"verdi\":\"S01\"}\n{\"innstilling\":\"standard_ansvarlig\",\"verdi\":null}\n{\"innstilling\":\"standard_prosjekttype\",\"verdi\":null}\n{\