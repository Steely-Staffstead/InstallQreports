4px}\n</style>\n</head>\n<body>\n<main id=app>\n<header data-qanvas-edit=header><div><h1>Balanseanalyse</h1><div class=sub id=sub></div></div><div id=ctl></div></header>\n<section class=kpis id=kpi data-qanvas-edit=kpis></section>\n<section class='card wrap' data-qanvas-edit=table><h2>Nøkkeltall per selskap</h2><table id=t></table></section>\n<section class=card data-qanvas-edit=chart><h2>Sammensetning av balansen</h2><div id=g></div><div id=l></div></section>\n<section class=card data-qanvas-edit=assess><h2>Vurdering</h2><ul id=as></ul><p class=note>Tommelfingerregler: likviditetsgrad 1 over 1,5 og egenkapitalandel over 20–30 % regnes ofte som solid, men nivået varierer med bransje. Kontroller vurderingen med regnskapsfører eller revisor.</p></section>\n</main>\n<script>\n(function(){\nvar MN=['jan','feb','mar','apr','mai','jun','jul','aug','sep','okt','nov','des'];\nvar AL={selskap:'company firma enhet',kontonr:'konto_nr kontonummer account accountno',konto:'kontonavn accountname account_name',linje:'line rapportlinje',gruppe:'group kategori',periode:'period yyyymm',ib:'inngående opening',bevegelse:'movement',ub:'utgående closing'};\nvar S={co:'',y:0,m:12},CO=[],YR=[];\nvar nf=new Intl.NumberFormat('nb-NO',{maximumFractionDigits:0}),n1=new Intl.NumberFormat('nb-NO',{minimumFractionDigits:1,maximumFractionDigits:1}),n2=new Intl.NumberFormat('nb-NO',{minimumFractionDigits:2,maximumFractionDigits:2});\nfunction el(id){return document.getElementById(id)}\nfunction f(v){return nf.format(Math.round(v||0))}\nfunction mk(v){return n1.format((v||0)/1e6)+' MNOK'}\nfunction pc(v){return isFinite(v)?n1.format(v*100)+' %':'–'}\nfunction dx(v){return isFinite(v)?n2.format(v):'–'}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;'}[c]})}\nfunction kpis(L){return L.map(function(x){return '<div class=\"card kpi\"><div class=l>'+x[0]+'</div><div class=v>'+x[1]+'</div></div>'}).join('')}\nfunction canon(c){c=String(c&&typeof c==='object'?(c.name||c.Name||c.key):c).trim().toLowerCase();for(var k in AL)if(k===c||AL[k].split(' ').indexOf(c)>=0)return k;return c}\nfunction colsOf(s){return ((s&&s.schema&&s.schema.columns)||(s&&s.columns)||[]).map(canon)}\nfunction srcs(p){var s=p.sources;return p.sourceList||(Array.isArray(s)?s:Object.values(s||{}))}\nfunction pick(p,need,tpl){var L=srcs(p).filter(function(s){var c=colsOf(s);return need.every(function(n){return c.indexOf(n)>=0})});return L.filter(function(s){return (s.id||s.sourceId)!==tpl})[0]||L[0]||null}\nfunction num(v){if(v==null||v==='')return 0;return typeof v==='number'?v:(+String(v).replace(/[\\s\\u00a0]/g,'').replace(',','.')||0)}\nfunction per(v){if(typeof v==='number')return v;var m=String(v||'').match(/(\\d{4})\\D?(\\d{1,2})/);return m?(+m[1])*100+(+m[2]):0}\nfunction rowsOf(s){if(!s)return [];var c=colsOf(s);return (s.rows||(s.data&&s.data.rows)||[]).map(function(x){var o={};if(Array.isArray(x))c.forEach(function(k,i){o[k]=x[i]});else for(var k in x)o[canon(k)]=x[k];['ib','bevegelse','ub'].forEach(function(k){o[k]=num(o[k])});o.periode=per(o.periode);o.kontonr=o.kontonr==null||o.kontonr===''?null:num(o.kontonr);if(!o.ub&&(o.ib||o.bevegelse))o.ub=o.ib+o.bevegelse;o.selskap=String(o.selskap||'Selskap');o.y=Math.floor(o.periode/100);o.m=o.periode%100;return o})}\nfunction balKey(r){var n=r.kontonr;if(n>=1000&&n<1400)return 'am';if(n>=1400&&n<1900)return 'om';if(n>=1900&&n<2000)return 'bank';if(n>=2000&&n<2100)return 'ek';if(n>=2100&&n<2300)return 'lg';if(n>=2300&&n<3000)return 'kg';if(n)return null;var l=(String(r.gruppe||'')+' '+String(r.linje||'')).toLowerCase();if(/bank|kontant/.test(l))return 'bank';if(/anlegg/.test(l))return 'am';if(/omløp|fordring|varer/.test(l))return 'om';if(/egenkap|resultat/.test(l))return 'ek';if(/langsiktig/.test(l))return 'lg';if(/gjeld/.test(l))return 'kg';return null}\nfunction loadBal(p){return rowsOf(pick(p,['ub'],'regnskap-balanse')).filter(function(x){x.k=balKey(x);return x.k})}\nfunction balAt(B,lim){var last={},ok=function(x){return !S.co||x.selskap===S.co};B.forEach(function(x){if(ok(x)&&x.periode<=lim&&!(last[x.selskap]>=x.periode))last[x.selskap]=x.periode});if(!Object.keys(last).length)B.forEach(function(x){if(ok(x)&&!(last[x.selskap]>=x.periode))last[x.selskap]=x.periode});return B.filter(function(x){return ok(x)&&last[x.selskap]===x.periode})}\nfunction bsum(R,k){var s=0;R.forEach(function(x){if(x.k===k)s+=x.ub});return s}\nfunction lastM(R){var m=0;R.forEach(function(x){if(x.y===S.y&&x.m>m)m=x.m});return m||12}\nfunction setup(R){CO=[];YR=[];R.forEach(function(x){if(CO.indexOf(x.selskap)<0)CO.push(x.selskap);if(x.y>1900&&YR.indexOf(x.y)<0)YR.push(x.y)});CO.sort();YR.sort();S.y=YR[YR.length-1]||new Date().getFullYear();S.m=lastM(R);if(CO.indexOf(S.co)<0)S.co=''}\nfunction bindCtl(R,cb){var h=el('ctl');h.className='ctl';h.innerHTML='<select id=c-co aria-label=Selskap><option value=\"\">Konsolidert</option>'+CO.map(function(c){return '<option'+(c===S.co?' selected':'')+'>'+esc(c)+'</option>'}).join('')+'</select><select id=c-y aria-label=År>'+YR.map(function(y){return '<option'+(y===S.y?' selected':'')+'>'+y+'</option>'}).join('')+'</select><select id=c-m aria-label=Måned>'+MN.map(function(n,i){return '<option value='+(i+1)+(i+1===S.m?' selected':'')+'>t.o.m. '+n+'</option>'}).join('')+'</select>';el('c-co').onchange=function(e){S.co=e.target.value;cb()};el('c-y').onchange=function(e){S.y=+e.target.value;S.m=lastM(R);cb()};el('c-m').onchange=function(e){S.m=+e.target.value;cb()}}\nfunction boot(fn){if(window.qanvas&&typeof qanvas.init==='function')qanvas.init(function(p){fn(p||{})});else if(window.qanvas&&qanvas.data)fn(qanvas.data)}\nfunction chart(ser,lab,H){var W=760,pl=58,pb=26,pt=12,n=lab.length,v=[0];for(var i=0;i<n;i++){var a=0;ser.forEach(function(s){a+=Math.max(0,s.v[i]||0)});v.push(a)}var mx=Math.max.apply(null,v)||1,Y=function(x){return pt+(mx-x)/mx*(H-pt-pb)},gw=(W-pl)/n,o='<svg viewBox=\"0 0 '+W+' '+H+'\" width=\"100%\" role=\"img\" aria-label=\"Diagram\" font-size=\"11\">';for(var t=0;t<=4;t++){var tv=mx*t/4,ty=Y(tv);o+='<line x1=\"'+pl+'\" x2=\"'+W+'\" y1=\"'+ty+'\" y2=\"'+ty+'\" style=\"stroke:var(--g)\"/><text x=\"'+(pl-6)+'\" y=\"'+(ty+4)+'\" text-anchor=\"end\" style=\"fill:currentColor\">'+n1.format(tv/1e6)+'</text>'}lab.forEach(function(l,i){var x0=pl+gw*i,sw=Math.min(120,gw*0.5),a=0;o+='<text x=\"'+(x0+gw/2)+'\" y=\"'+(H-8)+'\" text-anchor=\"middle\" style=\"fill:currentColor\">'+esc(l)+'</text>';ser.forEach(function(s){var x=Math.max(0,s.v[i]||0);if(!x)return;o+='<rect x=\"'+(x0+(gw-sw)/2)+'\" y=\"'+Y(a+x)+'\" width=\"'+sw+'\" height=\"'+(Y(a)-Y(a+x))+'\" style=\"fill:'+s.c+'\"><title>'+esc(s.n+': '+f(x))+'</title></rect>';a+=x})});return o+'</svg>'}\nfunction legend(ser){return '<div class=lg>'+ser.map(function(s){return '<span><i style=\"background:'+s.c+'\"></i>'+esc(s.n)+'</span>'}).join('')+'</div>'}\nfunction ratios(B){var am=bsum(B,'am'),om=bsum(B,'om'),bk=bsum(B,'bank'),ek=-bsum(B,'ek'),lg=-bsum(B,'lg'),kg=-bsum(B,'kg'),ta=am+om+bk,vl=0;B.forEach(function(x){if(x.k==='om'&&x.kontonr>=1400&&x.kontonr<1500)vl+=x.ub});return {ta:ta,ek:ek,ekA:ek/ta,l1:(om+bk)/kg,l2:(om+bk-vl)/kg,ak:om+bk-kg,gg:(lg+kg)/ek,am:am,om:om,bk:bk,lg:lg,kg:kg}}\nvar BAL=[];\nvar KR=[['Totalkapital',function(r){return f(r.ta)}],['Egenkapital',function(r){return f(r.ek)}],['Egenkapitalandel',function(r){return pc(r.ekA)}],['Likviditetsgrad 1',function(r){return dx(r.l1)}],['Likviditetsgrad 2 (uten varelager)',function(r){return dx(r.l2)}],['Arbeidskapital',function(r){return f(r.ak)}],['Gjeldsgrad',function(r){return dx(r.gg)}]];\nfunction render(){bindCtl(BAL,render);var lim=S.y*100+S.m,keep=S.co;el('sub').textContent=(S.co||'Konsolidert')+' · siste balanse t.o.m. '+MN[S.m-1]+' '+S.y;\nvar cos=S.co?[S.co]:CO.concat(['Konsolidert']),rs=cos.map(function(c){S.co=c==='Konsolidert'?'':c;return ratios(balAt(BAL,lim))});S.co=keep;var R=ratios(balAt(BAL,lim));\nel('t').innerHTML='<thead><tr><th>Nøkkeltall</th>'+cos.map(function(c){return '<th>'+esc(c)+'</th>'}).join('')+'</tr></thead><tbody>'+KR.map(function(k){return '<tr><td>'+k[0]+'</td>'+rs.map(function(r){return '<td>'+k[1](r)+'</td>'}).join('')+'</tr>'}).join('')+'</tbody>';\nel('kpi').innerHTML=kpis([['Egenkapitalandel',pc(R.ekA)],['Likviditetsgrad 1',dx(R.l1)],['Arbeidskapital',mk(R.ak)],['Bankinnskudd',mk(R.bk)]]);\nvar ser=[{n:'Anleggsmidler',c:'var(--c1)',v:[R.am,0]},{n:'Omløpsmidler',c:'var(--c2)',v:[R.om,0]},{n:'Bank',c:'var(--c3)',v:[R.bk,0]},{n:'Egenkapital',c:'var(--c4)',v:[0,R.ek]},{n:'Langsiktig gjeld',c:'var(--a)',v:[0,R.lg]},{n:'Kortsiktig gjeld',c:'var(--n)',v:[0,R.kg]}];el('g').innerHTML=chart(ser,['Eiendeler','Egenkapital og gjeld'],260);el('l').innerHTML=legend(ser);\nvar as=['Egenkapitalandelen er '+pc(R.ekA)+(R.ekA<0.2?', som er lavt og bør følges opp.':R.ekA<0.3?', som er akseptabelt.':', som er godt.'),'Likviditetsgrad 1 er '+dx(R.l1)+(R.l1<1?': kortsiktig gjeld er større enn omløpsmidlene.':R.l1<1.5?': noe stram likviditet.':': god betalingsevne på kort sikt.')];if(R.ek<0)as.push('<b>Negativ egenkapital.</b> Vurder tiltak og avklar med revisor.');el('as').innerHTML=as.map(function(x){return '<li>'+x+'</li>'}).join('')}\nboot(function(p){BAL=loadBal(p);if(!BAL.length){el('kpi').innerHTML='<div class=empty>Fant ingen balansedata. Kilden må ha kolonnen ub.</div>';return}setup(BAL);render()});\n})();\n</script>\n</body>\n</html>","id":"c9e1a3b5-8bad-4fc6-9de3-regn0bala0h05","kind":"html","layer":1,"noBorder":true,"rounding":0,"showHeader":false,"sourceId":"regnskap-balanse","textOverflow":"visible","themeBindings":{"header.background":"headerBackground","header.color":"headerText"},"title":"Balanseanalyse","transparentBackground":true,"width":1248,"x":16,"y":16}]},{"background":{"color":"#e8edf2","fit":"cover","image":"","templatePageId":"","themeRole":"surface","useTheme":true},"canvas":{"extraHeight":0,"height":720,"mode":"flow","presentationResize":"auto","preset":"1280x720","width":1280},"filters":[],"graphics":[],"hidden":false,"id":"e2a4c6d8-0bdf-4c19-9a16-regn0likv0p07","name":"Likviditet og prognose","tiles":[{"background":"#ffffff","borderColor":"#cbd5e1","borderThickness":1,"filters":[],"header":{"background":"#f3f6fa","fontFamily":"Segoe UI","fontSize":13,"color":"#182230","alignment":"left","bold":true,"italic":false,"underline":false},"height":2000,"htmlData":{"sourceIds":["regnskap-database","regnskap-balanse"],"maxRows":20000,"useFilteredContext":true,"bindings":[]},"htmlDocument":"<!doctype html>\n<html lang=no>\n<head>\n<meta charset=utf-8>\n<style>\n:root{--t:var(--qanvas-text,#273629);--s:var(--qanvas-surface,#f7faf5);--g:var(--qanvas-grid,#cbdac7);--hb:var(--qanvas-header-background,#e5eee3);--ht:var(--qanvas-header-text,#2b4d31);--n:var(--qanvas-negative,#ae4d42);--c4:var(--qanvas-color-4,#386641)}\nhtml,body{margin:0;background:transparent;color:var(--t);font:13px 'Segoe UI',Arial,sans-serif}\nmain{padding:8px 4px}\nheader{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:12px}\nh1{font-size:24px;margin:0;color:var(--ht)}\nh2{font-size:15px;margin:0 0 8px;color:var(--ht)}\n.sub{opacity:.75;margin-top:4px}\n.ctl{display:flex;gap:8px;flex-wrap:wrap}\nselect,input,button{font:inherit;color:var(--t);background:var(--s);border:1px solid var(--g);border-radius:4px;padding:4px 6px}\nbutton{cursor:pointer;justify-self:start}\n.card{background:var(--s);border:1px solid var(--g);border-radius:4px;padding:12px 14px;margin-bottom:12px}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}\n.kpi .l{opacity:.75;font-size:12px}\n.kpi .v{font-size:22px;font-weight:700;margin-top:4px}\n.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px 16px;margin-bottom:8px}\nlabel{display:flex;flex-direction:column;gap:4px;font-size:12px}\n.wrap{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-variant-numeric:tabular-num