n1=new Intl.NumberFormat('nb-NO',{minimumFractionDigits:1,maximumFractionDigits:1});\nfunction el(id){return document.getElementById(id)}\nfunction f(v){return nf.format(Math.round(v||0))}\nfunction mk(v){return n1.format((v||0)/1e6)+' MNOK'}\nfunction cl(v){return v<-0.5?' class=neg':''}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;'}[c]})}\nfunction kpis(L){return L.map(function(x){return '<div class=\"card kpi\"><div class=l>'+x[0]+'</div><div class=v>'+x[1]+'</div>'+(x[2]?'<div class=note>'+x[2]+'</div>':'')+'</div>'}).join('')}\nfunction canon(c){c=String(c&&typeof c==='object'?(c.name||c.Name||c.key):c).trim().toLowerCase();for(var k in AL)if(k===c||AL[k].split(' ').indexOf(c)>=0)return k;return c}\nfunction colsOf(s){return ((s&&s.schema&&s.schema.columns)||(s&&s.columns)||[]).map(canon)}\nfunction srcs(p){var s=p.sources;return p.sourceList||(Array.isArray(s)?s:Object.values(s||{}))}\nfunction pick(p,need,tpl){var L=srcs(p).filter(function(s){var c=colsOf(s);return need.every(function(n){return c.indexOf(n)>=0})});return L.filter(function(s){return (s.id||s.sourceId)!==tpl})[0]||L[0]||null}\nfunction num(v){if(v==null||v==='')return 0;return typeof v==='number'?v:(+String(v).replace(/[\\s\\u00a0]/g,'').replace(',','.')||0)}\nfunction per(v){if(typeof v==='number')return v;var m=String(v||'').match(/(\\d{4})\\D?(\\d{1,2})/);return m?(+m[1])*100+(+m[2]):0}\nfunction rowsOf(s){if(!s)return [];var c=colsOf(s);return (s.rows||(s.data&&s.data.rows)||[]).map(function(x){var o={};if(Array.isArray(x))c.forEach(function(k,i){o[k]=x[i]});else for(var k in x)o[canon(k)]=x[k];['belop','ib','bevegelse','ub'].forEach(function(k){o[k]=num(o[k])});o.periode=per(o.periode);o.kontonr=o.kontonr==null||o.kontonr===''?null:num(o.kontonr);if(!o.ub&&(o.ib||o.bevegelse))o.ub=o.ib+o.bevegelse;o.selskap=String(o.selskap||'Selskap');o.y=Math.floor(o.periode/100);o.m=o.periode%100;return o})}\nvar PLL=[['inn'],['vare'],['pers'],['andre'],['avs'],['fin']];\nfunction plKey(r){var n=r.kontonr;if(n>=3000&&n<4000)return 'inn';if(n>=4000&&n<5000)return 'vare';if(n>=5000&&n<6000)return 'pers';if(n>=6000&&n<6100)return 'avs';if(n>=6100&&n<8000)return 'andre';if(n>=8000&&n<8800)return 'fin';if(n)return null;var l=String(r.linje||r.gruppe||'').toLowerCase();if(/avskr|nedskr/.test(l))return 'avs';if(/finans|rente/.test(l))return 'fin';if(/inntekt|salg/.test(l))return 'inn';if(/vare/.test(l))return 'vare';if(/personal|lønn/.test(l))return 'pers';if(/kostnad/.test(l))return 'andre';return null}\nfunction loadPL(p){var r=rowsOf(pick(p,['periode','belop'],'regnskap-database')).filter(function(x){x.k=plKey(x);return x.k&&x.y>1900&&x.m>=1&&x.m<=12});var si=0;r.forEach(function(x){if(x.k==='inn')si+=x.belop});if(si<0)r.forEach(function(x){x.belop=-x.belop});return r}\nfunction balKey(r){var n=r.kontonr;if(n>=1900&&n<2000)return 'bank';if(n)return 'x';var l=(String(r.gruppe||'')+' '+String(r.linje||'')).toLowerCase();return /bank|kontant/.test(l)?'bank':'x'}\nfunction loadBal(p){return rowsOf(pick(p,['ub'],'regnskap-balanse')).filter(function(x){x.k=balKey(x);return true})}\nfunction balAt(B,lim){var last={},ok=function(x){return !S.co||x.selskap===S.co};B.forEach(function(x){if(ok(x)&&x.periode<=lim&&!(last[x.selskap]>=x.periode))last[x.selskap]=x.periode});if(!Object.keys(last).length)B.forEach(function(x){if(ok(x)&&!(last[x.selskap]>=x.periode))last[x.selskap]=x.periode});return B.filter(function(x){return ok(x)&&last[x.selskap]===x.periode})}\nfunction lastM(R){var m=0;R.forEach(function(x){if(x.y===S.y&&x.m>m)m=x.m});return m||12}\nfunction setup(R){CO=[];YR=[];R.forEach(function(x){if(CO.indexOf(x.selskap)<0)CO.push(x.selskap);if(x.y>1900&&YR.indexOf(x.y)<0)YR.push(x.y)});CO.sort();YR.sort();S.y=YR[YR.length-1]||new Date().getFullYear();S.m=lastM(R);if(CO.indexOf(S.co)<0)S.co=''}\nfunction bindCtl(R,cb){var h=el('ctl');h.className='ctl';h.innerHTML='<select id=c-co aria-label=Selskap><option value=\"\">Konsolidert</option>'+CO.map(function(c){return '<option'+(c===S.co?' selected':'')+'>'+esc(c)+'</option>'}).join('')+'</select><select id=c-y aria-label=År>'+YR.map(function(y){return '<option'+(y===S.y?' selected':'')+'>'+y+'</option>'}).join('')+'</select><select id=c-m aria-label=Måned>'+MN.map(function(n,i){return '<option value='+(i+1)+(i+1===S.m?' selected':'')+'>t.o.m. '+n+'</option>'}).join('')+'</select>';el('c-co').onchange=function(e){S.co=e.target.value;cb()};el('c-y').onchange=function(e){S.y=+e.target.value;S.m=lastM(R);cb()};el('c-m').onchange=function(e){S.m=+e.target.value;cb()}}\nfunction inS(x){return (!S.co||x.selskap===S.co)&&x.y===S.y&&x.m<=S.m}\nfunction agg(R){var o={};PLL.forEach(function(l){o[l[0]]=0});R.forEach(function(x){o[x.k]+=x.belop});o.ebitda=o.inn+o.vare+o.pers+o.andre;return o}\nfunction boot(fn){if(window.qanvas&&typeof qanvas.init==='function')qanvas.init(function(p){fn(p||{})});else if(window.qanvas&&qanvas.data)fn(qanvas.data)}\nfunction line(v,lab){var W=760,H=220,pl=58,pb=26,pt=12,n=lab.length,a=v.concat([0]),mx=Math.max.apply(null,a),mn=Math.min.apply(null,a);if(mx===mn)mx=mn+1;var Y=function(x){return pt+(mx-x)/(mx-mn)*(H-pt-pb)},gw=(W-pl)/n,o='<svg viewBox=\"0 0 '+W+' '+H+'\" width=\"100%\" role=\"img\" aria-label=\"Prognose bankbeholdning\" font-size=\"11\">';for(var t=0;t<=4;t++){var tv=mn+(mx-mn)*t/4,ty=Y(tv);o+='<line x1=\"'+pl+'\" x2=\"'+W+'\" y1=\"'+ty+'\" y2=\"'+ty+'\" style=\"stroke:var(--g)\"/><text x=\"'+(pl-6)+'\" y=\"'+(ty+4)+'\" text-anchor=\"end\" style=\"fill:currentColor\">'+n1.format(tv/1e6)+'</text>'}o+='<line x1=\"'+pl+'\" x2=\"'+W+'\" y1=\"'+Y(0)+'\" y2=\"'+Y(0)+'\" style=\"stroke:var(--n);stroke-dasharray:4 3\"/>';var P=v.map(function(x,i){return [pl+gw*i+gw/2,Y(x)]});o+='<polyline fill=\"none\" style=\"stroke:var(--c4);stroke-width:2.5\" points=\"'+P.map(function(q){return q.join(',')}).join(' ')+'\"/>';P.forEach(function(q,i){o+='<circle cx=\"'+q[0]+'\" cy=\"'+q[1]+'\" r=\"3.5\" style=\"fill:'+(v[i]<0?'var(--n)':'var(--c4)')+'\"><title>'+esc(lab[i]+': '+f(v[i]))+'</title></circle><text x=\"'+q[0]+'\" y=\"'+(H-8)+'\" text-anchor=\"middle\" style=\"fill:currentColor\">'+esc(lab[i].split(' ')[0])+'</text>'});return o+'</svg>'}\nvar PL=[],BAL=[],ED=false;\nfunction base(){var R=PL.filter(inS),s=0,k=0;for(var m=Math.max(1,S.m-2);m<=S.m;m++){var o=agg(R.filter(function(x){return x.m===m}));s+=o.ebitda;k++}return k?Math.round(s/k/1000)*1000:0}\nfunction render(full){if(full!==false)bindCtl(PL,function(){ED=false;render()});el('sub').textContent=(S.co||'Konsolidert')+' · start etter '+MN[S.m-1]+' '+S.y;if(!ED)el('i-cf').value=base();\nvar B=balAt(BAL,S.y*100+S.m),bank=0,pr=0;B.forEach(function(x){if(x.k==='bank')bank+=x.ub;if(x.periode>pr)pr=x.periode});\nvar cf=num(el('i-cf').value),inv=num(el('i-inv').value),avd=num(el('i-avd').value),eng=num(el('i-eng').value),em=+el('i-em').value||6,y=S.y,m=S.m,t=bank,lab=[],bal=[],rows='',min=null,used=false;\nfor(var i=0;i<12;i++){m++;if(m>12){m=1;y++}var e=0;if(!used&&m===em){e=eng;used=true}t+=cf-inv-avd-e;var L=MN[m-1]+' '+y;lab.push(L);bal.push(t);if(min===null||t<min.v)min={v:t,l:L};rows+='<tr><td>'+L+'</td><td'+cl(cf)+'>'+f(cf)+'</td><td'+cl(-inv)+'>'+f(-inv)+'</td><td'+cl(-avd)+'>'+f(-avd)+'</td><td'+cl(-e)+'>'+f(-e)+'</td><td'+cl(t)+'><b>'+f(t)+'</b></td></tr>'}\nel('t').innerHTML='<thead><tr><th>Måned</th><th>Drift</th><th>Investeringer</th><th>Avdrag</th><th>Engangs</th><th>Bank UB</th></tr></thead><tbody><tr><td>Start ('+(pr>100?MN[pr%100-1]+' '+Math.floor(pr/100):'ingen balanse')+')</td><td></td><td></td><td></td><td></td><td'+cl(bank)+'><b>'+f(bank)+'</b></td></tr>'+rows+'</tbody>';\nel('g').innerHTML=line(bal,lab);el('kpi').innerHTML=kpis([['Bank i dag',mk(bank),'Siste balanse'],['Laveste prognose',mk(min.v),min.l],['Bank om 12 måneder',mk(t)],['Kontantstrøm per måned',mk(cf-inv-avd)]])}\nel('i-em').innerHTML=MN.map(function(n,i){return '<option value='+(i+1)+(i===5?' selected':'')+'>'+n+'</option>'}).join('');\n['i-cf','i-inv','i-avd','i-eng','i-em'].forEach(function(id){el(id).addEventListener('input',function(){if(id==='i-cf')ED=true;render(false)})});\nel('i-r').addEventListener('click',function(){ED=false;['i-inv','i-avd','i-eng'].forEach(function(id){el(id).value=0});render(false)});\nboot(function(p){PL=loadPL(p);BAL=loadBal(p);if(!PL.length){el('kpi').innerHTML='<div class=empty>Fant ingen resultatdata. Kilden må ha kolonnene periode og belop.</div>';return}setup(PL);render()});\n})();\n</script>\n</body>\n</html>","id":"f3b5d7e9-1ce0-4d2a-8b27-regn0likv0h07","kind":"html","layer":1,"noBorder":true,"rounding":0,"showHeader":false,"sourceId":"regnskap-database","textOverflow":"visible","themeBindings":{"header.background":"headerBackground","header.color":"headerText"},"title":"Likviditet og prognose","transparentBackground":true,"width":1248,"x":16,"y":16}]},{"background":{"color":"#e8edf2","fit":"cover","image":"","templatePageId":"","themeRole":"surface","useTheme":true},"canvas":{"extraHeight":0,"height":720,"mode":"flow","presentationResize":"auto","preset":"1280x720","width":1280},"filters":[],"graphics":[],"hidden":false,"id":"c0e2a4b6-8cad-4fd7-9ef4-regn0scen0p06","name":"Scenario","tiles":[{"background":"#ffffff","borderColor":"#cbd5e1","borderThickness":1,"filters":[],"header":{"background":"#f3f6fa","fontFamily":"Segoe UI","fontSize":13,"color":"#182230","alignment":"left","bold":true,"italic":false,"underline":false},"height":1840,"htmlData":{"sourceIds":["regnskap-database","regnskap-balanse"],"maxRows":20000,"useFilteredContext":true,"bindings":[]},"htmlDocument":"<!doctype html>\n<html lang=no>\n<head>\n<meta charset=utf-8>\n<style>\n:root{--t:var(--qanvas-text,#273629);--s:var(--qanvas-surface,#f7faf5);--a:var(--qanvas-accent,#46744c);--g:var(--qanvas-grid,#cbdac7);--hb:var(--qanvas-header-background,#e5eee3);--ht:var(--qanvas-header-text,#2b4d31);--p:var(--qanvas-positive,#237344);--n:var(--qanvas-negative,#ae4d42)}\nhtml,body{margin:0;background:transparent;color:var(--t);font:13px 'Segoe UI',Arial,sans-serif}\nmain{padding:8px 4px}\nheader{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:12px}\nh1{font-size:24px;margin:0;color:var(--ht)}\nh2{font-size:15px;margin:0 0 8px;color:var(--ht)}\n.sub{opacity:.75;margin-top:4px}\n.ctl{display:flex;gap:8px;flex-wrap:wrap}\nselect,button{font:inherit;color:var(--t);background:var(--s);border:1px solid var(--g);border-radius:4px;padding:4px 6px}\nbutton{cursor:pointer}\ninput[type=range]{width:100%;accent-color:var(--a)}\n.card{background:var(--s);border:1px solid var(--g);border-radius:4px;padding:12px 14px;margin-bottom:12px}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}\n.kpi .l{opacity:.75;font-size:12px}\n.kpi .v{font-size:22px;font-weight:700;margin-top:4px}\n.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px 16px;margin-bottom:8px}\nlabel{display:flex;flex-direction:column;gap:4px;font-size:12px}\nlabel b{font-size:13px}\n.wrap{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}\nth,td{padding:5px 8px;border-bottom:1px solid var(--g);text-align:right;white-space:nowrap}\nth:first-child,td:first-child{text-align:left}\nthead th{background:var(--hb);color:var(--ht)}\ntr.sum td{font-weight:700;border-top:2px solid var(--ht)}\n.neg{color:var(--n)}\n.pos{color:var(--p)}\n.note{font-size:12px;opacity:.8}\n.empty{padding:24px;text-align:center;opacity:.75}\n</style>\n</head>\n<body>\n<main id=app>\n<header data-qanvas-edit=header><div><h1>Scenario – helårsestimat</h1><div class=sub id=sub></div></div><div id=ctl></div></header>\n<section class=card data-qanvas-edit=inputs><h2>Juster forutsetninger for resten av året</h2><div class=form>\n<label>Endring driftsinntekter <b id=v-inn>0 %</b><input type=range min=-30 max=30 step=1 value=0 id=s-inn></label>\n<label>Endring varekostnad (andel av omsetning) <b id=v-vare>0 %</b><input type=range min=-30 max=30 step=1 value=0 id=s-vare></label>\n<label>Endring personalkostnader <b id=v-pers>0 %</b><input type=range min=-30 max=30 step=1 value=0 id=s-pers></label>\n<label>Endring andre driftskostnader <b id=v-andre>0 %</b><input type=range min=-30 max=30 step=1 value=0 id=s-andre></label>\n</div><button id=s-r type=button>Nullstill</button>\n<p class=note>Estimatet bruker faktiske tall hittil i år og snittet av de tre siste månedene for hver resterende måned. Varekostnaden følger omsetningen automatisk, og justeringen kommer i tillegg.</p></section>\n<section class=kpis id=kpi data-qanvas-edit=kpis></section>\n<section class='card wrap' data-qanvas-edit=table><h2>Helårsestimat</h2><table id=t></table></section>\n</main>\n<script>\n(function(){\nvar MN=['jan','feb','mar','apr','mai','jun','jul','aug','sep','okt','nov','des'];\nvar AL={selskap:'company firma enhet',kontonr:'konto_nr kontonummer account accountno',konto:'kontonavn accountname account_name',linje:'line rapportlinje',gruppe:'group kategori',periode:'period yyyymm',belop:'beløp amount sum'};\nvar S={co:'',y:0,m:12},CO=[],YR=[];\nvar nf=new Intl.NumberFormat('nb-NO',{maximumFractionDigits:0}),n1=new Intl.NumberFormat('nb-NO',{minimumFractionDigits:1,maximumFractionDigits:1});\nfunction el(id){return document.getElementById(id)}\nfunction f(v){return nf.format(Math.round(v||0))}\nfunction mk(v){return n1.format((v||0)/1e6)+' MNOK'}\nfunction pc(v){return isFinite(v)?n1.format(v*100)+' %':'–'}\nfunction cl(v){return v<-0.5?' class=neg':''}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;'}[c]})}\nfunction kpis(L){return L.map(function(x){return '<div class=\"card kpi\"><div class=l>'+x[0]+'</div><div class=v>'+x[1]+'</div>'+(x[2]?'<div class=note>'+x[2]+'</div>':'')+'</div>'}).join('')}\nfunction canon(c){c=String(c&&typeof c==='object'?(c.name||c.Name||c.key):c).trim().toLowerCase();for(var k in AL)if(k===c||AL[k].split(' ').indexOf(c)>=0)return k;return c}\nfunction colsOf(s){return ((s&&s.schema&&s.schema.columns)||(s&&s.columns)||[]).map(canon)}\nfunction srcs(p){var s=p.sources;return p.sourceList||(Array.isArray(s)?s:Object.values(s||{}))}\nfunction pick(p,need,tpl){var L=srcs(p).filter(function(s){var c=colsOf(s);return need.every(function(n){return c.indexOf(n)>=0})});return L.filter(function(s){return (s.id||s.sourceId)!==tpl})[0]||L[0]||null}\nfunction num(v){if(v==null||v==='')return 0;return typeof v==='number'?v:(+String(v).replace(/[\\s\\u00a0]/g,'').replace(',','.')||0)}\nfunction per(v){if(typeof v==='number')return v;var m=String(v||'').match(/(\\d{4})\\D?(\\d{1,2})/);return m?(+m[1])*100+(+m[2]):0}\nfunction rowsOf(s){if(!s)return [];var c=colsOf(s);return (s.rows||(s.data&&s.data.rows)||[]).map(function(x){var o={};if(Array.isArray(x))c.forEach(function(k,i){o[k]=x[i]});else for(var k in x)o[canon(k)]=x[k];o.belop=num(o.belop);o.periode=per(o.periode);o.kontonr=o.kontonr==null||o.kontonr===''?null:num(o.kontonr);o.selskap=String(o.selskap||'Selskap');o.y=Math.floor(o.periode/100);o.m=o.periode%100;return o})}\nvar PLL=[['inn'],['vare'],['pers'],['andre'],['avs'],['fin']];\nfunction plKey(r){var n=r.kontonr;if(n>=3000&&n<4000)return 'inn';if(n>=4000&&n<5000)return 'vare';if(n>=5000&&n<6000)return 'pers';if(n>=6000&&n<6100)return 'avs';if(n>=6100&&n<8000)return 'andre';if(n>=8000&&n<8800)return 'fin';if(n)return null;var l=String(r.linje||r.gruppe||'').toLowerCase();if(/avskr|nedskr/.test(l))return 'avs';if(/finans|rente/.test(l))return 'fin';if(/inntekt|salg/.test(l))return 'inn';if(/vare/.test(l))return 'vare';if(/personal|lønn/.test(l))return 'pers';if(/kostnad/.test(l))return 'andre';return null}\nfunction loadPL(p){var r=rowsOf(pick(p,['periode','belop'],'regnskap-database')).filter(function(x){x.k=plKey(x);return x.k&&x.y>1900&&x.m>=1&&x.m<=12});var si=0;r.forEach(function(x){if(x.k==='inn')si+=x.belop});if(si<0)r.forEach(function(x){x.belop=-x.belop});return r}\nfunction lastM(R){var m=0;R.forEach(function(x){if(x.y===S.y&&x.m>m)m=x.m});return m||12}\nfunction setup(R){CO=[];YR=[];R.forEach(function(x){if(CO.indexOf(x.selskap)<0)CO.push(x.selskap);if(x.y>1900&&YR.indexOf(x.y)<0)YR.push(x.y)});CO.sort();YR.sort();S.y=YR[YR.length-1]||new Date().getFullYear();S.m=lastM(R);if(CO.indexOf(S.co)<0)S.co=''}\nfunction bindCtl(R,cb){var h=el('ctl');h.className='ctl';h.innerHTML='<select id=c-co aria-label=Selskap><option value=\"\">Konsolidert</option>'+CO.map(function(c){return '<option'+(c===S.co?' selected':'')+'>'+esc(c)+'</option>'}).join('')+'</select><select id=c-y aria-label=År>'+YR.map(function(y){return '<option'+(y===S.y?' selected':'')+'>'+y+'</option>'}).join('')+'</select><select id=c-m aria-label=Måned>'+MN.map(function(n,i){return '<option value='+(i+1)+(i+1===S.m?' selected':'')+'>t.o.m. '+n+'</option>'}).join('')+'</select>';el('c-co').onchange=function(e){S.co=e.target.value;cb()};el('c-y').onchange=function(e){S.y=+e.target.value;S.m=lastM(R);cb()};el('c-m').onchange=function(e){S.m=+e.target.value;cb()}}\nfunction inS(x){return (!S.co||x.selskap===S.co)&&x.y===S.y&&x.m<=S.m}\nfunction agg(R){var o={};PLL.forEach(function(l){o[l[0]]=0});R.forEach(function(x){o[x.k]+=x.belop});return dv(o)}\nfunction dv(o){o.brutto=o.inn+o.vare;o.ebitda=o.brutto+o.pers+o.andre;o.dr=o.ebitda+o.avs;o.rfs=o.dr+o.fin;return o}\nfunction boot(fn){if(window.qanvas&&typeof qanvas.init==='function')qanvas.init(function(p){fn(p||{})});else if(window.qanvas&&qanvas.data)fn(qanvas.data)}\nvar PL=[],SL=['inn','vare','pers','andre'];\nvar L=[['Driftsinntekter','inn'],['Varekostnad','vare'],['Bruttofortjeneste','brutto',1],['Personalkostnader','pers'],['Andre driftskostnader','andre'],['Driftsresultat før avskrivninger (EBITDA)','ebitda',1],['Avskrivninger','avs'],['Driftsresultat (EBIT)','dr',1],['Finansposter','fin'],['Resultat før skatt','rfs',1]];\nfunction render(full){if(full!==false)bindCtl(PL,render);el('sub').textContent=(S.co||'Konsolidert')+' · faktisk t.o.m. '+MN[S.m-1]+' '+S.y+', estimat for '+(12-S.m)+' måneder';\nvar R=PL.filter(inS),a=agg(R),av={},k=0,rest=12-S.m;PLL.forEach(function(l){av[l[0]]=0});for(var m=Math.max(1,S.m-2);m<=S.m;m++){var o=agg(R.filter(function(x){return x.m===m}));PLL.forEach(function(l){av[l[0]]+=o[l[0]]});k++}PLL.forEach(function(l){av[l[0]]/=k||1});\nvar adj={};SL.forEach(function(s){var v=+el('s-'+s).value;adj[s]=v/100;el('v-'+s).textContent=(v>0?'+':'')+v+' %'});\nvar ri=av.inn*(1+adj.inn),vr=av.inn?av.vare/av.inn:0,sm={inn:ri,vare:ri*vr*(1+adj.vare),pers:av.pers*(1+adj.pers),andre:av.andre*(1+adj.andre),avs:av.avs,fin:av.fin},b={},sc={};PLL.forEach(function(l){b[l[0]]=a[l[0]]+av[l[0]]*rest;sc[l[0]]=a[l[0]]+sm[l[0]]*rest});dv(b);dv(sc);\nel('t').innerHTML='<thead><tr><th>Linje</th><th>Hittil i år</th><th>Basis helår</th><th>Scenario helår</th><th>Endring</th></tr></thead><tbody>'+L.map(function(l){var x=l[1],d=sc[x]-b[x];return '<tr'+(l[2]?' class=sum':'')+'><td>'+l[0]+'</td><td'+cl(a[x])+'>'+f(a[x])+'</td><td'+cl(b[x])+'>'+f(b[x])+'</td><td'+cl(sc[x])+'>'+f(sc[x])+'</td><td class='+(d<-0.5?'neg':'pos')+'>'+(d>0.5?'+':'')+f(d)+'</td></tr>'}).join('')+'</tbody>';\nel('kpi').innerHTML=kpis([['Driftsinntekter helår',mk(sc.inn),'Basis '+mk(b.inn)],['Driftsresultat helår',mk(sc.dr),'Margin '+pc(sc.dr/sc.inn)],['Resultat før skatt helår',mk(sc.rfs),'Endring '+mk(sc.rfs-b.rfs)]])}\nSL.forEach(function(s){el('s-'+s).addEventListener('input',function(){render(false)})});\nel('s-r').addEventListener('click',function(){SL.forEach(function(s){el('s-'+s).value=0});render(false)});\nboot(function(p){PL=loadPL(p);if(!PL.length){el('kpi').innerHTML='<div class=empty>Fant ingen resultatdata. Kilden må ha kolonnene periode og belop.</div>';return}setup(PL);render()});\n})();\n</script>\n</body>\n</html>","id":"d1f3b5c7-9dbe-4ae8-8f05-regn0scen0h06","kind":"html","layer":1,"noBorder":true,"rounding":0,"showHeader":fa