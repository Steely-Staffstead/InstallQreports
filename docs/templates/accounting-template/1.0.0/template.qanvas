r AS\",\"kontonr\":8150,\"konto\":\"Rentekostnader\",\"linje\":\"Finansposter\",\"gruppe\":\"Finanskostnader\",\"periode\":202603,\"belop\":-9000}\n{\"selskap\":\"Fjordvarme Rør AS\",\"kontonr\":8150,\"konto\":\"Rentekostnader\",\"linje\":\"Finansposter\",\"gruppe\":\"Finanskostnader\",\"periode\":202604,\"belop\":-9000}\n{\"selskap\":\"Fjordvarme Rør AS\",\"kontonr\":8150,\"konto\":\"Rentekostnader\",\"linje\":\"Finansposter\",\"gruppe\":\"Finanskostnader\",\"periode\":202605,\"belop\":-9000}\n{\"selskap\":\"Fjordvarme Rør AS\",\"kontonr\":8150,\"konto\":\"Rentekostnader\",\"linje\":\"Finansposter\",\"gruppe\":\"Finanskostnader\",\"periode\":202606,\"belop\":-9000}\n{\"selskap\":\"Fjordvarme Rør AS\",\"kontonr\":8150,\"konto\":\"Rentekostnader\",\"linje\":\"Finansposter\",\"gruppe\":\"Finanskostnader\",\"periode\":202607,\"belop\":-9000}\n{\"selskap\":\"Fjordvarme Rør AS\",\"kontonr\":8150,\"konto\":\"Rentekostnader\",\"linje\":\"Finansposter\",\"gruppe\":\"Finanskostnader\",\"periode\":202608,\"belop\":-9000}\n{\"selskap\":\"Fjordvarme Rør AS\",\"kontonr\":8150,\"konto\":\"Rentekostnader\",\"linje\":\"Finansposter\",\"gruppe\":\"Finanskostnader\",\"periode\":202609,\"belop\":-9000}\n{\"selskap\":\"Fjordvarme Rør AS\",\"kontonr\":8150,\"konto\":\"Rentekostnader\",\"linje\":\"Finansposter\",\"gruppe\":\"Finanskostnader\",\"periode\":202610,\"belop\":-9000}"}],"name":"Regnskapsanalyse – mal","onboarding":{"journey":"report","startedUtc":"2026-11-21T15:55:12.073Z"},"packageVersion":1,"pages":[{"background":{"color":"#e8edf2","fit":"cover","image":"","templatePageId":"","themeRole":"surface","useTheme":true},"canvas":{"extraHeight":0,"height":720,"mode":"flow","presentationResize":"auto","preset":"1280x720","width":1280},"filters":[],"graphics":[],"hidden":false,"id":"a0c2e4f6-1b3d-4e5f-9a7c-regn0fors0p00","name":"Forside","tiles":[{"background":"#ffffff","borderColor":"#cbd5e1","borderThickness":1,"filters":[],"header":{"background":"#f3f6fa","fontFamily":"Segoe UI","fontSize":13,"color":"#182230","alignment":"left","bold":true,"italic":false,"underline":false},"height":980,"htmlData":{"sourceIds":["regnskap-database","regnskap-balanse"],"maxRows":20000,"useFilteredContext":true,"bindings":[]},"htmlDocument":"<!doctype html>\n<html lang=no>\n<head>\n<meta charset=utf-8>\n<style>\n:root{--t:var(--qanvas-text,#273629);--s:var(--qanvas-surface,#f7faf5);--a:var(--qanvas-accent,#46744c);--g:var(--qanvas-grid,#cbdac7);--hb:var(--qanvas-header-background,#e5eee3);--ht:var(--qanvas-header-text,#2b4d31);--p:var(--qanvas-positive,#237344);--n:var(--qanvas-negative,#ae4d42);--c1:var(--qanvas-color-1,#6b705c);--c2:var(--qanvas-color-2,#a5a58d);--c3:var(--qanvas-color-3,#cb997e);--c4:var(--qanvas-color-4,#386641)}\nhtml,body{margin:0;background:transparent;color:var(--t);font:13px 'Segoe UI',Arial,sans-serif}\nmain{padding:8px 4px}\nheader{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:12px}\nh1{font-size:24px;margin:0;color:var(--ht)}\nh2{font-size:15px;margin:0 0 8px;color:var(--ht)}\n.sub{opacity:.75;margin-top:4px}\n.ctl,.lg{display:flex;gap:8px 14px;align-items:center;flex-wrap:wrap}\nselect,input,button{font:inherit;color:var(--t);background:var(--s);border:1px solid var(--g);border-radius:4px;padding:4px 6px}\n.card{background:var(--s);border:1px solid var(--g);border-radius:4px;padding:12px 14px;margin-bottom:12px}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}\n.kpi .l{opacity:.75;font-size:12px}\n.kpi .v{font-size:22px;font-weight:700;margin:4px 0 2px}\n.note{font-size:12px;opacity:.8}\n.empty{padding:24px;text-align:center;opacity:.75}\n.lg{font-size:12px;margin-top:6px}\n.lg i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:middle}\nol.note li{margin-bottom:4px}\n</style>\n</head>\n<body>\n<main id=app>\n<header data-qanvas-edit=header><div><h1>Regnskapsanalyse</h1><div class=sub id=sub></div></div><div id=ctl></div></header>\n<section class=kpis id=kpi data-qanvas-edit=kpis></section>\n<section class=card data-qanvas-edit=chart><h2>Driftsinntekter og driftsresultat per måned</h2><div id=ch></div><div id=lg></div></section>\n<section class=card data-qanvas-edit=guide><h2>Slik bruker du malen</h2><ol class=note>\n<li>Tallene i malen er fiktive. Åpne kilden <b>Database</b> (resultat) eller <b>Balanse</b> via kildemerket, velg <b>Data</b> og lim inn eller last opp egne tall.</li>\n<li>Resultatdata trenger kolonnene <b>selskap, kontonr, konto, periode (ÅÅÅÅMM) og belop</b>, med én rad per konto per måned. Balansedata trenger <b>selskap, kontonr, konto, periode og ub</b>, gjerne også ib og bevegelse.</li>\n<li>Du kan også legge til en egen kilde og velge den på HTML-flisen. Sidene finner automatisk en kilde med riktige kolonner, og en egen kilde brukes før malens eksempeldata. Vanlige alternative kolonnenavn som period, amount, beløp og company gjenkjennes.</li>\n<li>Linjene bygges fra kontonummer etter norsk standard kontoplan (NS 4102). Mangler kontonummer, brukes kolonnen linje. Er inntektene negative i kildedata, snus fortegnet automatisk.</li>\n<li>Konsolidert visning er en enkel sum av selskapene, uten eliminering av interne mellomværender.</li>\n</ol></section>\n</main>\n<script>\n(function(){\nvar MN=['jan','feb','mar','apr','mai','jun','jul','aug','sep','okt','nov','des'];\nvar AL={selskap:'company firma enhet',kontonr:'konto_nr kontonummer account accountno',konto:'kontonavn accountname account_name',linje:'line rapportlinje',gruppe:'group kategori',periode:'period yyyymm',belop:'beløp amount sum',ib:'inngående opening',bevegelse:'movement',ub:'utgående closing'};\nvar S={co:'',y:0,m:12},CO=[],YR=[];\nvar nf=new Intl.NumberFormat('nb-NO',{maximumFractionDigits:0}),n1=new Intl.NumberFormat('nb-NO',{minimumFractionDigits:1,maximumFractionDigits:1});\nfunction el(id){return document.getElementById(id)}\nfunction f(v){return nf.format(Math.round(v||0))}\nfunction mk(v){return n1.format((v||0)/1e6)+' MNOK'}\nfunction pc(v){return isFinite(v)?n1.format(v*100)+' %':'–'}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;'}[c]})}\nfunction kpis(L){return L.map(function(x){return '<div class=\"card kpi\"><div class=l>'+x[0]+'</div><div class=v>'+x[1]+'</div>'+(x[2]?'<div class=note>'+x[2]+'</div>':'')+'</div>'}).join('')}\nfunction canon(c){c=String(c&&typeof c==='object'?(c.name||c.Name||c.key):c).trim().toLowerCase();for(var k in AL)if(k===c||AL[k].split(' ').indexOf(c)>=0)return k;return c}\nfunction colsOf(s){return ((s&&s.schema&&s.schema.columns)||(s&&s.columns)||[]).map(canon)}\nfunction srcs(p){var s=p.sources;return p.sourceList||(Array.isArray(s)?s:Object.values(s||{}))}\nfunction pick(p,need,tpl){var L=srcs(p).filter(function(s){var c=colsOf(s);return need.every(function(n){return c.indexOf(n)>=0})});return L.filter(function(s){return (s.id||s.sourceId)!==tpl})[0]||L[0]||null}\nfunction num(v){if(v==null||v==='')return 0;return typeof v==='number'?v:(+String(v).replace(/[\\s\\u00a0]/g,'').replace(',','.')||0)}\nfunction per(v){if(typeof v==='number')return v;var m=String(v||'').match(/(\\d{4})\\D?(\\d{1,2})/);return m?(+m[1])*100+(+m[2]):0}\nfunction rowsOf(s){if(!s)return [];var c=colsOf(s);return (s.rows||(s.data&&s.data.rows)||[]).map(function(x){var o={};if(Array.isArray(x))c.forEach(function(k,i){o[k]=x[i]});else for(var k in x)o[canon(k)]=x[k];['belop','ib','bevegelse','ub'].forEach(function(k){o[k]=num(o[k])});o.periode=per(o.periode);o.kontonr=o.kontonr==null||o.kontonr===''?null:num(o.kontonr);if(!o.ub&&(o.ib||o.bevegelse))o.ub=o.ib+o.bevegelse;o.selskap=String(o.selskap||'Selskap');o.y=Math.floor(o.periode/100);o.m=o.periode%100;return o})}\nvar PLL=[['inn','Driftsinntekter'],['vare','Varekostnad'],['pers','Personalkostnader'],['andre','Andre driftskostnader'],['avs','Avskrivninger'],['fin','Finansposter']];\nfunction plKey(r){var n=r.kontonr;if(n>=3000&&n<4000)return 'inn';if(n>=4000&&n<5000)return 'vare';if(n>=5000&&n<6000)return 'pers';if(n>=6000&&n<6100)return 'avs';if(n>=6100&&n<8000)return 'andre';if(n>=8000&&n<8800)return 'fin';if(n)return null;var l=String(r.linje||r.gruppe||'').toLowerCase();if(/avskr|nedskr/.test(l))return 'avs';if(/finans|rente/.test(l))return 'fin';if(/inntekt|salg/.test(l))return 'inn';if(/vare/.test(l))return 'vare';if(/personal|lønn/.test(l))return 'pers';if(/kostnad/.test(l))return 'andre';return null}\nfunction loadPL(p){var r=rowsOf(pick(p,['periode','belop'],'regnskap-database')).filter(function(x){x.k=plKey(x);return x.k&&x.y>1900&&x.m>=1&&x.m<=12});var si=0;r.forEach(function(x){if(x.k==='inn')si+=x.belop});if(si<0)r.forEach(function(x){x.belop=-x.belop});return r}\nfunction balKey(r){var n=r.kontonr;if(n>=1000&&n<1400)return 'am';if(n>=1400&&n<1900)return 'om';if(n>=1900&&n<2000)return 'bank';if(n>=2000&&n<2100)return 'ek';if(n>=2100&&n<2300)return 'lg';if(n>=2300&&n<3000)return 'kg';if(n)return null;var l=(String(r.gruppe||'')+' '+String(r.linje||'')).toLowerCase();if(/bank|kontant/.test(l))return 'bank';if(/anlegg/.test(l))return 'am';if(/omløp|fordring|varer/.test(l))return 'om';if(/egenkap|resultat/.test(l))return 'ek';if(/langsiktig/.test(l))return 'lg';if(/gjeld/.test(l))return 'kg';return null}\nfunction loadBal(p){return rowsOf(pick(p,['ub'],'regnskap-balanse')).filter(function(x){x.k=balKey(x);return x.k})}\nfunction balAt(B,lim){var last={},ok=function(x){return !S.co||x.selskap===S.co};B.forEach(function(x){if(ok(x)&&x.periode<=lim&&!(last[x.selskap]>=x.periode))last[x.selskap]=x.periode});if(!Object.keys(last).length)B.forEach(function(x){if(ok(x)&&!(last[x.selskap]>=x.periode))last[x.selskap]=x.periode});return B.filter(function(x){return ok(x)&&last[x.selskap]===x.periode})}\nfunction bsum(R,k){var s=0;R.forEach(function(x){if(x.k===k)s+=x.ub});return s}\nfunction lastM(R){var m=0;R.forEach(function(x){if(x.y===S.y&&x.m>m)m=x.m});return m||12}\nfunction setup(R){CO=[];YR=[];R.forEach(function(x){if(CO.indexOf(x.selskap)<0)CO.push(x.selskap);if(x.y>1900&&YR.indexOf(x.y)<0)YR.push(x.y)});CO.sort();YR.sort();S.y=YR[YR.length-1]||new Date().getFullYear();S.m=lastM(R);if(CO.indexOf(S.co)<0)S.co=''}\nfunction bindCtl(R,cb){var h=el('ctl');h.className='ctl';h.innerHTML='<select id=c-co aria-label=Selskap><option value=\"\">Konsolidert</option>'+CO.map(function(c){return '<option'+(c===S.co?' selected':'')+'>'+esc(c)+'</option>'}).join('')+'</select><select id=c-y aria-label=År>'+YR.map(function(y){return '<option'+(y===S.y?' selected':'')+'>'+y+'</option>'}).join('')+'</select><select id=c-m aria-label=Måned>'+MN.map(function(n,i){return '<option value='+(i+1)+(i+1===S.m?' selected':'')+'>t.o.m. '+n+'</option>'}).join('')+'</select>';el('c-co').onchange=function(e){S.co=e.target.value;cb()};el('c-y').onchange=function(e){S.y=+e.target.value;S.m=lastM(R);cb()};el('c-m').onchange=function(e){S.m=+e.target.value;cb()}}\nfunction inS(x){return (!S.co||x.selskap===S.co)&&x.y===S.y&&x.m<=S.m}\nfunction label(){return (S.co||'Konsolidert')+' · '+S.y+' t.o.m. '+MN[S.m-1]}\nfunction agg(R){var o={};PLL.forEach(function(l){o[l[0]]=0});R.forEach(function(x){o[x.k]+=x.belop});o.brutto=o.inn+o.vare;o.ebitda=o.brutto+o.pers+o.andre;o.dr=o.ebitda+o.avs;o.rfs=o.dr+o.fin;return o}\nfunction byM(R){var a=[];for(var m=1;m<=S.m;m++)a.push(agg(R.filter(function(x){return x.m===m})));return a}\nfunction boot(fn){if(window.qanvas&&typeof qanvas.init==='function')qanvas.init(function(p){fn(p||{})});else if(window.qanvas&&qanvas.data)fn(qanvas.data)}\nfunction chart(type,ser,lab,H){var W=760,pl=58,pb=26,pt=12,n=lab.length||1,v=[0];H=H||240;if(type==='stack'){for(var i=0;i<n;i++){var a=0,b=0;ser.forEach(function(s){var x=s.v[i]||0;if(x>0)a+=x;else b+=x});v.push(a,b)}}else ser.forEach(function(s){v=v.concat(s.v)});var mx=Math.max.apply(null,v),mn=Math.min.apply(null,v);if(mx===mn)mx=mn+1;var Y=function(x){return pt+(mx-x)/(mx-mn)*(H-pt-pb)},gw=(W-pl)/n,o='<svg viewBox=\"0 0 '+W+' '+H+'\" width=\"100%\" role=\"img\" aria-label=\"Diagram\" font-size=\"11\">';for(var t=0;t<=4;t++){var tv=mn+(mx-mn)*t/4,ty=Y(tv);o+='<line x1=\"'+pl+'\" x2=\"'+W+'\" y1=\"'+ty+'\" y2=\"'+ty+'\" style=\"stroke:var(--g)\"/><text x=\"'+(pl-6)+'\" y=\"'+(ty+4)+'\" text-anchor=\"end\" style=\"fill:currentColor\">'+n1.format(tv/1e6)+'</text>'}o+='<line x1=\"'+pl+'\" x2=\"'+W+'\" y1=\"'+Y(0)+'\" y2=\"'+Y(0)+'\" style=\"stroke:currentColor;stroke-opacity:.5\"/>';lab.forEach(function(l,i){var x0=pl+gw*i;o+='<text x=\"'+(x0+gw/2)+'\" y=\"'+(H-8)+'\" text-anchor=\"middle\" style=\"fill:currentColor\">'+esc(l)+'</text>';if(type==='bar'){var bw=Math.min(26,gw*0.8/ser.length);ser.forEach(function(s,j){var x=s.v[i]||0;o+='<rect x=\"'+(x0+(gw-bw*ser.length)/2+j*bw)+'\" y=\"'+Math.min(Y(x),Y(0))+'\" width=\"'+Math.max(1,bw-2)+'\" height=\"'+Math.abs(Y(x)-Y(0))+'\" style=\"fill:'+s.c+'\"><title>'+esc(s.n+' '+l+': '+f(x))+'</title></rect>'})}if(type==='stack'){var sw=Math.min(40,gw*0.6),a=0,b=0;ser.forEach(function(s){var x=s.v[i]||0,b0=x>0?a:b,e=b0+x;if(x>0)a=e;else b=e;if(x)o+='<rect x=\"'+(x0+(gw-sw)/2)+'\" y=\"'+Math.min(Y(b0),Y(e))+'\" width=\"'+sw+'\" height=\"'+Math.abs(Y(b0)-Y(e))+'\" style=\"fill:'+s.c+'\"><title>'+esc(s.n+' '+l+': '+f(x))+'</title></rect>'})}});if(type==='line')ser.forEach(function(s){var P=s.v.map(function(x,i){return [pl+gw*i+gw/2,Y(x)]});o+='<polyline fill=\"none\" style=\"stroke:'+s.c+';stroke-width:2.5\" points=\"'+P.map(function(q){return q.join(',')}).join(' ')+'\"/>'+P.map(function(q,i){return '<circle cx=\"'+q[0]+'\" cy=\"'+q[1]+'\" r=\"3.5\" style=\"fill:'+s.c+'\"><title>'+esc(s.n+' '+lab[i]+': '+f(s.v[i]))+'</title></circle>'}).join('')});return o+'</svg>'}\nfunction legend(ser){return '<div class=lg>'+ser.map(function(s){return '<span><i style=\"background:'+s.c+'\"></i>'+esc(s.n)+'</span>'}).join('')+'</div>'}\nvar PL=[],BAL=[];\nfunction render(){bindCtl(PL,render);el('sub').textContent=label();var R=PL.filter(inS),a=agg(R),B=balAt(BAL,S.y*100+S.m),ta=bsum(B,'am')+bsum(B,'om')+bsum(B,'bank'),ek=-bsum(B,'ek');\nel('kpi').innerHTML=kpis([['Driftsinntekter hittil i år',mk(a.inn)],['Driftsresultat (EBIT)',mk(a.dr),'Margin '+pc(a.dr/a.inn)],['Resultat før skatt',mk(a.rfs),'Margin '+pc(a.rfs/a.inn)],['Bankinnskudd',B.length?mk(bsum(B,'bank')):'–','Siste balanse'],['Egenkapitalandel',B.length?pc(ek/ta):'–','Egenkapital / totalkapital']]);\nvar M=byM(R),ser=[{n:'Driftsinntekter',c:'var(--c1)',v:M.map(function(o){return o.inn})},{n:'Driftsresultat',c:'var(--c4)',v:M.map(function(o){return o.dr})}];\nel('ch').innerHTML=chart('bar',ser,MN.slice(0,S.m));el('lg').innerHTML=legend(ser)}\nboot(function(p){PL=loadPL(p);BAL=loadBal(p);if(!PL.length){el('kpi').innerHTML='<div class=empty>Fant ingen resultatdata. Kilden må ha kolonnene periode og belop.</div>';return}setup(PL);render()});\n})();\n</script>\n</body>\n</html>","id":"b1d3f5a7-2c4e-4f60-8b8d-regn0fors0h00","kind":"html","layer":1,"noBorder":true,"rounding":0,"showHeader":false,"sourceId":"regnskap-database","textOverflow":"visible","themeBindings":{"header.background":"headerBackground","header.color":"headerText"},"title":"Forside","transparentBackground":true,"width":1248,"x":16,"y":16}]},{"background":{"color":"#e8edf2","fit":"cover","image":"","templatePageId":"","themeRole":"surface","useTheme":true},"canvas":{"extraHeight":0,"height":720,"mode":"preset","presentationResize":"auto","preset":"1280x720","width":1280},"filters":[{"basicValues":[],"column":"gruppe","enabled":true,"id":"3d009fac-34ba-4c43-acdb-8bd97945a265","mode":"Multiple","operator":"equals","skip":0,"sourceId":"regnskap-database","value":"","value2":""}],"graphics":[],"hidden":false,"id":"3c83d9f0-6ef9-49c4-9ed7-8480add96bd6","name":"Resultatregnskap","tiles":[{"background":"#ffffff","borderColor":"#cbd5e1","borderThickness":1,"filters":[],"header":{"background":"#f3f6fa","fontFamily":"Segoe UI","fontSize":13,"color":"#182230","alignment":"left","bold":true,"italic":false,"underline":false},"height":688,"htmlData":{"sourceIds":["regnskap-database"],"maxRows":20000,"useFilteredContext":true,"bindings":[]},"htmlDocument":"<!doctype html>\n<html lang=no>\n<head>\n<meta charset=utf-8>\n<style>\n:root{--t:var(--qanvas-text,#273629);--s:var(--qanvas-surface,#f7faf5);--g:var(--qanvas-grid,#cbdac7);--hb:var(--qanvas-header-background,#e5eee3);--ht:var(--qanvas-header-text,#2b4d31);--n:var(--qanvas-negative,#ae4d42)}\nhtml,body{margin:0;background:transparent;color:var(--t);font:13px 'Segoe UI',Arial,sans-serif}\nmain{padding:8px 4px}\nheader{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:12px}\nh1{font-size:24px;margin:0;color:var(--ht)}\n.sub{opacity:.75;margin-top:4px}\n.ctl{display:flex;gap:8px;flex-wrap:wrap}\nselect{font:inherit;color:var(--t);background:var(--s);border:1px solid var(--g);border-radius:4px;padding:4px 6px}\n.card{background:var(--s);border:1px solid var(--g);border-radius:4px;padding:8px 10px;margin-bottom:10px}\n.wrap{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}\nth,td{padding:5px 8px;border-bottom:1px solid var(--g);text-align:right;white-space:nowrap}\nth:first-child,td:first-child{text-align:left}\nthead th{background:var(--hb);color:var(--ht);position:sticky;top:0}\ntr.ln{cursor:pointer}\ntr.ln td:first-child{font-weight:600}\ntr.sum td{font-weight:700;border-top:2px solid var(--ht)}\ntr.acc td{font-size:12px;opacity:.85}\ntr.acc td:first-child{padding-left:24px}\n.neg{color:var(--n)}\n.note{font-size:12px;opacity:.8}\n.empty{padding:24px;text-align:center;opacity:.75}\n</style>\n</head>\n<body>\n<main id=app>\n<header data-qanvas-edit=header><div><h1>Resultatregnskap per måned</h1><div class=sub id=sub></div></div><div id=ctl></div></header>\n<section class='card wrap' data-qanvas-edit=table><table id=t></table></section>\n<p class=note>Klikk på en linje med ▸ for å se kontoene. Inntekter vises som positive tall og kostnader som negative.</p>\n</main>\n<script>\n(function(){\nvar MN=['jan','feb','mar','apr','mai','jun','jul','aug','sep','okt','nov','des'];\nvar AL={selskap:'company firma enhet',kontonr:'konto_nr kontonummer account accountno',konto:'kontonavn accountname account_name',linje:'line rapportlinje',gruppe:'group kategori',periode:'period yyyymm',belop:'beløp amount sum',ib:'inngående opening',bevegelse:'movement',ub:'utgående closing'};\nvar S={co:'',y:0,m:12},CO=[],YR=[];\nvar nf=new Intl.NumberFormat('nb-NO',{maximumFractionDigits:0});\nfunction el(id){return document.getElementById(id)}\nfunction f(v){return nf.format(Math.round(v||0))}\nfunction cl(v){return v<-0.5?' class=neg':''}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;'}[c]})}\nfunction canon(c){c=String(c&&typeof c==='object'?(c.name||c.Name||c.key):c).trim().toLowerCase();for(var k in AL)if(k===c||AL[k].split(' ').indexOf(c)>=0)return k;return c}\nfunction colsOf(s){return ((s&&s.schema&&s.schema.columns)||(s&&s.columns)||[]).map(canon)}\nfunction srcs(p){var s=p.sources;return p.sourceList||(Array.isArray(s)?s:Object.values(s||{}))}\nfunction pick(p,need,tpl){var L=srcs(p).filter(function(s){var c=colsOf(s);return need.every(function(n){return c.indexOf(n)>=0})});return L.filter(function(s){return (s.id||s.sourceId)!==tpl})[0]||L[0]||null}\nfunction num(v){if(v==null||v==='')return 0;return typeof v==='number'?v:(+String(v).replace(/[\\s\\u00a0]/g,'').replace(',','.')||0)}\nfunction per(v){if(typeof v==='number')return v;var m=String(v||'').match(/(\\d{4})\\D?(\\d{1,2})/);return m?(+m[1])*100+(+m[2]):0}\nfunction rowsOf(s){if(!s)return [];var c=colsOf(s);return (s.rows||(s.data&&s.data.rows)||[]).map(function(x){var o={};if(Array.isArray(x))c.forEach(function(k,i){o[k]=x[i]});else for(var k in x)o[canon(k)]=x[k];o.belop=num(o.belop);o.periode=per(o.periode);o.kontonr=o.kontonr==null||o.kontonr===''?null:num(o.kontonr);o.selskap=String(o.selskap||'Selskap');o.y=Math.floor(o.periode/100);o.m=o.periode%100;return o})}\nfunction plKey(r){var n=r.kontonr;if(n>=3000&&n<4000)return 'inn';if(n>=4000&&n<5000)return 'vare';if(n>=5000&&n<6000)return 'pers';if(n>=6000&&n<6100)return 'avs';if(n>=6100&&n<8000)return 'andre';if(n>=8000&&n<8800)return 'fin';if(n)return null;var l=String(r.linje||r.gruppe||'').toLowerCase();if(/avskr|nedskr/.test(l))return 'avs';if(/finans|rente/.test(l))return 'fin';if(/inntekt|salg/.test(l))return 'inn';if(/vare/.test(l))return 'vare';if(/personal|lønn/.test(l))return 'pers';if(/kostnad/.test(l))return 'andre';return null}\nfunction loadPL(p){var r=rowsOf(pick(p,['periode','belop'],'regnskap-database')).filter(function(x){x.k=plKey(x);return x.k&&x.y>1900&&x.m>=1&&x.m<=12});var si=0;r.forEach(function(x){if(x.k==='inn')si+=x.belop});if(si<0)r.forEach(function(x){x.belop=-x.belop});return r}\nfunction lastM(R){var m=0;R.forEach(function(x){if(x.y===S.y&&x.m>m)m=x.m});return m||12}\nfunction setup(R){CO=[];YR=[];R.forEach(function(x){if(CO.indexOf(x.selskap)<0)CO.push(x.selskap);if(x.y>1900&&YR.indexOf(x.y)<0)YR.push(x.y)});CO.sort();YR.sort();S.y=YR[YR.length-1]||new Date().getFullYear();S.m=lastM(R);if(CO.indexOf(S.co)<0)S.co=''}\nfunction bindCtl(R,cb){var h=el('ctl');h.className='ctl';h.innerHTML='<select id=c-co aria-label=Selskap><option value=\"\">Konsolidert</option>'+CO.map(function(c){return '<option'+(c===S.co?' selected':'')+'>'+esc(c)+'</option>'}).join('')+'</select><select id=c-y aria-label=År>'+YR.map(function(y){return '<option'+(y===S.y?' selected':'')+'>'+y+'</option>'}).join('')+'</select><select id=c-m aria-label=Måned>'+MN.map(function(n,i){return '<option value='+(i+1)+(i+1===S.m?' selected':'')+'>t.o.m. '+n+'</option>'}).join('')+'</select>';el('c-co').onchange=function(e){S.co=e.target.value;cb()};el('c-y').onchange=function(e){S.y=+e.target.value;S.m=lastM(R);cb()};el('c-m').onchange=function(e){S.m=+e.target.value;cb()}}\nfunction inS(x){return (!S.co||x.selskap===S.co)&&x.y===S.y&&x.m<=S.m}\nfunction boot(fn){if(window.qanvas&&typeof qanvas.init==='function')qanvas.init(function(p){fn(p||{})});else if(window.qanvas&&qanvas.data)fn(qanvas.data)}\nvar PL=[],OPEN={};\nfunction render(){bindCtl(PL,render);el('sub').textContent=(S.co||'Konsolidert')+' · '+S.y+' t.o.m. '+MN[S.m-1];var R=PL.filter(inS),ms=[];for(var m=1;m<=S.m;m++)ms.push(m);\nfunction row(lbl,fn,cls,attr){var t=0,c=ms.map(function(m){var v=fn(m);t+=v;return '<td'+cl(v)+'>'+f(v)+'</td>'}).join('');return '<tr'+(cls?' class='+cls:'')+(attr||'')+'><td>'+lbl+'</td>'+c+'<td'+cl(t)+'><b>'+f(t)+'</b></td></tr>'}\nfunction sk(k,m){var s=0;R.forEach(function(x){if(x.k===k&&x.m===m)s+=x.belop});return s}\nfunction aid(x){return (x.kontonr||'')+' '+(x.konto||'')}\nfunction lineRows(k,lbl){var o=row((OPEN[k]?'▾ ':'▸ ')+lbl,function(m){return sk(k,m)},'ln',' data-k='+k);if(OPEN[k]){var acc={};R.forEach(function(x){if(x.k===k)acc[aid(x)]=1});Object.keys(acc).sort().forEach(function(id){o+=row(esc(id),function(m){var s=0;R.forEach(function(x){if(x.k===k&&x.m===m&&aid(x)===id)s+=x.belop});return s},'acc')})}return o}\nfunction calc(lbl,ks){return row(lbl,function(m){var s=0;ks.forEach(function(k){s+=sk(k,m)});return s},'sum')}\nel('t').innerHTML='<thead><tr><th>Linje</th>'+ms.map(function(m){return '<th>'+MN[m-1]+'</th>'}).join('')+'<th>Sum</th></tr></thead><tbody>'+lineRows('inn','Driftsinntekter')+lineRows('vare','Varekostnad')+calc('Bruttofortjeneste',['inn','vare'])+lineRows('pers','Personalkostnader')+lineRows('andre','Andre driftskostnader')+calc('Driftsresultat før avskrivninger (EBITDA)',['inn','vare','pers','andre'])+lineRows('avs','Avskrivninger')+calc('Driftsresultat (EBIT)',['inn','vare','pers','andre','avs'])+lineRows('fin','Finansposter')+calc('Resultat før skatt',['inn','vare','pers','andre','avs','fin'])+'</tbody>'}\nel('t').addEventListener('click',function(e){var tr=e.target.closest('tr[data-k]');if(tr){var k=tr.getAttribute('data-k');OPEN[k]=!OPEN[k];render()}});\nboot(function(p){PL=loadPL(p);if(!PL.length){el('t').innerHTML='<tr><td class=empty>Fant ingen resultatdata. Kilden må ha kolonnene periode og belop.</td></tr>';return}setup(PL);render()});\n})();\n</script>\n</body>\n</html>","id":"7f1c2a90-3b6e-4d8a-9c41-regn0p1html01","kind":"html","layer":1,"noBorder":true,"rounding":0,"showHeader":false,"sourceId":"regnskap-database","textOverflow":"scroll","themeBindings":{"header.background":"headerBackground","header.color":"headerText"},"title":"Resultatregnskap","transparentBackground":true,"width":1248,"x":16,"y":16}]},{"background":{"color":"#e8edf2","fit":"cover","image":"","templatePageId":"","themeRole":"surface","useTheme":true},"canvas":{"extraHeight":0,"height":720,"mode":"flow","presentationResize":"auto","preset":"1280x720","width":1280},"filters":[],"graphics":[],"hidden":false,"id":"b2d4e6f8-1a3c-4e5f-8a7b-regn0bal0p02","name":"Balanse","tiles":[{"background":"#ffffff","borderColor":"#cbd5e1","borderThickness":1,"filters":[],"header":{"background":"#f3f6fa","fontFamily":"Segoe UI","fontSize":13,"color":"#182230","alignment":"left","bold":true,"italic":false,"underline":false},"height":925,"htmlData":{"sourceIds":["regnskap-balanse"],"maxRows":20000,"useFilteredContext":true,"bindings":[]},"htmlDocument":"<!doctype html>\n<html lang=no>\n<head>\n<meta charset=utf-8>\n<style>\n:root{--t:var(--qanvas-text,#273629);--s:var(--qanvas-surface,#f7faf5);--g:var(--qanvas-grid,#cbdac7);--hb:var(--qanvas-header-background,#e5eee3);--ht:var(--qanvas-header-text,#2b4d31);--p:var(--qanvas-positive,#237344);--n:var(--qanvas-negative,#ae4d42)}\nhtml,body{margin:0;background:transparent;color:var(--t);font:13px 'Segoe UI',Arial,sans-serif}\nmain{padding:8px 4px}\nheader{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:12px}\nh1{font-size:24px;margin:0;color:var(--ht)}\n.sub{opacity:.75;margin-top:4px}\n.ctl{display:flex;gap:8px;flex-wrap:wrap}\nselect{font:inherit;color:var(--t);background:var(--s);border:1px solid var(--g);border-radius:4px;padding:4px 6px}\n.card{background:var(--s);border:1px solid var(--g);border-radius:4px;padding:8px 10px;margin-bottom:10px}\ntable{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}\nth,td{padding:5px 8px;border-bottom:1px solid var(--g);text-align:right;white-space:nowrap}\nth:first-child,td:first-child{text-align:left}\nthead th{background:var(--hb);color:var(--ht)}\ntr.ln{cursor:pointer}\ntr.ln td:first-child,tr.hd td{font-weight:600}\ntr.hd td{background:var(--hb);color:var(--ht)}\ntr.sum td{font-weight:700;border-top:2px solid var(--ht)}\ntr.acc td{font-size:12px;opacity:.85}\ntr.acc td:first-child{padding-left:24px}\n.neg{color:var(--n)}\n.pos{color:var(--p)}\n.note{font-size:12px;opacity:.8}\n.empty{padding:24px;text-align:center;opacity:.75}\n</style>\n</head>\n<body>\n<main id=app>\n<header data-qanvas-edit=header><div><h1>Balanse</h1><div class=sub id=sub></div></div><div id=ctl></div></header>\n<section class=card data-qanvas-edit=table><table id=t></table></section>\n<p class=note id=chk></p>\n<p class=note>Viser siste balanseperiode til og med valgt måned. Egenkapital og gjeld vises som positive tall. Klikk på en linje med ▸ for å se kontoene.</p>\n</main>\n<script>\n(function(){\nvar MN=['jan','feb','mar','apr','mai','jun','jul','aug','sep','okt','nov','des'];\nvar AL={selskap:'company firma enhet',kontonr:'konto_nr kontonummer account accountno',konto:'kontonavn accountname account_name',linje:'line rapportlinje',gruppe:'group kategori',periode:'period yyyymm',ib:'inngående opening',bevegelse:'movement',ub:'utgående closing'};\nvar S={co:'',y:0,m:12},CO=[],YR=[];\nvar nf=new Intl.NumberFormat('nb-NO',{maximumFractionDigits:0});\nfunction el(id){return document.getElementById(id)}\nfunction f(v){return nf.format(Math.round(v||0))}\nfunction cl(v){return v<-0.5?' class=neg':''}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;'}[c]})}\nfunction canon(c){c=String(c&&typeof c==='object'?(c.name||c.Name||c.key):c).trim().toLowerCase();for(var k in AL)if(k===c||AL[k].split(' ').indexOf(c)>=0)return k;return c}\nfunction colsOf(s){return ((s&&s.schema&&s.schema.columns)||(s&&s.columns)||[]).map(canon)}\nfunction srcs(p){var s=p.sources;return p.sourceList||(Array.isArray(s)?s:Object.values(s||{}))}\nfunction pick(p,need,tpl){var L=srcs(p).filter(function(s){var c=colsOf(s);return need.every(function(n){return c.indexOf(n)>=0})});return L.filter(function(s){return (s.id||s.sourceId)!==tpl})[0]||L[0]||null}\nfunction num(v){if(v==null||v==='')return 0;return typeof v==='number'?v:(+String(v).replace(/[\\s\\u00a0]/g,'').replace(',','.')||0)}\nfunction per(v){if(typeof v==='number')return v;var m=String(v||'').match(/(\\d{4})\\D?(\\d{1,2})/);return m?(+m[1])*100+(+m[2]):0}\nfunction rowsOf(s){if(!s)return [];var c=colsOf(s);return (s.rows||(s.data&&s.data.rows)||[]).map(function(x){var o={};if(Array.isArray(x))c.forEach(function(k,i){o[k]=x[i]});else for(var k in x)o[canon(k)]=x[k];['ib','bevegelse','ub'].forEach(function(k){o[k]=num(o[k])});o.periode=per(o.periode);o.kontonr=o.kontonr==null||o.kontonr===''?null:num(o.kontonr);if(!o.ub&&(o.ib||o.bevegelse))o.ub=o.ib+o.bevegelse;o.selskap=String(o.selskap||'Selskap');o.y=Math.floor(o.periode/100);o.m=o.periode%100;return o})}\nvar BLL=[['am','Anleggsmidler',1],['om','Omløpsmidler',1],['bank','Bankinnskudd og kontanter',1],['ek','Egenkapital',-1],['lg','Langsiktig gjeld',-1],['kg','Kortsiktig gjeld',-1]];\nfunction balKey(r){var n=r.kontonr;if(n>=1000&&n<1400)return 'am';if(n>=1400&&n<1900)return 'om';if(n>=1900&&n<2000)return 'bank';if(n>=2000&&n<2100)return 'ek';if(n>=2100&&n<2300)return 'lg';if(n>=2300&&n<3000)return 'kg';if(n)return null;var l=(String(r.gruppe||'')+' '+String(r.linje||'')).toLowerCase();if(/bank|kontant/.test(l))return 'bank';if(/anlegg/.test(l))return 'am';if(/omløp|fordring|varer/.test(l))return 'om';if(/egenkap|resultat/.test(l))return 'ek';if(/langsiktig/.test(l))return 'lg';if(/gjeld/.test(l))return 'kg';return null}\nfunction loadBal(p){return rowsOf(pick(p,['ub'],'regnskap-balanse')).filter(function(x){x.k=balKey(x);return x.k})}\nfunction balAt(B,lim){var last={},ok=function(x){return !S.co||x.selskap===S.co};B.forEach(function(x){if(ok(x)&&x.periode<=lim&&!(last[x.selskap]>=x.periode))last[x.selskap]=x.periode});if(!Object.keys(last).length)B.forEach(function(x){if(ok(x)&&!(last[x.selskap]>=x.periode))last[x.selskap]=x.periode});return B.filter(function(x){return ok(x)&&last[x.selskap]===x.periode})}\nfunction lastM(R){var m=0;R.forEach(function(x){if(x.y===S.y&&x.m>m)m=x.m});return m||12}\nfunction setup(R){CO=[];YR=[];R.forEach(function(x){if(CO.indexOf(x.selskap)<0)CO.push(x.selskap);if(x.y>1900&&YR.indexOf(x.y)<0)YR.push(x.y)});CO.sort();YR.sort();S.y=YR[YR.length-1]||new Date().getFullYear();S.m=lastM(R);if(CO.indexOf(S.co)<0)S.co=''}\nfunction bindCtl(R,cb){var h=el('ctl');h.className='ctl';h.innerHTML='<select id=c-co aria-label=Selskap><option value=\"\">Konsolidert</option>'+CO.map(function(c){return '<option'+(c===S.co?' selected':'')+'>'+esc(c)+'</option>'}).join('')+'</select><select id=c-y aria-label=År>'+YR.map(function(y){return '<option'+(y===S.y?' selected':'')+'>'+y+'</option>'}).join('')+'</select><select id=c-m aria-label=Måned>'+MN.map(function(n,i){return '<option value='+(i+1)+(i+1===S.m?' selected':'')+'>t.o.m. '+n+'</option>'}).join('')+'</select>';el('c-co').onchange=function(e){S.co=e.target.value;cb()};el('c-y').onchange=function(e){S.y=+e.target.value;S.m=lastM(R);cb()};el('c-m').onchange=function(e){S.m=+e.target.value;cb()}}\nfunction boot(fn){if(window.qanvas&&typeof qanvas.init==='function')qanvas.init(function(p){fn(p||{})});else if(window.qanvas&&qanvas.data)fn(qanvas.data)}\nvar BAL=[],OPEN={};\nfunction render(){bindCtl(BAL,render);var B=balAt(BAL,S.y*100+S.m),pr=0;B.forEach(function(x){if(x.periode>pr)pr=x.periode});el('sub').textContent=(S.co||'Konsolidert')+' · balanse per '+(pr>100?MN[pr%100-1]+' '+Math.floor(pr/100):'siste periode');\nfunction tr(lbl,R,sg,cls,attr){var a=0,b=0,c=0;R.forEach(function(x){a+=x.ib*sg;b+=x.bevegelse*sg;c+=x.ub*sg});return '<tr'+(cls?' class='+cls:'')+(attr||'')+'><td>'+lbl+'</td><td'+cl(a)+'>'+f(a)+'</td><td'+cl(b)+'>'+f(b)+'</td><td'+cl(c)+'>'+f(c)+'</td></tr>'}\nfunction side(keys,title){var o='<tr class=hd><td colspan=4>'+title+'</td></tr>',all=[];keys.forEach(function(L){var R=B.filter(function(x){return x.k===L[0]});if(!R.length)return;all=all.concat(R);o+=tr((OPEN[L[0]]?'▾ ':'▸ ')+L[1],R,L[2],'ln',' data-k='+L[0]);if(OPEN[L[0]]){var g={};R.forEach(function(x){var id=(x.kontonr||'')+' '+(x.konto||'');(g[id]=g[id]||[]).push(x)});Object.keys(g).sort().forEach(function(id){o+=tr(esc(id),g[id],L[2],'acc')})}});return {h:o,r:all}}\nvar e=side(BLL.slice(0,3),'Eiendeler'),q=side(BLL.slice(3),'Egenkapital og gjeld'),diff=0;B.forEach(function(x){diff+=x.ub});\nel('t').innerHTML='<thead><tr><th>Post</th><th>IB</th><th>Bevegelse</th><th>UB</th></tr></thead><tbody>'+e.h+tr('Sum eiendeler',e.r,1,'sum')+q.h+tr('Sum egenkapital og gjeld',q.r,-1,'sum')+'</tbody>';\nel('chk').innerHTML=Math.abs(diff)>1?'<span class=neg>Kontroll: balansen går ikke opp (differanse '+f(diff)+'). Sjekk at årets resultat er med.</span>':'<span class=pos>Kontroll: eiendeler er lik egenkapital og gjeld.</span>'}\nel('t').addEventListener('click',function(e){var r=e.target.closest('tr[data-k]');if(r){var k=r.getAttribute('data-k');OPEN[k]=!OPEN[k];render()}});\nboot(function(p){BAL=loadBal(p);if(!BAL.length){el('t').innerHTML='<tr><td class=empty>Fant ingen balansedata. Kilden må ha kolonnen ub.</td></tr>';return}setup(BAL);render()});\n})();\n</script>\n</body>\n</html>","id":"c3e5a7b9-2b4d-4f60-9b8c-regn0bal0h02","kind":"html","layer":1,"noBorder":true,"rounding":0,"showHeader":false,"sourceId":"regnskap-balanse","textOverflow":"visible","themeBindings":{"header.background":"headerBackground","header.color":"headerText"},"title":"Balanse","transparentBackground":true,"width":1240,"x":25,"y":16}]},{"background":{"color":"#e8edf2","fit":"cover","image":"","templatePageId":"","themeRole":"surface","useTheme":true},"canvas":{"extraHeight":0,"height":720,"mode":"flow","presentationResize":"auto","preset":"1280x720","width":1280},"filters":[],"graphics":[],"hidden":false,"id":"d4f6b8c0-3c5e-4a71-8c9d-regn0anal0p03","name":"Driftsanalyse","tiles":[{"background":"#ffffff","borderColor":"#cbd5e1","borderThickness":1,"filters":[],"header":{"background":"#f3f6fa","fontFamily":"Segoe UI","fontSize":13,"color":"#182230","alignment":"left","bold":true,"italic":false,"underline":false},"height":1500,"htmlData":{"sourceIds":["regnskap-database","regnskap-balanse"],"maxRows":20000,"useFilteredContext":true,"bindings":[]},"htmlDocument":"<!doctype html>\n<html lang=no>\n<head>\n<meta charset=utf-8>\n<style>\n:root{--t:var(--qanvas-text,#273629);--s:var(--qanvas-surface,#f7faf5);--g:var(--qanvas-grid,#cbdac7);--hb:var(--qanvas-header-background,#e5eee3);--ht:var(--qanvas-header-text,#2b4d31);--n:var(--qanvas-negative,#ae4d42)}\nhtml,body{margin:0;background:transparent;color:var(--t);font:13px 'Segoe UI',Arial,sans-serif}\nmain{padding:8px 4px}\nheader{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:12px}\nh1{font-size:24px;margin:0;color:var(--ht)}\nh2{font-size:15px;margin:0 0 8px;color:var(--ht)}\n.sub{opacity:.75;margin-top:4px}\n.ctl{display:flex;gap:8px;flex-wrap:wrap}\nselect{font:inherit;color:var(--t);background:var(--s);border:1px solid var(--g);border-radius:4px;padding:4px 6px}\n.card{background:var(--s);border:1px solid var(--g);border-radius:4px;padding:12px 14px;margin-bottom:12px}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}\n.kpi .l{opacity:.75;font-size:12px}\n.kpi .v{font-size:22px;font-weight:700;margin-top:4px}\n.wrap{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}\nth,td{padding:5px 8px;border-bottom:1px solid var(--g);text-align:right;white-space:nowrap}\nth:first-child,td:first-child{text-align:left}\nthead th{background:var(--hb);color:var(--ht)}\n.note{font-size:12px;opacity:.8}\n.empty{padding:24px;text-align:center;opacity:.75}\nli{margin-bottom:4px}\n</style>\n</head>\n<body>\n<main id=app>\n<header data-qanvas-edit=header><div><h1>Driftsanalyse</h1><div class=sub id=sub></div></div><div id=ctl></div></header>\n<section class=kpis id=kpi data-qanvas-edit=kpis></section>\n<section class='card wrap' data-qanvas-edit=table><h2>Nøkkeltall per måned</h2><table id=t></table></section>\n<section class=card data-qanvas-edit=assess><h2>Vurdering</h2><ul id=as></ul><p class=note>Vurderingen lages automatisk fra tallene og må kvalitetssikres før den brukes i rapportering.</p></section>\n</main>\n<script>\n(function(){\nvar MN=['jan','feb','mar','apr','mai','jun','jul','aug','sep','okt','nov','des'];\nvar AL={selskap:'company firma enhet',kontonr:'konto_nr kontonummer account accountno',konto:'kontonavn accountname account_name',linje:'line rapportlinje',gruppe:'group kategori',periode:'period yyyymm',belop:'beløp amount sum'};\nvar S={co:'',y:0,m:12},CO=[],YR=[];\nvar nf=new Intl.NumberFormat('nb-NO',{maximumFractionDigits:0}),n1=new Intl.NumberFormat('nb-NO',{minimumFractionDigits:1,maximumFractionDigits:1});\nfunction el(id){return document.getElementById(id)}\nfunction f(v){return nf.format(Math.round(v||0))}\nfunction pc(v){return isFinite(v)?n1.format(v*100)+' %':'–'}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;'}[c]})}\nfunction kpis(L){return L.map(function(x){return '<div class=\"card kpi\"><div class=l>'+x[0]+'</div><div class=v>'+x[1]+'</div></div>'}).join('')}\nfunction canon(c){c=String(c&&typeof c==='object'?(c.name||c.Name||c.key):c).trim().toLowerCase();for(var k in AL)if(k===c||AL[k].split(' ').indexOf(c)>=0)return k;return c}\nfunction colsOf(s){return ((s&&s.schema&&s.schema.columns)||(s&&s.columns)||[]).map(canon)}\nfunction srcs(p){var s=p.sources;return p.sourceList||(Array.isArray(s)?s:Object.values(s||{}))}\nfunction pick(p,need,tpl){var L=srcs(p).filter(function(s){var c=colsOf(s);return need.every(function(n){return c.indexOf(n)>=0})});return L.filter(function(s){return (s.id||s.sourceId)!==tpl})[0]||L[0]||null}\nfunction num(v){if(v==null||v==='')return 0;return typeof v==='number'?v:(+String(v).replace(/[\\s\\u00a0]/g,'').replace(',','.')||0)}\nfunction per(v){if(typeof v==='number')return v;var m=String(v||'').match(/(\\d{4})\\D?(\\d{1,2})/);return m?(+m[1])*100+(+m[2]):0}\nfunction rowsOf(s){if(!s)return [];var c=colsOf(s);return (s.rows||(s.data&&s.data.rows)||[]).map(function(x){var o={};if(Array.isArray(x))c.forEach(function(k,i){o[k]=x[i]});else for(var k in x)o[canon(k)]=x[k];o.belop=num(o.belop);o.periode=per(o.periode);o.kontonr=o.kontonr==null||o.kontonr===''?null:num(o.kontonr);o.selskap=String(o.selskap||'Selskap');o.y=Math.floor(o.periode/100);o.m=o.periode%100;return o})}\nvar PLL=[['inn'],['vare'],['pers'],['andre'],['avs'],['fin']];\nfunction plKey(r){var n=r.kontonr;if(n>=3000&&n<4000)return 'inn';if(n>=4000&&n<5000)return 'vare';if(n>=5000&&n<6000)return 'pers';if(n>=6000&&n<6100)return 'avs';if(n>=6100&&n<8000)return 'andre';if(n>=8000&&n<8800)return 'fin';if(n)return null;var l=String(r.linje||r.gruppe||'').toLowerCase();if(/avskr|nedskr/.test(l))return 'avs';if(/finans|rente/.test(l))return 'fin';if(/inntekt|salg/.test(l))return 'inn';if(/vare/.test(l))return 'vare';if(/personal|lønn/.test(l))return 'pers';if(/kostnad/.test(l))return 'andre';return null}\nfunction loadPL(p){var r=rowsOf(pick(p,['periode','belop'],'regnskap-database')).filter(function(x){x.k=plKey(x);return x.k&&x.y>1900&&x.m>=1&&x.m<=12});var si=0;r.forEach(function(x){if(x.k==='inn')si+=x.belop});if(si<0)r.forEach(function(x){x.belop=-x.belop});return r}\nfunction lastM(R){var m=0;R.forEach(function(x){if(x.y===S.y&&x.m>m)m=x.m});return m||12}\nfunction setup(R){CO=[];YR=[];R.forEach(function(x){if(CO.indexOf(x.selskap)<0)CO.push(x.selskap);if(x.y>1900&&YR.indexOf(x.y)<0)YR.push(x.y)});CO.sort();YR.sort();S.y=YR[YR.length-1]||new Date().getFullYear();S.m=lastM(R);if(CO.indexOf(S.co)<0)S.co=''}\nfunction bindCtl(R,cb){var h=el('ctl');h.className='ctl';h.innerHTML='<select id=c-co aria-label=Selskap><option value=\"\">Konsolidert</option>'+CO.map(function(c){return '<option'+(c===S.co?' selected':'')+'>'+esc(c)+'</option>'}).join('')+'</select><select id=c-y aria-label=År>'+YR.map(function(y){return '<option'+(y===S.y?' selected':'')+'>'+y+'</option>'}).join('')+'</select><select id=c-m aria-label=Måned>'+MN.map(function(n,i){return '<option value='+(i+1)+(i+1===S.m?' selected':'')+'>t.o.m. '+n+'</option>'}).join('')+'</select>';el('c-co').onchange=function(e){S.co=e.target.value;cb()};el('c-y').onchange=function(e){S.y=+e.target.value;S.m=lastM(R);cb()};el('c-m').onchange=function(e){S.m=+e.target.value;cb()}}\nfunction inS(x){return (!S.co||x.selskap===S.co)&&x.y===S.y&&x.m<=S.m}\nfunction agg(R){var o={};PLL.forEach(function(l){o[l[0]]=0});R.forEach(function(x){o[x.k]+=x.belop});o.brutto=o.inn+o.vare;o.ebitda=o.brutto+o.pers+o.andre;o.dr=o.ebitda+o.avs;o.rfs=o.dr+o.fin;return o}\nfunction byM(R){var a=[];for(var m=1;m<=S.m;m++)a.push(agg(R.filter(function(x){return x.m===m})));return a}\nfunction boot(fn){if(window.qanvas&&typeof qanvas.init==='function')qanvas.init(function(p){fn(p||{})});else if(window.qanvas&&qanvas.data)fn(qanvas.data)}\nvar PL=[];\nvar K=[['Driftsinntekter',function(o){return f(o.inn)}],['Bruttomargin',function(o){return pc(o.brutto/o.inn)}],['Lønnsandel',function(o){return pc(-o.pers/o.inn)}],['Andre driftskostnader, andel',function(o){return pc(-o.andre/o.inn)}],['EBITDA-margin',function(o){return pc(o.ebitda/o.inn)}],['Driftsmargin',function(o){return pc(o.dr/o.inn)}],['Resultat før skatt',function(o){return f(o.rfs)}]];\nfunction render(){bindCtl(PL,render);el('sub').textContent=(S.co||'Konsolidert')+' · '+S.y+' t.o.m. '+MN[S.m-1];var R=PL.filter(inS),M=byM(R),a=agg(R);\nel('t').innerHTML='<thead><tr><th>Nøkkeltall</th>'+M.map(function(o,i){return '<th>'+MN[i]+'</th>'}).join('')+'<th>Hittil</th></tr></thead><tbody>'+K.map(function(k){return '<tr><td>'+k[0]+'</td>'+M.map(function(o){return '<td>'+k[1](o)+'</td>'}).join('')+'<td><b>'+k[1](a)+'</b></td></tr>'}).join('')+'</tbody>';\nvar py=PL.filter(function(x){return (!S.co||x.selskap===S.co)&&x.y===S.y-1&&x.m<=S.m}),b=agg(py);\nel('kpi').innerHTML=kpis([['Bruttomargin',pc(a.brutto/a.inn)],['EBITDA-margin',pc(a.ebitda/a.inn)],['Driftsmargin',pc(a.dr/a.inn)],['Vekst mot i fjor',py.length?pc(a.inn/b.inn-1):'Ingen fjorårstall']]);\nvar v=M.map(function(o,i){return {m:MN[i],d:o.inn?o.dr/o.inn:0,i:o.inn}}).filter(function(o){return o.i}),as=[];\nif(v.length){var s=v.slice().sort(function(x,y){return y.d-x.d});as.push('Høyeste driftsmargin i <b>'+s[0].m+'</b> ('+pc(s[0].d)+'), laveste i <b>'+s[s.length-1].m+'</b> ('+pc(s[s.length-1].d)+').');if(v.length>=6){var av=function(L){return L.reduce(function(t,o){return t+o.d},0)/L.length},h1=av(v.slice(0,3)),h2=av(v.slice(-3));as.push('Snittmarginen de tre siste månedene er '+pc(h2)+', '+(h2>=h1?'opp':'ned')+' '+n1.format(Math.abs(h2-h1)*100)+' prosentpoeng fra årets tre første måneder.')}}\nif(a.inn)as.push('Lønnsandelen hittil i år er '+pc(-a.pers/a.inn)+' av driftsinntektene.');if(a.dr<0)as.push('<b>Driftsresultatet er negativt</b> hittil i år.');\nel('as').innerHTML=as.map(function(x){return '<li>'+x+'</li>'}).join('')}\nboot(function(p){PL=loadPL(p);if(!PL.length){el('kpi').innerHTML='<div class=empty>Fant ingen resultatdata. Kilden må ha kolonnene periode og belop.</div>';return}setup(PL);render()});\n})();\n</script>\n</body>\n</html>