            "maxRows": 0,
            "useFilteredContext": true,
            "bindings": []
          },
          "htmlDocument": "<!doctype html><html><head><meta charset=\"utf-8\"><style>*{box-sizing:border-box}html,body{margin:0;background:transparent;color:#1d2939;font:13px/1.5 Segoe UI,system-ui,sans-serif}h1{margin:0;font-size:22px}p{margin:2px 0 0;color:#5d6b82}section{background:#fff;border:1px solid #d5dce8;border-radius:12px;padding:14px 16px;margin-bottom:12px}h2{margin:0 0 8px;font-size:15px}ul{margin:0;padding-left:18px}li{margin:0 0 6px}.note{padding:10px 12px;border-radius:10px;background:#eef2fa;color:#5d6b82;font-size:12.5px}</style></head><body><section><h2>How it works</h2><p style=\"margin:0;color:inherit\">The <b>Tasks</b> page is a board on its own data: it is not linked to a Gantt or a database. Drag cards between columns, and use ＋ on a column to add a task.</p></section><section><h2>What you can change</h2><ul><li><b>Statuses and priorities</b> – the guide, or List designer › Fields.</li><li><b>Card fields</b> – List designer › Board › Fields on cards.</li><li><b>Table or board</b> – List designer › Layout.</li></ul></section><div class=\"note\">This page is only for getting started. The last step in the guide removes it.</div></body></html>"
        },
