          "rounding": 4,
          "filters": [],
          "setupGuide": {
            "title": "Get started with Project board",
            "intro": "Replace the examples with your own people, projects and tasks.",
            "ganttTileId": "project-gantt",
            "steps": [
              {
                "id": "owners",
                "type": "owners"
