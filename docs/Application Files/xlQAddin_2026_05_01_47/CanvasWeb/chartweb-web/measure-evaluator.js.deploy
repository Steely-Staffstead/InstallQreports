(() => {
  const ci=(object,...names)=>{for(const [key,value] of Object.entries(object||{}))if(names.some(name=>key.toLowerCase()===String(name).toLowerCase()))return value;};
  const metricName=metric=>String(ci(metric,"OutputName","Name")||"");
  const metricFormula=metric=>String(ci(metric,"CustomFormula","Formula","Expression")||"").trim();
  const fieldIndex=(columns,name)=>{const clean=String(name||"").trim().replace(/^'[^']+'\s*\[/,"").replace(/^\[/,"").replace(/\]$/,"").replace(/['`]/g,"");return columns.findIndex(column=>String(column).toLowerCase()===clean.toLowerCase());};
  const splitArgs=text=>{const result=[];let depth=0,quote="",start=0;for(let i=0;i<text.length;i++){const ch=text[i];if(quote){if(ch===quote&&text[i-1]!=="\\")quote="";continue;}if(ch==='"'||ch==="'"){quote=ch;continue;}if(ch==="(")depth++;else if(ch===")")depth--;else if(ch===","&&depth===0){result.push(text.slice(start,i).trim());start=i+1;}}result.push(text.slice(start).trim());return result.filter(Boolean);};
  const unquote=value=>{const text=String(value??'').trim();return((text[0]==='"'&&text.at(-1)==='"')||(text[0]==="'"&&text.at(-1)==="'"))?text.slice(1,-1):text;};
  const pad=(value,length=2)=>String(value).padStart(length,'0');
  const formatValue=(value,pattern)=>{pattern=unquote(pattern);if(value===null||value===undefined||value===''||(typeof value==='number'&&!Number.isFinite(value)))return'';const parsedDate=value instanceof Date?value:new Date(value);if(Number.isFinite(parsedDate.getTime())&&/[yMdHhms]/.test(pattern)){const replacements={yyyy:pad(parsedDate.getFullYear(),4),yyy:pad(parsedDate.getFullYear(),4),yy:pad(parsedDate.getFullYear()%100),MM:pad(parsedDate.getMonth()+1),M:String(parsedDate.getMonth()+1),dd:pad(parsedDate.getDate()),d:String(parsedDate.getDate()),HH:pad(parsedDate.getHours()),H:String(parsedDate.getHours()),mm:pad(parsedDate.getMinutes()),ss:pad(parsedDate.getSeconds())};return pattern.replace(/yyyy|yyy|yy|MM|M|dd|d|HH|H|mm|ss/g,token=>replacements[token]);}const number=Number(value);if(Number.isFinite(number)){const decimals=/[0#][.,]([0#]+)/.exec(pattern)?.[1].length;if(Number.isInteger(decimals))return number.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals});if(/^N\d+$/i.test(pattern)){const digits=Number(pattern.slice(1));return number.toLocaleString(undefined,{minimumFractionDigits:digits,maximumFractionDigits:digits});}}return String(value);};
  const stripOuter=text=>{text=text.trim();while(text[0]==="("&&text.at(-1)===")"){let depth=0,whole=true;for(let i=0;i<text.length;i++){if(text[i]==="(")depth++;else if(text[i]===")")depth--;if(depth===0&&i<text.length-1){whole=false;break;}}if(!whole)break;text=text.slice(1,-1).trim();}return text;};
  function topOperator(text,operators){let depth=0,quote="";for(let i=text.length-1;i>=0;i--){const ch=text[i];if(quote){if(ch===quote&&text[i-1]!=="\\")quote="";continue;}if(ch==='"'||ch==="'"){quote=ch;continue;}if(ch===")")depth++;else if(ch==="(")depth--;else if(depth===0&&operators.includes(ch)){if((ch==="+"||ch==="-")&&(i===0||"(,+-*/".includes(text[i-1])))continue;return i;}}return-1;}
  const reduce=(values,kind)=>{const present=values.filter(value=>value!==null&&value!==undefined&&String(value).trim()!==''),mode=String(kind||'').toUpperCase();if(mode==='COUNT')return present.length;if(mode==='FIRST')return present[0]??'';if(mode==='LAST')return present.at(-1)??'';if(mode==='MIN'||mode==='MAX'){if(!present.length)return'';const numbers=present.map(value=>Number(value));if(numbers.every(Number.isFinite)){const target=mode==='MIN'?Math.min(...numbers):Math.max(...numbers);return present[numbers.indexOf(target)];}const dates=present.map(value=>Date.parse(value));if(dates.every(Number.isFinite)){const target=mode==='MIN'?Math.min(...dates):Math.max(...dates);return present[dates.indexOf(target)];}return [...present].sort((a,b)=>String(a).localeCompare(String(b),undefined,{numeric:true,sensitivity:'base'}))[mode==='MIN'?0:present.length-1];}const numbers=present.map(Number).filter(Number.isFinite);if(!numbers.length)return NaN;if(/average|avg/i.test(mode))return numbers.reduce((a,b)=>a+b,0)/numbers.length;return numbers.reduce((a,b)=>a+b,0);};
  function compare(left,operator,right){const a=Number(left),b=Number(right),numeric=Number.isFinite(a)&&Number.isFinite(b),x=numeric?a:String(left??"").toLowerCase(),y=numeric?b:String(right??"").toLowerCase();if(operator==="=")return x===y;if(operator==="<>"||operator==="!=")return x!==y;if(operator===">")return x>y;if(operator==="<")return x<y;if(operator===">=")return x>=y;if(operator==="<=")return x<=y;return false;}
  function filtered(rows,filter,columns){const match=/^\s*(.+?)\s*(<>|!=|>=|<=|=|>|<)\s*(.*?)\s*$/.exec(filter);if(!match)return rows;const index=fieldIndex(columns,match[1]);if(index<0)return rows;let expected=match[3].trim();if((expected[0]==="'"&&expected.at(-1)==="'")||(expected[0]==='"'&&expected.at(-1)==='"'))expected=expected.slice(1,-1);return rows.filter(row=>compare(row[index],match[2],expected));}
  function create(data,measures){const columns=data?.columns||[],allRows=data?.rows||[],map=new Map((measures||[]).map(metric=>[metricName(metric).toLowerCase(),metric]));
    function expression(source,rows,visiting=new Set(),variables=new Map()){
      let text=stripOuter(String(source||"").replace(/\s*-{2,}\s*/g," - ").replace(/\r?\n/g," ").trim());if(!text)return NaN;
      if(/^VAR\b/i.test(text)){
        const local=new Map(variables),returnAt=text.search(/\bRETURN\b/i);if(returnAt<0)return NaN;
        const declarations=text.slice(0,returnAt),pattern=/\bVAR\s+([A-Z_][A-Z0-9_]*)\s*=\s*([\s\S]*?)(?=\bVAR\s+[A-Z_][A-Z0-9_]*\s*=|$)/gi;let match;
        while((match=pattern.exec(declarations)))local.set(match[1].toLowerCase(),expression(match[2],rows,visiting,local));
        return expression(text.slice(returnAt+6),rows,visiting,local);
      }
      if(text[0]==="-")return-expression(text.slice(1),rows,visiting,variables);
      if(text[0]==="+")return expression(text.slice(1),rows,visiting,variables);
      let at=topOperator(text,["&"]);if(at>=0)return String(expression(text.slice(0,at),rows,visiting,variables)??'')+String(expression(text.slice(at+1),rows,visiting,variables)??'');
      at=topOperator(text,["+","-"]);if(at>=0){const a=expression(text.slice(0,at),rows,visiting,variables),b=expression(text.slice(at+1),rows,visiting,variables);return text[at]==="+"?a+b:a-b;}
      at=topOperator(text,["*","/"]);if(at>=0){const a=expression(text.slice(0,at),rows,visiting,variables),b=expression(text.slice(at+1),rows,visiting,variables);return text[at]==="*"?a*b:(b===0?NaN:a/b);}
      const fn=/^([A-Z][A-Z0-9_]*)\s*\(([\s\S]*)\)$/i.exec(text);if(fn){const name=fn[1].toUpperCase(),args=splitArgs(fn[2]);if(name==="CALCULATE"){let scoped=rows;for(const filter of args.slice(1))scoped=filtered(scoped,filter,columns);return expression(args[0],scoped,visiting,variables);}if(["SUM","AVERAGE","AVG","MIN","MAX","COUNT","FIRST","LAST"].includes(name)){let scoped=rows;for(const filter of args.slice(1))scoped=filtered(scoped,filter,columns);const index=fieldIndex(columns,args[0]);return index<0?NaN:reduce(scoped.map(row=>row[index]),name);}if(name==="FORMAT")return formatValue(expression(args[0],rows,visiting,variables),args[1]||'');if(name==="CONCATENATE")return args.map(arg=>expression(arg,rows,visiting,variables)).filter(value=>value!==null&&value!==undefined).join('');if(name==="MID"){const source=String(expression(args[0],rows,visiting,variables)??''),start=Math.max(1,Math.trunc(Number(expression(args[1],rows,visiting,variables))||1)),length=Math.max(0,Math.trunc(Number(expression(args[2],rows,visiting,variables))||0));return source.slice(start-1,start-1+length);}if(name==="CAST"){const value=expression(args[0],rows,visiting,variables),type=unquote(args[1]).toLowerCase();if(["string","text","varchar","nvarchar","char"].includes(type))return value==null?'':String(value);if(["date","datetime","datetime2"].includes(type)){const date=new Date(value);return Number.isFinite(date.getTime())?date.toISOString():NaN;}if(["int","integer","long","bigint"].includes(type)){const number=Number(String(value).replace(',','.'));return Number.isFinite(number)?Math.trunc(number):NaN;}if(["number","numeric","decimal","double","float","real"].includes(type)){const number=Number(String(value).replace(',','.'));return Number.isFinite(number)?number:NaN;}if(["bool","boolean","bit"].includes(type)){if(typeof value==='boolean')return value;const normalized=String(value??'').trim().toLowerCase();if(["true","1","yes"].includes(normalized))return true;if(["false","0","no"].includes(normalized))return false;return NaN;}return NaN;}if(["YEAR","MONTH","DAY"].includes(name)){const date=new Date(expression(args[0],rows,visiting,variables));return Number.isFinite(date.getTime())?(name==="YEAR"?date.getFullYear():name==="MONTH"?date.getMonth()+1:date.getDate()):NaN;}if(name==="DATEPART"){const part=unquote(args[0]).toLowerCase(),date=new Date(expression(args[1],rows,visiting,variables));if(!Number.isFinite(date.getTime()))return NaN;if(["yy","yyyy","year"].includes(part))return date.getFullYear();if(["qq","q","quarter"].includes(part))return Math.floor(date.getMonth()/3)+1;if(["mm","m","month"].includes(part))return date.getMonth()+1;if(["dy","y","dayofyear"].includes(part)){const start=new Date(date.getFullYear(),0,0);return Math.floor((date-start)/86400000);}if(["dd","d","day"].includes(part))return date.getDate();if(["wk","ww","week"].includes(part)){const target=new Date(date);target.setHours(0,0,0,0);target.setDate(target.getDate()+3-(target.getDay()+6)%7);const week1=new Date(target.getFullYear(),0,4);return 1+Math.round(((target-week1)/86400000-3+(week1.getDay()+6)%7)/7);}if(["dw","weekday"].includes(part))return(date.getDay()+6)%7+1;if(["hh","hour"].includes(part))return date.getHours();if(["mi","n","minute"].includes(part))return date.getMinutes();if(["ss","s","second"].includes(part))return date.getSeconds();return NaN;}if(name==="DATEFROMPARTS"){const year=Number(expression(args[0],rows,visiting,variables)),month=Number(expression(args[1],rows,visiting,variables)),day=Number(expression(args[2],rows,visiting,variables)),date=new Date(year,month-1,day);return Number.isInteger(year)&&Number.isInteger(month)&&Number.isInteger(day)&&date.getFullYear()===year&&date.getMonth()===month-1&&date.getDate()===day?`${String(year).padStart(4,'0')}-${pad(month)}-${pad(day)}`:NaN;}if(name==="DIVIDE"){const a=expression(args[0],rows,visiting,variables),b=expression(args[1],rows,visiting,variables);return b===0?expression(args[2]||"0",rows,visiting,variables):a/b;}if(name==="NEG")return-expression(args[0],rows,visiting,variables);return NaN;}
      if((text[0]==='"'&&text.at(-1)==='"')||(text[0]==="'"&&text.at(-1)==="'"))return unquote(text);const number=Number(text);if(Number.isFinite(number))return number;const ref=text.replace(/^\[|\]$/g,"").trim();if(variables.has(ref.toLowerCase()))return variables.get(ref.toLowerCase());const metric=map.get(ref.toLowerCase());if(metric){if(visiting.has(ref.toLowerCase()))return NaN;const next=new Set(visiting);next.add(ref.toLowerCase());return expression(metricFormula(metric),rows,next,variables);}const index=fieldIndex(columns,ref);return index<0?NaN:reduce(rows.map(row=>row[index]),"SUM");
    }
    function evaluate(field,rows=allRows,aggregation="Sum"){const metric=map.get(String(field||"").toLowerCase());if(metric)return expression(metricFormula(metric),rows,new Set([String(field).toLowerCase()]));const index=fieldIndex(columns,field);return index>=0?reduce(rows.map(row=>row[index]),aggregation):NaN;}
    return{evaluate,canEvaluate:field=>fieldIndex(columns,field)>=0||map.has(String(field||"").toLowerCase()),allRows};
  }
  window.CanvasMeasureEvaluator={create};
})();
