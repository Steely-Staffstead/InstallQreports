  [["value","Ycolumn"],["category","Xcolumn"],["group","GroupBy"],["subgroup","SubgroupBy"]].forEach(([id,key])=>$("#"+id).addEventListener("change",event=>{style()[key]=event.target.value;if(key==="Ycolumn"){if(!series().length)series().push({Id:uid(),ColumnName:event.target.value,Kind:"Bar"});else{series()[0].ColumnName=event.target.value;series()[0].LegendText=event.target.value;}}render();}));
