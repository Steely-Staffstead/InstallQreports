  let observedChartSize="",resizeTimer=0;new ResizeObserver(entries=>{const rect=entries[0]?.contentRect,key=`${Math.round(rect?.width||0)}x${Math.round(rect?.height||0)}`;if(!documentModel||key===observedChartSize)return;observedChartSize=key;clearTimeout(resizeTimer);resizeTimer=setTimeout(renderChart,80);}).observe($("#chart"));document.addEventListener("pointerdown",event=>{if(!event.target.closest(".chart-options-context"))document.querySelector(".chart-options-context")?.remove();});host?.addEventListener("message",event=>{if(event.data.type==="load"){documentModel=event.data.document;hydrated=false;render();}if(event.data.type==="loadSample"){documentModel=sample();hydrated=false;render();}if(event.data.type==="error")$("#error").textContent=event.data.message;});host?.postMessage({type:"ready"});if(!host){documentModel=sample();hydrated=false;render();}
