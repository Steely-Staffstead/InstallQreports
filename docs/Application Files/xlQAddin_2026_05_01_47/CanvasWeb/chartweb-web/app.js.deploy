  function renderSeriesTargets(){const groups=[[$("#showValueLabels")?.closest("details"),"labels",["ShowValueLabels","LabelShowCategory","LabelShowSeriesName","LabelShowValue","LabelDelimiter","LabelPosition","ValueLabelFormat","ValueLabelColor","ValueLabelAngle","ValueLabelSize","DataLabelSpacingPercent"]],[$("#markerOptions"),"line",["LineThickness","LineStyle","LineShadePercent","ShowMarkers","FilledMarkers","MarkerType","MarkerSize"]],[$("#scatterOptions"),"scatter",["ScatterSizeField","ScatterSizeMin","ScatterSizeMax","ScatterRegression","ScatterConnectPoints","ScatterLollipop"]]];for(const[panel,kind,keys]of groups){if(!panel)continue;let select=panel.querySelector(`[data-series-target="${kind}"]`);if(!select){const label=document.createElement("label");label.className="series-target";label.innerHTML=`Settings for<select data-series-target="${kind}"></select>`;panel.querySelector("summary")?.after(label);select=label.querySelector("select");select.onchange=()=>{seriesTargets[kind]=select.value;renderControls();};}select.innerHTML=`<option value="all">All series</option>${series().map((item,index)=>`<option value="${index}">${String(item.LegendText||item.ColumnName||`Series ${index+1}`).replaceAll("&","&amp;").replaceAll("<","&lt;")}</option>`).join("")}`;select.value=seriesTargets[kind];const target=seriesTargets[kind]==="all"?null:series()[+seriesTargets[kind]],overrides=target?.SeriesOptions||{};if(kind==="scatter")$("#scatterSizeOverride").classList.toggle("hidden",!target);if(target)for(const key of keys){const input=optionInput(key);if(!input||overrides[key]===undefined)continue;if(input.type==="checkbox")input.checked=!!overrides[key];else input.value=overrides[key];}}}
  function optionInput(key){const mapping={ShowValueLabels:"#showValueLabels",LabelShowCategory:"#labelCategory",LabelShowSeriesName:"#labelSeries",LabelShowValue:"#labelValue",LabelDelimiter:"#labelDelimiter",LabelPosition:"#labelPosition",ValueLabelFormat:"#valueLabelFormat",ValueLabelColor:"#valueLabelColor",ValueLabelAngle:"#valueLabelAngle",ValueLabelSize:"#valueLabelSize",DataLabelSpacingPercent:"#dataLabelSpacing",LineThickness:"#lineThickness",LineStyle:"#lineStyle",LineShadePercent:"#lineShadePercent",ShowMarkers:"#showMarkers",FilledMarkers:"#filledMarkers",MarkerType:"#markerType",MarkerSize:"#markerSize",ScatterSizeField:"#scatterSizeField",ScatterSizeMin:"#scatterSizeMin",ScatterSizeMax:"#scatterSizeMax",ScatterRegression:"#scatterRegression",ScatterConnectPoints:"#scatterConnect",ScatterLollipop:"#scatterLollipop"};return $(mapping[key]);}

  function correctFixedChartText(){/* SVGs preserve aspect ratio; keep authored text rotations intact. */}
  function refreshJsonEditor(force=false){const editor=$("#json"),section=editor?.closest("details");if(!editor||(!force&&!section?.open))return;editor.value=JSON.stringify(documentModel,null,2);}
  function replaceChartMarkup(chart,markup){const template=document.createElement("template");template.innerHTML=markup;chart.replaceChildren(template.content.cloneNode(true));void chart.offsetWidth;}
  function renderChart(){normalize();syncSettings();const chart=$("#chart"),type=window.CanvasChartRenderer.typeName(spec().Kind),rect=chart.getBoundingClientRect();try{const markup=window.CanvasChartRenderer.render({data:documentModel.data,measures:documentModel.measures,spec:documentModel.spec,settingsJson:documentModel.settingsJson||"",fallbackField:style().Ycolumn,interactive:true,viewportWidth:rect.width,viewportHeight:rect.height,paletteColors:chartPaletteColors(opt("PaletteName","Default")),themeRoles:documentModel.canvasTheme?.roles});replaceChartMarkup(chart,markup);if(["gauge","treemap","heatmap"].includes(type))chart.insertAdjacentHTML("beforeend",`<button class="chart-overlay-resize" data-chart-size="${type}" title="Drag to resize chart" aria-label="Resize chart"></button>`);correctFixedChartText(chart);const filters=documentModel.filterSummary||{};$("#status").textContent=`${documentModel.data.rows.length.toLocaleString()} rows · ${series().length} series · global filters: ${filters.globalFilters||0} · local filters: ${filters.localFilters||0}`;$("#error").textContent="";}catch(error){console.error("Chart preview update failed",error);$("#status").textContent="Chart preview update failed";$("#error").textContent=`Chart preview update failed: ${error?.message||error}`;}refreshJsonEditor();}
  function syncMultipleControl(){const subgroup=$("#subgroup");subgroup.disabled=false;const label=subgroup.closest("label");if(label){label.childNodes[0].nodeValue="Multiple ";const help=label.querySelector("small");if(help)help.textContent="split series or small charts";}setChecked("#showAsMultiples",bool("ShowAsMultiples",false));setValue("#multipleMax",opt("MultipleMaxCount",12));setChecked("#multipleAlignValue",bool("MultipleAlignValueAxis",true));setChecked("#multipleAlignCategory",bool("MultipleAlignCategoryAxis",true));setValue("#multipleRows",opt("MultipleRows",""));setValue("#multipleColumns",opt("MultipleColumns",""));setValue("#multipleSpacing",opt("MultipleSpacing",8));setValue("#multipleHeaderAlignment",opt("MultipleHeaderAlignment","Left"));setValue("#multipleHeaderSize",opt("MultipleHeaderSize",11));setValue("#multipleHeaderColor",opt("MultipleHeaderColor","#34425e"));setChecked("#multipleHeaderBold",bool("MultipleHeaderBold",true));setChecked("#multipleHeaderItalic",bool("MultipleHeaderItalic",false));setChecked("#multipleHeaderUnderline",bool("MultipleHeaderUnderline",false));}
  function render(){let controlsError=null;try{renderControls();syncMultipleControl();}catch(error){controlsError=error;console.error("Chart controls update failed",error);}renderChart();if(controlsError)$("#error").textContent=`Chart controls update failed: ${controlsError?.message||controlsError}`;}
  function setType(value){spec().Kind=value;series().forEach((item,index)=>{if(value==="combo")item.Kind=index?"Line":"Bar";else if(["line","area","scatter","heatmap"].includes(value))item.Kind=value[0].toUpperCase()+value.slice(1);else item.Kind="Bar";});if(value==="heatmap"&&!style().GroupBy)style().GroupBy=dimensions().find(name=>name!==style().Xcolumn)||"";render();}
  function updateOption(key,value,rerender=true){if(key==="PaletteName"){value=QReportsPalette.name(value);options().PaletteColors=value==="Canvas"?[]:[...(QReportsPalette.catalog(documentModel.canvasPalettes).find(item=>item.name===value)?.colors||builtInPalettes[value]||builtInPalettes.Default)];setValue("#paletteName",value);setValue("#treemapPaletteName",value);}const labelKeys=new Set(["ShowValueLabels","LabelShowCategory","LabelShowSeriesName","LabelShowValue","LabelDelimiter","LabelPosition","ValueLabelFormat","ValueLabelColor","ValueLabelAngle","ValueLabelSize","DataLabelSpacingPercent"]),lineKeys=new Set(["LineThickness","LineStyle","LineShadePercent","ShowMarkers","FilledMarkers","MarkerType","MarkerSize"]),scatterKeys=new Set(["ScatterSizeField","ScatterSizeMin","ScatterSizeMax","ScatterRegression","ScatterConnectPoints","ScatterLollipop"]),kind=labelKeys.has(key)?"labels":lineKeys.has(key)?"line":scatterKeys.has(key)?"scatter":"";if(kind&&seriesTargets[kind]!=="all"){const item=series()[+seriesTargets[kind]];if(item){item.SeriesOptions||={};item.SeriesOptions[key]=value;}}else options()[key]=value;if(rerender)renderChart();}
  function beginTitleEdit(){const chart=$("#chart");chart.querySelector(".chart-inline-title")?.remove();const editor=document.createElement("input");editor.className="chart-inline-title";editor.value=style().HeaderText||spec().Name||"Chart";chart.append(editor);editor.focus();editor.select();let done=false;const finish=commit=>{if(done)return;done=true;if(commit&&editor.value.trim()){style().HeaderText=editor.value.trim();style().HeaderTextManual=editor.value.trim();spec().Name=editor.value.trim();setValue("#title",style().HeaderText);}editor.remove();renderChart();};editor.addEventListener("keydown",event=>{if(event.key==="Enter")finish(true);if(event.key==="Escape")finish(false);});editor.addEventListener("blur",()=>finish(true));}
  function showLegendPositionControl(){const chart=$("#chart");chart.querySelector(".chart-direct-popover")?.remove();const popup=document.createElement("div"),positions=[["Top","Top left"],["TopCenter","Top center"],["Right","Right"],["Bottom","Bottom left"],["BottomCenter","Bottom center"],["Left","Left"]];popup.className="chart-direct-popover";popup.innerHTML=`<strong>Legend position</strong><div>${positions.map(([position,label])=>`<button type="button" data-position="${position}" class="${opt("LegendPosition","Bottom")===position?"active":""}">${label}</button>`).join("")}<button type="button" data-hide-legend>Hide legend</button></div>`;chart.append(popup);popup.addEventListener("click",event=>{const hide=event.target.closest("[data-hide-legend]");if(hide){setChecked("#showLegend",false);updateOption("ShowLegend",false);return;}const button=event.target.closest("[data-position]");if(!button)return;setChecked("#showLegend",true);options().ShowLegend=true;setValue("#legendPosition",button.dataset.position);updateOption("LegendPosition",button.dataset.position);});}
  function openOptionGroup(label){const layout=$("#chartLayout");layout.classList.remove("options-collapsed");const panel=[...document.querySelectorAll(".options details,.options .type-options")].find(item=>(item.querySelector("summary")||item.querySelector("h2"))?.textContent.trim()===label);if(!panel)return;if(panel.matches("details"))panel.open=true;panel.scrollIntoView({behavior:"smooth",block:"start"});}
  function availableOptionGroups(){const type=window.CanvasChartRenderer.typeName(spec().Kind),axisFree=["treemap","gauge","pie","doughnut"].includes(type),common=axisFree?["Title settings","Legend","Group labels","Data labels","Multiple settings","Plot margins"]:type==="heatmap"?["Title settings","Legend","Category axis","Group labels","Row labels","Data labels","Multiple settings","Plot margins"]:["Title settings","Legend","Category axis","Group labels","Value axis","Data labels","Multiple settings","Plot margins"],specific={bar:["Bar layout"],stacked:["Bar layout"],line:["Line and markers"],area:["Line and markers"],combo:["Line and markers"],scatter:["Line and markers","Scatter / plot"],waterfall:["Waterfall"],histogram:["Distribution"],boxplot:["Boxplot"],gauge:["Gauge"],treemap:["Treemap"],heatmap:["Heatmap"],pie:["Pie layout"],doughnut:["Doughnut layout"]};return [...common,...(specific[type]||[])];}
  function showChartContextMenu(event){event.preventDefault();document.querySelector(".chart-options-context")?.remove();const menu=document.createElement("div");menu.className="chart-options-context";menu.style.left=`${Math.min(event.clientX,innerWidth-210)}px`;menu.style.top=`${Math.min(event.clientY,innerHeight-360)}px`;menu.innerHTML='<div class="menu-title">Chart options</div>'+availableOptionGroups().map(label=>`<button type="button" data-chart-group="${label}">${label}</button>`).join("");document.body.append(menu);menu.addEventListener("click",click=>{const button=click.target.closest("[data-chart-group]");if(button)openOptionGroup(button.dataset.chartGroup);menu.remove();});}
  function beginTitleDrag(event){if(event.button!==0)return;event.preventDefault();const chart=$("#chart"),rect=chart.getBoundingClientRect(),startX=event.clientX,startY=event.clientY,offsetX=Number(opt("TitleOffsetX",0))||0,offsetY=Number(opt("TitleOffsetY",0))||0;let moved=false;const move=moveEvent=>{const dx=(moveEvent.clientX-startX)*800/rect.width,dy=(moveEvent.clientY-startY)*440/rect.height;if(Math.abs(dx)+Math.abs(dy)<2)return;moved=true;document.body.classList.add("chart-title-dragging");options().TitleOffsetX=Math.max(-360,Math.min(360,Math.round(offsetX+dx)));options().TitleOffsetY=Math.max(-180,Math.min(180,Math.round(offsetY+dy)));renderChart();};const stop=()=>{document.removeEventListener("pointermove",move);document.removeEventListener("pointerup",stop);document.body.classList.remove("chart-title-dragging");if(!moved)return;};document.addEventListener("pointermove",move);document.addEventListener("pointerup",stop,{once:true});}
  function beginLegendDrag(event){if(event.button!==0)return;event.preventDefault();event.stopPropagation();const chart=$("#chart"),rect=chart.getBoundingClientRect(),startX=event.clientX,startY=event.clientY,offsetX=Number(opt("LegendOffsetX",0))||0,offsetY=Number(opt("LegendOffsetY",0))||0;let moved=false;const move=moveEvent=>{const dx=(moveEvent.clientX-startX)*800/rect.width,dy=(moveEvent.clientY-startY)*440/rect.height;if(Math.abs(dx)+Math.abs(dy)<2)return;moved=true;document.body.classList.add("chart-legend-dragging");options().LegendOffsetX=Math.max(-500,Math.min(500,Math.round(offsetX+dx)));options().LegendOffsetY=Math.max(-300,Math.min(300,Math.round(offsetY+dy)));renderChart();};const stop=()=>{document.removeEventListener("pointermove",move);document.removeEventListener("pointerup",stop);document.body.classList.remove("chart-legend-dragging");if(!moved)openOptionGroup("Legend");};document.addEventListener("pointermove",move);document.addEventListener("pointerup",stop,{once:true});}
  function beginDoughnutResize(event){if(event.button!==0)return;event.preventDefault();const kind=event.target.closest("[data-chart-size]")?.dataset.chartSize||"doughnut",settings={pie:["PieRadius","#pieRadius",150,80,205,800],doughnut:["DoughnutRadius","#doughnutRadius",175,80,205,800],gauge:["GaugeScale","#gaugeScale",100,50,135,300],treemap:["TreemapScale","#treemapScale",100,50,125,300],heatmap:["HeatmapScale","#heatmapScale",100,50,125,300]}[kind],key=settings[0],input=settings[1],fallback=settings[2],minimum=settings[3],maximum=settings[4],sensitivity=settings[5],chart=$("#chart"),rect=chart.getBoundingClientRect(),startX=event.clientX,start=Number(opt(key,fallback))||fallback;document.body.classList.add("chart-doughnut-dragging");const move=moveEvent=>{const size=Math.max(minimum,Math.min(maximum,Math.round(start+(moveEvent.clientX-startX)*sensitivity/rect.width)));options()[key]=size;setValue(input,size);renderChart();};const stop=()=>{document.removeEventListener("pointermove",move);document.removeEventListener("pointerup",stop);document.body.classList.remove("chart-doughnut-dragging");};document.addEventListener("pointermove",move);document.addEventListener("pointerup",stop,{once:true});}
  function beginMarginDrag(event,side){if(event.button!==0)return;event.preventDefault();const chart=$("#chart"),rect=chart.getBoundingClientRect(),key={top:"MarginTop",bottom:"MarginBottom",left:"MarginLeft",right:"MarginRight"}[side],input={top:"#marginTop",bottom:"#marginBottom",left:"#marginLeft",right:"#marginRight"}[side],minimum={top:-80,bottom:-80,left:-55,right:-20}[side],maximum=side==="left"||side==="right"?200:140,start=Number(opt(key,0))||0,startX=event.clientX,startY=event.clientY;document.body.classList.add("chart-margin-dragging");const move=moveEvent=>{const raw=side==="left"?start+(moveEvent.clientX-startX)*800/rect.width:side==="right"?start-(moveEvent.clientX-startX)*800/rect.width:side==="top"?start+(moveEvent.clientY-startY)*440/rect.height:start-(moveEvent.clientY-startY)*440/rect.height,value=Math.max(minimum,Math.min(maximum,Math.round(raw)));options()[key]=value;setValue(input,value);renderChart();};const stop=()=>{document.removeEventListener("pointermove",move);document.removeEventListener("pointerup",stop);document.body.classList.remove("chart-margin-dragging");};document.addEventListener("pointermove",move);document.addEventListener("pointerup",stop,{once:true});}

  $("#types").addEventListener("click",event=>{const button=event.target.closest("[data-type]");if(button)setType(button.dataset.type);});$("#chartType").addEventListener("change",event=>setType(event.target.value));
  if(!$("#showAsMultiples")){const control=document.createElement("label");control.className="check";control.innerHTML='<input id="showAsMultiples" type="checkbox"> Show as multiples';$("#subgroup").closest("label")?.after(control);control.querySelector("input").addEventListener("change",event=>updateOption("ShowAsMultiples",event.target.checked));}
  [["multipleMax","MultipleMaxCount"],["multipleRows","MultipleRows"],["multipleColumns","MultipleColumns"],["multipleSpacing","MultipleSpacing"],["multipleHeaderSize","MultipleHeaderSize"]].forEach(([id,key])=>$("#"+id)?.addEventListener("input",event=>updateOption(key,event.target.value===""?"":Number(event.target.value))));
  [["multipleHeaderAlignment","MultipleHeaderAlignment"],["multipleHeaderColor","MultipleHeaderColor"]].forEach(([id,key])=>$("#"+id)?.addEventListener("change",event=>updateOption(key,event.target.value)));
