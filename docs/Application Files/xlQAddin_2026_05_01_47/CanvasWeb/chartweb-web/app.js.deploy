    ["waterfall","▥","Waterfall"],["histogram","▥","Histogram"],["boxplot","▣","Boxplot"],["treemap","▦","Treemap"],["heatmap","▦","Heatmap"],["gauge","◴","Gauge"],
    ["pie","◕","Pie"],["doughnut","◉","Doughnut"]
  ];
  const builtInPalettes={Default:["#4f6ee8","#16a085","#e67e22","#8e5bd9","#d64562","#2e86c1","#7d8f29","#a66a3f"],Bright:["#3366cc","#dc3912","#ff9900","#109618","#990099","#0099c6","#dd4477","#66aa00"],Pastel:["#8db3e2","#f4b183","#a9d18e","#d5a6bd","#ffe699","#9dc3e6","#c9c9c9","#b4a7d6"],Muted:["#607d8b","#78909c","#8d6e63","#7e57c2","#5c6bc0","#26a69a","#9e9d24","#ef6c00"],Excel:["#4472c4","#ed7d31","#a5a5a5","#ffc000","#5b9bd5","#70ad47","#264478","#9e480e"],EarthTones:["#6b705c","#a5a58d","#b7b7a4","#cb997e","#ddbea9","#7f5539","#9c6644","#386641"],Berry:["#5b2a86","#8b3a9c","#b94e8f","#d8647a","#e9856f","#9c2c77","#692c70","#3d285d"],SeaGreen:["#006d77","#0a9396","#2a9d8f","#52b788","#74c69d","#95d5b2","#40916c","#1b4332"],Fire:["#7f0000","#b30000","#d7301f","#ef6548","#fc8d59","#fdbb84","#fdd49e","#ffeda0"],Grayscale:["#20242a","#414850","#626b75","#838e99","#a5afb9","#c4cbd2","#dce1e5","#eff1f3"],NightOcean:["#69b8ff","#60ddc8","#f7c978","#b69cff","#f18e9b","#83c7d8","#b6db78","#edaa7a"],NightAmber:["#e0ae69","#84c9b1","#a8b8e9","#df91a6","#bdd47d","#92c7dd","#c7a1db","#e6ba9b"],NightViolet:["#9cdecc","#b4a6ed","#82add8","#d8bb8c","#e49eaf","#9cc5b0","#b5bdda","#d4a8c7"]};
