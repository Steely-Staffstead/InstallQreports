  $("#chart").addEventListener("click",event=>{const edge=event.target.closest("[data-margin-handle]")?.dataset.marginHandle;if(!edge)return;event.stopImmediatePropagation();const type=window.CanvasChartRenderer.typeName(spec().Kind);openOptionGroup(edge==="left"?(type==="heatmap"?"Row labels":"Value axis"):edge==="bottom"?"Category axis":"Plot margins");},true);
  $("#chart").addEventListener("dblclick",event=>{if(event.target.closest("[data-chart-action='edit-title']"))beginTitleEdit();});$("#chart").addEventListener("click",event=>{document.querySelector(".chart-options-context")?.remove();const type=window.CanvasChartRenderer.typeName(spec().Kind),axisFree=["treemap","gauge","pie","doughnut"].includes(type);if(event.target.closest("[data-chart-action='legend-position']"))return;else if(event.target.closest("[data-chart-action='edit-title']"))openOptionGroup("Title settings");else if(event.target.closest("[data-chart-action='heatmap']"))openOptionGroup("Heatmap");else if(event.target.closest("[data-chart-action='heatmap-row-labels']"))openOptionGroup("Row labels");else if(event.target.closest("[data-chart-action='data-label']")||(axisFree&&event.target.closest("[data-chart-action='category-axis'],.chart-axis-label,.value-axis-label")))openOptionGroup("Data labels");else if(event.target.closest("[data-chart-action='group-label']"))openOptionGroup("Group labels");else if(event.target.closest("[data-chart-action='value-axis'],.value-axis-label"))openOptionGroup(type==="heatmap"?"Row labels":"Value axis");else if(event.target.closest("[data-chart-action='category-axis'],.chart-axis-label"))openOptionGroup("Category axis");else if(event.target.closest("svg rect,svg polyline,svg circle,svg polygon,svg path"))openOptionGroup("Data labels");else if(["bar","stacked"].includes(type))openOptionGroup("Bar layout");else if(["line","area"].includes(type))openOptionGroup("Line and markers");});$("#chart").addEventListener("contextmenu",showChartContextMenu);$("#chart").addEventListener("pointerdown",event=>{const handle=event.target.closest("[data-margin-handle]");if(handle)beginMarginDrag(event,handle.dataset.marginHandle);else if(event.target.closest("[data-chart-action='legend-position']"))beginLegendDrag(event);else if(event.target.closest("[data-chart-size]"))beginDoughnutResize(event);else if(event.target.closest("[data-chart-action='edit-title']"))beginTitleDrag(event);});
  $("#collapseAll").addEventListener("click",()=>document.querySelectorAll(".options details").forEach(details=>details.open=false));$("#hideOptions").addEventListener("click",()=>{$("#chartLayout").classList.add("options-collapsed");correctFixedChartText($("#chart"));});$("#expandOptions").addEventListener("click",()=>{$("#chartLayout").classList.remove("options-collapsed");correctFixedChartText($("#chart"));});$("#hideData").addEventListener("click",()=>{$("#chartLayout").classList.add("data-collapsed");correctFixedChartText($("#chart"));});$("#expandData").addEventListener("click",()=>{$("#chartLayout").classList.remove("data-collapsed");correctFixedChartText($("#chart"));});
  $("#addSeries").addEventListener("click",()=>{const field=names()[0]||"",type=window.CanvasChartRenderer.typeName(spec().Kind),kind=type==="combo"&&series().length?"Line":["line","area","scatter"].includes(type)?type[0].toUpperCase()+type.slice(1):"Bar";series().push({Id:uid(),ColumnName:field,Kind:kind,LegendText:field});render();});
  $("#series").addEventListener("change",event=>{const row=event.target.closest("[data-index]");if(!row)return;const item=series()[+row.dataset.index];if(event.target.matches("[data-series-field]")){item.ColumnName=event.target.value;item.LegendText=event.target.value;}if(event.target.matches("[data-series-kind]"))item.Kind=event.target.value;if(event.target.matches("[data-series-color]"))item.Color=event.target.value;render();});
  $("#series").addEventListener("click",event=>{const row=event.target.closest("[data-index]");if(!row)return;const index=+row.dataset.index;if(event.target.closest("[data-remove-series]")){series().splice(index,1);render();}else if(event.target.closest("[data-theme-color]")){delete series()[index].Color;render();}});
