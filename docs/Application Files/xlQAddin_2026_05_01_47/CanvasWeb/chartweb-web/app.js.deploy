  const opt=(key,fallback="")=>options()[key]??fallback;
  const bool=(key,fallback=true)=>{const value=opt(key,fallback);return typeof value==="boolean"?value:/^(true|1|yes|on)$/i.test(String(value));};
  const chartPaletteColors=name=>{name=QReportsPalette.name(name);if(name==="Canvas")return QReportsPalette.colors(documentModel.canvasTheme?.colors);return QReportsPalette.colors(options().PaletteColors).length?QReportsPalette.colors(options().PaletteColors):QReportsPalette.catalog(documentModel.canvasPalettes).find(item=>item.name===name)?.colors||builtInPalettes[name]||builtInPalettes.Default;};
  const heatmapUsesCustomColors=()=>options().HeatmapUseCustomColors==null?["HeatmapLowColor","HeatmapHighColor","HeatmapEmptyColor"].some(key=>Object.hasOwn(options(),key)):bool("HeatmapUseCustomColors",false);
  const mixColor=(from,to,ratio)=>{const rgb=value=>/^#([0-9a-f]{6})$/i.test(value||"")?[1,3,5].map(index=>parseInt(value.slice(index,index+2),16)):[255,255,255],a=rgb(from),b=rgb(to);return `#${a.map((value,index)=>Math.round(value+(b[index]-value)*ratio).toString(16).padStart(2,"0")).join("")}`;};
  const heatmapThemeColors=()=>{const colors=chartPaletteColors(opt("PaletteName","Default")),high=colors[0]||"#315fba",background=style().BackgroundColor||"#ffffff";return {high,low:mixColor(high,background,.82),empty:mixColor(high,background,.94),divider:mixColor(high,background,.48),today:colors[1]||high,currentWeek:mixColor(high,background,.28)};};
  const nullableNumber=value=>value===""||value==null?null:Number(value);
