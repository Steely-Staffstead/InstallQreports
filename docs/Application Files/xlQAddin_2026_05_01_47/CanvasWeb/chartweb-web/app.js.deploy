      style().Xcolumn ||= ui.x||"";style().Ycolumn ||= ui.y||"";style().GroupBy ||= ui.group||"";style().SubgroupBy ||= ui.subgroup||"";style().HeaderText ||= settings.name||spec().Name||"Chart";style().BackgroundColor ||= settings.background||"#ffffff";
      Object.entries(renderer).forEach(([key,value])=>{if(options()[key]==null)options()[key]=value;});
      if(!series().length)for(const entry of settings.series||[]){const item=entry.spec||entry,field=item.column||item.ColumnName;if(field)series().push({Id:uid(),ColumnName:field,Kind:item.kind||"Bar",LegendText:item.legend||entry.name||field});}
      if(!spec().Kind)spec().Kind=settings.type||"bar";if(new Set(series().map(item=>String(item.Kind).toLowerCase())).size>1)spec().Kind="combo";
      const inherit=(key,value)=>{if(options()[key]==null&&value!=null&&value!=="")options()[key]=value;},dockMap={0:"Top",1:"Bottom",2:"Left",3:"Right"},orderMap={0:"Natural",1:"AlphabeticalAsc",2:"AlphabeticalDesc",3:"ByYAsc",4:"ByYDesc",5:"AlphabeticalAsc",6:"AlphabeticalDesc"},labels=series()[0]?.Labels||{};
      inherit("PaletteName",documentModel.canvasTheme?.colors?.length?"Canvas":style().PaletteName);inherit("LegendPosition",dockMap[style().LgdDock]||style().LgdDock);inherit("LegendSize",style().LgdFSize);inherit("ShowLegend",style().LgdVisible);inherit("CategoryAxisAngle",axisX().Angle??(style().XCatVert?90:null));inherit("CategoryAxisSize",axisX().Labels?.Size??style().XFontSize);inherit("CategoryAxisFormat",axisX().LabelFormatOverride);inherit("CategoryAxisMin",axisX().HardMin);inherit("CategoryAxisMax",axisX().HardMax);inherit("CategoryOrder",orderMap[style().XOrder]||style().XOrder);inherit("ValueAxisSize",axisY().Labels?.Size??style().YFontSize);inherit("ValueAxisFormat",axisY().LabelFormatOverride||valueStyle().Format);inherit("ValueAxisMin",axisY().HardMin??style().YMin);inherit("ValueAxisMax",axisY().HardMax??style().YMax);inherit("ShowValueLabels",labels.Show??valueStyle().Visible);inherit("ValueLabelFormat",labels.Format||valueStyle().Format);inherit("LabelDelimiter",labels.Delimiter);inherit("LabelPosition",labels.Position);inherit("ValueLabelSize",valueStyle().Size);if(labels.Parts!=null){inherit("LabelShowCategory",(+labels.Parts&1)!==0);inherit("LabelShowValue",(+labels.Parts&2)!==0);inherit("LabelShowSeriesName",(+labels.Parts&4)!==0);}hydrated=true;
