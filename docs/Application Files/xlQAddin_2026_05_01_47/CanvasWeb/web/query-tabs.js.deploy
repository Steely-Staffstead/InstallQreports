// Query tabs stay inside Query Workspace. Only the designated Main query is returned to the caller.
const queryWorkspaceKind="QReports.QueryWorkspace";
const queryWorkspaceVersion=1;
const queryTabs=[];
let activeQueryTabId=null,mainQueryTabId=null,workspaceParameters=[],workspaceFileName="",workspaceFilePath="",switchingQueryTab=false,compareRightTabId=null;

function emptyQueryData(){return{columns:[],rows:[]};}
function newResultView(data=emptyQueryData()){return{data,sortIndex:-1,sortDirection:0,hidden:new Set(),formats:new Map(),widths:new Map()};}
function queryRowLimit(value,fallback=0){const parsed=Number(value);return Number.isFinite(parsed)?Math.max(0,Math.min(50000,Math.trunc(parsed))):fallback;}
function activeQueryTab(){return queryTabs.find(tab=>tab.id===activeQueryTabId)||null;}
function mainQueryTab(){return queryTabs.find(tab=>tab.id===mainQueryTabId)||null;}
function isMainQueryTab(){return !!activeQueryTabId&&activeQueryTabId===mainQueryTabId;}
function markActiveQueryTabDirty(){const tab=activeQueryTab();if(!tab)return;tab.dirty=true;renderQueryTabs();}
function canChangeQueryTab(){if(switchingQueryTab)return false;if(queryClock||pending.size){toast("Wait for the current operation to finish before switching tabs.");return false;}if(hasEdits()){toast("Save or revert table edits before switching tabs.");return false;}if(document.body.dataset.sourceEdit){toast("Finish editing the saved source before switching tabs.");return false;}return true;}

function snapshotActiveQueryTab(){
 const tab=activeQueryTab();if(!tab)return;
 workspaceParameters=query.parameters||workspaceParameters;
 tab.query={...query,queryText:$("queryText").value,previewLimit:Number($("previewLimit").value)||0};
 tab.sqlFilePath=currentSqlFilePath;
 tab.resultView=resultView;tab.resultMode=resultMode;tab.parsedSql=parsedSql;tab.resultMessage=resultMessage;
 tab.summary=$("resultSummary").textContent;tab.status=$("queryStatus").textContent;
 tab.editorSelectionStart=$("queryText").selectionStart;tab.editorSelectionEnd=$("queryText").selectionEnd;
 tab.editorScrollTop=$("queryText").scrollTop;tab.resultScrollTop=document.querySelector(".result-wrap").scrollTop;
}

function renderQueryTabs(){
 const list=$("queryTabs");if(!list)return;
 renderQueryRunConnections();
 list.innerHTML=queryTabs.map(tab=>`<div class="query-tab ${tab.id===activeQueryTabId?"active":""} ${tab.id===compareRightTabId?"compared":""}" role="presentation"><button type="button" role="tab" data-query-tab="${esc(tab.id)}" aria-selected="${tab.id===activeQueryTabId}" title="${esc(tab.title)} · ${esc(tab.query.connectionName||'No connection')} · Double-click to rename">${esc(tab.title)}</button>${tab.id===mainQueryTabId?'<span class="main-mark" title="Returned to Excel / caller">★ Main</span>':""}${tab.dirty?'<span class="dirty-mark" title="Unsaved workspace changes">•</span>':""}${tab.id!==mainQueryTabId?`<button type="button" class="tab-close" data-close-query-tab="${esc(tab.id)}" title="Close tab">×</button>`:""}</div>`).join("");
 list.querySelectorAll("[data-query-tab]").forEach(button=>{button.onclick=()=>activateQueryTab(button.dataset.queryTab);button.ondblclick=event=>{event.preventDefault();renameQueryTab(button.dataset.queryTab);};button.oncontextmenu=event=>showQueryTabMenu(event,button.dataset.queryTab);});
 list.querySelectorAll("[data-close-query-tab]").forEach(button=>button.onclick=()=>closeQueryTab(button.dataset.closeQueryTab));
 $("setMainTab").disabled=isMainQueryTab()||!activeQueryTabId;
 const auxiliary=!isMainQueryTab(),sourceEdit=!!document.body.dataset.sourceEdit;
 document.querySelector('[data-action="apply"]').disabled=auxiliary||sourceEdit;
 const saveToggle=document.querySelector('[data-action="toggleSaveMenu"]');if(saveToggle)saveToggle.disabled=sourceEdit;
 document.querySelectorAll('[data-action="saveSourceView"],[data-action="saveCombinedSource"]').forEach(button=>button.disabled=auxiliary||sourceEdit);
 document.querySelector('[data-action="apply"]').title=auxiliary?"Only the Main tab can be returned to Excel or Canvas.":"Return the Main query to Excel or Canvas";
}
function renderQueryRunConnections(){
 const select=document.querySelector('#queryRunConnection');if(!select)return;
 const name=query.connectionName||'',connections=[...allConnections];
 if(name&&!connections.some(item=>item.name===name))connections.unshift({name,type:'Missing'});
 select.innerHTML=connections.map(item=>`<option value="${esc(item.name)}">${esc(item.name)} — ${esc(item.type||item.kind||'')}</option>`).join('');
 if(name)select.value=name;
}

function initializeQueryTabsFromHost(){
 if(queryTabs.length)return;
 workspaceParameters=query.parameters||[];
 const id=crypto.randomUUID();queryTabs.push({id,title:"Main",query:{...query,parameters:workspaceParameters},sqlFilePath:"",resultView,resultMode,parsedSql,resultMessage,summary:$("resultSummary").textContent,status:"Ready",dirty:false});
 activeQueryTabId=id;mainQueryTabId=id;renderQueryTabs();
}

async function activateQueryTab(id){
 if(id===activeQueryTabId)return;if(!queryTabs.some(tab=>tab.id===id)||!canChangeQueryTab())return;
 switchingQueryTab=true;
 try{
  snapshotActiveQueryTab();exitEditable(false);hideContextMenu();hideAutocomplete();$("openMenu")?.classList.add("hidden");$("saveMenu")?.classList.add("hidden");$("designMenu")?.classList.add("hidden");
  const previousId=activeQueryTabId,tab=queryTabs.find(item=>item.id===id);activeQueryTabId=id;
  query={...tab.query,parameters:workspaceParameters};currentSqlFilePath=tab.sqlFilePath||"";updateQuickSaveSql();resultView=tab.resultView||newResultView(tab.query.data||emptyQueryData());
  resultMode=tab.resultMode||"grid";parsedSql=tab.parsedSql||"";resultMessage=tab.resultMessage||"";
  $("queryText").value=query.queryText||"";$("previewLimit").value=query.previewLimit??window.QReportsSettings?.get().records??1000;
  highlightSql();renderResult(resultView.data,true);$("resultSummary").textContent=tab.summary||$("resultSummary").textContent;
  $("queryStatus").textContent=tab.status||"Ready";
  $("queryText").selectionStart=Math.min(tab.editorSelectionStart??0,$("queryText").value.length);
  $("queryText").selectionEnd=Math.min(tab.editorSelectionEnd??0,$("queryText").value.length);
  $("queryText").scrollTop=tab.editorScrollTop||0;document.querySelector(".result-wrap").scrollTop=tab.resultScrollTop||0;
  if(compareRightTabId===id)compareRightTabId=previousId;
  renderQueryTabs();renderParameterReference();renderComparePane();
 }finally{switchingQueryTab=false;}
}

function addQueryTab(){if(!canChangeQueryTab())return;if(queryTabs.length>=30)return toast("A workspace can contain at most 30 tabs.");snapshotActiveQueryTab();const id=crypto.randomUUID(),connectionName=mainQueryTab()?.query.connectionName||query.connectionName,previewLimit=queryRowLimit(window.QReportsSettings?.get().records,1000),data=emptyQueryData();queryTabs.push({id,title:`Query ${queryTabs.length+1}`,query:{connectionName,queryText:"",previewLimit,parameters:workspaceParameters,measures:[],data},sqlFilePath:"",resultView:newResultView(data),resultMode:"grid",parsedSql:"",resultMessage:"",summary:"No query executed",status:"Ready",dirty:true});renderQueryTabs();activateQueryTab(id);}
async function renameQueryTab(id){const tab=queryTabs.find(item=>item.id===id);if(!tab)return;const title=await window.QReportsDialogs.prompt("Tab name",tab.title);if(title===null)return;const trimmed=title.trim();if(!trimmed)return toast("Enter a tab name.");tab.title=trimmed;tab.dirty=true;renderQueryTabs();renderComparePane();}
async function closeQueryTab(id){const tab=queryTabs.find(item=>item.id===id);if(!tab||id===mainQueryTabId)return;if(!canChangeQueryTab())return;if(tab.dirty&&!await window.QReportsDialogs.confirm(`Close '${tab.title}'? Unsaved workspace changes in this tab will be lost.`))return;if(id===compareRightTabId||id===activeQueryTabId&&compareRightTabId)closeQueryCompare();if(id===activeQueryTabId)await activateQueryTab(mainQueryTabId);const index=queryTabs.findIndex(item=>item.id===id);if(index>=0)queryTabs.splice(index,1);renderQueryTabs();}
function setActiveQueryTabAsMain(){if(!activeQueryTabId||isMainQueryTab()||!canChangeQueryTab())return;snapshotActiveQueryTab();const previous=mainQueryTab();if(previous?.title==="Main")previous.title="Query 1";mainQueryTabId=activeQueryTabId;activeQueryTab().dirty=true;renderQueryTabs();toast("Main tab changed. Only this query will be returned to Excel or Canvas.");}

function showQueryTabMenu(event,id){
 event.preventDefault();const tab=queryTabs.find(item=>item.id===id);if(!tab)return;
 if(id===activeQueryTabId)snapshotActiveQueryTab();
 const connections=[...allConnections];if(tab.query.connectionName&&!connections.some(item=>item.name===tab.query.connectionName))connections.unshift({name:tab.query.connectionName,type:"Missing"});
 const others=queryTabs.filter(item=>item.id!==id);
 const rowLimit=queryRowLimit(tab.query.previewLimit,queryRowLimit(window.QReportsSettings?.get().records,1000));
 showContextMenu(event,`<div class="tab-menu-title">${esc(tab.title)}</div><label class="tab-menu-label">Run connection<select data-tab-connection>${connections.map(item=>`<option value="${esc(item.name)}" ${item.name===tab.query.connectionName?"selected":""}>${esc(item.name)} — ${esc(item.type||item.kind||"")}</option>`).join("")}</select></label><label class="tab-menu-label">Rows to return<input data-tab-limit type="number" min="0" max="50000" step="1" value="${rowLimit}"><small>0 returns all rows. This setting belongs to this query.</small></label><button data-tab-action="add">Add tab</button><button data-tab-action="duplicate">Duplicate</button><button data-tab-action="rename">Rename</button><button data-tab-action="main" ${id===mainQueryTabId?"disabled":""}>Set as Main</button>${others.length?`<div class="tab-menu-label">Compare with…</div>${others.map(item=>`<button data-tab-compare="${esc(item.id)}">${esc(item.title)}</button>`).join("")}`:""}`,menu=>{
  menu.querySelector('[data-tab-connection]').onchange=change=>{if(!canChangeQueryTab())return;tab.query.connectionName=change.target.value;if(id===activeQueryTabId)query.connectionName=change.target.value;tab.dirty=true;hideContextMenu();renderQueryTabs();renderComparePane();toast(`${tab.title} runs on ${change.target.value}. The source browser is unchanged.`);};
  menu.querySelector('[data-tab-limit]').onchange=change=>{if(!canChangeQueryTab())return;const limit=queryRowLimit(change.target.value,rowLimit);change.target.value=String(limit);tab.query.previewLimit=limit;if(id===activeQueryTabId){query.previewLimit=limit;$("previewLimit").value=String(limit);}tab.dirty=true;hideContextMenu();renderQueryTabs();renderComparePane();toast(`${tab.title} will return ${limit===0?"all rows":limit.toLocaleString()+" rows"}.`);};
  menu.querySelectorAll('[data-tab-action]').forEach(button=>button.onclick=()=>{hideContextMenu();if(!canChangeQueryTab())return;if(button.dataset.tabAction==='add')addQueryTab();else if(button.dataset.tabAction==='duplicate')duplicateQueryTab(id);else if(button.dataset.tabAction==='rename')renameQueryTab(id);else if(button.dataset.tabAction==='main'){snapshotActiveQueryTab();const previous=mainQueryTab();if(previous?.title==='Main')previous.title='Query 1';mainQueryTabId=id;tab.dirty=true;renderQueryTabs();}});
  menu.querySelectorAll('[data-tab-compare]').forEach(button=>button.onclick=()=>{hideContextMenu();compareQueryTabs(id,button.dataset.tabCompare);});
 });
}
function duplicateQueryTab(id){if(queryTabs.length>=30)return toast('A workspace can contain at most 30 tabs.');snapshotActiveQueryTab();const source=queryTabs.find(item=>item.id===id),data=emptyQueryData(),newId=crypto.randomUUID();queryTabs.push({id:newId,title:`${source.title} copy`,query:{...structuredClone(source.query),data,parameters:workspaceParameters},resultView:newResultView(data),resultMode:'grid',parsedSql:'',resultMessage:'',summary:'Run this query to load results',status:'Ready',dirty:true});renderQueryTabs();activateQueryTab(newId);}
async function compareQueryTabs(leftId,rightId){
 if(!queryTabs.some(tab=>tab.id===leftId)||!queryTabs.some(tab=>tab.id===rightId)||leftId===rightId)return;
 if(!canChangeQueryTab())return;
 if(leftId!==activeQueryTabId)await activateQueryTab(leftId);
 if(activeQueryTabId!==leftId)return;
 snapshotActiveQueryTab();compareRightTabId=rightId;
 const work=document.querySelector('.work');let pane=document.querySelector('#queryComparePane');
 if(!pane){pane=document.createElement('section');pane.id='queryComparePane';pane.className='query-compare-pane';pane.innerHTML=`<div class="compare-divider" data-compare-divider role="separator" aria-orientation="vertical" title="Drag to resize split view"></div><div class="compare-query-head"><strong data-compare-title></strong><label>Run on <select data-compare-connection></select></label><label>Rows <input data-compare-limit type="number" min="0" max="50000"></label><button type="button" data-compare-statistics title="Statistics for this query">Statistics</button><button type="button" data-compare-run>▶ Run</button><button type="button" data-compare-close title="Close split view">×</button></div><textarea class="compare-query-text" data-compare-editor spellcheck="false" placeholder="SELECT * FROM table_name"></textarea><div class="compare-result-head"><div class="compare-result-tabs"><button type="button" data-compare-mode="grid">Grid</button><button type="button" data-compare-mode="json">JSON</button><button type="button" data-compare-mode="sql">Parsed SQL</button><button type="button" data-compare-mode="messages">Messages</button></div><span data-compare-summary></span></div><div class="compare-result-wrap" data-compare-result></div>`;work.append(pane);
  pane.querySelector('[data-compare-divider]').onpointerdown=event=>{const bounds=work.getBoundingClientRect();pointerDrag(event,e=>{const percent=Math.max(25,Math.min(75,(e.clientX-bounds.left)/bounds.width*100));work.style.setProperty('--compare-left',`${percent}%`);});};
  pane.querySelector('[data-compare-close]').onclick=closeQueryCompare;
  pane.querySelector('[data-compare-editor]').oninput=event=>{const tab=queryTabs.find(item=>item.id===compareRightTabId);if(!tab)return;tab.query.queryText=event.target.value;tab.dirty=true;renderQueryTabs();};
  pane.querySelector('[data-compare-connection]').onchange=event=>{const tab=queryTabs.find(item=>item.id===compareRightTabId);if(!tab)return;tab.query.connectionName=event.target.value;tab.dirty=true;renderQueryTabs();};
  pane.querySelector('[data-compare-limit]').onchange=event=>{const tab=queryTabs.find(item=>item.id===compareRightTabId);if(!tab)return;tab.query.previewLimit=Number(event.target.value)||0;tab.dirty=true;renderQueryTabs();};
  pane.querySelector('[data-compare-run]').onclick=()=>runCompareTab();
  pane.querySelector('[data-compare-statistics]').onclick=showCompareStatistics;
  pane.querySelector('[data-compare-editor]').oncontextmenu=showCompareEditorMenu;
  pane.querySelector('[data-compare-result]').oncontextmenu=showCompareResultMenu;
  pane.querySelectorAll('[data-compare-mode]').forEach(button=>button.onclick=async()=>{const tab=queryTabs.find(item=>item.id===compareRightTabId);if(!tab)return;tab.resultMode=button.dataset.compareMode;if(tab.resultMode==='sql')await refreshCompareParsedSql(tab);renderCompareResult(tab);});
 }
 work.classList.add('compare-active');renderQueryTabs();renderComparePane();
}
function closeQueryCompare(){compareRightTabId=null;document.querySelector('#queryComparePane')?.remove();document.querySelector('.work')?.classList.remove('compare-active');const label=document.querySelector('.query-head>span:first-child');if(label)label.textContent='QUERY';renderQueryTabs();}
function renderComparePane(){
 if(!compareRightTabId)return;
 const tab=queryTabs.find(item=>item.id===compareRightTabId),pane=document.querySelector('#queryComparePane');if(!pane||!tab){closeQueryCompare();return;}
 const primaryLabel=document.querySelector('.query-head>span:first-child');if(primaryLabel)primaryLabel.textContent=`QUERY · ${activeQueryTab()?.title||''}`;
 pane.querySelector('[data-compare-title]').textContent=tab.title;
 const editor=pane.querySelector('[data-compare-editor]');if(editor.value!==tab.query.queryText)editor.value=tab.query.queryText||'';
 const connections=[...allConnections];if(tab.query.connectionName&&!connections.some(item=>item.name===tab.query.connectionName))connections.unshift({name:tab.query.connectionName,type:'Missing'});
 const select=pane.querySelector('[data-compare-connection]');select.innerHTML=connections.map(item=>`<option value="${esc(item.name)}">${esc(item.name)} — ${esc(item.type||item.kind||'')}</option>`).join('');select.value=tab.query.connectionName||'';
 pane.querySelector('[data-compare-limit]').value=tab.query.previewLimit??0;
 renderCompareResult(tab);
}
function renderCompareResult(tab){
 const pane=document.querySelector('#queryComparePane');if(!pane)return;
 const mode=tab.resultMode||'grid',view=tab.resultView||newResultView(),data=view.data||emptyQueryData(),columns=data.columns||[],rows=data.rows||[];
 pane.querySelectorAll('[data-compare-mode]').forEach(button=>button.classList.toggle('active',button.dataset.compareMode===mode));
 pane.querySelector('[data-compare-summary]').textContent=tab.summary||`${rows.length.toLocaleString()} row(s)`;
 const result=pane.querySelector('[data-compare-result]');
 if(mode==='json'){result.innerHTML=`<pre class="result-text">${esc(JSON.stringify(rows.map(row=>Object.fromEntries(columns.map((column,index)=>[resultColumnName(column),rowValues(row,columns)[index]??null]))),null,2))}</pre>`;return;}
 if(mode==='sql'||mode==='messages'){result.innerHTML=`<pre class="result-text">${esc(mode==='sql'?tab.parsedSql||'Run this query first.':tab.resultMessage||'No messages.')}</pre>`;return;}
 if(!columns.length){result.innerHTML='<div class="empty">Run the query to preview data.</div>';return;}
 const visible=columns.map((column,index)=>({column,index})).filter(item=>!view.hidden.has(item.index));
 const indexed=rows.map((row,index)=>({row,index}));if(view.sortIndex>=0&&view.sortDirection)indexed.sort((left,right)=>{const a=rowValues(left.row,columns)[view.sortIndex],b=rowValues(right.row,columns)[view.sortIndex];if(a==null&&b==null)return left.index-right.index;if(a==null)return 1;if(b==null)return -1;const an=Number(a),bn=Number(b);return(Number.isFinite(an)&&Number.isFinite(bn)?an-bn:String(a).localeCompare(String(b),undefined,{numeric:true,sensitivity:'base'}))*view.sortDirection||left.index-right.index;});
 result.innerHTML=`<table style="width:max(100%,${visible.reduce((sum,item)=>sum+(view.widths.get(item.index)||160),0)}px)"><colgroup>${visible.map(item=>`<col style="width:${view.widths.get(item.index)||160}px">`).join('')}</colgroup><thead><tr>${visible.map(item=>`<th data-compare-column="${item.index}"><span>${esc(resultColumnName(item.column))}</span>${view.sortIndex===item.index&&view.sortDirection?`<span class="sort-mark">${view.sortDirection===1?'▲':'▼'}</span>`:''}<span class="column-resizer" data-compare-resize="${item.index}"></span></th>`).join('')}</tr></thead><tbody>${indexed.map(entry=>{const values=rowValues(entry.row,columns);return `<tr>${visible.map(item=>`<td>${statisticsCellHtml(columns,values,item.index,view.formats.get(item.index)||'auto')}</td>`).join('')}</tr>`;}).join('')}</tbody></table>`;
 result.querySelectorAll('[data-compare-column]').forEach(cell=>{const index=+cell.dataset.compareColumn;cell.onclick=event=>{if(event.target.closest('.column-resizer'))return;if(view.sortIndex!==index){view.sortIndex=index;view.sortDirection=1;}else if(view.sortDirection===1)view.sortDirection=-1;else{view.sortIndex=-1;view.sortDirection=0;}renderCompareResult(tab);};cell.oncontextmenu=event=>{event.preventDefault();event.stopPropagation();showCompareColumnMenu(event,tab,index);};cell.querySelector('.column-resizer').onpointerdown=event=>{event.stopPropagation();const startX=event.clientX,start=view.widths.get(index)||160;pointerDrag(event,e=>{view.widths.set(index,Math.max(55,Math.min(700,start+e.clientX-startX)));renderCompareResult(tab);});};});
}
function compareDelimited(tab,delimiter){const data=tab.resultView?.data||emptyQueryData(),columns=data.columns||[],indexes=columns.map((_,index)=>index).filter(index=>!tab.resultView.hidden.has(index)),quote=value=>{const valueText=String(value??'');return delimiter===','&&/[",\r\n]/.test(valueText)?`"${valueText.replace(/"/g,'""')}"`:valueText.replace(/[\t\r\n]+/g,' ');};return [indexes.map(index=>quote(resultColumnName(columns[index]))).join(delimiter),...(data.rows||[]).map(row=>{const values=rowValues(row,columns);return indexes.map(index=>quote(values[index])).join(delimiter);})].join('\r\n');}
function showCompareColumnMenu(event,tab,index){const view=tab.resultView,columns=view.data.columns||[];showContextMenu(event,`<div class="menu-title">${esc(resultColumnName(columns[index]))}</div><button data-sort="1">Sort ascending</button><button data-sort="-1">Sort descending</button><button data-sort="0">Clear sorting</button><label>Format <select data-result-format><option value="auto">Auto</option><option value="number">Number</option><option value="integer">Integer</option><option value="percent">Percent</option><option value="date">Date</option><option value="excel-date">Excel serial date</option><option value="text">Text</option></select></label><hr><div class="menu-title">Visible columns</div>${columns.map((column,columnIndex)=>`<label><input type="checkbox" data-visible-column="${columnIndex}" ${view.hidden.has(columnIndex)?'':'checked'}> ${esc(resultColumnName(column))}</label>`).join('')}`,menu=>{menu.querySelector('[data-result-format]').value=view.formats.get(index)||'auto';menu.querySelector('[data-result-format]').onchange=e=>{view.formats.set(index,e.target.value);hideContextMenu();renderCompareResult(tab);};menu.querySelectorAll('[data-sort]').forEach(button=>button.onclick=()=>{view.sortDirection=+button.dataset.sort;view.sortIndex=view.sortDirection?index:-1;hideContextMenu();renderCompareResult(tab);});menu.querySelectorAll('[data-visible-column]').forEach(input=>input.onchange=()=>{const columnIndex=+input.dataset.visibleColumn;input.checked?view.hidden.delete(columnIndex):view.hidden.add(columnIndex);if(view.hidden.size===columns.length)view.hidden.delete(columnIndex);hideContextMenu();renderCompareResult(tab);showCompareColumnMenu(event,tab,index);});});}
function showCompareResultMenu(event){const tab=queryTabs.find(item=>item.id===compareRightTabId);if(!tab)return;const mode=tab.resultMode||'grid';if(mode==='grid'){event.preventDefault();showContextMenu(event,'<div class="menu-title">Query results</div><button data-compare-action="copy">Copy table to clipboard</button><button data-compare-action="csv">Save as CSV file…</button><hr><button data-compare-action="clear">Clear results</button>',menu=>menu.querySelectorAll('[data-compare-action]').forEach(button=>button.onclick=async()=>{const action=button.dataset.compareAction;hideContextMenu();if(action==='copy')await copyText(compareDelimited(tab,'\t'),'Table');else if(action==='csv'){const saved=await call('queryResultsSaveCsv',{fileName:'query-results.csv',content:compareDelimited(tab,',')},{silentError:true});if(saved.path)toast(`Saved ${saved.path}`);}else{tab.query.data=emptyQueryData();tab.resultView=newResultView(tab.query.data);tab.summary='Results cleared';renderCompareResult(tab);}}));return;}if(mode==='messages'){event.preventDefault();showContextMenu(event,'<div class="menu-title">Messages</div><button data-compare-action="copy">Copy to clipboard</button><button data-compare-action="clear">Clear messages</button>',menu=>menu.querySelectorAll('[data-compare-action]').forEach(button=>button.onclick=async()=>{hideContextMenu();if(button.dataset.compareAction==='copy')await copyText(tab.resultMessage||'','Messages');else{tab.resultMessage='';renderCompareResult(tab);}}));return;}if(mode==='json'||mode==='sql'){event.preventDefault();const label=mode==='json'?'JSON':'Parsed SQL';showContextMenu(event,`<button data-compare-copy>Copy ${label} to clipboard</button>`,menu=>menu.querySelector('[data-compare-copy]').onclick=async()=>{hideContextMenu();await copyText(document.querySelector('#queryComparePane [data-compare-result]').textContent,label);});}}
function showCompareEditorMenu(event){event.preventDefault();const tab=queryTabs.find(item=>item.id===compareRightTabId),editor=document.querySelector('#queryComparePane [data-compare-editor]');if(!tab||!editor)return;showContextMenu(event,'<div class="menu-title">Query</div><button data-compare-query="selected">Run selected</button><button data-compare-query="all">Run all</button><hr><button data-compare-query="copy">Copy to clipboard</button><button data-compare-query="select">Select all</button><button data-compare-query="clear">Clear query window</button>',menu=>menu.querySelectorAll('[data-compare-query]').forEach(button=>button.onclick=async()=>{const action=button.dataset.compareQuery;hideContextMenu();if(action==='selected'){const selected=editor.value.slice(editor.selectionStart,editor.selectionEnd).trim();if(!selected)return toast('Select the query text to run.');await runCompareTab(selected);}else if(action==='all')await runCompareTab();else if(action==='copy')await copyText(editor.value.slice(editor.selectionStart,editor.selectionEnd)||editor.value,'Query');else if(action==='select'){editor.focus();editor.select();}else{editor.value='';tab.query.queryText='';tab.dirty=true;renderQueryTabs();editor.focus();}}));}
async function refreshCompareParsedSql(tab){try{const parsed=await call('queryParse',{query:{...tab.query,parameters:workspaceParameters}},{silentError:true});tab.parsedSql=parsed.parsedQuery??tab.query.queryText;}catch(error){tab.parsedSql=error?.message||String(error);}}
async function showCompareStatistics(){const tab=queryTabs.find(item=>item.id===compareRightTabId),pane=document.querySelector('#queryComparePane');if(!tab||!pane)return;const button=pane.querySelector('[data-compare-statistics]');tab.query.queryText=pane.querySelector('[data-compare-editor]').value;button.disabled=true;tab.summary='Calculating statistics…';renderCompareResult(tab);try{const result=await call('queryStatistics',{query:{...tab.query,parameters:workspaceParameters}},{silentError:true});tab.resultView=newResultView(result.data);tab.resultMode='grid';tab.summary='Query statistics';tab.resultMessage='Statistics calculated successfully.';}catch(error){tab.resultMode='messages';tab.resultMessage=error?.message||String(error);tab.summary='Statistics failed';}finally{button.disabled=false;renderCompareResult(tab);}}
async function runCompareTab(selectedText=null){
 const tab=queryTabs.find(item=>item.id===compareRightTabId),pane=document.querySelector('#queryComparePane');if(!tab||!pane)return;
 const button=pane.querySelector('[data-compare-run]'),editor=pane.querySelector('[data-compare-editor]');button.disabled=true;editor.disabled=true;tab.query.queryText=editor.value;tab.query.previewLimit=Number(pane.querySelector('[data-compare-limit]').value)||0;tab.status='Working…';tab.summary='Running query…';renderCompareResult(tab);
 try{const result=await call('queryRun',{query:{...tab.query,queryText:selectedText||tab.query.queryText,parameters:workspaceParameters}},{silentError:true});tab.query.data=result.data;tab.resultView=newResultView(result.data);tab.parsedSql=result.parsedQuery||selectedText||tab.query.queryText;tab.resultMessage=`Query executed successfully\nNumber of rows: ${(result.data?.rows||[]).length.toLocaleString()}`;tab.resultMode='grid';tab.status='Ready';tab.summary=`${(result.data?.rows||[]).length.toLocaleString()} row(s)`;}
 catch(error){tab.resultMode='messages';tab.resultMessage=error?.message||String(error);tab.status='Error';tab.summary='Query failed';}
 finally{button.disabled=false;editor.disabled=false;renderCompareResult(tab);}
}

function workspaceParameterForFile(parameter){const copy=structuredClone(parameter),kind=String(copy.Type||copy.type||"").toLowerCase(),secret=copy.IsSecret===true||copy.isSecret===true||/password|secret|credential|token/.test(kind);if(secret)for(const key of Object.keys(copy))if(/^(current|default).*(value|display)/i.test(key))delete copy[key];return copy;}
function tabForWorkspaceFile(tab){const{data,parameters,...definition}=tab.query;return{id:tab.id,title:tab.title,query:definition};}
function serializeQueryWorkspace(){snapshotActiveQueryTab();return JSON.stringify({kind:queryWorkspaceKind,version:queryWorkspaceVersion,mainTabId:mainQueryTabId,activeTabId:activeQueryTabId,parameters:workspaceParameters.map(workspaceParameterForFile),tabs:queryTabs.map(tabForWorkspaceFile)},null,2);}
function parseQueryWorkspace(content){
 const file=JSON.parse(content);
 if(file?.kind!==queryWorkspaceKind||file.version!==queryWorkspaceVersion)throw new Error("This is not a supported QReports query workspace file.");
 if(!Array.isArray(file.tabs)||file.tabs.length<1||file.tabs.length>30)throw new Error("A workspace must contain 1–30 query tabs.");
 const ids=new Set();for(const tab of file.tabs){if(typeof tab?.id!=="string"||!tab.id||ids.has(tab.id)||typeof tab.title!=="string"||typeof tab.query!=="object"||tab.query===null||typeof tab.query.queryText!=="string"||tab.query.queryText.length>1000000||typeof tab.query.connectionName!=="string")throw new Error("The workspace contains an invalid query tab.");ids.add(tab.id);}
 if(!ids.has(file.mainTabId))throw new Error("The workspace has no valid Main tab.");
 if(!Array.isArray(file.parameters)||file.parameters.length>500)throw new Error("The workspace parameters are invalid.");
 return file;
}
async function saveQueryWorkspace(saveAs=true){
 if(!canChangeQueryTab())return;
 try{
  const content=serializeQueryWorkspace(),direct=!saveAs&&!!workspaceFilePath,result=await call("querySqlFileSave",{workspace:true,fileName:workspaceFileName||"query-workspace.qws",...(direct?{path:workspaceFilePath,direct:true}:{}),content},{silentError:true});
  if(result.cancelled)return;
  workspaceFilePath=String(result.path||workspaceFilePath||"").trim();workspaceFileName=workspaceFilePath.split(/[\\/]/).pop()||workspaceFileName;activeSaveTargetKind="workspace";updateQuickSaveSql();
  if(typeof rememberRecentQueryFile==="function")rememberRecentQueryFile("workspace",result.path);
  queryTabs.forEach(tab=>tab.dirty=false);renderQueryTabs();toast(`Workspace saved: ${result.path}`);
 }catch(error){showResultError(error,"Workspace save failed",false);}
}
async function openQueryWorkspace(path=""){
 if(!canChangeQueryTab())return;
 let opened;
 try{opened=await call("querySqlFileOpen",{workspace:true,...(path?{path,direct:true}:{})},{silentError:true});}
 catch(error){showResultError(error,"Workspace open failed",false);return;}
 if(opened.cancelled)return;const file=parseQueryWorkspace(opened.content||"");snapshotActiveQueryTab();if(!await window.QReportsDialogs.confirm("Replace the current query tabs with this workspace? Save the current workspace first if needed."))return;
 closeQueryCompare();
 queryTabs.length=0;workspaceParameters=file.parameters;mainQueryTabId=file.mainTabId;activeQueryTabId=null;workspaceFilePath=String(opened.path||"").trim();workspaceFileName=workspaceFilePath.split(/[\\/]/).pop();activeSaveTargetKind="workspace";
 for(const item of file.tabs){const data=emptyQueryData();queryTabs.push({id:item.id,title:item.title,query:{...item.query,parameters:workspaceParameters,data},sqlFilePath:"",resultView:newResultView(data),resultMode:"grid",parsedSql:"",resultMessage:"",summary:"Run this query to load results",status:"Ready",dirty:false});}
 const target=queryTabs.find(tab=>tab.id===file.activeTabId)?.id||mainQueryTabId;
 renderQueryTabs();await activateQueryTab(target);
 if(typeof rememberRecentQueryFile==="function")rememberRecentQueryFile("workspace",opened.path);queryTabs.forEach(tab=>tab.dirty=false);renderQueryTabs();updateQuickSaveSql();toast(`Workspace opened: ${opened.path}`);
}

document.querySelector(".query-tabbar").addEventListener("click",async event=>{const action=event.target.closest("[data-workspace-action]")?.dataset.workspaceAction;if(!action)return;try{if(action==="new")addQueryTab();else if(action==="main")setActiveQueryTabAsMain();else if(action==="save")await saveQueryWorkspace();else if(action==="open")await openQueryWorkspace();}catch(error){showResultError(error,"Workspace operation failed");}});
document.addEventListener('click',event=>{if(event.target.closest('[data-table-action="select"],[data-local-table-action="select"],[data-view-action="select"]'))adoptSourceConnection();},true);
function applyQueryTabsSetting(settings=window.QReportsSettings?.get()){
 const hidden=!settings?.queryShowTabs,work=document.querySelector('.work');
 if(hidden&&compareRightTabId)closeQueryCompare();
 if(hidden&&activeQueryTabId&&!isMainQueryTab()){activateQueryTab(mainQueryTabId).then(()=>work?.classList.toggle('tabs-hidden',isMainQueryTab()));return;}
 work?.classList.toggle('tabs-hidden',hidden);
}
window.addEventListener('qreports-settings-changed',event=>applyQueryTabsSetting(event.detail));
applyQueryTabsSetting();
document.addEventListener("click",event=>{if(!event.target.closest('[data-action="apply"]'))return;event.preventDefault();event.stopImmediatePropagation();if(!isMainQueryTab())return toast("Switch to the Main tab before applying the query.");snapshotActiveQueryTab();const payload={...mainQueryTab().query,parameters:workspaceParameters};chrome.webview.postMessage({type:"queryApply",query:payload});},true);
$("queryText").addEventListener("input",markActiveQueryTabDirty);
$("previewLimit").addEventListener("input",markActiveQueryTabDirty);
$("queryRunConnection").addEventListener("change",event=>{query.connectionName=event.target.value;markActiveQueryTabDirty();});
chrome.webview.addEventListener("message",event=>{if(event.data?.type==="loadQueryWorkspace")initializeQueryTabsFromHost();});
