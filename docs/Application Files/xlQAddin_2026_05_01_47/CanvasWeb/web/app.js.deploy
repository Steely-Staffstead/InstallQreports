  });
  window.addEventListener("pointerup", () => { clearAlignmentGuides();document.body.classList.remove("canvas-geometry-edit");if (!drag)return;const completed=drag;drag=null;if(!completed.changed)return;if(completed.mode==="connector"){const start=completed.end==="start",x=completed.t[start?'x1':'x2'],y=completed.t[start?'y1':'y2'],point={x,y},target=allObjects(page()).filter(item=>item.id!==completed.t.id&&!["connector","line"].includes(item.kind)).find(item=>x>=item.x-24&&x<=item.x+item.width+24&&y>=item.y-24&&y<=item.y+item.height+24);if(target){const port=nearestPort(target,point);completed.t[start?'fromId':'toId']=target.id;completed.t[start?'fromAnchor':'toAnchor']={side:port.side,offset:port.offset};}}if(completed.mode==="resize"&&completed.t.kind==="chart")refreshTileBody(completed.t,completed.node);refreshConnectors();applyCanvasSize();renderProperties();renderGraphicProperties();renderLayerProperties();markDirty(); });



  function renderProperties() { themeControls.render();const t = selectedTile(); $("#noSelection").classList.toggle("hidden", !!t); $("#tileProperties").classList.toggle("hidden", !t); $("#designTileButton").classList.toggle("hidden", !t || !["table", "matrix", "chart"].includes(t.kind)); $("#webChartButton").classList.toggle("hidden", !t || t.kind !== "chart"); if (!t) { $("#selectionStatus").textContent = "No tile selected"; return; } const graphic=graphicKinds.has(t.kind),dataBound=t.kind==="card";["tileTitle","tileText","tileX","tileY","tileWidth","tileHeight","tileHeader","tileBackground"].forEach(id=>$("#"+id)?.closest("label")?.classList.toggle("hidden",graphic));$("#tileField")?.closest("label")?.classList.toggle("hidden",graphic||!dataBound);const settingsSummary=document.querySelector(".tile-settings summary");if(settingsSummary)settingsSummary.textContent=graphic?"Graphic settings":"Tile settings";$("#selectionStatus").textContent = selectedIds.size>1?`${selectedIds.size} objects selected`:`${t.title} selected`; const fields = [...query().data.columns, ...query().measures.map(m => m.Name ?? m.name ?? m.OutputName ?? m.outputName).filter(Boolean)]; $("#tileField").innerHTML = `<option value="">Select field or measure…</option>${[...new Set(fields)].map(f => `<option ${f === t.field ? "selected" : ""}>${esc(f)}</option>`).join("")}`; $("#tileTitle").value = t.title || ""; $("#tileText").value = t.text || ""; const rich = ["text","graphicText"].includes(t.kind); $("#plainTextLabel").classList.toggle("hidden", t.kind !== "picture"); $("#richTextGroup").classList.toggle("hidden", !rich); $("#textTileFont").classList.toggle("hidden", !rich||graphic); if (rich && document.activeElement !== $("#richTextEditor")) $("#richTextEditor").innerHTML = sanitizeHtml(t.html || ""); if (rich) { $("#tileFontFamily").value = t.fontFamily || "Segoe UI"; $("#tileFontSize").value = t.fontSize || 14; $("#tileTextColor").value = t.textColor || "#1f2937"; } $("#tileX").value = t.x; $("#tileY").value = t.y; $("#tileWidth").value = t.width; $("#tileHeight").value = t.height; $("#tileHeader").checked = t.showHeader; $("#tileBackground").value = t.background; }
  function setLayer(command){const ordered=allObjects(page()).sort((a,b)=>(a.layer??0)-(b.layer??0)),index=ordered.findIndex(t=>t.id===selectedId);if(index<0)return;const [item]=ordered.splice(index,1);if(command==="front")ordered.push(item);else if(command==="back")ordered.unshift(item);else if(command==="forward")ordered.splice(Math.min(index+1,ordered.length),0,item);else ordered.splice(Math.max(0,index-1),0,item);ordered.forEach((t,i)=>t.layer=i);markDirty();render();}
  function moveSelectionToPage(targetIndex){if(targetIndex===pageIndex||!model.pages[targetIndex])return;const sourcePage=page(),ids=selectedIds.size?new Set(selectedIds):new Set([selectedId]),target=model.pages[targetIndex],movedTiles=(sourcePage.tiles||[]).filter(item=>ids.has(item.id)),movedGraphics=(sourcePage.graphics||[]).filter(item=>ids.has(item.id));sourcePage.tiles=(sourcePage.tiles||[]).filter(item=>!ids.has(item.id));sourcePage.graphics=(sourcePage.graphics||[]).filter(item=>!ids.has(item.id));target.tiles||=[];target.graphics||=[];target.tiles.push(...movedTiles);target.graphics.push(...movedGraphics);pageIndex=targetIndex;selectedIds=new Set([...movedTiles,...movedGraphics].map(item=>item.id));selectedId=[...selectedIds].at(-1)||null;markDirty();render();$("#saveStatus").textContent=`Moved ${selectedIds.size} ${selectedIds.size===1?"object":"objects"} to ${target.name}`;}
