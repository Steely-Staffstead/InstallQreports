  let presentationState=null;
  function setPresentationZoom(value){
    if(!presentationState)return;
    const zoom=Math.max(25,Math.min(200,Math.round(value)));
    if(!Number.isFinite(zoom))return;
    presentationState.zoom=zoom;
    // Scale only the canvas; CSS zoom also updates its scrollable layout bounds.
    document.querySelector("#canvas").style.setProperty("--presentation-zoom",String(zoom/100));
    const header=document.querySelector("#presentationHeader");
    header.querySelector("[data-presentation-zoom-level]").textContent=zoom+"%";
    header.querySelector("[data-presentation-zoom-out]").disabled=zoom<=25;
    header.querySelector("[data-presentation-zoom-in]").disabled=zoom>=200;
    header.querySelector("[data-presentation-zoom-reset]").disabled=zoom===100;
  }
