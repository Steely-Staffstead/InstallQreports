    options.addEventListener("click",event=>{if(!event.target.matches("[data-remove-row],[data-remove-column],[data-remove-value]"))return;setTimeout(()=>{normalizeSorts();draw();});});
    const sortFields=()=>[...state.rows,...state.values.map(value=>value.field)];
