  function renderGeneralSettings(){
    const properties=$("#tileProperties");if(!properties)return;
    if(selectedTile()?.kind==="chart"&&activeChartPropertyGroup==="Title settings"&&!$("#quickChartTitle")){const label=document.createElement("label");label.id="quickChartTitle";label.innerHTML='<span>Title</span><input type="text" data-chart-option="TitleText">';label.querySelector("input").value=selectedTile().design?.chartSpec?.ChartOptions?.TitleText??selectedTile().design?.chartSpec?.Name??"Chart";$("#chartPropertyControls")?.querySelector('[data-chart-option="ShowTitle"]')?.closest("label")?.after(label);}
    let general=$("#tileGeneralSettings");
    if(!general){general=document.createElement("details");general.id="tileGeneralSettings";general.innerHTML="<summary>General settings</summary>";properties.append(general);}
    $("#headerSettings")?.after(general);
    $("#headerSettings")?.querySelector("summary")?.after($("#tileHeader").closest("label"));
    $("#tileHeight").min=selectedTile()?.kind==="picture"?30:0;
    let imagePicker=$("#localImagePicker");
    if(!imagePicker){
      imagePicker=document.createElement("div");imagePicker.id="localImagePicker";
      imagePicker.innerHTML='<label class="file-button">Choose image…<input type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/bmp"></label><p>Find an image and paste its direct image URL above.</p><p>Free Sources:</p><ul><li><a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a></li><li><a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer">Pexels</a></li><li><a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a></li></ul><small data-image-name></small>';
      $("#pictureProperties")?.querySelector("summary")?.after(imagePicker);
      imagePicker.querySelector("input").addEventListener("change",async event=>{
        const tile=selectedTile(),file=event.target.files[0];if(tile?.kind!=="picture"||!file)return;
        if(file.size>20*1024*1024){$("#jsonError").textContent="Choose an image smaller than 20 MB.";return;}
        try{const value=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(reader.error);reader.readAsDataURL(file);});tile.text=value;tile.imageFileName=file.name;markDirty();render();}catch(error){$("#jsonError").textContent=error.message;}
      });
    }
    imagePicker.querySelector("[data-image-name]").textContent=selectedTile()?.imageFileName?`Embedded image: ${selectedTile().imageFileName}`:"Local images are included in the canvas file.";
    const position=$("#tileX")?.closest(".property-grid");
    [$("#tileSourceLabel"),$("#tileField")?.closest("label"),position,$("#textRoundingControl"),$("#tileBackground")?.closest("label"),properties.querySelector('[data-picture="transparentBackground"]')?.closest("label")].filter(Boolean).forEach(control=>general.append(control));
    general.classList.toggle("hidden",!selectedTile()||graphicKinds.has(selectedTile().kind));
    const body=$("#textBodySettings");if(body)general.after(body);
    const imageSettings=$("#pictureProperties");if(imageSettings){general.after(imageSettings);imageSettings.append($("#plainTextLabel"));}
    const panel=$("#cardProperties");if(!panel)return;
    // The card renderer rebuilds its controls; retain each section's expansion state.
    Array.from(panel.querySelectorAll("h4")).forEach(heading=>{
      const name=heading.textContent,section=document.createElement("details"),summary=document.createElement("summary");
      summary.textContent=name;section.append(summary);section.open=cardSectionState.get(name)||false;
      heading.before(section);
      while(heading.nextSibling&&heading.nextSibling.nodeName!=="H4")section.append(heading.nextSibling);
      heading.remove();section.addEventListener("toggle",()=>{if(section.isConnected)cardSectionState.set(name,section.open);});
    });
