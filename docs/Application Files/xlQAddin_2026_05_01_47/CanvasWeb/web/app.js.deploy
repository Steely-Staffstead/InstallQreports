      else if(template.value==='progressRing')input.value=`<svg viewBox="0 0 220 220"><circle cx="110" cy="110" r="82" fill="none" stroke="${background}" stroke-width="22" opacity=".18"/><circle cx="110" cy="110" r="82" pathLength="100" fill="none" stroke="${background}" stroke-width="22" stroke-linecap="round" stroke-dasharray="${value} 100" transform="rotate(-90 110 110)"/><text x="110" y="104" text-anchor="middle" fill="${background}" font-family="Segoe UI, Arial" font-size="18" font-weight="700">${title}</text><text x="110" y="139" text-anchor="middle" fill="${background}" font-family="Segoe UI, Arial" font-size="30" font-weight="700">${value}%</text>${subtext?`<text x="110" y="174" text-anchor="middle" fill="${background}" opacity=".72" font-family="Segoe UI, Arial" font-size="12">${subtext}</text>`:''}</svg>`;
