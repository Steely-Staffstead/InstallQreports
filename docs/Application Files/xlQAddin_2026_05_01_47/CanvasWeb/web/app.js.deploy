  function columnPropertiesHtml(selected,fields,includeBars=true,includeMissing=false){if(!selected)return "";const current=selected.format||"Auto",preset=formatChoices.includes(current)?current:"Custom",custom=preset==="Custom"?current:"#,##0.0";return `<label>Caption<input data-column-caption value="${esc(selected.caption||selected.field)}"></label><label>Format<select data-column-format>${formatChoices.map(value=>`<option ${value===preset?"selected":""}>${value}</option>`).join("")}</select></label><label data-custom-format-wrap class="${preset==="Custom"?"":"hidden"}">Custom format<input data-column-custom-format value="${esc(custom)}"><small data-format-preview>Preview: ${esc(format(1234567.89,custom))}</small></label><label>Alignment<select data-column-align>${["Auto","Left","Center","Right"].map(value=>`<option ${value===(selected.align||"Auto")?"selected":""}>${value}</option>`).join("")}</select></label>${includeMissing?`<label>Missing / NaN text<input data-column-missing-text value="${esc(selected.missingText??"")}" placeholder="Blank"></label>`:""}${includeBars?dataBarPropertiesHtml(selected,fields):""}`;}
  function bindColumnFormat(container,selected,refreshPreview){const select=container.querySelector("[data-column-format]"),wrap=container.querySelector("[data-custom-format-wrap]"),custom=container.querySelector("[data-column-custom-format]"),preview=container.querySelector("[data-format-preview]");if(!select)return;const apply=()=>{const isCustom=select.value==="Custom";wrap?.classList.toggle("hidden",!isCustom);selected.format=isCustom?(custom?.value||"#,##0.0"):select.value;if(preview)preview.textContent=`Preview: ${format(1234567.89,selected.format)}`;refreshPreview();};select.addEventListener("change",apply);custom?.addEventListener("input",apply);}
  function sortDesignerHtml(sorts,fields){return `<section class="sort-designer"><h4>Advanced ordering</h4><small>Columns are applied from top to bottom.</small>${sorts.map((sort,index)=>`<div class="sort-row"><span>${index+1}</span><select data-sort-field="${index}">${fields.map(field=>`<option ${field===sort.field?"selected":""}>${esc(field)}</option>`).join("")}</select><select data-sort-direction="${index}"><option value="asc" ${sort.direction!=="desc"?"selected":""}>Ascending</option><option value="desc" ${sort.direction==="desc"?"selected":""}>Descending</option></select><button data-sort-up="${index}" title="Higher priority">↑</button><button data-sort-down="${index}" title="Lower priority">↓</button><button data-sort-remove="${index}" title="Remove">×</button></div>`).join("")}<button data-sort-add>+ Add ordering</button></section>`;}
  function bindSortDesigner(container,sorts,fields,redraw){container.querySelector("[data-sort-add]")?.addEventListener("click",()=>{const field=fields.find(name=>!sorts.some(sort=>sort.field===name))||fields[0];if(field){sorts.push({field,direction:"asc"});redraw();}});container.querySelectorAll("[data-sort-field]").forEach(input=>input.onchange=()=>{sorts[+input.dataset.sortField].field=input.value;redraw();});container.querySelectorAll("[data-sort-direction]").forEach(input=>input.onchange=()=>{sorts[+input.dataset.sortDirection].direction=input.value;redraw();});container.querySelectorAll("[data-sort-remove]").forEach(button=>button.onclick=()=>{sorts.splice(+button.dataset.sortRemove,1);redraw();});container.querySelectorAll("[data-sort-up]").forEach(button=>button.onclick=()=>{const i=+button.dataset.sortUp;if(i>0)[sorts[i-1],sorts[i]]=[sorts[i],sorts[i-1]];redraw();});container.querySelectorAll("[data-sort-down]").forEach(button=>button.onclick=()=>{const i=+button.dataset.sortDown;if(i<sorts.length-1)[sorts[i+1],sorts[i]]=[sorts[i],sorts[i+1]];redraw();});}
