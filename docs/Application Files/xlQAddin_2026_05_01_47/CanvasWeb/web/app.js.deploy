  function dataBarPropertiesHtml(selected,fields){if(!selected)return "";const bar=selected.bar||={type:"None",alignment:"Left",scope:"GroupsAndDetail",color:"#4f8bd6",negativeColor:"#d95c5c",comparisonField:"",backgroundField:"",backgroundColor:"#d8e0eb",targetColor:"#111827",targetThickness:3};return `<details class="column-bars"><summary>Data bar / bullet graph</summary><label>Bar type<select data-bar="type">${[["None","None"],["DataBar","Data bar"],["Bullet","Bullet graph"]].map(([value,label])=>`<option value="${value}" ${value===bar.type?"selected":""}>${label}</option>`).join("")}</select></label><div class="two-cols"><label>Alignment<select data-bar="alignment">${["Left","Center","Right"].map(value=>`<option ${value===bar.alignment?"selected":""}>${value}</option>`).join("")}</select></label><label>Draw bars on<select data-bar="scope">${[["GroupsAndDetail","Groups and detail"],["Groups","Groups only"],["Detail","Detail only"]].map(([value,label])=>`<option value="${value}" ${value===bar.scope?"selected":""}>${label}</option>`).join("")}</select></label><label>Bar color<input data-bar="color" type="color" value="${bar.color}"></label><label>Negative color<input data-bar="negativeColor" type="color" value="${bar.negativeColor}"></label></div><label>Comparison measure<select data-bar="comparisonField"><option value="">None</option>${fields.map(value=>`<option ${value===bar.comparisonField?"selected":""}>${esc(value)}</option>`).join("")}</select></label><label>Background measure<select data-bar="backgroundField"><option value="">Automatic</option>${fields.map(value=>`<option ${value===bar.backgroundField?"selected":""}>${esc(value)}</option>`).join("")}</select></label><div class="two-cols"><label>Backcolor<input data-bar="backgroundColor" type="color" value="${bar.backgroundColor}"></label><label>Target color<input data-bar="targetColor" type="color" value="${bar.targetColor}"></label><label>Target thickness<input data-bar="targetThickness" type="number" min="