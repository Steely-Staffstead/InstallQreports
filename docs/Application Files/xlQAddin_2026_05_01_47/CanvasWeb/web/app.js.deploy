  window.addEventListener("pointerdown",event=>{if(!document.body.classList.contains("presentation-mode")||event.target.closest("#presentationHeader,#presentationPageNav,#presentationFiltersPane,.range-calendar,[data-value-selector]"))return;event.stopImmediatePropagation();},true);
  window.addEventListener("contextmenu",event=>{if(!document.body.classList.contains("presentation-mode")||event.target.closest("#presentationHeader,#presentationPageNav,#presentationFiltersPane,.range-calendar"))return;event.preventDefault();event.stopImmediatePropagation();},true);
  window.addEventListener("click",event=>{if(!document.body.classList.contains("presentation-mode")||event.target.closest("#presentationHeader,#presentationPageNav,#presentationFiltersPane,.range-calendar"))return;const selectorButton=event.target.closest("[data-value-selector]");if(selectorButton){const tileNode=selectorButton.closest(".tile"),tile=allObjects(page()).find(item=>item.id===tileNode?.dataset.id);if(applySelectorChoice(tile,selectorButton.dataset.valueSelector,true)){event.preventDefault();event.stopImmediatePropagation();}return;}const link=event.target.closest('a[href^="#qanvas-page="]');if(link){event.preventDefault();const key=decodeURIComponent(link.getAttribute("href").slice(13)),index=model.pages.findIndex(item=>(item.id||item.name)===key);if(index>=0){pageIndex=index;presentationDraw();}}const sortHeader=event.target.closest("[data-tile-sort]");if(sortHeader){event.preventDefault();const tileNode=sortHeader.closest(".tile"),tile=allObjects(page()).find(item=>item.id===tileNode?.dataset.id),field=sortHeader.dataset.tileSort;if(tile&&field){tile.sorts||=[];const existing=tile.sorts.find(sort=>sort.field===field);if(!event.shiftKey)tile.sorts=existing?[existing]:[];const current=tile.sorts.find(sort=>sort.field===field);if(!current)tile.sorts.push({field,direction:"asc"});else if(current.direction==="asc")current.direction="desc";else tile.sorts=tile.sorts.filter(sort=>sort.field!==field);presentationDraw();}}const toggle=event.target.closest("[data-matrix-toggle]");if(toggle){const tile=toggle.closest(".tile"),spec=allObjects(page()).find(item=>item.id===tile?.dataset.id)?.design?.matrixSpec,key=decodeURIComponent(toggle.dataset.matrixToggle);if(spec){spec.collapsedGroups||={};const field=spec.rows[Math.max(0,JSON.parse(key).length-1)];spec.collapsedGroups[key]=!(spec.collapsedGroups[key]??spec.rowOptions?.[field]?.startCollapsed??false);presentationDraw();}}event.stopImmediatePropagation();},true);
  window.canvasWeb = {
    viewerLoad(document){model=normalize(structuredClone(document));selectedId=null;selectedIds.clear();model.settings.showDesignHandles=false;model.settings.showTypeTags=false;pageIndex=0;},
    viewerDocument(){return model;},
    viewerRender(index=pageIndex){pageIndex=index;const canvas=$("#canvas"),p=page();canvas.querySelectorAll(".tile").forEach(n=>n.remove());$("#emptyState").classList.add("hidden");Object.assign(canvas.style,{backgroundColor:pageBackgroundColor(p),backgroundImage:p.background.image?`url("${p.background.image}")`:"",backgroundSize:p.background.fit||"cover"});applyCanvasSize();allObjects(p).sort((a,b)=>(a.layer||0)-(b.layer||0)).forEach(t=>{renderQueryContext=displayQueryForTile(t);canvas.insertAdjacentHTML("beforeend",tileHtml(t));renderQueryContext=null;});correctFixedChartText(canvas);},
    viewerSelectValue(id,value){const tile=allObjects(page()).find(item=>item.id===id);return applySelectorChoice(tile,value,true);},
    viewerToggle(id,key){const tile=allObjects(page()).find(t=>t.id===id),spec=tile?.design?.matrixSpec;if(!spec)return;spec.collapsedGroups||={};const field=spec.rows[Math.max(0,JSON.parse(key).length-1)];spec.collapsedGroups[key]=!(spec.collapsedGroups[key]??spec.rowOptions?.[field]?.startCollapsed??false);this.viewerRender();},
    viewerSort(id,field,additive){const tile=allObjects(page()).find(t=>t.id===id);if(!tile)return;tile.sorts||=[];const existing=tile.sorts.find(s=>s.field===field);if(!additive)tile.sorts=existing?[existing]:[];const sort=tile.sorts.find(s=>s.field===field);if(!sort)tile.sorts.push({field,direction:"asc"});else if(sort.direction==="asc")sort.direction="desc";else tile.sorts=tile.sorts.filter(s=>s.field!==field);this.viewerRender();},
    prepareExcelExport() { const c = page().canvas, canvas = $("#canvas"); let width=c.width||1280,height=c.height||720;if(c.mode==="preset")[width,height]=String(c.preset||"1280x720").split("x").map(Number);document.body.classList.remove("busy");document.body.classList.add("excel-export"); canvas.style.width = `${Math.max(320, width)}px`; canvas.style.height = `${Math.max(240, height)}px`; canvas.querySelectorAll(".tile").forEach(tile => tile.classList.remove("selected")); return JSON.stringify({ width:canvas.offsetWidth, height:canvas.offsetHeight }); },
    preparePdfExport() {
      this.pdfPreviousPage=pageIndex;
      document.querySelector('.pdf-export-pages')?.remove();
      document.body.classList.add('excel-export');
      const pages=document.createElement('div');pages.className='pdf-export-pages';
      const snapshots=[];
      for(let index=0;index<model.pages.length;index++){
        this.viewerRender(index);
        const size=JSON.parse(this.prepareExcelExport()),canvas=$('#canvas').cloneNode(true);
        canvas.removeAttribute('id');canvas.classList.add('pdf-export-canvas');
        snapshots.push({canvas,...size});
      }
      const width=Math.max(...snapshots.map(item=>item.width)),height=Math.max(...snapshots.map(item=>item.height));
      for(const item of snapshots){
        const sheet=document.createElement('section');sheet.className='pdf-export-page';
        sheet.style.width=`${width}px`;sheet.style.height=`${height}px`;
        Object.assign(item.canvas.style,{position:'absolute',left:'0',top:'0',margin:'0',transformOrigin:'top left',transform:`scale(${Math.min(width/item.width,height/item.height)})`});
        sheet.append(item.canvas);pages.append(sheet);
      }
      document.body.append(pages);document.body.classList.add('pdf-export');
      return JSON.stringify({width,height,pages:snapshots.length});
    },
    finishPdfExport() { document.querySelector('.pdf-export-pages')?.remove();document.body.classList.remove('pdf-export');pageIndex=this.pdfPreviousPage??pageIndex;delete this.pdfPreviousPage;this.finishExcelExport(); },
    finishExcelExport() { document.body.classList.remove("excel-export"); document.body.classList.remove("busy"); render(); }
  };
  function parameterLookupChoices(result){if(Array.isArray(result.choices))return result.choices;const data=result.data||{},columns=data.columns||[],rows=data.rows||[],index=name=>Math.max(0,columns.findIndex(x=>String(x).toLowerCase()===String(name||"").toLowerCase())),vi=index(result.valueColumn),di=index(result.displayColumn),hi=(result.hierarchyColumns||[]).map(index);return rows.map(row=>({value:row[vi],display:row[di],hierarchyValues:hi.map(i=>row[i]).filter(value=>value!==null&&value!==undefined&&String(value)!=="")}));}
  if(host){if(window.WebExportSettings)window.WebExportSettings.install({model:()=>model,changed:markDirty,post,host,status:message=>$("#saveStatus").textContent=message});else {const message="Export settings could not be loaded.";$("#saveStatus").textContent=message;document.querySelectorAll('[data-action="exportWebpage"],[data-action="presentationSettings"]').forEach(button=>{button.title=message;button.disabled=true;});}}
  document.querySelector('[data-action="exportPdf"]')?.addEventListener("click",()=>post("exportPdf",{name:model.name}));
  document.addEventListener("click",event=>{const action=event.target.closest("[data-action]")?.dataset.action,menu=$("#exportMenu");if(action==="toggleExport"){menu?.classList.toggle("hidden");event.stopPropagation();return;}if(["exportPdf","exportWebpage"].includes(action))menu?.classList.add("hidden");else if(!event.target.closest(".export-menu-wrap"))menu?.classList.add("hidden");},true);
  const sourceLabel=document.querySelector(".query-summary dt");if(sourceLabel)sourceLabel.textContent="Source";
  const themeControls=CanvasThemeControls.install({model:()=>model,selected:selectedTile,changed:()=>{markDirty();render();}});window.addEventListener("qreports-settings-changed",()=>{if(!dirty&&!originalQrcn&&model.name==="Untitled report"&&!allObjects(page()).length){model=newDocument();model=normalize(model);}render();});setupUpdateMenu();render(); post("ready");
})();
