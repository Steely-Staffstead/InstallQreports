  function ensureSourceUi(){
    if(!$("#sourceList")){const pagesHeading=[...document.querySelectorAll(".left-panel .section-heading")].find(node=>node.textContent.includes("Pages"));pagesHeading?.insertAdjacentHTML("beforebegin",'<div class="section-heading"><span>Data sources</span><button class="icon-button" data-action="addSource" title="Add global source">+</button></div><div id="sourceList" class="source-list"></div><div class="source-actions"><button data-action="renameSource">Rename</button><button data-action="deleteSource">Delete</button></div>');}
    if(!$("#activeSourceName")){const heading=document.querySelector(".query-summary b");if(heading)heading.id="activeSourceName";}
    if(!$("#tileSource")){const field=$("#tileField")?.closest("label");field?.insertAdjacentHTML("beforebegin",'<label id="tileSourceLabel">Data source<select id="tileSource"></select></label>');$("#tileSource")?.addEventListener("change",event=>{const tile=selectedTile();if(!tile)return;tile.sourceId=event.target.value;if(tile.design)delete tile.design.data;activeSourceId=tile.sourceId;markDirty();render();});}
    const filterTab=document.querySelector('[data-panel="filters"]');if(filterTab)filterTab.textContent="Filters";
    const filtersPanel=$("#filtersPanel");if(filtersPanel&&!$("#tileFilterList")){filtersPanel.querySelector(".panel-title").textContent="Source query filters";const note=filtersPanel.querySelector(".property-empty");if(note)note.textContent="Source filters use the data already loaded for this source and affect every tile connected to it.";note?.insertAdjacentHTML("afterend",'<hr class="filter-divider"><div class="panel-title">Tile filters</div><div id="tileFilterContext" class="filter-context">Select a data tile to add a local filter.</div><div id="tileFilterList"></div><button data-action="addTileFilter">+ Add local filter</button><button class="primary" data-action="applyTileFilters">Apply filter</button><p class="property-empty">Tile filters use loaded source data and affect only the referenced tile.</p>');}
  }
  function renderCanvasTheme(){window.canvasSettingsPalettes=[...Object.entries(builtInPalettes).map(([name,colors])=>({name,colors})),...(model.settings.palettes||[]),{name:model.settings.theme.name,colors:model.settings.theme.colors}];const select=$("#canvasPalette"),colors=$("#canvasPaletteColors");if(!select||!colors)return;const theme=model.settings.theme||={name:"Default",colors:[...builtInPalettes.Default]},names=[...Object.keys(builtInPalettes),...(model.settings.palettes||[]).map(item=>item.name)];if(!names.includes(theme.name))names.unshift(theme.name);select.innerHTML=names.map(name=>`<option ${name===theme.name?"selected":""}>${esc(name)}</option>`).join("");colors.innerHTML=theme.colors.map((color,index)=>`<span class="palette-color"><input type="color" value="${color}" data-palette-color="${index}" title="Color ${index+1}"><button type="button" data-remove-palette-color="${index}" title="Remove">×</button></span>`).join("");}
  function render() {
    ensureSourceUi();
    applyPaneLayout();
    $("#reportName").value = model.name || "";
    $("#hostBadge").textContent = host ? "Desktop bridge active" : "Web mode";
    $("#pageList").innerHTML = model.pages.map((p, i) => `<button class="page-item ${i === pageIndex ? "active" : ""}" data-page="${i}">${esc(p.name)}</button>`).join("");
    const currentSource=activeSource();activeSourceId=currentSource?.id||"main";$("#sourceList").innerHTML=model.sources.map(source=>`<button class="source-item ${source.id===activeSourceId?"active":""}" data-source-id="${esc(source.id)}"><span>${source.kind==="main"?"◆":"◇"}</span><b>${esc(source.name)}</b><small>${source.kind==="main"?"Main":"Global"}</small></button>`).join("");
    $("#pageName").value = page().name; $("#activeSourceName").textContent=currentSource?.name||"Main source"; $("#queryConnection").textContent = query().connectionName || "Not set"; $("#measureCount").textContent = query().measures.length; $("#rowCount").textContent = `${query().data.rows.length}${query().totalRows > query().data.rows.length ? ` of ${query().totalRows}` : ""}`; $("#previewLimit").value = query().previewLimit;
    applyCanvasSizeControls();
    $("#pageBackgroundUseTheme").checked = !!page().background.useTheme; $("#pageBackground").disabled = !!page().background.useTheme;
    $("#pageBackground").value = pageBackgroundColor(page()); $("#pageBackgroundImage").value = page().background.image; $("#pageBackgroundFit").value = page().background.fit;
    Object.assign($("#canvas").style, { backgroundColor: pageBackgroundColor(page()), backgroundImage: page().background.image ? `url("${page().background.image.replace(/["\\]/g, "")}")` : "", backgroundSize: page().background.image ? page().background.fit : "20px 20px", backgroundRepeat: page().background.image ? "no-repeat" : "repeat", backgroundPosition: "center" });
    renderFilters();
    $("#canvas").querySelectorAll(".tile").forEach(n => n.remove()); const objects=allObjects(page());$("#emptyState").classList.toggle("hidden", objects.length > 0);
    [...objects].sort((a,b)=>(a.layer??0)-(b.layer??0)).forEach(t => {renderQueryContext=displayQueryForTile(t);$("#canvas").insertAdjacentHTML("beforeend", tileHtml(t));renderQueryContext=null;});
    objects.forEach(t=>{const node=$("#canvas").querySelector(`.tile[data-id="${t.id}"]`);if(node)node.style.zIndex=t.layer??0;});
    bindTiles(); renderPropertyPanels();renderCanvasTheme(); correctFixedChartText($("#canvas")); syncJson();
  }
  function renamePageInline(index){const button=$("#pageList")?.querySelector(`[data-page="${index}"]`),item=model.pages[index];if(!button||!item)return;const input=document.createElement("input");input.className="page-name-editor";input.value=item.name||`Page ${index+1}`;button.replaceWith(input);input.focus();input.select();let finished=false;const finish=save=>{if(finished)return;finished=true;const name=input.value.trim();if(save&&name)item.name=name;markDirty();render();};input.addEventListener("keydown",event=>{if(event.key==="Enter")finish(true);if(event.key==="Escape")finish(false);});input.addEventListener("blur",()=>finish(true),{once:true});}
  function movePage(index,target){if(index<0||index>=model.pages.length)return;const destination=target==="top"?0:target==="up"?Math.max(0,index-1):target==="down"?Math.min(model.pages.length-1,index+1):model.pages.length-1;if(destination===index)return;const[item]=model.pages.splice(index,1);model.pages.splice(destination,0,item);pageIndex=destination;selectedId=null;selectedIds.clear();markDirty();render();}
  function themedConfirm(title,message,confirmLabel="Delete"){return new Promise(resolve=>{const dialog=document.createElement("dialog");dialog.className="qanvas-confirm-dialog";dialog.innerHTML=`<form method="dialog"><h3>${esc(title)}</h3><p>${esc(message)}</p><div><button value="cancel">Cancel</button><button value="confirm" class="danger">${esc(confirmLabel)}</button></div></form>`;dialog.addEventListener("close",()=>{const accepted=dialog.returnValue==="confirm";dialog.remove();resolve(accepted);},{once:true});document.body.append(dialog);dialog.showModal();});}
  async function deletePage(index){if(model.pages.length<=1){$("#saveStatus").textContent="A report must contain at least one page";return;}const name=model.pages[index]?.name||`Page ${index+1}`;if(!await themedConfirm("Delete page",`Delete “${name}” and all of its tiles?`))return;const previousPageIndex=pageIndex;model.pages.splice(index,1);if(index<previousPageIndex)pageIndex=previousPageIndex-1;else if(index===previousPageIndex)pageIndex=Math.min(index,model.pages.length-1);else pageIndex=previousPageIndex;selectedId=null;selectedIds.clear();markDirty();render();}
  function showPageMenu(event,index){event.preventDefault();event.stopPropagation();document.querySelector(".tile-context-menu")?.remove();const menu=document.createElement("div");menu.className="tile-context-menu page-context-menu";menu.style.left=`${Math.min(event.clientX,innerWidth-215)}px`;menu.style.top=`${Math.min(event.clientY,innerHeight-230)}px`;menu.innerHTML='<button data-page-command="rename">Edit name</button><button data-page-command="top">Move to top</button><button data-page-command="up">Move up</button><button data-page-command="down">Move down</button><button data-page-command="bottom">Move to bottom</button><button class="danger" data-page-command="delete">Delete</button>';document.body.append(menu);menu.addEventListener("click",click=>{const command=click.target.closest("[data-page-command]")?.dataset.pageCommand;if(!command)return;menu.remove();if(command==="rename")renamePageInline(index);else if(command==="delete")deletePage(index);else movePage(index,command);});}
  function applyPaneLayout(){const root=document.documentElement,main=document.querySelector("main"),settings=model.settings;root.style.setProperty("--left-pane-width",`${Math.max(150,Math.min(480,settings.leftPaneWidth||205))}px`);root.style.setProperty("--right-pane-width",`${Math.max(220,Math.min(620,settings.rightPaneWidth||285))}px`);if(!document.querySelector("#canvasPaneDockStyles")){const style=document.createElement("style");style.id="canvasPaneDockStyles";style.textContent=`main{grid-template-columns:var(--left-pane-width,205px) 6px minmax(520px,1fr) 6px var(--right-pane-width,285px)}.pane-splitter{cursor:col-resize;background:#e2e7ef}.pane-splitter:hover{background:#9fb1cc}.pane-dock{position:sticky;top:0;z-index:5;width:28px;height:34px;padding:0;border-radius:7px}.left-panel .pane-dock{float:right}.right-panel .pane-dock{float:left}.left-collapsed{grid-template-columns:30px 0 minmax(520px,1fr) 6px var(--right-pane-width,285px)}.right-collapsed{grid-template-columns:var(--left-pane-width,205px) 6px minmax(520px,1fr) 0 30px}.left-collapsed.right-collapsed{grid-template-columns:30px 0 minmax(520px,1fr) 0 30px}.left-collapsed .left-panel,.right-collapsed .right-panel{padding:6px 1px;overflow:hidden}.left-collapsed .left-panel>*:not(.pane-dock),.right-collapsed .right-panel>*:not(.pane-dock){display:none}.left-collapsed .left-panel .pane-dock,.right-collapsed .right-panel .pane-dock{float:none;margin:auto}`;document.head.append(style);const left=document.createElement("button"),right=document.createElement("button");left.className="pane-dock";right.className="pane-dock";left.dataset.action="toggleLeftPane";right.dataset.action="toggleRightPane";document.querySelector(".left-panel").prepend(left);document.querySelector(".right-panel").prepend(right)}document.querySelector(".left-panel .pane-dock").textContent=settings.leftPaneCollapsed?"›":"‹";document.querySelector(".right-panel .pane-dock").textContent=settings.rightPaneCollapsed?"‹":"›";main.classList.togg