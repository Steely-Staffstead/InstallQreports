function ensureLocalDataDialog(){if($("localDataModal"))return;const modal=document.createElement("div");modal.id="localDataModal";modal.className="modal hidden";modal.innerHTML=`<div class="dialog local-data-dialog"><div class="filter-head"><div><h2>Local data</h2><p class="muted">Paste an Excel range, enter values directly, or import a file.</p></div><button data-local-action="close">×</button></div><div class="two"><label>Table name<input id="localTableName" placeholder="MyTable"></label><label>First pasted row<select id="localHasHeaders"><option value="true">Contains headers</option><option value="false">Contains data</option></select></label></div><textarea id="localPaste" rows="6" placeholder="Paste tab-separated or comma-separated values here"></textarea><div class="local-actions"><button data-local-action="parse">Use pasted data</button><button data-local-action="row">＋ Row</button><button data-local-action="column">＋ Column</button><button data-local-action="import">Import CSV/TXT…</button><button data-local-action="importExcel">Import Excel…</button></div><div id="localGrid" class="local-grid"></div><p id="localError" class="pw-error"></p><div class="dialog-actions"><button data-local-action="close">Cancel</button><button class="apply" data-local-action="save">Save local table</button></div></div>`;document.body.appendChild(modal);modal.addEventListener("click",async event=>{const action=event.target.closest("[data-local-action]")?.dataset.localAction;if(!action)return;try{if(action==="close")modal.classList.add("hidden");else if(action==="parse")useLocalPaste();else if(action==="row")addLocalRow();else if(action==="column")addLocalColumn();else if(action==="save")await saveLocalData();else if(action==="import")await importLocalFile();else if(action==="importExcel")await importLocalExcel();}catch(error){$("localError").textContent=error.message||String(error)}});}
function parseDelimitedText(text){const delimiter=text.includes("\t")?"\t":",",rows=[];let row=[],value="",quoted=false;for(let i=0;i<text.length;i++){const c=text[i];if(c==='"'){if(quoted&&text[i+1]==='"'){value+='"';i++;}else quoted=!quoted;}else if(c===delimiter&&!quoted){row.push(value);value="";}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&text[i+1]==='\n')i++;row.push(value);if(row.some(cell=>cell!==""))rows.push(row);row=[];value="";}else value+=c;}row.push(value);if(row.some(cell=>cell!==""))rows.push(row);return rows;}
function uniqueHeaders(values,count){const used=new Set(),result=[];for(let i=0;i<count;i++){let base=String(values?.[i]||`Column${i+1}`).trim().replace(/[^A-Za-z0-9_ ]/g,"_")||`Column${i+1}`,name=base,suffix=2;while(used.has(name.toLowerCase()))name=`${base}_${suffix++}`;used.add(name.toLowerCase());result.push(name);}return result;}
function suggestLocalType(values){const filled=values.map(String).map(x=>x.trim()).filter(Boolean).slice(0,10);if(!filled.length)return"Text";if(filled.every(x=>/^[+-]?\d+$/.test(x)))return"Integer";if(filled.every(x=>/^(true|false|0|1)$/i.test(x))&&filled.some(x=>/^(true|false)$/i.test(x)))return"Boolean";const normalized=filled.map(x=>x.replace(/\s/g,"").replace(/,(?=\d+$)/,"."));if(normalized.every(x=>/^[+-]?(?:\d+\.?\d*|\.\d+)$/.test(x)))return"Decimal";if(filled.every(x=>!Number.isNaN(Date.parse(x))&&/[\-/:]/.test(x)))return"DateTime";return"Text";}
function renderLocalGrid(focusCell=""){ensureLocalDataDialog();$("localTableName").value=localState.name;const width=Math.max(localState.columns.length,...localState.rows.map(row=>row.length),1);while(localState.columns.length<width)localState.columns.push({name:`Column${localState.columns.length+1}`,type:"Text"});localState.rows.forEach(row=>{while(row.length<width)row.push("")});$("localGrid").innerHTML=`<table><thead><tr><th></th>${localState.columns.map((column,index)=>`<th><input data-local-name="${index}" value="${esc(column.name)}"><select data-local-type="${index}">${["Text","Integer","Decimal","Boolean","DateTime"].map(type=>`<option ${type===column.type?"selected":""}>${type}</option>`).join("")}</select><button class="remove-local" data-remove-local-column="${index}">×</button></th>`).join("")}<th class="add-local-column"><button data-add-local-column title="Add column">＋</button></th></tr></thead><tbody>${localState.rows.map((row,rowIndex)=>`<tr><td><button class="remove-local" data-remove-local-row="${rowIndex}">×</button></td>${row.map((value,columnIndex)=>`<td><input data-local-cell="${rowIndex}:${columnIndex}" value="${esc(value)}"></td>`).join("")}<td></td></tr>`).join("")}</tbody></table>`;$("localGrid").querySelectorAll("[data-local-name]").forEach(input=>input.oninput=()=>localState.columns[+input.dataset.localName].name=input.value);$("localGrid").querySelectorAll("[data-local-type]").forEach(select=>select.onchange=()=>localState.columns[+select.dataset.localType].type=select.value);$("localGrid").querySelectorAll("[data-local-cell]").forEach(input=>{input.oninput=()=>{const[r,c]=input.dataset.localCell.split(":").map(Number);localState.rows[r][c]=input.value};input.onkeydown=event=>handleLocalGridKey(event,input)});$("localGrid").querySelectorAll("[data-remove-local-row]").forEach(button=>button.onclick=()=>{localState.rows.splice(+button.dataset.removeLocalRow,1);renderLocalGrid()});$("localGrid").querySelectorAll("[data-remove-local-column]").forEach(button=>button.onclick=()=>{const index=+button.dataset.removeLocalColumn;localState.columns.splice(index,1);localState.rows.forEach(row=>row.splice(index,1));renderLocalGrid()});$("localGrid").querySelector("[data-add-local-column]").onclick=addLocalColumn;if(focusCell)requestAnimationFrame(()=>$("localGrid").querySelector(`[data-local-cell="${focusCell}"]`)?.focus());}
function addLocalRow(focusColumn=0){localState.rows.push(Array(localState.columns.length).fill(""));(localState.sourceRowIndices||(localState.sourceRowIndices=[])).push(null);localPage=Math.floor((localState.rows.length-1)/localPageSize);renderLocalGrid(`${localState.rows.length-1}:${focusColumn}`);}
function addLocalColumn(){localState.columns.push({name:`Column${localState.columns.length+1}`,type:"Text"});localState.rows.forEach(row=>row.push(""));renderLocalGrid();}
function handleLocalGridKey(event,input){const[row,column]=input.dataset.localCell.split(":").map(Number),lastRow=row===localState.rows.length-1,lastColumn=column===localState.columns.length-1,allSelected=input.selectionStart===0&&input.selectionEnd===input.value.length;if(event.key==="ArrowDown"){event.preventDefault();if(lastRow)addLocalRow(column);else focusLocalCell(row+1,column);}else if(event.key==="ArrowUp"&&row>0){event.preventDefault();focusLocalCell(row-1,column);}else if(event.key==="ArrowLeft"&&allSelected&&column>0){event.preventDefault();focusLocalCell(row,column-1);}else if(event.key==="ArrowRight"&&allSelected&&!lastColumn){event.preventDefault();focusLocalCell(row,column+1);}else if(event.key==="Tab"&&!event.shiftKey&&lastRow&&lastColumn){event.preventDefault();addLocalRow(0);}}
function focusLocalCell(row,column){const page=Math.floor(row/localPageSize);if(page!==localPage){localPage=page;renderLocalGrid(`${row}:${column}`);return;}const input=$("localGrid").querySelector(`[data-local-cell="${row}:${column}"]`);input?.focus();input?.select();}
function openLocalData(){ensureLocalDataDialog();localState={id:"",name:"",columns:[{name:"Column1",sourceName:"",type:"Text"}],rows:[[""]],sourceMode:"Manual",sourcePath:"",delimiter:",",hasHeaders:true,encodingName:"UTF-8",sourceObjectKind:"",sourceObjectName:"",comment:"",excludedSourceRows:[],sourceRowIndices:[null]};$("localPaste").value="";$("localError").textContent="";renderLocalGrid();$("localDataModal").classList.remove("hidden");}
