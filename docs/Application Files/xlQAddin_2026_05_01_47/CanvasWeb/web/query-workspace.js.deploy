let localPage=0;const localPageSize=150;
function ensureLocalExtras(){ensureLocalDataDialog();if(!localState.updatedUtc&&localState.id)localState.updatedUtc=new Date().toISOString();const actionsBar=$("localDataModal").querySelector(".local-actions");if(!actionsBar.querySelector("[data-import-url]")){const button=document.createElement("button");button.type="button";button.dataset.importUrl="";button.textContent="Import from web…";button.onclick=()=>showUrlImportDialog().catch(error=>$("localError").textContent=error.message||String(error));actionsBar.append(button);}let meta=$("localDataModal").querySelector(".local-source-meta");if(!meta){meta=document.createElement("div");meta.className="local-source-meta";$("localPaste").before(meta);}meta.textContent=localState.updatedUtc?`Last imported or updated: ${formatLocalDate(localState.updatedUtc)}`:"Not saved yet";}
