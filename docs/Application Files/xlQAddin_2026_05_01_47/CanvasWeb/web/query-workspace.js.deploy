function addEditableRow(){if(!editState)return;resultView.data.rows.push((resultView.data.columns||[]).map(()=>null));editState.originalRows.push(null);editState.rowStates.push("insert");renderResult(resultView.data,true,`Editable: ${editState.schemaName}.${editState.tableName}`);}
function toggleDeleteRow(index){if(!editState)return;if(editState.rowStates[index]==="insert"){resultView.data.rows.splice(index,1);editState.originalRows.splice(index,1);editState.rowStates.splice(index,1);}else editState.rowStates[index]=editState.rowStates[index]==="delete"?"clean":"delete";renderResult(resultView.data,true,`Editable: ${editState.schemaName}.${editState.tableName}`);}
function revertEditable(){if(!editState)return;resultView.data.rows=structuredClone(editState.originalRows.filter(Boolean));editState.originalRows=structuredClone(resultView.data.rows);editState.rowStates=resultView.data.rows.map(()=>"clean");renderResult(resultView.data,true,`Editable: ${editState.schemaName}.${editState.tableName}`);resultMessage="Unsaved edits were reverted.";}
function exitEditable(render=true){editState=null;updateEditActions();if(render)renderResult(query.data||{columns:[],rows:[]});}
async function saveEditable(){if(editState?.localDefinition)return saveManualQueryGrid();if(!editState||!hasEdits())return;const changes=[];for(let index=0;index<editState.rowStates.length;index++){const state=editState.rowStates[index];if(state==="clean")continue;const columns=resultView.data.columns||[],toObject=row=>row?Object.fromEntries(columns.map((column,i)=>[resultColumnName(column),row[i]??null])):null;changes.push({state,original:toObject(editState.originalRows[index]),current:state==="delete"?null:toObject(resultView.data.rows[index])});}$("queryStatus").textContent="Saving changes…";try{const result=await call("queryEditSave",{connectionName:editState.connectionName,schemaName:editState.schemaName,tableName:editState.tableName,changes});resultMessage=`Saved ${result.saved} row change(s).`;toast(resultMessage);await loadEditable();}catch(error){showResultError(error,"Could not save editable changes");}}
function formatSql() { let text=$("queryText").value; text=text.replace(/\s+(FROM|WHERE|INNER JOIN|LEFT JOIN|RIGHT JOIN|FULL OUTER JOIN|GROUP BY|ORDER BY|HAVING|UNION)\s+/gi,"\n$1 ").replace(/\s+(AND|OR)\s+/gi,"\n  $1 "); $("queryText").value=text.trim(); highlightSql(); if(typeof markActiveQueryTabDirty==="function")markActiveQueryTabDirty(); }

const sqlKeywords=new Set("SELECT FROM WHERE INNER JOIN LEFT RIGHT FULL OUTER ON GROUP BY ORDER HAVING UNION ALL DISTINCT AS AND OR NOT NULL IS IN EXISTS BETWEEN LIKE CASE WHEN THEN ELSE END ASC DESC TOP OFFSET FETCH INSERT UPDATE DELETE INTO VALUES CREATE ALTER DROP TABLE VIEW WITH OVER PARTITION".split(" "));
const sqlFunctions=new Set("COUNT SUM AVG MIN MAX CONCAT SUBSTRING LENGTH REPLACE TRIM LEFT RIGHT UPPER LOWER CHARINDEX PATINDEX REVERSE SPACE REPLICATE GETDATE DATEADD DATEDIFF YEAR MONTH DATENAME DATEPART EOMONTH COALESCE NULLIF IIF CHOOSE ROUND FLOOR CEILING ABS MOD POWER SQRT EXP LOG LOG10 PI RAND SIGN CAST CONVERT PARSE TRY_CAST TRY_CONVERT ISNULL FORMAT XLDATE XLDATETIME".split(" "));
function highlightSql(){const source=$("queryText").value,pattern=/(--[^\n]*|\/\*[\s\S]*?\*\/|'(?:''|[^'])*'|\{\{[^}]+\}\}|<[^>\n]+>|\b\d+(?:\.\d+)?\b|\b[A-Za-z_][A-Za-z0-9_]*\b)/g;let html="",last=0,match;while((match=pattern.exec(source))){html+=esc(source.slice(last,match.index));const token=match[0],upper=token.toUpperCase();let cls="";if(token.startsWith("--")||token.startsWith("/*"))cls="sql-comment";else if(token.startsWith("'"))cls="sql-string";else if(token.startsWith("{{")||token.startsWith("<"))cls="sql-parameter";else if(/^\d/.test(token))cls="sql-number";else if(sqlKeywords.has(upper))cls="sql-keyword";else if(sqlFunctions.has(upper))cls="sql-function";html+=cls?`<span class="${cls}">${esc(token)}</span>`:esc(token);last=pattern.lastIndex;}html+=esc(source.slice(last));$("queryHighlight").innerHTML=html+"\n";renderParameterReference();}

function autocompleteCandidates(prefix) {
  const keywords=["SELECT","FROM","WHERE","INNER JOIN","LEFT JOIN","GROUP BY","ORDER BY","HAVING","AND","OR","AS","DISTINCT","SUM","COUNT","AVG","MIN","MAX"];
  const metadata=[]; for(const table of tables){ metadata.push({text:qualifiedName(table),kind:table.type||"table"}); if(table.columnsLoaded) for(const column of table.columns||[])metadata.push({text:column.name,kind:qualifiedName(table)}); }
  if (prefix.includes(".")) {
    const dot=prefix.indexOf("."),qualifier=prefix.slice(0,dot).toLowerCase(),partial=prefix.slice(dot+1).toLowerCase(),sql=$("queryText").value;
    const aliasMatch=[...sql.matchAll(/(?:from|join)\s+([\w.[\]]+)\s+(?:as\s+)?(\w+)/gi)].find(match=>match[2].toLowerCase()===qualifier);
    const sourceName=(aliasMatch?.[1]||qualifier).replace(/[\[\]]/g,"").toLowerCase();
    const table=tables.find(item=>qualifiedName(item).toLowerCase()===sourceName||item.name.toLowerCase()===sourceName||tableAliases(item).some(alias=>alias.toLowerCase()===qualifier));
    if(table?.columnsLoaded)return (table.columns||[]).filter(column=>column.name.toLowerCase().startsWith(partial)).map(column=>({text:`${prefix.slice(0,dot+1)}${column.name}`,kind:qualifiedName(table)})).slice(0,18);
  }
  const parameters=(query.parameters||[]).map(parameter=>({text:`{{${parameter.Name||parameter.name}}}`,kind:"parameter"}));
  const needle=prefix.toLowerCase(); return [...metadata,...parameters,...keywords.map(text=>({text,kind:"keyword"}))].filter((item,index,array)=>item.text.toLowerCase().includes(needle)&&array.findIndex(other=>other.text.toLowerCase()===item.text.toLowerCase())===index).slice(0,18);
}
function aliasTable(prefix){if(!prefix.includes("."))return null;const qualifier=prefix.slice(0,prefix.indexOf(".")).toLowerCase(),sql=$("queryText").value;const reserved=new Set(["where","on","group","order","having","inner","left","right","full","join"]);const matches=[...sql.matchAll(/(?:from|join)\s+((?:\[[^\]]+\]|[A-Za-z_][\w$]*)(?:\s*\.\s*(?:\[[^\]]+\]|[A-Za-z_][\w$]*))?)\s+(?:as\s+)?([A-Za-z_][\w$]*)/gi)];const aliasMatch=matches.find(match=>match[2].toLowerCase()===qualifier&&!reserved.has(match[2].toLowerCase()));if(!aliasMatch)return tables.find(item=>qualifiedName(item).toLowerCase()===qualifier||item.name.toLowerCase()===qualifier||tableAliases(item).some(alias=>alias.toLowerCase()===qualifier));const sourceName=aliasMatch[1].replace(/[\[\]\s]/g,"").toLowerCase();return tables.find(item=>qualifiedName(item).toLowerCase()===sourceName||item.name.toLowerCase()===sourceName);}
function currentToken() { const editor=$("queryText"), before=editor.value.slice(0,editor.selectionStart), match=before.match(/[A-Za-z_][A-Za-z0-9_.]*$/); return match ? match[0] : ""; }
function positionAutocomplete(){const editor=$("queryText"),box=$("autocomplete"),work=document.querySelector(".work"),before=editor.value.slice(0,editor.selectionStart),lines=before.split("\n"),line=lines.at(-1).replace(/\t/g,"    "),style=getComputedStyle(editor),canvas=positionAutocomplete.canvas||(positionAutocomplete.canvas=document.createElement("canvas")),context=canvas.getContext("2d"),editorRect=editor.getBoundingClientRect(),workRect=work.getBoundingClientRect(),lineHeight=parseFloat(style.lineHeight)||22;context.font=style.font;let left=editorRect.left-workRect.left+17+context.measureText(line).width-editor.scrollLeft,top=editorRect.top-workRect.top+14+lines.length*lineHeight-editor.scrollTop;left=Math.max(8,Math.min(work.clientWidth-370,left));if(top+270>work.clientHeight)top=Math.max(40,top-285);box.style.left=`${left}px`;box.style.top=`${top}px`;}
async function showAutocomplete(force=false) { const token=currentToken(); if(!force&&token.length<2)return hideAutocomplete();const aliasSource=aliasTable(token);if(aliasSource&&!aliasSource.columnsLoaded){try{await ensureColumns(aliasSource)}catch(error){return toast(error.message||String(error));}if(currentToken()!==token)return;} autocompleteItems=autocompleteCandidates(force?"":token); autocompleteIndex=0; const box=$("autocomplete"); box.innerHTML=autocompleteItems.map((item,index)=>`<button type="button" data-completion="${index}" class="${index===0?"active":""}">${esc(item.text)}<small>${esc(item.kind)}</small></button>`).join(""); box.classList.toggle("hidden",!autocompleteItems.length);if(autocompleteItems.length)positionAutocomplete();box.querySelectorAll("button").forEach(button=>button.onmousedown=event=>{event.preventDefault();acceptAutocomplete(+button.dataset.completion);}); }
function hideAutocomplete(){ $("autocomplete").classList.add("hidden"); }
function acceptAutocomplete(index=autocompleteIndex){ const item=autocompleteItems[index]; if(!item)return; const editor=$("queryText"), token=currentToken(), end=editor.selectionStart, start=end-token.length; editor.value=editor.value.slice(0,start)+item.text+editor.value.slice(end); editor.selectionStart=editor.selectionEnd=start+item.text.length; editor.focus(); hideAutocomplete();highlightSql(); }
function moveAutocomplete(delta){ if(!autocompleteItems.length)return; autocompleteIndex=(autocompleteIndex+delta+autocompleteItems.length)%autocompleteItems.length; $("autocomplete").querySelectorAll("button").forEach((button,index)=>button.classList.toggle("active",index===autocompleteIndex)); }

function parameterName(parameter){return parameter.Name||parameter.name||"";}
function parameterValue(parameter){return parameter.CurrentDisplayValue||parameter.currentDisplayValue||parameter.CurrentValue||parameter.currentValue||parameter.DefaultValue||parameter.defaultValue||"";}
function parsedParameterNames(){const names=new Set();for(const match of $("queryText").value.matchAll(/\{\{\s*([^}]+?)\s*\}\}|<\s*([A-Za-z_][A-Za-z0-9_]*)\s*>/g))names.add((match[1]||match[2]).trim());return [...names];}
function renderParameterReference(){if(!$("toolPanel").classList.contains("parameter-mode"))return;showParametersPanel();}
function showToolPanel(){ $("defaultInspector").classList.add("hidden"); $("toolPanel").classList.remove("hidden"); }
function closeToolPanel(){ $("toolPanel").classList.add("hidden"); $("toolPanel").className="tool-panel hidden"; $("defaultInspector").classList.remove("hidden"); }
function showParametersPanel(){
  showToolPanel();
  const names=parsedParameterNames(), definitions=(query.parameters||[]).filter(parameter=>parameterName(parameter));
  const isUsed=parameter=>names.some(name=>name.toLowerCase()===parameterName(parameter).toLowerCase());
  const missing=names.filter(name=>!definitions.some(parameter=>parameterName(parameter).toLowerCase()===name.toLowerCase()));
  const available=definitions.filter(parameter=>!isUsed(parameter));
  const cards=items=>items.map(item=>{
    const name=typeof item==="string"?item:parameterName(item);
    const parameter=typeof item==="string"?definitions.find(candidate=>parameterName(candidate).toLowerCase()===name.toLowerCase()):item;
    return `<div class="parameter-item" data-parameter="${esc(name)}"><b>{{${esc(name)}}}</b><small>${parameter?esc(parameterValue(parameter)):"Not defined"}</small></div>`;
  }).join("");
  $("toolPanel").className="tool-panel parameter-mode";
  $("toolPanel").innerHTML=`<div class="tool-head"><h2>Parameters</h2><button data-close-tool>×</button></div><button data-edit-parameters>Edit parameter values</button><details class="used-parameters" ${usedParametersOpen?'open':''}><summary>Used in this query (${names.length})</summary><div class="parameter-list">${cards(names)||'<p class="muted">No {{parameters}} were found in this query.</p>'}</div>${missing.length?`<p class="parameter-warning">Missing definitions: ${esc(missing.join(", "))}</p>`:""}</details><div class="tool-subhead">Available from Parameter Manager / _control</div><div class="parameter-list">${cards(available)||'<p class="muted">No additional workbook parameters are available.</p>'}</div>`;
  const usedSection=$("toolPanel").querySelector('.used-parameters');
  usedSection.querySelector('summary').onclick=()=>{usedParametersOpen=!usedSection.open;};
  usedSection.ontoggle=event=>{if(event.target.isConnected)usedParametersOpen=event.target.open;};
  $("toolPanel").querySelector("[data-close-tool]").onclick=closeToolPanel;
  $("toolPanel").querySelector("[data-edit-parameters]").onclick=openParameters;
  $("toolPanel").querySelectorAll("[data-parameter]").forEach(item=>item.onclick=()=>insertSql(`{{${item.dataset.parameter}}}`));
}
function lookupParameter(parameter){return new Promise((resolve,reject)=>{const requestId=`parameter-${Date.now()}-${Math.random()}`;parameterLookups.set(requestId,{resolve,reject});chrome.webview.postMessage({type:"parameterLookup",requestId,query,parameter});});}
function openParameters(){ParameterWeb.openInput({parameters:query.parameters||[],sheetNames:workbookSheetNames,lookup:lookupParameter,onManage:items=>{query.parameters=items;openParameters();},onManagerCancel:openParameters,onApply:items=>{query.parameters=items;highlightSql();showParametersPanel();},onCancel:()=>{}});}
async function showFunctions(){showToolPanel();$("toolPanel").className="tool-panel function-mode";$("toolPanel").innerHTML='<div class="tool-head"><h2>Function reference</h2><button data-close-tool>×</button></div><p class="muted">Loading functions…</p>';$("toolPanel").querySelector("[data-close-tool]").onclick=closeToolPanel;const result=await call("queryFunctions",{connectionName:$("connection").value});const functions=result.functions||[];$("toolPanel").innerHTML=`<div class="tool-head"><h2>Function reference</h2><button data-close-tool>×</button></div><input class="tool-search" placeholder="Search functions"><div class="function-list"></div>`;const render=()=>{const search=$("toolPanel").querySelector(".tool-search").value.toLowerCase(),visible=functions.filter(item=>!search||String(item.Name||item.name).toLowerCase().includes(search)||String(item.Category||item.category).toLowerCase().includes(search));$("toolPanel").querySelector(".function-list").innerHTML=visible.map((item,index)=>`<div class="function-item" data-function="${index}"><b>${esc(item.Name||item.name)}</b><small>${esc(item.Syntax||item.syntax)}</small><small>${esc(item.Category||item.category)} · ${esc(String(item.Description||item.description||"").replace(/<br\s*\/?\s*>/gi," "))}</small></div>`).join("");$("toolPanel").querySelectorAll("[data-function]").forEach(element=>element.onclick=()=>{const item=visible[+element.dataset.function];insertSql(item.Syntax||item.syntax||item.Name||item.name);});};$("toolPanel").querySelector("[data-close-tool]").onclick=closeToolPanel;$("toolPanel").querySelector(".tool-search").oninput=render;render();}
async function showStatistics(table=null){$("queryStatus").textContent="Calculating statistics…";query.queryText=$("queryText").value;const payload={query:table?{...query,connectionName:$("connection").value}:query};if(table){payload.tableName=table.name;payload.schemaName=table.schema||"";}const result=await call("queryStatistics",payload);renderResult(result.data,true,table?`Statistics for ${qualifiedName(table)}`:"Query statistics");$("queryStatus").textContent="Ready";}

