async function run() { if(queryClock)return;await executeQuery($("queryText").value); }
async function refreshParsedSql(){query.queryText=$("queryText").value;$("queryStatus").textContent="Parsing parameters…";try{const result=await call("queryParse",{query});parsedSql=result.parsedQuery??query.queryText;applyResultMode();$("queryStatus").textContent="Ready";}catch(error){showResultError(error,"Could not parse SQL");}}
function parseManualEditQuery(text){const sql=String(text||"").trim().replace(/;\s*$/,"");if(/;|--|\/\*|\*\/|\b(join|union|group|having|distinct|into|insert|update|delete|drop|alter|create|exec|with)\b/i.test(sql))throw new Error("Editable manual queries must use one SELECT from one table, without joins, grouping, comments, or multiple statements.");const match=/^SELECT\s+(.+?)\s+FROM\s+((?:\[[^\]]+\]|[A-Za-z_]\w*)(?:\.(?:\[[^\]]+\]|[A-Za-z_]\w*))?)(?:\s+(?:AS\s+)?(?!(?:WHERE|ORDER)\b)([A-Za-z_]\w*))?(?:\s+WHERE\s+(.+?))?(?:\s+ORDER\s+BY\s+(.+))?$/is.exec(sql);if(!match)throw new Error("Use SELECT columns FROM one manual table, optionally with WHERE and ORDER BY.");const [,fields,name,alias,where,order]=match;const identifier=/^(?:\[[^\]]+\]|[A-Za-z_]\w*)(?:\.(?:\[[^\]]+\]|[A-Za-z_]\w*))?$/i;const selected=fields.trim()==="*"?null:fields.split(",").map(part=>part.trim());if(selected&&selected.some(part=>!identifier.test(part)))throw new Error("Editable columns must be plain column names (no expressions or aliases).");if(order&&!order.split(",").every(part=>/^((?:\[[^\]]+\]|[A-Za-z_]\w*)(?:\.(?:\[[^\]]+\]|[A-Za-z_]\w*))?)(?:\s+(?:ASC|DESC))?$/i.test(part.trim())))throw new Error("ORDER BY may use only plain column names.");if(where&&/\b(select|join|union|into|insert|update|delete|drop|alter|create|exec)\b/i.test(where))throw new Error("The WHERE clause cannot contain another query or write statement.");return{name:name.replace(/[\[\]]/g,""),selected:selected?.map(part=>part.split(".").at(-1).replace(/[\[\]]/g,"")),filterQuery:`SELECT * FROM ${name}${alias?` ${alias}`:""}${where?` WHERE ${where}`:""}${order?` ORDER BY ${order}`:""}`,displayQuery:sql};}
async function loadEditable(){if(String(query.connectionName).toLowerCase()==="local"){try{const parsed=parseManualEditQuery($("queryText").value);return await openManualQueryGrid(parsed.name,parsed.filterQuery,parsed.selected,parsed.displayQuery);}catch(error){return showResultError(error,"Cannot edit query");}}query.queryText=$("queryText").value;query.previewLimit=Number($("previewLimit").value)||0;$("queryStatus").textContent="Validating editable query…";try{const result=await call("queryEditLoad",{query});parsedSql=result.parsedQuery||query.queryText;editState={connectionName:result.connectionName,schemaName:result.schemaName,tableName:result.tableName,columns:result.columns||[],originalRows:structuredClone(result.data?.rows||[]),rowStates:(result.data?.rows||[]).map(()=>"clean")};resultMode="grid";renderResult(result.data,false,`Editable: ${result.schemaName}.${result.tableName}`);await refreshLookupChoices();renderResult(resultView.data,true);$("queryStatus").textContent="Editing";resultMessage="Editable mode validates a single SQL Server table and saves changes in one transaction.";}catch(error){exitEditable(false);showResultError(error,"Could not open editable result");}}
function copyEditableFromAbove(targetIndex,sourceIndex,columnIndex=null){
  if(!editState||editState.rowStates[targetIndex]!=="insert"||editState.rowStates[sourceIndex]==="delete")return false;
  const target=resultView.data.rows[targetIndex],source=resultView.data.rows[sourceIndex];
  if(!target||!source)return false;
  const indexes=columnIndex==null?resultView.data.columns.map((_,index)=>index):[columnIndex];
  let copied=false;
  for(const index of indexes){if(editColumn(index)?.readOnly)continue;target[index]=structuredClone(rowValues(source,resultView.data.columns)[index]??null);copied=true;}
  if(copied){renderResult(resultView.data,true);updateEditActions();}
  return copied;
