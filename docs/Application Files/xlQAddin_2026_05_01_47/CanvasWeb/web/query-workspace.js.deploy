    const columnIndex=cell?.querySelector("[data-edit-column]")?.dataset.editColumn,copyValue=columnIndex!==undefined&&!editColumn(+columnIndex)?.readOnly;
    showContextMenu(event,'<div class="menu-title">New row</div><button data-copy-row-above>Copy row from above</button>'+ (copyValue?'<button data-copy-value-above>Copy value from row above</button>':''),menu=>{
      menu.querySelector("[data-copy-row-above]").onclick=()=>{hideContextMenu();copyEditableFromAbove(targetIndex,sourceIndex);};
      menu.querySelector("[data-copy-value-above]")?.addEventListener("click",()=>{hideContextMenu();copyEditableFromAbove(targetIndex,sourceIndex,+columnIndex);});
    });
  }:null;
  if(editState){body.querySelectorAll("[data-edit-row]").forEach(input=>input.onchange=()=>{const row=+input.dataset.editRow,columnIndex=+input.dataset.editColumn,column=editColumn(columnIndex);let value=input.type==="checkbox"?input.checked:input.value;if(input.type!=="checkbox"&&value===""&&column?.nullable)value=null;else if(!exactSqlNumber(column)&&(input.type==="number"||input.tagName==="SELECT"&&isNumericColumn({type:column?.dbType}))&&value!=="")value=Number(value);resultView.data.rows[row][columnIndex]=value;if(editState.rowStates[row]==="clean")editState.rowStates[row]="update";updateEditActions();input.closest("tr").classList.toggle("edit-dirty",editState.rowStates[row]==="update");});body.querySelectorAll("[data-delete-row]").forEach(button=>button.onclick=()=>toggleDeleteRow(+button.dataset.deleteRow));}
  $("emptyResult").classList.toggle("hidden",columns.length>0);$("resultSummary").textContent=`${sourceRows.length.toLocaleString()} row(s) · ${visible.length}/${columns.length} column(s)`;if(label)$("resultSummary").textContent=`${label} · ${$("resultSummary").textContent}`;
  applyResultMode();
  updateEditActions();
}
function resultJson(){const data=resultView.data||{columns:[],rows:[]},columns=data.columns||[];return (data.rows||[]).map(row=>Object.fromEntries(columns.map((column,index)=>[resultColumnName(column),rowValues(row,columns)[index]??null])));}
function resultDelimited(delimiter){const data=resultView.data||{columns:[],rows:[]},columns=data.columns||[],indexes=columns.map((_,index)=>index).filter(index=>!resultView.hidden.has(index)),quote=value=>{const text=String(value??"");return delimiter===","&&/[",\r\n]/.test(text)?`"${text.replace(/"/g,'""')}"`:text.replace(/[\t\r\n]+/g," ")};return[indexes.map(index=>quote(resultColumnName(columns[index]))).join(delimiter),...(data.rows||[]).map(row=>{const values=rowValues(row,columns);return indexes.map(index=>quote(values[index])).join(delimiter)})].join("\r\n");}
function showResultTableMenu(event){showContextMenu(event,`<div class="menu-title">Query results</div><button data-result-table-action="copy">Copy table to clipboard</button><button data-result-table-action="csv">Save as CSV file…</button><hr><button data-result-table-action="clear">Clear results</button>`,menu=>menu.querySelectorAll("[data-result-table-action]").forEach(button=>button.onclick=async()=>{const action=button.dataset.resultTableAction;hideContextMenu();if(action==="copy")await copyText(resultDelimited("\t"),"Table");else if(action==="csv"){const result=await call("queryResultsSaveCsv",{fileName:"query-results.csv",content:resultDelimited(",")});if(result.path)toast(`Saved ${result.path}`);}else{query.data={columns:[],rows:[]};resultView={...resultView,data:query.data,sortIndex:-1,sortDirection:0,hidden:new Set(),formats:new Map(),widths:new Map()};renderResult(query.data,true);toast("Results cleared");}}));}
function applyResultMode(){const table=$("result"),text=$("resultText"),empty=$("emptyResult"),hasData=(resultView.data?.columns||[]).length>0;document.querySelectorAll("[data-result-view]").forEach(button=>button.classList.toggle("active",button.dataset.resultView===resultMode));table.classList.toggle("hidden",resultMode!=="grid");text.classList.toggle("hidden",resultMode==="grid");text.classList.toggle("message-result",resultMode==="messages");if(resultMode==="json")text.textContent=JSON.stringify(resultJson(),null,2);else if(resultMode==="sql")text.textContent=parsedSql||"Select Parsed SQL to substitute the current parameters.";else if(resultMode==="messages")text.textContent=resultMessage||"No messages.";empty.classList.toggle("hidden",hasData||resultMode!=="grid");}
function startColumnResize(event,index){event.stopPropagation();const startX=event.clientX,start=resultView.widths.get(index)||160,visibleIndexes=(resultView.data.columns||[]).map((_,i)=>i).filter(i=>!resultView.hidden.has(i)),col=$("result").querySelectorAll("col")[visibleIndexes.indexOf(index)];pointerDrag(event,e=>{const width=Math.max(55,Math.min(700,start+e.clientX-startX));resultView.widths.set(index,width);if(col)col.style.width=`${width}px`;});}
function showResultColumnMenu(event,index,label){const columns=resultView.data.columns||[];showContextMenu(event,`<div class="menu-title">${esc(resultColumnName(columns[index]))}</div>${editState?'<button data-configure-lookup>Configure lookup…</button><hr>':""}<button data-sort="1">Sort ascending</button><button data-sort="-1">Sort descending</button><button data-sort="0">Clear sorting</button><label>Format <select data-result-format><option value="auto">Auto</option><option value="number">Number</option><option value="integer">Integer</option><option value="percent">Percent</option><option value="date">Date</option><option value="excel-date">Excel serial date</option><option value="text">Text</option></select></label><hr><div class="menu-title">Visible columns</div>${columns.map((column,columnIndex)=>`<label><input type="checkbox" data-visible-column="${columnIndex}" ${resultView.hidden.has(columnIndex)?"":"checked"}> ${esc(resultColumnName(column))}</label>`).join("")}`,menu=>{menu.querySelector("[data-configure-lookup]")?.addEventListener("click",()=>{hideContextMenu();configureLookup(index);});menu.querySelector("[data-result-format]").value=resultView.formats.get(index)||"auto";menu.querySelector("[data-result-format]").onchange=e=>{resultView.formats.set(index,e.target.value);renderResult(resultView.data,true,label);hideContextMenu();};menu.querySelectorAll("[data-sort]").forEach(button=>button.onclick=()=>{const direction=+button.dataset.sort;resultView.sortIndex=direction?index:-1;resultView.sortDirection=direction;renderResult(resultView.data,true,label);hideContextMenu();});menu.querySelectorAll("[data-visible-column]").forEach(input=>input.onchange=()=>{const columnIndex=+input.dataset.visibleColumn;input.checked?resultView.hidden.delete(columnIndex):resultView.hidden.add(columnIndex);if(resultView.hidden.size===columns.length)resultView.hidden.delete(columnIndex);rememberEditColumnVisibility();renderResult(resultView.data,true,label);showResultColumnMen