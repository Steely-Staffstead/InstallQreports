}
function renderResult(data, preserveQueryData=false, label="") {
  if(!preserveQueryData&&resultMode==="messages")resultMode="grid";
  const rendered=data||{columns:[],rows:[]}; if(!preserveQueryData){query.data=rendered;resultView={...resultView,data:rendered,sortIndex:-1,sortDirection:0,hidden:new Set(),formats:new Map(),widths:new Map()};restoreEditColumnVisibility();}else resultView.data=rendered;
  const columns=rendered.columns||[], sourceRows=rendered.rows||[], indexed=sourceRows.map((row,index)=>({row,index})).filter(entry=>(!editState?.paneVisibleRows||editState.paneVisibleRows.has(entry.index)||editState.rowStates[entry.index]==="insert")).filter(entry=>!editState?.viewFilter||LocalTableTools.matches(rowValues(entry.row,columns)[editState.viewFilter.column],editState.viewFilter));
  if(editState?.paneRowOrder&&!resultView.sortDirection)indexed.sort((a,b)=>(editState.paneRowOrder.get(a.index)??Number.MAX_SAFE_INTEGER)-(editState.paneRowOrder.get(b.index)??Number.MAX_SAFE_INTEGER));
  if(resultView.sortIndex>=0&&resultView.sortDirection){const direction=resultView.sortDirection;indexed.sort((left,right)=>{const a=rowValues(left.row,columns)[resultView.sortIndex],b=rowValues(right.row,columns)[resultView.sortIndex];if(a==null&&b==null)return left.index-right.index;if(a==null)return 1;if(b==null)return -1;const an=Number(a),bn=Number(b),comparison=Number.isFinite(an)&&Number.isFinite(bn)?an-bn:String(a).localeCompare(String(b),undefined,{numeric:true,sensitivity:"base"});return comparison*direction||left.index-right.index;});}
  const visible=columns.map((column,index)=>({column,index})).filter(item=>!resultView.hidden.has(item.index));
  const table=$("result"),colgroup=table.querySelector("colgroup"),head=table.querySelector("thead"),body=table.querySelector("tbody");colgroup.replaceChildren();head.replaceChildren();body.replaceChildren();table.style.width=`max(100%, ${visible.reduce((sum,item)=>sum+(resultView.widths.get(item.index)||160),0)}px)`;
  for(const item of visible){const col=document.createElement("col");col.style.width=`${resultView.widths.get(item.index)||160}px`;colgroup.appendChild(col);}
  const headerRow=document.createElement("tr");if(editState){const actionHead=document.createElement("th");actionHead.className="row-action-head";headerRow.appendChild(actionHead);}for(const item of visible){const cell=document.createElement("th");cell.dataset.column=String(item.index);cell.innerHTML=`<span>${esc(resultColumnName(item.column))}</span>${resultView.sortIndex===item.index&&resultView.sortDirection?`<span class="sort-mark">${resultView.sortDirection===1?"▲":"▼"}</span>`:""}<span class="column-resizer"></span>`;cell.onclick=event=>{if(event.target.classList.contains("column-resizer"))return;if(resultView.sortIndex!==item.index){resultView.sortIndex=item.index;resultView.sortDirection=1;}else if(resultView.sortDirection===1)resultView.sortDirection=-1;else if(resultView.sortDirection===-1){resultView.sortIndex=-1;resultView.sortDirection=0;}renderResult(resultView.data,true,label);};cell.oncontextmenu=event=>{event.preventDefault();showResultColumnMenu(event,item.index,label);};cell.querySelector(".column-resizer").onpointerdown=event=>startColumnResize(event,item.index);headerRow.appendChild(cell);}head.appendChild(headerRow);
  for(const entry of indexed){const resultRow=document.createElement("tr"),values=rowValues(entry.row,columns),state=editState?.rowStates?.[entry.index]||"clean";if(editState)resultRow.dataset.editRow=String(entry.index);if(state==="update")resultRow.className="edit-dirty";else if(state==="insert")resultRow.className="edit-new";else if(state==="delete")resultRow.className="edit-deleted";if(editState){const action=document.createElement("td");action.className="row-action";action.innerHTML=`<button title="${state==="delete"?"Restore row":"Delete row"}" data-delete-row="${entry.index}">${state==="delete"?"↶":"×"}</button>`;resultRow.appendChild(action);}for(const item of visible){const cell=document.createElement("td"),column=editColumn(item.index);if(editState&&!column?.readOnly&&state!=="delete"){cell.className="edit-cell";cell.innerHTML=editInputHtml(values[item.index],column,item.index,entry.index);}else{if(editState&&column?.readOnly)cell.className="edit-readonly";cell.innerHTML=state==="insert"&&column?.readOnly&&values[item.index]==null?`<span class="auto-value-pending">${column.identity?"Auto on save":column.computed?"Calculated on save":"Set on save"}</span>`:statisticsCellHtml(columns,values,item.index,resultView.formats.get(item.index)||"auto");}resultRow.appendChild(cell);}body.appendChild(resultRow);}
  body.oncontextmenu=editState?event=>{
    const cell=event.target.closest("td"),row=cell?.closest("tr"),targetIndex=Number(row?.dataset.editRow),above=row?.previousElementSibling,sourceIndex=Number(above?.dataset.editRow);
