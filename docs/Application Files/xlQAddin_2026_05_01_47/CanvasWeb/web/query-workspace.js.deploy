async function saveLocalData(){localState.name=$("localTableName").value.trim();if(!localState.name)throw new Error("Enter a table name.");const names=uniqueHeaders(localState.columns.map(column=>column.name),localState.columns.length);localState.columns.forEach((column,index)=>column.name=names[index]);localState.comment=$("localSourceComment")?.value||"";const definition={Id:localState.id,Name:localState.name,SourceMode:localState.sourceMode,SourcePath:localState.sourcePath,Delimiter:localState.delimiter,HasHeaders:localState.hasHeaders,EncodingName:localState.encodingName,SourceObjectKind:localState.sourceObjectKind,SourceObjectName:localState.sourceObjectName,Comment:localState.comment,ImportSteps:localSteps.map(({state,...step})=>step),SourceRowIndices:localState.sourceRowIndices||[],ExcludedSourceRows:[...(localState.excludedSourceRows||[])].sort((a,b)=>a-b),Columns:localState.columns.map(column=>({Name:column.name,SourceName:column.sourceName||"",DataType:column.type,AllowNull:true}))},data={columns:localState.columns.map(column=>column.name),types:localState.columns.map(()=>"System.String"),rows:localState.rows};await call("localTableSave",{definition,data});$("localDataModal").classList.add("hidden");await loadConnections();$("connection").value="local";await loadSchema();toast(`Local table ${localState.name} saved`);}
