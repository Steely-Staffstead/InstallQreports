const $ = id => document.getElementById(id);
let query = { connectionName:"", queryText:"", previewLimit:window.QReportsSettings?.get().records??1000, measures:[], parameters:[], data:{ columns:[], rows:[] } };
let tables = [], allConnections = [], joinTables = [], joins = [], autocompleteItems = [], autocompleteIndex = 0, selectedTable = null, editingJoinIndex = -1;
const expandedTables = new Set(), pending = new Map(), parameterLookups = new Map(), tableClickTimers = new Map();
const sourceSelections = new Map();
const lookupSettingsKey="qreports-query-edit-lookups-v1", visibleTablesKey="qreports-query-visible-tables-v1";
let lookupSettings={};try{lookupSettings=JSON.parse(localStorage.getItem(lookupSettingsKey)||"{}")}catch{}
let visibleTables={};try{visibleTables=JSON.parse(localStorage.getItem(visibleTablesKey)||"{}")}catch{}
const hiddenEditColumnsKey="qreports-query-edit-hidden-columns-v1";
let hiddenEditColumns={};try{hiddenEditColumns=JSON.parse(localStorage.getItem(hiddenEditColumnsKey)||"{}")}catch{}
const recentQueryFilesKey="qreports-query-recent-files-v1";
let recentQueryFiles=[];try{const saved=JSON.parse(localStorage.getItem(recentQueryFilesKey)||"[]");if(Array.isArray(saved))recentQueryFiles=saved.filter(item=>item&&["sql","workspace"].includes(item.kind)&&typeof item.path==="string").slice(0,8);}catch{}
const queryPaneStateKey="qreports-query-pane-state-v1";
let queryPaneState={sourcesHidden:false,inspectorHidden:true};try{queryPaneState={...queryPaneState,...JSON.parse(localStorage.getItem(queryPaneStateKey)||"{}")};}catch{}
function applyQueryPaneState(){const main=document.querySelector("main");if(!main)return;main.classList.toggle("sources-hidden",!!queryPaneState.sourcesHidden);main.classList.toggle("inspector-hidden",!!queryPaneState.inspectorHidden);}
function setQueryPaneHidden(pane,hidden){queryPaneState[pane==="sources"?"sourcesHidden":"inspectorHidden"]=!!hidden;localStorage.setItem(queryPaneStateKey,JSON.stringify(queryPaneState));applyQueryPaneState();}
applyQueryPaneState();
let currentSqlFilePath="";
let activeSaveTargetKind="";
function updateQuickSaveSql(){const button=$("quickSaveSql");if(!button)return;const workspacePath=typeof workspaceFilePath!=="undefined"?workspaceFilePath:"",isWorkspace=activeSaveTargetKind==="workspace"&&!!workspacePath,isSql=activeSaveTargetKind==="sql"&&!!currentSqlFilePath,target=isWorkspace?workspacePath:isSql?currentSqlFilePath:"";button.disabled=!target;button.textContent=isWorkspace?"Save workspace":isSql?"Save SQL":"Save";button.title=target?`Save ${isWorkspace?"workspace":"SQL file"} directly to ${target}`:"Open or save a SQL file or workspace to enable Save";}
function setCurrentSqlFile(path){currentSqlFilePath=String(path||"").trim();if(typeof activeQueryTab==="function"&&activeQueryTab())activeQueryTab().sqlFilePath=currentSqlFilePath;if(currentSqlFilePath)activeSaveTargetKind="sql";updateQuickSaveSql();}
function recentQueryFileName(path){return String(path||"").split(/[\\/]/).pop()||String(path||"");}
function rememberRecentQueryFile(kind,path){path=String(path||"").trim();if(!path)return;recentQueryFiles=[{kind,path},...recentQueryFiles.filter(item=>item.path.toLowerCase()!==path.toLowerCase())].slice(0,8);localStorage.setItem(recentQueryFilesKey,JSON.stringify(recentQueryFiles));renderRecentQueryFiles();}
function renderRecentQueryFiles(){const list=$("recentQueryFiles");if(!list)return;list.innerHTML=recentQueryFiles.length?`${recentQueryFiles.map(item=>`<button type="button" data-action="openRecentFile" data-recent-kind="${esc(item.kind)}" data-recent-path="${esc(item.path)}" title="${esc(item.path)}"><span>${esc(recentQueryFileName(item.path))}</span><small>${item.kind==="workspace"?"Workspace":"SQL"}</small></button>`).join("")}<button type="button" class="clear-recent" data-action="clearRecentFiles">Clear recent list</button>`:'<span class="menu-empty">No recent files</span>';}
async function openSqlDocument(path=""){if(hasEdits())throw new Error("Save or revert table edits before opening another query.");try{const opened=await call("querySqlFileOpen",path?{path,direct:true}:{},{silentError:true});if(opened.cancelled)return;replaceSql(opened.content||"");setCurrentSqlFile(opened.path);rememberRecentQueryFile("sql",opened.path);toast(`Opened ${opened.path}`);}catch(error){showResultError(error,"SQL file open failed",false);}}
async function quickSaveSql(){if(activeSaveTargetKind==="workspace"&&typeof saveQueryWorkspace==="function")return saveQueryWorkspace(false);if(!currentSqlFilePath)return;const saved=await call("querySqlFileSave",{path:currentSqlFilePath,direct:true,content:$("queryText").value},{silentError:true});if(saved.path){setCurrentSqlFile(saved.path);rememberRecentQueryFile("sql",saved.path);toast(`Saved ${saved.path}`);}}
const lookupChoices=new Map();
function lookupKey(column){return `${String(editState?.connectionName||$("connection").value).toLowerCase()}|${editState?.schemaName?.toLowerCase()}|${editState?.tableName?.toLowerCase()}|${column.toLowerCase()}`;}
function editTableKey(){return `${editState?.connectionName?.toLowerCase()}|${editState?.schemaName?.toLowerCase()}|${editState?.tableName?.toLowerCase()}`;}
function restoreEditColumnVisibility(){if(!editState)return;const hidden=new Set(hiddenEditColumns[editTableKey()]||[]);resultView.hidden=new Set((resultView.data.columns||[]).map((column,index)=>hidden.has(resultColumnName(column).toLowerCase())?index:-1).filter(index=>index>=0));}
function rememberEditColumnVisibility(){if(!editState)return;hiddenEditColumns[editTableKey()]=[...resultView.hidden].map(index=>resultColumnName(resultView.data.columns[index]).toLowerCase());localStorage.setItem(hiddenEditColumnsKey,JSON.stringify(hiddenEditColumns));}
function rememberVisibleTables(){visibleTables[$("connection").value.toLowerCase()]=[...expandedTables];localStorage.setItem(visibleTablesKey,JSON.stringify(visibleTables));}
let resultView = { data:{columns:[],rows:[]}, sortIndex:-1, sortDirection:0, hidden:new Set(), formats:new Map(), widths:new Map() };
let resultMode="grid", parsedSql="", resultMessage="", workbookSheetNames=[];
let editState=null;
let usedParametersOpen=true;
let queryStartedAt=0,queryClock=null;
function startQueryClock(){clearInterval(queryClock);queryStartedAt=performance.now();const tick=()=>$("queryStatus").textContent=`Working… ${Math.floor((performance.now()-queryStartedAt)/1000)} s`;tick();queryClock=setInterval(tick,250);}
function stopQueryClock(){clearInterval(queryClock);queryClock=null;}
async function executeQuery(text){exitEditable(false);query.connectionName=query.connectionName||$("connection").value;query.queryText=text;query.previewLimit=Number($("previewLimit").value)||0;resultMessage="";startQueryClock();try{const result=await call("queryRun",{query});parsedSql=result.parsedQuery||text;renderResult(result.data);resultMessage=`Query executed successfully\nNumber of rows: ${(result.data?.rows||[]).length.toLocaleString()}\nTime used: ${((performance.now()-queryStartedAt)/1000).toFixed(2)} seconds\nCompleted: ${new Date().toLocaleString()}`;$("queryStatus").textContent="Ready";if(resultMode==="messages")applyResultMode();}catch(error){showResultError(error,"Query failed");}finally{stopQueryClock();}}
let activeFilter=null,filterChoices=[],filterPending=new Set();
const actions = { localTableConvertManual:"local-table-convert-manual",localManualSave:"local-manual-save", localSourcesRefresh:"local-sources-refresh", queryConnections:"query-connections", querySchema:"query-schema", queryApiSpec:"query-api-spec", queryRun:"query-run", queryParse:"query-parse", queryFunctions:"query-functions", queryStatistics:"query-statistics", queryEditLoad:"query-edit-load", queryEditSave:"query-edit-save", querySqlFileOpen:"query-sql-file-open", querySqlFileSave:"query-sql-file-save", queryApiDesigner:"query-api-designer", queryResultsSaveCsv:"query-results-save-csv", connectionsFileOpen:"connections-file-open", localTablesList:"local-tables-list", localTableLoad:"local-table-load", localTableSave:"local-table-save", localTableDelete:"local-table-delete", localTableImport:"local-table-import", localTableImportUrl:"local-table-import-url", localExcelFileOpen:"local-excel-file-open", localExcelList:"local-excel-list", localExcelImport:"local-excel-import" };
chrome.webview.addEventListener("message",event=>{if(event.data?.type==="loadQueryWorkspace")workbookSheetNames=Array.isArray(event.data.sheetNames)?event.data.sheetNames:[];});

function call(type, payload = {}, options = {}) {
  return new Promise((resolve, reject) => {
    const action = actions[type];
    const requestId=crypto.randomUUID();
    pending.set(requestId, { resolve, reject, action, silentError:!!options.silentError });
    chrome.webview.postMessage({ type, ...payload, requestId });
  });
}
function toast(text) { const e=$("toast"); e.textContent=text; e.classList.remove("hidden"); clearTimeout(toast.t); toast.t=setTimeout(()=>e.classList.add("hidden"),3500); }
function showResultError(error,context="Query failed",includeQueryContext=true){const detail=error?.message||String(error||"Unknown error"),connection=query.connectionName||$("connection")?.value||"(not selected)",sql=includeQueryContext?($("queryText")?.value||query.queryText||""):"",queryDetail=includeQueryContext?`\n\nConnection: ${connection}${sql?`\n\nSQL:\n${sql}`:""}`:"";resultMessage=`${context}\n\n${detail}${queryDetail}`;resultMode="messages";$("queryStatus").textContent="Error";$("resultSummary").textContent=context;applyResultMode();}
function esc(value) { return String(value ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function tableKey(table) { return `${table.schema || ""}.${table.name}`.toLowerCase(); }
function qualifiedName(table) { return table.schema ? `${table.schema}.${table.name}` : table.name; }
function isExcelTableSource(){const select=$("connection"),option=select?.selectedOptions?.[0],value=String(select?.value||query.connectionName||"").toLowerCase(),label=String(option?.textContent||"").toLowerCase();return value==="table"||label.includes("excel table")||label.includes("workbook table");}
function quoteSqlIdentifier(name){const text=String(name??"");return isExcelTableSource()?text:`[${text.replace(/]/g,"]]" )}]`;}
function sqlName(table){if(isExcelTableSource())return table.name;return table.schema?`${quoteSqlIdentifier(table.schema)}.${quoteSqlIdentifier(table.name)}`:quoteSqlIdentifier(table.name);}
function sqlColumn(name){return isExcelTableSource()?name:quoteSqlIdentifier(name);}
function sourceState(table) { const key=`${$("connection")?.value?.toLowerCase()||""}|${tableKey(table)}`; if(!sourceSelections.has(key))sourceSelections.set(key,{selected:new Set(),filters:new Map(),aliases:[]}); const state=sourceSelections.get(key);state.aliases||=[];return state; }
function tableAliases(table){return sourceState(table).aliases.filter(Boolean);}
function primaryAlias(table){return tableAliases(table)[0]||"";}
function aliasedColumn(table,column){const alias=primaryAlias(table);return `${alias?`${alias}.`:""}${sqlColumn(column)}`;}
function aliasedTable(table){const alias=primaryAlias(table);return `${sqlName(table)}${alias?` ${alias}`:""}`;}

async function loadConnections() {
  const result = await call("queryConnections");
  allConnections = (result.connections || []).sort((a,b)=>Number(isApiConnection(a))-Number(isApiConnection(b))||String(a.name||"").localeCompare(String(b.name||""),undefined,{sensitivity:"base"}));
  if(allConnections.some(connection=>connection.name===query.connectionName&&isApiConnection(connection)))$("showApis").checked=true;
  renderConnections();
  if(typeof renderQueryRunConnections==="function")renderQueryRunConnections();
  await loadSchema();
}
function isApiConnection(connection){return String(connection?.kind||connection?.type||"").toLowerCase()==="api";}
function selectedConnectionIsApi(){return $("connection")?.selectedOptions?.[0]?.dataset.api==="true";}
function renderConnections(){
  const previous=$("connection").value||query.connectionName,visible=allConnections.filter(connection=>$("showApis").checked||!isApiConnection(connection));
  $("connection").innerHTML=visible.map(c=>`<option value="${esc(c.name)}" data-api="${isApiConnection(c)}">${esc(c.name)} — ${esc(c.type||c.kind)}</option>`).join("");
  if(previous&&!visible.some(c=>c.name===previous))$("connection").insertAdjacentHTML("afterbegin",`<option value="${esc(previous)}">${esc(previous)} — missing connection</option>`);
  if(previous&&visible.some(c=>c.name===previous))$("connection").value=previous;
  if (!$("connection").value && $("connection").options.length) $("connection").selectedIndex = 0;
  if (!query.connectionName) query.connectionName = $("connection").value;
}
async function loadSchema() {
  const sourceConnectionName=$("connection").value;
  $("schema").innerHTML = '<p class="muted">Loading tables and views…</p>';
  expandedTables.clear();
  for(const key of visibleTables[sourceConnectionName.toLowerCase()]||[])expandedTables.add(key);
  try {
    const result = await call("querySchema", { connectionName:sourceConnectionName });
    tables = (result.tables || []).sort((left,right)=>qualifiedName(left).localeCompare(qualifiedName(right),undefined,{sensitivity:"base"}));
    for(const table of tables)if(expandedTables.has(tableKey(table)))await ensureColumns(table);
    renderSchema();
  } catch (error) { $("schema").innerHTML = `<p class="muted">${esc(error.message)}</p>`; showResultError(error,"Could not load tables and views"); }
}
async function ensureColumns(table) {
  if (table.columnsLoaded) return table.columns || [];
  if (table.columnPromise) return table.columnPromise;
  table.loading = true; renderSchema();
  table.columnPromise = (async () => {
    const result = await call("querySchema", { connectionName:$("connection").value, tableName:table.name, schemaName:table.schema || "" });
    table.columns = result.columns || [];
    table.columnsLoaded = true;
    return table.columns;
  })();
  try { return await table.columnPromise; }
  finally { table.loading = false; table.columnPromise = null; renderSchema(); }
}
function renderSchema() {
  const search = $("schemaSearch").value.trim().toLowerCase();
  const visible = tables.filter(table => !search || qualifiedName(table).toLowerCase().includes(search) || (table.columnsLoaded && (table.columns || []).some(column => column.name.toLowerCase().includes(search))));
  $("schema").innerHTML = visible.map(table => {
    const key=tableKey(table), expanded=expandedTables.has(key), columns=table.columns || [], isView=String($("connection").value).toLowerCase()!=="local"&&/view/i.test(table.type||"");
    const state=sourceState(table);
    const aliases=tableAliases(table),aliasLabel=aliases.length?`${aliases[0]}${aliases.length>1?"+":""}`:"";
    const localTooltip=String($("connection").value).toLowerCase()==="local"?[`Type: ${table.sourceMode||table.type||"Local table"}`,table.comment?`Comment: ${table.comment}`:"",table.sourcePath?`File: ${table.sourcePath}`:"",table.sourceObjectName?`${table.sourceObjectKind||"Object"}: ${table.sourceObjectName}`:"",table.updatedUtc?`Last update: ${formatLocalDate(table.updatedUtc)}`:""].filter(Boolean).join("\n"):"";
    return `<div class="table-node" data-key="${esc(key)}"><div class="table-title"${localTooltip?` title="${esc(localTooltip)}"`:""}><span>${esc(qualifiedName(table))}</span><span class="table-title-actions">${isView?'<span class="table-kind" title="View">V</span>':""}${aliasLabel?`<b class="table-alias" title="${esc(aliases.join(", "))}">${esc(aliasLabel)}</b>`:""}<span>${table.loading ? "…" : expanded ? "−" : "+"}</span></span></div>${expanded ? `<div class="columns">${columns.map((column,index)=>`<div class="column" data-column="${index}"><input type="checkbox" data-select-column="${index}" ${state.selected.has(index)?"checked":""}><span>${esc(column.name)}</span><small>${esc(column.type)}</small><span class="column-filter-wrap"><input class="column-filter" data-filter-column="${index}" value="${esc(state.filters.get(index)||"")}" placeholder="Filter"><button data-filter-pick="${index}" title="Choose distinct values">…</button></span></div>`).join("") || '<div class="column muted">No columns found</div>'}<div class="source-actions"><button data-source-query="add">Selected → query</button><button data-source-preview>View top</button></div></div>` : ""}</div>`;
  }).join("") || '<p class="muted">No tables or views found.</p>';
  decorateLocalSourceGroups(visible);
  document.querySelectorAll(".table-node").forEach(node => {
    const table = tables.find(item => tableKey(item) === node.dataset.key);
    const title = node.querySelector(".table-title");
    title.onclick = event => {
      if(event.detail>1)return;
      const key=node.dataset.key;
      clearTimeout(tableClickTimers.get(key));
      tableClickTimers.set(key,setTimeout(async()=>{
        tableClickTimers.delete(key);
        if (expandedTables.has(key)) expandedTables.delete(key);
        else { try { await ensureColumns(table); expandedTables.add(key); } catch(error) { toast(error.message || String(error)); } }
        rememberVisibleTables();renderSchema();selectItem(table);
      },220));
    };
    title.ondblclick = async event => { event.preventDefault();const key=node.dataset.key;clearTimeout(tableClickTimers.get(key));tableClickTimers.delete(key);await addJoinTable(table); };
    title.oncontextmenu = event => { event.preventDefault(); String($("connection").value).toLowerCase()==="local"?showLocalTableMenu(event,table):showTableMenu(event,table); };
    node.querySelectorAll(".column[data-column]").forEach(element => {
      element.onclick = event => { if(event.target.matches("input"))return; event.stopPropagation(); selectItem(table, table.columns[+element.dataset.column]); };
      element.oncontextmenu = event => { event.preventDefault(); event.stopPropagation(); showSourceColumnMenu(event,table,+element.dataset.column); };
    });
    node.querySelectorAll("[data-select-column]").forEach(input=>input.onchange=()=>{const index=+input.dataset.selectColumn;input.checked?sourceState(table).selected.add(index):sourceState(table).selected.delete(index);});
    node.querySelectorAll("[data-filter-column]").forEach(input=>{input.onclick=event=>event.stopPropagation();input.oninput=()=>{const index=+input.dataset.filterColumn,value=input.value.trim();value?sourceState(table).filters.set(index,value):sourceState(table).filters.delete(index);};});
    node.querySelectorAll("[data-filter-pick]").forEach(button=>button.onclick=async event=>{event.stopPropagation();await openFilterPicker(table,+button.dataset.filterPick);});
    node.querySelectorAll("[data-source-query]").forEach(button=>button.onclick=async event=>{event.stopPropagation();await setSourceQuery(table,false);});
    node.querySelectorAll("[data-source-preview]").forEach(button=>button.onclick=async event=>{event.stopPropagation();await previewSelected(table);});
  });
}
function localSourceGroup(table){const mode=String(table?.sourceMode||table?.type||"").toLowerCase();if(mode==="sourceview")return"Source views";if(mode==="combinedsource")return"Combined sources";return table?.groupName||table?.schema?`Schema · ${table.groupName||table.schema}`:"Local tables";}
function decorateLocalSourceGroups(visible){if(String($("connection")?.value).toLowerCase()!=="local")return;const schema=$("schema"),nodes=new Map([...schema.querySelectorAll(".table-node")].map(node=>[node.dataset.key,node])),fragment=document.createDocumentFragment(),groups=[...new Set(visible.map(localSourceGroup))].sort((a,b)=>{const order=value=>value==="Source views"?0:value==="Combined sources"?1:value.startsWith("Schema ·")?2:3;return order(a)-order(b)||a.localeCompare(b)});for(const group of groups){const members=visible.filter(table=>localSourceGroup(table)===group);const heading=document.createElement("div");heading.className="source-group-heading";heading.textContent=group;fragment.append(heading);members.forEach(table=>{const node=nodes.get(tableKey(table));if(node)fragment.append(node)});}schema.replaceChildren(fragment);}
function selectItem(table, column) {
  selectedTable = table;
  $("tableStats").disabled = false;
}
function insertSql(text) { const editor=$("queryText"), position=editor.selectionStart; editor.value=editor.value.slice(0,position)+text+editor.value.slice(editor.selectionEnd); editor.focus(); editor.selectionStart=editor.selectionEnd=position+text.length; hideAutocomplete(); highlightSql(); if(typeof markActiveQueryTabDirty==="function")markActiveQueryTabDirty(); }
function replaceSql(text){$("queryText").value=text;highlightSql();$("queryText").focus();if(typeof markActiveQueryTabDirty==="function")markActiveQueryTabDirty();}
function isNumericColumn(column){return /int|decimal|numeric|number|double|single|float|real|currency/i.test(column?.type||"")}function sqlLiteral(value,column){const text=String(value??'').trim();if(/^null$/i.test(text))return'NULL';if(/^-?\d+(?:[.,]\d+)?$/.test(text))return text.replace(',','.');if(/^'.*'$/.test(text))return text;return`'${text.replace(/'/g,"''")}'`}function filterExpression(value,column){const text=String(value||'').trim();if(!text)return'';if(/^not\s+null$/i.test(text))return'IS NOT NULL';if(/^null$/i.test(text))return'IS NULL';let m=text.match(/^between\s+(.+?)\s+and\s+(.+)$/i);if(m)return`BETWEEN ${sqlLiteral(m[1],column)} AND ${sqlLiteral(m[2],column)}`;m=text.match(/^(-?\d+(?:\.\d+)?)\s*-\s*(-?\d+(?:\.\d+)?)$/);if(m)return`BETWEEN ${m[1]} AND ${m[2]}`;if(/^in\s*\(/i.test(text)){const inner=text.replace(/^in\s*\(|\)\s*$/gi,'');return`IN (${inner.split(',').map(x=>sqlLiteral(x,column)).join(', ')})`}if(text.includes('|'))return`IN (${text.split('|').map(x=>sqlLiteral(x,column)).join(', ')})`;m=text.match(/^(<>|!=|>=|<=|>|<|=)\s*(.+)$/);if(m)return`${m[1]} ${sqlLiteral(m[2],column)}`;m=text.match(/^like\s+(.+)$/i);if(m)return`LIKE ${sqlLiteral(m[1],column)}`;if(text.includes('*')||text.includes('%'))return`LIKE ${sqlLiteral(text.replace(/\*/g,'%'),column)}`;return`= ${sqlLiteral(text,column)}`}function filterClause(table){const state=sourceState(table),parts=[];for(const [index,value] of state.filters){const column=table.columns?.[index],expression=filterExpression(value,column);if(column&&expression)parts.push(`${aliasedColumn(table,column.name)} ${expression}`)}return parts.length?`\nWHERE ${parts.join("\n  AND ")}`:"";}
function sourceSelectSql(table,top=false){const state=sourceState(table),indexes=state.selected.size?[...state.selected].sort((a,b)=>a-b):(table.columns||[]).map((_,index)=>index),fields=indexes.map(index=>table.columns[index]?.name).filter(Boolean).map(name=>aliasedColumn(table,name));return `SELECT ${top?"TOP 100 ":""}${fields.length?fields.join(",\n       "):primaryAlias(table)?`${primaryAlias(table)}.*`:"*"}\nFROM ${aliasedTable(table)}${filterClause(table)}`;}
async function apiSpecFor(table){const result=await call("queryApiSpec",{connectionName:$("connection").value,endpointName:table.name});return JSON.stringify(result.spec,null,2);}
function adoptSourceConnection(){const name=$("connection").value;if(!name)return;query.connectionName=name;if(typeof activeQueryTab==="function"){const tab=activeQueryTab();if(tab){tab.query.connectionName=name;tab.dirty=true;}}if(typeof renderQueryTabs==="function")renderQueryTabs();}
async function setSourceQuery(table,top=false){if(selectedConnectionIsApi()){replaceSql(await apiSpecFor(table));adoptSourceConnection();return;}await ensureColumns(table);replaceSql(sourceSelectSql(table,top));adoptSourceConnection();}
async function previewSelected(table){$("queryStatus").textContent="Previewing selection…";const text=selectedConnectionIsApi()?await apiSpecFor(table):(await ensureColumns(table),sourceSelectSql(table,true));const previewQuery={...query,connectionName:$("connection").value,queryText:text,previewLimit:100};try{const result=await call("queryRun",{query:previewQuery});renderResult(result.data,true,`Preview: ${qualifiedName(table)}`);$("queryStatus").textContent="Ready";}catch(error){showResultError(error,`Could not preview ${qualifiedName(table)}`);}}
async function addSourceFields(table){await ensureColumns(table);const state=sourceState(table),indexes=state.selected.size?[...state.selected].sort((a,b)=>a-b):(table.columns||[]).map((_,index)=>index),fields=indexes.map(index=>table.columns[index]?.name).filter(Boolean).map(name=>aliasedColumn(table,name));if(!fields.length)return toast("Select at least one field");insertSql(fields.join(",\n       "));}
function showContextMenu(event,html,wire){const menu=$("contextMenu"),margin=8;menu.innerHTML=html;menu.style.left=`${Math.max(margin,Math.min(event.clientX,window.innerWidth-240))}px`;menu.style.top=`${Math.max(margin,event.clientY)}px`;menu.classList.remove("hidden");wire?.(menu);requestAnimationFrame(()=>{const rect=menu.getBoundingClientRect(),left=Math.max(margin,Math.min(parseFloat(menu.style.left)||event.clientX,window.innerWidth-rect.width-margin)),preferredTop=event.clientY,top=preferredTop+rect.height+margin<=window.innerHeight?preferredTop:Math.max(margin,preferredTop-rect.height);menu.style.left=`${left}px`;menu.style.top=`${Math.min(top,window.innerHeight-rect.height-margin)}px`;});}
function hideContextMenu(){$("contextMenu").classList.add("hidden");}
async function copyText(text,label){try{await navigator.clipboard.writeText(text);}catch{const area=document.createElement("textarea");area.value=text;area.style.position="fixed";area.style.opacity="0";document.body.appendChild(area);area.select();document.execCommand("copy");area.remove();}hideContextMenu();toast(`${label} copied to clipboard`);}
function pointerDrag(event,onMove,onEnd=()=>{}){if(event.button!==0)return;event.preventDefault();let active=true;const move=e=>{if(active&&e.buttons===1)onMove(e);else if(active&&e.buttons===0)finish();};const finish=()=>{if(!active)return;active=false;window.removeEventListener("pointermove",move,true);window.removeEventListener("pointerup",finish,true);window.removeEventListener("pointercancel",finish,true);window.removeEventListener("blur",finish,true);onEnd();};window.addEventListener("pointermove",move,true);window.addEventListener("pointerup",finish,true);window.addEventListener("pointercancel",finish,true);window.addEventListener("blur",finish,true);}
async function previewTable(table){$("queryStatus").textContent="Previewing table…";const previewQuery={...query,connectionName:$("connection").value,queryText:`SELECT *\nFROM ${sqlName(table)}`,previewLimit:100};try{const result=await call("queryRun",{query:previewQuery});renderResult(result.data,true,`Preview: ${qualifiedName(table)}`);$("queryStatus").textContent="Ready";}catch(error){showResultError(error,`Could not preview ${qualifiedName(table)}`);}}
async function openFilterPicker(table,index){const column=table.columns[index],lookupQuery={connectionName:$("connection").value,queryText:`SELECT DISTINCT ${sqlColumn(column.name)}\nFROM ${sqlName(table)}`,previewLimit:0,measures:[],parameters:query.parameters||[],data:{columns:[],rows:[]}};$("queryStatus").textContent="Loading filter values…";try{const result=await call("queryRun",{query:lookupQuery}),columns=result.data?.columns||[],rows=result.data?.rows||[];filterChoices=[...new Map(rows.map(row=>{const value=rowValues(row,columns)[0];return[String(value??''),value]})).values()].sort((a,b)=>String(a??'').localeCompare(String(b??''),undefined,{numeric:true,sensitivity:'base'}));activeFilter={table,index,column};filterPending=new Set(selectedFilterTokens().map(String));$("filterTitle").textContent=`Filter: ${column.name}`;$("filterSearch").value='';renderFilterChoices();$("filterModal").classList.remove("hidden");requestAnimationFrame(()=>$("filterSearch").focus());$("queryStatus").textContent="Ready"}catch(error){$("queryStatus").textContent="Error";toast(error.message||String(error))}}
function selectedFilterTokens(){const existing=sourceState(activeFilter.table).filters.get(activeFilter.index)||'';if(/^in\s*\(/i.test(existing))return existing.replace(/^in\s*\(|\)\s*$/gi,'').split(',').map(x=>x.trim().replace(/^'|'$/g,'')).filter(Boolean);return existing.includes('|')?existing.split('|').map(x=>x.trim()):[]}
function renderFilterChoices(){if(!activeFilter)return;const search=$("filterSearch").value.toLowerCase();const visible=filterChoices.filter(value=>!search||String(value??'').toLowerCase().includes(search));$("filterValues").innerHTML=visible.map((value,index)=>`<label><input type="checkbox" data-filter-value="${index}" data-raw-index="${filterChoices.indexOf(value)}" ${filterPending.has(String(value??''))?'checked':''}> <span>${esc(value==null?'(null)':value)}</span></label>`).join('')||'<p class="muted">No matching values.</p>';$("filterValues").querySelectorAll('[data-filter-value]').forEach(input=>input.onchange=()=>{const value=String(filterChoices[+input.dataset.rawIndex]??'');input.checked?filterPending.add(value):filterPending.delete(value);renderFilterSelectAll()});renderFilterSelectAll()}
function renderFilterSelectAll(){$("filterSelectAll").checked=$("filterValues").querySelectorAll('[data-filter-value]').length>0&&$("filterValues").querySelectorAll('[data-filter-value]:not(:checked)').length===0}
function applyPickedFilter(){if(!activeFilter)return;const state=sourceState(activeFilter.table);if(filterPending.size)state.filters.set(activeFilter.index,[...filterPending].join('|'));else state.filters.delete(activeFilter.index);$("filterModal").classList.add("hidden");renderSchema()}
function showLocalTableMenu(event,table){const state=sourceState(table);showContextMenu(event,`<div class="menu-title">${esc(qualifiedName(table))}</div><label>Aliases <input data-table-aliases value="${esc(state.aliases.join(", "))}" placeholder="t, previous"></label><button data-local-table-action="aliases">Set aliases</button><hr><button data-local-table-action="top">View top 100 records</button><button data-local-table-action="select">Select * into query</button><button data-local-table-action="insert">Insert table name into query</button><hr><button data-local-table-action="edit">Edit import settings</button><button data-local-table-action="reimport">Re-import file</button><button data-local-table-action="delete">Delete local table</button>`,menu=>menu.querySelectorAll("[data-local-table-action]").forEach(button=>button.onclick=async()=>{const action=button.dataset.localTableAction;if(action==="aliases"){const raw=menu.querySelector("[data-table-aliases]").value,aliases=[...new Set(raw.split(/[,;\s]+/).map(value=>value.trim()).filter(Boolean))];if(aliases.some(alias=>!/^[A-Za-z_][A-Za-z0-9_]*$/.test(alias)))return toast("Aliases must start with a letter or underscore and contain only letters, numbers, or underscores");state.aliases=aliases;hideContextMenu();renderSchema();return;}hideContextMenu();if(action==="insert"){insertSql(aliasedTable(table));return;}if(action==="top"){await previewTable(table);return;}if(action==="select"){replaceSql(`SELECT ${primaryAlias(table)?`${primaryAlias(table)}.*`:"*"}\nFROM ${aliasedTable(table)}`);return;}if(action==="delete"){if(!await window.QReportsDialogs.confirm(`Delete local table '${table.name}' and its generated JSONL files?`))return;await call("localTableDelete",{name:table.name});await loadSchema();toast("Local table deleted");return;}const loaded=await call("localTableLoad",{name:table.name}),definition=loaded.definition||{};if(action==="reimport"&&definition.SourcePath){try{if(definition.SourceMode==="ExcelFile")await call("localExcelImport",{name:table.name,path:definition.SourcePath,objectKind:definition.SourceObjectKind,objectName:definition.SourceObjectName});else await call("localTableImport",{name:table.name,path:definition.SourcePath,delimiter:definition.Delimiter||",",hasHeaders:definition.HasHeaders!==false,encoding:definition.EncodingName||"UTF-8"});await loadSchema();toast("Local table imported again using its saved settings");return;}catch(error){toast("Source file is unavailable; showing the saved editable data.");}}openLoadedLocalTable(table,definition,loaded);}));}
function sourceRowIndices(definition,rowCount){if(definition.SourceRowIndices?.length===rowCount)return [...definition.SourceRowIndices];const excluded=new Set(definition.ExcludedSourceRows||[]),result=[];for(let index=0;result.length<rowCount;index++)if(!excluded.has(index))result.push(index);return result;}
function openLoadedLocalTable(table,definition,loaded){const rows=loaded.data?.rows||[];localState={id:definition.Id||"",name:definition.Name||table.name,sourceMode:definition.SourceMode||"Manual",sourcePath:definition.SourcePath||"",delimiter:definition.Delimiter||",",hasHeaders:definition.HasHeaders!==false,encodingName:definition.EncodingName||"UTF-8",updatedUtc:definition.UpdatedUtc||"",sourceObjectKind:definition.SourceObjectKind||"",sourceObjectName:definition.SourceObjectName||"",comment:definition.Comment||"",importSteps:structuredClone(definition.ImportSteps||[]),excludedSourceRows:[...(definition.ExcludedSourceRows||[])],sourceRowIndices:sourceRowIndices(definition,rows.length),columns:(definition.Columns||[]).map(column=>({name:column.Name,sourceName:column.SourceName||column.Name,type:column.DataType})),rows};ensureLocalDataDialog();$("localPaste").value="";$("localError").textContent=definition.SourcePath?`Imported from ${definition.SourcePath}`:"";renderLocalGrid();$("localDataModal").classList.remove("hidden");}
function showTableMenu(event,table){if(selectedConnectionIsApi()){showContextMenu(event,`<div class="menu-title">${esc(qualifiedName(table))}</div><button data-api-source="query">Selected → query</button><button data-api-source="top">View top records</button>`,menu=>menu.querySelectorAll("[data-api-source]").forEach(button=>button.onclick=async()=>{hideContextMenu();try{if(button.dataset.apiSource==="query")await setSourceQuery(table);else await previewSelected(table);}catch(error){showResultError(error,"API source failed");}}));return;}const state=sourceState(table);showContextMenu(event,`<div class="menu-title">${esc(qualifiedName(table))}</div><label>Aliases <input data-table-aliases value="${esc(state.aliases.join(", "))}" placeholder="t, previous"></label><button data-table-action="aliases">Set aliases</button><hr><button data-table-action="top">View top 100 records</button><button data-table-action="select">Select * into query</button><button data-table-action="insert">Insert table name into query</button><hr><button data-table-action="edit">Edit table data</button>`,menu=>menu.querySelectorAll("[data-table-action]").forEach(button=>button.onclick=async()=>{const action=button.dataset.tableAction;if(action==="aliases"){const raw=menu.querySelector("[data-table-aliases]").value,state=sourceState(table),aliases=[...new Set(raw.split(/[,;\s]+/).map(value=>value.trim()).filter(Boolean))];if(aliases.some(alias=>!/^[A-Za-z_][A-Za-z0-9_]*$/.test(alias)))return toast("Aliases must start with a letter or underscore and contain only letters, numbers, or underscores");state.aliases=aliases;hideContextMenu();renderSchema();return;}hideContextMenu();if(action==="insert")insertSql(aliasedTable(table));else if(action==="top")await previewTable(table);else if(action==="edit"){replaceSql(`SELECT TOP ${Number($("previewLimit").value)||5000} *\nFROM ${sqlName(table)}`);await loadEditable();}else replaceSql(`SELECT ${primaryAlias(table)?`${primaryAlias(table)}.*`:"*"}\nFROM ${aliasedTable(table)}`);}));}
function showSourceColumnMenu(event,table,index){const column=table.columns[index],state=sourceState(table);showContextMenu(event,`<div class="menu-title">${esc(column.name)}</div><label><input type="checkbox" data-column-check ${state.selected.has(index)?"checked":""}> Include in generated SELECT</label><button data-column-action="insert">Insert column name</button><button data-column-action="only">Select only this column</button>`,menu=>{menu.querySelector("[data-column-check]").onchange=e=>{e.target.checked?state.selected.add(index):state.selected.delete(index);renderSchema();hideContextMenu();};menu.querySelector('[data-column-action="insert"]').onclick=()=>{insertSql(aliasedColumn(table,column.name));hideContextMenu();};menu.querySelector('[data-column-action="only"]').onclick=()=>{state.selected=new Set([index]);setSourceQuery(table,false);hideContextMenu();};});}

async function addJoinTable(table) {
  await ensureColumns(table);
  $("joinPanel").classList.remove("hidden");
  if (joinTables.some(item => tableKey(item) === tableKey(table))) return toast("Table is already in the join designer");
  joinTables.push({ ...table, columns:[...(table.columns||[])], alias:`t${joinTables.length+1}`, selectedColumns:new Set((table.columns||[]).map(column=>column.name)) });
  renderJoin(); if (joinTables.length >= 2) openJoin(-1,joinTables.length-2,joinTables.length-1);
}
function renderJoin() {
  $("joinCanvas").innerHTML = joinTables.map((table,tableIndex) => `<div class="join-table" data-join-table="${tableIndex}"><b>${esc(table.alias)} · ${esc(qualifiedName(table))}</b><div class="join-columns">${(table.columns||[]).map(column=>`<label><input type="checkbox" data-join-column="${tableIndex}" value="${esc(column.name)}" ${table.selectedColumns?.has(column.name)?"checked":""}> <span>${esc(column.name)}</span></label>`).join("")}</div></div>`).join("") || '<span class="muted">Double-click tables in Data sources to begin.</span>';
  if($("joinList")) $("joinList").innerHTML = joins.map((join,index)=>`<div class="join-item"><button data-remove-join="${index}">×</button><b>${esc(join.type)}</b><br>${esc(join.left.alias)} → ${esc(join.right.alias)}<br>${join.clauses.map(clause=>esc(`${clause.left} = ${clause.right}`)).join("<br>")}</div>`).join("") || '<p class="muted">No joins defined.</p>';
  document.querySelectorAll("[data-remove-join]").forEach(element => element.onclick=()=>{ joins.splice(+element.dataset.removeJoin,1); renderJoin(); });
  document.querySelectorAll("[data-join-column]").forEach(input=>input.onchange=()=>{const table=joinTables[+input.dataset.joinColumn];table.selectedColumns||=new Set();input.checked?table.selectedColumns.add(input.value):table.selectedColumns.delete(input.value);});
  document.querySelectorAll("[data-join-table]").forEach(node=>node.oncontextmenu=event=>{event.preventDefault();const index=+node.dataset.joinTable,table=joinTables[index];showContextMenu(event,`<div class="menu-title">${esc(qualifiedName(table))}</div><label>Alias <input data-join-alias value="${esc(table.alias)}"></label><button data-join-action="alias">Set alias</button><button data-join-action="all">Check all columns</button><button data-join-action="none">Uncheck all columns</button><hr><button data-join-action="delete">Delete table</button>`,menu=>menu.querySelectorAll('[data-join-action]').forEach(button=>button.onclick=()=>{const action=button.dataset.joinAction;if(action==='alias'){const value=menu.querySelector('[data-join-alias]').value.trim();if(!/^[A-Za-z_][A-Za-z0-9_]*$/.test(value))return toast('Enter a valid SQL alias');table.alias=value;}else if(action==='all')table.selectedColumns=new Set(table.columns.map(column=>column.name));else if(action==='none')table.selectedColumns.clear();else if(action==='delete'){joins=joins.filter(join=>join.left!==table&&join.right!==table);joinTables.splice(index,1);}hideContextMenu();renderJoin();}));});
  requestAnimationFrame(renderJoinLines);
}
function renderJoinLines(){const canvas=$("joinCanvas");canvas.querySelector('.join-links')?.remove();if(!joins.length)return;const bounds=canvas.getBoundingClientRect(),svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.classList.add('join-links');svg.innerHTML='<defs><marker id="joinArrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z"/></marker></defs>';joins.forEach((join,index)=>{const leftIndex=joinTables.indexOf(join.left),rightIndex=joinTables.indexOf(join.right),left=canvas.querySelector(`[data-join-table="${leftIndex}"]`),right=canvas.querySelector(`[data-join-table="${rightIndex}"]`);if(!left||!right)return;const a=left.getBoundingClientRect(),b=right.getBoundingClientRect(),x1=a.right-bounds.left+canvas.scrollLeft,y1=a.top+a.height/2-bounds.top+canvas.scrollTop,x2=b.left-bounds.left+canvas.scrollLeft,y2=b.top+b.height/2-bounds.top+canvas.scrollTop,path=document.createElementNS(svg.namespaceURI,'path'),title=document.createElementNS(svg.namespaceURI,'title');path.setAttribute('d',`M ${x1} ${y1} C ${(x1+x2)/2} ${y1}, ${(x1+x2)/2} ${y2}, ${x2} ${y2}`);path.setAttribute('marker-end','url(#joinArrow)');path.dataset.joinLink=index;title.textContent=`${join.type}: ${join.left.alias} → ${join.right.alias}\n${join.clauses.map(clause=>`${clause.left} = ${clause.right}`).join('\n')}`;path.append(title);path.onclick=()=>openJoin(index);svg.append(path)});canvas.prepend(svg)}
function openJoin(index=-1,leftIndex=0,rightIndex=1) { if(joinTables.length<2)return toast("Add at least two tables");editingJoinIndex=index;const options=joinTables.map((table,tableIndex)=>`<option value="${tableIndex}">${esc(`${table.alias} · ${qualifiedName(table)}`)}</option>`).join(""); $("joinLeftTable").innerHTML=options; $("joinRightTable").innerHTML=options;const existing=joins[index];if(existing){$("joinLeftTable").value=joinTables.indexOf(existing.left);$("joinRightTable").value=joinTables.indexOf(existing.right);$("joinType").value=existing.type;}else{$("joinLeftTable").value=leftIndex;$("joinRightTable").value=rightIndex;}$("joinClauses").innerHTML="";(existing?.clauses||[null]).forEach(clause=>addClause(clause)); $("joinModal").classList.remove("hidden"); }
function addClause(existing=null) { const left=joinTables[+$("joinLeftTable").value]||joinTables[0], right=joinTables[+$("joinRightTable").value]||joinTables[1]; const row=document.createElement("div"); row.className="clause"; row.innerHTML=`<select class="left-col">${(left.columns||[]).map(c=>`<option ${c.name===existing?.left?'selected':''}>${esc(c.name)}</option>`).join("")}</select><span>=</span><select class="right-col">${(right.columns||[]).map(c=>`<option ${c.name===existing?.right?'selected':''}>${esc(c.name)}</option>`).join("")}</select><button type="button">×</button>`; row.querySelector("button").onclick=()=>row.remove(); $("joinClauses").appendChild(row); }
function saveJoin() { const left=joinTables[+$("joinLeftTable").value], right=joinTables[+$("joinRightTable").value]; if(!left||!right||left===right)return toast("Choose two different tables"); const clauses=[...document.querySelectorAll(".clause")].map(row=>({left:row.querySelector(".left-col").value,right:row.querySelector(".right-col").value})).filter(c=>c.left&&c.right); if(!clauses.length)return toast("Add at least one join condition"); const value={left,right,type:$("joinType").value,clauses};if(editingJoinIndex>=0)joins[editingJoinIndex]=value;else joins.push(value);editingJoinIndex=-1;$("joinModal").classList.add("hidden"); renderJoin(); }
function generateSql() { if(!joinTables.length)return toast("Add tables first"); const main=joinTables[0],full=table=>sqlName(table),reference=(table,column)=>`${sqlColumn(table.alias)}.${sqlColumn(column)}`,selected=joinTables.flatMap(table=>[...(table.selectedColumns||[])].map(column=>reference(table,column))); let sql=`SELECT ${selected.length?selected.join(",\n       "):"*"}\nFROM ${full(main)} AS ${sqlColumn(main.alias)}`; for(const join of joins)sql+=`\n${join.type} ${full(join.right)} AS ${sqlColumn(join.right.alias)} ON `+join.clauses.map(c=>`${reference(join.left,c.left)} = ${reference(join.right,c.right)}`).join("\n    AND "); $("queryText").value=sql; highlightSql(); toast("SQL generated from joins"); }

function resultColumnName(column){return typeof column==="string"?column:column.name;}
function rowValues(row,columns){return Array.isArray(row)?row:columns.map(column=>row?.[resultColumnName(column)]);}
function formatResultValue(value,format){if(value==null)return "";if(format==="number"){const number=Number(value);return Number.isFinite(number)?number.toLocaleString(undefined,{maximumFractionDigits:2}):value;}if(format==="integer"){const number=Number(value);return Number.isFinite(number)?number.toLocaleString(undefined,{maximumFractionDigits:0}):value;}if(format==="percent"){const number=Number(value);return Number.isFinite(number)?number.toLocaleString(undefined,{style:"percent",maximumFractionDigits:2}):value;}if(format==="excel-date"){const number=Number(value),date=Number.isFinite(number)?new Date(Date.UTC(1899,11,30)+number*86400000):new Date(value);return Number.isNaN(date.valueOf())?value:date.toLocaleDateString();}if(format==="date"){const date=new Date(value);return Number.isNaN(date.valueOf())?value:date.toLocaleDateString();}return value;}
function editColumn(index){return editState?.columns?.find(column=>column.name.toLowerCase()===resultColumnName(resultView.data.columns[index]).toLowerCase());}
function hasEdits(){return !!editState?.rowStates?.some(state=>state&&state!=="clean");}
function updateEditActions(){const bar=$("editActions");bar.classList.toggle("hidden",!editState);bar.querySelectorAll('[data-action="saveEdits"],[data-action="revertEdits"]').forEach(button=>button.disabled=!hasEdits());}
function exactSqlNumber(column){return /^(bigint|decimal|numeric|money|smallmoney)$/i.test(column?.dbType||"");}
function editInputHtml(value,column,index,rowIndex){if(column?.dbType==="bit")return `<input type="checkbox" data-edit-row="${rowIndex}" data-edit-column="${index}" ${value===true||value===1?"checked":""}>`;const key=lookupKey(column?.name||""),config=lookupSettings[key],choices=lookupChoices.get(key);if(config&&choices?.length){const current=String(value??""),matched=choices.some(choice=>String(choice.value??"")===current);return `<select data-edit-row="${rowIndex}" data-edit-column="${index}">${column.nullable?'<option value="">(blank)</option>':""}${!matched&&current?`<option value="${esc(current)}" selected>${esc(current)} (not in lookup)</option>`:""}${choices.map(choice=>`<option value="${esc(choice.value??"")}" ${String(choice.value??"")===current?"selected":""}>${esc(lookupLabel(choice,config.mode))}</option>`).join("")}</select>`;}const exact=exactSqlNumber(column),type=/date|time/i.test(column?.dbType||"")||exact?"text":/int|decimal|numeric|money|float|real/i.test(column?.dbType||"")?"number":"text",step=type==="number"?' step="any"':exact?' inputmode="decimal"':"";return `<input type="${type}"${step} data-edit-row="${rowIndex}" data-edit-column="${index}" value="${esc(value??"")}" ${column?.nullable?'placeholder="NULL"':""}>`;}
function lookupLabel(choice,mode){const id=String(choice.value??""),name=String(choice.name??"");return mode==="name"?name:mode==="id"?id:`${id} - ${name}`;}
async function refreshLookupChoices(){lookupChoices.clear();if(!editState)return;for(const column of editState.columns||[]){const key=lookupKey(column.name),config=lookupSettings[key];if(!config)continue;try{const table=tables.find(table=>tableKey(table)===config.table);if(!table)continue;await ensureColumns(table);const value=table.columns.find(item=>item.name.toLowerCase()===config.value.toLowerCase()),name=table.columns.find(item=>item.name.toLowerCase()===config.name.toLowerCase());if(!value||!name)continue;const order=config.order==="name"?name:value,tableSql=sqlName(table),qualified=columnName=>`${tableSql}.${sqlColumn(columnName)}`,sql=`SELECT ${qualified(value.name)}, ${qualified(name.name)} FROM ${tableSql} ORDER BY ${qualified(order.name)}`;const result=await call("queryRun",{query:{connectionName:editState.connectionName,queryText:sql,previewLimit:5000,parameters:[]}});lookupChoices.set(key,(result.data?.rows||[]).map(row=>({value:row[0],name:row[1]})));}catch(error){console.warn("Lookup could not load",column.name,error);}}}
async function configureLookup(index){if(!editState)return;const column=editColumn(index);if(!column||column.dbType==="bit")return;const key=lookupKey(column.name),saved=lookupSettings[key]||{},eligible=tables.filter(table=>String(table.type||"").toLowerCase()!=="api");const modal=document.createElement("div");modal.className="modal lookup-modal";modal.innerHTML=`<div class="dialog"><h2>Lookup for ${esc(column.name)}</h2><p class="muted">Choose a table and ID/name columns. The cell saves the ID, not the displayed label. Up to 5,000 lookup rows are loaded.</p><label>Lookup table<select data-lookup-table><option value="">None (remove lookup)</option>${eligible.map(table=>`<option value="${esc(tableKey(table))}">${esc(qualifiedName(table))}</option>`).join("")}</select></label><div class="two"><label>ID column<select data-lookup-value></select></label><label>Name column<select data-lookup-name></select></label></div><div class="two"><label>Display<select data-lookup-mode><option value="both">ID - name</option><option value="id">ID</option><option value="name">Name</option></select></label><label>Order by<select data-lookup-order><option value="id">ID</option><option value="name">Name</option></select></label></div><div class="dialog-actions"><button data-lookup-cancel>Cancel</button><button class="apply" data-lookup-save>Save lookup</button></div></div>`;document.body.append(modal);const tableInput=modal.querySelector("[data-lookup-table]"),valueInput=modal.querySelector("[data-lookup-value]"),nameInput=modal.querySelector("[data-lookup-name]");tableInput.value=saved.table||"";async function updateColumns(){const table=eligible.find(item=>tableKey(item)===tableInput.value);if(table)await ensureColumns(table);const options=(table?.columns||[]).map(item=>`<option value="${esc(item.name)}">${esc(item.name)}</option>`).join("");valueInput.innerHTML=options;nameInput.innerHTML=options;if(saved.table===tableInput.value){valueInput.value=saved.value||"";nameInput.value=saved.name||"";}}tableInput.onchange=()=>updateColumns();await updateColumns();modal.querySelector("[data-lookup-mode]").value=saved.mode||"both";modal.querySelector("[data-lookup-order]").value=saved.order||"id";modal.querySelector("[data-lookup-cancel]").onclick=()=>modal.remove();modal.querySelector("[data-lookup-save]").onclick=async()=>{if(tableInput.value&&!valueInput.value)return toast("Choose an ID column");if(tableInput.value&&!nameInput.value)return toast("Choose a name column");if(tableInput.value)lookupSettings[key]={table:tableInput.value,value:valueInput.value,name:nameInput.value,mode:modal.querySelector("[data-lookup-mode]").value,order:modal.querySelector("[data-lookup-order]").value};else delete lookupSettings[key];localStorage.setItem(lookupSettingsKey,JSON.stringify(lookupSettings));modal.remove();await refreshLookupChoices();renderResult(resultView.data,true);};}
function isStatisticsData(columns){return columns.length===13&&["Column","Valid","%Valid","Unique","Mean","Distribution","50% (Median)","Min","25%","75%","Max","Empty","Std"].every((name,index)=>resultColumnName(columns[index])===name);}
function statisticsCellHtml(columns,values,index,format="auto"){
 const name=resultColumnName(columns[index]),display=esc(formatResultValue(values[index],format));if(!isStatisticsData(columns))return display;
 if(name==="%Valid"){const percent=Math.max(0,Math.min(100,Number(values[index])||0));return `<div class="stats-meter" title="${percent}% valid"><span style="width:${percent}%"></span></div><span>${display}%</span>`;}
