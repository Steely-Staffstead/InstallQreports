<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>QReports sources</title><link rel="stylesheet" href="connections.css?v=20260902-2"><link rel="stylesheet" href="connections-overrides.css?v=20260918-1"><link rel="stylesheet" href="workspace-theme-header.css?v=20260918-2"><link rel="stylesheet" href="connections-theme.css?v=20260919-1"><script src="shared-settings.js?v=20260922-dialogs-1"></script></head>
<body>
<header><div class="brand"><span>Q</span><div><strong>Sources</strong><small>QReports data sources and secrets</small></div></div><nav>
<button data-action="new">＋ New</button><button class="primary" data-action="save">Save</button><button data-action="test">Test</button><button data-action="template">Add template</button><button data-action="export">Export file</button><button data-action="secrets">Secrets</button><button data-action="close">Close</button>
</nav></header>
<main><aside><div class="aside-head"><div><h2>Sources</h2><p>Saved for the current QReports installation.</p></div><input id="search" placeholder="Search"></div><div id="connectionList" class="connection-list"></div></aside>
<section class="editor"><div class="editor-head"><div><h1 id="editorTitle">New source</h1><p>Configure a database, file, or API source.</p></div><span id="status" class="status">Ready</span></div>
<div class="summary-grid"><label>Name<input id="name" autocomplete="off"></label><label>Type<select id="type"><option>SQL</option><option>MYSQL</option><option>SNOWFLAKE</option><option>API</option><option>EXCEL</option><option>CSV</option><option>TEXT</option></select></label><label>Order<input id="order" type="number" value="0"></label></div>
<div class="tabs"><button class="active" data-tab="manual">Connection string</button><button data-tab="structured">Structured details</button></div>
<div id="manualPanel" class="panel"><label id="detailsLabel">Connection string<textarea id="details" rows="10" spellcheck="false"></textarea></label><p class="help">Secrets can be referenced as <code>{{secret:my_key}}</code>.</p></div>
<div id="structuredPanel" class="panel hidden"><div id="databaseFields" class="form-grid"><label>Server / account<input id="server"></label><label>Port<input id="port" type="number"></label><label>Database<input id="database"></label><label>Driver<select id="driver"><option>System.Data.SqlClient</option><option>SQL Server - Windows authentication</option><option>MySQL Connector/NET</option><option>Snowflake .NET Connector</option></select></label><label>User ID<input id="user"></label><label>Password or secret token<input id="password" type="password"></label><label class="check"><input id="encrypt" type="checkbox"> Encrypt connection</label><label class="check"><input id="trust" type="checkbox"> Trust server certificate</label></div>
<div id="fileFields" class="form-grid hidden"><label class="wide">Source file<div class="input-button"><input id="filePath"><button data-action="browse">Browse…</button></div></label><label id="delimiterLabel">Delimiter<input id="delimiter" value=","></label><label>Encoding<select id="encoding"><option>UTF-8</option><option>UTF-16</option><option>Windows-1252</option><option>ISO-8859-1</option></select></label><label class="check"><input id="hasHeaders" type="checkbox" checked> First row contains headers</label></div>
<div id="apiFields" class="form-grid hidden"><label class="wide">Base URL<input id="apiUrl" placeholder="https://api.example.com/"></label><label class="wide">Comment<textarea id="apiComment" rows="3" placeholder="Purpose, owner, documentation links, or usage notes"></textarea></label><label>Authentication<select id="apiAuth"><option value="None">None</option><option value="BearerToken">Bearer token</option><option value="BearerTokenWorkflow">Bearer token workflow</option><option value="ApiKey">API key</option><option value="AzureFunctionKey">Azure Function key</option><option value="Basic">Basic authentication</option></select></label><label>Secret reference<input id="apiSecret" placeholder="{{secret:api_token}}"></label></div>
<div class="panel-actions"><button data-action="applyStructured" class="primary">Apply to connection string</button></div></div>
<div class="danger-zone"><button class="danger" data-action="delete">Delete source</button></div>
</section></main>
<div id="secretModal" class="modal hidden"><div class="modal-card"><div class="modal-head"><div><h2>QReports secrets</h2><p>Values are encrypted or obfuscated by the existing SecretManager.</p></div><button data-action="closeSecrets">×</button></div><div class="secret-layout"><div><div class="secret-toolbar"><button data-action="newSecret">＋ Add secret</button></div><div id="secretList" class="secret-list"></div></div><form id="secretForm" class="secret-editor"><h3 id="secretTitle">Create secret</h3><label>Key<input id="secretKey" pattern="[A-Za-z0-9_.-]+"></label><label>Scope<select id="secretScope"><option value="private">Private — current Windows user</option><option value="shared">Shared — company settings</option></select></label><label>Value<div class="input-button"><input id="secretValue" type="password"><button type="button" data-action="showSecret">Show</button></div></label><p>Token: <code id="secretToken">{{secret:key}}</code></p><div class="form-actions"><button type="submit" class="primary">Save secret</button><button type="button" class="danger" data-action="deleteSecret">Delete</button></div></form></div></div></div>
<div id="toast" class="toast hidden"></div><script src="connections.js?v=20260922-dialogs-1"></script></body></html>
