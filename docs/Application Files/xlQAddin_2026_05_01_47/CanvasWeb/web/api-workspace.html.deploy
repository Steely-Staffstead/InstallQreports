<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QReports API workspace</title><link rel="stylesheet" href="api-workspace.css?v=20260901-1"><link rel="stylesheet" href="api-workspace-overrides.css?v=20260903-1"><link rel="stylesheet" href="api-workspace-enhancements.css?v=20260922-1"><link rel="stylesheet" href="api-workspace-query-integration.css?v=20260907-1"><link rel="stylesheet" href="workspace-theme-header.css?v=20260918-2"><script src="shared-settings.js?v=20260922-dialogs-1"></script></head><body>
<header><div class="brand"><span>Q</span><div><strong>API workspace</strong><small>Build, test and save data-source requests</small></div></div><nav><button id="newRequest">＋ New</button><button id="saveEndpoint">Save API</button><button id="secrets">Secrets</button><button id="run" class="run">▶ Send</button><button id="returnExcel" class="primary">Return to Excel</button><button id="close">Close</button></nav></header>
<main id="workspaceMain"><aside id="library"><div class="pane-title"><div><h2>Saved APIs</h2><p>Connections and endpoints</p></div><div class="pane-title-actions"><button id="collapseLeft" title="Hide saved APIs">‹</button><button id="reload">↻</button></div></div><input id="search" placeholder="Search APIs"><div id="libraryList"></div></aside><div id="leftResize" class="pane-resizer" title="Resize sources pane"></div><section class="workspace">
<div class="request-line"><select id="method"><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option></select><select id="connection"></select><input id="path" placeholder="/v1/resources"><span id="status">Ready</span></div>
<div class="tabs" id="requestTabs"><button class="active" data-panel="params">Parameters</button><button data-panel="body">Body</button><button data-panel="auth">Authentication</button><button data-panel="paging">Pagination & loop</button><button data-panel="shape">Response shape</button></div>
<div class="request-panels"><section id="params" class="panel active"><div class="split"><div><h3>Query parameters</h3><div id="queryRows" class="kv"></div><button data-add="queryRows">＋ Add query parameter</button></div><div><h3>Headers</h3><div id="headerRows" class="kv"></div><button data-add="headerRows">＋ Add header</button></div></div></section>
<section id="body" class="panel"><div class="form-row"><label>Body type<select id="bodyMode"><option value="0">None</option><option value="1">Raw</option><option value="2">GraphQL</option><option value="3">Form URL encoded</option></select></label><label>Raw format<select id="rawFormat"><option value="0">JSON</option><option value="1">Text</option><option value="2">XML</option><option value="3">JavaScript</option></select></label><label>Content type<input id="contentType" value="application/json"></label></div><div id="rawBody"><textarea id="bodyText" class="code" spellcheck="false" placeholder="Request body"></textarea></div><div id="graphBody" class="hidden split"><label>GraphQL query<textarea id="graphql" class="code"></textarea></label><label>Variables JSON<textarea id="variables" class="code"></textarea></label></div><div id="formBody" class="hidden"><div id="formRows" class="kv"></div><button data-add="formRows">＋ Add field</button></div></section>
<section id="auth" class="panel"><div class="form-grid"><label>Authentication<select id="authKind"><option value="0">None</option><option value="1">API key</option><option value="2">Azure Function key</option><option value="3">Bearer token</option><option value="4">Bearer token workflow</option><option value="5">Basic authentication</option></select></label><label>Secret reference<input id="secretRef" placeholder="Generated automatically"></label><label>Key / header name<input id="keyName"></label><label>Key location<select id="keyLocation"><option value="0">Header</option><option value="1">Query parameter</option></select></label></div><div id="simpleCredentials" class="credential-card"><h3>Secure credentials</h3><p>Values are saved through QReports SecretManager. Leave blank to keep an existing value.</p><div class="form-grid"><label id="singleSecretLabel">Secret value<input id="singleSecretValue" type="password" autocomplete="new-password"></label><label>Basic username<input id="basicSecretUsername" autocomplete="off"></label><label>Basic password<input id="basicSecretPassword" type="password" autocomplete="new-password"></label></div></div><details id="workflow"><summary>Token workflow</summary><div class="form-grid"><label>Request mode<select id="wfRequestMode"><option value="0">OAuth form fields</option><option value="1">API request JSON</option></select></label><label>Token URL<input id="tokenUrl"></label><label>Grant type<select id="grantType"><option value="0">Client credentials</option><option value="1">Password</option></select></label><label>Scope<input id="scope"></label><label>Audience<input id="audience"></label><label>Token JSON path<input id="tokenPath" value="access_token"></label><label>Expiry JSON path<input id="expiresPath" value="expires_in"></label><label>Workflow secret reference<input id="workflowSecretRef" placeholder="Generated automatically"></label><label>Apply token as<select id="applyMode"><option value="0">Bearer header</option><option value="1">Basic auth password</option><option value="2">Custom header</option><option value="3">Query parameter</option><option value="4">Raw authorization header</option></select></label><label>Output header<input id="outputHeader" value="Authorization"></label><label>Output prefix<input id="outputPrefix" value="Bearer "></label><label>Output query name<input id="outputQuery"></label><label>Basic username<input id="basicUsername"></label><label class="wide">Token request JSON<textarea id="requestSpec" class="code"></textarea></label></div><div class="credential-card"><h3>Workflow credentials</h3><p>Stored as one protected SecretManager value. Leave blank to preserve existing credentials.</p><div class="form-grid"><label>Client ID<input id="clientId"></label><label>Client secret<input id="clientSecret" type="password"></label><label>Username<input id="workflowUsername"></label><label>Password<input id="workflowPassword" type="password"></label></div></div><div class="split"><div><h3>Extra form fields</h3><div id="workflowParamRows" class="kv"></div><button data-add="workflowParamRows">＋ Add form field</button></div><div><h3>Extra token headers</h3><div id="workflowHeaderRows" class="kv"></div><button data-add="workflowHeaderRows">＋ Add header</button></div></div><button id="testToken">Test token workflow</button></details></section>
<section id="paging" class="panel"><div class="form-grid"><label class="check"><input id="pagingEnabled" type="checkbox"> Enable pagination</label><label>Type<select id="pagingType"><option value="0">None</option><option value="1">Next link / OData</option><option value="2">Offset</option></select></label><label>Data property<input id="dataProperty"></label><label>Next-link property<input id="nextLink" value="@odata.nextLink"></label><label>Offset parameter<input id="offsetParam" value="skip"></label><label>Limit parameter<input id="limitParam" value="first"></label><label>Start offset<input id="startOffset" type="number" value="0"></label><label>Page size<input id="pageSize" type="number" value="100"></label><label>Maximum pages<input id="maxPages" type="number" value="100"></label><label class="check"><input id="loopEnabled" type="checkbox"> Enable request loop</label><label>Loop connection<input id="loopConnection"></label><label class="wide">Loop query<div class="loop-query-control"><textarea id="loopQuery" class="code"></textarea><button id="designLoopQuery" type="button">Design…</button></div></label><label>Value column<input id="loopColumn"></label><label>Replacement token<input id="loopToken" value="value"></label><label>Maximum requests<input id="maxRequests" type="number" value="0"></label><label>Delay (ms)<input id="delayMs" type="number" value="0"></label></div></section>
<section id="shape" class="panel"><div class="form-grid">
<label title="Choose the JSON array that represents rows. CSV is already tabular and does not need a flatten path.">Array / flatten path (JSON only)<div class="input-button"><input id="flattenPath" value="value"><button id="pickPath">Choose…</button></div></label>
<label>Maximum rows<input id="maxRows" type="number" value="1000"></label>
<label class="wide" title="Applied to the tabular result for both JSON and CSV. Example: Amount > 0">Post-filter expression<textarea id="postFilter" placeholder="Example: Amount > 0"></textarea></label>
<label class="wide" title="One column per line. Existing comma-separated lists also work; quote column names that contain commas.">Excluded columns (one per line)<textarea id="excluded" rows="2"></textarea></label>
<label class="wide" title="One source=alias pair per line. Source names may contain commas.">Column aliases (one source=alias per line)<textarea id="aliases" rows="3" placeholder="customer.name=Customer&#10;amount=Revenue"></textarea></label>
</div></section></div>
<div id="responseResize" class="horizontal-resizer" title="Resize request and response"></div><div class="response-head"><div class="tabs" id="responseTabs"><button class="active" data-response="grid">Data</button><button data-response="raw">Raw response</button><button data-response="submitted">Submitted request</button><button data-response="jsonRequest">JSON request</button></div><div class="response-actions"><span id="responseSummary">No request sent</span></div></div><div class="response"><div id="grid" class="response-panel active"></div><pre id="raw" class="response-panel"></pre><pre id="submitted" class="response-panel"></pre><div id="jsonRequest" class="response-panel"><div class="json-request-actions"><button id="manualJson" type="button" title="Edit the generated request specification directly">Manual JSON: off</button></div><pre id="jsonRequestEditor" class="code" spellcheck="false"></pre></div></div>
</section><div id="rightResize" class="pane-resizer" title="Resize details pane"></div><aside id="inspector"><div class="pane-title"><h2>API details</h2><button id="collapseRight" title="Hide API details">›</button></div><label>Connection name<input id="connectionName"></label><label>Base URL<input id="baseUrl" placeholder="https://api.example.com"></label><label>Timeout seconds<input id="timeout" type="number" value="100"></label><div class="connection-actions"><button id="newConnection">＋ New connection</button><button id="saveConnection" class="primary">Save connection</button></div><label>Saved API name<input id="endpointName" value="AdhocEndpoint"></label><div class="connection-actions"><button id="duplicateEndpoint">Duplicate API</button><button id="moveEndpoint" title="Choose the destination in the connection dropdown, then click this button.">Move to selected connection</button></div><label title="Headers sent with every API definition using this connection. Example: Accept, User-Agent, or an API version header. Secrets should use Authentication instead.">Default headers (JSON)<textarea id="defaultHeaders" class="code">{}</textarea></label><div class="danger"><button id="deleteEndpoint">Delete API</button><button id="deleteConnection">Delete connection</button></div></aside></main>
<button id="formatBody" class="hidden" aria-hidden="true" tabindex="-1"></button><div id="pathModal" class="modal hidden"><div class="modal-card path-card"><div class="modal-head"><div><h2>Choose flatten path and columns</h2><p>Select the array that represents rows, then choose which fields to include.</p></div><button id="closePath">×</button></div><div id="pathList" class="path-tree"></div><div class="modal-actions"><button id="applyPath" class="primary">Apply selection</button><button id="cancelPath">Cancel</button></div></div></div><div id="columnMenu" class="context-menu hidden"></div><div id="toast"></div><script src="api-workspace.js?v=20260922-dialogs-1"></script><script src="api-manual-json.js?v=20260922-1"></script><script src="api-workspace-query-integration.js?v=20260913-6"></script></body></html>
