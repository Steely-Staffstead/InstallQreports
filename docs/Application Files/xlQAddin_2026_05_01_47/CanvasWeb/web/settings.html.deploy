<!doctype html><html lang="en"><head><meta charset="utf-8"><title>QReports settings</title><script src="shared-settings.js?v=20260922-dialogs-1"></script></head><body><header><h1>QReports settings</h1></header><p>Settings apply to QReports web forms launched from Canvas, Excel, and PowerPoint.</p><script>if(window.chrome?.webview){chrome.webview.addEventListener('message',event=>{if(event.data.type==='sharedSettings'&&!event.data.saved)requestAnimationFrame(()=>QReportsSettings.open());});chrome.webview.postMessage({type:'ready'});}else document.addEventListener('DOMContentLoaded',()=>QReportsSettings.open());</script></body></html>
