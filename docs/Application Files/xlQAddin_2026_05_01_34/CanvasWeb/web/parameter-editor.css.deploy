.pw-overlay{position:fixed;inset:0;z-index:12000;background:rgba(15,23,42,.48);backdrop-filter:blur(3px);display:grid;place-items:center;padding:24px}.pw-dialog{width:min(1100px,96vw);height:min(760px,94vh);background:#f8fafc;border:1px solid #cbd5e1;border-radius:18px;box-shadow:0 28px 80px rgba(15,23,42,.3);display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;color:#17213a}.pw-dialog.input{width:min(720px,94vw);height:auto;max-height:92vh}.pw-head{background:#243154;color:white;padding:18px 24px;display:flex;align-items:center;gap:14px}.pw-head h2{font-size:20px;margin:0}.pw-head p{margin:2px 0 0;color:#cbd5e1}.pw-head .pw-close{margin-left:auto;color:white;background:transparent;border:1px solid #7180a5;width:40px;height:40px;font-size:22px}.pw-body{min-height:0;display:grid;grid-template-columns:290px 1fr}.pw-input-body{overflow:auto;padding:22px 26px}.pw-sidebar{border-right:1px solid #dbe2ec;background:white;padding:18px;overflow:auto}.pw-list{display:grid;gap:7px;margin:14px 0}.pw-item{display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:7px;padding:10px;border:1px solid #dbe2ec;border-radius:10px;background:white;cursor:pointer}.pw-item.active{border-color:#6686ee;background:#eef2ff}.pw-grip{cursor:grab;color:#718096;font-size:17px}.pw-item small{display:block;color:#718096}.pw-tools{display:flex;gap:7px;flex-wrap:wrap}.pw-tools button{padding:7px 10px}.pw-properties{padding:22px 26px;overflow:auto}.pw-section{background:white;border:1px solid #dbe2ec;border-radius:12px;padding:17px;margin-bottom:14px}.pw-section h3{font-size:14px;text-transform:uppercase;letter-spacing:.06em;color:#53617b;margin:0 0 14px}.pw-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.pw-grid .wide{grid-column:1/-1}.pw-dialog label{display:grid;gap:6px;color:#53617b;font-size:13px}.pw-dialog input,.pw-dialog select,.pw-dialog textarea{box-sizing:border-box;width:100%;border:1px solid #cbd5e1;border-radius:8px;background:white;padding:9px 10px;color:#17213a;font:inherit}.pw-dialog textarea{resize:vertical}.pw-check{display:flex!important;align-items:center;gap:8px;color:#27334e!important}.pw-check input{width:auto}.pw-foot{display:flex;align-items:center;gap:10px;padding:14px 20px;border-top:1px solid #dbe2ec;background:white}.pw-foot .spacer{flex:1}.pw-primary{background:#5274df!important;color:white!important;border-color:#5274df!important}.pw-danger{color:#a13c3c}.pw-error{color:#b42318;min-height:18px}.pw-input-row{background:white;border:1px solid #dbe2ec;border-radius:12px;padding:15px 17px;margin-bottom:12px}.pw-input-row>label>span{font-weight:650;color:#27334e;font-size:14px}.pw-help{color:#718096;font-size:12px;margin:5px 0 0}.pw-multi{max-height:190px;overflow:auto;border:1px solid #dbe2ec;border-radius:8px;padding:7px}.pw-multi label{display:flex;align-items:center;gap:8px;padding:6px}.pw-multi input{width:auto}.pw-empty{text-align:center;color:#718096;padding:36px}.pw-hidden{display:none!important}@media(max-width:760px){.pw-overlay{padding:6px}.pw-dialog{height:98vh}.pw-body{grid-template-columns:1fr}.pw-sidebar{max-height:220px;border-right:0;border-bottom:1px solid #dbe2ec}.pw-grid{grid-template-columns:1fr}.pw-grid .wide{grid-column:auto}}
