const $ = id => document.getElementById(id);
let query = { connectionName:"", queryText:"", previewLimit:1000, measures:[], parameters:[], data:{ columns:[], rows:[] } };
let tables = [], joinTables = [], joins = [], autocompleteItems = [], autocompleteIndex = 0, selectedTable = null;
const expandedTables = new Set(), pending = new Map(), parameterLookups = new Map();
const sourceSelections = new Map();
let resultView = { data:{columns:[],rows:[]}, sortIndex:-1, sortDirection:0, hidden:new Set(), formats:new Map(), widths:new Map() };
let resultMode="grid", parsedSql="", resultMessage="";
let editState=null;
let activeFilter=null,filterChoices=[],filterPending=new Set();
const actions = { queryConnections:"query-connections", querySchema:"query-schema", queryRun:"query-run", queryParse:"query-parse", queryFunctions:"query-functions", queryStatistics:"query-statistics", queryEditLoad:"query-edit-load", queryEditSave:"query-edit-save" };

function call(type, payload = {}) {
  return new Promise((resolve, reject) => {
    const action = actions[type];
    pending.set(action, { resolve, reject });
    chrome.webview.postMessage({ type, ...payload });
  });
}
function toast(text) { const e=$("toast"); e.textContent=text; e.classList.remove("hidden"); clearTimeout(toast.t); toast.t=setTimeout(()=>e.classList.add("hidden"),3500); }
function showResultError(error,context="Query failed"){const detail=error?.message||String(error||"Unknown error"),connection=$("connection")?.value||query.connectionName||"(not selected)",sql=$("queryText")?.value||query.queryText||"";resultMessage=`${context}\n\n${detail}\n\nConnection: ${connection}${sql?`\n\nSQL:\n${sql}`:""}`;resultMode="messages";$("queryStatus").textContent="Error";$("resultSummary").textContent=context;applyResultMode();}
function esc(value) { return String(value ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function tableKey(table) { return `${table.schema || ""}.${table.name}`.toLowerCase(); }
function qualifiedName(table) { return table.schema ? `${table.schema}.${table.name}` : table.name; }
function isExcelTableSource(){const select=$("connection"),option=select?.selectedOptions?.[0],value=String(select?.value||query.connectionName||"").toLowerCase(),label=String(option?.textContent||"").toLowerCase();return value==="table"||label.includes("excel table")||label.includes("workbook table");}
function quoteSqlIdentifier(name){const text=String(name??"");return isExcelTableSource()?text:`[${text.replace(/]/g,"]]" )}]`;}
function sqlName(table){if(isExcelTableSource())return table.name;return table.schema?`${quoteSqlIdentifier(table.schema)}.${quoteSqlIdentifier(table.name)}`:quoteSqlIdentifier(table.name);}
function sqlColumn(name){return isExcelTableSource()?name:quoteSqlIdentifier(name);}
function sourceState(table) { const key=tableKey(table); if(!sourceSelections.has(key))sourceSelections.set(key,{selected:new Set(),filters:new Map(),aliases:[]}); const state=sourceSelections.get(key);state.aliases||=[];return state; }
function tableAliases(table){return sourceState(table).aliases.filter(Boolean);}
function primaryAlias(table){return tableAliases(table)[0]||"";}
function aliasedColumn(table,column){const alias=primaryAlias(table);return `${alias?`${alias}.`:""}${sqlColumn(column)}`;}
function aliasedTable(table){const alias=primaryAlias(table);return `${sqlName(table)}${alias?` ${alias}`:""}`;}

async function loadConnections() {
  const result = await call("queryConnections");
  $("connection").innerHTML = (result.connections || []).map(c => `<option value="${esc(c.name)}">${esc(c.name)} — ${esc(c.type || c.kind)}</option>`).join("");
  if (query.connectionName) $("connection").value = query.connectionName;
  if (!$("connection").value && $("connection").options.length) $("connection").selectedIndex = 0;
  query.connectionName = $("connection").value;
  await loadSchema();
}
async function loadSchema() {
  query.connectionName = $("connection").value;
  $("schema").innerHTML = '<p class="muted">Loading tables and views…</p>';
  expandedTables.clear();
  try {
    const result = await call("querySchema", { connectionName:query.connectionName });
    tables = (result.tables || []).sort((left,right)=>qualifiedName(left).localeCompare(qualifiedName(right),undefined,{sensitivity:"base"}));
    renderSchema();
  } catch (error) { $("schema").innerHTML = `<p class="muted">${esc(error.message)}</p>`; showResultError(error,"Could not load tables and views"); }
}
async function ensureColumns(table) {
  if (table.columnsLoaded) return table.columns || [];
  if (table.columnPromise) return table.columnPromise;
  table.loading = true; renderSchema();
  table.columnPromise = (async () => {
    const result = await call("querySchema", { connectionName:query.connectionName, tableName:table.name, schemaName:table.schema || "" });
    table.columns = result.columns || [];
    table.columnsLoaded = true;
    return table.columns;
  })();
  try { return await table.columnPromise; }
  finally { table.loading = false; table.columnPromise = null; renderSchema(); }
}
function renderSchema() {
  const search = $("schemaSearch").value.trim().toLowerCase();
  const visible = tables.filter(table => !search || qualifiedName(table).toLowerCase().includes(search) || (table.columnsLoaded && (table.columns || []).some(column => column.name.toLowerCase().includes(search))));
  $("schema").innerHTML = visible.map(table => {
    const key=tableKey(table), expanded=expandedTables.has(key), columns=table.columns || [], isView=/view/i.test(table.type||"");
    const state=sourceState(table);
    const aliases=tableAliases(table),aliasLabel=aliases.length?`${aliases[0]}${aliases.length>1?"+":""}`:"";
    return `<div class="table-node" data-key="${esc(key)}"><div class="table-title"><span>${esc(qualifiedName(table))}</span><span class="table-title-actions">${isView?'<span class="table-kind" title="View">V</span>':""}${aliasLabel?`<b class="table-alias" title="${esc(aliases.join(", "))}">${esc(aliasLabel)}</b>`:""}<span>${table.loading ? "…" : expanded ? "−" : "+"}</span></span></div>${expanded ? `<div class="columns">${columns.map((column,index)=>`<div class="column" data-column="${index}"><input type="checkbox" data-select-column="${index}" ${state.selected.has(index)?"checked":""}><span>${esc(column.name)}</span><small>${esc(column.type)}</small><span class="column-filter-wrap"><input class="column-filter" data-filter-column="${index}" value="${esc(state.filters.get(index)||"")}" placeholder="Filter"><button data-filter-pick="${index}" title="Choose distinct values">…</button></span></div>`).join("") || '<div class="column muted">No columns found</div>'}<div class="source-actions"><button data-source-query="add">Selected → query</button><button data-source-preview>View top</button></div></div>` : ""}</div>`;
  }).join("") || '<p class="muted">No tables or views found.</p>';
  document.querySelectorAll(".table-node").forEach(node => {
    const table = tables.find(item => tableKey(item) === node.dataset.key);
    const title = node.querySelector(".table-title");
    title.onclick = async () => {
      if (expandedTables.has(node.dataset.key)) expandedTables.delete(node.dataset.key);
      else { try { await ensureColumns(table); expandedTables.add(node.dataset.key); } catch(error) { toast(error.message || String(error)); } }
      renderSchema(); selectItem(table);
    };
    title.ondblclick = async event => { event.preventDefault(); await addJoinTable(table); };
    title.oncontextmenu = event => { event.preventDefault(); showTableMenu(event,table); };
    node.querySelectorAll(".column[data-column]").forEach(element => {
      element.onclick = event => { if(event.target.matches("input"))return; event.stopPropagation(); selectItem(table, table.columns[+element.dataset.column]); };
      element.oncontextmenu = event => { event.preventDefault(); event.stopPropagation(); showSourceColumnMenu(event,table,+element.dataset.column); };
    });
    node.querySelectorAll("[data-select-column]").forEach(input=>input.onchange=()=>{const index=+input.dataset.selectColumn;input.checked?sourceState(table).selected.add(index):sourceState(table).selected.delete(index);});
    node.querySelectorAll("[data-filter-column]").forEach(input=>{input.onclick=event=>event.stopPropagation();input.oninput=()=>{const index=+input.dataset.filterColumn,value=input.value.trim();value?sourceState(table).filters.set(index,value):sourceState(table).filters.delete(index);};});
    node.querySelectorAll("[data-filter-pick]").forEach(button=>button.onclick=async event=>{event.stopPropagation();await openFilterPicker(table,+button.dataset.filterPick);});
    node.querySelectorAll("[data-source-query]").forEach(button=>button.onclick=async event=>{event.stopPropagation();await setSourceQuery(table,false);});
    node.querySelectorAll("[data-source-preview]").forEach(button=>button.onclick=async event=>{event.stopPropagation();await previewSelected(table);});
  });
}
function selectItem(table, column) {
  selectedTable = table;
  $("tableStats").disabled = false;
  $("selectionHelp").classList.add("hidden");
  const label = column ? column.name : qualifiedName(table);
  $("selectionInfo").innerHTML = `<div class="selection-card"><b>${esc(label)}</b><p>${column ? esc(column.type) : table.columnsLoaded ? `${(table.columns||[]).length} columns` : "Columns load when opened"}</p><button data-insert="${esc(label)}">Insert into SQL</button></div>`;
  document.querySelector("[data-insert]").onclick = () => insertSql(column ? aliasedColumn(table,column.name) : aliasedTable(table));
}
function insertSql(text) { const editor=$("queryText"), position=editor.selectionStart; editor.value=editor.value.slice(0,position)+text+editor.value.slice(editor.selectionEnd); editor.focus(); editor.selectionStart=editor.selectionEnd=position+text.length; hideAutocomplete(); highlightSql(); }
function replaceSql(text){$("queryText").value=text;highlightSql();$("queryText").focus();}
function isNumericColumn(column){return /int|decimal|numeric|number|double|single|float|real|currency/i.test(column?.type||"")}function sqlLiteral(value,column){const text=String(value??'').trim();if(/^null$/i.test(text))return'NULL';if(/^-?\d+(?:[.,]\d+)?$/.test(text))return text.replace(',','.');if(/^'.*'$/.test(text))return text;return`'${text.replace(/'/g,"''")}'`}function filterExpression(value,column){const text=String(value||'').trim();if(!text)return'';if(/^not\s+null$/i.test(text))return'IS NOT NULL';if(/^null$/i.test(text))return'IS NULL';let m=text.match(/^between\s+(.+?)\s+and\s+(.+)$/i);if(m)return`BETWEEN ${sqlLiteral(m[1],column)} AND ${sqlLiteral(m[2],column)}`;m=text.match(/^(-?\d+(?:\.\d+)?)\s*-\s*(-?\d+(?:\.\d+)?)$/);if(m)return`BETWEEN ${m[1]} AND ${m[2]}`;if(/^in\s*\(/i.test(text)){const inner=text.replace(/^in\s*\(|\)\s*$/gi,'');return`IN (${inner.split(',').map(x=>sqlLiteral(x,column)).join(', ')})`}if(text.includes('|'))return`IN (${text.split('|').map(x=>sqlLiteral(x,column)).join(', ')})`;m=text.match(/^(<>|!=|>=|<=|>|<|=)\s*(.+)$/);if(m)return`${m[1]} ${sqlLiteral(m[2],column)}`;m=text.match(/^like\s+(.+)$/i);if(m)return`LIKE ${sqlLiteral(m[1],column)}`;if(text.includes('*')||text.includes('%'))return`LIKE ${sqlLiteral(text.replace(/\*/g,'%'),column)}`;return`= ${sqlLiteral(text,column)}`}function filterClause(table){const state=sourceState(table),parts=[];for(const [index,value] of state.filters){const column=table.columns?.[index],expression=filterExpression(value,column);if(column&&expression)parts.push(`${aliasedColumn(table,column.name)} ${expression}`)}return parts.length?`\nWHERE ${parts.join("\n  AND ")}`:"";}
function sourceSelectSql(table,top=false){const state=sourceState(table),indexes=state.selected.size?[...state.selected].sort((a,b)=>a-b):(table.columns||[]).map((_,index)=>index),fields=indexes.map(index=>table.columns[index]?.name).filter(Boolean).map(name=>aliasedColumn(table,name));return `SELECT ${top?"TOP 100 ":""}${fields.length?fields.join(",\n       "):primaryAlias(table)?`${primaryAlias(table)}.*`:"*"}\nFROM ${aliasedTable(table)}${filterClause(table)}`;}
async function setSourceQuery(table,top=false){await ensureColumns(table);replaceSql(sourceSelectSql(table,top));}
async function previewSelected(table){await ensureColumns(table);$("queryStatus").textContent="Previewing selection…";const previewQuery={...query,connectionName:$("connection").value,queryText:sourceSelectSql(table,true),previewLimit:100};try{const result=await call("queryRun",{query:previewQuery});renderResult(result.data,true,`Preview: ${qualifiedName(table)}`);$("queryStatus").textContent="Ready";}catch(error){showResultError(error,`Could not preview ${qualifiedName(table)}`);}}
async function addSourceFields(table){await ensureColumns(table);const state=sourceState(table),indexes=state.selected.size?[...state.selected].sort((a,b)=>a-b):(table.columns||[]).map((_,index)=>index),fields=indexes.map(index=>table.columns[index]?.name).filter(Boolean).map(name=>aliasedColumn(table,name));if(!fields.length)return toast("Select at least one field");insertSql(fields.join(",\n       "));}
function showContextMenu(event,html,wire){const menu=$("contextMenu");menu.innerHTML=html;menu.style.left=`${Math.min(event.clientX,window.innerWidth-240)}px`;menu.style.top=`${Math.min(event.clientY,window.innerHeight-300)}px`;menu.classList.remove("hidden");wire?.(menu);}
function hideContextMenu(){$("contextMenu").classList.add("hidden");}
function pointerDrag(event,onMove,onEnd=()=>{}){if(event.button!==0)return;event.preventDefault();let active=true;const move=e=>{if(active&&e.buttons===1)onMove(e);else if(active&&e.buttons===0)finish();};const finish=()=>{if(!active)return;active=false;window.removeEventListener("pointermove",move,true);window.removeEventListener("pointerup",finish,true);window.removeEventListener("pointercancel",finish,true);window.removeEventListener("blur",finish,true);onEnd();};window.addEventListener("pointermove",move,true);window.addEventListener("pointerup",finish,true);window.addEventListener("pointercancel",finish,true);window.addEventListener("blur",finish,true);}
async function previewTable(table){$("queryStatus").textContent="Previewing table…";const previewQuery={...query,connectionName:$("connection").value,queryText:`SELECT *\nFROM ${sqlName(table)}`,previewLimit:100};try{const result=await call("queryRun",{query:previewQuery});renderResult(result.data,true,`Preview: ${qualifiedName(table)}`);$("queryStatus").textContent="Ready";}catch(error){showResultError(error,`Could not preview ${qualifiedName(table)}`);}}
async function openFilterPicker(table,index){const column=table.columns[index],base={...query,connectionName:$("connection").value,previewLimit:1000};$("queryStatus").textContent="Loading filter values…";try{let result=await call("queryRun",{query:{...base,queryText:`SELECT DISTINCT ${sqlColumn(column.name)}\nFROM ${sqlName(table)}\nORDER BY ${sqlColumn(column.name)}`}}),columns=result.data?.columns||[],rows=result.data?.rows||[];if(!rows.length){result=await call("queryRun",{query:{...base,queryText:`SELECT ${sqlColumn(column.name)}\nFROM ${sqlName(table)}`}});columns=result.data?.columns||[];rows=result.data?.rows||[]}filterChoices=[...new Map(rows.map(row=>{const value=rowValues(row,columns)[0];return[String(value??''),value]})).values()].sort((a,b)=>String(a??'').localeCompare(String(b??''),undefined,{numeric:true,sensitivity:'base'}));activeFilter={table,index,column};filterPending=new Set(selectedFilterTokens().map(String));$("filterTitle").textContent=`Filter: ${column.name}`;$("filterSearch").value='';renderFilterChoices();$("filterModal").classList.remove("hidden");requestAnimationFrame(()=>$("filterSearch").focus());$("queryStatus").textContent="Ready"}catch(error){$("queryStatus").textContent="Error";toast(error.message||String(error))}}
function selectedFilterTokens(){const existing=sourceState(activeFilter.table).filters.get(activeFilter.index)||'';if(/^in\s*\(/i.test(existing))return existing.replace(/^in\s*\(|\)\s*$/gi,'').split(',').map(x=>x.trim().replace(/^'|'$/g,'')).filter(Boolean);return existing.includes('|')?existing.split('|').map(x=>x.trim()):[]}
function renderFilterChoices(){if(!activeFilter)return;const search=$("filterSearch").value.toLowerCase();const visible=filterChoices.filter(value=>!search||String(value??'').toLowerCase().includes(search));$("filterValues").innerHTML=visible.map((value,index)=>`<label><input type="checkbox" data-filter-value="${index}" data-raw-index="${filterChoices.indexOf(value)}" ${filterPending.has(String(value??''))?'checked':''}> <span>${esc(value==null?'(null)':value)}</span></label>`).join('')||'<p class="muted">No matching values.</p>';$("filterValues").querySelectorAll('[data-filter-value]').forEach(input=>input.onchange=()=>{const value=String(filterChoices[+input.dataset.rawIndex]??'');input.checked?filterPending.add(value):filterPending.delete(value);renderFilterSelectAll()});renderFilterSelectAll()}
function renderFilterSelectAll(){$("filterSelectAll").checked=$("filterValues").querySelectorAll('[data-filter-value]').length>0&&$("filterValues").querySelectorAll('[data-filter-value]:not(:checked)').length===0}
function applyPickedFilter(){if(!activeFilter)return;const state=sourceState(activeFilter.table);if(filterPending.size)state.filters.set(activeFilter.index,[...filterPending].join('|'));else state.filters.delete(activeFilter.index);$("filterModal").classList.add("hidden");renderSchema()}
function showTableMenu(event,table){const state=sourceState(table);showContextMenu(event,`<div class="menu-title">${esc(qualifiedName(table))}</div><label>Aliases <input data-table-aliases value="${esc(state.aliases.join(", "))}" placeholder="t, previous"></label><button data-table-action="aliases">Set aliases</button><hr><button data-table-action="edit">Edit table data</button><button data-table-action="top">View top 100 records</button><button data-table-action="columns">Select columns into query</button><button data-table-action="select">Select * into query</button><button data-table-action="insert">Insert table name into query</button>`,menu=>menu.querySelectorAll("[data-table-action]").forEach(button=>button.onclick=async()=>{const action=button.dataset.tableAction;if(action==="aliases"){const raw=menu.querySelector("[data-table-aliases]").value,state=sourceState(table),aliases=[...new Set(raw.split(/[,;\s]+/).map(value=>value.trim()).filter(Boolean))];if(aliases.some(alias=>!/^[A-Za-z_][A-Za-z0-9_]*$/.test(alias)))return toast("Aliases must start with a letter or underscore and contain only letters, numbers, or underscores");state.aliases=aliases;hideContextMenu();renderSchema();return;}hideContextMenu();if(action==="insert")insertSql(aliasedTable(table));else if(action==="top")await previewTable(table);else if(action==="columns")await setSourceQuery(table,false);else if(action==="edit"){replaceSql(`SELECT TOP ${Number($("previewLimit").value)||5000} *\nFROM ${sqlName(table)}`);await loadEditable();}else replaceSql(`SELECT ${primaryAlias(table)?`${primaryAlias(table)}.*`:"*"}\nFROM ${aliasedTable(table)}`);}));}
function showSourceColumnMenu(event,table,index){const column=table.columns[index],state=sourceState(table);showContextMenu(event,`<div class="menu-title">${esc(column.name)}</div><label><input type="checkbox" data-column-check ${state.selected.has(index)?"checked":""}> Include in generated SELECT</label><button data-column-action="insert">Insert column name</button><button data-column-action="only">Select only this column</button>`,menu=>{menu.querySelector("[data-column-check]").onchange=e=>{e.target.checked?state.selected.add(index):state.selected.delete(index);renderSchema();hideContextMenu();};menu.querySelector('[data-column-action="insert"]').onclick=()=>{insertSql(aliasedColumn(table,column.name));hideContextMenu();};menu.querySelector('[data-column-action="only"]').onclick=()=>{state.selected=new Set([index]);setSourceQuery(table,false);hideContextMenu();};});}

async function addJoinTable(table) {
  await ensureColumns(table);
  if (joinTables.some(item => tableKey(item) === tableKey(table))) return toast("Table is already in the join designer");
  joinTables.push({ ...table, columns:[...(table.columns||[])], alias:`t${joinTables.length+1}` });
  renderJoin(); if (joinTables.length === 2) openJoin();
}
function renderJoin() {
  $("joinCanvas").innerHTML = joinTables.map(table => `<div class="join-table"><b>${esc(table.alias)} · ${esc(qualifiedName(table))}</b>${(table.columns||[]).slice(0,10).map(column=>`<span>${esc(column.name)}</span>`).join("")}</div>`).join("") || '<span class="muted">Double-click tables in Data sources to begin.</span>';
  $("joinList").innerHTML = joins.map((join,index)=>`<div class="join-item"><button data-remove-join="${index}">×</button><b>${esc(join.type)}</b><br>${esc(join.left.alias)} → ${esc(join.right.alias)}<br>${join.clauses.map(clause=>esc(`${clause.left} = ${clause.right}`)).join("<br>")}</div>`).join("") || '<p class="muted">No joins defined.</p>';
  document.querySelectorAll("[data-remove-join]").forEach(element => element.onclick=()=>{ joins.splice(+element.dataset.removeJoin,1); renderJoin(); });
}
function openJoin() { if(joinTables.length<2)return toast("Add at least two tables"); const options=joinTables.map((table,index)=>`<option value="${index}">${esc(`${table.alias} · ${qualifiedName(table)}`)}</option>`).join(""); $("joinLeftTable").innerHTML=options; $("joinRightTable").innerHTML=options; $("joinRightTable").selectedIndex=1; $("joinClauses").innerHTML=""; addClause(); $("joinModal").classList.remove("hidden"); }
function addClause() { const left=joinTables[+$("joinLeftTable").value]||joinTables[0], right=joinTables[+$("joinRightTable").value]||joinTables[1]; const row=document.createElement("div"); row.className="clause"; row.innerHTML=`<select class="left-col">${(left.columns||[]).map(c=>`<option>${esc(c.name)}</option>`).join("")}</select><span>=</span><select class="right-col">${(right.columns||[]).map(c=>`<option>${esc(c.name)}</option>`).join("")}</select><button type="button">×</button>`; row.querySelector("button").onclick=()=>row.remove(); $("joinClauses").appendChild(row); }
function saveJoin() { const left=joinTables[+$("joinLeftTable").value], right=joinTables[+$("joinRightTable").value]; if(!left||!right||left===right)return toast("Choose two different tables"); const clauses=[...document.querySelectorAll(".clause")].map(row=>({left:row.querySelector(".left-col").value,right:row.querySelector(".right-col").value})).filter(c=>c.left&&c.right); if(!clauses.length)return toast("Add at least one join condition"); joins.push({left,right,type:$("joinType").value,clauses}); $("joinModal").classList.add("hidden"); renderJoin(); }
function generateSql() { if(!joinTables.length)return toast("Add tables first"); const main=joinTables[0], full=table=>table.schema?`[${table.schema}].[${table.name}]`:`[${table.name}]`; let sql=`SELECT ${joinTables.map(t=>`${t.alias}.*`).join(",\n       ")}\nFROM ${full(main)} ${main.alias}`; for(const join of joins)sql+=`\n${join.type} ${full(join.right)} ${join.right.alias} ON `+join.clauses.map(c=>`${join.left.alias}.[${c.left}] = ${join.right.alias}.[${c.right}]`).join("\n    AND "); $("queryText").value=sql; highlightSql(); toast("SQL generated from joins"); }

function resultColumnName(column){return typeof column==="string"?column:column.name;}
function rowValues(row,columns){return Array.isArray(row)?row:columns.map(column=>row?.[resultColumnName(column)]);}
function formatResultValue(value,format){if(value==null)return "";if(format==="number"){const number=Number(value);return Number.isFinite(number)?number.toLocaleString(undefined,{maximumFractionDigits:2}):value;}if(format==="integer"){const number=Number(value);return Number.isFinite(number)?number.toLocaleString(undefined,{maximumFractionDigits:0}):value;}if(format==="percent"){const number=Number(value);return Number.isFinite(number)?number.toLocaleString(undefined,{style:"percent",maximumFractionDigits:2}):value;}if(format==="excel-date"){const number=Number(value),date=Number.isFinite(number)?new Date(Date.UTC(1899,11,30)+number*86400000):new Date(value);return Number.isNaN(date.valueOf())?value:date.toLocaleDateString();}if(format==="date"){const date=new Date(value);return Number.isNaN(date.valueOf())?value:date.toLocaleDateString();}return value;}
function editColumn(index){return editState?.columns?.find(column=>column.name.toLowerCase()===resultColumnName(resultView.data.columns[index]).toLowerCase());}
function hasEdits(){return !!editState?.rowStates?.some(state=>state&&state!=="clean");}
function updateEditActions(){const bar=$("editActions");bar.classList.toggle("hidden",!editState);bar.querySelectorAll('[data-action="saveEdits"],[data-action="revertEdits"]').forEach(button=>button.disabled=!hasEdits());}
function editInputHtml(value,column,index,rowIndex){if(column?.dbType==="bit")return `<input type="checkbox" data-edit-row="${rowIndex}" data-edit-column="${index}" ${value===true||value===1?"checked":""}>`;const type=/date|time/i.test(column?.dbType||"")?"text":/int|decimal|numeric|money|float|real/i.test(column?.dbType||"")?"number":"text",step=type==="number"?' step="any"':"";return `<input type="${type}"${step} data-edit-row="${rowIndex}" data-edit-column="${index}" value="${esc(value??"")}" ${column?.nullable?'placeholder="NULL"':""}>`;}
function renderResult(data, preserveQueryData=false, label="") {
  resultMessage="";if(resultMode==="messages")resultMode="grid";
  const rendered=data||{columns:[],rows:[]}; if(!preserveQueryData){query.data=rendered;resultView={...resultView,data:rendered,sortIndex:-1,sortDirection:0,hidden:new Set(),formats:new Map(),widths:new Map()};}else resultView.data=rendered;
  const columns=rendered.columns||[], sourceRows=rendered.rows||[], indexed=sourceRows.map((row,index)=>({row,index}));
  if(resultView.sortIndex>=0&&resultView.sortDirection){const direction=resultView.sortDirection;indexed.sort((left,right)=>{const a=rowValues(left.row,columns)[resultView.sortIndex],b=rowValues(right.row,columns)[resultView.sortIndex];if(a==null&&b==null)return left.index-right.index;if(a==null)return 1;if(b==null)return -1;const an=Number(a),bn=Number(b),comparison=Number.isFinite(an)&&Number.isFinite(bn)?an-bn:String(a).localeCompare(String(b),undefined,{numeric:true,sensitivity:"base"});return comparison*direction||left.index-right.index;});}
  const visible=columns.map((column,index)=>({column,index})).filter(item=>!resultView.hidden.has(item.index));
  const table=$("result"),colgroup=table.querySelector("colgroup"),head=table.querySelector("thead"),body=table.querySelector("tbody");colgroup.replaceChildren();head.replaceChildren();body.replaceChildren();table.style.width=`max(100%, ${visible.reduce((sum,item)=>sum+(resultView.widths.get(item.index)||160),0)}px)`;
  for(const item of visible){const col=document.createElement("col");col.style.width=`${resultView.widths.get(item.index)||160}px`;colgroup.appendChild(col);}
  const headerRow=document.createElement("tr");if(editState){const actionHead=document.createElement("th");actionHead.className="row-action-head";headerRow.appendChild(actionHead);}for(const item of visible){const cell=document.createElement("th");cell.dataset.column=String(item.index);cell.innerHTML=`<span>${esc(resultColumnName(item.column))}</span>${resultView.sortIndex===item.index&&resultView.sortDirection?`<span class="sort-mark">${resultView.sortDirection===1?"▲":"▼"}</span>`:""}<span class="column-resizer"></span>`;cell.onclick=event=>{if(event.target.classList.contains("column-resizer"))return;if(resultView.sortIndex!==item.index){resultView.sortIndex=item.index;resultView.sortDirection=1;}else if(resultView.sortDirection===1)resultView.sortDirection=-1;else if(resultView.sortDirection===-1){resultView.sortIndex=-1;resultView.sortDirection=0;}renderResult(resultView.data,true,label);};cell.oncontextmenu=event=>{event.preventDefault();showResultColumnMenu(event,item.index,label);};cell.querySelector(".column-resizer").onpointerdown=event=>startColumnResize(event,item.index);headerRow.appendChild(cell);}head.appendChild(headerRow);
  for(const entry of indexed){const resultRow=document.createElement("tr"),values=rowValues(entry.row,columns),state=editState?.rowStates?.[entry.index]||"clean";if(state==="update")resultRow.className="edit-dirty";else if(state==="insert")resultRow.className="edit-new";else if(state==="delete")resultRow.className="edit-deleted";if(editState){const action=document.createElement("td");action.className="row-action";action.innerHTML=`<button title="${state==="delete"?"Restore row":"Delete row"}" data-delete-row="${entry.index}">${state==="delete"?"↶":"×"}</button>`;resultRow.appendChild(action);}for(const item of visible){const cell=document.createElement("td"),column=editColumn(item.index);if(editState&&!column?.readOnly&&state!=="delete"){cell.className="edit-cell";cell.innerHTML=editInputHtml(values[item.index],column,item.index,entry.index);}else{if(editState&&column?.readOnly)cell.className="edit-readonly";cell.textContent=formatResultValue(values[item.index],resultView.formats.get(item.index)||"auto");}resultRow.appendChild(cell);}body.appendChild(resultRow);}
  if(editState){body.querySelectorAll("[data-edit-row]").forEach(input=>input.onchange=()=>{const row=+input.dataset.editRow,columnIndex=+input.dataset.editColumn,column=editColumn(columnIndex);let value=input.type==="checkbox"?input.checked:input.value;if(input.type!=="checkbox"&&value===""&&column?.nullable)value=null;else if(input.type==="number"&&value!=="")value=Number(value);resultView.data.rows[row][columnIndex]=value;if(editState.rowStates[row]==="clean")editState.rowStates[row]="update";updateEditActions();renderResult(resultView.data,true,"Editable: "+editState.schemaName+"."+editState.tableName);});body.querySelectorAll("[data-delete-row]").forEach(button=>button.onclick=()=>toggleDeleteRow(+button.dataset.deleteRow));}
  $("emptyResult").classList.toggle("hidden",columns.length>0);$("resultSummary").textContent=`${sourceRows.length.toLocaleString()} row(s) · ${visible.length}/${columns.length} column(s)`;if(label)$("resultSummary").textContent=`${label} · ${$("resultSummary").textContent}`;
  applyResultMode();
  updateEditActions();
}
function resultJson(){const data=resultView.data||{columns:[],rows:[]},columns=data.columns||[];return (data.rows||[]).map(row=>Object.fromEntries(columns.map((column,index)=>[resultColumnName(column),rowValues(row,columns)[index]??null])));}
function applyResultMode(){const table=$("result"),text=$("resultText"),empty=$("emptyResult"),hasData=(resultView.data?.columns||[]).length>0;document.querySelectorAll("[data-result-view]").forEach(button=>button.classList.toggle("active",button.dataset.resultView===resultMode));table.classList.toggle("hidden",resultMode!=="grid");text.classList.toggle("hidden",resultMode==="grid");text.classList.toggle("message-result",resultMode==="messages");if(resultMode==="json")text.textContent=JSON.stringify(resultJson(),null,2);else if(resultMode==="sql")text.textContent=parsedSql||"Select Parsed SQL to substitute the current parameters.";else if(resultMode==="messages")text.textContent=resultMessage||"No messages.";empty.classList.toggle("hidden",hasData||resultMode!=="grid");}
function startColumnResize(event,index){event.stopPropagation();const startX=event.clientX,start=resultView.widths.get(index)||160,visibleIndexes=(resultView.data.columns||[]).map((_,i)=>i).filter(i=>!resultView.hidden.has(i)),col=$("result").querySelectorAll("col")[visibleIndexes.indexOf(index)];pointerDrag(event,e=>{const width=Math.max(55,Math.min(700,start+e.clientX-startX));resultView.widths.set(index,width);if(col)col.style.width=`${width}px`;});}
function showResultColumnMenu(event,index,label){const columns=resultView.data.columns||[];showContextMenu(event,`<div class="menu-title">${esc(resultColumnName(columns[index]))}</div><button data-sort="1">Sort ascending</button><button data-sort="-1">Sort descending</button><button data-sort="0">Clear sorting</button><label>Format <select data-result-format><option value="auto">Auto</option><option value="number">Number</option><option value="integer">Integer</option><option value="percent">Percent</option><option value="date">Date</option><option value="excel-date">Excel serial date</option><option value="text">Text</option></select></label><hr><div class="menu-title">Visible columns</div>${columns.map((column,columnIndex)=>`<label><input type="checkbox" data-visible-column="${columnIndex}" ${resultView.hidden.has(columnIndex)?"":"checked"}> ${esc(resultColumnName(column))}</label>`).join("")}`,menu=>{menu.querySelector("[data-result-format]").value=resultView.formats.get(index)||"auto";menu.querySelector("[data-result-format]").onchange=e=>{resultView.formats.set(index,e.target.value);renderResult(resultView.data,true,label);hideContextMenu();};menu.querySelectorAll("[data-sort]").forEach(button=>button.onclick=()=>{const direction=+button.dataset.sort;resultView.sortIndex=direction?index:-1;resultView.sortDirection=direction;renderResult(resultView.data,true,label);hideContextMenu();});menu.querySelectorAll("[data-visible-column]").forEach(input=>input.onchange=()=>{const columnIndex=+input.dataset.visibleColumn;input.checked?resultView.hidden.delete(columnIndex):resultView.hidden.add(columnIndex);if(resultView.hidden.size===columns.length)resultView.hidden.delete(columnIndex);renderResult(resultView.data,true,label);showResultColumnMenu(event,index,label);});});}
async function run() { exitEditable(false);query.connectionName=$("connection").value; query.queryText=$("queryText").value; query.previewLimit=Number($("previewLimit").value)||0; $("queryStatus").textContent="Running…"; resultMessage=""; try{const result=await call("queryRun",{query});parsedSql=result.parsedQuery||query.queryText;renderResult(result.data);$("queryStatus").textContent="Ready";}catch(error){showResultError(error,"Query failed");} }
async function refreshParsedSql(){query.queryText=$("queryText").value;$("queryStatus").textContent="Parsing parameters…";try{const result=await call("queryParse",{query});parsedSql=result.parsedQuery??query.queryText;applyResultMode();$("queryStatus").textContent="Ready";}catch(error){showResultError(error,"Could not parse SQL");}}
async function loadEditable(){query.connectionName=$("connection").value;query.queryText=$("queryText").value;query.previewLimit=Number($("previewLimit").value)||0;$("queryStatus").textContent="Validating editable query…";try{const result=await call("queryEditLoad",{query});parsedSql=result.parsedQuery||query.queryText;editState={connectionName:result.connectionName,schemaName:result.schemaName,tableName:result.tableName,columns:result.columns||[],originalRows:structuredClone(result.data?.rows||[]),rowStates:(result.data?.rows||[]).map(()=>"clean")};resultMode="grid";renderResult(result.data,false,`Editable: ${result.schemaName}.${result.tableName}`);$("queryStatus").textContent="Editing";resultMessage="Editable mode validates a single SQL Server table and saves changes in one transaction.";}catch(error){exitEditable(false);showResultError(error,"Could not open editable result");}}
function addEditableRow(){if(!editState)return;resultView.data.rows.push((resultView.data.columns||[]).map(()=>null));editState.originalRows.push(null);editState.rowStates.push("insert");renderResult(resultView.data,true,`Editable: ${editState.schemaName}.${editState.tableName}`);}
function toggleDeleteRow(index){if(!editState)return;if(editState.rowStates[index]==="insert"){resultView.data.rows.splice(index,1);editState.originalRows.splice(index,1);editState.rowStates.splice(index,1);}else editState.rowStates[index]=editState.rowStates[index]==="delete"?"clean":"delete";renderResult(resultView.data,true,`Editable: ${editState.schemaName}.${editState.tableName}`);}
function revertEditable(){if(!editState)return;resultView.data.rows=structuredClone(editState.originalRows.filter(Boolean));editState.originalRows=structuredClone(resultView.data.rows);editState.rowStates=resultView.data.rows.map(()=>"clean");renderResult(resultView.data,true,`Editable: ${editState.schemaName}.${editState.tableName}`);resultMessage="Unsaved edits were reverted.";}
function exitEditable(render=true){editState=null;updateEditActions();if(render)renderResult(query.data||{columns:[],rows:[]});}
async function saveEditable(){if(!editState||!hasEdits())return;const changes=[];for(let index=0;index<editState.rowStates.length;index++){const state=editState.rowStates[index];if(state==="clean")continue;const columns=resultView.data.columns||[],toObject=row=>row?Object.fromEntries(columns.map((column,i)=>[resultColumnName(column),row[i]??null])):null;changes.push({state,original:toObject(editState.originalRows[index]),current:state==="delete"?null:toObject(resultView.data.rows[index])});}$("queryStatus").textContent="Saving changes…";try{const result=await call("queryEditSave",{connectionName:editState.connectionName,schemaName:editState.schemaName,tableName:editState.tableName,changes});resultMessage=`Saved ${result.saved} row change(s).`;toast(resultMessage);await loadEditable();}catch(error){showResultError(error,"Could not save editable changes");}}
function formatSql() { let text=$("queryText").value; text=text.replace(/\s+(FROM|WHERE|INNER JOIN|LEFT JOIN|RIGHT JOIN|FULL OUTER JOIN|GROUP BY|ORDER BY|HAVING|UNION)\s+/gi,"\n$1 ").replace(/\s+(AND|OR)\s+/gi,"\n  $1 "); $("queryText").value=text.trim(); highlightSql(); }

const sqlKeywords=new Set("SELECT FROM WHERE INNER JOIN LEFT RIGHT FULL OUTER ON GROUP BY ORDER HAVING UNION ALL DISTINCT AS AND OR NOT NULL IS IN EXISTS BETWEEN LIKE CASE WHEN THEN ELSE END ASC DESC TOP OFFSET FETCH INSERT UPDATE DELETE INTO VALUES CREATE ALTER DROP TABLE VIEW WITH OVER PARTITION".split(" "));
const sqlFunctions=new Set("COUNT SUM AVG MIN MAX CONCAT SUBSTRING LENGTH REPLACE TRIM LEFT RIGHT UPPER LOWER CHARINDEX PATINDEX REVERSE SPACE REPLICATE GETDATE DATEADD DATEDIFF YEAR MONTH DATENAME DATEPART EOMONTH COALESCE NULLIF IIF CHOOSE ROUND FLOOR CEILING ABS MOD POWER SQRT EXP LOG LOG10 PI RAND SIGN CAST CONVERT PARSE TRY_CAST TRY_CONVERT ISNULL FORMAT XLDATE XLDATETIME".split(" "));
function highlightSql(){const source=$("queryText").value,pattern=/(--[^\n]*|\/\*[\s\S]*?\*\/|'(?:''|[^'])*'|\{\{[^}]+\}\}|<[^>\n]+>|\b\d+(?:\.\d+)?\b|\b[A-Za-z_][A-Za-z0-9_]*\b)/g;let html="",last=0,match;while((match=pattern.exec(source))){html+=esc(source.slice(last,match.index));const token=match[0],upper=token.toUpperCase();let cls="";if(token.startsWith("--")||token.startsWith("/*"))cls="sql-comment";else if(token.startsWith("'"))cls="sql-string";else if(token.startsWith("{{")||token.startsWith("<"))cls="sql-parameter";else if(/^\d/.test(token))cls="sql-number";else if(sqlKeywords.has(upper))cls="sql-keyword";else if(sqlFunctions.has(upper))cls="sql-function";html+=cls?`<span class="${cls}">${esc(token)}</span>`:esc(token);last=pattern.lastIndex;}html+=esc(source.slice(last));$("queryHighlight").innerHTML=html+"\n";renderParameterReference();}

function autocompleteCandidates(prefix) {
  const keywords=["SELECT","FROM","WHERE","INNER JOIN","LEFT JOIN","GROUP BY","ORDER BY","HAVING","AND","OR","AS","DISTINCT","SUM","COUNT","AVG","MIN","MAX"];
  const metadata=[]; for(const table of tables){ metadata.push({text:qualifiedName(table),kind:table.type||"table"}); if(table.columnsLoaded) for(const column of table.columns||[])metadata.push({text:column.name,kind:qualifiedName(table)}); }
  if (prefix.includes(".")) {
    const dot=prefix.indexOf("."),qualifier=prefix.slice(0,dot).toLowerCase(),partial=prefix.slice(dot+1).toLowerCase(),sql=$("queryText").value;
    const aliasMatch=[...sql.matchAll(/(?:from|join)\s+([\w.[\]]+)\s+(?:as\s+)?(\w+)/gi)].find(match=>match[2].toLowerCase()===qualifier);
    const sourceName=(aliasMatch?.[1]||qualifier).replace(/[\[\]]/g,"").toLowerCase();
    const table=tables.find(item=>qualifiedName(item).toLowerCase()===sourceName||item.name.toLowerCase()===sourceName||tableAliases(item).some(alias=>alias.toLowerCase()===qualifier));
    if(table?.columnsLoaded)return (table.columns||[]).filter(column=>column.name.toLowerCase().startsWith(partial)).map(column=>({text:`${prefix.slice(0,dot+1)}${column.name}`,kind:qualifiedName(table)})).slice(0,18);
  }
  const parameters=(query.parameters||[]).map(parameter=>({text:`{{${parameter.Name||parameter.name}}}`,kind:"parameter"}));
  const needle=prefix.toLowerCase(); return [...metadata,...parameters,...keywords.map(text=>({text,kind:"keyword"}))].filter((item,index,array)=>item.text.toLowerCase().includes(needle)&&array.findIndex(other=>other.text.toLowerCase()===item.text.toLowerCase())===index).slice(0,18);
}
function aliasTable(prefix){if(!prefix.includes("."))return null;const qualifier=prefix.slice(0,prefix.indexOf(".")).toLowerCase(),sql=$("queryText").value;const reserved=new Set(["where","on","group","order","having","inner","left","right","full","join"]);const matches=[...sql.matchAll(/(?:from|join)\s+((?:\[[^\]]+\]|[A-Za-z_][\w$]*)(?:\s*\.\s*(?:\[[^\]]+\]|[A-Za-z_][\w$]*))?)\s+(?:as\s+)?([A-Za-z_][\w$]*)/gi)];const aliasMatch=matches.find(match=>match[2].toLowerCase()===qualifier&&!reserved.has(match[2].toLowerCase()));if(!aliasMatch)return tables.find(item=>qualifiedName(item).toLowerCase()===qualifier||item.name.toLowerCase()===qualifier||tableAliases(item).some(alias=>alias.toLowerCase()===qualifier));const sourceName=aliasMatch[1].replace(/[\[\]\s]/g,"").toLowerCase();return tables.find(item=>qualifiedName(item).toLowerCase()===sourceName||item.name.toLowerCase()===sourceName);}
function currentToken() { const editor=$("queryText"), before=editor.value.slice(0,editor.selectionStart), match=before.match(/[A-Za-z_][A-Za-z0-9_.]*$/); return match ? match[0] : ""; }
function positionAutocomplete(){const editor=$("queryText"),box=$("autocomplete"),work=document.querySelector(".work"),before=editor.value.slice(0,editor.selectionStart),lines=before.split("\n"),line=lines.at(-1).replace(/\t/g,"    "),style=getComputedStyle(editor),canvas=positionAutocomplete.canvas||(positionAutocomplete.canvas=document.createElement("canvas")),context=canvas.getContext("2d"),editorRect=editor.getBoundingClientRect(),workRect=work.getBoundingClientRect(),lineHeight=parseFloat(style.lineHeight)||22;context.font=style.font;let left=editorRect.left-workRect.left+17+context.measureText(line).width-editor.scrollLeft,top=editorRect.top-workRect.top+14+lines.length*lineHeight-editor.scrollTop;left=Math.max(8,Math.min(work.clientWidth-370,left));if(top+270>work.clientHeight)top=Math.max(40,top-285);box.style.left=`${left}px`;box.style.top=`${top}px`;}
async function showAutocomplete(force=false) { const token=currentToken(); if(!force&&token.length<2)return hideAutocomplete();const aliasSource=aliasTable(token);if(aliasSource&&!aliasSource.columnsLoaded){try{await ensureColumns(aliasSource)}catch(error){return toast(error.message||String(error));}if(currentToken()!==token)return;} autocompleteItems=autocompleteCandidates(force?"":token); autocompleteIndex=0; const box=$("autocomplete"); box.innerHTML=autocompleteItems.map((item,index)=>`<button type="button" data-completion="${index}" class="${index===0?"active":""}">${esc(item.text)}<small>${esc(item.kind)}</small></button>`).join(""); box.classList.toggle("hidden",!autocompleteItems.length);if(autocompleteItems.length)positionAutocomplete();box.querySelectorAll("button").forEach(button=>button.onmousedown=event=>{event.preventDefault();acceptAutocomplete(+button.dataset.completion);}); }
function hideAutocomplete(){ $("autocomplete").classList.add("hidden"); }
function acceptAutocomplete(index=autocompleteIndex){ const item=autocompleteItems[index]; if(!item)return; const editor=$("queryText"), token=currentToken(), end=editor.selectionStart, start=end-token.length; editor.value=editor.value.slice(0,start)+item.text+editor.value.slice(end); editor.selectionStart=editor.selectionEnd=start+item.text.length; editor.focus(); hideAutocomplete();highlightSql(); }
function moveAutocomplete(delta){ if(!autocompleteItems.length)return; autocompleteIndex=(autocompleteIndex+delta+autocompleteItems.length)%autocompleteItems.length; $("autocomplete").querySelectorAll("button").forEach((button,index)=>button.classList.toggle("active",index===autocompleteIndex)); }

function parameterName(parameter){return parameter.Name||parameter.name||"";}
function parameterValue(parameter){return parameter.CurrentDisplayValue||parameter.currentDisplayValue||parameter.CurrentValue||parameter.currentValue||parameter.DefaultValue||parameter.defaultValue||"";}
function parsedParameterNames(){const names=new Set();for(const match of $("queryText").value.matchAll(/\{\{\s*([^}]+?)\s*\}\}|<\s*([A-Za-z_][A-Za-z0-9_]*)\s*>/g))names.add((match[1]||match[2]).trim());return [...names];}
function renderParameterReference(){if(!$("toolPanel").classList.contains("parameter-mode"))return;showParametersPanel();}
function showToolPanel(){ $("defaultInspector").classList.add("hidden"); $("toolPanel").classList.remove("hidden"); }
function closeToolPanel(){ $("toolPanel").classList.add("hidden"); $("toolPanel").className="tool-panel hidden"; $("defaultInspector").classList.remove("hidden"); }
function showParametersPanel(){
  showToolPanel();
  const names=parsedParameterNames(), definitions=(query.parameters||[]).filter(parameter=>parameterName(parameter));
  const isUsed=parameter=>names.some(name=>name.toLowerCase()===parameterName(parameter).toLowerCase());
  const missing=names.filter(name=>!definitions.some(parameter=>parameterName(parameter).toLowerCase()===name.toLowerCase()));
  const available=definitions.filter(parameter=>!isUsed(parameter));
  const cards=items=>items.map(item=>{
    const name=typeof item==="string"?item:parameterName(item);
    const parameter=typeof item==="string"?definitions.find(candidate=>parameterName(candidate).toLowerCase()===name.toLowerCase()):item;
    return `<div class="parameter-item" data-parameter="${esc(name)}"><b>{{${esc(name)}}}</b><small>${parameter?esc(parameterValue(parameter)):"Not defined"}</small></div>`;
  }).join("");
  $("toolPanel").className="tool-panel parameter-mode";
  $("toolPanel").innerHTML=`<div class="tool-head"><h2>Parameters</h2><button data-close-tool>×</button></div><button data-edit-parameters>Edit parameter values</button><div class="tool-subhead">Used in this query</div><div class="parameter-list">${cards(names)||'<p class="muted">No {{parameters}} were found in this query.</p>'}</div>${missing.length?`<p class="parameter-warning">Missing definitions: ${esc(missing.join(", "))}</p>`:""}<div class="tool-subhead">Available from Parameter Manager / _control</div><div class="parameter-list">${cards(available)||'<p class="muted">No additional workbook parameters are available.</p>'}</div>`;
  $("toolPanel").querySelector("[data-close-tool]").onclick=closeToolPanel;
  $("toolPanel").querySelector("[data-edit-parameters]").onclick=openParameters;
  $("toolPanel").querySelectorAll("[data-parameter]").forEach(item=>item.onclick=()=>insertSql(`{{${item.dataset.parameter}}}`));
}
function lookupParameter(parameter){return new Promise((resolve,reject)=>{const requestId=`parameter-${Date.now()}-${Math.random()}`;parameterLookups.set(requestId,{resolve,reject});chrome.webview.postMessage({type:"parameterLookup",requestId,query,parameter});});}
function openParameters(){ParameterWeb.openInput({parameters:query.parameters||[],lookup:lookupParameter,onManage:items=>{query.parameters=items;openParameters();},onManagerCancel:openParameters,onApply:items=>{query.parameters=items;highlightSql();showParametersPanel();},onCancel:()=>{}});}
async function showFunctions(){showToolPanel();$("toolPanel").className="tool-panel function-mode";$("toolPanel").innerHTML='<div class="tool-head"><h2>Function reference</h2><button data-close-tool>×</button></div><p class="muted">Loading functions…</p>';$("toolPanel").querySelector("[data-close-tool]").onclick=closeToolPanel;const result=await call("queryFunctions",{connectionName:$("connection").value});const functions=result.functions||[];$("toolPanel").innerHTML=`<div class="tool-head"><h2>Function reference</h2><button data-close-tool>×</button></div><input class="tool-search" placeholder="Search functions"><div class="function-list"></div>`;const render=()=>{const search=$("toolPanel").querySelector(".tool-search").value.toLowerCase();$("toolPanel").querySelector(".function-list").innerHTML=functions.filter(item=>!search||String(item.Name||item.name).toLowerCase().includes(search)||String(item.Category||item.category).toLowerCase().includes(search)).map((item,index)=>`<div class="function-item" data-function="${index}"><b>${esc(item.Name||item.name)}</b><small>${esc(item.Syntax||item.syntax)}</small><small>${esc(item.Category||item.category)} · ${esc(String(item.Description||item.description||"").replace(/<br\s*\/?\s*>/gi," "))}</small></div>`).join("");$("toolPanel").querySelectorAll("[data-function]").forEach(element=>element.onclick=()=>insertSql(functions[+element.dataset.function].Syntax||functions[+element.dataset.function].syntax||functions[+element.dataset.function].Name));};$("toolPanel").querySelector("[data-close-tool]").onclick=closeToolPanel;$("toolPanel").querySelector(".tool-search").oninput=render;render();}
async function showStatistics(table=null){$("queryStatus").textContent="Calculating statistics…";query.queryText=$("queryText").value;query.connectionName=$("connection").value;const payload={query};if(table){payload.tableName=table.name;payload.schemaName=table.schema||"";}const result=await call("queryStatistics",payload);renderResult(result.data,true,table?`Statistics for ${qualifiedName(table)}`:"Query statistics");$("queryStatus").textContent="Ready";}

document.addEventListener("click",async event=>{if(!event.target.closest("#contextMenu"))hideContextMenu();const button=event.target.closest("button[data-action]");if(!button)return;try{switch(button.dataset.action){case"run":await run();break;case"editQuery":await loadEditable();break;case"addRow":addEditableRow();break;case"saveEdits":await saveEditable();break;case"revertEdits":revertEditable();break;case"exitEdit":exitEditable();break;case"format":formatSql();break;case"toggleJoin":$("joinPanel").classList.toggle("hidden");break;case"toggleSources":document.querySelector("main").classList.toggle("sources-hidden");break;case"toggleInspector":document.querySelector("main").classList.toggle("inspector-hidden");break;case"refreshSchema":await loadSchema();break;case"generateSql":generateSql();break;case"addClause":addClause();break;case"saveJoin":saveJoin();break;case"closeJoin":$("joinModal").classList.add("hidden");break;case"closeFilter":$("filterModal").classList.add("hidden");break;case"applyFilter":applyPickedFilter();break;case"clearFilter":if(activeFilter){sourceState(activeFilter.table).filters.delete(activeFilter.index);$("filterModal").classList.add("hidden");renderSchema()}break;case"apply":query.connectionName=$("connection").value;query.queryText=$("queryText").value;query.previewLimit=Number($("previewLimit").value)||0;chrome.webview.postMessage({type:"queryApply",query});break;case"cancel":chrome.webview.postMessage({type:"queryCancel"});break;}}catch(error){showResultError(error,"Query operation failed");}});
document.querySelectorAll("[data-result-view]").forEach(button=>button.onclick=async()=>{resultMode=button.dataset.resultView;applyResultMode();if(resultMode==="sql")await refreshParsedSql();});
$("connection").onchange=loadSchema; $("schemaSearch").oninput=renderSchema;
$("filterSearch").oninput=renderFilterChoices;$("filterSelectAll").onchange=()=>$("filterValues").querySelectorAll('[data-filter-value]').forEach(input=>{input.checked=$("filterSelectAll").checked;const value=String(filterChoices[+input.dataset.rawIndex]??'');input.checked?filterPending.add(value):filterPending.delete(value)});
$("joinLeftTable").onchange=()=>{$("joinClauses").innerHTML="";addClause();}; $("joinRightTable").onchange=()=>{$("joinClauses").innerHTML="";addClause();};
$("queryText").addEventListener("input",()=>{highlightSql();showAutocomplete(false);});
$("queryText").addEventListener("scroll",()=>{$("queryHighlight").scrollTop=$("queryText").scrollTop;$("queryHighlight").scrollLeft=$("queryText").scrollLeft;});
function indentQuerySelection(outdent=false){const editor=$("queryText"),text=editor.value,start=editor.selectionStart,end=editor.selectionEnd,lineStart=text.lastIndexOf("\n",Math.max(0,start-1))+1;if(start===end&&!outdent){editor.setRangeText("\t",start,end,"end");highlightSql();hideAutocomplete();return;}const block=text.slice(lineStart,end),lines=block.split("\n");let removedBeforeStart=0,totalRemoved=0;const changed=lines.map((line,index)=>{if(!outdent)return`\t${line}`;const match=line.match(/^(\t| {1,4})/),count=match?.[0].length||0;if(index===0)removedBeforeStart=count;totalRemoved+=count;return line.slice(count);}).join("\n");editor.setRangeText(changed,lineStart,end,"start");if(outdent){editor.selectionStart=Math.max(lineStart,start-removedBeforeStart);editor.selectionEnd=Math.max(editor.selectionStart,end-totalRemoved);}else{editor.selectionStart=start+1;editor.selectionEnd=end+lines.length;}highlightSql();hideAutocomplete();}
$("queryText").addEventListener("keydown",event=>{ if(event.ctrlKey&&event.code==="Space"){event.preventDefault();showAutocomplete(true);} else if(!$("autocomplete").classList.contains("hidden")&&event.key==="ArrowDown"){event.preventDefault();moveAutocomplete(1);} else if(!$("autocomplete").classList.contains("hidden")&&event.key==="ArrowUp"){event.preventDefault();moveAutocomplete(-1);} else if(!$("autocomplete").classList.contains("hidden")&&(event.key==="Enter"||event.key==="Tab")&&!event.shiftKey){event.preventDefault();acceptAutocomplete();} else if(event.key==="Tab"){event.preventDefault();indentQuerySelection(event.shiftKey);} else if(event.key==="Escape")hideAutocomplete();});
document.querySelector(".result-head").addEventListener("pointerdown",event=>{if(event.target.closest("button"))return;const work=document.querySelector(".work"),startY=event.clientY,start=$("queryText").getBoundingClientRect().height;pointerDrag(event,e=>{const available=work.clientHeight-68,size=Math.max(150,Math.min(available-220,start+e.clientY-startY));work.style.setProperty("--query-size",`${size}px`);});});
document.querySelector(".left-splitter").addEventListener("pointerdown",event=>{const main=document.querySelector("main");if(main.classList.contains("sources-hidden")){main.classList.remove("sources-hidden");return}const startX=event.clientX,start=document.querySelector(".sources").getBoundingClientRect().width;pointerDrag(event,e=>main.style.setProperty("--left-pane",`${Math.max(190,Math.min(560,start+e.clientX-startX))}px`));});
document.querySelector(".right-splitter").addEventListener("pointerdown",event=>{const main=document.querySelector("main");if(main.classList.contains("inspector-hidden")){main.classList.remove("inspector-hidden");return}const startX=event.clientX,start=document.querySelector(".inspector").getBoundingClientRect().width;pointerDrag(event,e=>main.style.setProperty("--right-pane",`${Math.max(210,Math.min(620,start-(e.clientX-startX)))}px`));});
document.querySelectorAll("[data-side]").forEach(button=>button.onclick=async()=>{try{if(button.dataset.side==="parameters")showParametersPanel();else if(button.dataset.side==="functions")await showFunctions();else if(button.dataset.side==="queryStats")await showStatistics();else if(button.dataset.side==="tableStats"&&selectedTable)await showStatistics(selectedTable);}catch(error){showResultError(error,"Tool operation failed");}});

chrome.webview.addEventListener("message",event=>{const message=event.data;if(message.type==="loadQueryWorkspace"){query={...query,...message.query};$("queryText").value=query.queryText||"";$("previewLimit").value=query.previewLimit??1000;highlightSql();renderResult(query.data);loadConnections().catch(error=>showResultError(error,"Could not load query workspace"));}else if(message.type==="bridgeResult"&&message.action==="parameter-lookup"){const waiter=parameterLookups.get(message.requestId);if(!waiter)return;parameterLookups.delete(message.requestId);if(!message.result?.ok)waiter.reject(new Error(message.result?.error||"Lookup failed"));else{const data=message.result.data||{},columns=data.columns||[],rows=data.rows||[],valueIndex=Math.max(0,columns.findIndex(column=>String(column).toLowerCase()===String(message.result.valueColumn||"").toLowerCase())),displayIndex=Math.max(0,columns.findIndex(column=>String(column).toLowerCase()===String(message.result.displayColumn||"").toLowerCase()));waiter.resolve(rows.map(row=>({value:row[valueIndex],display:row[displayIndex]})));}}else if(message.type==="bridgeResult"){const waiter=pending.get(message.action);if(!waiter){if(message.result?.ok===false)showResultError(message.result.error||"Operation failed","Query operation failed");return;}pending.delete(message.action);if(message.result?.ok)waiter.resolve(message.result);else{const error=new Error(message.result?.error||"Operation failed");showResultError(error,message.action==="query-run"?"Query failed":"Query operation failed");waiter.reject(error);}}else if(message.type==="bridgeBusy")$("queryStatus").textContent="Working…";else if(message.type==="hostError")showResultError(message.message,"Host error");});
window.addEventListener("DOMContentLoaded",()=>chrome.webview.postMessage({type:"ready"}));
