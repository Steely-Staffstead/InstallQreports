:root { font-family:"Segoe UI",Arial,sans-serif; color:#17213a; background:#eef2f8 }
* { box-sizing:border-box }
body { margin:0; height:100vh; display:grid; grid-template-rows:78px 1fr; overflow:hidden }
button,input,select,textarea { font:inherit }
button { border:1px solid #c8d1df; border-radius:8px; background:white; color:#263451; padding:8px 12px; cursor:pointer }
header { display:flex; align-items:center; padding:13px 22px; background:#243154; color:white }
.brand { display:flex; align-items:center; gap:12px }
.brand>span { display:grid; place-items:center; width:46px; height:46px; border-radius:12px; background:#6385ed; font-size:26px; font-weight:800 }
.brand strong { display:block; font-size:20px }
.brand small { display:block; color:#ccd5ee }
.toolbar { display:flex; align-items:center; gap:8px; margin-left:auto }
.toolbar button { background:#334265; border-color:#596886; color:white }
.toolbar .run { background:#278554; border-color:#278554 }
.toolbar .apply { background:#6385ed }
.toolbar label { display:flex; align-items:center; gap:7px; color:#ccd5ee; font-size:13px }
.toolbar input { width:82px; padding:8px; border-radius:7px; border:1px solid #667493 }
main { --left-pane:300px; --right-pane:290px; display:grid; grid-template-columns:var(--left-pane) 5px minmax(420px,1fr) 5px var(--right-pane); min-height:0 }
main.sources-hidden { grid-template-columns:0 34px minmax(420px,1fr) 5px var(--right-pane) }
main.inspector-hidden { grid-template-columns:var(--left-pane) 5px minmax(420px,1fr) 34px 0 }
main.sources-hidden.inspector-hidden { grid-template-columns:0 34px minmax(420px,1fr) 34px 0 }
main.sources-hidden .sources,main.inspector-hidden .inspector { visibility:hidden; padding:0; overflow:hidden }
.sources { grid-column:1 }.left-splitter { grid-column:2 }.work { grid-column:3 }.right-splitter { grid-column:4 }.inspector { grid-column:5 }
main.sources-hidden .left-splitter,main.inspector-hidden .right-splitter { display:grid; place-items:center; cursor:pointer }
main.sources-hidden .left-splitter::after { content:"DATA SOURCES"; writing-mode:vertical-rl; color:#40547e; font-size:11px;letter-spacing:.07em;font-weight:700 }
main.inspector-hidden .right-splitter::after { content:"TOOLS"; writing-mode:vertical-rl; color:#40547e;font-size:11px;letter-spacing:.07em;font-weight:700 }
.sources,.inspector { background:#f8fafc; padding:12px; overflow:auto }
.sources { border-right:1px solid #d6deea }
.inspector { border-left:1px solid #d6deea }
.splitter { background:#e0e6ef; cursor:col-resize }
.pane-head { display:flex; align-items:center; justify-content:space-between }
.pane-head>div { display:flex; gap:5px }
.pane-head button { padding:4px 8px }
.pane-head h2,.inspector h2 { font-size:15px; text-transform:uppercase; letter-spacing:.06em; color:#53617b; margin:0 0 12px }
.sources label { display:grid; gap:4px; color:#63708a; font-size:13px }
.sources select,.sources input { width:100%; padding:7px 9px; border:1px solid #c8d2e1; border-radius:7px; background:white }
.sources>input { margin-top:8px }
.schema { display:grid; gap:3px; margin-top:9px }
.table-node { background:white; border:1px solid #d4ddea; border-radius:6px; overflow:hidden }
.table-title { min-height:30px; padding:5px 8px; font-size:13px; line-height:19px; font-weight:400; cursor:pointer; display:flex; gap:6px; justify-content:space-between }
.table-title span:first-child { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap }
.table-title-actions { display:flex; align-items:center; gap:7px; flex:0 0 auto }
.table-kind { display:inline-grid; place-items:center; min-width:17px; height:17px; border-radius:4px; background:#e8edfb; color:#4f68b2; font-size:10px; font-weight:800 }
.table-title:hover { background:#eef3ff }
.columns { border-top:1px solid #e2e7ef }
.column { min-height:27px; padding:3px 7px; font-size:12px; color:#4f5d75; display:grid; grid-template-columns:16px minmax(80px,1fr) 62px minmax(105px,155px); gap:5px; align-items:center; cursor:pointer }
.column input[type=checkbox] { width:14px; height:14px; margin:0 }
.column-filter { min-width:0; width:100%; padding:3px 5px!important; font-size:11px; border-radius:4px!important }
.column-filter-wrap { display:grid; grid-template-columns:minmax(0,1fr) 24px; gap:2px }
.column-filter-wrap button { padding:2px; min-width:0; font-size:11px }
.column small { text-align:right }
.source-actions { display:flex; gap:5px; padding:5px 7px; background:#f7f9fc; border-top:1px solid #e2e7ef }
.source-actions button { padding:4px 7px; font-size:11px }
.column:hover { background:#f1f5fa }
.column small { color:#8a95a8 }
.work { --query-size:36%; display:grid; grid-template-rows:34px minmax(150px,var(--query-size)) auto 34px minmax(220px,1fr); grid-template-areas:"query-head" "editor" "join" "result-head" "result"; min-height:0; height:100%; overflow:hidden; background:white; position:relative }
.query-head { grid-area:query-head }
.editor-shell { grid-area:editor }
.join-panel { grid-area:join }
.result-head { grid-area:result-head }
.result-wrap { grid-area:result }
.query-head,.result-head { display:flex; justify-content:space-between; align-items:center; padding:0 13px; background:#68707d; color:white; font-size:12px; letter-spacing:.07em }
.result-head { background:#535d6c; cursor:row-resize; user-select:none }
.edit-actions { display:flex; gap:5px; margin-left:8px; margin-right:auto; height:27px; align-items:center }.edit-actions button { padding:3px 8px; border-color:#8994a8; background:#626d80; color:white; font-size:11px }.edit-actions .save-edit { background:#278554;border-color:#278554 }.edit-actions button:disabled { opacity:.45;cursor:default }
.result-tabs { display:flex; align-items:stretch; height:100% }.result-tabs button { border:0; border-radius:0; background:transparent; color:#dfe6f3; padding:0 11px; cursor:pointer }.result-tabs button.active { color:white; background:#758096; box-shadow:inset 0 -3px #9fb1ff }.result-text { margin:0; padding:14px 16px; min-height:100%; font:13px/1.5 Consolas,"Courier New",monospace; white-space:pre-wrap; color:#17213c; background:#fbfcff }
.editor-shell { position:relative; min-height:0; overflow:hidden; background:#fffdfd }
#queryText,#queryHighlight { position:absolute; inset:0; width:100%; height:100%; margin:0; border:0; padding:14px 17px; font:14px/1.55 Consolas,"Courier New",monospace; tab-size:4; white-space:pre; overflow:auto }
#queryText { z-index:2; outline:0; resize:none; color:transparent; caret-color:#15285a; background:transparent; -webkit-text-fill-color:transparent }
#queryText::selection { background:rgba(82,116,223,.25) }
#queryHighlight { z-index:1; pointer-events:none; color:#17213a }
.sql-keyword { color:#165dcc; font-weight:650 }.sql-function { color:#7c3aed }.sql-string { color:#16803b }.sql-comment { color:#82906f; font-style:italic }.sql-number { color:#b45309 }.sql-parameter { color:#c026d3; font-weight:650 }
.result-wrap { overflow:auto; position:relative; min-height:0; height:100%; scrollbar-gutter:stable }
.result-wrap table { border-collapse:collapse; min-width:100%; font-size:13px }
.result-wrap tbody { display:table-row-group }
.result-wrap th { position:sticky; top:0; background:#eef2f7; color:#23314d; text-align:left; border-bottom:1px solid #cbd4e2; padding:9px 18px 9px 11px; white-space:nowrap; user-select:none; cursor:pointer; overflow:hidden; text-overflow:ellipsis }
.result-wrap th .sort-mark { margin-left:5px; color:#5573d1 }
.column-resizer { position:absolute; top:0; right:0; width:6px; height:100%; cursor:col-resize }
.result-wrap td { padding:7px 11px; border-bottom:1px solid #e5e9f0; white-space:nowrap }
.result-wrap tr:nth-child(even) { background:#fafbfd }
.result-wrap tr.edit-dirty { background:#fff7d6 }.result-wrap tr.edit-new { background:#eaf8ef }.result-wrap tr.edit-deleted { background:#fdeaea;text-decoration:line-through;opacity:.75 }
.result-wrap td.edit-cell { padding:0 }.result-wrap td.edit-cell input { width:100%; min-width:70px; border:0; background:transparent; padding:7px 10px; color:#17213a; outline:none }.result-wrap td.edit-cell input:focus { box-shadow:inset 0 0 0 2px #6385ed;background:white }.result-wrap td.edit-readonly { color:#7c8799;background:#f3f5f8 }.result-wrap td.row-action { width:38px;padding:3px 5px;position:sticky;left:0;background:inherit }.result-wrap td.row-action button { padding:2px 7px;color:#a63830;background:transparent;border:0 }.result-wrap th.row-action-head { width:38px;min-width:38px }
.empty { position:absolute; inset:0; display:grid; place-items:center; color:#7d879b }
.autocomplete { position:absolute; z-index:30; width:min(360px,70%); max-height:260px; overflow:auto; background:white; border:1px solid #aebbd0; border-radius:9px; box-shadow:0 12px 35px rgba(15,23,42,.2) }
.autocomplete button { display:block; width:100%; border:0; border-radius:0; text-align:left; padding:8px 12px; font:13px Consolas,"Courier New",monospace }
.autocomplete button:hover,.autocomplete button.active { background:#e8efff }
.autocomplete small { float:right; color:#8490a4 }
.result-text.message-result { color:#a12820; white-space:pre-wrap; font-family:"Segoe UI",sans-serif; }
.table-alias { min-width:18px; color:#203b75; font-weight:800; text-align:right; }
.hidden { display:none!important }
.join-panel { border-top:1px solid #ccd5e3; border-bottom:1px solid #ccd5e3; background:#f3f6fb; min-height:180px; max-height:340px; overflow:auto }
.join-head { display:flex; justify-content:space-between; align-items:center; padding:9px 13px }
.join-head small { display:block; color:#768198 }
.join-canvas { display:flex; gap:14px; padding:10px 14px 16px; align-items:start; overflow:auto }
.join-table { min-width:180px; background:white; border:1px solid #bdc9da; border-radius:9px; box-shadow:0 3px 10px rgba(25,36,61,.08) }
.join-table b { display:block; padding:9px 11px; background:#e9effb }
.join-table span { display:block; padding:5px 11px; color:#5b6880; font-size:12px }
.muted { color:#7b8699 }
.selection-card { background:white; border:1px solid #d7deea; border-radius:9px; padding:12px }
.side-tools { display:grid; grid-template-columns:1fr 1fr; gap:5px; margin-bottom:10px }.side-tools button { padding:6px 5px; font-size:11px }.side-tools button:disabled { opacity:.45; cursor:not-allowed }.tool-panel { margin-bottom:10px }.tool-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:6px }.tool-head h2 { margin:0 }.tool-search { width:100%; padding:6px; border:1px solid #ccd5e3; border-radius:6px; margin-bottom:6px }.function-list,.parameter-list { display:grid; gap:4px; overflow:auto }.parameter-mode .parameter-list { max-height:none; overflow:visible }.tool-subhead { margin:10px 0 4px; color:#4f5d75; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.04em }.function-item,.parameter-item { border:1px solid #d7deea; border-radius:6px; background:white; padding:6px 7px; font-size:12px; cursor:pointer }.function-item:hover,.parameter-item:hover { border-color:#6686ee; background:#f0f4ff }.function-item b,.parameter-item b { display:block }.function-item small,.parameter-item small { display:block; color:#748097; margin-top:1px; font-size:11px }.parameter-warning { color:#a33; font-size:11px; margin-top:6px }
.context-menu { position:fixed; z-index:1000; min-width:210px; max-height:min(520px,80vh); overflow:auto; padding:5px; background:white; border:1px solid #bdc7d7; border-radius:8px; box-shadow:0 12px 36px rgba(15,23,42,.25) }
.context-menu button,.context-menu label { display:flex; width:100%; align-items:center; gap:7px; border:0; border-radius:5px; padding:7px 9px; text-align:left; background:white; color:#25324e; font-size:12px }
.context-menu button:hover,.context-menu label:hover { background:#edf2ff }
.context-menu hr { border:0; border-top:1px solid #e1e6ef; margin:4px }
.context-menu .menu-title { padding:5px 9px; color:#6c7890; font-size:10px; font-weight:700; text-transform:uppercase }
.context-menu select { margin-left:auto; max-width:105px }
.join-item { background:white; border:1px solid #d7deea; border-radius:8px; padding:9px; margin-bottom:7px; font-size:12px }
.join-item button { float:right; padding:2px 6px; color:#a33 }
.modal { position:fixed; inset:0; z-index:2000; background:rgba(15,23,42,.5); display:grid; place-items:center; pointer-events:auto }
.modal .dialog{position:relative;z-index:2001;pointer-events:auto}
.dialog { width:min(650px,94vw); max-height:90vh; overflow:auto; background:#f8fafc; border-radius:15px; padding:24px; box-shadow:0 24px 70px rgba(0,0,0,.3) }
.dialog h2 { margin-top:0 }
.dialog label { display:grid; gap:6px; color:#59677f; margin-bottom:13px }
.dialog select { padding:9px; border:1px solid #c8d2e1; border-radius:8px }
.two { display:grid; grid-template-columns:1fr 1fr; gap:12px }
.clause { display:grid; grid-template-columns:1fr 28px 1fr 32px; gap:7px; align-items:center; margin:8px 0 }
.clause button { padding:5px }
.dialog-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:20px }
.dialog .apply { background:#5274df; color:white }
.filter-dialog { width:min(540px,94vw) }
.filter-head { display:flex; justify-content:space-between; align-items:start }
.filter-head h2 { margin-bottom:3px }
.filter-dialog>input { width:100%; padding:8px; border:1px solid #c8d2e1; border-radius:7px }
.filter-select-all { display:flex!important; flex-direction:row!important; align-items:center; gap:7px; margin:10px 0!important }
.filter-values { max-height:330px; overflow:auto; border:1px solid #d7deea; border-radius:8px; padding:6px }
.filter-values label { display:flex; flex-direction:row; align-items:center; gap:7px; margin:0; padding:5px 7px; border-radius:5px }
.filter-values label:hover { background:#edf2ff }
.filter-dialog details pre { font:12px/1.45 Consolas,monospace; white-space:pre-wrap }
.toast { position:fixed; right:24px; bottom:22px; padding:12px 16px; background:#17213a; color:white; border-radius:9px; box-shadow:0 8px 30px rgba(0,0,0,.25) }
@media(max-width:950px) { main { grid-template-columns:240px 4px minmax(420px,1fr) 0 0 } .inspector,.right-splitter { display:none } .toolbar label { display:none } }
