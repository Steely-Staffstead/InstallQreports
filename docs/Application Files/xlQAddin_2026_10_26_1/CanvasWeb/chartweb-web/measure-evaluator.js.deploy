(() => {
  const ci=(object,...names)=>{for(const [key,value] of Object.entries(object||{}))if(names.some(name=>key.toLowerCase()===String(name).toLowerCase()))return value;};
  const metricName=metric=>String(ci(metric,"OutputName","Name")||"");
