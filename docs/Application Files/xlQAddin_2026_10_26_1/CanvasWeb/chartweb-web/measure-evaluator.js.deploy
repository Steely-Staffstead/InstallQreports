  const parameterScalar=(parameter,property="")=>{const name=parameterName(parameter),prop=String(property||"value").toLowerCase();if(prop==="name")return name;if(["displayname","label"].includes(prop))return ci(parameter,"DisplayName")??name;if(prop==="description")return ci(parameter,"Description")??"";if(["count","selectedcount"].includes(prop)){const values=ci(parameter,"CurrentValues");return Array.isArray(values)?values.length:(ci(parameter,"CurrentValue")??ci(parameter,"DefaultValue")??"")===""?0:1;}if(["default","defaultvalue"].includes(prop))return ci(parameter,"DefaultValue")??"";if(["display","displayvalue","displayvalues","currentdisplay","currentdisplayvalue"].includes(prop))return ci(parameter,"CurrentDisplayValue")??ci(parameter,"CurrentDisplayValues")?.[0]??ci(parameter,"CurrentValue")??ci(parameter,"DefaultValue")??"";return ci(parameter,"CurrentValue")??ci(parameter,"CurrentValues")?.[0]??ci(parameter,"DefaultValue")??"";};
  const parameterLiteral=(parameter,property="")=>{const value=parameterScalar(parameter,property),mode=parameterMode(parameter);if(mode===2)return`"${String(value).replaceAll('"','""')}"`;if(mode===1)return`'${String(value).replaceAll("'","''")}'`;return String(value);};
  const patchParameters=(formula,parameters)=>{const map=new Map((parameters||[]).filter(Boolean).map(parameter=>[parameterName(parameter).toLowerCase(),parameter]));if(!map.size)return String(formula||"");return String(formula||"").replace(/{{\s*([^{}]+?)\s*}}/g,(token,reference)=>{const clean=String(reference).trim(),dot=clean.indexOf("."),name=(dot>0?clean.slice(0,dot):clean).trim(),property=dot>0?clean.slice(dot+1).trim():"",parameter=map.get(name.toLowerCase());return parameter?parameterLiteral(parameter,property):token;});};
  const pad=(value,length=2)=>String(value).padStart(length,'0');
  const wholeDateDifference=(startValue,endValue,interval)=>{const start=new Date(startValue),end=new Date(endValue);if(!Number.isFinite(start.getTime())||!Number.isFinite(end.getTime()))return NaN;const part=unquote(interval).trim().toLowerCase();if(["day","days","dd","d"].includes(part)){const startDay=Date.UTC(start.getFullYear(),start.getMonth(),start.getDate()),endDay=Date.UTC(end.getFullYear(),end.getMonth(),end.getDate());return Math.round((endDay-startDay)/86400000);}const direction=end>=start?1:-1,earlier=direction>0?start:end,later=direction>0?end:start,clampedDate=(year,month,day)=>new Date(year,month,Math.min(day,new Date(year,month+1,0).getDate()),earlier.getHours(),earlier.getMinutes(),earlier.getSeconds(),earlier.getMilliseconds());let result,anniversary;if(["year","years","yy","yyyy"].includes(part)){result=later.getFullYear()-earlier.getFullYear();anniversary=clampedDate(earlier.getFullYear()+result,earlier.getMonth(),earlier.getDate());}else if(["month","months","mm","m"].includes(part)){result=(later.getFullYear()-earlier.getFullYear())*12+later.getMonth()-earlier.getMonth();const totalMonth=earlier.getMonth()+result,year=earlier.getFullYear()+Math.floor(totalMonth/12),month=((totalMonth%12)+12)%12;anniversary=clampedDate(year,month,earlier.getDate());}else return NaN;if(anniversary>later)result--;return result*direction;};
  const isoWeek=value=>{const date=value instanceof Date?new Date(value):new Date(value);if(!Number.isFinite(date.getTime()))return NaN;const target=new Date(date.getFullYear(),date.getMonth(),date.getDate());target.setDate(target.getDate()+3-(target.getDay()+6)%7);const week1=new Date(target.getFullYear(),0,4);return 1+Math.round(((target-week1)/86400000-3+(week1.getDay()+6)%7)/7);};
  const formatValue=(value,pattern)=>{pattern=unquote(pattern);if(value===null||value===undefined||value===''||(typeof value==='number'&&!Number.isFinite(value)))return'';if(/^text$/i.test(pattern))return String(value);const parsedDate=value instanceof Date?value:new Date(value);if(Number.isFinite(parsedDate.getTime())&&/[yMdHhms]/.test(pattern)){const replacements={yyyy:pad(parsedDate.getFullYear(),4),yyy:pad(parsedDate.getFullYear(),4),yy:pad(parsedDate.getFullYear()%100),MMMM:new Intl.DateTimeFormat(undefined,{month:'long'}).format(parsedDate),MMM:new Intl.DateTimeFormat(undefined,{month:'short'}).format(parsedDate),MM:pad(parsedDate.getMonth()+1),M:String(parsedDate.getMonth()+1),dddd:new Intl.DateTimeFormat(undefined,{weekday:'long'}).format(parsedDate),ddd:new Intl.DateTimeFormat(undefined,{weekday:'short'}).format(parsedDate),dd:pad(parsedDate.getDate()),d:String(parsedDate.getDate()),HH:pad(parsedDate.getHours()),H:String(parsedDate.getHours()),mm:pad(parsedDate.getMinutes()),ss:pad(parsedDate.getSeconds())};return pattern.replace(/yyyy|yyy|yy|MMMM|MMM|MM|M|dddd|ddd|dd|d|HH|H|mm|ss/g,token=>replacements[token]);}const number=Number(value);if(Number.isFinite(number)){const decimals=/[0#][.,]([0#]+)/.exec(pattern)?.[1].length;if(Number.isInteger(decimals))return number.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals});if(/^N\d+$/i.test(pattern)){const digits=Number(pattern.slice(1));return number.toLocaleString(undefined,{minimumFractionDigits:digits,maximumFractionDigits:digits});}}return String(value);};
  const stripOuter=text=>{text=text.trim();while(text[0]==="("&&text.at(-1)===")"){let depth=0,whole=true;for(let i=0;i<text.length;i++){if(text[i]==="(")depth++;else if(text[i]===")")depth--;if(depth===0&&i<text.length-1){whole=false;break;}}if(!whole)break;text=text.slice(1,-1).trim();}return text;};
  function topOperator(text,operators){let depth=0,quote="";for(let i=text.length-1;i>=0;i--){const ch=text[i];if(quote){if(ch===quote&&text[i-1]!=="\\")quote="";continue;}if(ch==='"'||ch==="'"){quote=ch;continue;}if(ch===")")depth++;else if(ch==="(")depth--;else if(depth===0&&operators.includes(ch)){if((ch==="+"||ch==="-")&&(i===0||"(,+-*/".includes(text[i-1])))continue;return i;}}return-1;}
  function topComparison(text){let depth=0,quote="";for(let i=0;i<text.length;i++){const ch=text[i];if(quote){if(ch===quote&&text[i-1]!=="\\")quote="";continue;}if(ch==='"'||ch==="'"){quote=ch;continue;}if(ch==="(")depth++;else if(ch===")")depth--;else if(depth===0){const pair=text.slice(i,i+2);if(["<>","!=",">=","<="].includes(pair))return{at:i,operator:pair};if(["=",">","<"].includes(ch))return{at:i,operator:ch};}}return null;}
  const reduce=(values,kind)=>{const present=values.filter(value=>value!==null&&value!==undefined&&String(value).trim()!==''),mode=String(kind||'').toUpperCase();if(mode==='COUNT')return present.length;if(mode==='FIRST')return present[0]??'';if(mode==='LAST')return present.at(-1)??'';if(mode==='MIN'||mode==='MAX'){if(!present.length)return'';const numbers=present.map(numericValue);if(numbers.every(Number.isFinite)){const target=mode==='MIN'?Math.min(...numbers):Math.max(...numbers);return present[numbers.indexOf(target)];}const dates=present.map(value=>Date.parse(value));if(dates.every(Number.isFinite)){const target=mode==='MIN'?Math.min(...dates):Math.max(...dates);return present[dates.indexOf(target)];}return [...present].sort((a,b)=>String(a).localeCompare(String(b),undefined,{numeric:true,sensitivity:'base'}))[mode==='MIN'?0:present.length-1];}const numbers=present.map(numericValue).filter(Number.isFinite);if(!numbers.length)return mode==='SUM'?0:NaN;if(/average|avg/i.test(mode))return numbers.reduce((a,b)=>a+b,0)/numbers.length;return numbers.reduce((a,b)=>a+b,0);};
  const bitNumber=value=>{if(value==null||value==='')return NaN;const text=String(value).trim().toLowerCase();if(text==='true')return 1;if(text==='false')return 0;return numericValue(value);};
  function compare(left,operator,right){const a=bitNumber(left),b=bitNumber(right),numeric=Number.isFinite(a)&&Number.isFinite(b),x=numeric?a:String(left??"").toLowerCase(),y=numeric?b:String(right??"").toLowerCase();if(operator==="=")return x===y;if(operator==="<>"||operator==="!=")return x!==y;if(operator===">")return x>y;if(operator==="<")return x<y;if(operator===">=")return x>=y;if(operator==="<=")return x<=y;return false;}
  function filtered(rows,filter,columns){const match=/^\s*(.+?)\s*(<>|!=|>=|<=|=|>|<)\s*(.*?)\s*$/.exec(filter);if(!match){const index=fieldIndex(columns,filter);return index<0?rows:rows.filter(row=>{const value=bitNumber(row[index]);return Number.isFinite(value)&&value!==0;});}const index=fieldIndex(columns,match[1]);if(index<0)return rows;let expected=match[3].trim();if((expected[0]==="'"&&expected.at(-1)==="'")||(expected[0]==='"'&&expected.at(-1)==='"'))expected=expected.slice(1,-1);return rows.filter(row=>compare(row[index],match[2],expected));}
  function create(data,measures,parameters=data?.parameters||[]){const columns=data?.columns||[],allRows=data?.rows||[],map=new Map((measures||[]).map(metric=>[metricName(metric).toLowerCase(),metric])),linked=new Map((data?.linkedMeasures||[]).filter(item=>item?.name&&item?.measure&&item?.data).map(item=>[String(item.name).toLowerCase(),item])),linkedEvaluators=new Map();let rowContext=null;
    const linkedKey=value=>window.CanvasSourceRelationships?.part?window.CanvasSourceRelationships.part(value):value==null?"∅":String(value).trim().toLocaleLowerCase();
    function linkedValue(binding,rows,aggregation){
      const mappings=Array.isArray(binding.keys)?binding.keys:[],relatedData=binding.data||{},relatedColumns=relatedData.columns||[],primaryIndexes=mappings.map(item=>fieldIndex(columns,item.primaryField)),relatedIndexes=mappings.map(item=>fieldIndex(relatedColumns,item.relatedField));
      if(!mappings.length||primaryIndexes.some(index=>index<0)||relatedIndexes.some(index=>index<0))return NaN;
      const keys=new Set((rows||[]).map(row=>JSON.stringify(primaryIndexes.map(index=>linkedKey(row[index]))))),relatedRows=(relatedData.rows||[]).filter(row=>keys.has(JSON.stringify(relatedIndexes.map(index=>linkedKey(row[index])))));
      let evaluator=linkedEvaluators.get(binding);if(!evaluator){evaluator=create(relatedData,binding.measures||[],parameters);linkedEvaluators.set(binding,evaluator);}
      return evaluator.evaluate(binding.measure,relatedRows,aggregation);
    }
    function expression(source,rows,visiting=new Set(),variables=new Map()){
      let text=stripOuter(String(source||"").replace(/\s*-{2,}\s*/g," - ").replace(/\r?\n/g," ").trim());if(!text)return NaN;
      if(/^VAR\b/i.test(text)){
        const local=new Map(variables),returnAt=text.search(/\bRETURN\b/i);if(returnAt<0)return NaN;
        const declarations=text.slice(0,returnAt),pattern=/\bVAR\s+([A-Z_][A-Z0-9_]*)\s*=\s*([\s\S]*?)(?=\bVAR\s+[A-Z_][A-Z0-9_]*\s*=|$)/gi;let match;
        while((match=pattern.exec(declarations)))local.set(match[1].toLowerCase(),expression(match[2],rows,visiting,local));
        return expression(text.slice(returnAt+6),rows,visiting,local);
      }
      if(text[0]==="-")return-expression(text.slice(1),rows,visiting,variables);
      if(text[0]==="+")return expression(text.slice(1),rows,visiting,variables);
      const comparison=topComparison(text);if(comparison){const left=expression(text.slice(0,comparison.at),rows,visiting,variables),right=expression(text.slice(comparison.at+comparison.operator.length),rows,visiting,variables);return compare(left,comparison.operator,right);}
      let at=topOperator(text,["&"]);if(at>=0)return String(expression(text.slice(0,at),rows,visiting,variables)??'')+String(expression(text.slice(at+1),rows,visiting,variables)??'');
      at=topOperator(text,["+","-"]);if(at>=0){const a=expression(text.slice(0,at),rows,visiting,variables),b=expression(text.slice(at+1),rows,visiting,variables);return text[at]==="+"?a+b:a-b;}
      at=topOperator(text,["*","/"]);if(at>=0){const a=expression(text.slice(0,at),rows,visiting,variables),b=expression(text.slice(at+1),rows,visiting,variables);return text[at]==="*"?a*b:(b===0?NaN:a/b);}
      const len=/^LEN\s*\(([\s\S]*)\)$/i.exec(text);if(len){const args=splitArgs(len[1]);return args.length===1?String(expression(args[0],rows,visiting,variables)??'').length:NaN;}
      if(/^TRUE\s*\(\s*\)$/i.test(text))return true;if(/^FALSE\s*\(\s*\)$/i.test(text))return false;
      const switchFn=/^SWITCH\s*\(([\s\S]*)\)$/i.exec(text);if(switchFn){const args=splitArgs(switchFn[1]),selected=expression(args[0],rows,visiting,variables),hasFallback=(args.length-1)%2===1,limit=hasFallback?args.length-1:args.length;for(let index=1;index+1<limit;index+=2)if(compare(selected,"=",expression(args[index],rows,visiting,variables)))return expression(args[index+1],rows,visiting,variables);return hasFallback?expression(args.at(-1),rows,visiting,variables):NaN;}
      const fn=/^([A-Z][A-Z0-9_]*)\s*\(([\s\S]*)\)$/i.exec(text);if(fn){const name=fn[1].toUpperCase(),args=splitArgs(fn[2]);if(name==="IF"){const condition=expression(args[0],rows,visiting,variables);return expression(condition?args[1]:(args[2]??'""'),rows,visiting,variables);}if(name==="CALCULATE"){let scoped=rows;for(const filter of args.slice(1))scoped=filtered(scoped,filter,columns);return expression(args[0],scoped,visiting,variables);}if(name==="DISTINCTCOUNT"){const index=fieldIndex(columns,args[0]);if(index<0)return NaN;const keys=new Set(rows.map(row=>{const value=row[index];return value==null||value===""?"blank":`${typeof value}:${String(value)}`;}));return keys.size;}if(["SUM","AVERAGE","AVG","MIN","MAX","COUNT","FIRST","LAST"].includes(name)){let scoped=rows;for(const filter of args.slice(1))scoped=filtered(scoped,filter,columns);const index=fieldIndex(columns,args[0]),values=index>=0?scoped.map(row=>row[index]):scoped.map(row=>{const previous=rowContext;rowContext=row;try{return expression(args[0],[row],visiting,variables);}finally{rowContext=previous;}});return reduce(values,name);}if(name==="CONCATVALUES"){const index=fieldIndex(columns,args[0]);if(index<0||args.length>4)return "";const separator=args[1]===undefined?", ":String(expression(args[1],rows,visiting,variables)??""),limit=args[2]===undefined?Infinity:Math.max(0,Math.trunc(Number(expression(args[2],rows,visiting,variables))||0)),distinct=args[3]===undefined?true:!(/^(false|false\(\)|0|no)$/i.test(unquote(args[3])));if(limit===0)return "";const seen=new Set(),values=[];for(const row of rows){const raw=row[index];if(raw==null||String(raw).trim()==="")continue;const value=String(raw);if(distinct&&seen.has(value))continue;seen.add(value);values.push(value);if(values.length>=limit)break;}return values.join(separator);}if(name==="FORMAT")return formatValue(expression(args[0],rows,visiting,variables),args[1]||'');if(name==="CONCATENATE")return args.map(arg=>expression(arg,rows,visiting,variables)).filter(value=>value!==null&&value!==undefined).join('');if(name==="MID"){const source=String(expression(args[0],rows,visiting,variables)??''),start=Math.max(1,Math.trunc(Number(expression(args[1],rows,visiting,variables))||1)),length=Math.max(0,Math.trunc(Number(expression(args[2],rows,visiting,variables))||0));return source.slice(start-1,start-1+length);}if(name==="CAST"){const value=expression(args[0],rows,visiting,variables),type=unquote(args[1]).toLowerCase();if(["string","text","varchar","nvarchar","char"].includes(type))return value==null?'':String(value);if(["date","datetime","datetime2"].includes(type)){const date=new Date(value);return Number.isFinite(date.getTime())?date.toISOString():NaN;}if(["int","integer","long","bigint"].includes(type)){const number=Number(String(value).replace(',','.'));return Number.isFinite(number)?Math.trunc(number):NaN;}if(["number","numeric","decimal","double","float","real"].includes(type)){const number=Number(String(value).replace(',','.'));return Number.isFinite(number)?number:NaN;}if(["bool","boolean","bit"].includes(type)){if(typeof value==='boolean')return value;const normalized=String(value??'').trim().toLowerCase();if(["true","1","yes"].includes(normalized))return true;if(["false","0","no"].includes(normalized))return false;return NaN;}return NaN;}if(["YEAR","MONTH","DAY","WEEK"].includes(name)){const date=new Date(expression(args[0],rows,visiting,variables));return Number.isFinite(date.getTime())?(name==="YEAR"?date.getFullYear():name==="MONTH"?date.getMonth()+1:name==="DAY"?date.getDate():isoWeek(date)):NaN;}if(name==="DATEDIFF"){if(args.length!==3)return NaN;return wholeDateDifference(expression(args[0],rows,visiting,variables),expression(args[1],rows,visiting,variables),args[2]);}if(name==="DATEPART"){const part=unquote(args[0]).toLowerCase(),date=new Date(expression(args[1],rows,visiting,variables));if(!Number.isFinite(date.getTime()))return NaN;if(["yy","yyyy","year"].includes(part))return date.getFullYear();if(["qq","q","quarter"].includes(part))return Math.floor(date.getMonth()/3)+1;if(["mm","m","month"].includes(part))return date.getMonth()+1;if(["dy","y","dayofyear"].includes(part)){const start=new Date(date.getFullYear(),0,0);return Math.floor((date-start)/86400000);}if(["dd","d","day"].includes(part))return date.getDate();if(["wk","ww","week"].includes(part))return isoWeek(date);if(["dw","weekday"].includes(part))return(date.getDay()+6)%7+1;if(["hh","hour"].includes(part))return date.getHours();if(["mi","n","minute"].includes(part))return date.getMinutes();if(["ss","s","second"].includes(part))return date.getSeconds();return NaN;}if(name==="DATEFROMPARTS"){const year=Number(expression(args[0],rows,visiting,variables)),month=Number(expression(args[1],rows,visiting,variables)),day=Number(expression(args[2],rows,visiting,variables)),date=new Date(year,month-1,day);return Number.isInteger(year)&&Number.isInteger(month)&&Number.isInteger(day)&&date.getFullYear()===year&&date.getMonth()===month-1&&date.getDate()===day?`${String(year).padStart(4,'0')}-${pad(month)}-${pad(day)}`:NaN;}if(name==="DIVIDE"){const a=expression(args[0],rows,visiting,variables),b=expression(args[1],rows,visiting,variables);return b===0?expression(args[2]||"0",rows,visiting,variables):a/b;}if(name==="NEG")return-expression(args[0],rows,visiting,variables);return NaN;}
      if((text[0]==='"'&&text.at(-1)==='"')||(text[0]==="'"&&text.at(-1)==="'"))return unquote(text);const number=numericValue(text);if(Number.isFinite(number))return number;const ref=text.replace(/^\[|\]$/g,"").trim();if(variables.has(ref.toLowerCase()))return variables.get(ref.toLowerCase());const metric=map.get(ref.toLowerCase());if(metric){if(visiting.has(ref.toLowerCase()))return NaN;const next=new Set(visiting);next.add(ref.toLowerCase());return expression(patchParameters(metricFormula(metric),parameters),rows,next,variables);}const index=fieldIndex(columns,ref);return index<0?NaN:rowContext?rowContext[index]:reduce(rows.map(row=>row[index]),"SUM");
    }
    function evaluate(field,rows=allRows,aggregation="Sum"){const key=String(field||"").toLowerCase(),linkedMetric=linked.get(key);if(linkedMetric)return linkedValue(linkedMetric,rows,aggregation);const metric=map.get(key);if(metric&&isCalculatedColumn(metric)){const previous=rowContext,values=[];try{for(const row of rows){rowContext=row;values.push(expression(patchParameters(metricFormula(metric),parameters),[row],new Set([key])));}}finally{rowContext=previous;}return reduce(values,aggregation);}if(metric)return expression(patchParameters(metricFormula(metric),parameters),rows,new Set([key]));const index=fieldIndex(columns,field);return index>=0?reduce(rows.map(row=>row[index]),aggregation):NaN;}
    function evaluateRow(field,row){const previous=rowContext;rowContext=row;try{return evaluate(field,[row],"First");}finally{rowContext=previous;}}
    return{evaluate,evaluateRow,canEvaluate:field=>fieldIndex(columns,field)>=0||map.has(String(field||"").toLowerCase())||linked.has(String(field||"").toLowerCase()),allRows};
  }
  function materialize(data,measures,parameters=data?.parameters||[]){const result={...(data||{}),columns:[...(data?.columns||[])],types:[...(data?.types||[])],rows:(data?.rows||[]).map(row=>[...row])};for(const metric of(measures||[]).filter(isCalculatedColumn)){const name=metricName(metric);if(!name||fieldIndex(result.columns,name)>=0)continue;const evaluator=create(result,withVolatileDates(measures),parameters),values=result.rows.map(row=>evaluator.evaluateRow(name,row));result.columns.push(name);result.types.push(values.some(value=>typeof value==='number'&&Number.isFinite(value))?'System.Double':values.some(value=>typeof value==='boolean')?'System.Boolean':'System.String');values.forEach((value,index)=>result.rows[index].push(value));}return result;}
  function withVolatileDates(measures){const now=new Date(),today=`${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}`;return(measures||[]).map(metric=>{const formula=metricFormula(metric);if(!/\bTODAY\s*\(\s*\)/i.test(formula))return metric;const copy={...metric},key=Object.keys(copy).find(name=>["customformula","formula","expression"].includes(name.toLowerCase()))||"Expression";copy[key]=formula.replace(/\bTODAY\s*\(\s*\)/gi,`"${today}"`);return copy;});}
  window.CanvasMeasureEvaluator={create:(data,measures,parameters)=>create(data,withVolatileDates(measures),parameters),materialize:(data,measures,parameters)=>materialize(data,withVolatileDates(measures),parameters)};
})();
