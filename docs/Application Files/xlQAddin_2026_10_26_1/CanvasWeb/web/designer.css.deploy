.resize-handle { display:none; position:absolute; z-index:20; width:10px; height:10px; border:1px solid #aeb7c4; border-radius:50%; background:#eef1f4; touch-action:none; }
.tile.selected:not(.hide-handles) > .resize-handle { display:block; }
.tile.tile-line.selected:not(.hide-handles) > .resize-handle { display:none; }
.resize-nw { left:1px; top:1px; cursor:nwse-resize; }
.resize-ne { right:1px; top:1px; cursor:nesw-resize; }
.resize-sw { left:1px; bottom:1px; cursor:nesw-resize; }
.resize-se { right:1px; bottom:1px; cursor:nwse-resize; }
.corner-rounding-handle { display:none; position:absolute; top:1px; z-index:21; width:10px; height:10px; padding:0; transform:translateX(-50%); border:1px solid #a9a06d; border-radius:50%; background:#f3d56b; box-shadow:none; cursor:ew-resize; touch-action:none; }
.tile.selected:not(.hide-handles):not(.text-editing) > .corner-rounding-handle { display:block; }
body.presentation-mode .corner-rounding-handle,body.excel-export .corner-rounding-handle,body.pdf-export .corner-rounding-handle { display:none!important; }
.page-style { margin-top:18px; padding-top:14px; border-top:1px solid #d9e0e7; }
.page-style > b { display:block; margin-bottom:10px; font-size:12px; }
.workspace.pages-at-bottom { grid-template-rows:minmax(0,1fr) auto 31px; }
.workspace.pages-at-top { grid-template-rows:auto minmax(0,1fr) 31px; }
.canvas-page-bar { display:flex; align-items:center; gap:8px; min-width:0; min-height:44px; padding:5px 10px; border-top:1px solid var(--qreports-grid,#d9e0e7); border-bottom:1px solid transparent; background:var(--qreports-surface,#fff); color:var(--qreports-text,#344054); }
.workspace.pages-at-top .canvas-page-bar { border-top:0; border-bottom-color:var(--qreports-grid,#d9e0e7); }
body.presentation-mode #canvasPageBar { display:none!important; }
.canvas-page-bar > span { flex:none; font-size:12px; font-weight:700; }
.canvas-page-list { display:flex; flex:1; min-width:0; gap:5px; overflow:hidden; padding:2px; }
.canvas-page-list .page-item { flex:0 0 auto; width:auto; max-width:240px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.canvas-page-list .page-item.page-overflowed { display:none; }
.page-overflow-wrap { position:relative; flex:none; align-self:center; }
.page-overflow-button { min-width:36px; font-weight:800; letter-spacing:2px; }
.page-overflow-menu { position:absolute; z-index:3250; top:calc(100% + 5px); right:0; display:grid; width:min(280px,65vw); max-height:min(420px,65vh); padding:6px; gap:2px; overflow:auto; border:1px solid var(--qreports-grid,#cbd5e1); border-radius:8px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#243047); box-shadow:0 14px 34px #10182838; }
.workspace.pages-at-bottom .page-overflow-menu { top:auto; bottom:calc(100% + 5px); }
.page-overflow-menu button { width:100%; padding:8px 10px; overflow:hidden; border-color:transparent; background:transparent; color:inherit; text-align:left; text-overflow:ellipsis; white-space:nowrap; }
.page-overflow-menu button:hover { background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 12%,var(--qreports-surface,#fff)); }
.canvas-page-bar.page-list-tabs { min-height:40px; padding:4px 8px 0; align-items:flex-end; gap:6px; }
.canvas-page-bar.page-list-tabs > span,.canvas-page-bar.page-list-tabs > .icon-button { align-self:center; }
.canvas-page-bar.page-list-tabs .canvas-page-list { align-self:stretch; align-items:flex-end; gap:0; padding:0; }
.canvas-page-bar.page-list-tabs .page-item { min-height:35px; padding:7px 16px; border-radius:7px 7px 0 0; border-color:var(--qreports-grid,#d9e0e7); background:color-mix(in srgb,var(--qreports-header,#eef3f9) 58%,var(--qreports-surface,#fff)); color:color-mix(in srgb,var(--qreports-text,#344054) 72%,var(--qreports-surface,#fff)); }
.canvas-page-bar.page-list-tabs .page-item.active { position:relative; z-index:2; margin-bottom:-1px; border-color:var(--qreports-accent,#4f6ee8); border-bottom-color:var(--designer-subtle,#dfe5eb); background:var(--designer-subtle,#dfe5eb); color:var(--qreports-text,#344054); box-shadow:inset 0 3px var(--qreports-accent,#4f6ee8); }
.canvas-page-bar.page-list-tabs .page-item.active::after { content:""; position:absolute; left:-1px; right:-1px; bottom:-3px; height:4px; background:var(--designer-subtle,#dfe5eb); pointer-events:none; }
.workspace.pages-at-bottom .canvas-page-bar.page-list-tabs { padding:0 8px 4px; align-items:flex-start; }
.workspace.pages-at-bottom .canvas-page-bar.page-list-tabs > span,.workspace.pages-at-bottom .canvas-page-bar.page-list-tabs > .icon-button { align-self:center; }
.workspace.pages-at-bottom .canvas-page-bar.page-list-tabs .canvas-page-list { align-items:flex-start; }
.workspace.pages-at-bottom .canvas-page-bar.page-list-tabs .page-item { border-radius:0 0 7px 7px; border-color:var(--qreports-grid,#d9e0e7); }
.workspace.pages-at-bottom .canvas-page-bar.page-list-tabs .page-item.active { margin-top:-1px; margin-bottom:0; border-color:var(--qreports-accent,#4f6ee8); border-top-color:var(--designer-subtle,#dfe5eb); box-shadow:inset 0 -3px var(--qreports-accent,#4f6ee8); }
.workspace.pages-at-bottom .canvas-page-bar.page-list-tabs .page-item.active::after { top:-3px; bottom:auto; }
.left-panel.page-list-tabs #pageList { gap:0; }
.left-panel.page-list-tabs #pageList .page-item { border-radius:0; border-left:3px solid var(--qreports-grid,#cdd5df); background:transparent; }
.left-panel.page-list-tabs #pageList .page-item.active { border-left-color:var(--qreports-accent,#4f6ee8); background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 10%,var(--qreports-surface,#fff)); }
.page-item[draggable="true"] { cursor:default; user-select:none; }
.page-item[draggable="true"]:active { cursor:grabbing; }
.page-item.dragging { opacity:.45; cursor:grabbing; }
#pageList .page-item.drag-before { box-shadow:inset 0 3px var(--qreports-accent,#4f6ee8); }
#pageList .page-item.drag-after { box-shadow:inset 0 -3px var(--qreports-accent,#4f6ee8); }
#pageBarList .page-item.drag-before { box-shadow:inset 3px 0 var(--qreports-accent,#4f6ee8); }
#pageBarList .page-item.drag-after { box-shadow:inset -3px 0 var(--qreports-accent,#4f6ee8); }
.canvas-page-position-setting { margin-top:12px; }
.field-label { display:block; color:#475467; font-size:12px; margin-bottom:5px; }
.rich-toolbar { display:flex; gap:4px; padding:5px; background:#eef2f6; border:1px solid #cdd5df; border-bottom:0; border-radius:7px 7px 0 0; }
.rich-toolbar button { padding:3px 8px; }
.rich-editor { min-height:110px; max-height:220px; overflow:auto; padding:9px; background:#fff; border:1px solid #cdd5df; border-radius:0 0 7px 7px; font-size:13px; }
.rich-editor:focus { outline:2px solid #83afe9; }
.rich-content p { margin:.35em 0; }
.rich-content ul,.rich-content ol,.inline-rich-editor ul,.inline-rich-editor ol { margin:.35em 0; padding-left:1.6em; list-style-position:outside; }
.rich-content ul,.rich-editor ul,.inline-rich-editor ul,.gantt-description-editor ul,.gantt-description-popover ul { list-style-type:disc; }
.rich-content ul ul,.rich-editor ul ul,.inline-rich-editor ul ul,.gantt-description-editor ul ul,.gantt-description-popover ul ul { list-style-type:circle; }
.rich-content ul ul ul,.rich-editor ul ul ul,.inline-rich-editor ul ul ul,.gantt-description-editor ul ul ul,.gantt-description-popover ul ul ul { list-style-type:square; }
.rich-content ul ul ul ul,.rich-editor ul ul ul ul,.inline-rich-editor ul ul ul ul,.gantt-description-editor ul ul ul ul,.gantt-description-popover ul ul ul ul { list-style-type:disc; }
.rich-content ol,.inline-rich-editor ol { list-style-type:decimal; }
.rich-content li,.inline-rich-editor li { display:list-item; }
.rich-content li::marker,.inline-rich-editor li::marker { color:currentColor; font:inherit; }
.rich-content li[style*="text-align: center"],.rich-content li[style*="text-align: right"],.inline-rich-editor li[style*="text-align: center"],.inline-rich-editor li[style*="text-align: right"] { list-style-position:inside; }
#richTextGroup { margin-bottom:12px; }
main { grid-template-columns:clamp(180px,18vw,230px) minmax(0,1fr) clamp(260px,22vw,320px); overflow:hidden; }
.workspace { min-width:0; overflow:hidden; }
.canvas-viewport { min-width:0; min-height:0; overflow:scroll; scrollbar-gutter:stable; background:#dfe5eb; }
.canvas-viewport.canvas-pan-enabled #canvas { cursor:grab; }
.canvas-viewport.canvas-pan-enabled #canvas>.tile { cursor:auto; }
.canvas-viewport.canvas-pan-active #canvas { cursor:grabbing; user-select:none; }
.tile-picture { min-height:30px; }
.tile-picture,.tile-picture .tile-body,.tile-picture .picture-content,.tile-picture img { cursor:move; }
.tile-picture .tile-body { display:block; background:transparent; }
.tile-picture .picture-content { width:100%; height:100%; }
.tile-picture .picture-content img { display:block; max-width:none; max-height:none; object-fit:contain; }
.tile-picture .picture-width img { width:100%; height:auto; }
.tile-picture .picture-height img { width:auto; height:100%; }
.tile-picture .picture-fit img { width:100%; height:100%; }
#localImagePicker p, #localImagePicker li, #localImagePicker small { font-size:12px; color:var(--qreports-text,#475467); line-height:1.4; }
#localImagePicker a { color:var(--qreports-accent,#2363c5); }
#localImagePicker ul { margin:4px 0 10px; padding-left:20px; }
#localImagePicker p { margin:8px 0 4px; }
.web-export-dialog { width:min(912px,92vw); min-width:min(480px,92vw); min-height:300px; max-width:96vw; max-height:92vh; resize:both; overflow:auto; border:1px solid #cdd5df; border-radius:12px; padding:20px; }
.web-export-dialog::backdrop { background:#18223066; }
.web-export-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:14px; }
.web-export-heading h2 { margin:0; }
.web-export-heading [data-close-x] { flex:0 0 auto; width:42px; height:42px; padding:0; font-size:22px; line-height:1; }
.web-export-layout { display:grid; grid-template-columns:180px minmax(0,1fr); gap:18px; }
[data-export-list] button { display:block; width:100%; text-align:left; margin-bottom:6px; }
[data-export-list] button.active { background:#eaf0ff; border-color:#4f6ee8; }
.web-export-list-row{display:flex;align-items:center;gap:5px}.web-export-list-row>input{flex:none}.web-export-list-row>button{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.web-export-batch{display:grid;gap:6px;margin:8px 0 14px}
.web-export-presets{margin:12px 0;padding:10px;border:1px solid var(--qreports-grid,#cdd5df);border-radius:8px}.web-export-presets h4{margin:0 0 4px}.web-export-presets p{font-size:12px;margin:4px 0 10px}.web-export-preset-row{display:grid;grid-template-columns:minmax(95px,1fr) minmax(95px,1fr) minmax(95px,1fr) 34px;gap:5px;align-items:center;margin:5px 0}.web-export-preset-row select,.web-export-preset-row input{min-width:0;width:100%}.web-export-preset-row button{padding:5px}
.web-export-dialog :is([data-export-list] button,[data-new],.web-export-batch button,.web-export-presets button,.web-export-presets select,.web-export-presets input){font-size:12px;line-height:1.3;box-sizing:border-box}
.web-export-dialog :is([data-new],.web-export-batch button,.web-export-presets button,.web-export-presets select,.web-export-presets input){padding:6px 8px}
.web-export-dialog [data-export-list] button{padding:6px 8px}
.web-export-presets h4{font-size:14px}.web-export-preset-row{grid-template-columns:repeat(3,minmax(95px,1fr)) minmax(34px,auto)}
.web-export-preset-row>[data-remove-preset]{grid-column:-2/-1;grid-row:1/-1;align-self:stretch;padding:4px}
.web-export-preset-row select,.web-export-preset-row input{height:32px}
.web-export-context-menu{position:fixed;z-index:100;min-width:135px;padding:4px;border:1px solid var(--qreports-grid,#cdd5df);border-radius:8px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);box-shadow:0 8px 24px #0003}
.web-export-context-menu button{display:block;width:100%;padding:7px 10px;text-align:left;font-size:12px;background:transparent;color:inherit;border:0}
.web-export-context-menu button:hover,.web-export-context-menu button:focus-visible{background:var(--designer-accent-soft,#eaf0ff)}
.web-export-path { display:flex; align-items:center; gap:6px; }
.web-export-path input { min-width:0; }
.web-export-dialog input[data-name],.web-export-dialog input[data-folder] { display:block; width:100%; box-sizing:border-box; margin-top:5px; padding:8px; border:1px solid #cdd5df; border-radius:7px; }
.web-export-path input[data-folder] { flex:1; }
.web-export-path button { flex:none; }
.web-export-dialog button[data-run] { background:#4f6ee8; color:#fff; }
.export-preview { margin:14px 0; padding:14px; border:1px solid #cdd5df; border-radius:8px; background:#f7f9fc; }
.web-export-layout form { min-width:0; }
.web-export-buttons { display:flex; justify-content:flex-end; gap:6px; margin-top:16px; }
[data-columns] { height:190px; min-height:100px; max-height:60vh; overflow:auto; resize:vertical; border:1px solid #cdd5df; border-radius:8px; padding:10px; margin-top:10px; scrollbar-gutter:stable; }
.web-export-dialog details > summary { margin-bottom:14px; }
.web-export-dialog [data-columns] fieldset { border:0; margin:0 0 12px; padding:0; min-width:0; }
.web-export-dialog [data-columns] legend { font-size:13px; font-weight:600; margin-bottom:8px; }
.web-export-dialog [data-columns] .web-export-filter-source { margin:0; padding:0; border:1px solid var(--qreports-grid,#cdd5df); border-radius:7px; overflow:hidden; }
.web-export-dialog [data-columns] .web-export-filter-source > summary { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:0; padding:9px 11px; cursor:pointer; font-size:13px; font-weight:700; background:var(--designer-raised,#f7f9fc); }
.web-export-dialog [data-columns] .web-export-filter-source > summary small { margin-left:auto; font-weight:400; white-space:nowrap; }
.web-export-dialog [data-columns] .web-export-filter-source[open] > summary { margin-bottom:8px; border-bottom:1px solid var(--qreports-grid,#cdd5df); }
.web-export-dialog [data-columns] .web-export-filter-source > label.check { margin-left:10px; margin-right:10px; }
.web-export-dialog [data-columns] label.check { display:grid; grid-template-columns:auto minmax(90px,1fr) minmax(110px,1fr) minmax(130px,1fr) auto; align-items:center; gap:6px; margin:0 0 6px; font-size:12px; }
.web-export-dialog [data-columns] label.check>select,.web-export-dialog [data-columns] .filter-dependency select { box-sizing:border-box; min-width:0; width:100%; padding:5px; font-size:12px; }
.web-export-dialog [data-columns] .filter-dependency { display:grid; gap:2px; font-size:11px; }
.web-export-dialog [data-columns] .filter-order { display:flex; gap:2px; }
.web-export-dialog [data-columns] .filter-order button { padding:3px 6px; font-size:12px; line-height:1.2; }
.chart-margin-controls line { stroke:transparent; stroke-width:8; pointer-events:stroke; cursor:ew-resize; }
.chart-margin-controls line[data-margin-handle="top"],.chart-margin-controls line[data-margin-handle="bottom"] { cursor:ns-resize; }
.chart-margin-controls line:hover { stroke:#4f6ee880; }
.rich-content a { color:#2363c5; text-decoration:underline; }
.web-export-dialog small,.web-export-dialog [data-last] { font-size:11px; color:#667085; }
.canvas { min-width:0; min-height:0; overflow:hidden; margin:0 auto; }
.canvas.canvas-has-visible-text { overflow:visible; }
:root { --left-pane-width:205px; --right-pane-width:285px; }
main { grid-template-columns:var(--left-pane-width) 7px minmax(420px,1fr) 7px var(--right-pane-width); }
.left-panel { grid-column:1; }
.left-splitter { grid-column:2; }
.workspace { grid-column:3; }
.right-splitter { grid-column:4; }
.right-panel { grid-column:5; }
.right-panel { position:relative; z-index:4; min-width:0; overflow:auto; box-shadow:-2px 0 6px #18223012; }
.left-panel { min-width:0; }
.pane-splitter { position:relative; z-index:7; background:#e2e8f0; cursor:col-resize; touch-action:none; }
.pane-splitter:hover,.pane-splitter.resizing { background:#6f91e8; }
main.left-collapsed { grid-template-columns:34px 0 minmax(420px,1fr) 7px var(--right-pane-width); }
main.right-collapsed { grid-template-columns:var(--left-pane-width) 7px minmax(420px,1fr) 0 34px; }
main.left-collapsed.right-collapsed { grid-template-columns:34px 0 minmax(420px,1fr) 0 34px; }
main.left-collapsed .left-splitter,main.right-collapsed .right-splitter { display:none; }
main.left-collapsed .left-panel,main.right-collapsed .right-panel{padding:0;overflow:hidden;position:relative}main.left-collapsed .left-panel>*:not(.pane-tab),main.right-collapsed .right-panel>*:not(.pane-tab){display:none}.pane-tab{display:none;position:absolute;inset:0;padding:0;writing-mode:vertical-rl;border:0;border-radius:0;background:#eef2fa;color:#354365;font-weight:700;text-transform:uppercase;letter-spacing:.07em}main.left-collapsed .left-panel .pane-tab,main.right-collapsed .right-panel .pane-tab{display:block}.tile-settings{border-top:1px solid #dce2ec;margin-top:10px;padding-top:10px}.tile-settings>summary{cursor:pointer;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64728d;font-size:12px;margin-bottom:12px}
.panel-tabs { position:sticky; top:-16px; z-index:40; display:grid; grid-template-columns:1fr 1fr; gap:4px; margin:-16px -16px 16px; padding:16px 16px 10px; background:var(--qreports-surface,#f9fafb); border-bottom:1px solid var(--qreports-grid,#d9e0e7); box-shadow:0 5px 10px color-mix(in srgb,var(--qreports-text,#182230) 8%,transparent); }
.panel-tabs button.active { color:#174e9d; border-color:#8ab4ee; background:#eaf2fd; font-weight:700; }
#filtersPanel > button { margin:4px 4px 8px 0; }
.filter-row { padding:10px; margin-bottom:8px; border:1px solid #d7dee7; border-radius:8px; background:#fff; }
.filter-row select,.filter-row input { margin:3px 0; }
.filter-row .remove-filter { float:right; padding:2px 7px; color:#a83b32; }
.rich-toolbar { flex-wrap:wrap; }
.rich-toolbar select { width:auto; margin:0; padding:3px; }
.rich-toolbar input[type=color] { width:30px; height:28px; }
.rich-toolbar button[aria-pressed="true"] { color:#174e9d; border-color:#79aaf0; background:#e8f1ff; }
.text-edit-mode { display:grid; gap:6px; margin:6px 0 9px; }
.text-edit-mode>span { min-width:0; color:#667085; font-size:12px; line-height:1.2; }
.text-edit-mode>div { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:5px; }
.text-edit-mode button { min-width:0; padding:5px 7px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.text-edit-mode button:only-child { grid-column:1/-1; }
#richTextGroup:not(.property-text-editing)>.rich-toolbar { display:none; }
.rich-editor-readonly { min-height:64px; max-height:150px; cursor:default; opacity:.86; }
.whole-text-note { margin:0 0 8px; color:#667085; font-size:12px; line-height:1.35; }
#textLayoutSettings>summary{margin-bottom:12px}#textVerticalAlignControl{display:grid;gap:7px}#textVerticalAlignControl>small{color:#667085;font-size:11px;line-height:1.35}.text-vertical-align-buttons{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.text-vertical-align-buttons button{display:grid;place-items:center;min-width:0;height:42px;padding:6px}.text-vertical-align-buttons button[aria-pressed="true"]{border-color:var(--qreports-accent,#506fbd);background:color-mix(in srgb,var(--qreports-accent,#506fbd) 15%,var(--qreports-surface,#fff));color:var(--qreports-accent,#506fbd);box-shadow:inset 0 0 0 1px var(--qreports-accent,#506fbd)}.text-vertical-align-icon{position:relative;display:block;width:24px;height:18px;border:1px solid currentColor;border-radius:2px}.text-vertical-align-icon:after{content:"";position:absolute;right:4px;left:4px;height:2px;border-radius:2px;background:currentColor}.text-vertical-align-icon.top:after{top:3px}.text-vertical-align-icon.middle:after{top:50%;transform:translateY(-50%)}.text-vertical-align-icon.bottom:after{bottom:3px}
.inline-text-toolbar { position:fixed; z-index:2600; max-width:calc(100vw - 16px); filter:drop-shadow(0 8px 18px #18223038); }
.inline-text-toolbar .rich-toolbar { width:max-content; max-width:100%; align-items:center; padding:6px; border:1px solid #cdd5df; border-radius:8px; flex-wrap:wrap; }
.inline-text-toolbar .inline-text-done { display:inline-flex; margin-left:4px; font-weight:700; }
#richTextGroup .inline-text-done { display:none; }
#richTextGroup.inline-editor-detached { display:none!important; }
.rich-pixel-size { display:inline-flex; align-items:center; gap:2px; }
.rich-pixel-size button { width:34px; height:30px; padding:0; font-size:17px; line-height:1; }
.rich-font-step { position:relative; display:inline-grid; place-items:center; }
.rich-font-step span { transform:translateX(-2px); font-size:18px; line-height:1; }
.rich-font-step i { position:absolute; top:3px; right:3px; color:var(--qreports-accent,#2878df); font-size:8px; font-style:normal; line-height:1; }
.rich-pixel-size input { width:50px!important; height:30px; margin:0!important; padding:3px 4px!important; text-align:center; }
.rich-paragraph-controls { display:inline-flex; align-items:center; gap:2px; }
.rich-paragraph-controls button { width:30px; height:30px; padding:0; font-size:17px; }
.rich-paragraph-controls select { width:58px!important; height:30px; }
.rich-more-control { position:relative; flex:none; margin:0; padding:0; border:0; }
.rich-more-control>summary { display:flex; align-items:center; gap:4px; min-height:30px; box-sizing:border-box; padding:3px 8px; border:1px solid #cdd5df; border-radius:5px; cursor:pointer; list-style:none; white-space:nowrap; }
.rich-more-control>summary::-webkit-details-marker { display:none; }
.rich-more-menu { position:absolute; top:calc(100% + 5px); right:0; z-index:14; display:flex; align-items:center; gap:4px; min-width:max-content; padding:6px; border:1px solid #cdd5df; border-radius:8px; background:#fff; box-shadow:0 10px 24px #18223030; }
.rich-more-menu #richFont { width:118px; }
#richTextGroup .rich-toolbar>.rich-more-control[open] { flex:1 0 100%; }
#richTextGroup .rich-toolbar>.rich-more-control[open]>.rich-more-menu { position:static; width:100%; min-width:0; margin-top:4px; flex-wrap:wrap; box-shadow:none; }
.rich-content :is(h1,h2),.inline-rich-editor :is(h1,h2) { margin:.25em 0 .35em; line-height:1.15; }
.rich-content h1,.inline-rich-editor h1 { font-size:2em; }
.rich-content h2,.inline-rich-editor h2 { font-size:1.5em; }
.rich-content blockquote,.inline-rich-editor blockquote { margin:.45em 0; padding-left:.8em; border-left:3px solid currentColor; opacity:.84; }
:is(.rich-content,.rich-editor,.inline-rich-editor) table { width:100%; max-width:100%; margin:.65em 0; border-collapse:collapse; table-layout:auto; font:inherit; color:inherit; }
:is(.rich-content,.rich-editor,.inline-rich-editor) :is(th,td) { min-width:72px; padding:.48em .62em; border:1px solid color-mix(in srgb,currentColor 24%,transparent); text-align:left; vertical-align:top; }
:is(.rich-content,.rich-editor,.inline-rich-editor) th { background:color-mix(in srgb,currentColor 8%,transparent); font-weight:700; }
:is(.rich-content,.rich-editor,.inline-rich-editor) caption { padding:.35em .2em; font-weight:700; text-align:left; }
:is(.rich-content,.rich-editor,.inline-rich-editor) pre { max-width:100%; margin:.65em 0; padding:.85em 1em; overflow:auto; border:1px solid color-mix(in srgb,currentColor 16%,transparent); border-radius:9px; background:color-mix(in srgb,currentColor 7%,transparent); white-space:pre; tab-size:4; font:12px/1.5 Consolas,"Cascadia Mono",monospace; }
:is(.rich-content,.rich-editor,.inline-rich-editor) :not(pre)>code { padding:.08em .28em; border-radius:4px; background:color-mix(in srgb,currentColor 8%,transparent); font-family:Consolas,"Cascadia Mono",monospace; }
:is(.rich-editor,.inline-rich-editor) code:has(>kbd:only-child) { background:transparent; border-bottom:1px dashed color-mix(in srgb,currentColor 55%,transparent); border-radius:0; box-decoration-break:clone; -webkit-box-decoration-break:clone; white-space:normal; overflow-wrap:anywhere; }
:is(.rich-editor,.inline-rich-editor) code:has(>kbd:only-child)>kbd { background:transparent; font:inherit; }
:is(.rich-content,.rich-editor,.inline-rich-editor) pre code { font:inherit; color:inherit; }
:is(.rich-content,.rich-editor,.inline-rich-editor) [data-qanvas-countdown] { display:inline; padding:0; border:0; border-radius:0; background:transparent; cursor:inherit; }
:is(.rich-content,.rich-editor,.inline-rich-editor) figure[data-qanvas-image] { box-sizing:border-box; width:100%; max-width:100%; }
:is(.rich-content,.rich-editor,.inline-rich-editor) figure[data-qanvas-image] img { display:inline-block; height:auto; max-width:100%; border-radius:3px; vertical-align:middle; }
:is(.rich-content,.rich-editor,.inline-rich-editor) ul[data-gantt-checklist="true"] { list-style:none; padding-inline-start:1.65em; }
:is(.rich-content,.rich-editor,.inline-rich-editor) li[data-gantt-checklist="true"] { position:relative; min-height:1.35em; padding-inline-start:.2em; }
:is(.rich-content,.rich-editor,.inline-rich-editor) li[data-gantt-checklist="true"]::before { content:""; position:absolute; top:.14em; left:-1.45em; box-sizing:border-box; width:1.05em; height:1.05em; border:1.5px solid currentColor; border-radius:3px; color:var(--qreports-accent,#4f6ee8); background:transparent; line-height:.9em; text-align:center; cursor:pointer; }
:is(.rich-content,.rich-editor,.inline-rich-editor) li[data-gantt-checklist="true"][data-gantt-checked="true"]::before { content:"✓"; border-color:currentColor; background:color-mix(in srgb,currentColor 14%,transparent); font-weight:800; }
:is(.rich-content,.rich-editor,.inline-rich-editor) li[data-gantt-checklist="true"][data-gantt-checked="true"] { opacity:.7; }
.inline-rich-editor figure[data-qanvas-image] img { cursor:pointer; }
.inline-rich-editor figure[data-qanvas-image] img:hover { outline:2px solid color-mix(in srgb,var(--qreports-accent,#4f6ee8) 55%,transparent); outline-offset:2px; }
:is(.rich-content,.rich-editor,.inline-rich-editor,.gantt-description-editor) :is(ul,ol) { margin:0 0 .3em; padding-left:1.6em; list-style-position:outside; }
:is(.rich-content,.rich-editor,.inline-rich-editor,.gantt-description-editor) :is(p,div,h1,h2,h3,blockquote):has(+ :is(ul,ol)) { margin-bottom:0; }
:is(.rich-content,.rich-editor,.inline-rich-editor,.gantt-description-editor) :is(p,div):has(>br:only-child):has(+ :is(ul,ol)) { display:none; }
.inline-parameter-menu { position:absolute; top:calc(100% + 4px); right:0; z-index:1; display:grid; gap:2px; min-width:190px; max-height:220px; overflow:auto; padding:6px; border:1px solid #cdd5df; border-radius:8px; background:#fff; box-shadow:0 10px 24px #18223030; }
.inline-parameter-menu button { width:100%; text-align:left; }
.inline-parameter-menu span { padding:8px; color:#667085; }
.rich-insert-control { position:relative; display:inline-flex; }
.rich-insert-trigger { display:inline-flex; align-items:center; gap:5px; white-space:nowrap; }
.rich-insert-menu { position:absolute; top:calc(100% + 5px); right:0; z-index:12; box-sizing:border-box; width:280px; max-width:min(90vw,360px); padding:6px; border:1px solid #cdd5df; border-radius:9px; background:#fff; box-shadow:0 12px 30px #18223038; }
.rich-insert-root { display:grid; gap:3px; }
.rich-insert-root>button { display:grid!important; grid-template-columns:1fr; gap:2px; width:100%; min-height:44px; padding:6px 9px!important; text-align:left; }
.rich-insert-root small { font-size:11px; font-weight:400; opacity:.7; }
.rich-insert-picker-head { display:flex; align-items:center; gap:7px; margin-bottom:5px; }
.rich-insert-picker-head button { flex:0 0 auto; }
.rich-insert-picker-head strong { font-size:13px; }
.rich-insert-picker>input { box-sizing:border-box; width:100%!important; height:32px; margin:0 0 6px!important; padding:4px 8px!important; }
.rich-insert-results { display:grid; gap:4px; max-height:260px; overflow:auto; }
.rich-insert-results section { display:grid; gap:2px; }
.rich-insert-results section>strong { position:sticky; top:0; padding:5px 7px 3px; font-size:11px; text-transform:uppercase; letter-spacing:.05em; background:#fff; color:#667085; }
.rich-insert-results button { width:100%; padding:6px 9px!important; text-align:left; }
.rich-insert-empty { padding:12px 8px; color:#667085; }
.rich-toolbar.rich-image-mode { visibility:hidden; pointer-events:none; }
.rich-image-tools { position:fixed; z-index:90; display:flex; align-items:center; flex-wrap:nowrap; gap:4px; max-width:calc(100vw - 16px); padding:5px 7px; border:1px solid color-mix(in srgb,var(--qreports-accent,#4f6ee8) 48%,var(--qreports-grid,#cdd5df)); border-radius:8px; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); box-shadow:0 8px 24px #10182838; }
.rich-image-tools[hidden] { display:none!important; }
.rich-image-tools>strong { margin-right:3px; font-size:11px; }
.rich-image-tools label { display:inline-flex; align-items:center; gap:3px; margin:0; font-size:11px; }
.rich-image-tools input { width:52px!important; height:30px; margin:0!important; padding:3px 4px!important; text-align:right; }
.rich-image-tools button { min-width:30px; height:30px; padding:3px 7px; }
.rich-image-align { display:inline-flex; gap:2px; }
.rich-image-align button[aria-pressed="true"] { color:var(--qreports-on-accent,#fff); background:var(--qreports-accent,#4f6ee8); border-color:var(--qreports-accent,#4f6ee8); }
.rich-image-tools small { min-width:70px; color:var(--qreports-muted,#667085); font-size:10px; }
.rich-image-selection { position:fixed; z-index:89; box-sizing:border-box; border:2px solid color-mix(in srgb,var(--qreports-accent,#4f6ee8) 82%,#fff); border-radius:3px; pointer-events:none; }
.rich-image-selection[hidden] { display:none!important; }
.rich-image-selection [data-rich-image-handle] { position:absolute; box-sizing:border-box; width:11px; height:11px; border:2px solid var(--qreports-surface,#fff); border-radius:50%; background:var(--qreports-accent,#4f6ee8); box-shadow:0 1px 4px #10182855; pointer-events:auto; touch-action:none; }
.rich-image-selection [data-rich-image-handle="nw"] { top:-7px; left:-7px; cursor:nwse-resize; }
.rich-image-selection [data-rich-image-handle="ne"] { top:-7px; right:-7px; cursor:nesw-resize; }
.rich-image-selection [data-rich-image-handle="sw"] { bottom:-7px; left:-7px; cursor:nesw-resize; }
.rich-image-selection [data-rich-image-handle="se"] { right:-7px; bottom:-7px; cursor:nwse-resize; }
@media (max-width:720px) { .rich-image-tools { flex-wrap:wrap; }.rich-image-tools>strong,.rich-image-tools small { display:none; } }
.rich-table-dialog { width:min(420px,calc(100vw - 28px)); padding:0; border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); box-shadow:0 24px 70px #0007; }
.rich-table-dialog::backdrop { background:#0007; backdrop-filter:blur(2px); }
.rich-table-dialog form { display:grid; gap:14px; padding:16px; }
.rich-table-dialog header { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
.rich-table-dialog h3,.rich-table-dialog p { margin:0; }
.rich-table-dialog header p { margin-top:4px; color:var(--qreports-muted,#667085); font-size:12px; line-height:1.4; }
.rich-table-dialog header>button { flex:none; width:32px; height:32px; padding:0; font-size:20px; }
.rich-table-options { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.rich-table-dialog label:not(.check) { display:grid; gap:5px; font-weight:700; }
.rich-table-dialog input[type="number"] { box-sizing:border-box; width:100%; }
.rich-table-dialog footer { display:flex; justify-content:flex-end; gap:8px; }
.svg-link-actions { display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:5px;margin:6px 0 8px;padding:5px 6px;border:1px solid var(--qreports-grid,#d5dded);border-radius:8px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230); }
.svg-link-actions span{overflow:hidden;color:var(--qreports-muted,#667085);font-size:11px;text-overflow:ellipsis;white-space:nowrap}
.svg-link-actions button{width:auto;min-width:28px;margin:0;padding:4px 7px;color:var(--qreports-text,#182230);background:color-mix(in srgb,var(--qreports-surface,#fff) 92%,var(--qreports-accent,#4b8dcc) 8%);border-color:var(--qreports-grid,#d5dded)}
.svg-tile-link { position:absolute; inset:0; display:block; color:inherit; text-decoration:none; cursor:pointer; }
.tile-valueSelector { min-width:30px; min-height:30px; }
.tile-valueSelector .tile-body { padding:0; overflow:visible; }
.value-selector-buttons { display:flex; align-items:center; justify-content:center; gap:4px; width:100%; min-height:30px; height:100%; padding:3px; box-sizing:border-box; flex-wrap:wrap; font-family:var(--selector-font,"Segoe UI"); font-size:var(--selector-size,14px); font-weight:var(--selector-weight,700); font-style:var(--selector-style,normal); }
.value-selector-buttons button { box-sizing:border-box; flex:1 1 56px; align-self:stretch; min-width:56px; min-height:24px; padding:2px 12px; border:1px solid var(--selector-border,color-mix(in srgb,var(--qreports-grid,#cdd5df) 68%,transparent)); border-radius:999px; color:var(--selector-text,var(--qreports-text,#182230)); background:transparent; font:inherit; line-height:1.1; cursor:pointer; }
.value-selector-buttons button:hover:not(:disabled):not(.active) { border-color:color-mix(in srgb,var(--selector-active-bg,var(--qreports-accent,#4f6ee8)) 55%,transparent); background:color-mix(in srgb,var(--selector-active-bg,var(--qreports-accent,#4f6ee8)) 9%,transparent); }
.value-selector-buttons button:focus-visible { outline:2px solid var(--selector-active-bg,var(--qreports-accent,#4f6ee8)); outline-offset:2px; }
.value-selector-buttons button.active { color:var(--selector-active-text,var(--qreports-on-accent,#fff)); background:var(--selector-active-bg,var(--qreports-accent,#4f6ee8)); border-color:transparent; box-shadow:0 1px 3px #10182820; }
.value-selector-buttons button.invalid { opacity:.48; text-decoration:line-through; cursor:not-allowed; }
.selector-style-pillGroup { gap:0; width:100%; max-width:100%; margin:auto; padding:2px; min-height:30px; height:100%; flex-wrap:nowrap; border:1px solid var(--selector-border,color-mix(in srgb,var(--qreports-grid,#cdd5df) 75%,transparent)); border-radius:999px; background:var(--selector-bg,var(--qreports-surface,#eef2f7)); box-shadow:0 1px 2px #10182812; }
.selector-style-pillGroup button { border-color:transparent; }
.selector-style-pills button { background:var(--selector-bg,var(--qreports-surface,#eef2f7)); }
.selector-style-minimal button { border-color:transparent; border-radius:5px; }
.selector-style-underline button { border:0; border-bottom:2px solid transparent; border-radius:0; }
.selector-style-underline button.active { color:var(--selector-active-bg,var(--qreports-accent,#4f6ee8)); background:transparent; border-bottom-color:currentColor; box-shadow:none; }
.value-selector-dropdown { display:flex; align-items:center; width:100%; height:100%; min-height:30px; padding:3px; box-sizing:border-box; font-family:var(--selector-font,"Segoe UI"); font-size:var(--selector-size,14px); font-weight:var(--selector-weight,700); font-style:var(--selector-style,normal); }
.value-selector-dropdown select { width:100%; height:100%; min-height:30px; padding:3px 34px 3px 12px; border:1px solid var(--selector-border,color-mix(in srgb,var(--qreports-grid,#cdd5df) 68%,transparent)); border-radius:8px; color:var(--selector-text,var(--qreports-text,#182230)); background:var(--selector-bg,var(--qreports-surface,#eef2f7)); font:inherit; cursor:pointer; }
.value-selector-dropdown select:hover { border-color:color-mix(in srgb,var(--selector-active-bg,var(--qreports-accent,#4f6ee8)) 55%,var(--selector-border,#cdd5df)); }
.value-selector-dropdown select:focus-visible { outline:2px solid var(--selector-active-bg,var(--qreports-accent,#4f6ee8)); outline-offset:1px; }
.selector-add-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:5px; margin-bottom:6px; }
.selector-add-row :is(select,button) { min-height:30px; margin:0; padding:4px 8px; }
.selector-choice-list { display:grid; gap:3px; }
.selector-choice-row { display:grid; grid-template-columns:14px minmax(0,1fr) minmax(64px,.75fr) auto; gap:4px; align-items:center; min-height:34px; padding:2px 3px; border:1px solid var(--qreports-grid,#d7dee7); border-radius:7px; transition:border-color .12s,background .12s,opacity .12s; }
.selector-choice-row>div { min-width:0; overflow:hidden; }
.selector-choice-row strong { display:block; overflow:hidden; font-size:12px; line-height:1.15; text-overflow:ellipsis; white-space:nowrap; }
.selector-choice-row input { min-width:0; height:28px; margin:0; padding:3px 6px; font-size:12px; }
.selector-drag-handle { align-self:stretch; display:grid; place-items:center; cursor:grab; color:var(--qreports-muted,#65718a); font-size:13px; letter-spacing:-3px; user-select:none; }
.selector-choice-actions { display:flex; gap:2px; }
.selector-choice-row button { width:23px; height:28px; padding:0; color:var(--qreports-text,#182230); font-size:12px; }
.selector-choice-row button.selector-remove { color:var(--qreports-negative,#c43d4b); }
.selector-choice-row.dragging { opacity:.45; }
.selector-choice-row.drag-over { border-color:var(--qreports-accent,#4f6ee8); background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 10%,transparent); }
.selector-choice-row small { display:block; color:var(--qreports-negative,#c43d4b); font-size:11px; }
.selector-choice-row.invalid { border-color:color-mix(in srgb,var(--qreports-negative,#c43d4b) 45%,var(--qreports-grid,#d7dee7)); }
.selector-property-list { display:grid; gap:6px; max-height:190px; overflow:auto; padding:7px; border:1px solid var(--qreports-grid,#d7dee7); border-radius:8px; }
.selector-property-list .check { margin:0; padding:4px; }
.hyperlink-dialog { border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; padding:0; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); color-scheme:var(--qreports-color-scheme,light); }
.picture-compress-dialog { width:min(760px,calc(100vw - 32px)); max-height:90vh; overflow:auto; border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; padding:20px; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); color-scheme:var(--qreports-color-scheme,light); }
.picture-paste-dialog { width:min(520px,calc(100vw - 32px)); padding:22px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); color-scheme:var(--qreports-color-scheme,light); }
.picture-paste-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#182230) 55%,transparent); }
.picture-paste-dialog h2 { margin:0 0 8px; }
.picture-paste-dialog p { line-height:1.5; }
.picture-paste-dialog .picture-compress-actions { flex-wrap:wrap; }
.picture-paste-dialog .primary { color:var(--qreports-on-accent,#fff); background:var(--qreports-accent,#4f6ee8); border-color:var(--qreports-accent,#4f6ee8); }
.picture-compress-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#182230) 55%,transparent); }
.picture-compress-dialog h2 { margin:0 0 8px; font-size:20px; }
.picture-compress-dialog .picture-compress-intro { margin:0 0 16px; color:var(--qreports-muted,#667085); font-size:13px; line-height:1.4; }
.picture-compress-controls { display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; }
.picture-compress-controls label { min-width:0; color:var(--qreports-text,#182230); }
.picture-compress-controls select { color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); border-color:var(--qreports-grid,#cdd5df); }
.picture-compress-controls input[type=range] { display:block; width:100%; margin:14px 0 0; accent-color:var(--qreports-accent,#4f6ee8); }
.picture-compress-controls output { float:right; }
.picture-compress-previews { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.picture-compress-previews figure { min-width:0; margin:0; padding:8px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:9px; background:var(--qreports-background,var(--qreports-surface,#fff)); }
.picture-compress-previews img { display:block; width:100%; height:220px; object-fit:contain; }
.picture-crop-surface { position:relative; overflow:hidden; touch-action:none; cursor:crosshair; }
.picture-crop-surface img { user-select:none; pointer-events:none; }
.picture-crop-surface [data-crop-selection] { position:absolute; box-sizing:border-box; border:2px solid var(--qreports-accent,#4f6ee8); box-shadow:0 0 0 2000px #0006; pointer-events:none; }
.picture-crop-surface [data-crop-selection][hidden] { display:none; }
.picture-crop-controls { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:8px 0; color:var(--qreports-muted,#667085); font-size:12px; }
.picture-crop-controls button { flex:none; }
.picture-compress-previews figcaption { padding-top:7px; color:var(--qreports-muted,#667085); font-size:12px; text-align:center; }
.picture-compress-dialog [data-compress-estimate] { min-height:2.5em; margin:14px 0 4px; font-weight:600; line-height:1.4; }
.picture-compress-dialog [data-compress-error] { min-height:1em; margin:0; }
.picture-compress-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:14px; }
.picture-compress-actions .primary { color:var(--qreports-on-accent,#fff); background:var(--qreports-accent,#4f6ee8); border-color:var(--qreports-accent,#4f6ee8); }
#pictureProperties [data-compress-picture] { margin:8px 0 3px; width:100%; }
#pictureProperties .picture-compress-hint { display:block; color:var(--qreports-muted,#667085); line-height:1.35; }
@media(max-width:620px){.picture-compress-controls{grid-template-columns:1fr}.picture-compress-previews img{height:150px}}
.hyperlink-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#182230) 55%,transparent); }
.hyperlink-dialog form { display:grid; gap:12px; padding:22px; }
.hyperlink-dialog h3 { margin:0 0 4px; }
.hyperlink-dialog label { display:grid; gap:5px; color:var(--qreports-muted,#667085); }
.hyperlink-dialog [data-web] { display:grid; gap:12px; }
.hyperlink-dialog [hidden] { display:none!important; }
.hyperlink-dialog :is(input,select) { width:100%; box-sizing:border-box; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); border-color:var(--qreports-grid,#cdd5df); }
.hyperlink-dialog [data-error] { min-height:1em; margin:0; color:var(--qreports-negative,#c43d4b); }
.rich-countdown-help { margin:0 0 2px; color:var(--qreports-muted,#667085); line-height:1.45; }
.rich-countdown-preview { display:flex; align-items:baseline; justify-content:space-between; gap:16px; margin:2px 0 4px; padding:10px 12px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:8px; background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 7%,var(--qreports-surface,#fff)); }
.rich-countdown-preview small { color:var(--qreports-muted,#667085); }
.rich-countdown-preview strong { text-align:right; }
.gantt-priority-format { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px 12px; margin:10px 0; padding:12px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:9px; }
.gantt-priority-format legend { padding:0 6px; font-weight:700; }
.gantt-priority-format label { min-width:0; }
.gantt-priority-format input,.gantt-priority-format select { box-sizing:border-box; width:100%; }
.gantt-priority-format [hidden] { display:none!important; }
.tile.text-editing { overflow:visible; outline:2px solid #2878df; outline-offset:2px; }
.tile.text-editing .tile-body { display:block; overflow:auto; cursor:text; }
.tile.text-editing .inline-rich-editor { box-sizing:border-box; width:100%; height:auto; min-height:100%; max-height:none; margin:0; padding:0; overflow:visible; border:0; border-radius:0; outline:0; background:transparent; color:inherit; white-space:normal; cursor:text; }
.tile.text-editing .inline-rich-editor p { margin:.35em 0; }
.tile.selected.text-editing:not(.hide-handles) .resize-handle { display:block; z-index:30; }
.tile.hide-handles .resize-handle,.tile.hide-handles .tile-kind { display:none; }
.tile-text .tile-body, .tile-graphicText .tile-body { display:flex; flex-direction:column; justify-content:var(--tile-vertical-align,flex-start); font-family:var(--tile-font,"Segoe UI"); font-size:var(--tile-font-size,14px); color:var(--tile-text-color,#1f2937); }
.tile-text .tile-body>.rich-content,.tile-graphicText .tile-body>.rich-content { width:100%; }
.tile:is(.tile-text,.tile-graphicText).text-overflow-visible { overflow:visible; }
.tile:is(.tile-text,.tile-graphicText).text-overflow-visible .tile-body { overflow:visible!important; }
.tile:is(.tile-text,.tile-graphicText).text-overflow-clip .tile-body { overflow:hidden!important; }
.tile:is(.tile-text,.tile-graphicText).text-overflow-scroll .tile-body { overflow:auto!important; overscroll-behavior:contain; touch-action:pan-x pan-y; cursor:auto; scrollbar-gutter:stable; }
.tile:is(.tile-text,.tile-graphicText).text-editing.text-overflow-clip .tile-body { overflow:auto!important; overscroll-behavior:contain; scrollbar-gutter:stable; }
body.presentation-mode .tile:is(.tile-text,.tile-graphicText).text-overflow-scroll .tile-body { pointer-events:auto; user-select:text; }
#textOverflowControl small { display:block; margin-top:5px; color:var(--qreports-muted,#667085); line-height:1.35; }
.tile>.tile-drag-strip { position:absolute; z-index:12; inset:0 0 auto 0; height:12px; padding:0; border:0; background:transparent; }
.query-summary label { margin-top:10px; }
.query-summary small { display:block; color:#667085; line-height:1.35; }
.source-summary { position:relative; }
.source-summary > #activeSourceName { display:block; min-width:0; padding-right:62px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:14px; }
.source-kind-badge { position:absolute; top:10px; right:10px; max-width:58px; padding:2px 7px; overflow:hidden; border:1px solid color-mix(in srgb,var(--qreports-accent,#6686ee) 36%,var(--qreports-grid,#cdd5df)); border-radius:999px; background:color-mix(in srgb,var(--qreports-accent,#6686ee) 10%,var(--qreports-surface,#fff)); color:var(--qreports-text,#344054); font-size:10px; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.source-summary-actions { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:6px; margin-top:12px; padding-top:12px; border-top:1px solid color-mix(in srgb,var(--qreports-grid,#cdd5df) 85%,transparent); }
.source-summary-actions button { display:flex; align-items:center; justify-content:center; gap:4px; min-width:0; overflow:hidden; padding:7px 5px; color:var(--qreports-text,#344054); background:var(--qreports-surface,#fff); border-color:var(--qreports-grid,#cdd5df); font-size:11px; font-weight:650; white-space:nowrap; }
.source-summary-actions button > span:first-child { flex:none; width:13px; color:var(--qreports-accent,#4f6ee8); font-size:12px; line-height:1; text-align:center; }
.source-summary-actions .source-action-wide { grid-column:1 / -1; justify-content:center; }
.source-summary-actions button.primary { color:var(--qreports-on-accent,#fff); background:var(--qreports-accent,#4f6ee8); border-color:var(--qreports-accent,#4f6ee8); }
.source-summary-actions button.primary > span:first-child { color:inherit; }
.source-summary-actions button.danger { margin-top:3px; color:var(--qreports-negative,#b42318); background:color-mix(in srgb,var(--qreports-negative,#b42318) 7%,var(--qreports-surface,#fff)); border-color:color-mix(in srgb,var(--qreports-negative,#b42318) 34%,var(--qreports-grid,#cdd5df)); }
.source-summary-actions button.danger > span:first-child { color:inherit; }
.commandbar { overflow:visible; }
.add-menu { z-index:1001; }
.add-menu .menu { z-index:1002; max-height:min(420px,calc(100vh - 150px)); overflow-y:auto; }
.file-actions .export-menu-wrap { position:relative; z-index:1200; }
.file-actions .export-menu-wrap .menu { top:40px; right:0; left:auto; width:190px; grid-template-columns:1fr; }
.file-actions .export-menu-wrap .menu button { width:100%; color:#344054; background:#fff; border-color:transparent; font-size:13px; }
.file-actions .export-menu-wrap .menu button:hover { background:#f3f6f9; }
.file-actions .canvas-ai-launch { display:inline-flex; align-items:center; justify-content:center; gap:5px; min-width:52px; padding-inline:9px; font-weight:700; }
.file-actions .canvas-ai-launch svg { width:14px; height:14px; flex:none; fill:currentColor; }
.file-actions .help-menu-wrap { position:relative; z-index:1201; }
.file-actions :is(.header-icon-button,.shared-settings-icon) { display:grid; place-items:center; width:40px; min-width:40px; height:34px; padding:0; border-radius:8px; font-size:17px; font-weight:800; }
.file-actions .help-menu { position:absolute; top:42px; right:0; display:grid; width:250px; padding:7px; gap:3px; border:1px solid var(--qreports-grid,#cad3df); border-radius:10px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#243047); color-scheme:var(--qreports-color-scheme,light); box-shadow:0 16px 38px #1018283d; }
.file-actions .help-menu button { display:grid; grid-template-columns:28px 1fr; align-items:center; gap:8px; width:100%; padding:9px 10px; border-color:transparent; background:transparent; color:var(--qreports-text,#243047); text-align:left; }
.file-actions .help-menu button:hover { border-color:transparent; background:color-mix(in srgb,var(--qreports-accent,#6686ee) 13%,var(--qreports-surface,#fff)); }
.file-actions .help-menu button span:last-child { min-width:0; }
.file-actions .help-menu b,.file-actions .help-menu small { display:block; }
.file-actions .help-menu b { font-size:13px; }
.file-actions .help-menu small { margin-top:2px; color:color-mix(in srgb,var(--qreports-text,#243047) 70%,var(--qreports-surface,#fff)); font-size:11px; font-weight:400; }
.file-actions .help-menu-icon { color:var(--qreports-accent,#6686ee); font-size:16px; text-align:center; }
html[data-qreports-theme] .app-header .file-actions .help-menu { border-color:var(--qreports-grid); background:var(--qreports-surface); color:var(--qreports-text); }
html[data-qreports-theme] .app-header .file-actions .help-menu button:not(.primary) { border-color:transparent; background:transparent; color:var(--qreports-text); }
html[data-qreports-theme] .app-header .file-actions .help-menu button:not(.primary):hover { border-color:transparent; background:color-mix(in srgb,var(--qreports-accent) 13%,var(--qreports-surface)); }
.qvitr-product-dialog { box-sizing:border-box; width:min(610px,calc(100vw - 32px)); max-height:min(760px,calc(100vh - 32px)); margin:auto; padding:0; overflow:auto; border:1px solid var(--qreports-grid,#cad3df); border-radius:14px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#243047); color-scheme:var(--qreports-color-scheme,light); box-shadow:0 24px 70px color-mix(in srgb,var(--qreports-text,#243047) 38%,transparent); }
.qvitr-product-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#1d2d44) 58%,transparent); backdrop-filter:blur(2px); }
.qvitr-product-dialog form { display:grid; gap:18px; padding:24px; }
.qvitr-product-dialog header { display:grid; grid-template-columns:56px minmax(0,1fr) 38px; align-items:center; gap:14px; padding:0 0 18px; border-bottom:1px solid var(--qreports-grid,#cad3df); color:inherit; background:transparent; }
.qvitr-product-dialog header img,.qvitr-product-icon { display:grid; place-items:center; width:52px; height:52px; border-radius:12px; object-fit:contain; background:color-mix(in srgb,var(--qreports-accent,#6686ee) 13%,var(--qreports-surface,#fff)); font-size:25px; }
.qvitr-product-dialog h2 { margin:0; color:var(--qreports-text,#243047); font-size:23px; line-height:1.2; }
.qvitr-product-dialog header p,.qvitr-license-note { margin:4px 0 0; color:color-mix(in srgb,var(--qreports-text,#243047) 72%,var(--qreports-surface,#fff)); line-height:1.45; }
.qvitr-product-dialog button { min-height:36px; padding:8px 16px; border:1px solid var(--qreports-grid,#cad3df); border-radius:8px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#243047); font:inherit; cursor:pointer; }
.qvitr-product-dialog button:hover { border-color:var(--qreports-accent,#6686ee); background:color-mix(in srgb,var(--qreports-accent,#6686ee) 10%,var(--qreports-surface,#fff)); }
.qvitr-product-dialog button:focus-visible,.qvitr-product-dialog textarea:focus { outline:2px solid var(--qreports-accent,#6686ee); outline-offset:2px; }
.qvitr-product-dialog button.primary { border-color:var(--qreports-accent,#6686ee); background:var(--qreports-accent,#6686ee); color:var(--qreports-on-accent,#fff); font-weight:700; }
.qvitr-product-dialog button:disabled { cursor:wait; opacity:.62; }
.qvitr-product-dialog .qvitr-dialog-close { width:38px; min-width:38px; height:38px; padding:0; font-size:23px; line-height:1; }
.qvitr-product-dialog label { display:grid; gap:7px; color:var(--qreports-text,#243047); font-weight:700; }
.qvitr-product-dialog textarea { box-sizing:border-box; width:100%; min-height:140px; padding:11px 12px; resize:vertical; border:1px solid var(--qreports-grid,#cad3df); border-radius:8px; background:color-mix(in srgb,var(--qreports-surface,#fff) 96%,var(--qreports-header,#edf2f8)); color:var(--qreports-text,#243047); font:12px/1.45 Consolas,monospace; }
.qvitr-product-dialog footer { display:flex; justify-content:flex-end; gap:8px; padding-top:4px; }
.qvitr-license-current,.qvitr-about-details>div { display:grid; gap:4px; padding:13px 15px; border:1px solid var(--qreports-grid,#cad3df); border-radius:9px; background:color-mix(in srgb,var(--qreports-header,#edf2f8) 45%,var(--qreports-surface,#fff)); }
.qvitr-license-current span,.qvitr-about-details span { color:color-mix(in srgb,var(--qreports-text,#243047) 66%,var(--qreports-surface,#fff)); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.055em; }
.qvitr-license-current strong,.qvitr-about-details strong { overflow-wrap:anywhere; font-size:14px; line-height:1.45; }
.qvitr-dialog-status { min-height:20px; margin:0; font-weight:650; }
.qvitr-dialog-status[data-state="success"] { color:var(--qreports-positive,#16844a); }
.qvitr-dialog-status[data-state="error"] { color:var(--qreports-negative,#b43441); }
.qvitr-about-details { display:grid; gap:10px; }
.qvitr-about-dialog { width:min(540px,calc(100vw - 32px)); }
@media(max-width:540px){.qvitr-product-dialog form{padding:18px}.qvitr-product-dialog header{grid-template-columns:46px minmax(0,1fr) 34px}.qvitr-product-dialog header img,.qvitr-product-icon{width:44px;height:44px}.qvitr-product-dialog .qvitr-dialog-close{width:34px;min-width:34px;height:34px}}
.excel-return { font-weight:700; }
body.excel-export { margin:0; overflow:visible; background:transparent; }
body.excel-export .app-header,
body.excel-export .commandbar,
body.excel-export .left-panel,
body.excel-export .right-panel,
body.excel-export .statusbar { display:none !important; }
body.excel-export main,
body.excel-export .workspace,
body.excel-export .canvas-viewport { display:block; width:max-content; height:max-content; min-width:0; min-height:0; margin:0; padding:0; overflow:visible; border:0; }
body.excel-export .canvas { position:relative; margin:0; box-shadow:none; border:0; }
body.excel-export:not(.powerpoint-export) .canvas { background-image:none !important; }
body.excel-export .tile { outline:0 !important; }
body.excel-export .resize-handle { display:none !important; }
.web-chart { width:100%; height:100%; overflow:visible; }
.chart-web-surface { position:relative; width:100%; height:100%; min-height:120px; overflow:hidden; background:#fff; }
.tile-chart.chart-treemap>.tile-body{padding:0}
.chart-web-svg { display:block; width:100%; height:100%; font-family:Segoe UI,Arial,sans-serif; }
.chart-title { fill:#253653; font-size:20px; font-weight:700; }
.chart-grid { stroke:#dfe5ee; stroke-width:1; }
.chart-axis { stroke:#73809a; stroke-width:1.2; }
.chart-axis-label,.chart-legend { fill:#65718a; font-size:11px; }
.chart-total { fill:#253653; font-size:18px; font-weight:700; }
.chart-web-empty { height:100%; display:grid; place-content:center; gap:6px; text-align:center; color:#7a869e; }
.chart-web-empty strong { color:#344563; font-size:16px; }
.chart-web-warning { position:absolute; right:8px; bottom:6px; max-width:80%; padding:3px 7px; border-radius:5px; background:#fff4ce; color:#725500; font-size:10px; box-shadow:0 1px 4px #0002; }
.web-chart .axis { stroke:#9aa8b7; stroke-width:.5; }
.web-chart .chart-line { fill:none; stroke:#2873ca; stroke-width:2; vector-effect:non-scaling-stroke; }
.web-chart .chart-point { fill:#2873ca; vector-effect:non-scaling-stroke; }
@media(max-width:1050px) { :root { --left-pane-width:180px; --right-pane-width:260px; } main { grid-template-columns:var(--left-pane-width) 7px minmax(0,1fr) 7px var(--right-pane-width); } .right-panel { display:block; } .command { min-width:58px; padding:3px 6px; } .command b { font-size:10px; } }

.tile { --visual-row-header:#f5f7fa; }
.tile .matrix-label { background:var(--visual-row-header); }
.tile .matrix-total-row td { background:var(--visual-total-row); font-weight:700; }
.matrix-group-actions{display:flex;gap:6px;justify-content:flex-end;padding:5px 8px;background:var(--visual-header,#f5f7fa);border-bottom:1px solid var(--visual-grid,#dce3ec)}
.matrix-group-actions button{min-height:var(--matrix-control-size,24px);padding:3px 8px;border:1px solid var(--matrix-control-bg,#4f6ee8);border-radius:5px;background:var(--matrix-control-bg,#4f6ee8);color:var(--matrix-control-text,#fff);font-size:11px;cursor:pointer}
.matrix-visual-styling{padding:10px;border:1px solid var(--qreports-grid,#ccd5e0);border-radius:9px;background:var(--qreports-surface,#fff)}
.matrix-visual-styling h4{margin:0 0 5px}.matrix-visual-styling p{margin:0 0 9px;font-size:12px;color:var(--qreports-text,#475467)}
.table-visual-styling>summary,.table-column-format>summary{cursor:pointer;font-size:13px;font-weight:700;color:var(--qreports-text,#182230)}
.table-visual-styling[open]>summary,.table-column-format[open]>summary{margin-bottom:10px}
.table-column-format{margin-top:14px;padding:10px;border:1px solid var(--qreports-grid,#ccd5e0);border-radius:9px;background:var(--qreports-surface,#fff)}
.matrix-style-map{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:3px;margin:0 0 10px}.matrix-style-map button{min-width:0;padding:7px 4px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:3px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);font-size:10px;text-align:center}.matrix-style-map button:first-child,.matrix-style-map button:nth-child(n+5){grid-column:1/-1}.matrix-style-map button[aria-pressed="true"]{outline:2px solid var(--qreports-accent,#4f6ee8);outline-offset:1px}
.matrix-style-map{display:grid;grid-template-columns:minmax(0,1fr);gap:5px}
.matrix-style-map-row{display:grid;grid-template-columns:68px repeat(3,minmax(0,1fr));gap:4px;align-items:stretch}
.matrix-style-map-row strong{align-self:center;font-size:11px}
.matrix-style-map-row button{grid-column:auto!important;min-height:32px;padding:5px 3px;overflow:hidden;line-height:1.1}
.matrix-style-map-row button[draggable="true"]{cursor:grab}
.matrix-style-map-row button.matrix-format-dragging{opacity:.5}
.matrix-style-map-row button.matrix-format-drop-target{outline:3px solid var(--qreports-accent,#6da0ff);outline-offset:-3px}
.table-style-map{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;margin:0 0 10px}
.table-style-map button{min-height:42px;padding:6px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:4px;cursor:grab}
.table-style-map button[aria-pressed="true"]{outline:2px solid var(--qreports-accent,#4f6ee8);outline-offset:1px}
.table-style-map button.matrix-format-dragging{opacity:.5}
.table-style-map button.matrix-format-drop-target{outline:3px solid var(--qreports-accent,#4f6ee8);outline-offset:-3px}
.matrix-format-menu{position:fixed;z-index:2400;min-width:170px;padding:6px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);border:1px solid var(--qreports-grid,#cbd5e1);border-radius:8px;box-shadow:0 10px 28px #0005}
.matrix-format-menu strong{display:block;padding:5px 9px;font-size:11px;opacity:.8}
.matrix-format-menu button{display:block;width:100%;padding:7px 9px;text-align:left;font:inherit;font-size:12px;background:transparent;color:inherit;border:0;border-radius:5px;cursor:pointer}
.matrix-format-menu button:hover,.matrix-format-menu button:focus-visible{background:var(--qreports-accent,#6da0ff);color:#fff}
.matrix-visual-styling>.check{margin:10px 0}
.matrix-active-filters{margin:10px 0;padding:9px 10px;border:1px solid var(--qreports-grid,#ccd5e0);border-radius:8px;background:var(--qreports-surface,#fff)}
.matrix-active-filters h4{margin:0 0 5px;font-size:12px}
.matrix-active-filters ul{margin:0;padding-left:17px;font-size:11px;line-height:1.5}
.matrix-active-filters p{margin:0;font-size:11px}
.matrix-group-actions-left{justify-content:flex-start}
.matrix-group-actions-levels button{min-width:var(--matrix-control-size,24px);padding:3px 5px}
.matrix-group-actions button[aria-pressed="true"]{box-shadow:inset 0 0 0 2px var(--matrix-control-text,#fff)}
.matrix-row-header>.matrix-group-actions{display:inline-flex;vertical-align:middle;gap:3px;margin-left:8px;padding:0;border:0;background:transparent}
.matrix-preview-surface{display:block;min-width:100%;width:max-content;color:var(--visual-text);background:var(--visual-alt,#fff)}
.matrix-preview-surface .data-table{width:max-content;min-width:100%}
html[data-qreports-app-theme] .designer-preview .matrix-preview-surface .data-table{color:var(--visual-text)}
html[data-qreports-app-theme] .designer-preview .matrix-preview-surface .data-table th{background:var(--visual-header);color:var(--visual-text);border-color:var(--visual-grid)}
html[data-qreports-app-theme] .designer-preview .matrix-preview-surface .data-table td{background:transparent;color:inherit;border-color:var(--visual-grid)}
html[data-qreports-app-theme] .designer-preview .matrix-preview-surface .data-table .matrix-label{background:var(--visual-row-header)}
html[data-qreports-app-theme] .designer-preview .matrix-preview-surface .data-table .matrix-total-row td{background:var(--visual-total-row)}

.recent-menu-wrap { position:relative; }
.recent-menu { position:absolute; right:0; top:43px; z-index:50; width:min(420px,72vw); padding:7px; border:1px solid #cad3df; border-radius:10px; background:#fff; color:#243047; box-shadow:0 16px 38px #1018283d; }
.recent-menu button { display:block; width:100%; padding:9px 10px; border:0; background:transparent; color:#243047; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.recent-menu button:hover { background:#edf3fb; }
.recent-menu button small { display:block; color:#718096; overflow:hidden; text-overflow:ellipsis; }
.recent-empty { padding:12px; color:#718096; font-size:12px; }
.tile-text .tile-body { padding:var(--tile-padding-y,6px) 12px; }
.tile-context-menu { position:fixed; z-index:2100; display:grid; width:200px; padding:6px; gap:3px; border:1px solid #cbd5e1; border-radius:8px; background:#fff; box-shadow:0 12px 30px #18223035; }
.tile-context-menu button { text-align:left; border:0; }
.tile-context-menu .danger { color:#b42318; }
.tile-context-menu.tile-layer-context-menu { overflow:visible !important; }
.tile-layer-menu { position:relative; min-width:0; }
.tile-layer-split { display:grid; grid-template-columns:minmax(0,1fr) 30px; gap:1px; }
.tile-layer-split>button:first-child { min-width:0; border-radius:6px 2px 2px 6px; }
.tile-layer-split>.tile-layer-toggle { display:grid; place-items:center; width:30px; min-width:30px; padding:0; border-radius:2px 6px 6px 2px; font-size:20px; line-height:1; text-align:center; }
.tile-layer-flyout { position:absolute; z-index:2; top:-6px; left:100%; display:none; width:174px; padding:6px; gap:3px; border:1px solid var(--qreports-grid,#cbd5e1); border-radius:8px; background:var(--designer-raised,#fff); color:inherit; box-shadow:0 12px 30px #18223035; }
.tile-layer-menu:is(:hover,.is-open,:focus-within)>.tile-layer-flyout { display:grid; }
.tile-layer-flyout-left .tile-layer-flyout { right:100%; left:auto; }
.page-name-editor { width:100%; min-width:0; padding:7px 10px; border:2px solid #4f6ee8; border-radius:7px; background:#fff; color:#182230; font:inherit; }
.page-context-menu { width:350px; max-height:min(690px,calc(100vh - 16px)); overflow:auto; }
.page-layout-title { padding:8px 10px 4px; font-weight:700; }
.page-layout-gallery { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:5px; padding:4px 8px 8px; }
.page-layout-gallery button { display:flex; flex-direction:column; align-items:stretch; gap:3px; min-width:0; padding:5px; cursor:pointer; }
.page-layout-gallery button small { text-align:center; white-space:nowrap; font-size:11px; }
.page-layout-thumb { position:relative; display:block; width:100%; aspect-ratio:16/9; background:var(--surface,#eef2f7); border:1px solid var(--grid,#aab7c9); border-radius:3px; }
.page-layout-thumb i { position:absolute; display:block; box-sizing:border-box; border:1px solid var(--accent,#5369ce); background:color-mix(in srgb,var(--accent,#5369ce) 20%,transparent); }
.empty-page-layout-gallery { width:min(760px,calc(100% - 40px)); max-height:calc(100% - 120px); grid-template-columns:repeat(3,minmax(120px,1fr)); overflow:auto; padding:12px; border:1px solid var(--qreports-grid,#cbd5e1); border-radius:10px; background:color-mix(in srgb,var(--qreports-surface,#fff) 94%,transparent); box-shadow:0 10px 30px #18223018; }
.empty-page-layout-gallery button { padding:8px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#344054); }
.empty-page-layout-gallery button:hover,.empty-page-layout-gallery button:focus-visible { border-color:var(--qreports-accent,#5369ce); background:color-mix(in srgb,var(--qreports-accent,#5369ce) 8%,var(--qreports-surface,#fff)); }
.tile-layoutPlaceholder .tile-body { display:grid; place-items:stretch; padding:8px; overflow:hidden; }
.layout-add-tile { width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;border:2px dashed var(--qreports-grid,#aab7c9);background:transparent;color:var(--qreports-text,#344054);font-weight:600;cursor:pointer; }
.layout-add-tile span { color:var(--qreports-accent,#5369ce);font-size:30px;line-height:1; }
.layout-add-tile b { font:inherit; }
.layout-add-tile small { color:var(--qreports-muted,#667085); font-size:11px; font-weight:500; }
.layout-add-tile:hover,.layout-add-tile:focus-visible { border-color:var(--qreports-accent,#5369ce);background:color-mix(in srgb,var(--qreports-accent,#5369ce) 9%,transparent); }
.layout-tile-menu { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px;max-height:min(70vh,450px);overflow:auto;min-width:250px; }
.layout-tile-menu .page-layout-title { grid-column:1/-1; }
.layout-tile-menu [data-layout-kind] { display:flex; align-items:center; gap:8px; min-width:0; text-align:left; }
.layout-tile-menu [data-layout-kind] b { display:inline-grid; place-items:center; flex:0 0 22px; }
.presentation-mode .tile-layoutPlaceholder { visibility:hidden; }
.page-context-menu hr { border:0; border-top:1px solid var(--grid,#d5dce5); margin:3px 8px; }
.command:disabled { opacity:.45; cursor:default; }
.web-export-dialog .appearance-subgroup { margin:10px 0; padding:10px 12px; border:1px solid #dce3ec; border-radius:8px; }
.web-export-dialog .appearance-subgroup>summary { margin:0; }
.web-export-dialog .appearance-subgroup[open]>summary { margin-bottom:10px; }
.web-export-dialog .presentation-navigation { margin-top:12px; }
.export-preview.preview-tabs>div { display:flex; align-items:stretch; gap:0; margin-top:10px; border-bottom:1px solid currentColor; }
.export-preview.preview-tabs>div button { border-radius:7px 7px 0 0; }
.export-preview.preview-left-tabs { display:grid; grid-template-columns:minmax(110px,150px) minmax(0,1fr); gap:12px; }
.export-preview.preview-left-tabs>[data-preview-title],.export-preview.preview-left-tabs>[data-preview-note] { grid-column:1 / -1; }
.export-preview.preview-left-tabs>div { grid-column:1; flex-direction:column; border-right:1px solid currentColor; border-bottom:0; margin:0; }
.export-preview.preview-left-tabs>div button { width:100%; text-align:left; border-radius:6px 0 0 6px; }
.exported-file-link { display:inline-block; margin-left:6px; padding:4px 8px!important; color:var(--qreports-accent,#4f6ee8)!important; text-decoration:underline; background:transparent!important; border:0!important; }
.qanvas-confirm-dialog { width:min(420px,calc(100vw - 32px)); border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; padding:0; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); color-scheme:var(--qreports-color-scheme,light); }
.qanvas-confirm-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#182230) 55%,transparent); }
.qanvas-confirm-dialog form { padding:20px; }
.qanvas-confirm-dialog h3 { margin:0 0 10px; }
.qanvas-confirm-dialog p { margin:0 0 22px; line-height:1.45; }
.qanvas-confirm-dialog form>div { display:flex; justify-content:flex-end; gap:8px; }
.qanvas-confirm-dialog .danger { background:var(--qreports-negative,#c43d4b); color:var(--qreports-on-negative,#fff); border-color:var(--qreports-negative,#c43d4b); }
.page-section-heading .page-import-button { margin-left:auto; margin-right:5px; }
.page-import-dialog { width:min(760px,calc(100vw - 32px)); min-width:min(520px,calc(100vw - 16px)); min-height:360px; max-width:calc(100vw - 16px); max-height:calc(100vh - 16px); overflow:auto; resize:both; }
.page-import-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#182230) 32%,transparent); }
.page-import-dialog form { min-width:0; }
.page-import-dialog .page-import-titlebar { margin:-20px -20px 10px; padding:17px 20px 13px; border-bottom:1px solid var(--qreports-grid,#cdd5df); cursor:grab; user-select:none; touch-action:none; }
.page-import-dialog .page-import-titlebar:active,.page-import-dialog.dialog-moving .page-import-titlebar { cursor:grabbing; }
.page-import-dialog.dialog-moving { user-select:none; }
.page-import-dialog form>div.page-import-actions { justify-content:flex-start; margin:12px 0 8px; }
.page-import-mode { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:12px 0; padding:0; border:0; }
.page-import-mode legend { margin-bottom:7px; color:var(--qreports-text,#182230); font-size:12px; font-weight:700; }
.page-import-mode label { display:flex; align-items:flex-start; gap:8px; min-width:0; margin:0; padding:10px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:8px; color:var(--qreports-text,#182230); cursor:pointer; }
.page-import-mode label:has(input:checked) { border-color:var(--qreports-accent,#4f6ee8); background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 9%,var(--qreports-surface,#fff)); }
.page-import-mode input { flex:none; margin:3px 0 0; accent-color:var(--qreports-accent,#4f6ee8); }
.page-import-mode span,.page-import-mode b,.page-import-mode small { display:block; min-width:0; }
.page-import-mode small { margin-top:2px; color:color-mix(in srgb,var(--qreports-text,#475467) 68%,transparent); font-weight:400; line-height:1.3; }
[data-import-pages-ui][hidden] { display:none!important; }
.page-import-dialog form>div.page-import-list { display:grid; justify-content:stretch; gap:6px; max-height:min(420px,52vh); overflow:auto; padding:7px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:9px; background:color-mix(in srgb,var(--qreports-header,#eef3f9) 40%,var(--qreports-surface,#fff)); }
.page-import-list label { display:flex; align-items:flex-start; gap:10px; margin:0; padding:9px 10px; border:1px solid transparent; border-radius:7px; color:var(--qreports-text,#182230); cursor:pointer; }
.page-import-list label:hover { border-color:var(--qreports-grid,#cdd5df); background:var(--qreports-surface,#fff); }
.page-import-list input { margin-top:3px; accent-color:var(--qreports-accent,#4f6ee8); }
.page-import-list span,.page-import-list b,.page-import-list small { display:block; }
.page-import-list small { margin-top:2px; color:color-mix(in srgb,var(--qreports-text,#475467) 65%,transparent); }
.page-import-source-toggle { display:flex; align-items:center; gap:8px; margin:14px 0 8px; font-weight:650; color:var(--qreports-text,#182230); }
.page-import-source-toggle input { accent-color:var(--qreports-accent,#4f6ee8); }
.page-import-dialog form>div.page-import-sources { display:grid; justify-content:stretch; gap:7px; max-height:none; overflow:visible; margin:0; padding:7px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:9px; background:color-mix(in srgb,var(--qreports-header,#eef3f9) 40%,var(--qreports-surface,#fff)); }
.page-import-sources[hidden] { display:none!important; }
.page-import-source-card { min-width:0; padding:8px 9px; border-radius:7px; color:var(--qreports-text,#182230); }
.page-import-source-card:hover { background:var(--qreports-surface,#fff); }
.page-import-source-head { display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,1.2fr); align-items:center; gap:12px; }
.page-import-source-head span,.page-import-source-head b,.page-import-source-head small { display:block; min-width:0; }
.page-import-source-head small { margin-top:2px; color:color-mix(in srgb,var(--qreports-text,#475467) 65%,transparent); }
.page-import-source-head select { width:100%; min-width:0; margin:0; }
.page-import-measures { margin:8px 0 0; padding:8px 0 0; border-top:1px solid color-mix(in srgb,var(--qreports-grid,#cdd5df) 72%,transparent); }
.page-import-measures summary { display:flex; align-items:center; gap:7px; padding:2px 0; }
.page-import-measures summary span { margin-left:auto; color:color-mix(in srgb,var(--qreports-text,#475467) 65%,transparent); font-weight:500; }
.page-import-measure-actions { display:flex; gap:5px; margin:7px 0; }
.page-import-measure-actions button { padding:4px 8px; font-size:11px; }
.page-import-measure-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:3px 10px; max-height:none; overflow:visible; padding:5px; border:1px solid color-mix(in srgb,var(--qreports-grid,#cdd5df) 72%,transparent); border-radius:6px; }
.page-import-measure-list label { display:flex; align-items:center; gap:7px; min-width:0; margin:0; padding:4px 5px; color:var(--qreports-text,#182230); cursor:pointer; }
.page-import-measure-list label:hover { background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 7%,var(--qreports-surface,#fff)); }
.page-import-measure-list label.new-measure { background:color-mix(in srgb,var(--qreports-positive,#2f855a) 7%,var(--qreports-surface,#fff)); }
.page-import-measure-list input { flex:none; margin:0; accent-color:var(--qreports-accent,#4f6ee8); }
.page-import-measure-list span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.page-import-measure-list em { flex:none; padding:1px 6px; border:1px solid color-mix(in srgb,var(--qreports-positive,#2f855a) 38%,var(--qreports-grid,#cdd5df)); border-radius:999px; background:color-mix(in srgb,var(--qreports-positive,#2f855a) 12%,var(--qreports-surface,#fff)); color:var(--qreports-positive,#2f855a); font-size:10px; font-style:normal; font-weight:700; }
.page-import-sources>p { margin:8px; color:color-mix(in srgb,var(--qreports-text,#475467) 72%,transparent); }
.page-import-dialog p.page-import-note { margin:12px 0; font-size:12px; color:color-mix(in srgb,var(--qreports-text,#475467) 72%,transparent); }
.page-import-dialog p.error { min-height:18px; margin:0 0 8px; }
@media (max-width:640px) { .page-import-mode,.page-import-source-head,.page-import-measure-list { grid-template-columns:1fr; } }
.source-data-dialog { box-sizing:border-box; width:min(1180px,94vw); height:min(760px,88vh); min-width:min(620px,calc(100vw - 16px)); min-height:360px; max-width:calc(100vw - 16px); max-height:calc(100vh - 16px); padding:0; overflow:hidden; resize:both; border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); box-shadow:0 22px 70px #10182855; color-scheme:var(--qreports-color-scheme,light); }
.source-data-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#182230) 32%,transparent); }
.source-data-dialog form { display:grid; grid-template-rows:auto auto minmax(0,1fr) auto; width:100%; height:100%; min-width:0; min-height:0; }
.source-data-titlebar { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:14px 17px; border-bottom:1px solid var(--qreports-grid,#cdd5df); background:var(--qreports-header,#eef3f9); cursor:grab; user-select:none; touch-action:none; }
.source-data-titlebar:active,.source-data-dialog.dialog-moving .source-data-titlebar { cursor:grabbing; }
.source-data-titlebar h2,.source-data-titlebar p { margin:0; }
.source-data-titlebar h2 { font-size:18px; }
.source-data-titlebar p { margin-top:3px; color:var(--qreports-muted,#667085); font-size:12px; }
.source-data-titlebar>button { min-width:36px; padding:5px 9px; font-size:20px; }
.source-data-toolbar { display:flex; align-items:center; gap:8px; padding:10px 12px; border-bottom:1px solid var(--qreports-grid,#cdd5df); }
.source-data-toolbar input { flex:1; min-width:140px; margin:0; }
.source-data-toolbar span { margin-left:auto; color:var(--qreports-muted,#667085); font-size:12px; white-space:nowrap; }
.source-data-grid { min-width:0; min-height:0; overflow:auto; background:var(--qreports-surface,#fff); }
.source-data-grid table { width:max-content; min-width:100%; border-spacing:0; border-collapse:separate; }
.source-data-grid th { position:sticky; z-index:2; top:0; padding:0; border-right:1px solid var(--qreports-grid,#d7dee7); border-bottom:1px solid var(--qreports-grid,#d7dee7); background:var(--qreports-header,#eef3f9); text-align:left; }
.source-data-grid th button { display:grid; grid-template-columns:minmax(90px,1fr) auto; width:100%; min-height:45px; padding:7px 10px; border:0; border-radius:0; color:inherit; background:transparent; text-align:left; }
.source-data-grid th span,.source-data-grid th small { grid-column:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.source-data-grid th small { color:var(--qreports-muted,#667085); font-size:10px; font-weight:400; }
.source-data-grid th i { grid-column:2; grid-row:1 / span 2; align-self:center; color:var(--qreports-accent,#4f6ee8); font-style:normal; }
.source-data-grid td { max-width:380px; padding:7px 10px; overflow:hidden; border-right:1px solid var(--qreports-grid,#e3e8ef); border-bottom:1px solid var(--qreports-grid,#e3e8ef); text-overflow:ellipsis; white-space:nowrap; }
.source-data-grid tbody tr:nth-child(even) td { background:color-mix(in srgb,var(--qreports-header,#eef3f9) 45%,var(--qreports-surface,#fff)); }
.source-data-empty { display:grid; min-height:220px; place-items:center; padding:24px; color:var(--qreports-muted,#667085); text-align:center; }
.source-data-empty[hidden] { display:none; }
.source-data-dialog footer { display:flex; justify-content:flex-end; gap:8px; padding:10px 12px; border-top:1px solid var(--qreports-grid,#cdd5df); background:var(--qreports-surface,#fff); }
.source-data-dialog footer>span { align-self:center; margin-right:auto; color:var(--qreports-muted,#667085); font-size:11px; }
.local-source-grid table { font-size:13px; }
.local-source-grid th { box-sizing:border-box; width:240px; min-width:150px; padding:0; vertical-align:top; }
.local-source-grid th.local-source-row-number,.local-source-grid tbody th { left:0; z-index:3; width:38px; min-width:38px; max-width:38px; padding:0; text-align:center; }
.local-source-grid tbody th { display:flex; align-items:center; justify-content:space-between; height:36px; background:var(--qreports-surface,#fff); }
.local-source-grid tbody th>span { flex:1; color:var(--qreports-muted,#667085); font-size:11px; }
.local-source-grid .local-column-heading { display:grid; grid-template-columns:minmax(80px,1fr) repeat(4,27px); align-items:center; height:35px; gap:0; }
.local-source-grid thead input { box-sizing:border-box; width:100%; min-width:80px; height:35px; margin:0; padding:7px 9px; border:0; border-radius:0; color:var(--qreports-text,#182230); background:transparent; font-weight:700; }
.local-source-grid thead select { box-sizing:border-box; width:100%; height:27px; margin:0; padding:3px 8px; border-width:1px 0 0; border-radius:0; color:var(--qreports-muted,#667085); background:color-mix(in srgb,var(--qreports-header,#eef3f9) 55%,var(--qreports-surface,#fff)); font-size:10px; }
.local-source-grid thead button,.local-source-grid tbody th button { display:grid; grid-template-columns:none; place-items:center; box-sizing:border-box; width:27px; min-width:27px; min-height:27px; margin:0; padding:0; border:0; border-radius:0; color:var(--qreports-muted,#667085); background:transparent; font-size:13px; }
.local-source-grid thead button:hover { color:var(--qreports-accent,#4f6ee8); background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 9%,transparent); }
.local-source-grid thead button.active { color:var(--qreports-accent,#4f6ee8); background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 14%,transparent); }
.local-source-grid thead [data-local-delete-column],.local-source-grid tbody th button { color:var(--qreports-negative,#b42318); }
.local-source-grid td { height:36px; max-width:none; padding:0; }
.local-source-grid td input,.local-source-grid td select { box-sizing:border-box; width:100%; min-width:0; height:35px; margin:0; padding:7px 10px; border:0; border-radius:0; color:var(--qreports-text,#182230); background:transparent; }
.local-source-grid td input:focus,.local-source-grid td select:focus,.local-source-grid thead input:focus { position:relative; z-index:1; outline:0; box-shadow:inset 0 0 0 2px var(--qreports-accent,#4f6ee8); background:var(--qreports-surface,#fff); }
.add-source-dialog fieldset { display:grid; gap:8px; margin:12px 0; padding:10px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:8px; }
.add-source-dialog fieldset label { display:grid; grid-template-columns:auto 1fr; align-items:start; gap:4px 8px; }
.add-source-dialog fieldset small { grid-column:2; color:var(--qreports-muted,#667085); }
.local-query-editor { width:min(1320px,96vw); height:min(840px,92vh); }
.local-query-editor form { grid-template-rows:auto auto minmax(0,1fr) auto; }
.local-query-editor .source-data-titlebar>strong { margin-left:auto; padding:4px 9px; border-radius:999px; color:var(--qreports-muted,#667085); background:color-mix(in srgb,var(--qreports-grid,#cdd5df) 38%,transparent); font-size:11px; white-space:nowrap; }
.local-query-editor .source-data-titlebar>strong.dirty { color:var(--qreports-negative,#b42318); background:color-mix(in srgb,var(--qreports-negative,#b42318) 11%,transparent); }
.local-query-strip { display:flex; align-items:stretch; min-width:0; overflow-x:auto; border-bottom:1px solid var(--qreports-grid,#cdd5df); background:color-mix(in srgb,var(--qreports-header,#eef3f9) 58%,var(--qreports-surface,#fff)); }
.local-query-strip>button { flex:none; min-height:44px; padding:7px 12px; border-width:0 1px 0 0; border-radius:0; background:transparent; }
.local-query-strip>button.active { border-bottom:3px solid var(--qreports-accent,#4f6ee8); color:var(--qreports-text,#182230); font-weight:700; }
.local-query-strip>button.primary { align-self:center; min-height:36px; margin:4px; border:1px solid var(--qreports-accent,#4f6ee8); border-radius:7px; color:var(--qreports-on-accent,#fff); background:var(--qreports-accent,#4f6ee8); }
.local-query-strip>button:disabled:not(.active) { opacity:.45; }
.local-query-filter { display:flex; align-items:center; gap:6px; flex:0 1 250px; min-width:160px; margin:4px 8px; padding:0 8px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:7px; background:var(--qreports-surface,#fff); }
.local-query-filter span { color:var(--qreports-muted,#667085); font-size:11px; }
.local-query-filter input { min-width:80px; height:30px; margin:0; padding:3px; border:0; background:transparent; }
.local-query-strip>[data-local-status] { align-self:center; margin-left:auto; padding:0 12px; color:var(--qreports-muted,#667085); font-family:Consolas,monospace; font-size:11px; white-space:nowrap; }
.local-query-editor .local-source-grid th { background:color-mix(in srgb,var(--qreports-header,#eef3f9) 76%,var(--qreports-surface,#fff)); }
.local-query-editor:not(.editing-columns) .local-structure-only,.local-query-editor:not(.editing-columns) [data-local-delete-row] { display:none; }
.local-query-editor:not(.editing-columns) .local-source-grid tbody th { justify-content:center; }
.local-query-editor [data-local-edit-columns].active { color:var(--qreports-accent,#4f6ee8); background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 10%,transparent); font-weight:700; }
.local-source-grid thead .local-column-display { display:flex; align-items:center; justify-content:space-between; width:100%; min-width:0; min-height:46px; padding:5px 11px; color:var(--qreports-text,#182230); text-align:left; }
.local-source-grid thead .local-column-display>span { display:grid; min-width:0; }
.local-source-grid thead .local-column-display strong,.local-source-grid thead .local-column-display small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.local-source-grid thead .local-column-display small { margin-top:2px; color:var(--qreports-muted,#667085); font-size:10px; font-weight:400; }
.local-source-grid thead .local-column-display i { flex:none; color:var(--qreports-accent,#4f6ee8); font-style:normal; }
.local-source-grid .local-column-resizer { position:absolute; z-index:5; top:0; right:-4px; bottom:0; width:9px; cursor:col-resize; touch-action:none; }
.local-source-grid .local-column-resizer:hover { background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 18%,transparent); }
.local-query-editor .local-source-grid tbody th { position:sticky; left:0; }
.local-query-editor .local-source-grid tbody tr:hover td { background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 5%,var(--qreports-surface,#fff)); }
.local-query-editor .local-source-grid td.selected { box-shadow:inset 0 0 0 2px var(--qreports-accent,#4f6ee8); background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 9%,var(--qreports-surface,#fff)); }
.local-query-editor .local-source-grid td.selected :is(input,select) { background:transparent; }
.local-lookup-dialog { width:min(520px,92vw); padding:0; overflow:hidden; border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); box-shadow:0 22px 70px #10182855; }
.local-lookup-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#182230) 32%,transparent); }
.local-lookup-dialog form { display:grid; gap:12px; }
.local-lookup-dialog header { display:flex; align-items:start; gap:12px; padding:14px 16px; border-bottom:1px solid var(--qreports-grid,#cdd5df); background:var(--qreports-header,#eef3f9); cursor:grab; }
.local-lookup-dialog header>div { flex:1; min-width:0; }
.local-lookup-dialog h3,.local-lookup-dialog p { margin:0; }
.local-lookup-dialog p { margin-top:3px; color:var(--qreports-muted,#667085); font-size:12px; }
.local-lookup-dialog header>button { padding:4px 9px; font-size:18px; }
.local-lookup-dialog form>label,.local-lookup-fields { margin:0 16px; }
.local-lookup-dialog label { display:grid; gap:5px; color:var(--qreports-muted,#667085); font-size:12px; }
.local-lookup-dialog select { width:100%; min-width:0; margin:0; }
.local-lookup-fields { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.local-lookup-dialog [data-lookup-table-options],.local-lookup-date-options { display:grid; gap:12px; margin:0 16px; }
.local-lookup-dialog [hidden] { display:none!important; }
.local-lookup-date-options { padding:12px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:8px; background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 5%,var(--qreports-surface,#fff)); }
.local-lookup-date-options label.check { display:flex; align-items:center; gap:8px; color:var(--qreports-text,#182230); }
.local-lookup-date-options input { width:auto; }
.local-date-cell { display:block; min-width:0; }
.local-date-cell .date-picker-actions { display:flex; min-width:0; }
.local-date-cell .date-picker-selected { width:100%; min-width:0; height:35px; padding:7px 10px; overflow:hidden; border:0; border-radius:0; background:transparent; color:var(--qreports-text,#182230); text-align:left; text-overflow:ellipsis; white-space:nowrap; }
.local-date-cell .date-picker-selected:hover,.local-date-cell .date-picker-selected:focus-visible { background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 8%,var(--qreports-surface,#fff)); }
.local-lookup-dialog footer { display:flex; justify-content:flex-end; gap:8px; padding:12px 16px; border-top:1px solid var(--qreports-grid,#cdd5df); }
.local-save-file-dialog { width:min(560px,92vw); padding:0; overflow:hidden; border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; color:var(--qreports-text,#182230); background:var(--qreports-surface,#fff); box-shadow:0 22px 70px #10182855; }
.local-save-file-dialog::backdrop { background:color-mix(in srgb,var(--qreports-header,#182230) 32%,transparent); }
.local-save-file-dialog form { display:grid; gap:12px; }
.local-save-file-dialog header { display:flex; align-items:start; gap:12px; padding:14px 16px; border-bottom:1px solid var(--qreports-grid,#cdd5df); background:var(--qreports-header,#eef3f9); cursor:grab; }
.local-save-file-dialog header>div { flex:1; min-width:0; }
.local-save-file-dialog h3,.local-save-file-dialog p { margin:0; }
.local-save-file-dialog header p { margin-top:3px; color:var(--qreports-muted,#667085); font-size:12px; }
.local-save-file-dialog header>button { padding:4px 9px; font-size:18px; }
.local-save-file-dialog form>label,.local-save-file-dialog form>.error { margin:0 16px; }
.local-save-file-dialog label { display:grid; gap:5px; color:var(--qreports-muted,#667085); font-size:12px; }
.local-save-file-dialog input { box-sizing:border-box; width:100%; margin:0; }
.local-save-file-dialog .error { min-height:17px; color:var(--qreports-negative,#b42318); font-size:12px; }
.local-save-file-dialog footer { display:flex; justify-content:flex-end; gap:8px; padding:12px 16px; border-top:1px solid var(--qreports-grid,#cdd5df); }
@media (max-width:800px) { .local-query-strip { flex-wrap:wrap; }.local-query-filter { order:2; flex:1 1 220px; }.local-query-strip>[data-local-status] { order:3; width:100%; padding:6px 10px; }.local-query-editor footer>span { display:none; } }
@media (max-width:680px) { .source-data-toolbar { flex-wrap:wrap; }.source-data-toolbar input { flex-basis:100%; }.source-data-toolbar span { margin-left:0; margin-right:auto; } }
.tile-move-menu { margin:0; padding:0; border:0; }
.tile-move-menu summary { padding:7px 11px; border-radius:6px; list-style:none; font-size:inherit; font-weight:400; color:inherit; }
.tile-move-menu summary::-webkit-details-marker { display:none; }
.tile-move-menu summary::after { content:"›"; float:right; }
.tile-move-menu[open] summary { background:#eef3f9; }
.tile-move-menu>div { display:grid; max-height:210px; overflow:auto; padding:3px 0 3px 12px; }
.visual-designer-overlay { position:fixed; inset:0; z-index:4000; display:grid; place-items:center; box-sizing:border-box; padding:clamp(6px,2vh,24px); overflow:hidden; background:#1018288c; }
.visual-designer { display:grid; grid-template-rows:64px minmax(0,1fr) 62px; width:min(1280px,96vw); height:min(820px,94vh); min-width:760px; min-height:520px; max-width:98vw; max-height:96vh; overflow:hidden; resize:both; border-radius:13px; background:#f8fafc; box-shadow:0 24px 80px #10182866; }
.visual-designer>header { display:flex; align-items:center; justify-content:space-between; padding:0 22px; color:#fff; background:#1f3158; cursor:move; user-select:none; touch-action:none; }
.visual-designer.panel-moving { user-select:none; }
.chart-designer-panel { grid-template-rows:54px minmax(0,1fr); width:min(1500px,96vw); height:min(920px,94vh); min-width:760px; min-height:520px; }
.chart-designer-panel>iframe { width:100%; height:100%; min-width:0; min-height:0; border:0; background:var(--qreports-surface,#fff); }
.visual-designer>header strong,.visual-designer>header small { display:block; }
.visual-designer>header small { color:#cbd7f4; margin-top:3px; }
.visual-designer>header button { color:#fff; border-color:#ffffff55; background:transparent; font-size:20px; }
.svg-designer-launch { width:100%; margin:0 0 10px; padding:9px 12px; color:var(--qreports-on-accent,#fff); background:var(--qreports-accent,#4f6ee8); font-weight:700; }
.svg-designer { width:min(1480px,calc(100vw - 12px)); height:min(900px,calc(100dvh - 12px)); min-height:min(520px,calc(100dvh - 12px)); max-height:calc(100dvh - 12px); overflow:hidden; }
.svg-designer>header,.svg-designer>footer { position:relative; z-index:3; }
.svg-designer-layout { position:relative; z-index:1; display:grid; grid-template-columns:minmax(420px,1.45fr) minmax(330px,.9fr) minmax(210px,.55fr); width:100%; height:100%; min-height:0; overflow:hidden; overscroll-behavior:none; }
.svg-designer-layout>main,.svg-designer-layout>aside { min-width:0; min-height:0; padding:18px; overflow:auto; overscroll-behavior:contain; scrollbar-gutter:stable; }
.svg-designer-options { box-sizing:border-box; height:100%; max-height:100%; padding-bottom:112px!important; overflow-anchor:none; scroll-padding-block:18px 112px; }
.svg-designer-options,.svg-designer-fields { border-left:1px solid #d7dee7; background:#fff; }
.svg-designer-preview { display:grid; grid-template-columns:minmax(0,1fr); grid-template-rows:auto minmax(0,1fr); gap:10px; background:#eef2f6; }
.svg-designer-preview>div:first-child { display:flex; align-items:baseline; justify-content:space-between; gap:12px; }
.svg-designer-preview h3 { margin:0; }
.svg-designer-preview [data-svg-designer-preview] { display:grid; box-sizing:border-box; width:100%; min-width:0; min-height:0; place-items:center; align-self:stretch; justify-self:stretch; padding:18px; overflow:auto; border:1px solid #cbd5e1; border-radius:10px; background:#fff; }
.svg-designer-preview [data-svg-designer-preview] { grid-template-rows:minmax(0,1fr) auto; align-content:center; }
.svg-designer-preview-tile { position:relative; box-sizing:border-box; width:100%; min-width:160px; max-width:100%; max-height:100%; overflow:hidden; border:1px solid #d7dee7; border-radius:8px; background:var(--qreports-surface,#fff); box-shadow:0 2px 10px #10182818; }
.svg-designer-preview-tile>.tile-body { position:absolute!important; inset:0; width:auto!important; height:auto!important; }
.svg-designer-preview-tile .svg-tile-link { pointer-events:none; }
.svg-preview-size { margin-top:8px; color:#667085; font-size:10px; }
.svg-designer-preview [data-svg-analysis-status].error { color:var(--qreports-negative,#b42318); font-weight:700; }
.svg-designer-templates { margin:0 0 12px; padding:0 0 12px; border-bottom:1px solid #e1e7ef; }
.svg-designer-templates>summary { display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; cursor:pointer; color:#344054; font-size:14px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
.svg-designer-templates:not([open])>summary { margin-bottom:0; }
.svg-designer-templates>summary small,.svg-designer-custom>details>summary small { color:#667085; font-size:10px; font-weight:600; letter-spacing:0; text-transform:none; }
.svg-designer-templates>div { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:5px; }
.svg-designer-templates button { display:grid; min-width:0; min-height:50px; place-items:center; gap:2px; padding:6px 3px; font-size:15px; }
.svg-designer-templates button span { max-width:100%; overflow:hidden; font-size:9px; text-overflow:ellipsis; white-space:nowrap; }
.svg-designer-templates button.active { border-color:var(--qreports-accent,#4f6ee8); background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 11%,#fff); box-shadow:inset 0 0 0 1px var(--qreports-accent,#4f6ee8); }
.svg-designer-custom { display:grid; gap:10px; margin-top:16px; }
.svg-designer-custom.hidden { display:none; }
.svg-designer-section-heading { display:flex; align-items:end; justify-content:space-between; gap:8px; }
.svg-designer-section-heading h3 { margin-bottom:3px; }
.svg-designer-section-heading small { color:#667085; }
.svg-designer-custom textarea[data-svg-designer-code] { box-sizing:border-box; width:100%; min-height:150px; margin-top:8px; resize:vertical; font:11px/1.45 Consolas,"Cascadia Mono",monospace; }
.svg-designer-custom details { padding:8px 0; border-top:1px solid #e1e7ef; }
.svg-designer-custom>details>summary { display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; cursor:pointer; font-weight:700; }
.svg-designer-custom>details:not([open])>summary { margin-bottom:0; }
.svg-designer-help { margin:0 0 8px; }
.svg-component-summary { display:flex; flex-wrap:wrap; gap:5px; margin-bottom:8px; }
.svg-component-summary span { padding:3px 7px; border-radius:999px; background:#edf2f7; color:#475467; font-size:10px; }
.svg-component-list { max-height:190px; overflow:auto; border:1px solid #d7dee7; border-radius:7px; }
.svg-component-list label { display:flex; align-items:start; gap:7px; margin:0; padding:6px 8px; border-bottom:1px solid #edf1f5; cursor:pointer; }
.svg-component-list label:last-child { border-bottom:0; }
.svg-component-list input { flex:none; margin-top:3px; }
.svg-component-list span,.svg-component-list b,.svg-component-list small { display:block; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.svg-component-list b { font-size:11px; }.svg-component-list small { color:#667085; font-size:9px; }
.svg-component-editors { display:grid; gap:6px; }
.svg-component-editor { padding:0!important; overflow:hidden; border:1px solid #d7dee7!important; border-radius:8px; background:#fbfcfe; }
.svg-component-editor>summary { display:grid!important; grid-template-columns:minmax(0,1fr) minmax(70px,.7fr); align-items:center; gap:8px; box-sizing:border-box; min-height:44px; margin:0!important; padding:7px 9px; list-style-position:inside; }
.svg-component-editor>summary>span { display:block; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.svg-component-editor>summary b,.svg-component-editor>summary small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.svg-component-editor>summary small { color:#667085; font-size:9px; }
.svg-component-current { color:#475467; font-size:10px; text-align:right; }
.svg-component-editor-body { display:grid; gap:7px; padding:9px; border-top:1px solid #e1e7ef; background:#fff; }
.svg-component-actions { display:flex; justify-content:flex-end; gap:6px; }
.svg-component-actions button:first-child { margin-right:auto; }
.svg-component-editor.svg-component-selected { border-color:var(--qreports-accent,#4f6ee8)!important; box-shadow:0 0 0 3px color-mix(in srgb,var(--qreports-accent,#4f6ee8) 22%,transparent); }
.svg-additional-date-markers { display:grid; gap:8px; margin-top:12px; padding-top:10px; border-top:1px solid #e1e7ef; }
.svg-additional-date-markers>h4 { margin:0 0 2px; color:#475467; font-size:11px; text-transform:uppercase; letter-spacing:.06em; }
.svg-date-marker-editor { display:grid; gap:8px; padding:0!important; overflow:hidden; border:1px solid #d7dee7!important; border-radius:8px; background:#fbfcfe; }
.svg-date-marker-editor>summary { display:flex!important; align-items:center; justify-content:space-between; gap:8px; margin:0!important; padding:9px; cursor:pointer; }
.svg-date-marker-editor>summary span { overflow:hidden; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.svg-date-marker-editor>summary small { color:#667085; }
.svg-date-marker-editor>label,.svg-date-marker-editor>div,.svg-date-marker-editor>details { margin-inline:9px; }
.svg-date-marker-editor>.svg-component-actions { margin-bottom:9px; }
.svg-component-editor-body label { display:grid; gap:3px; margin:0; color:#475467; font-size:10px; }
.svg-component-editor-body input,.svg-component-editor-body select { box-sizing:border-box; width:100%; min-width:0; }
.svg-component-token-input { display:grid; grid-template-columns:minmax(0,1fr) 32px; gap:4px; }
.svg-component-token-input button { display:grid; place-items:center; width:32px; min-width:32px; height:32px; padding:0; font-size:16px; }
.svg-component-editor-body .svg-category-slot { display:flex; align-items:center; gap:6px; color:#344054; font-size:11px; font-weight:700; }
.svg-component-editor-body .svg-category-slot input { width:auto; }
.svg-option-help { color:#667085; font-size:9px; }
.svg-component-text-tools { display:grid; grid-template-columns:minmax(100px,1.7fr) 62px 76px minmax(110px,1fr); gap:5px; }
.svg-component-geometry { min-width:0; margin:2px 0; padding:7px; border:1px solid #e1e7ef; border-radius:8px; }
.svg-component-geometry>legend { padding:0 4px; color:#344054; font-size:10px; font-weight:700; }
.svg-component-geometry>div { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:5px; }
.svg-component-color { display:grid; grid-template-columns:minmax(0,1fr) 34px; gap:4px; }
.svg-component-color input[type="color"] { height:32px; padding:2px; }
.svg-paint-swatch { width:24px; height:24px; justify-self:end; border:1px solid #cbd5e1; border-radius:5px; background-image:linear-gradient(45deg,#e5e7eb 25%,transparent 25%),linear-gradient(-45deg,#e5e7eb 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e5e7eb 75%),linear-gradient(-45deg,transparent 75%,#e5e7eb 75%); background-position:0 0,0 4px,4px -4px,-4px 0; background-size:8px 8px; }
.svg-designer-property-note { padding:8px 10px; border:1px solid var(--qreports-grid,#d7dee7); border-radius:7px; background:var(--qreports-header,#f5f7fa); }
.svg-binding-drop { display:grid; gap:2px; min-height:48px; margin:7px 0; padding:9px; border:2px dashed #9fb0c8; border-radius:8px; background:#f8fafc; }
.svg-binding-drop.drag-over { border-color:var(--qreports-accent,#4f6ee8); background:#eef3ff; }
.svg-binding-drop small { color:#667085; }
.svg-designer-fields [data-svg-source-fields],.svg-designer-fields [data-svg-source-parameters] { display:grid; gap:4px; }
.svg-designer-fields [data-svg-source-fields] button,.svg-designer-fields [data-svg-source-parameters] button { display:flex; align-items:center; gap:7px; min-width:0; padding:7px 8px; overflow:hidden; background:#fff; text-align:left; text-overflow:ellipsis; white-space:nowrap; cursor:grab; }
.svg-designer-fields [data-svg-source-fields] button span { color:#667085; }
.svg-designer-preview [data-qanvas-field] { cursor:pointer; transition:filter .12s ease,opacity .12s ease; }
.svg-designer-preview [data-qanvas-field]:hover { filter:drop-shadow(0 0 2px var(--qreports-accent,#4f6ee8)); opacity:.82; }
@media (max-width:1000px) { .svg-designer-layout { grid-template-columns:minmax(360px,1.2fr) minmax(300px,1fr); }.svg-designer-fields { display:none; } }
.visual-designer-layout { display:grid; grid-template-columns:280px 6px 280px 6px minmax(320px,1fr); grid-template-areas:"fields split2 options split1 preview"; min-height:0; }
.designer-preview { grid-area:preview; }
.visual-designer-layout>.designer-preview { display:block; width:100%; height:100%; min-width:0; min-height:0; }
.designer-options { grid-area:options; }
.designer-fields { grid-area:fields; }
.designer-splitter { cursor:col-resize; background:#e4e9f0; transition:background .15s; touch-action:none; }
.designer-splitter:hover,.designer-splitter:active { background:#5b7fe4; }
.designer-splitter[data-splitter="preview"] { grid-area:split1; }
.designer-splitter[data-splitter="fields"] { grid-area:split2; }
.visual-designer-layout>aside,.designer-preview { min-width:0; overflow:auto; padding:20px; }
.visual-designer-layout>aside { background:#fff; }
.designer-fields { border-right:1px solid #d7dee7; }
.matrix-field-controls { position:sticky; top:0; z-index:2; display:grid; gap:9px; margin:0 0 13px; padding:0 0 10px; background:var(--qreports-surface,#fff); }
.matrix-field-controls input,.matrix-field-controls select { box-sizing:border-box; width:100%; min-width:0; }
.matrix-field-controls label { display:grid; gap:4px; font-size:12px; }
.matrix-field-section { margin:15px 0 5px; color:#667085; font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }
.matrix-field-section:first-child { margin-top:0; }
.visual-designer .matrix-measure-folder { margin:0 0 0 3px; padding:0; border:0; }
.matrix-measure-folder .matrix-measure-folder { margin-left:12px; }
.matrix-measure-folder > summary { padding:5px; cursor:pointer; font-size:12px; font-weight:600; }
.matrix-measure-folder > div { margin-left:10px; }
.matrix-fields-empty { padding:9px 0; }
.designer-options { border-left:1px solid #d7dee7; }
.visual-designer h3 { margin:0 0 14px; color:#344054; font-size:14px; text-transform:uppercase; letter-spacing:.08em; }
.visual-designer h4 { margin:18px 0 8px; }
.designer-options [data-designer-options]>section:first-child>h4 { margin-top:0; }
.visual-designer p { color:#667085; font-size:12px; }
.designer-preview [data-designer-preview] { width:100%; height:calc(100% - 32px); min-height:360px; padding:16px; overflow:auto; border:1px solid #d7dee7; border-radius:9px; background:#fff; }
.designer-preview .data-table { width:max-content; min-width:100%; }
.designer-field-row { display:grid; grid-template-columns:auto minmax(0,1fr); align-items:center; gap:8px; padding:7px 6px; border:1px solid transparent; border-bottom-color:#edf1f5; cursor:grab; font-size:12px; }
.designer-field-row:hover,.matrix-field:hover { border-color:#9bb8e8; border-radius:6px; background:#eef4ff; }
.designer-field-row.dragging,.matrix-field.dragging { opacity:.45; }
.designer-field-row span { overflow:hidden; text-overflow:ellipsis; }
.designer-field-row button,.matrix-field button,.designer-chip button,.matrix-value button { padding:3px 6px; }
.matrix-field { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:8px; padding:7px 6px; border:1px solid transparent; border-bottom-color:#edf1f5; cursor:grab; font-size:12px; font-weight:400; }
.matrix-field b { font-weight:500; }
.matrix-field small { max-width:120px; overflow:hidden; color:var(--qreports-muted,#667085); font-size:10px; text-overflow:ellipsis; white-space:nowrap; }
.matrix-field button { font-size:10px; }
.designer-chip,.matrix-value { display:flex; align-items:center; justify-content:space-between; gap:7px; margin:5px 0; padding:7px 9px; border:1px solid #d7dee7; border-radius:7px; background:#f8fafc; }
.designer-drag-handle { flex:none; color:#53657b; font-size:18px; line-height:1; cursor:grab; user-select:none; }
.designer-drag-handle:active { cursor:grabbing; }
.designer-chip.dragging,.matrix-value.dragging { opacity:.45; border-color:#5273df; }
.designer-chip.selected,.matrix-value.selected { border-color:#5273df; background:#eef3ff; box-shadow:0 0 0 1px #5273df inset; }
.column-bars { margin-top:14px; border-top:1px solid #dce3ec; padding-top:10px; }
.column-bars summary { cursor:pointer; font-weight:700; color:#263755; margin-bottom:10px; }
.cell-visual { position:relative; display:block; min-width:72px; min-height:20px; line-height:20px; overflow:hidden; }
.cell-visual > i { position:absolute; z-index:0; top:2px; bottom:2px; opacity:.38; border-radius:2px; }
.cell-visual > b { position:relative; z-index:2; font-weight:inherit; }
.cell-renderer-badge{display:inline-flex;align-items:center;justify-content:center;min-width:2.2em;min-height:1.8em;padding:.18em .65em;background:var(--cell-renderer-color);color:#fff;font-weight:700;line-height:1.2;box-shadow:inset 0 0 0 1px #ffffff38}.cell-renderer-pill{border-radius:999px}.cell-renderer-rounded{border-radius:.5em}.cell-renderer-square{border-radius:.15em}.cell-renderer-circle{width:2.25em;height:2.25em;padding:0;border-radius:50%}.cell-renderer-icon{display:inline-flex;align-items:center;gap:.4em}.cell-renderer-icon>i{color:var(--cell-renderer-color);font-style:normal;font-size:1.25em;line-height:1}.cell-renderer-icon>b{font-weight:inherit}.cell-renderer-options{margin:12px 0;padding:10px;border:1px solid var(--qreports-grid,#ccd5e0);border-radius:9px}
.card-content { width:100%; min-width:0; }
.card-value { line-height:1.08; overflow-wrap:anywhere; }
.card-comparison { margin-top:5px; font-size:14px; font-weight:650; }
.card-properties { margin-top:16px; padding-top:12px; border-top:1px solid #dde3e9; }
.card-properties h4 { margin:12px 0 9px; font-size:12px; }
.card-help { display:block; margin:-5px 0 10px; color:#667085; line-height:1.4; }
.bullet-cell .bullet-background { left:0; opacity:.75; }
.bullet-cell .bullet-value { left:0; top:6px; bottom:6px; opacity:.9; }
.bullet-cell .bullet-target { top:1px; bottom:1px; opacity:1; border-radius:0; transform:translateX(-50%); }
.field-well { min-height:50px; padding:7px; border:2px dashed #c7d2e2; border-radius:8px; color:#7b8798; background:#f8fafc; transition:.15s; }
.field-well.drag-over { border-color:#4f7ee8; background:#eaf1ff; color:#294caa; }
.matrix-value select { width:110px; margin:0 0 0 auto; padding:5px; }
.visual-designer>footer { display:flex; align-items:center; justify-content:flex-end; gap:8px; padding:0 20px; border-top:1px solid #d7dee7; background:#fff; }
#webChartButton { display:none!important; }
.tile-table .tile-body,.tile-matrix .tile-body { padding-top:0; isolation:isolate; }
.tile-table .data-table,.tile-matrix .data-table { color:var(--visual-text); }
.tile-table .data-table th,.tile-matrix .data-table th { background:var(--visual-header); z-index:3; background-clip:padding-box; }
.tile-table .data-table th[data-tile-sort],.tile-matrix .data-table th[data-tile-sort] { cursor:pointer; user-select:none; }
.sort-mark { color:#315fc4; font-size:9px; white-space:nowrap; }
.sort-designer { margin-top:18px; padding-top:12px; border-top:1px solid #d7dee7; }
.sort-designer>small { display:block; margin:-4px 0 9px; color:#667085; }
.sort-row { display:grid; grid-template-columns:20px minmax(100px,1fr) 105px 32px 32px 32px; gap:4px; align-items:center; margin-bottom:5px; }
.sort-row select { min-width:0; margin:0; padding:5px; }
.sort-row button { padding:4px; }
.tile-table .data-table td,.tile-matrix .data-table td { border-color:var(--visual-grid); }
.tile-table .data-table tbody tr:nth-child(even),.tile-matrix .data-table tbody tr:nth-child(even) { background:var(--visual-alt); }
.tile.no-table-grid .data-table td,.tile.no-table-grid .data-table th { border-color:transparent; }
.data-table tfoot td { padding:7px 8px; border-top:2px solid var(--visual-grid,#9aa8b7); background:var(--visual-header,#f5f7fa); font-weight:700; }
.visual-appearance { margin-top:16px; padding-top:12px; border-top:1px solid #dde3e9; }
.visual-appearance h4 { margin:0 0 10px; font-size:12px; }
body.busy::before { content:"Opening editor…"; }
body.excel-export.busy::before,body.excel-export.busy::after { display:none!important; content:none!important; }
.chart-web-svg.hide-category-axis .chart-axis-label:not(.value-axis-label),.chart-web-svg.hide-category-axis .chart-group-label { display:none; }
@media(max-width:900px) { .visual-designer { min-width:680px; } }
.cell-visual .data-bar-zero{position:absolute;z-index:1;top:1px;bottom:1px;width:1px;background:#7c8798;opacity:.75}.cell-visual>i:not(.bullet-background):not(.bullet-value):not(.bullet-target){z-index:0}

/* Matrix designer navigation and collapsible panes. */
.designer-fields-collapse{position:absolute;top:9px;right:8px;z-index:4;display:flex;align-items:center;gap:5px;height:30px;padding:3px 8px;border-color:var(--qreports-grid,#cbd5e1);background:var(--qreports-surface,#fff);color:var(--qreports-text,#344054)}
.designer-fields-collapse span{font-size:20px;line-height:1}.designer-fields-collapse b{display:none;font-size:10px;letter-spacing:.08em;text-transform:uppercase}
.designer-fields{position:relative}
.visual-designer-layout.fields-collapsed{grid-template-columns:34px 0 280px 6px minmax(320px,1fr)}
.visual-designer-layout.fields-collapsed>.designer-splitter[data-splitter="fields"]{display:none}
.visual-designer-layout.fields-collapsed>.designer-fields{padding:0;overflow:hidden;background:var(--qreports-surface,#fff)}
.visual-designer-layout.fields-collapsed>.designer-fields>*:not(.designer-fields-collapse){display:none}
.visual-designer-layout.fields-collapsed .designer-fields-collapse{inset:0;width:34px;height:100%;padding:0;border:0;border-radius:0;writing-mode:vertical-rl;background:color-mix(in srgb,var(--qreports-header,#1f3158) 8%,var(--qreports-surface,#fff))}
.visual-designer-layout.fields-collapsed .designer-fields-collapse b{display:inline}
.matrix-value-navigation{position:sticky;top:-20px;z-index:12;display:grid;grid-template-columns:30px minmax(0,1fr) 30px auto;align-items:end;gap:5px;margin:-20px -20px 14px;padding:9px 10px;border-bottom:1px solid var(--qreports-grid,#d7dee7);background:color-mix(in srgb,var(--qreports-surface,#fff) 94%,var(--qreports-header,#1f3158));box-shadow:0 4px 10px #10182812}
.matrix-value-navigation label{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:7px;margin:0;font-size:11px;font-weight:700}
.matrix-value-navigation select{min-width:0;width:100%;margin:0;padding:5px}
.matrix-value-navigation button{height:30px;padding:3px 8px;white-space:nowrap}
.theme-format-mark{display:inline-grid;place-items:center;min-width:15px;height:15px;margin-right:5px;padding:0 3px;border:1px solid currentColor;border-radius:4px;font-size:9px;font-style:normal;font-weight:800;line-height:1;vertical-align:1px;opacity:.85}
.designer-preview th[data-tile-sort],.designer-preview [data-matrix-format-area],.designer-preview [data-matrix-group-header]{cursor:pointer}
.designer-preview .designer-selected-heading{position:relative;z-index:2;box-shadow:inset 0 0 0 3px var(--qreports-accent,#4f8bd6),inset 0 -4px 0 var(--qreports-accent,#4f8bd6)!important}
.table-group-format{margin:0 0 12px}
.table-group-well .designer-chip.selected{outline:2px solid var(--qreports-accent,#4f8bd6);outline-offset:-2px}
.matrix-format-areas,.matrix-selected-value,.matrix-settings{margin:12px 0;padding:10px;border:1px solid var(--qreports-grid,#ccd5e0);border-radius:9px;background:var(--qreports-surface,#fff)}
.matrix-format-areas>summary,.matrix-selected-value>summary,.matrix-settings>summary{margin:0;cursor:pointer;font-weight:700;color:var(--qreports-text,#263755)}
.matrix-format-areas[open]>summary,.matrix-selected-value[open]>summary,.matrix-settings[open]>summary{margin-bottom:10px}
.matrix-selected-value{scroll-margin-top:54px}
.matrix-selected-value-body{display:grid;gap:9px}
.matrix-selected-value-body>.matrix-value-basics,.matrix-selected-value-body>.cell-renderer-options,.matrix-selected-value-body>.column-bars,.matrix-selected-value-body>.matrix-conditional-options{margin:0;padding:10px;border:1px solid var(--qreports-grid,#ccd5e0);border-left:4px solid var(--qreports-accent,#4f6ee8);border-radius:8px;background:color-mix(in srgb,var(--qreports-surface,#fff) 94%,var(--qreports-accent,#4f6ee8))}
.matrix-selected-value-body>.cell-renderer-options{border-left-color:var(--qreports-color1,var(--qreports-accent,#4f6ee8))}
.matrix-selected-value-body>.column-bars{border-left-color:var(--qreports-color2,#6aa4e8)}
.matrix-selected-value-body>.matrix-conditional-options{border-left-color:var(--qreports-positive,#16844a)}
.matrix-value-basics h4{margin:0 0 9px;font-size:13px;color:var(--qreports-text,#263755)}
.matrix-selected-value-body>details>summary{padding:2px 0;cursor:pointer;font-size:13px;font-weight:700;color:var(--qreports-text,#263755)}
.matrix-selected-value-body>details[open]>summary{margin-bottom:9px;padding-bottom:8px;border-bottom:1px solid var(--qreports-grid,#dce3ec)}
.matrix-settings>p{margin:0 0 8px}.matrix-settings>section{padding:8px 0;border-top:1px solid var(--qreports-grid,#dce3ec)}.matrix-settings>section h4{margin:3px 0 8px}
.matrix-settings .matrix-active-filters{margin:10px 0 0}
.matrix-subtotal-options>section{padding:12px 0;border-top:1px solid var(--qreports-grid,#dce3ec)}
.matrix-subtotal-options>section:first-of-type{border-top:0}
.matrix-subtotal-options>section h4,.matrix-property-group h4{margin:0 0 8px}
.matrix-control-appearance{margin-top:10px;padding:8px;border:1px solid var(--qreports-grid,#dce3ec);border-radius:7px}
.matrix-control-appearance>summary{cursor:pointer;font-weight:600}
.matrix-control-appearance[open]>summary{margin-bottom:8px}
.matrix-hierarchy-controls.is-disabled,.matrix-property-group.is-disabled{opacity:.58}
.table-columns-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:18px 0 8px}.table-columns-heading h4{margin:0}.table-columns-actions{display:flex;align-items:center;gap:6px}.table-columns-heading button{padding:4px 7px;font-size:11px}.table-columns-heading [data-remove-all-columns]{color:var(--qreports-negative,#b42318)}.table-columns-heading button:disabled{color:var(--qreports-muted,#667085)}

/* Compact names in the report structure lists. */
.left-panel .page-item, .left-panel .source-item, .left-panel .page-name-editor { font-size:13px; }
.page-item.hidden-page { opacity:.72; border-style:dashed; }
.page-hidden-mark { display:inline-block; margin-right:3px; color:#667085; font-weight:700; }

.empty-state-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:8px; }

/* The header settings panel owns this checkbox; retain the legacy input for existing bindings. */
#tileProperties label:has(#tileHeader) { display:none!important; }

/* Selector colors must win over the general themed button rule. */
.tile-valueSelector .value-selector-buttons button:not(.active) {
  color:var(--selector-text,var(--qreports-text,#182230));
  background:transparent;
}

/* Visual filters are canvas views of existing page or linked tile filters. */
.tile-visualFilter>.tile-header{display:none}
.tile-visualFilter{min-width:30px;min-height:30px}
.tile-visualFilter>.tile-body{position:absolute;inset:0;width:auto;height:auto;min-height:0;padding:0;overflow:auto}
.visual-filter{display:grid;grid-template-columns:repeat(var(--visual-filter-columns),minmax(0,1fr));grid-auto-rows:minmax(30px,1fr);gap:var(--visual-filter-gap);padding:var(--visual-filter-padding);width:100%;height:100%;min-width:100%;min-height:100%;align-content:stretch;box-sizing:border-box}
.visual-filter-choice{appearance:none;min-width:0;border:1px solid var(--visual-filter-border);border-radius:var(--visual-filter-radius);background:var(--visual-filter-bg);color:var(--visual-filter-text);padding:9px 12px;display:flex;align-items:center;gap:10px;text-align:left;font:inherit;cursor:pointer;transition:background-color .12s,border-color .12s,transform .12s}
.visual-filter-choice:hover{border-color:var(--visual-filter-hover-border);background:var(--visual-filter-hover-bg);color:var(--visual-filter-hover-text);transform:translateY(-1px);filter:brightness(.985)}
.visual-filter-choice:focus-visible{outline:2px solid var(--visual-filter-selected-bg);outline-offset:2px}
.visual-filter-choice.selected{background:var(--visual-filter-selected-bg);border-color:var(--visual-filter-selected-border);color:var(--visual-filter-selected-text)}
.visual-filter-selection-fill .visual-filter-choice.selected{border-color:var(--visual-filter-border)}
.visual-filter-selection-border .visual-filter-choice{border-width:var(--visual-filter-selected-border-width);border-color:transparent}
.visual-filter-selection-border .visual-filter-choice.selected{background:var(--visual-filter-bg);border-color:var(--visual-filter-selected-border);color:var(--visual-filter-text)}
.visual-filter-selection-fillBorder .visual-filter-choice{border-width:var(--visual-filter-selected-border-width)}
.visual-filter-choice img{width:42px;height:42px;border-radius:max(2px,calc(var(--visual-filter-radius) * .65));object-fit:cover;flex:0 0 auto}
.visual-filter-copy{min-width:0;display:flex;flex:1;flex-direction:column;gap:2px}
.visual-filter-copy b,.visual-filter-copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:inherit}
.visual-filter-copy small{opacity:.82;font-size:.86em;font-weight:400}
.visual-filter-value{margin-left:auto;color:inherit;white-space:nowrap}
.visual-filter-metrics{min-width:0;display:flex;align-items:stretch;gap:10px;margin-left:auto}
.visual-filter-metric{min-width:0;margin-left:auto;display:flex;flex-direction:column;align-items:flex-end;gap:1px;color:inherit;white-space:nowrap}
.visual-filter-metric.visual-filter-align-left{align-items:flex-start}
.visual-filter-metric.visual-filter-align-center{align-items:center}
.visual-filter-metric.visual-filter-caption-left,.visual-filter-metric.visual-filter-caption-right{flex-direction:row;align-items:baseline;gap:8px}
.visual-filter-metric.visual-filter-caption-left.visual-filter-align-left,.visual-filter-metric.visual-filter-caption-right.visual-filter-align-left{justify-content:flex-start}
.visual-filter-metric.visual-filter-caption-left.visual-filter-align-center,.visual-filter-metric.visual-filter-caption-right.visual-filter-align-center{justify-content:center}
.visual-filter-metric.visual-filter-caption-left.visual-filter-align-right,.visual-filter-metric.visual-filter-caption-right.visual-filter-align-right{justify-content:flex-end}
.visual-filter-metric>strong{min-width:54px;color:inherit;font-size:var(--visual-filter-value-font-size,14px);font-weight:700}
.visual-filter-metric>span{font-size:.72em;font-weight:400;opacity:.78}
.visual-filter-metric .cell-visual{min-width:72px}
.visual-filter-choice.selected .visual-filter-metric .cell-visual>b,.visual-filter-choice.selected .visual-filter-metric .cell-renderer-icon b{color:inherit}
.visual-filter-buttons{display:grid;grid-template-columns:repeat(var(--visual-filter-columns),minmax(0,1fr));align-items:stretch;align-content:stretch}
.visual-filter-buttons .visual-filter-choice{width:100%;min-height:0;height:100%;justify-content:center;text-align:center}
.visual-filter-cards .visual-filter-choice{min-height:0;height:100%;overflow:hidden}
.visual-filter-multiCard .visual-filter-choice{min-height:0;height:100%;overflow:hidden;align-items:flex-start;flex-direction:column;padding:14px}
.visual-filter-multiCard .visual-filter-copy b{font-size:1.08em}
.visual-filter-multiCard .visual-filter-copy{width:100%;flex:none}
.visual-filter-multiCard .visual-filter-metrics{width:100%;display:grid;grid-template-columns:var(--visual-filter-metric-grid);grid-auto-flow:row dense;gap:8px 12px;margin:5px 0 0}
.visual-filter-multiCard .visual-filter-metric{width:100%;margin:0;justify-content:center;overflow:hidden}
.tile-visualFilter:has(.visual-filter-dropdown)>.tile-body{overflow:hidden}
.visual-filter-dropdown{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1fr);align-items:stretch;min-height:0!important;overflow:hidden}
.visual-filter-dropdown-control{display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-rows:minmax(24px,1fr) auto;align-items:center;gap:3px 8px;min-width:0;min-height:0;margin:0;color:var(--visual-filter-text)}
.visual-filter-dropdown-control.no-heading{grid-template-columns:minmax(0,1fr)}
.visual-filter-dropdown-heading{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:inherit}
.visual-filter-dropdown select{display:block;grid-column:2;grid-row:1;box-sizing:border-box;width:100%;height:100%;min-width:0;min-height:0;margin:0;padding:3px 30px 3px 10px;border:1px solid var(--visual-filter-border)!important;border-radius:var(--visual-filter-radius);background:var(--visual-filter-bg)!important;color:var(--visual-filter-text)!important;font:inherit;font-weight:600;text-align:left;text-align-last:left}
.visual-filter-dropdown-control.no-heading select{grid-column:1}
.visual-filter-dropdown-supporting{grid-column:2;grid-row:2;overflow:hidden;color:inherit;line-height:1.2;text-overflow:ellipsis;white-space:nowrap;opacity:.78}
.visual-filter-dropdown-control.no-heading .visual-filter-dropdown-supporting{grid-column:1}
.visual-filter-setup{width:100%;height:100%;border:1px dashed var(--qreports-grid,#9aa7b5);border-radius:8px;background:color-mix(in srgb,var(--qreports-surface,#fff) 92%,transparent);color:var(--qreports-text,#182230);cursor:pointer}
.visual-filter-designer{box-sizing:border-box;width:min(1180px,96vw);height:min(820px,94vh);min-width:min(680px,94vw);min-height:min(480px,88vh);max-width:calc(100vw - 16px);max-height:calc(100vh - 16px);overflow:hidden;resize:both;padding:0;border:1px solid #d9c9b8;border-radius:14px;background:#fffaf4;color:#3d342c;box-shadow:0 28px 70px #2d241d4a}
.visual-filter-designer::backdrop{background:#31271f66}
.visual-filter-designer>form{height:100%;display:grid;grid-template-rows:auto minmax(0,1fr) auto}
.visual-filter-designer>form>header,.visual-filter-designer>form>footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 20px;background:#f4e8d7;border-bottom:1px solid #dfcfbd}
.visual-filter-designer>form>header{cursor:move;touch-action:none;user-select:none}.visual-filter-designer.dialog-moving>form>header{cursor:grabbing}
.visual-filter-designer>form>footer{justify-content:flex-end;border:0;border-top:1px solid #dfcfbd}
.visual-filter-designer header h2,.visual-filter-designer header p{margin:0}.visual-filter-designer header p{margin-top:3px;color:#786857}
.visual-filter-designer-body{display:grid;grid-template-columns:minmax(300px,34%) minmax(0,1fr);min-height:0}
.visual-filter-designer-options{overflow:auto;padding:18px 22px;border-right:1px solid #dfcfbd}
.visual-filter-designer-options h3{margin:18px 0 8px}.visual-filter-designer-options h3:first-child{margin-top:0}
.visual-filter-designer-options label{display:grid;gap:5px;margin:9px 0}.visual-filter-designer-options label.check{display:flex;align-items:center;justify-content:flex-start;gap:8px;text-align:left}.visual-filter-designer-options label.check input[type="checkbox"]{flex:0 0 17px;width:17px!important;height:17px;min-height:0;margin:0;accent-color:var(--qreports-accent,#4f6ee8)}
.visual-filter-designer-options>label.check{box-sizing:border-box;width:100%;min-height:40px;margin:7px 0;padding:8px 10px;border:1px solid #e3d7c9;border-radius:8px;background:#fffdf9;color:#4e443b;font-size:13px;font-weight:650;line-height:1.25;cursor:pointer;transition:border-color .12s,background-color .12s,box-shadow .12s}.visual-filter-designer-options>label.check:hover{border-color:#c8b49f;background:#fffaf4}.visual-filter-designer-options>label.check:focus-within{border-color:var(--qreports-accent,#4f6ee8);box-shadow:0 0 0 2px color-mix(in srgb,var(--qreports-accent,#4f6ee8) 18%,transparent)}
.visual-filter-designer-options input,.visual-filter-designer-options select{width:100%;box-sizing:border-box}.visual-filter-designer-options :is(input[type="text"],input[type="search"],input:not([type]),textarea){background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);caret-color:var(--qreports-accent,#4f6ee8)}.visual-filter-designer-options :is(input,textarea)::placeholder{color:var(--qreports-muted,#667085);opacity:1}
.visual-filter-values-well{margin-bottom:8px}
.visual-filter-value-editor{grid-template-columns:auto minmax(120px,1fr) minmax(90px,.7fr) auto}
.visual-filter-designer-options .field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px}
.visual-filter-binding-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:8px}.visual-filter-binding-row label{margin:0}.visual-filter-binding-row button{width:auto;white-space:nowrap;margin-bottom:0}
.visual-filter-colors{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.visual-filter-colors input{height:38px}
.visual-filter-designer:not(.visual-filter-custom-colors) .visual-filter-colors{opacity:.45;pointer-events:none}
.visual-filter-designer.visual-filter-custom-colors .visual-filter-theme-roles,.visual-filter-designer.visual-filter-custom-colors .visual-filter-hover-theme-roles{opacity:.45;pointer-events:none}
.visual-filter-designer .visual-filter-not-applicable{opacity:.42}
.visual-filter-designer .visual-filter-not-applicable :is(input,select,button){cursor:not-allowed}
.visual-filter-designer .visual-filter-layout-note{margin:2px 0 8px;padding:7px 9px;border:1px solid #dfcfbd;border-radius:7px;background:#f7eee3;color:#776b60;font-size:12px}
.visual-filter-designer-preview{overflow:auto;padding:22px}.visual-filter-designer-preview>[data-vf-preview]{min-height:180px;border:1px solid #e3d7c9;border-radius:10px;background:#fff;padding:12px}.visual-filter-designer-preview .visual-filter{min-height:180px}.visual-filter-designer-preview [data-vf-preview-target]{cursor:pointer;border-radius:3px}.visual-filter-designer-preview [data-vf-preview-target]:hover{outline:2px solid color-mix(in srgb,var(--qreports-accent,#4f6ee8) 55%,transparent);outline-offset:2px}.visual-filter-designer-preview .visual-filter-choice{cursor:pointer}
@media(max-width:820px){.visual-filter-designer{min-width:0;resize:vertical}.visual-filter-designer-body{grid-template-columns:1fr}.visual-filter-designer-options{border-right:0;border-bottom:1px solid #dfcfbd}.visual-filter-colors{grid-template-columns:repeat(2,minmax(0,1fr))}.visual-filter-binding-row{grid-template-columns:1fr}}
.tile-valueSelector .selector-style-pills button:not(.active) {
  background:var(--selector-bg,var(--qreports-surface,#eef2f7));
}
.tile-valueSelector .value-selector-buttons button.active {
  color:var(--selector-active-text,var(--qreports-on-accent,#fff));
  background:var(--selector-active-bg,var(--qreports-accent,#4f6ee8));
}
.tile-valueSelector .selector-style-underline button.active {
  color:var(--selector-active-bg,var(--qreports-accent,#4f6ee8));
  background:transparent;
}

.tile-valueSelector.selector-has-background .tile-body { padding:6px; }

/* Keep each selector color and its theme control together at narrow panel widths. */
.selector-color-list { display:grid; gap:8px; margin:2px 0 12px; }
.selector-color-control { min-width:0; padding:8px 9px; border:1px solid var(--qreports-grid,#d7dee7); border-radius:8px; background:color-mix(in srgb,var(--qreports-surface,#fff) 35%,transparent); }
.selector-color-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:20px; margin-bottom:6px; color:var(--qreports-text,#182230); font-size:12px; }
.selector-color-heading .check { flex:none; margin:0; color:var(--qreports-muted,#667085); font-size:11px; white-space:nowrap; }
.selector-color-heading small { color:var(--qreports-muted,#667085); font-size:11px; white-space:nowrap; }
.selector-color-control>input[type=color] { display:block; width:100%; height:34px; margin:0; }

/* Non-modal, folder-backed AI collaboration panel. */
.canvas-ai-panel{position:fixed;inset:72px 12px auto auto;width:min(440px,calc(100vw - 28px));height:min(780px,calc(100vh - 114px));min-width:340px;min-height:480px;max-width:min(760px,calc(100vw - 20px));max-height:calc(100vh - 20px);margin:0;padding:0;overflow:hidden;resize:both;z-index:3600}
.canvas-ai-panel::backdrop{display:none}
.canvas-ai-panel form{display:flex;height:100%;min-height:0;box-sizing:border-box;flex-direction:column;gap:10px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;padding:14px}
.canvas-ai-panel form>header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding-bottom:9px;border-bottom:1px solid var(--qreports-grid);cursor:move;user-select:none}
.canvas-ai-panel form>header h2{margin:0;font-size:20px}.canvas-ai-panel form>header button{width:34px;height:34px;padding:0;font-size:23px;line-height:1}
.canvas-ai-heading{display:flex;align-items:center;gap:9px}.canvas-ai-mode-mark:empty{display:none}.canvas-ai-mode-mark.experience-mode-icon>img{width:38px;height:38px;border-radius:10px}
.canvas-ai-chat{display:flex;height:260px;min-height:120px;max-height:60vh;flex:0 0 auto;flex-direction:column;gap:9px;overflow:auto;resize:vertical;overscroll-behavior:contain;scrollbar-gutter:stable;padding:9px;border:1px solid var(--qreports-grid);border-radius:9px;background:color-mix(in srgb,var(--qreports-header) 22%,var(--qreports-surface))}
.canvas-ai-empty{margin:auto!important;padding:18px;text-align:center;color:color-mix(in srgb,var(--qreports-text) 65%,var(--qreports-surface))!important}
.canvas-ai-message{max-width:88%;padding:9px 11px;border:1px solid var(--qreports-grid);border-radius:10px;background:var(--qreports-surface);color:var(--qreports-text)}
.canvas-ai-message.user{align-self:flex-end;background:var(--qreports-accent);color:var(--qreports-on-accent,#fff);border-color:var(--qreports-accent)}
.canvas-ai-message.assistant{align-self:flex-start}.canvas-ai-message.live{border-style:dashed}
.canvas-ai-message b{display:block;margin-bottom:4px;font-size:11px;opacity:.78}.canvas-ai-message pre{margin:0;overflow:visible;white-space:pre-wrap;word-break:break-word;font:13px/1.45 'Segoe UI',sans-serif;color:inherit}
.canvas-ai-compose{display:grid;gap:7px}.canvas-ai-compose label{margin:0}.canvas-ai-compose textarea{min-height:72px;max-height:150px}.canvas-ai-compose>div{display:flex;align-items:center;flex-wrap:wrap;gap:7px}.canvas-ai-compose>div>.check{margin-right:auto;font-size:11px;font-weight:500}.canvas-ai-compose button{width:auto;white-space:nowrap}
.canvas-ai-attachments{display:flex!important;align-items:stretch!important;gap:7px!important;max-width:100%;overflow-x:auto;padding:4px 1px}.canvas-ai-attachments[hidden]{display:none!important}.canvas-ai-attachments figure{position:relative;display:grid;grid-template-columns:54px minmax(80px,1fr);align-items:center;flex:0 0 190px;gap:7px;margin:0;padding:5px 27px 5px 5px;border:1px solid var(--qreports-grid);border-radius:7px;background:var(--qreports-surface)}.canvas-ai-attachments img{width:54px;height:40px;object-fit:cover;border-radius:4px;background:#0001}.canvas-ai-file-icon{display:grid;width:54px;height:40px;place-items:center;border:1px solid color-mix(in srgb,var(--qreports-accent) 55%,var(--qreports-grid));border-radius:4px;background:color-mix(in srgb,var(--qreports-accent) 12%,var(--qreports-surface));color:var(--qreports-accent);font-size:10px;font-weight:800;letter-spacing:.04em}.canvas-ai-attachments figcaption{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px}.canvas-ai-attachments button{position:absolute;top:3px;right:3px;width:21px!important;height:21px;padding:0!important;border-radius:50%;font-size:15px!important;line-height:1}
.canvas-ai-panel .canvas-ai-status{min-height:20px;margin:0!important;font-size:12px}
.canvas-ai-activity{height:116px;min-height:64px;max-height:42vh;flex:0 0 auto;overflow:auto;resize:vertical;overscroll-behavior:contain;scrollbar-gutter:stable;padding:7px 9px;border:1px solid color-mix(in srgb,var(--qreports-accent) 42%,var(--qreports-grid));border-radius:8px;background:color-mix(in srgb,var(--qreports-accent) 7%,var(--qreports-surface));color:var(--qreports-text)}
.canvas-ai-activity[hidden]{display:none}.canvas-ai-activity header{display:flex;align-items:baseline;justify-content:space-between;gap:8px}.canvas-ai-activity header b{color:var(--qreports-accent);font-size:11px}.canvas-ai-activity header span{font-size:9px;opacity:.64}.canvas-ai-activity ol{display:grid;gap:3px;margin:5px 0 0;padding-left:19px}.canvas-ai-activity li{font-size:10px;line-height:1.35;word-break:break-word}.canvas-ai-activity li:last-child{color:var(--qreports-accent);font-weight:600}
.canvas-ai-panel .canvas-ai-guide{flex:0 0 auto;max-height:42%;overflow:auto}.canvas-ai-panel .canvas-ai-guide textarea{min-height:92px}
.canvas-ai-panel .canvas-ai-information{flex:0 0 auto;max-height:46%;overflow:auto;padding:8px 10px}.canvas-ai-information-body{display:grid;gap:8px;padding-top:8px}.canvas-ai-information .canvas-ai-mode-help{margin:0!important}.canvas-ai-workspace-info{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:8px;padding:6px 8px;border:1px solid var(--qreports-grid);border-radius:7px}.canvas-ai-workspace-info b{font-size:11px;text-transform:uppercase;opacity:.72}.canvas-ai-workspace-info code{overflow:hidden;color:var(--qreports-text);font:11px Consolas,monospace;text-overflow:ellipsis;white-space:nowrap}.canvas-ai-mode-steps{margin:0;padding-left:21px;font-size:12px;line-height:1.4}.canvas-ai-mode-steps li+li{margin-top:3px}.canvas-ai-prompt-block{margin:0!important;font-size:12px}.canvas-ai-information [data-ai-prompt]{min-height:72px;max-height:112px;padding:8px;font-size:11px;resize:vertical}.canvas-ai-information [data-ai="copyPrompt"]{justify-self:start;width:auto;margin:0;padding:5px 8px}.canvas-ai-information .canvas-ai-files{padding:7px 9px}.canvas-ai-information .canvas-ai-files p{font-size:11px;line-height:1.4}
.canvas-ai-data-notice{padding:8px 10px;border:1px solid var(--qreports-grid);border-left:4px solid var(--qreports-accent);border-radius:7px;background:color-mix(in srgb,var(--qreports-accent) 7%,var(--qreports-surface));font-size:11px;line-height:1.4}.canvas-ai-data-notice p{margin:4px 0 0!important;color:var(--qreports-text)!important}.canvas-ai-data-notice b{font-size:11px}
.canvas-ai-workflows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:9px 0}.canvas-ai-workflows section{padding:8px;border:1px solid var(--qreports-grid);border-radius:7px;background:color-mix(in srgb,var(--qreports-surface) 94%,var(--qreports-accent))}.canvas-ai-workflows h3{margin:0 0 5px;font-size:12px}.canvas-ai-workflows ol{margin:0;padding-left:18px;font-size:11px;line-height:1.45}
.canvas-ai-panel .canvas-ai-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;flex:0 0 auto}.canvas-ai-panel .canvas-ai-actions>div{display:flex;align-content:flex-start;flex-wrap:wrap;gap:5px;padding:7px;border:1px solid var(--qreports-grid);border-radius:8px}.canvas-ai-panel .canvas-ai-actions strong{flex:0 0 100%;font-size:10px;letter-spacing:.04em;text-transform:uppercase;opacity:.72}.canvas-ai-panel .canvas-ai-actions button{padding:6px 8px;font-size:11px}
.canvas-ai-panel[data-ai-mode="manual"]{bottom:auto;height:auto;max-height:calc(100vh - 92px)}.canvas-ai-panel[data-ai-mode="manual"] :is(.canvas-ai-chat,.canvas-ai-queue,.canvas-ai-compose){display:none!important}.canvas-ai-panel[data-ai-mode="manual"] .canvas-ai-information{max-height:none}.canvas-ai-panel[data-ai-mode="manual"] .canvas-ai-status{min-height:0}
.canvas-ai-context-menu{position:fixed;z-index:3900;min-width:180px;padding:5px;border:1px solid var(--qreports-grid);border-radius:8px;background:var(--qreports-panel);box-shadow:0 12px 34px #0005}.canvas-ai-context-menu[hidden]{display:none}.canvas-ai-context-menu button{width:100%;padding:8px 10px;text-align:left}
.canvas-ai-queue li{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:8px}.canvas-ai-queue-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.canvas-ai-queue-edit{width:auto!important;padding:4px 7px!important;font-size:10px!important}
.canvas-ai-queue-editor{width:min(560px,calc(100vw - 28px));max-height:calc(100vh - 40px);padding:0;border:1px solid var(--qreports-grid,#cdd5df);border-radius:10px;background-color:var(--qreports-surface,#fff)!important;color:var(--qreports-text,#182230);color-scheme:var(--qreports-color-scheme,light);box-shadow:0 24px 70px #0008}.canvas-ai-queue-editor::backdrop{background:#0009;backdrop-filter:blur(2px)}.canvas-ai-queue-editor form{display:grid;gap:12px;padding:15px;background-color:var(--qreports-surface,#fff)}.canvas-ai-queue-editor header{display:flex;justify-content:space-between;gap:12px}.canvas-ai-queue-editor h3,.canvas-ai-queue-editor header p{margin:0}.canvas-ai-queue-editor header p{margin-top:3px;font-size:11px;opacity:.72}.canvas-ai-queue-editor header button{width:32px;height:32px;padding:0;font-size:20px}.canvas-ai-queue-editor textarea{min-height:135px;resize:vertical}.canvas-ai-queue-editor [data-queue-edit-attachments]>div{display:flex;gap:8px;overflow-x:auto;margin-top:7px}.canvas-ai-queue-editor figure{flex:0 0 150px;margin:0}.canvas-ai-queue-editor figure :is(img,.canvas-ai-file-icon){display:grid;width:150px;height:96px;place-items:center;object-fit:cover;border:1px solid var(--qreports-grid);border-radius:6px;background:color-mix(in srgb,var(--qreports-grid) 25%,transparent)}.canvas-ai-queue-editor figcaption{overflow:hidden;margin-top:4px;font-size:10px;text-overflow:ellipsis;white-space:nowrap}.canvas-ai-queue-editor [data-queue-edit-error]{min-height:16px;margin:0;color:var(--qreports-negative,#c43d4b);font-size:11px}.canvas-ai-queue-editor footer{display:flex;justify-content:flex-end;gap:8px}.canvas-ai-queue-editor footer button{width:auto}
@media(max-width:520px){.canvas-ai-workflows,.canvas-ai-panel .canvas-ai-actions{grid-template-columns:1fr}}
@media(max-width:720px){.canvas-ai-panel{inset:62px 6px 8px 6px;width:auto;min-width:0;resize:none}}
.multi-card-designer .visual-designer-layout{grid-template-columns:minmax(220px,25%) 6px minmax(360px,1fr) 6px minmax(300px,32%)}
.multi-card-designer .designer-preview [data-designer-preview]{position:relative;z-index:0;height:auto;min-height:0;padding:16px;background:var(--qreports-canvas,#eef2f7);overflow:auto}
.multi-card-designer .designer-preview{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)}
.multi-card-designer .designer-preview .designer-preview-nav{position:relative;z-index:100;flex-wrap:nowrap;min-height:34px;padding:0 14px 7px;margin:0;overflow-x:auto;background:var(--qreports-panel,var(--qreports-surface,#fff));scrollbar-width:thin}
.multi-card-designer .designer-preview .multi-card{min-height:auto}
.multi-card-values-well{display:flex;flex-direction:column;gap:8px;min-height:70px;padding:8px;border:1px dashed var(--qreports-grid,#cbd5e1);border-radius:8px}
.multi-card-values-well.drag-over{border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 8%,transparent)}
.multi-card-value-row{display:grid;grid-template-columns:auto minmax(105px,1fr) minmax(86px,.75fr) auto;gap:6px;align-items:center;padding:7px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:7px;background:var(--qreports-surface,#fff)}
.multi-card-value-row input:not([type="checkbox"]),.multi-card-value-row select{min-width:0;width:100%}.multi-card-value-row input[type="checkbox"]{flex:none;width:auto;margin:0}.multi-card-value-row label.check{justify-content:flex-start;text-align:left}
.multi-card-value-row .multi-card-value-caption{grid-column:2/4}
.multi-card-value-row .multi-card-value-format{grid-column:2}
.multi-card-value-row .multi-card-value-align{grid-column:3}
.multi-card-value-row>.multi-card-value-more{grid-column:2/4;margin-top:2px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:7px}.multi-card-value-row>.multi-card-value-more>summary{padding:7px 9px;font-size:11px;font-weight:700;cursor:pointer}.multi-card-value-more-body{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;padding:0 7px 7px}.multi-card-value-more-body>.multi-card-value-format{grid-column:1}.multi-card-value-more-body>.multi-card-value-align{grid-column:2}.multi-card-value-more-body>.multi-card-value-placement,.multi-card-value-more-body>.multi-card-cell-display,.multi-card-value-more-body>.column-bars,.multi-card-value-more-body>.matrix-conditional-options{grid-column:1/-1;margin:2px 0 0;padding:7px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:7px}.multi-card-value-more-body>.multi-card-value-placement>summary,.multi-card-value-more-body>.multi-card-cell-display>summary,.multi-card-value-more-body>.column-bars>summary,.multi-card-value-more-body>.matrix-conditional-options>summary{font-size:11px}
.multi-card-value-placement{grid-column:2/4;margin:2px 0 0;padding:7px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:7px}.multi-card-value-placement>summary{cursor:pointer;font-size:11px;font-weight:700}.multi-card-value-placement>.property-grid{margin-top:7px}.multi-card-value-placement small{display:block;margin-top:7px;color:var(--qreports-muted,#667085);font-size:11px;line-height:1.35}
.visual-filter-value-editor .multi-card-value-more-body>.multi-card-value-custom-format{grid-column:1/-1}.visual-filter-value-editor .multi-card-value-more-body>.multi-card-value-custom-format small{color:var(--qreports-muted,#667085);font-size:10px}.visual-filter-value-editor .multi-card-value-more-body>.multi-card-value-font-size{grid-column:2}.visual-filter-value-editor .multi-card-value-more-body>.multi-card-value-align{grid-column:1}.visual-filter-value-editor .multi-card-value-more-body>.multi-card-value-caption-position{grid-column:2}
.multi-card-cell-display{grid-column:2/4;margin:2px 0 0;padding:7px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:7px}.multi-card-cell-display>summary{cursor:pointer;font-size:11px;font-weight:700}.multi-card-cell-display>label,.multi-card-cell-display>.property-grid{margin-top:7px}.multi-card-cell-display small{display:block;margin-top:7px;color:var(--qreports-muted,#667085)}
.multi-card-value-row>.column-bars,.multi-card-value-row>.matrix-conditional-options{grid-column:2/4;margin:2px 0 0;padding:7px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:7px}.multi-card-value-row>.column-bars>summary,.multi-card-value-row>.matrix-conditional-options>summary{font-size:11px}
.matrix-conditional-options .two-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 8px}.matrix-conditional-options label.check{display:flex;justify-content:flex-start;align-items:center;gap:7px;width:100%;text-align:left}.matrix-conditional-options label.check input{flex:none;width:auto;margin:0}.matrix-conditional-options .conditional-checks{grid-template-columns:1fr}.multi-card-band-options{margin:10px 0 0;padding:8px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:7px}.multi-card-band-options legend{padding:0 5px;font-size:11px;font-weight:700}.multi-card-band-options small{display:block;margin-top:4px;color:var(--qreports-muted,#667085);font-size:10px;line-height:1.35}
.multi-card-token-menu{position:fixed;z-index:4300;display:grid;grid-template-rows:auto minmax(0,1fr);width:min(520px,calc(100vw - 24px));height:min(390px,calc(100vh - 24px));min-width:min(320px,calc(100vw - 24px));min-height:220px;max-width:calc(100vw - 16px);max-height:calc(100vh - 16px);overflow:hidden;resize:both;border:1px solid var(--qreports-grid,#d9dee7);border-radius:10px;background:var(--qreports-surface,#fff);box-shadow:0 16px 40px rgba(31,41,55,.24);color:var(--qreports-text,#182230);color-scheme:var(--qreports-color-scheme,light)}.multi-card-token-menu[hidden]{display:none}.designer-token-lookup-head{display:flex;align-items:center;gap:6px;padding:9px;border-bottom:1px solid var(--qreports-grid,#d9dee7);background:color-mix(in srgb,var(--qreports-header,#eef2f7) 55%,var(--qreports-surface,#fff))}.designer-token-lookup-head input{min-width:0;width:100%;box-sizing:border-box;background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);caret-color:var(--qreports-accent,#4f6ee8)}.designer-token-lookup-head input::placeholder{color:var(--qreports-muted,#667085);opacity:1}.designer-token-lookup-head button{flex:none;width:30px;height:30px;padding:0;text-align:center;font-size:18px}.designer-token-lookup-results{display:grid;grid-template-columns:repeat(2,minmax(130px,1fr));align-content:start;gap:8px;min-height:0;padding:9px;overflow:auto}.multi-card-token-menu section{display:flex;flex-direction:column;gap:3px;min-width:0}.multi-card-token-menu section strong{padding:4px 7px;font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--qreports-muted,#667085)}.multi-card-token-menu button{width:100%;padding:6px 8px;overflow:hidden;border:0;border-radius:5px;background:transparent;color:inherit;text-align:left;text-overflow:ellipsis;white-space:nowrap}.multi-card-token-menu button:hover,.multi-card-token-menu button:focus{background:var(--qreports-selection,#eef2ff);outline:none}.designer-token-empty{grid-column:1/-1;margin:auto;padding:22px;color:var(--qreports-muted,#667085);text-align:center;font-size:12px}
.designer-search-select{position:relative;display:block;width:100%;min-width:0}.designer-search-select-native{position:absolute!important;width:1px!important;height:1px!important;margin:0!important;padding:0!important;overflow:hidden!important;opacity:0!important;pointer-events:none!important}.designer-search-select-trigger{display:flex;width:100%;min-width:0;align-items:center;justify-content:space-between;overflow:hidden;text-align:left;text-overflow:ellipsis;white-space:nowrap}.designer-search-select-trigger::after{content:"⌄";flex:none;margin-left:8px;color:var(--qreports-muted,#667085);font-size:14px}.designer-search-select-menu{position:fixed;z-index:4700;display:grid;grid-template-rows:auto minmax(0,1fr) auto;overflow:hidden;border:1px solid var(--qreports-grid,#d9dee7);border-radius:9px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);color-scheme:var(--qreports-color-scheme,light);box-shadow:0 18px 45px rgba(31,41,55,.24)}.designer-search-select-search{display:grid;grid-template-columns:minmax(0,1fr) 32px;gap:6px;padding:8px;border-bottom:1px solid var(--qreports-grid,#d9dee7);background:color-mix(in srgb,var(--qreports-header,#eef2f7) 55%,var(--qreports-surface,#fff))}.designer-search-select-search input{box-sizing:border-box;width:100%;min-width:0;background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);caret-color:var(--qreports-accent,#4f6ee8)}.designer-search-select-search input::placeholder{color:var(--qreports-muted,#667085);opacity:1}.designer-search-select-search button{width:32px;min-width:32px;padding:0;font-size:18px}.designer-search-select-options{min-height:0;padding:5px;overflow:auto}.designer-search-select-options section{display:grid;gap:2px}.designer-search-select-options section+section{margin-top:5px;padding-top:5px;border-top:1px solid color-mix(in srgb,var(--qreports-grid,#d9dee7) 65%,transparent)}.designer-search-select-options strong{padding:5px 8px;color:var(--qreports-muted,#667085);font-size:10px;letter-spacing:.06em;text-transform:uppercase}.designer-search-select-options button{width:100%;padding:7px 9px;overflow:hidden;border:0;border-radius:5px;background:transparent;color:inherit;text-align:left;text-overflow:ellipsis;white-space:nowrap}.designer-search-select-options button:hover,.designer-search-select-options button:focus-visible{background:var(--qreports-selection,#eef2ff);outline:none}.designer-search-select-options button[aria-selected="true"]{background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 14%,var(--qreports-surface,#fff));font-weight:700}.designer-search-select-empty{margin:0;padding:14px;color:var(--qreports-muted,#667085);font-size:11px;text-align:center}
.designer-search-select-options :is(section,button)[hidden],.designer-search-select-empty[hidden]{display:none!important}
.designer-preview-heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:7px;margin:0 0 10px}.designer-preview-heading h3{margin:0}.designer-preview-nav{display:flex;align-items:center;flex-wrap:wrap;gap:4px;margin:0 0 8px}.designer-preview-heading .designer-preview-nav{flex:1 1 180px;justify-content:flex-start;flex-wrap:nowrap;min-width:0;margin:0;overflow-x:auto;scrollbar-width:thin}.designer-preview-nav[hidden]{display:none}.designer-preview-nav button{width:auto;min-height:26px;padding:4px 8px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:999px;background:color-mix(in srgb,var(--qreports-surface,#fff) 92%,var(--qreports-accent,#4f6ee8));color:var(--qreports-text,#182230);font-size:10px;font-weight:650;line-height:1.15;white-space:nowrap}.designer-preview-nav button:hover,.designer-preview-nav button:focus-visible{border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 12%,var(--qreports-surface,#fff));outline:none}.designer-preview-focus{outline:2px solid var(--qreports-accent,#4f6ee8)!important;outline-offset:3px;transition:outline-color .2s}
.multi-card-value-row .designer-drag-handle{cursor:grab;color:var(--qreports-muted,#667085)}
.multi-card-value-row .multi-card-value-actions{display:flex;flex-direction:column;gap:3px;grid-row:1/4;grid-column:4}
.multi-card-value-row .multi-card-value-actions button{padding:2px 7px;min-height:25px}
.multi-card-designer .designer-fields button[draggable]{width:100%;display:flex;gap:7px;align-items:center;margin:0 0 6px;text-align:left}
.multi-card-designer .designer-fields h4{margin:14px 0 7px}
.multi-card-column-widths{display:grid;gap:6px;margin:12px 0 2px;padding:9px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:8px;background:color-mix(in srgb,var(--qreports-surface,#fff) 94%,var(--qreports-header,#eef2f7))}
.multi-card-column-widths>strong{font-size:12px}.multi-card-column-widths>small{color:var(--qreports-muted,#667085);font-size:11px;line-height:1.35}
.multi-card-column-width-row{display:grid;grid-template-columns:62px minmax(105px,1fr) minmax(70px,.75fr) 24px;align-items:center;gap:6px;font-size:11px}
.multi-card-column-width-row select,.multi-card-column-width-row input{min-width:0;width:100%}.multi-card-column-width-row input:disabled{opacity:.55}.multi-card-column-width-row span:last-child{color:var(--qreports-muted,#667085)}
.multi-card-typography-list{display:grid;gap:8px;margin-top:12px}
.multi-card-typography{margin:0;padding:9px;border:1px solid var(--qreports-grid,#d9dee7);border-radius:8px}
.multi-card-typography legend{padding:0 5px;font-weight:700}
.multi-card-typography .property-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
.multi-card-typography label.check{align-self:end;min-height:34px}
.multi-card-designer [data-designer-preview] .multi-card-item{cursor:pointer}.multi-card-designer [data-designer-preview] [data-mc-preview-target]{cursor:pointer;border-radius:3px;transition:outline-color .15s,background-color .15s}.multi-card-designer [data-designer-preview] [data-mc-preview-target]:hover{outline:2px solid color-mix(in srgb,var(--qreports-accent,#4f6ee8) 55%,transparent);outline-offset:2px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 8%,transparent)}.multi-card-preview-focus{outline:2px solid var(--qreports-accent,#4f6ee8)!important;outline-offset:3px;transition:outline-color .2s}.multi-card-designer .designer-options :is(input[type="text"],input[type="search"],input:not([type]),textarea),.svg-designer-options :is(input[type="text"],input[type="search"],input:not([type]),textarea){background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);caret-color:var(--qreports-accent,#4f6ee8)}.multi-card-designer .designer-options :is(input,textarea)::placeholder,.svg-designer-options :is(input,textarea)::placeholder{color:var(--qreports-muted,#667085);opacity:1}
@media(max-width:1050px){.multi-card-designer .visual-designer-layout{grid-template-columns:1fr;overflow:auto}.multi-card-designer .designer-splitter{display:none}.multi-card-designer .designer-preview,.multi-card-designer .designer-options,.multi-card-designer .designer-fields{min-height:250px}}
