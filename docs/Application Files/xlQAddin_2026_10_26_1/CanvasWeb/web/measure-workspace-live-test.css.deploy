.matrix-test-actions{display:grid;gap:7px;justify-items:end;align-self:end}
.matrix-test-actions label{display:flex;align-items:center;gap:7px;white-space:nowrap;font-size:13px;cursor:pointer}
.matrix-test-actions input{width:auto;margin:0;accent-color:#657fee}
.matrix-test-actions button{white-space:nowrap}
