.canvas-filter-row { display:grid; grid-template-columns: 32px 1fr 1fr; gap: 7px; padding: 8px 0; border-bottom: 1px solid #e1e6ef; }
.canvas-filter-row.tile-filter-row { grid-template-columns:minmax(0,1fr) minmax(0,1fr); padding-top:0; }
.canvas-filter-row>.filter-row-heading,.canvas-filter-row>.filter-row-toolbar { grid-column:1 / -1; }
.filter-row-toolbar { display:flex; align-items:center; gap:5px; min-width:0; }
.canvas-filter-row .canvas-filter-lock { display:flex; align-items:center; justify-content:flex-start; gap:6px; margin:0 0 0 auto; font-size:11px; white-space:nowrap; }
.canvas-filter-row>.canvas-filter-lock { grid-column:2 / -1; }
.canvas-filter-row .canvas-filter-lock input { width:auto; margin:0; }
.filter-row-heading { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:5px 8px; min-width:0; min-height:0; margin:0 0 3px; padding:7px; border:1px solid var(--qreports-grid,#dde3e9); border-radius:8px; background:color-mix(in srgb,var(--qreports-header,#eef3f9) 44%,var(--qreports-surface,#fff)); color:var(--qreports-text,#344054); }
.filter-row-title { display:grid; gap:1px; min-width:0; }
.filter-row-title b,.filter-row-title small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.filter-row-title b { font-size:12px; }
.filter-row-title small { color:var(--qreports-muted,#667085); font-size:9px; }
.filter-row-heading>.canvas-filter-lock { align-self:start; margin:0; padding:2px 3px; }
.filter-row-heading>.filter-row-actions { display:grid; grid-column:1 / -1; grid-template-columns:minmax(0,1fr) minmax(0,1fr) 30px; gap:5px; min-width:0; }
.filter-row-heading>.filter-row-actions button { position:static; min-width:0; width:100%; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.filter-row-heading>.filter-row-actions .remove-filter { width:30px; padding-inline:0!important; font-size:15px!important; }
.canvas-filter-advanced { grid-column:1 / -1; display:grid; grid-template-columns:minmax(96px,.8fr) minmax(0,1.2fr); align-items:end; gap:7px; min-width:0; }
.canvas-filter-advanced>select,.canvas-filter-value,.canvas-filter-value>input { min-width:0; width:100%; margin:0; box-sizing:border-box; }
.canvas-filter-value { position:relative; display:block; }
.canvas-filter-value>input { padding-right:30px!important; }
.filter-inline-help { position:absolute; top:50%; right:6px; display:grid; place-items:center; width:17px; height:17px; border:1px solid var(--qreports-grid,#cbd5e1); border-radius:50%; background:var(--qreports-surface,#fff); color:var(--qreports-muted,#667085); font-size:10px; font-weight:800; line-height:1; cursor:help; transform:translateY(-50%); }
.filter-inline-help:focus-visible { outline:2px solid var(--qreports-accent,#4f6ee8); outline-offset:1px; }
.filter-level{border-bottom:1px solid var(--qreports-grid,#d7e1ed);padding:8px 0 10px;margin:0}
.filter-level>summary{display:flex;align-items:center;gap:7px;cursor:pointer;font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.filter-level-help{margin-left:auto;cursor:help;font-size:14px;font-weight:400;letter-spacing:0;text-transform:none}
.filter-level>[data-action^="add"]{font-size:12px;padding:6px 9px;margin-top:8px}
.filter-level .filter-context{font-size:12px;padding:7px;margin-top:7px}
.canvas-filter-row > input, .canvas-filter-row > button:not(.remove-filter), .canvas-filter-row > select:nth-of-type(n+3) { grid-column: 2 / -1; }
.filter-values-dialog { width: min(520px, 86vw); max-height: 78vh; border: 0; border-radius: 15px; padding: 20px; box-shadow: 0 20px 70px #17213c55; color: #17213c; }
.filter-values-dialog::backdrop { background: #17213c77; }
.filter-values-dialog h2 { margin: 0 0 14px; }
.filter-values-dialog [data-value-search] { width: 100%; padding: 9px; border: 1px solid #cbd5e5; border-radius: 8px; }
.filter-value-list { max-height: 350px; overflow: auto; margin: 10px 0; border: 1px solid #dbe2ed; border-radius: 8px; padding: 7px; }
.filter-value-list label { display: block; padding: 4px 6px; }
.filter-value-list [hidden] { display: none !important; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; }
.source-relationships-dialog { box-sizing:border-box; width:min(1180px,96vw); height:min(780px,92vh); min-width:min(720px,96vw); min-height:min(520px,92vh); max-width:calc(100vw - 16px); max-height:calc(100vh - 16px); overflow:hidden; resize:both; padding:18px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#17213c); }
.source-relationships-dialog>form { display:grid; grid-template-rows:auto minmax(0,1fr) auto auto; gap:12px; height:100%; min-height:0; }
.source-relationships-dialog header,.source-relationship-head,.source-relationship-footer { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.source-relationships-dialog>form>header { align-items:flex-start; cursor:move; }
.source-relationships-dialog header h2 { margin:0 0 5px; }
.source-relationships-dialog header p { max-width:850px; margin:0; color:var(--qreports-muted,#667085); line-height:1.4; }
.source-relationships-dialog>form>header>button { flex:none; width:38px; height:38px; padding:0; font-size:20px; }
.source-model-workspace { display:grid; grid-template-columns:minmax(0,1fr) minmax(310px,360px); gap:12px; min-height:0; }
.source-model-stage,.source-relationship-editor { min-width:0; min-height:0; border:1px solid var(--qreports-grid,#dbe2ed); border-radius:12px; background:color-mix(in srgb,var(--qreports-header,#eef3f9) 24%,var(--qreports-surface,#fff)); overflow:hidden; }
.source-model-stage { display:grid; grid-template-rows:auto minmax(0,1fr); }
.source-model-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:9px 12px; border-bottom:1px solid var(--qreports-grid,#dbe2ed); background:var(--qreports-header,#eef3f9); color:var(--qreports-text,#17213c); font-size:12px; }
.source-model-toolbar small { color:var(--qreports-muted,#667085); }
.source-model-canvas { position:relative; min-height:0; overflow:auto; padding:26px; background-color:color-mix(in srgb,var(--qreports-surface,#fff) 92%,var(--qreports-grid,#dbe2ed)); background-image:radial-gradient(circle,var(--qreports-grid,#dbe2ed) 1px,transparent 1px); background-size:18px 18px; }
.source-model-cards { position:relative; z-index:2; min-width:650px; min-height:360px; pointer-events:none; }
.source-model-card { position:absolute; display:grid; grid-template-rows:auto minmax(0,1fr); min-width:190px; min-height:110px; max-width:900px; max-height:700px; overflow:hidden; resize:both; border:1px solid var(--qreports-grid,#cbd5e1); border-radius:10px; background:var(--qreports-surface,#fff); box-shadow:0 5px 18px color-mix(in srgb,var(--qreports-text,#17213c) 12%,transparent); transition:border-color .15s,box-shadow .15s,transform .15s; pointer-events:auto; }
.source-model-card.selected { border-color:var(--qreports-accent,var(--theme-accent,#4f6ee8)); box-shadow:0 0 0 2px color-mix(in srgb,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 24%,transparent),0 7px 22px color-mix(in srgb,var(--qreports-text,#17213c) 14%,transparent); }
.source-model-card.moving { z-index:4; transition:none; box-shadow:0 10px 28px color-mix(in srgb,var(--qreports-text,#17213c) 22%,transparent); }
.source-model-card.source-link-drop-target,.source-model-column.source-link-drop-target { outline:3px solid color-mix(in srgb,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 42%,transparent); outline-offset:-3px; }
.source-model-card>header { display:grid; grid-template-columns:minmax(0,1fr) auto auto auto; align-items:center; gap:7px; padding:10px 10px 9px 12px; border-bottom:1px solid var(--qreports-grid,#dbe2ed); background:var(--qreports-header,#eef3f9); cursor:move; }
.source-model-card>header div { min-width:0; display:grid; gap:2px; }
.source-model-card>header strong,.source-model-card>header small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.source-model-card>header small { color:var(--qreports-muted,#667085); font-size:10px; }
.source-model-link-count { min-width:22px; padding:2px 6px; border-radius:999px; background:color-mix(in srgb,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 13%,transparent); color:var(--qreports-accent,var(--theme-accent,#4f6ee8)); text-align:center; font-size:10px; font-weight:800; }
.source-model-linked-toggle { width:auto!important; min-width:0; height:24px!important; margin:0; padding:2px 7px!important; border:1px solid var(--qreports-grid,#cbd5e1); border-radius:999px; background:var(--qreports-surface,#fff); color:var(--qreports-muted,#667085); font-size:9px!important; font-weight:700; line-height:1; cursor:pointer; }
.source-model-linked-toggle[aria-pressed="true"] { border-color:var(--qreports-accent,var(--theme-accent,#4f6ee8)); background:color-mix(in srgb,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 14%,var(--qreports-surface,#fff)); color:var(--qreports-accent,var(--theme-accent,#4f6ee8)); }
.source-model-columns { min-height:0; overflow:auto; padding:5px 0; }
.source-model-column { display:grid; grid-template-columns:minmax(0,1fr) auto 22px; align-items:center; gap:6px; min-height:30px; padding:3px 7px 3px 12px; color:var(--qreports-text,#17213c); font-size:11px; }
.source-model-column:hover { background:color-mix(in srgb,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 8%,transparent); }
.source-model-column.relationship-column { font-weight:650; }
.source-model-column.selected-relationship-column { background:color-mix(in srgb,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 14%,transparent); box-shadow:inset 3px 0 0 var(--qreports-accent,var(--theme-accent,#4f6ee8)); color:var(--qreports-accent,var(--theme-accent,#4f6ee8)); }
.source-model-column.selected-relationship-column:hover { background:color-mix(in srgb,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 20%,transparent); }
.source-model-column>span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.source-model-column>small { color:var(--qreports-muted,#667085); font-size:9px; }
.source-model-port { display:grid; place-items:center; width:20px!important; height:20px!important; min-width:20px; margin:0; padding:0!important; border:1px solid var(--qreports-accent,var(--theme-accent,#4f6ee8)); border-radius:50%; background:var(--qreports-surface,#fff); color:var(--qreports-accent,var(--theme-accent,#4f6ee8)); font-size:9px!important; line-height:1; cursor:grab; }
.source-model-port:active { cursor:grabbing; }
.source-model-source-port { width:24px!important; height:24px!important; }
.source-model-no-columns { margin:0; padding:18px 12px; color:var(--qreports-muted,#667085); font-size:11px; text-align:center; }
.source-model-links { position:absolute; z-index:1; inset:0; overflow:visible; pointer-events:none; }
.source-model-link-line { fill:none; stroke:var(--qreports-muted,#667085); stroke-width:2; }
.source-model-link.lookup .source-model-link-line { stroke-dasharray:6 4; }
.source-model-link.selected .source-model-link-line { stroke:var(--qreports-accent,var(--theme-accent,#4f6ee8)); stroke-width:3; }
.source-model-arrow path { fill:var(--qreports-muted,#667085); }
.source-model-arrow.selected path { fill:var(--qreports-accent,var(--theme-accent,#4f6ee8)); }
.source-model-link-hit { fill:none; stroke:transparent; stroke-width:18; pointer-events:stroke; cursor:pointer; }
.source-model-link text { pointer-events:auto; cursor:pointer; paint-order:stroke; stroke:var(--qreports-surface,#fff); stroke-width:5px; stroke-linejoin:round; fill:var(--qreports-muted,#667085); font-size:10px; font-weight:800; }
.source-model-link.selected text { fill:var(--qreports-accent,var(--theme-accent,#4f6ee8)); }
.source-relationship-editor { overflow:auto; padding:13px; }
.source-relationship-editor>section { display:grid; gap:10px; }
.source-relationship-editor.empty { display:grid; place-items:center; padding:26px; text-align:center; color:var(--qreports-muted,#667085); }
.source-relationship-editor.empty p { max-width:260px; margin:6px 0 0; line-height:1.45; }
.source-relationship-head>div { display:grid; gap:3px; min-width:0; }
.source-relationship-head>div small { color:var(--qreports-muted,#667085); font-size:10px; text-transform:uppercase; letter-spacing:.06em; }
.source-relationship-head>div strong { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.source-relationship-head button,[data-add-relationship-key] { width:auto; padding:5px 8px; font-size:11px; }
.source-relationship-sources { display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); align-items:end; gap:10px; }
.source-relationship-sources label { margin:0; }
.source-relationship-sources>span { padding-bottom:10px; font-weight:800; }
.source-relationship-direction { margin:0; color:var(--qreports-muted,#667085); font-size:12px; line-height:1.4; }
.source-relationship-keys { display:grid; gap:7px; }
.source-relationship-keys>div { display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) 34px; align-items:center; gap:8px; }
.source-relationship-keys select { margin:0; }
.source-relationship-keys button { width:34px; height:34px; padding:0; }
.source-relationship-footer { padding-top:4px; }
.source-relationship-footer>span { flex:1; }
.source-relationship-error { min-height:18px; margin:0; color:var(--qreports-negative,#b42318); font-size:12px; }
.source-relationship-cardinality { display:flex; align-items:flex-start; gap:9px; padding:8px 10px; border-radius:7px; background:color-mix(in srgb,var(--qreports-positive,#16865c) 10%,transparent); color:var(--qreports-text,#1f2937); font-size:12px; line-height:1.35; }
.source-relationship-cardinality strong { flex:none; }
.source-relationship-cardinality[data-quality="warning"],.source-relationship-cardinality[data-quality="coverage-warning"] { background:color-mix(in srgb,var(--qreports-negative,#b42318) 12%,transparent); color:var(--qreports-negative,#b42318); }
.source-relationship-cardinality[data-quality="unknown"] { background:color-mix(in srgb,var(--qreports-muted,#667085) 12%,transparent); color:var(--qreports-muted,#667085); }
@media(max-width:850px){.source-relationships-dialog{width:calc(100vw - 16px);height:min(900px,94vh);min-width:0;resize:vertical}.source-model-workspace{grid-template-columns:1fr;grid-template-rows:minmax(310px,1fr) minmax(250px,.8fr)}.source-model-cards{min-width:520px}.source-relationship-sources{grid-template-columns:1fr}.source-relationship-sources>span{display:none}.source-relationship-keys>div{grid-template-columns:1fr 28px 1fr 34px}}
.canvas-filter-buttons,.canvas-toggle-row { grid-column: 1 / -1; display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
.canvas-filter-buttons button { width:auto; min-width:38px; padding:7px 10px; }
.canvas-filter-buttons button.active { background:var(--theme-accent,#4f6ee8); color:var(--theme-accent-text,#fff); border-color:var(--theme-accent,#4f6ee8); }
.canvas-filter-row select[multiple] option:checked { background:var(--theme-accent,#4f6ee8) linear-gradient(0deg,var(--theme-accent,#4f6ee8),var(--theme-accent,#4f6ee8)); color:var(--theme-accent-text,#fff); }
.canvas-search-multiple { grid-column:1 / -1; display:grid; gap:6px; }
.canvas-search-multiple>input { width:100%; margin:0; padding:8px; border:1px solid var(--theme-control-border,#cbd5e1); border-radius:7px; background:var(--theme-control-bg,#fff); color:inherit; }
.canvas-filter-checklist { display:grid; gap:3px; max-height:180px; overflow:auto; padding:5px; border:1px solid var(--theme-control-border,#cbd5e1); border-radius:7px; background:var(--theme-control-bg,#fff); }
.canvas-filter-checklist label { display:flex; align-items:center; gap:7px; margin:0; padding:4px; }
.canvas-filter-pair { grid-column:1 / -1; display:grid; grid-template-columns:1fr 1fr; gap:7px; }
.canvas-filter-pair label { min-width:0; }
.canvas-filter-row .date-range-display { grid-column:1 / -1; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
.canvas-filter-row .date-picker-actions { grid-column:1 / -1; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
.canvas-filter-row .date-picker-selected,.canvas-filter-row .date-picker-value { grid-column:1 / -1; width:max-content; max-width:100%; background:var(--theme-control-bg,var(--qreports-surface,#fff)); color:var(--theme-text,var(--qreports-text,#34425e)); border-color:var(--theme-control-border,var(--qreports-grid,#cbd5e1)); }
.canvas-filter-row .date-picker-clear { width:max-content; background:transparent; color:var(--theme-text,var(--qreports-text,#34425e)); border-color:var(--theme-control-border,var(--qreports-grid,#cbd5e1)); }
.canvas-toggle { width:46px; height:26px; padding:3px; border-radius:999px; background:var(--theme-control-bg,#e5e7eb); }
.canvas-toggle span { display:block; width:18px; height:18px; border-radius:50%; background:var(--theme-surface,#fff); transition:transform .16s ease; }
.canvas-toggle.active { background:var(--theme-accent,#4f6ee8); }
.canvas-toggle.active span { transform:translateX(18px); }
.canvas-toggle-row button:last-child { width:auto; margin-left:auto; }
.canvas-range { grid-column:1 / -1; display:grid; gap:7px; }
.canvas-range>input[type=range] { width:100%; height:28px; margin:0; padding:0!important; border:0!important; appearance:none; background:linear-gradient(to right,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 0 var(--range-end,100%),var(--qreports-grid,var(--theme-control-border,#cbd5e1)) var(--range-end,100%) 100%) center/100% 6px no-repeat!important; color:var(--qreports-text,var(--theme-text,#34425e)); }
.canvas-range>input[type=range]::-webkit-slider-runnable-track { height:6px; background:transparent; }
.canvas-range>input[type=range]::-webkit-slider-thumb { appearance:none; width:20px; height:20px; margin-top:-7px; border:2px solid var(--qreports-surface,#fff); border-radius:50%; background:var(--qreports-accent,var(--theme-accent,#4f6ee8)); box-shadow:0 0 0 1px var(--qreports-accent,var(--theme-accent,#4f6ee8)); }
.canvas-range>input[type=range]::-moz-range-track { height:6px; background:transparent; }
.canvas-range>input[type=range]::-moz-range-thumb { width:20px; height:20px; border:2px solid var(--qreports-surface,#fff); border-radius:50%; background:var(--qreports-accent,var(--theme-accent,#4f6ee8)); box-shadow:0 0 0 1px var(--qreports-accent,var(--theme-accent,#4f6ee8)); }
.canvas-range output { justify-self:center; min-width:28px; padding:3px 8px; border:1px solid var(--qreports-grid,var(--theme-control-border,#cbd5e1)); border-radius:6px; background:color-mix(in srgb,var(--qreports-accent,var(--theme-accent,#4f6ee8)) 16%,var(--qreports-surface,#fff)); color:var(--qreports-text,var(--theme-text,#34425e)); font-weight:700; text-align:center; }
.dual-range { position:relative; min-height:28px; background:linear-gradient(to right,var(--qreports-grid,var(--theme-control-border,#cbd5e1)) 0 var(--range-start,0%),var(--qreports-accent,var(--theme-accent,#4f6ee8)) var(--range-start,0%) var(--range-end,100%),var(--qreports-grid,var(--theme-control-border,#cbd5e1)) var(--range-end,100%) 100%) center/100% 6px no-repeat; border-radius:999px; }
.dual-range input[type=range] { position:absolute; inset:0; width:100%; height:28px; margin:0; padding:0!important; border:0!important; background:transparent!important; color:var(--qreports-text,var(--theme-text,#34425e)); pointer-events:none; appearance:none; }
.dual-range .range-low { z-index:2; }
.dual-range .range-high { z-index:3; }
.dual-range input[type=range]::-webkit-slider-runnable-track { height:6px; background:transparent; }
.dual-range input[type=range]::-webkit-slider-thumb { appearance:none; width:20px; height:20px; margin-top:-7px; border:2px solid var(--qreports-surface,#fff); border-radius:50%; background:var(--qreports-accent,var(--theme-accent,#4f6ee8)); box-shadow:0 0 0 1px var(--qreports-accent,var(--theme-accent,#4f6ee8)); }
.dual-range input[type=range]::-moz-range-track { height:6px; background:transparent; }
.dual-range input[type=range]::-moz-range-progress { background:transparent; }
.dual-range input[type=range]::-moz-range-thumb { width:20px; height:20px; border:2px solid var(--qreports-surface,#fff); border-radius:50%; background:var(--qreports-accent,var(--theme-accent,#4f6ee8)); box-shadow:0 0 0 1px var(--qreports-accent,var(--theme-accent,#4f6ee8)); }
body.presentation-mode { display:flex; flex-direction:column; background:var(--presentation-surface,var(--qreports-surface,#fff)); color:var(--presentation-text,var(--qreports-text,#182230)); }
body.presentation-mode>.app-header,body.presentation-mode>.commandbar,body.presentation-mode .left-panel,body.presentation-mode .right-panel,body.presentation-mode .pane-splitter,body.presentation-mode .statusbar { display:none!important; }
body.presentation-mode>main { display:block!important; flex:1; min-height:0; height:auto; }
body.presentation-mode .workspace,body.presentation-mode .canvas-viewport { display:block; height:100%; }
body.presentation-mode .canvas-viewport { overflow:auto; scrollbar-gutter:auto; }
body.presentation-mode .tile { outline:none!important; }
body.presentation-mode .resize-handle,body.presentation-mode .connection-port,body.presentation-mode .tile-kind { display:none!important; }
#presentationHeader { position:fixed; inset:0 0 auto 0; box-sizing:border-box; display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:8px; align-items:center; padding:8px 12px; background:var(--presentation-header,var(--qreports-surface,#fff)); color:var(--presentation-header-text,var(--qreports-text,#34425e)); border-bottom:1px solid var(--presentation-grid,var(--qreports-border,#ccd5e0)); max-height:45vh; overflow:visible; scrollbar-width:none; -ms-overflow-style:none; z-index:3000; transition:max-height .2s ease,padding .2s ease,opacity .16s ease,border-color .16s ease; }
body.presentation-mode.presentation-controls-pinned>#presentationHeader { position:relative; inset:auto; flex:0 0 auto; }
#presentationHeader::-webkit-scrollbar { width:0; height:0; }
body.presentation-mode.presentation-controls-hidden>#presentationHeader { max-height:0; min-height:0; padding-top:0; padding-bottom:0; overflow:hidden; border-color:transparent; opacity:0; pointer-events:none; }
.presentation-title strong,.presentation-title small { display:block; }
.presentation-title small { opacity:.7; font-size:11px; }
#presentationHeader nav { display:flex; min-width:0; align-items:center; flex-wrap:nowrap; gap:6px; overflow:visible; }
#presentationHeader nav button { flex:0 0 auto; }
.presentation-page-list { display:flex; min-width:0; flex:1 1 auto; gap:6px; overflow:hidden; }
.presentation-page-hidden { display:none!important; }
.presentation-page-overflow,.presentation-control-menu { position:relative; flex:0 0 auto; margin:0; }
.presentation-page-overflow[open] { z-index:3400; }
.presentation-control-menu[open] { z-index:3500; }
.presentation-page-overflow>summary,.presentation-control-menu>summary { display:flex; box-sizing:border-box; min-height:34px; align-items:center; justify-content:center; gap:6px; padding:7px 10px; list-style:none; cursor:pointer; user-select:none; border:1px solid var(--presentation-grid,#ccd5e0); border-radius:7px; background:var(--viewer-unselected-bg,var(--presentation-surface,#fff)); color:var(--viewer-unselected-color,var(--presentation-text,#34425e)); white-space:nowrap; }
.presentation-control-menu>summary { min-height:40px; padding:8px 12px; touch-action:manipulation; }
.presentation-page-overflow>summary::-webkit-details-marker,.presentation-control-menu>summary::-webkit-details-marker { display:none; }
.presentation-page-overflow>summary { min-width:40px; padding-inline:10px; font-size:18px; font-weight:800; letter-spacing:2px; }
.presentation-page-overflow[open]>summary,.presentation-control-menu[open]>summary { border-color:var(--viewer-selected-bg,#4f6ee8); box-shadow:0 0 0 1px var(--viewer-selected-bg,#4f6ee8); }
.presentation-page-overflow-menu,.presentation-control-menu>:not(summary) { position:absolute; z-index:3300; top:calc(100% + 6px); right:0; }
.presentation-page-overflow-menu { display:grid; width:min(280px,70vw); max-height:min(420px,65vh); gap:2px; padding:6px; overflow:auto; border:1px solid var(--presentation-grid,#ccd5e0); border-radius:8px; background:var(--presentation-header,var(--qreports-surface,#fff)); box-shadow:0 14px 34px #10182838; }
.presentation-page-overflow-menu button { width:100%; overflow:hidden; text-align:left; text-overflow:ellipsis; white-space:nowrap; }
.presentation-actions { display:flex; min-width:0; flex-wrap:nowrap; justify-content:flex-end; gap:6px; }
#presentationHeader nav button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); }
body.presentation-tab-navigation #presentationHeader nav { align-self:end; gap:0; }
body.presentation-tab-navigation #presentationHeader nav .presentation-page-list { gap:0; }
body.presentation-mode.presentation-tab-navigation:not(.presentation-left-tabs)>#presentationHeader { padding-bottom:0; }
body.presentation-mode.presentation-tab-navigation:not(.presentation-left-tabs)>#presentationHeader nav { align-self:stretch; margin-bottom:-1px; }
body.presentation-tab-navigation #presentationHeader nav button { border-radius:8px 8px 0 0; border-color:var(--presentation-grid,#ccd5e0); border-bottom-color:var(--presentation-grid,#ccd5e0); background:transparent; color:var(--viewer-unselected-color,var(--presentation-header-text,#34425e)); }
body.presentation-tab-navigation #presentationHeader nav button.active { border-bottom-color:var(--presentation-surface,var(--qreports-surface,#fff)); box-shadow:inset 0 -3px var(--viewer-selected-bg,#4f6ee8); }
#presentationPageNav { display:none; }
body.presentation-mode.presentation-left-tabs { display:grid; grid-template-columns:minmax(150px,220px) minmax(0,1fr); grid-template-rows:auto minmax(0,1fr); }
body.presentation-left-tabs>#presentationHeader { grid-column:1 / -1; grid-row:1; }
body.presentation-left-tabs>#presentationPageNav { display:flex; grid-column:1; grid-row:2; min-width:200px; width:auto; flex-direction:column; align-items:stretch; gap:4px; padding:14px 10px; overflow:auto; background:var(--presentation-header,var(--qreports-surface,#fff)); border-right:1px solid var(--presentation-grid,#ccd5e0); }
body.presentation-left-tabs>#presentationPageNav .presentation-page-list { flex-direction:column; overflow:visible; }
body.presentation-left-tabs>#presentationPageNav button { width:100%; min-height:38px; text-align:left; white-space:normal; overflow-wrap:anywhere; border:0; border-radius:6px; background:transparent; color:var(--viewer-unselected-color,var(--presentation-header-text,#34425e)); }
body.presentation-left-tabs>#presentationPageNav button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); }
body.presentation-left-tabs>main { grid-column:2; grid-row:2; }
#presentationHeader .presentation-filters { grid-column:1 / -1; margin:0; }
#presentationHeader fieldset { display:flex; flex-wrap:wrap; gap:12px; margin:8px 0; }
#presentationHeader .presentation-filters,#presentationFiltersPane .presentation-filters {
  --qreports-surface:var(--presentation-surface,#fff);
  --qreports-text:var(--presentation-text,#182230);
  --qreports-grid:var(--presentation-grid,#ccd5e0);
  --qreports-border:var(--presentation-grid,#ccd5e0);
  --qreports-input-bg:var(--viewer-unselected-bg,var(--presentation-surface,#fff));
  --qreports-accent:var(--viewer-selected-bg,#4f6ee8);
  --qreports-on-accent:var(--viewer-selected-color,#fff);
  color:var(--presentation-text,#182230);
  color-scheme:var(--presentation-color-scheme,light);
}
#presentationHeader .export-filter,#presentationFiltersPane .export-filter { display:block; min-width:180px; color:inherit; }
#presentationHeader .filter-buttons,#presentationFiltersPane .filter-buttons { display:flex; flex-wrap:wrap; gap:5px; }
#presentationHeader .filter-buttons button.active,#presentationFiltersPane .filter-buttons button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); }
#presentationHeader .filter-buttons button:not(.active),#presentationFiltersPane .filter-buttons button:not(.active) { background:var(--viewer-unselected-bg,#fff); color:var(--viewer-unselected-color,#34425e); border-color:var(--presentation-grid,#ccd5e0); }
#presentationHeader .search-multiple>input,#presentationFiltersPane .search-multiple>input { width:100%; padding:8px; border:1px solid var(--qreports-border,#cbd5e1); border-radius:7px; background:var(--qreports-input-bg,#fff); color:inherit; }
#presentationHeader .toggle-filter-row,#presentationFiltersPane .toggle-filter-row { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
#presentationHeader .export-toggle,#presentationFiltersPane .export-toggle { width:48px; height:28px; padding:3px; border-radius:999px; background:var(--viewer-unselected-bg,#fff); color:var(--viewer-unselected-color,#34425e); }
#presentationHeader .export-toggle span,#presentationFiltersPane .export-toggle span { display:block; width:20px; height:20px; border-radius:50%; background:currentColor; transition:transform .15s; }
#presentationHeader .export-toggle.active,#presentationFiltersPane .export-toggle.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); }
#presentationHeader .export-toggle.active span,#presentationFiltersPane .export-toggle.active span { transform:translateX(18px); }
body.presentation-mode.presentation-vertical-filters { display:grid; grid-template-columns:0 minmax(0,1fr); grid-template-rows:auto minmax(0,1fr); }
body.presentation-mode.presentation-vertical-filters>#presentationHeader { grid-column:1 / -1; grid-row:1; }
body.presentation-mode.presentation-vertical-filters>main { grid-column:2; grid-row:2; }
body.presentation-mode.presentation-vertical-filters.presentation-filters-open { grid-template-columns:minmax(260px,340px) minmax(0,1fr); }
#presentationFiltersPane { display:none; }
body.presentation-filters-open>#presentationFiltersPane { display:block; grid-column:1; grid-row:2; overflow:auto; padding:12px; background:var(--presentation-surface,var(--qreports-surface,#fff)); color:var(--presentation-text,var(--qreports-text,#182230)); border-right:1px solid var(--presentation-grid,var(--qreports-border,#ccd5e0)); color-scheme:var(--qreports-color-scheme,light); }
#presentationFiltersPane .presentation-filters { color:inherit; }
#presentationFiltersPane .presentation-filters>summary { color:inherit; border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane fieldset { margin:8px 0; min-width:0; color:inherit; border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane legend { color:inherit; }
#presentationFiltersPane .export-filter { max-width:100%; color:var(--presentation-text,var(--qreports-text,#182230)); border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane :is(input:not([type="range"]):not([type="checkbox"]),select) { background:var(--viewer-unselected-bg,var(--presentation-surface,#fff)); color:var(--viewer-unselected-color,var(--presentation-text,#182230)); border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane button { border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane button:not(.active),#presentationHeader .presentation-filters button:not(.active) { background:var(--viewer-unselected-bg,var(--presentation-surface,#fff)); color:var(--viewer-unselected-color,var(--presentation-text,#182230)); }
#presentationFiltersPane input[type="checkbox"],#presentationHeader .presentation-filters input[type="checkbox"] { accent-color:var(--viewer-selected-bg,#4f6ee8); }
body.presentation-mode.presentation-vertical-filters.presentation-right-filters { grid-template-columns:minmax(0,1fr) 0; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters { grid-template-columns:minmax(200px,260px) 0 minmax(0,1fr); }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters>#presentationPageNav { grid-column:1; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters>main { grid-column:3; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters.presentation-filters-open { grid-template-columns:minmax(200px,260px) minmax(260px,340px) minmax(0,1fr); }
body.presentation-mode.presentation-left-tabs.presentation-filters-open>#presentationFiltersPane { grid-column:2; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters.presentation-right-filters { grid-template-columns:minmax(200px,260px) minmax(0,1fr) 0; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters.presentation-right-filters>main { grid-column:2; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters.presentation-right-filters.presentation-filters-open { grid-template-columns:minmax(200px,260px) minmax(0,1fr) minmax(260px,340px); }
body.presentation-mode.presentation-left-tabs.presentation-right-filters.presentation-filters-open>#presentationFiltersPane { grid-column:3; }
body.presentation-mode.presentation-right-filters>main { grid-column:1; }
body.presentation-mode.presentation-right-filters.presentation-filters-open { grid-template-columns:minmax(0,1fr) minmax(260px,340px); }
body.presentation-right-filters.presentation-filters-open>#presentationFiltersPane { grid-column:2; border-right:0; border-left:1px solid var(--presentation-grid,var(--qreports-border,#ccd5e0)); }
@media(max-width:900px){
  #presentationHeader{grid-template-columns:minmax(0,1fr) auto;gap:6px;padding-inline:8px}
  #presentationHeader .presentation-title{display:none}
  #presentationHeader nav{grid-column:1;grid-row:1}
  #presentationHeader .presentation-actions{grid-column:2;grid-row:1}
}
.dual-range input[type=range]::-webkit-slider-thumb { pointer-events:auto; }
.dual-range input[type=range]::-moz-range-thumb { pointer-events:auto; }

body.presentation-mode #canvas { zoom:var(--presentation-zoom,1); }
body.presentation-mode .gantt-toolbar-toggle:hover { border-color:var(--viewer-selected-bg,var(--gantt-accent)); }
body.presentation-mode.presentation-fit-screen .canvas-viewport { display:grid; place-items:center; }
body.presentation-mode.presentation-fit-width .canvas-viewport { display:grid; justify-items:center; align-items:start; }
body.presentation-mode.presentation-fit-height .canvas-viewport { display:grid; justify-items:start; align-items:center; }
.presentation-zoom { display:flex; align-items:center; gap:4px; flex-shrink:0; }
.presentation-control-menu>.presentation-zoom,.presentation-control-menu>.presentation-tools { box-sizing:border-box; width:max-content; max-width:min(720px,calc(100vw - 28px)); padding:8px; border:1px solid var(--presentation-grid,#ccd5e0); border-radius:8px; background:var(--presentation-header,var(--qreports-surface,#fff)); box-shadow:0 14px 34px #10182838; }
.presentation-control-menu>summary::after { content:"▾"; font-size:10px; opacity:.72; }
.presentation-control-menu[open]>summary::after { content:"▴"; }
.presentation-control-menu>summary output { min-width:4ch; font:inherit; font-variant-numeric:tabular-nums; opacity:.72; }
.presentation-control-menu>summary>* { pointer-events:none; }
.presentation-zoom output { min-width:5ch; text-align:center; font-variant-numeric:tabular-nums; }
.presentation-zoom button:disabled { opacity:.45; cursor:default; }
.presentation-fit-label { margin-left:4px; padding-left:7px; border-left:1px solid var(--presentation-grid,#ccd5e0); font-size:12px; font-weight:600; white-space:nowrap; opacity:.78; }
.presentation-zoom .presentation-fit-tool { width:38px; min-width:38px; padding-inline:7px; font-size:19px; line-height:1; }
.presentation-zoom .presentation-fit-tool[aria-pressed="true"] { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); }
.presentation-tools { display:flex; align-items:center; gap:4px; padding-left:6px; border-left:1px solid var(--presentation-grid,#ccd5e0); }
.presentation-draw-label { margin-left:3px; padding-left:7px; border-left:1px solid var(--presentation-grid,#ccd5e0); font-size:0; font-weight:600; white-space:nowrap; opacity:.78; }
.presentation-draw-label::after { content:"Annotations:"; font-size:11px; }
.presentation-tools [data-presentation-tool="rectangle"]>span,
.presentation-tools [data-presentation-tool="oval"]>span { font-size:21px; line-height:1; }
.presentation-tools button,.presentation-zoom button { display:inline-flex; align-items:center; justify-content:center; gap:5px; white-space:nowrap; }
.presentation-tools button,.presentation-zoom button,.presentation-actions>button:not(.primary) { background:var(--viewer-unselected-bg,var(--presentation-surface,#fff)); color:var(--viewer-unselected-color,var(--presentation-text,#34425e)); border-color:var(--presentation-grid,#ccd5e0); }
.presentation-tools button[aria-pressed="true"] { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); }
.presentation-tools button:disabled { opacity:.42; cursor:default; }
.presentation-tools .presentation-icon-tool { width:38px; padding-inline:8px; }
.presentation-navigation-tools { display:flex; align-items:center; gap:4px; padding-left:6px; border-left:1px solid var(--presentation-grid,#ccd5e0); }
.presentation-navigation-tools output { min-width:5.2ch; text-align:center; font-size:12px; font-variant-numeric:tabular-nums; white-space:nowrap; }
.presentation-navigation-tools button { display:inline-grid; width:38px; min-width:38px; padding-inline:6px; place-items:center; background:var(--viewer-unselected-bg,var(--presentation-surface,#fff)); color:var(--viewer-unselected-color,var(--presentation-text,#34425e)); border-color:var(--presentation-grid,#ccd5e0); font-size:17px; }
.presentation-navigation-tools button[aria-pressed="true"] { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); }
.presentation-icon-tool svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
.presentation-pointer-icon { display:inline-block; width:9px; height:9px; border-radius:50%; background:#e11d48; box-shadow:0 0 0 2px #fff8; }
.presentation-annotation-layer { position:absolute; inset:0; z-index:2400; width:100%; height:100%; overflow:visible; pointer-events:none; }
.presentation-annotation-layer.drawing { pointer-events:auto; cursor:crosshair; touch-action:none; }
.presentation-annotation-layer.erasing { pointer-events:auto; cursor:crosshair; touch-action:none; }
.presentation-annotation-layer.erasing .presentation-annotation { pointer-events:all; cursor:crosshair; }
.presentation-annotation { fill:#e11d4820; stroke:#e11d48; stroke-width:4; filter:drop-shadow(0 1px 1px #fff); pointer-events:none; }
.presentation-annotation-layer rect.presentation-annotation { fill:#e11d4808; stroke-width:2; }
.presentation-annotation.preview { stroke-dasharray:8 5; }
#presentationPointer { position:fixed; z-index:5000; width:18px; height:18px; transform:translate(-50%,-50%); border:2px solid #fff; border-radius:50%; background:#e11d48; box-shadow:0 1px 7px #0009,0 0 0 2px #e11d4866; pointer-events:none; }
#presentationPointer[hidden] { display:none; }
body.presentation-pan-ready:not(.presentation-panning) .canvas-viewport { cursor:grab; }
body.presentation-panning .canvas-viewport { cursor:grabbing; user-select:none; }
body.presentation-black-screen::after { content:""; position:fixed; inset:0; z-index:10000; background:#000; }
.presentation-page-overview { width:min(980px,calc(100vw - 40px)); max-width:none; max-height:calc(100vh - 40px); padding:0; overflow:hidden; border:1px solid var(--presentation-grid,#ccd5e0); border-radius:12px; background:var(--presentation-surface,#fff); color:var(--presentation-text,#182230); box-shadow:0 24px 80px #0009; }
.presentation-page-overview::backdrop { background:#0008; backdrop-filter:blur(2px); }
.presentation-page-overview form { display:flex; max-height:calc(100vh - 42px); flex-direction:column; }
.presentation-page-overview header { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:14px 16px; border-bottom:1px solid var(--presentation-grid,#ccd5e0); }
.presentation-page-overview h2,.presentation-page-overview p { margin:0; }
.presentation-page-overview p { margin-top:3px; font-size:12px; opacity:.68; }
.presentation-page-overview header button { width:36px; height:36px; padding:0; font-size:22px; }
.presentation-page-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:12px; overflow:auto; padding:14px; }
.presentation-page-card { display:grid; gap:7px; min-width:0; padding:8px; text-align:left; background:var(--viewer-unselected-bg,var(--presentation-surface,#fff)); color:var(--viewer-unselected-color,var(--presentation-text,#34425e)); border:2px solid var(--presentation-grid,#ccd5e0); border-radius:9px; }
.presentation-page-card.active { border-color:var(--viewer-selected-bg,#4f6ee8); box-shadow:0 0 0 2px color-mix(in srgb,var(--viewer-selected-bg,#4f6ee8) 22%,transparent); }
.presentation-page-thumbnail { position:relative; display:block; aspect-ratio:16/9; overflow:hidden; border:1px solid var(--presentation-grid,#ccd5e0); border-radius:5px; background-position:center; }
.presentation-page-thumbnail i { position:absolute; display:block; min-width:2px; min-height:2px; border:1px solid; border-radius:2px; opacity:.92; }
.presentation-page-caption { display:grid; grid-template-columns:2.2ch minmax(0,1fr); gap:6px; align-items:center; font-size:12px; }
.presentation-page-caption span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.presentation-context-menu { z-index:12010; width:250px; max-height:calc(100vh - 16px); overflow:auto; background:var(--presentation-surface,#fff); color:var(--presentation-text,#182230); border-color:var(--presentation-grid,#ccd5e0); color-scheme:var(--presentation-color-scheme,light); }
.presentation-context-menu>button,.presentation-context-menu details button { display:grid; grid-template-columns:22px minmax(0,1fr); align-items:center; width:100%; min-height:34px; padding:7px 9px; color:inherit; background:transparent; border:0; border-radius:5px; text-align:left; }
.presentation-context-menu>button>span { display:grid; place-items:center; }
.presentation-context-menu button:hover:not(:disabled),.presentation-context-menu summary:hover { background:color-mix(in srgb,var(--viewer-selected-bg,#4f6ee8) 13%,transparent); }
.presentation-context-menu button[aria-pressed="true"] { color:var(--viewer-selected-bg,#4f6ee8); font-weight:700; }
.presentation-context-menu button:disabled { opacity:.42; }
.presentation-context-menu hr { width:100%; margin:3px 0; border:0; border-top:1px solid var(--presentation-grid,#ccd5e0); }
.presentation-context-menu details { margin:0; padding:0; border:0; }
.presentation-context-menu summary { display:grid; grid-template-columns:22px minmax(0,1fr) auto; align-items:center; min-height:34px; margin:0; padding:7px 9px; border-radius:5px; cursor:pointer; list-style:none; }
.presentation-context-menu summary::-webkit-details-marker { display:none; }
.presentation-context-menu summary::after { content:"›"; font-size:18px; transform-origin:center; }
.presentation-context-menu details[open]>summary::after { transform:rotate(90deg); }
.presentation-context-menu details>div { margin:2px 0 4px 18px; padding-left:5px; border-left:1px solid var(--presentation-grid,#ccd5e0); }
.presentation-context-menu details button { display:block; }
@media(max-width:1100px){.presentation-tools button{font-size:0}.presentation-tools button>span{font-size:16px}.presentation-tools [data-presentation-annotation-undo]{font-size:18px}.presentation-tools [data-presentation-annotation-clear]{font-size:11px}}
