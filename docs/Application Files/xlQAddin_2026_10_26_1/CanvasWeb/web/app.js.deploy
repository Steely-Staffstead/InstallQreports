  }
  document.addEventListener("click",event=>{const action=event.target.closest("[data-action]")?.dataset.action,menu=$("#updateMenu");if(action==="toggleUpdate"){menu?.classList.toggle("hidden");event.stopPropagation();return;}if(action==="refreshSelected"||action==="refreshSelectedUnderlying"){menu?.classList.add("hidden");invokeBridge("refresh",action==="refreshSelectedUnderlying");event.stopPropagation();return;}if(action==="refreshAll"||action==="refreshAllUnderlying"){menu?.classList.add("hidden");refreshAllSources(false,action==="refreshAllUnderlying");event.stopPropagation();return;}if(!event.target.closest(".update-menu-wrap"))menu?.classList.add("hidden");},true);
  function syncJson(force=false) { const editor=$("#jsonEditor");if(!force&&!editor.closest("details")?.open)return;editor.value = JSON.stringify(model, null, 2); }
  $("#jsonEditor").closest("details")?.addEventListener("toggle",event=>{if(event.currentTarget.open)syncJson(true);});
  async function refreshManualFileSources(){if(!host)return;const sources=model.sources.filter(fileLocalSource);if(!sources.length)return;const unavailable=[];for(const source of sources){try{const loaded=await localBridgeCall("localTableLoad",{name:source.localTable?.name||source.name}),definition=loaded.definition||{},data=loaded.data||{};if(String(definition.SourceMode||"").toLowerCase()!=="manual")throw new Error("the local source is no longer a Manual table");source.query||=blankQuery();source.query.data={columns:data.columns||[],types:data.types||[],rows:data.rows||[]};source.query.totalRows=source.query.data.rows.length;source.query.previewLimit=Math.max(source.query.totalRows,Number(source.query.previewLimit)||0);source.localTable={...(source.localTable||{}),storage:"file",name:definition.Name||source.localTable?.name||source.name,id:definition.Id||source.localTable?.id||"",updatedUtc:definition.UpdatedUtc||source.localTable?.updatedUtc||""};}catch(reason){unavailable.push(`${source.name}: ${reason.message||reason}`);}}render();if(unavailable.length)$("#jsonError").textContent=`Using cached data because these Manual local tables could not be refreshed: ${unavailable.join(" · ")}`;else $("#saveStatus").textContent=`Refreshed ${sources.length} Manual local table${sources.length===1?"":"s"}`;}
  function load(doc, fileName = "", filePath = "") { finishFormatPainter("");model = normalize(doc); if (!model.pages.length) throw new Error("Document must contain a page"); updateSaveTooltip(filePath); pageIndex = 0; selectedId = null;selectedIds.clear(); dirty = false; post("documentDirty",{dirty:false}); $("#saveStatus").textContent = fileName ? `Opened ${fileName}` : "Ready"; $("#jsonError").textContent = ""; render();resetHistory();void refreshManualFileSources();
    // Saved rows are a compact preview. Measures in cards and matrices must
    // evaluate against every row, including values absent from that preview.
    if(host&&!hostMode){const incomplete=model.sources.filter(source=>source.query?.queryText&&source.query?.measures?.length&&source.query.totalRows>source.query.data.rows.length);
      const automatic=incomplete.filter(source=>source.query.totalRows<=50000),manual=incomplete.filter(source=>source.query.totalRows>50000);
      if(manual.length)$("#jsonError").textContent=`${manual.map(source=>source.name).join(", ")} contains preview rows only. Use Update to load all rows for accurate measures.`;
      if(automatic.length){sourceRefreshQueue=automatic.map(source=>source.id);refreshingAllSources=true;returnAfterSourceRefresh=false;$("#saveStatus").textContent="Loading complete data for measures…";setTimeout(refreshNextSource,0);}
    }
  }
  function fileDocument(){syncPublishedGanttSources(model);const mainQuery=model.sources.find(source=>source.id==="main")?.query,saved={...model,sources:model.sources.map(source=>{const q=source.query;if(source.kind==="gantt")return{...source,query:{...q,data:{columns:[],types:[],rows:[]},totalRows:0,measureValues:{}}};if(manualLocalSource(source))return source;const limit=Math.max(1,Number(q.previewLimit)||1000);return q.data?.rows?.length>limit?{...source,query:{...q,data:{...q.data,rows:q.data.rows.slice(0,limit)}}}:source;}),pages:model.pages.map(page=>{if(!mainQuery||page.query!==mainQuery)return page;const {query,...savedPage}=page;return savedPage;})};return syncEmbeddedLocalSources(saved);}
  function download() { const a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([JSON.stringify(fileDocument())], { type: "application/json" })); a.download = `${(model.name || "report").replace(/[^a-z0-9_-]+/gi, "-")}.qanvas`; a.click(); URL.revokeObjectURL(a.href);dirty=false;post("documentDirty",{dirty:false});$("#saveStatus").textContent="Canvas downloaded"; }
  new ResizeObserver(()=>{if(model?.pages?.length&&!document.body.classList.contains("excel-export"))applyCanvasSize();}).observe(document.querySelector(".canvas-viewport"));
  function showSidePanel(name) { $("#propertiesPanel").classList.toggle("hidden", name !== "properties"); $("#filtersPanel").classList.toggle("hidden", name !== "filters"); document.querySelectorAll("[data-panel]").forEach(b => b.classList.toggle("active", b.dataset.panel === name)); }
  function openPrimaryTileEditor(tile=selectedTile()){
    if(!tile||selectedIds.size>1)return false;
    if(["text","graphicText"].includes(tile.kind)){focusFormattedText(tile);return true;}
    if(["table","list","matrix","chart","reportGrid","gantt","svgGraphic","multiCard"].includes(tile.kind)){openTileDesigner();return true;}
    model.settings.rightPaneCollapsed=false;applyPaneLayout();showSidePanel("properties");renderPropertyPanels();
    document.querySelector(".tile-settings")?.setAttribute("open","");
    let panel=null,focus=null;
    if(tile.kind==="picture"){
      panel=$("#pictureProperties");focus=panel?.querySelector('[data-picture="imageSizing"]');
    }else if(tile.kind==="card"){
      focus=$("#tileField");panel=focus?.closest("label");
    }else if(tile.kind==="svgGraphic"){
      panel=$("#svgGraphicProperties")?.querySelector('details[data-group="content"],details[data-group="svgText"],details[data-group="svg"]');
      focus=panel?.querySelector('input:not([type="hidden"]),select,textarea,button');
    }else if(tile.kind==="valueSelector"){
      panel=$("#valueSelectorProperties");focus=panel?.querySelector("select,input,button");
    }else if(graphicKinds.has(tile.kind)){
      panel=$("#graphicProperties")?.querySelector("details:not(.hidden)")||$("#graphicProperties");
      focus=panel?.querySelector('input:not([type="hidden"]),select,textarea,[contenteditable="true"],button');
    }else{
      panel=$("#tileProperties");focus=panel?.querySelector('input:not([type="hidden"]),select,textarea,button');
    }
    if(panel?.tagName==="DETAILS")panel.open=true;
    requestAnimationFrame(()=>{const target=focus||panel;target?.scrollIntoView?.({block:"nearest"});if(focus&&!focus.disabled)focus.focus({preventScroll:true});});
    return !!(panel||focus);
  }
  let connectorMotionSignature="";
  function animateAttachedConnectors(){
    if(drag?.mode==="move"){
      const signature=`${drag.t.id}:${drag.t.x}:${drag.t.y}`;
      if(signature!==connectorMotionSignature){connectorMotionSignature=signature;refreshConnectors();}
    }else connectorMotionSignature="";
    requestAnimationFrame(animateAttachedConnectors);
  }
  requestAnimationFrame(animateAttachedConnectors);
  function clearCanvasSelection(){selectedId=null;selectedIds.clear();syncSelection();renderProperties();renderVisualProperties();renderVisualTypography();renderSubtotalProperties();renderCardProperties();renderCardCaptionProperties();renderCardBorderControl();renderBorderProperties();renderChartProperties();renderGraphicProperties();renderLayerProperties();}
  function installCanvasPanning(){
    const viewport=$("#canvasViewport"),canvas=$("#canvas");let pan=null,suppressClick=false;
    if(!viewport||!canvas)return;
    viewport.classList.add("canvas-pan-enabled");
    window.addEventListener("pointerdown",event=>{
      if(event.button!==0||event.target!==canvas||event.ctrlKey||event.metaKey||event.shiftKey||document.querySelector("dialog[open]"))return;
      pan={pointerId:event.pointerId,startX:event.clientX,startY:event.clientY,scrollLeft:viewport.scrollLeft,scrollTop:viewport.scrollTop,moved:false};
      viewport.classList.add("canvas-pan-active");
      try{canvas.setPointerCapture(event.pointerId);}catch{}
      event.preventDefault();event.stopImmediatePropagation();
    },true);
    window.addEventListener("pointermove",event=>{
      if(!pan||event.pointerId!==pan.pointerId)return;
      const dx=event.clientX-pan.startX,dy=event.clientY-pan.startY;
      if(!pan.moved&&Math.hypot(dx,dy)>=3)pan.moved=true;
      if(pan.moved){viewport.scrollLeft=pan.scrollLeft-dx;viewport.scrollTop=pan.scrollTop-dy;}
      event.preventDefault();event.stopImmediatePropagation();
    },true);
    const finish=event=>{
      if(!pan||event.pointerId!==pan.pointerId)return;
      const moved=pan.moved,pointerId=pan.pointerId;pan=null;viewport.classList.remove("canvas-pan-active");
      try{if(canvas.hasPointerCapture(pointerId))canvas.releasePointerCapture(pointerId);}catch{}
      if(moved){suppressClick=true;setTimeout(()=>suppressClick=false,0);}else if(!document.body.classList.contains("presentation-mode")&&!window.QanvasReport)clearCanvasSelection();
