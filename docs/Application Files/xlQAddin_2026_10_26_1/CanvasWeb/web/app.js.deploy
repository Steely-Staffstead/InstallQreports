    const renderSources=()=>{sourceFields.innerHTML=fields.length?fields.map(field=>`<button type="button" draggable="true" data-field="${esc(field)}" title="Drag ${esc(field)} to a binding"><span>⋮⋮</span>${esc(field)}</button>`).join(""):'<p class="property-empty">No source fields are available.</p>';sourceMeasures.innerHTML=measures.length?measures.map(item=>`<button type="button" data-svg-measure="${esc(item.token)}" title="Available as {{measure:${esc(item.token)}}}">${esc(item.label)}</button>`).join(""):'<p class="property-empty">No measures are available.</p>';sourceParameters.innerHTML=parameters.length?parameters.map(name=>`<button type="button" data-svg-parameter="${esc(name)}">${esc(name)}</button>`).join(""):'<p class="property-empty">No parameters are available.</p>';};
    const renderOptions=()=>{
