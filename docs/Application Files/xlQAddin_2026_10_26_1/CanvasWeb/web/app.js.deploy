  }
  const pageButtonsHtml=listedPages=>listedPages.map(({item,index})=>`<button class="page-item ${index===pageIndex?"active":""} ${item.hidden?"hidden-page":""}" data-page="${index}" draggable="true" title="Drag to reorder · Double-click to rename page">${item.hidden?'<span class="page-hidden-mark" aria-label="Hidden page">◌</span> ':""}${esc(item.name)}</button>`).join("");
  function updatePageBarOverflow(){
    const bar=$("#canvasPageBar"),list=$("#pageBarList"),wrap=$("#pageOverflowWrap"),button=$("#pageOverflowButton"),menu=$("#pageOverflowMenu");
    if(!bar||!list||!wrap||!button||!menu||pageListPosition()==="left"||document.body.classList.contains("presentation-mode")){wrap?.classList.add("hidden");return;}
    const items=[...list.querySelectorAll(".page-item")];items.forEach(item=>item.classList.remove("page-overflowed"));wrap.classList.add("hidden");menu.classList.add("hidden");button.setAttribute("aria-expanded","false");
    if(!items.length||list.scrollWidth<=list.clientWidth+1)return;
    wrap.classList.remove("hidden");const available=Math.max(0,list.clientWidth),gap=parseFloat(getComputedStyle(list).columnGap)||0,widths=items.map(item=>item.getBoundingClientRect().width),active=Math.max(0,items.findIndex(item=>item.classList.contains("active"))),shown=new Set([active]);let used=widths[active]||0,left=active-1,right=active+1;
    while(left>=0||right<items.length){for(const candidate of [left,right]){if(candidate<0||candidate>=items.length)continue;const width=(widths[candidate]||0)+(shown.size?gap:0);if(used+width<=available){shown.add(candidate);used+=width;}}left--;right++;}
    items.forEach((item,index)=>item.classList.toggle("page-overflowed",!shown.has(index)));const hidden=items.filter(item=>item.classList.contains("page-overflowed"));
    menu.innerHTML=hidden.map(item=>`<button type="button" role="menuitem" data-overflow-page="${item.dataset.page}">${item.innerHTML}</button>`).join("");button.title=`More pages (${hidden.length})`;button.setAttribute("aria-label",button.title);
  }
  function render() {
    if(!presentationState)document.body.classList.remove("presentation-fit-screen");
    syncPublishedGanttSources(model);
    if(!showHiddenPagesWhileEditing()&&page()?.hidden){const first=visiblePageEntries()[0];if(first)pageIndex=first.index;}
    document.body.classList.toggle('theme-colors-required',model.settings.theme?.requireColors===true);
    ensureSourceUi();
    ensurePageNavigationUi();
    applyPaneLayout();
    $("#reportName").value = model.name || "";
    $("#hostBadge").textContent = host ? "Desktop bridge active" : "Web mode";
    const pageList=$("#pageList"),listedPages=model.pages.map((item,index)=>({item,index})).filter(entry=>showHiddenPagesWhileEditing()||entry.item.hidden!==true);
    pageList.innerHTML=pageButtonsHtml(listedPages);const pageBarList=$("#pageBarList");if(pageBarList)pageBarList.innerHTML=pageButtonsHtml(listedPages);requestAnimationFrame(updatePageBarOverflow);
    const currentSource=activeSource();activeSourceId=currentSource?.id||"main";$("#sourceList").innerHTML=model.sources.filter(source=>source.localTable?.private!==true||source.id===activeSourceId).map(source=>`<button class="source-item ${source.id===activeSourceId?"active":""}" data-source-id="${esc(source.id)}" title="Select ${esc(source.name)} · Double-click to view table"><span>${source.kind==="main"?"◆":source.kind==="gantt"?"▰":source.localTable?.listOwned?"☷":manualLocalSource(source)?"▦":"◇"}</span><b>${esc(source.name)}</b><small>${source.kind==="main"?"Main":source.kind==="gantt"?"Embedded Gantt":source.localTable?.listOwned?"Embedded List":fileLocalSource(source)?"Local · file":embeddedLocalSource(source)?"Local · embedded":"Global"}</small></button>`).join("");
    $("#activeSourceName").textContent=currentSource?.name||"Main source";renderSourceSummaryActions(currentSource); $("#queryConnection").textContent = query().connectionName || "Not set"; $("#measureCount").textContent = query().measures.length; $("#rowCount").textContent = `${query().data.rows.length}${query().totalRows > query().data.rows.length ? ` of ${query().totalRows}` : ""}`; $("#previewLimit").value = query().previewLimit;
    applyCanvasSizeControls();
    $("#pageBackgroundUseTheme").checked = !!page().background.useTheme||!!model.settings.theme?.requireColors; $("#pageBackgroundUseTheme").disabled=!!model.settings.theme?.requireColors;$("#pageBackground").disabled = !!page().background.useTheme||!!model.settings.theme?.requireColors;const pageRole=$("#pageBackgroundThemeRole"),slots=(model.settings.theme?.colors||[]).map((_,index)=>`<option value="color${index+1}">Theme color ${index+1}</option>`);pageRole.innerHTML=`<option value="surface">Surface</option>${slots.join("")}`;pageRole.value=page().background.themeRole||"surface";pageRole.closest("label").classList.toggle("hidden",!page().background.useTheme&&!model.settings.theme?.requireColors);
    $("#pageBackground").value = pageBackgroundColor(page()); $("#pageBackgroundImage").value = page().background.image; $("#pageBackgroundFit").value = page().background.fit;
    Object.assign($("#canvas").style, { backgroundColor: pageBackgroundColor(page()), backgroundImage: page().background.image ? `url("${page().background.image.replace(/["\\]/g, "")}")` : "", backgroundSize: page().background.image ? page().background.fit : "20px 20px", backgroundRepeat: page().background.image ? "no-repeat" : "repeat", backgroundPosition: "center" });
    renderFilters();
    renderCanvasObjects();
    updateAlignMenu();renderComponentMenu(); renderPropertyPanels();renderCanvasTheme(); syncJson();
  }
  function renamePageInline(index){const container=pageListPosition()!=="left"?$("#pageBarList"):$("#pageList"),button=container?.querySelector(`[data-page="${index}"]`),item=model.pages[index];if(!button||!item)return;const input=document.createElement("input");input.className="page-name-editor";input.value=item.name||`Page ${index+1}`;button.replaceWith(input);input.focus();input.select();let finished=false;const finish=save=>{if(finished)return;finished=true;const name=input.value.trim();if(save&&name&&name!==item.name){item.name=name;markDirty();}render();};input.addEventListener("keydown",event=>{if(event.key==="Enter")finish(true);if(event.key==="Escape")finish(false);});input.addEventListener("blur",()=>finish(true),{once:true});}
  function movePage(index,target){if(index<0||index>=model.pages.length)return;const destination=target==="top"?0:target==="up"?Math.max(0,index-1):target==="down"?Math.min(model.pages.length-1,index+1):model.pages.length-1;if(destination===index)return;const[item]=model.pages.splice(index,1);model.pages.splice(destination,0,item);pageIndex=destination;selectedId=null;selectedIds.clear();markDirty();render();}
