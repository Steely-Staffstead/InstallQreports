    options.addEventListener("change",event=>{const input=event.target.closest('[data-vf="binding"]');if(!input)return;const separator=input.value.indexOf(":"),scope=input.value.slice(0,separator),filterId=input.value.slice(separator+1);draft.filterRef={scope,filterId};draw();});options.addEventListener("click",event=>{if(event.target.closest("[data-vf-add-page-filter]")){const source=sourceParts().source||sourceById(tile.sourceId||"main")||sourceById("main"),filter={id:uid(),sourceId:source?.id||"main",column:source?.query?.data?.columns?.[0]||"",mode:"ButtonsSingle",operator:"equals",value:"",value2:"",basicValues:[],enabled:true};page().filters.push(filter);addedFilters.push(filter);bindings.push({scope:"page",filter,owner:page(),label:`Page · ${filter.column||"New filter"}`});draft.filterRef={scope:"page",filterId:filter.id};draw();return;}if(event.target.closest("[data-vf-value-add]")){draft.values.push({id:uid(),field:"__count__",aggregation:"Count",caption:"",format:"N0",align:"right",renderer:{type:"Number"}});draw();return;}const row=event.target.closest("[data-vf-value-index]"),index=row?+row.dataset.vfValueIndex:-1;if(index>=0&&event.target.closest("[data-vf-value-remove]")){draft.values.splice(index,1);draw();return;}const direction=+event.target.closest("[data-vf-value-move]")?.dataset.vfValueMove;if(index>=0&&direction&&draft.values[index+direction]){[draft.values[index],draft.values[index+direction]]=[draft.values[index+direction],draft.values[index]];draw();return;}if(event.target.closest("[data-visual-filter-choice],[data-visual-filter-clear]")){event.preventDefault();event.stopPropagation();}});
    dialog.querySelector(".visual-filter-designer-preview").addEventListener("click",event=>{const jump=event.target.closest("[data-vf-preview-jump]")?.dataset.vfPreviewJump,hit=event.target.closest("[data-vf-preview-target]"),choice=event.target.closest(".visual-filter-choice");let target,owner;if(jump==="layout")target=options.querySelector('[data-vf="layout"]');else if(jump==="card-content")target=options.querySelector('[data-vf="heading"]');else if(jump==="values")target=options.querySelector('[data-vf-value-index] [data-vf-value="field"],[data-vf-value-add]');else if(jump==="appearance")target=options.querySelector('[data-vf="useTheme"]');else if(hit){const kind=hit.dataset.vfPreviewTarget,index=hit.dataset.vfPreviewValueIndex;target=kind==="heading"?options.querySelector('[data-vf="heading"]'):kind==="supporting"?options.querySelector('[data-vf="supportingText"]'):options.querySelector(`[data-vf-value-index="${index}"] [data-vf-value="${kind==="caption"?"caption":"field"}"]`);owner=target?.closest(".multi-card-value-row,label")||target;}else if(choice)target=options.querySelector('[data-vf="useTheme"]');if(!target)return;event.preventDefault();event.stopPropagation();focusDesignerControl(target,owner||target.closest?.("label,.multi-card-value-row")||target);});
