    if(sourceSummary&&!$("#sourceSummaryActions")){sourceSummary.querySelector("dl")?.insertAdjacentHTML("afterend",'<div id="sourceSummaryActions" class="source-summary-actions" aria-label="Selected source actions"><button type="button" class="primary source-action-wide" data-action="viewSourceData" title="Open this source as a table"><span aria-hidden="true">▦</span> View table</button><button type="button" data-action="editQuery" data-source-query-action title="Edit this source query"><span aria-hidden="true">⌁</span> Query</button><button type="button" data-action="editMeasures" data-source-measure-action title="Edit measures for this source"><span aria-hidden="true">ƒx</span> Edit</button><button type="button" data-source-card-action="open-gantt" data-source-gantt-action class="hidden" title="Open the Gantt tile that publishes this source"><span aria-hidden="true">▰</span> Gantt</button><button type="button" data-action="manageRelationships" title="Edit relationships between sources"><span aria-hidden="true">↗</span> Links</button><button type="button" data-action="renameSource" title="Rename this source"><span aria-hidden="true">✎</span> Rename</button><button type="button" class="danger source-action-wide" data-source-destructive title="Delete or reset this source"><span aria-hidden="true">×</span> <span data-source-destructive-label>Delete source</span></button></div>');}
    if(!$("#tileSource")){const field=$("#tileField")?.closest("label");field?.insertAdjacentHTML("beforebegin",'<label id="tileSourceLabel">Data source<select id="tileSource"></select></label>');$("#tileSource")?.addEventListener("change",event=>{const tile=selectedTile();if(!tile)return;tile.sourceId=event.target.value;if(tile.kind==="list"&&tile.list)tile.list.storage=tile.sourceId===tile.list.ownedSourceId?"embedded":"linked";if(tile.design)delete tile.design.data;activeSourceId=tile.sourceId;markDirty();render();});}
