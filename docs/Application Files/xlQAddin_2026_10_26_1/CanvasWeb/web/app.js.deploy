    if(leftHeading?.classList.contains("section-heading")){leftHeading.classList.add("page-section-heading");const add=leftHeading.querySelector('[data-action="addPage"]');if(add&&!leftHeading.querySelector('[data-action="importPage"]'))add.insertAdjacentHTML("beforebegin",'<button type="button" class="icon-button page-import-button" data-action="importPage" title="Import pages from another Qanvas project" aria-label="Import pages from another Qanvas project">⇩</button>');}
