    const themeRoleNames=()=>[...new Set([...Object.keys(CanvasTheme.defaults),...(model.settings.theme?.colors||[]).map((_,index)=>`color${index+1}`)])],themeRoleOptions=selected=>themeRoleNames().map(name=>`<option value="${esc(name)}" ${name===selected?"selected":""}>${/^color\d+$/.test(name)?`Palette ${name.slice(5)}`:esc(name.replace(/([A-Z])/g," $1"))}</option>`).join(""),columnWidths=()=>{draft.metricColumnWidths=multiCardColumnWidths(draft);return`<div class="multi-card-column-widths"><strong>Value column widths</strong>${draft.metricColumnWidths.map((item,index)=>`<label class="multi-card-column-width-row"><b>Column ${index+1}</b><select data-vf-column-mode data-vf-column-index="${index}"><option value="auto" ${item.mode==="auto"?"selected":""}>Auto / remaining</option><option value="percent" ${item.mode==="percent"?"selected":""}>Percent</option><option value="fixed" ${item.mode==="fixed"?"selected":""}>Fixed</option></select><input type="number" data-vf-column-value data-vf-column-index="${index}" min="${item.mode==="fixed"?40:1}" max="${item.mode==="fixed"?1200:100}" value="${item.value}" ${item.mode==="auto"?"disabled":""}><span>${item.mode==="fixed"?"px":item.mode==="percent"?"%":""}</span></label>`).join("")}<small>Use Auto, relative percent, or fixed pixel widths inside each clickable card.</small></div>`;};
    const draw=()=>{const opened=new Set([...options.querySelectorAll("[data-vf-value-index] details[open]")].map(detail=>{const index=+detail.closest("[data-vf-value-index]").dataset.vfValueIndex,metric=draft.values[index];return`${metric?.id}:${detail.className}`;})),binding=bindingForDraft(),columns=binding?.source?.query?.data?.columns||[],sourceOptions=(binding?.scope==="page"?model.sources:[binding?.source].filter(Boolean)).map(source=>`<option value="${esc(source.id)}" ${source.id===binding?.source?.id?"selected":""}>${esc(source.name||source.id)}</option>`).join(""),appearanceDisabled=draft.useTheme!==false?"disabled":"";options.innerHTML=`<h3>Filter binding</h3><div class="visual-filter-binding-row"><label>Page or linked tile filter<select data-vf="binding">${bindingOptions()}</select></label><button type="button" data-vf-add-page-filter>+ New page filter</button></div><label>Filter source<select data-vf="filterSourceId" ${binding?.scope==="page"?"":"disabled"}>${sourceOptions}</select></label><small>Choose any page or linked tile filter. Page filters can change source here; related-source measures remain available through source relationships.</small><label>Filter column<select data-vf="dimension">${columns.map(field=>`<option value="${esc(field)}" ${field===binding?.filter?.column?"selected":""}>${esc(field)}</option>`).join("")}</select></label><h3>Layout</h3><div class="field-grid"><label>Display<select data-vf="layout">${[["buttons","Button group"],["cards","Cards"],["multiCard","Multi-card"],["dropdown","Dropdown"]].map(([value,label])=>`<option value="${value}" ${draft.layout===value?"selected":""}>${label}</option>`).join("")}</select></label><label>Selection<select data-vf="selectionMode">${[["auto","Follow filter type"],["single","Single"],["multiple","Multiple"]].map(([value,label])=>`<option value="${value}" ${draft.selectionMode===value?"selected":""}>${label}</option>`).join("")}</select></label><label>Cards per row<input data-vf="columns" type="number" min="1" max="12" value="${+draft.columns||5}"></label><label>Values per card row<select data-vf="metricColumns">${[1,2,3,4,5,6].map(value=>`<option value="${value}" ${+draft.metricColumns===value?"selected":""}>${value}</option>`).join("")}</select></label><label>Maximum items<input data-vf="maximumItems" type="number" min="1" max="500" value="${+draft.maximumItems||100}"></label><label>Sort<select data-vf="sort"><option value="source" ${draft.sort==="source"?"selected":""}>Source order</option><option value="ascending" ${draft.sort==="ascending"?"selected":""}>Ascending</option><option value="descending" ${draft.sort==="descending"?"selected":""}>Descending</option></select></label></div>${columnWidths()}<label class="check"><input data-vf="showAll" type="checkbox" ${draft.showAll!==false?"checked":""}> Show All / Clear</label><label>All label<input data-vf="allLabel" data-vf-token value="${esc(draft.allLabel||"All")}"></label><label class="check"><input data-vf="showAllValues" type="checkbox" ${draft.showAllValues!==false?"checked":""}> Show count and values in All</label><h3>Card content</h3><label>Heading<input data-vf="heading" data-vf-token value="${esc(draft.heading||"{{value}}")}" placeholder="{{value}}"></label><label>Supporting text<input data-vf="supportingText" data-vf-token value="${esc(draft.supportingText||"")}" placeholder="{{count}} items"></label><label>Image field<select data-vf="imageField">${fieldOptions(draft.imageField)}</select></label><h3>Values</h3><div class="multi-card-values-well visual-filter-values-well">${draft.values.map(valueRow).join("")||'<p class="property-empty">Add a count, field, or measure.</p>'}</div><button type="button" data-vf-value-add>+ Add value</button><h3>Appearance</h3><label class="check"><input data-vf="useTheme" type="checkbox" ${draft.useTheme!==false?"checked":""}> Follow canvas theme</label><div class="field-grid"><label>Selection highlight<select data-vf="selectionStyle"><option value="fill" ${draf