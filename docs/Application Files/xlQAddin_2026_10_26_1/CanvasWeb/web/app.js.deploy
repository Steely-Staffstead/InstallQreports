    options.addEventListener("click",event=>{const step=event.target.closest("[data-matrix-value-step]"),edit=event.target.closest("[data-edit-selected-value]");if(!step&&!edit)return;event.preventDefault();event.stopImmediatePropagation();if(edit){selectMatrixValue(selectedValue,{edit:true});return;}const index=state.values.findIndex(value=>value.field===selectedValue),next=state.values[index+Number(step.dataset.matrixValueStep)];if(next)selectMatrixValue(next.field);},true);
    function bind(selected){options.onclick=event=>{const area=event.target.closest("[data-matrix-area]");if(area){selectedStyleArea=area.dataset.matrixArea;draw();return;}const rowChip=event.target.closest("[data-select-row]");if(rowChip?.dataset.selectRow&&!event.target.closest("button")){selectedRow=rowChip.dataset.selectRow;draw();return;}const valueChip=event.target.closest("[data-select-value]");if(valueChip&&!event.target.closest("button,select")){selectedValue=valueChip.dataset.selectValue;draw();return;}for(const type of ["row","column","value"]){const value=event.target.dataset[`remove${type[0].toUpperCase()+type.slice(1)}`];if(value!=null){const removed=state[type==="value"?"values":`${type}s`].splice(+value,1)[0];if(type==="row"){delete state.rowOptions[removed];selectedRow=state.rows[0]||"";}if(type==="value")reconcileValueGroups();selectedValue=state.values[0]?.field;draw();return;}}};options.onchange=event=>{if(event.target.matches("[data-matrix-inherit]")){state.areaStyles||={};state.areaStyles[selectedStyleArea]||={};if(event.target.checked){delete state.areaStyles[selectedStyleArea].background;delete state.areaStyles[selectedStyleArea].textColor;state.areaStyles[selectedStyleArea].inheritTheme=true;}else{delete state.areaStyles[selectedStyleArea].inheritTheme;state.areaStyles[selectedStyleArea].background=options.querySelector('[data-matrix-style="background"]').value;state.areaStyles[selectedStyleArea].textColor=options.querySelector('[data-matrix-style="textColor"]').value;}draw();return;}if(event.target.matches("[data-matrix-control-mode]")){state.groupControlMode=event.target.value;refreshPreview();return;}if(event.target.matches("[data-matrix-control-placement]")){state.groupControlPlacement=event.target.value;refreshPreview();return;}const controlStyleKey=event.target.dataset.matrixControlStyle;if(controlStyleKey){state.groupControlStyle||={};state.groupControlStyle[controlStyleKey]=event.target.type==="checkbox"?event.target.checked:event.ta