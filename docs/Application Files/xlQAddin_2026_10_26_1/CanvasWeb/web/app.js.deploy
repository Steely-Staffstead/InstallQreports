      options.innerHTML=`${valueNavigation}${fieldWells}${valuesHtml}${selectedHtml}${matrixStylingHtml()}${matrixSettingsHtml()}${subtotalsHtml}${sortDesignerHtml(state.sorts,[...state.rows,...state.values.map(value=>value.field)],sortFieldLabel)}${matrixAdvancedJsonHtml()}`;
      enhanceStyleToolbar(options.querySelector(".matrix-visual-styling"),"matrix-style",selectedStyleArea.replace("."," · "),{alignValue:styleForArea(selectedStyleArea).alignment||"left",before:options.querySelector(".matrix-style-map")});
