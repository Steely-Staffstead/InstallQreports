    options.addEventListener('change',event=>{const key=event.target.dataset.matrixThemeRole;if(!key)return;state.areaStyles||={};const style=state.areaStyles[selectedStyleArea]||={};style.inheritTheme=true;if(event.target.value)style[key]=event.target.value;else delete style[key];delete style.background;delete style.textColor;event.stopImmediatePropagation();draw();},true);
    options.addEventListener("click",event=>{
      if(event.target.matches("[data-add-value-group]")){
        state.valueGroups||=[];
        if(!state.valueGroups.length)state.valueGroups.push({caption:"Group 1",span:state.values.length});
        else{
          const donor=[...state.valueGroups].reverse().find(group=>Number(group.span)>1);
          if(!donor)return;
          donor.span=Number(donor.span)-1;
          state.valueGroups.push({caption:`Group ${state.valueGroups.length+1}`,span:1});
        }
        valueGroupsOpen=true;draw();return;
      }
      if(event.target.matches("[data-reset-value-groups]")){
        state.valueGroups=state.values.length?[{caption:state.valueGroups?.[0]?.caption||"Group 1",span:state.values.length}]:[];
        valueGroupsOpen=true;draw();return;
      }
      if(event.target.matches("[data-remove-value-group]")){
        const index=Number(event.target.dataset.removeValueGroup),groups=state.valueGroups||[];
        const [removed]=groups.splice(index,1);
        if(groups.length&&removed)groups[Math.min(index,groups.length-1)].span=Number(groups[Math.min(index,groups.length-1)].span||0)+Number(removed.span||0);
        valueGroupsOpen=true;draw();return;
      }
      if(event.target.matches("[data-apply-matrix-json]")){
        try{
          const parsed=JSON.parse(options.querySelector("[data-matrix-json]").value);
          if(!parsed||typeof parsed!=="object"||Array.isArray(parsed)||!["rows","columns","values"].every(key=>Array.isArray(parsed[key])))throw new Error("Matrix JSON needs rows, columns and values arrays.");
          if(Object.keys(parsed).some(key=>["__proto__","constructor","prototype"].includes(key)))throw new Error("Matrix JSON contains an invalid property name.");
          if(!parsed.rows.every(field=>typeof field==="string")||!parsed.columns.every(field=>typeof field==="string")||!parsed.values.every(value=>value&&typeof value==="object"&&!Array.isArray(value)&&typeof value.field==="string"))throw new Error("Rows and columns must contain field names; values must contain objects with a field name.");
          for(const key of Object.keys(state))delete state[key];
          Object.assign(state,parsed);
          state.rowCaptions||={};state.rowOptions||={};state.sorts||=[];
          selectedRow=state.rows[0]||"";selectedValue=state.values[0]?.field;
          advancedJsonOpen=true;draw();
          if(state.valueGroups?.length)options.querySelector(".matrix-value-group-editor").open=true;
        }catch(error){options.querySelector("[data-matrix-json-error]").textContent=error.message;}
      }
    });
    options.addEventListener("input",event=>{
      if(!event.target.matches("[data-value-group-caption]"))return;
      const group=state.valueGroups?.[Number(event.target.dataset.valueGroupCaption)];
      if(group){group.caption=event.target.value;refreshPreview();}
    });
    options.addEventListener("change",event=>{
      if(!event.target.matches("[data-value-group-span]"))return;
      const group=state.valueGroups?.[Number(event.target.dataset.valueGroupSpan)];
      if(group){group.span=Math.max(1,Math.min(state.values.length,Math.floor(Number(event.target.value)||1)));valueGroupsOpen=true;draw();}
    });
    options.addEventListener("change",event=>{if(!event.target.matches("[data-selected-row]"))return;const keepOpen=event.target.closest("details")?.open;requestAnimationFrame(()=>{const panel=options.querySelector(".matrix-subtotal-options");if(panel&&keepOpen)panel.open=true;});},true);
    const conditionalObserver=new MutationObserver(()=>{if(options.querySelector('.matrix-conditional-options'))return;const selected=state.values.find(value=>value.field===selectedValue)||state.values[0],section=options.querySelector('.matrix-selected-value-body');if(!selected||!section)return;section.insertAdjacentHTML('beforeend',matrixConditionalPropertiesHtml(selected,allFields));bindMatrixConditionalProperties(section,selected,refreshPreview);});
    conditionalObserver.observe(options,{childList:true});
    const paletteChanged=()=>{if(overlay.isConnected)draw();else window.removeEventListener('canvas-palette-changed',paletteChanged);};window.addEventListener('canvas-palette-changed',paletteChanged);
    overlay.querySelector("[data-apply-designer]").onclick=()=>{const repair=reconcileValueGroups();if(!repair.ok){valueGroupsMessage="";valueGroupsOpen=true;matrixSettingsOpen=true;draw();const warning=options.querySelector('.matrix-value-group-warning');if(warning){warning.textContent=repair.message;warning.scrollIntoView({block:'nearest'});}return;}normalizeSorts();const design={...(t.design||{}),matrixSpec:state};delete design.data;t.design=design;t.sorts=structuredClone(state.sorts);markDirty();conditionalObserver.disconnect();window.removeEventListener('canvas-palette-changed',paletteChanged);overlay.remove();render();if(repair.message)$("#saveStatus").textContent=`Grouped headers adjusted automatically · ${repair.message}`;};draw();
  }
  const layoutTileChoices=[["card","Value","42"],["multiCard","Multi-card","▦"],["text","Text tile","T"],["graphicText","Text graphic","¶"],["graphicTextBox","Text box","▣"],["picture","Picture","▧"],["chart","Chart","▥"],["table","Table","▤"],["list","List","☷"],["matrix","Matrix","▦"],["reportGrid","Grid","⊞"],["valueSelector","Selector","↔"],["svgGraphic","SVG graphic","◇"],["pageLink","Action","↗"]];
  function layoutTileChoicesHtml(){return layoutTileChoices.filter(([kind])=>tileDefaults[kind]||kind==="graphicTextBox").map(([kind,label,icon])=>`<button type="button" data-layout-kind="${kind}"><b aria-hidden="true">${icon}</b><span>${label}</span></button>`).join("");}
  function showLayoutTileMenu(event,slot){document.querySelector(".tile-context-menu")?.remove();const menu=document.createElement("div");menu.className="tile-context-menu layout-tile-menu";menu.innerHTML=`<div class="page-layout-title">Choose tile</div>${layoutTileChoicesHtml()}`;document.body.append(menu);menu.style.left=`${Math.max(8,Math.min(event.clientX,innerWidth-menu.offsetWidth-8))}px`;menu.style.top=`${Math.max(8,Math.min(event.clientY,innerHeight-menu.offsetHeight-8))}px`;menu.addEventListener("click",click=>{const kind=click.target.closest("[data-layout-kind]")?.dataset.layoutKind;if(!kind)return;menu.remove();addTile(kind,slot);});}
  function applyListPreset(tile,preset){const source=sourceById(tile.list?.ownedSourceId||tile.sourceId),created=window.CanvasListTile.createPreset(preset);if(!source)return;tile.list={...created.spec,ownedSourceId:source.id,datasourceName:preset==="task"?"Tasks":"List items"};tile.title=preset==="task"?"Tasks":"List";source.name=tile.list.datasourceName;source.localTable={storage:"embedded",format:"jsonl",ownerTileId:tile.id,listOwned:true,private:false,listSchema:structuredClone(tile.list.fields)};source.query||=blankQuery();source.query.data=created.data;source.query.totalRows=0;source.query.previewLimit=0;tile.sourceId=source.id;markDirty();render();}
  function openListPresetDialog(tile){if(!tile||tile.kind!=="list")return;document.querySelector(".list-preset-dialog")?.remove();const dialog=document.createElement("dialog");dialog.className="list-preset-dialog";dialog.innerHTML=`<form method="dialog"><header><div><h2>New List</h2><p>Choose a starting schema. Every field can be changed later.</p></div><button value="cancel" aria-label="Close">×</button></header><div class="list-preset-options"><label><input type="radio" name="listPreset" value="basic" checked><b>Basic</b><small>Item plus managed ID, line number, created and updated timestamps.</small></label><label><input type="radio" name="listPreset" value="task"><b>Task</b><small>Title, description, status, priority, owner, due/completed dates and managed metadata.</small></label></div><div class="dialog-actions"><button value="cancel">Keep Basic</button><button value="apply" class="primary">Create list</button></div></form>`;document.body.append(dialog);dialog.addEventListener("close",()=>{if(dialog.returnValue==="apply")applyListPreset(tile,dialog.querySelector('[name="listPreset"]:checked')?.value||"basic");dialog.remove();if(selectedTile()?.id===tile.id)requestAnimationFrame(()=>openListDesigner(tile));},{once:true});dialog.showModal();}
  function addTile(kind,slot=null) { const boxed=kind==="graphicTextBox";if(boxed)kind="graphicText";const chartPage=kind==="chartPage";if(chartPage){kind="chart";page().canvas.mode="preset";page().canvas.preset="800x300";page().canvas.width=800;page().canvas.height=300;}const d = tileDefaults[kind];if(!d)return null; const offset = chartPage?0:allObjects(page()).length * 20,roles=CanvasTheme.roles(model.settings.theme); const t = { id: uid(), kind, sourceId:activeSourceId||"main", ...structuredClone(d), x: slot?.x??(chartPage?10:30 + offset), y: slot?.y??(chartPage?10:30 + offset), width:slot?.width??(chartPage?780:d.width), height:slot?.height??(chartPage?280:d.height), showHeader:!["line","rectangle","connector","graphicText","svgGraphic","pageLink","valueSelector"].includes(kind), background:roles.surface, borderColor:roles.grid, layer:slot?.layer??Math.max(-1,...allObjects(page()).map(item=>Number(item.layer)||0))+1 };if(kind==="list"){const created=window.CanvasListTile.createPreset("basic"),base="List items";let name=base,suffix=2;while(model.sources.some(source=>String(source.name).toLowerCase()===name.toLowerCase()))name=`${base} ${suffix++}`;const source=blankSource(`list:${t.id}`,name,"local");t.list={...created.spec,ownedSourceId:source.id,datasourceName:name};t.sourceId=source.id;source.localTable={storage:"embedded",format:"jsonl",ownerTileId:t.id,listOwned:true,listSchema:structuredClone(t.list.fields)};source.query.data=created.data;source.query.totalRows=0;source.query.previewLimit=0;model.sources.push(source);} if(boxed){t.boxed=true;t.title=duplicateName({title:"Text box"}).title;t.borderColor=roles.grid;t.borderThickness=1;t.transparentBackground=false;t.boxShape="rectangle";}if(kind==="svgGraphic")t.svgGraphic=CanvasSvgGraphic.defaults();if(kind==="multiCard"){const source=sourceById(t.sourceId),columns=source?.query?.data?.columns||[],measureNames=(source?.query?.measures||[]).map(sourceMeasureName).filter(Boolean),spec=t.design.multiCardSpec;s