    const ensureEmbeddedData=()=>{if(!embeddedData)embeddedData=sourceData.columns?.length?structuredClone(sourceData):standaloneData();embeddedData.columns||=[];embeddedData.rows||=[];for(const [name,initial] of [["Project / Group",""],["Milestone",false],["Status",draft.defaultStatus||"Open"],["Priority",draft.defaultPriority||"Normal"],["Description",""]])if(!embeddedData.columns.some(column=>String(column).toLowerCase()===name.toLowerCase())){embeddedData.columns.push(name);embeddedData.rows.forEach(row=>row.push(initial));}Object.assign(draft,window.CanvasGantt.autoConfigure(draft,embeddedData.columns));return embeddedData;};
