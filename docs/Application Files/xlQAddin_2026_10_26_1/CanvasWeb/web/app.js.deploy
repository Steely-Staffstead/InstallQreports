      const list=ensureBindings(false),marker=draft.dataBindings.dateMarker,textFields=analysis.textFields||[],paintFields=analysis.paintFields||[],manual=draft.template==="manual";
      options.innerHTML=`<datalist id="svgDesignerFontFamilies"><option value="Segoe UI"><option value="Arial"><option value="Calibri"><option value="Georgia"><option value="Verdana"></datalist><details class="svg-designer-templates" data-svg-section="templates" ${ui.templatesOpen?"open":""}><summary>Templates <small>${templateLabel(draft.template)}</small></summary><div>${CanvasSvgGraphic.templates.map(value=>`<button type="button" data-svg-designer-template="${value}" class="${value===draft.template?"active":""}">${value==="manual"?"</>":"◇"}<span>${templateLabel(value)}</span></button>`).join("")}</div></details><section class="svg-designer-custom ${manual?"":"hidden"}"><details data-svg-section="source" ${ui.sourceOpen?"open":""}><summary>SVG source <small>Advanced</small></summary><div class="svg-designer-section-heading"><small>Paste one safe, standalone SVG and analyze it.</small><button type="button" data-svg-analyze>Analyze SVG</button></div><textarea data-svg-designer-code spellcheck="false" rows="10">${esc(draft.svgCode||"")}</textarea></details><details data-svg-section="components" ${ui.componentsOpen?"open":""}><summary>Text components <small>${textFields.length}</small></summary><div class="svg-component-summary"><span>${textFields.length} text</span><span>${paintFields.length} shapes</span><span>${analysis.dateMarker?"Date axis found":"No date axis"}</span></div><p class="svg-designer-help">Edit text and formatting here. The category checkbox has one purpose only: it makes that text a replaceable slot for the category list.</p><div class="svg-component-editors">${textFields.map(textComponent).join("")||'<p class="property-empty">No editable text elements detected.</p>'}</div></details><details data-svg-section="shapes" ${ui.shapesOpen?"open":""}><summary>Colors and borders <small>${paintFields.length}</small></summary><div class="svg-component-editors">${paintFields.map(paintComponent).join("")||'<p class="property-empty">Name a shape with data-qanva