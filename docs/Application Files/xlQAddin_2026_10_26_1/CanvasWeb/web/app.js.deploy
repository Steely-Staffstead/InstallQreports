    const fieldRows=()=>tile.list.fields.map((item,index)=>{const lookupSource=sourceById(item.lookup?.sourceId),lookupColumns=lookupSource?.query?.data?.columns||[],sourceOptions=model.sources.filter(source=>source.id!==tile.list.ownedSourceId&&source.localTable?.private!==true).map(source=>`<option value="${esc(source.id)}" ${source.id===item.lookup?.sourceId?"selected":""}>${esc(source.name||source.id)}</option>`).join(""),managed=window.CanvasListTile.systemFields.has(item.field),linkedLocked=tile.list.storage==="linked"&&!(tile.list.allowLinkedEditing===true&&current()?.localTable?.storage==="embedded"),schemaLocked=managed||linkedLocked,expanded=expandedListFields.has(item.field);return`<div class="list-designer-field${expanded?" is-expanded":""}" data-list-designer-field="${index}" data-reorder-index="${index}"><span class="designer-drag-handle list-field-drag" draggable="true" data-reorder-zone="list-fields" data-reorder-index="${index}" title="Drag to reorder" aria-label="Drag field to reorder">☷</span><input data-list-field-setting="label" value="${esc(item.label||item.field)}" aria-label="Field label"><select data-list-field-setting="type" ${schemaLocked?"disabled":""}>${fieldTypes.map(([value,label])=>`<option value="${value}" ${item.type===value?"selected":""}>${label}</option>`).join("")}</select><span class="list-field-actions"><button type="button" data-list-field-move="-1" data-list-field-index="${index}" title="Move field up" ${index===0?"disabled":""}>↑</button><button type="button" data-list-field-move="1" data-list-field-index="${index}" title="Move field down" ${index===tile.list.fields.length-1?"disabled":""}>↓</button><button type="button" data-list-field-remove="${index}" ${managed||tile.list.storage==="linked"?"disabled title=\"Source field\"":"title=\"Delete field\""}>×</button></span><small><code>${esc(item.field)}</code>${managed?" · managed":linkedLocked?" · source locked":item.readOnly?" · read only":""}</small><div class="list-field-flags"><label class="check"><input type="checkbox" data-list-field-setting="required" ${item.required?"checked":""} ${item.readOnly||schemaLocked?"disabled":""}> Required</label><label class="check"><input type="checkbox" data-list-field-setting="readOnly" ${item.readOnly?"checked":""} ${schemaLocked?"disabled":""}> Read only</label><label class="check"><input type="checkbox" data-list-field-setting="hidden" ${item.hidden?"checked":""}> Hidden</label></div><button type="button" class="list-field-more-toggle" data-list-field-toggle="${index}" aria-expanded="${expanded}"><span>${expanded?"Less":"More"}</span><span aria-hidden="true">${expanded?"▴":"▾"}</span></button><label class="list-field-width">Width<select data-list-field-setting="widthMode"><option value="auto" ${item.width?.mode==="auto"?"selected":""}>Auto</option><option value="percent" ${item.width?.mode==="percent"?"selected":""}>Percent</option><option value="px" ${item.width?.mode==="px"?"selected":""}>Pixels</option></select></label><input class="list-field-width-value" type="number" data-list-field-setting="widthValue" min="1" max="800" value="${+item.width?.value||120}" ${item.width?.mode==="auto"?"disabled":""} aria-label="Width value">${defaultEditor(item)}${item.type==="choice"?`<label class="list-field-options">Choices <input data-list-field-setting="choicesText" value="${esc((item.choices||[]).map(choice=>choice.code===choice.label?choice.code:`${choice.code}=${choice.label}`).join(", "))}" placeholder="open=Open, done=Completed"></label>`:""}${item.type==="lookup"?`<div class="list-field-lookup"><label>Lookup source<select data-list-field-setting="lookupSourceId"><option value="">Choose source…</option>${sourceOptions}</select></label><label>Stored value<select data-list-field-setting="lookupValueField"><option value="">Choose field…</option>${lookupColumns.map(name=>`<option value="${esc(name)}" ${name===item.lookup?.valueField?"selected":""}>${esc(name)}</option>`).join("")}</select></label><label>Displayed text<select data-list-field-setting="lookupLabelField"><option value="">Same as value</option>${lookupColumns.map(name=>`<option value="${esc(name)}" ${name===item.lookup?.labelField?"selected":""}>${esc(name)}</option>`).join("")}</select></label></div>`:""}${formFieldEditor(item)}</div>`;}).join("");
    const draw=()=>{const source=current(),embedded=tile.list.storage!=="linked",linkedEditable=!embedded&&source?.localTable?.storage==="embedded",available=model.sources.filter(item=>item.id!==tile.list.ownedSourceId&&item.localTable?.private!==true),form=tile.list.form||{},formWidths=Array.from({length:Math.max(1,+form.columns||2)},(_,index)=>{const width=form.columnWidths?.[index]||{mode:"auto"};return`<label>Column ${index+1}<select data-list-form-width="${index}"><option value="auto" ${width.mode==="auto"?"selected":""}>Auto</option><option value="percent" ${width.mode==="percent"?"selected":""}>Percent</option><option value="px" ${width.mode==="px"?"selected":""}>Pixels</option></select><input type="number" min="1" max="800" data-list-form-width-value="${index}" value="${+width.value||25}" ${width.mode==="auto"?"disabled":""}></label>`;}).join("");options.innerHTML=`<details open data-designer-group-label="Data"><summary>Data</summary><label>Mode<select data-list-setting="storage"><option value="embedded" ${embedded?"selected":""}>Embedded editable list</option><option value="linked" ${!embedded?"selected":""}>Linked source</option></select></label><label class="${embedded?"hidden":""}">Linked source<select data-list-setting="linkedSource">${available.map(item=>`<option value="${esc(item.id)}" ${item.id===tile.sourceId?"selected":""}>${esc(item.name)}</option>`).join("")}</select></label><label class="check ${embedded?"":"hidden"}"><input type="checkbox" data-list-setting="exposeAsDatasource" ${tile.list.exposeAsDatasource!==false?"checked":""}> Expose as datasource</label><label class="${embedded?"":"hidden"}">Datasource name<input data-list-setting="datasourceName" value="${esc(tile.list.datasourceName||source?.name||"List items")}"></label>${!embedded?`<label class="check"><input type="checkbox" data-list-setting="allowLinkedEditing" ${tile.list.allowLinkedEditing?"checked":""} ${linkedEditable?"":"disabled"}> Edit the shared embedded source</label>`:""}<small>${embedded?"Rows are stored once in the embedded manual-table source owned by this tile.":linkedEditable?"This view can share and edit the same embedded rows as the source List. Tile and page filters limit which records are shown.":"This source has no safe embedded write contract, so the view is read-only."}</small></details><details open data-designer-group-label="Fields"><summary>Fields</summary><div class="list-designer-fields">${fieldRows()}</div><button type="button" data-list-field-add ${embedded?"":"disabled"}>＋ Add field</button></details><details data-designer-group-label="Layout"><summary>Layout</summary><label>View<select data-list-setting="viewMode"><option value="table" ${tile.list.viewMode!=="form"?"selected":""}>Table / list</option><option value="form" ${tile.list.viewMode==="form"?"selected":""}>Form · one record</option></select></label>${tile.list.viewMode==="form"?`<section class="list-form-settings"><div class="property-grid"><label>Columns<input type="number" min="1" max="6" data-list-setting="form.columns" value="${Math.max(1,+form.columns||2)}"></label><label>Column gap<input type="number" min="0" max="64" data-list-setting="form.columnGap" value="${Math.max(0,+form.columnGap||0)}"></label><label>Row gap<input type="number" min="0" max="64" data-list-setting="form.rowGap" value="${Math.max(0,+form.rowGap||0)}"></label><label>Labels<select data-list-setting="form.labelPosition"><option value="top" ${form.labelPosition!=="left"?"selected":""}>Above controls</option><option value="left" ${form.labelPosition==="left"?"selected":""}>Left of controls</option></select></label></div><label class="check"><input type="checkbox" data-list-setting="form.showNavigator" ${form.showNavigator!==false?"checked":""}> Show record navigation</label><label class="check"><input type="checkbox" data-list-setting="form.showRecordCount" ${form.showRecordCount!==false?"checked":""}> Show record count</label><label class="check"><input type="checkbox" data-list-setting="form.compact" ${form.compact?"checked":""}> Compact form spacing</label><div class="list-form-column-widths">${formWidths}</div></section>`:`<div class="property-grid"><label>Density<select data-list-setting="density"><option value="compact" ${tile.list.density!=="comfortable"?"selected":""}>Compact</option><option value="comfortable" ${tile.list.density==="comfortable"?"selected":""}>Comfortable</option></select></label><label>Row height<input type="number" min="26" max="96" data-list-setting="rowHeight" value="${+tile.list.rowHeight||32}"></label><label>Frozen columns<input type="number" min="0" max="6" data-list-setting="frozenColumns" value="${+tile.list.frozenColumns||0}"></label></div>`}</details><details data-designer-group-label="Appearance"><summary>Appearance</summary><label class="check"><input type="checkbox" data-list-setting="appearance.useTheme" ${tile.list.appearance?.useTheme!==false?"checked":""}> Use canvas theme</label><div class="property-grid"><label>Text role<select data-list-appearance="textRole">${roleOptions(tile.list.appearance?.textRole||"text")}</select></label><label>Surface role<select data-list-appearance="surfaceRole">${roleOptions(tile.list.appearance?.surfaceRole||"surface")}</select></label><label>Header role<select data-list-appearance="headerRole">${roleOptions(tile.list.appearance?.headerRole||"headerBackground")}</select></label><label>Grid role<select data-list-appearance="gridRole">${roleOptions(tile.list.appearance?.gridRole||"grid")}</select></label></div></details><details data-designer-group-label="Interaction"><summary>Interaction</summary><label class="check"><input type="checkbox" data-list-setting="allowPresentEditing" ${tile.list.allowPresentEditing?"checked":""} ${embedded||tile.list.allowLinkedEditing?"":"disabled"}> Allow editing in Present mode</label><label class="check"><input type="checkbox" data-list-setting="followSelection" ${tile.list.followSelection!==false?"checked":""}> Follow record selected in another view</label>${["add","duplicate","delete","move"].map(key=>`<label class="check"><input type="checkbox" data-list-permission="${key}" ${tile.list.permissions?.[key]!==false?"checked":""}> ${key[0].toUpperCase()+key.slice(1)} rows</label>`).join("")}</details>`;refreshPreview();};
    const commit=()=>{const source=current();if(tile.list.storage==="embedded")syncListSchema(tile,source);syncEmbeddedLocalSources(model);markDirty();refreshPreview();};
    const moveListField=(from,to)=>{const fields=tile.list.fields||[];from=Math.max(0,Math.min(fields.length-1,+from));to=Math.max(0,Math.min(fields.length-1,+to));if(from===to||!fields[from])return;const [field]=fields.splice(from,1);fields.splice(to,0,field);commit();redrawPreservingGroups();};
    const redrawPreservingGroups=()=>{const state=new Map([...options.querySelectorAll('details[data-designer-group-label]')].map(group=>[group.dataset.designerGroupLabel,group.open]));draw();state.forEach((open,name)=>{const group=[...options.querySelectorAll('details[data-designer-group-label]')].find(item=>item.dataset.designerGroupLabel===name);if(group)group.open=open;});};
    const formFieldByName=name=>(tile.list.fields||[]).find(item=>item.field===name);
    const updateFormLayout=(name,change)=>{const item=formFieldByName(name);if(!item)return;item.form||={column:0,columnSpan:1,rowSpan:1,renderer:"auto"};const columns=Math.max(1,Math.min(6,+tile.list.form?.columns||2)),visibleIndex=tile.list.fields.filter(field=>!field.hidden).findIndex(field=>field===item);if(!+item.form.column)item.form.column=(Math.max(0,visibleIndex)%columns)+1;change(item.form,item);item.form.column=Math.max(1,Math.min(columns,+item.form.column||1));item.form.columnSpan=Math.max(1,Math.min(columns-item.form.column+1,+item.form.columnSpan||1));item.form.rowSpan=Math.max(1,Math.min(8,+item.form.rowSpan||1));selectedFormField=name;commit();redrawPreservingGroups();};
    const moveFormField=(name,targetName)=>{const fields=tile.list.fields||[],from=fields.findIndex(item=>item.field===name),to=fields.findIndex(item=>item.field===targetName);if(from<0||to<0||from===to)return;const targetColumn=fields[to].form?.column||1,[item]=fields.splice(from,1);fields.splice(to,0,item);item.form||={};item.form.column=targetColumn;selectedFormField=name;commit();redrawPreservingGroups();};
    const showFieldDetails=(name,exclusive=false)=>{const item=formFieldByName(name);if(!item)return;if(exclusive)expandedListFields.clear();expandedListFields.add(name);options.querySelectorAll("[data-list-designer-field]").forEach((card,index)=>{const expanded=expandedListFields.has(tile.list.fields[index]?.field),toggle=card.querySelector("[data-list-field-toggle]");card.classList.toggle("is-expanded",expanded);if(toggle){toggle.setAttribute("aria-expanded",String(expanded));toggle.innerHTML=`<span>${expanded?"Less":"More"}</span><span aria-hidden="true">${expanded?"▴":"▾"}</span>`;}});};
    options.addEventListener("change",event=>{const setting=event.target.dataset.listSetting,appearance=event.target.dataset.listAppearance,row=event.target.closest("[data-list-designer-field]"),fieldSetting=event.target.dataset.listFieldSetting;if(["showToolbarTitle","showSearch"].includes(setting)){tile.list[setting]=event.target.checked;markDirty();redrawPreservingGroups();event.stopImmediatePropagation();return;}if(appearance){tile.list.appearance[appearance]=event.target.type==="checkbox"?event.target.checked:event.target.value;markDirty();["headerUseTheme","alternatingRows","alternateUseTheme","highlightSelectedRow","selectedRowUseTheme","urlHoverUseTheme","gridUseTheme","separatorUseTheme"].includes(appearance)?redrawPreservingGroups():refreshPreview();event.stopImmediatePropagation();return;}if(row&&fieldSetting==="type"){const item=tile.list.fields[+row.dataset.listDesignerField];item.defaultValue=null;expandedListFields.add(item.field);}if(row&&fieldSetting==="defaultValue"){const item=tile.list.fields[+row.dataset.listDesignerField],raw=event.target.value;item.defaultValue=raw===""?null:event.target.type==="number"?+raw:raw;commit();event.stopImmediatePropagation();}},true);
    const editDefaultLink=async target=>{const row=target.closest("[data-list-designer-field]"),item=row&&tile.list.fields[+row.dataset.listDesignerField];if(!item||item.type!=="url"||item.readOnly)return;const result=await openHyperlinkDialog({href:item.defaultValue||"",title:item.defaultLinkTitle||"",hideText:true});if(!result)return;item.defaultValue=result.href;item.defaultLinkTitle=result.title||"";markDirty();redrawPreservingGroups();commit();};
    options.addEventListener("click",async event=>{const link=event.target.closest("[data-list-default-link]"),add=event.target.closest("[data-list-field-add]"),remove=event.target.closest("[data-list-field-remove]"),toggle=event.target.closest("[data-list-field-toggle]");if(toggle){event.preventDefault();const item=tile.list.fields[+toggle.dataset.listFieldToggle];if(!item)return;if(expandedListFields.has(item.field))expandedListFields.delete(item.field);else expandedListFields.add(item.field);redrawPreservingGroups();return;}if(link){event.preventDefault();await editDefaultLink(link);return;}if(add){const existing=new Set(tile.list.fields.map(item=>item.field.toLowerCase()));let number=1,name="field_1";while(existing.has(name))name=`field_${++number}`;tile.list.fields.push({field:name,label:`Field ${number}`,type:"text",required:false,readOnly:false,hidden:false,multiline:false,width:{mode:"auto"},choices:[]});owned()?.query?.data?.rows?.forEach(row=>row.push(null));syncListSchema(tile,owned());commit();draw();return;}if(remove){const index=+remove.dataset.listFieldRemove,item=tile.list.fields[index];if(!item||window.CanvasListTile.systemFields.has(item.field)||tile.list.storage==="linked")return;expandedListFields.delete(item.field);tile.list.fields.splice(index,1);owned()?.query?.data?.rows?.forEach(row=>row.splice(index,1));syncListSchema(tile,owned());commit();draw();}});
    options.addEventListener("click",event=>{const move=event.target.closest("[data-list-field-move]");if(!move)return;event.preventDefault();moveListField(+move.dataset.listFieldIndex,+move.dataset.listFieldIndex+(+move.dataset.listFieldMove));});
    options.addEventListener("dragstart",event=>{const handle=event.target.closest("[data-reorder-zone=\"list-fields\"]");if(!handle)return;event.dataTransfer.effectAllowed="move";event.dataTransfer.setData("application/x-list-field",handle.dataset.reorderIndex);handle.closest(".list-designer-field")?.classList.add("dragging");});
    options.addEventListener("dragover",event=>{if(!event.dataTransfer.types.includes("application/x-list-field")||!event.target.closest(".list-designer-field"))return;event.preventDefault();event.dataTransfer.dropEffect="move";});
    options.addEventListener("drop",event=>{const raw=event.dataTransfer.getData("application/x-list-field"),target=event.target.closest(".list-designer-field");if(raw===""||!target)return;event.preventDefault();moveListField(+raw,+target.dataset.listDesignerField);});
    options.addEventListener("dragend",event=>event.target.closest(".list-designer-field")?.classList.remove("dragging"));
    options.addEventListener("contextmenu",event=>{const input=event.target.closest("[data-list-default-url]");if(!input)return;event.preventDefault();editDefaultLink(input);});
    options.addEventListener("change",event=>{
      const setting=event.target.dataset.listSetting,permission=event.target.dataset.listPermission,appearance=event.target.dataset.listAppearance,row=event.target.closest("[data-list-designer-field]"),fieldSetting=event.target.dataset.listFieldSetting,widthIndex=event.target.dataset.listFormWidth,widthValueIndex=event.target.dataset.listFormWidthValue;
      if(widthIndex!==undefined||widthValueIndex!==undefined){
        const index=+(widthIndex??widthValueIndex);tile.list.form||={};tile.list.form.columnWidths||=[];tile.list.form.columnWidths[index]||={mode:"auto"};
        if(widthIndex!==undefined)tile.list.form.columnWidths[index].mode=event.target.value;else tile.list.form.columnWidths[index].value=+event.target.value;
        redrawPreservingGroups();commit();return;
      }
      if(setting){
        const value=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?+event.target.value:event.target.value;
        if(setting==="storage"){
          if(value==="linked"){
            tile.list.embeddedFields=structuredClone(tile.list.fields);tile.list.storage="linked";tile.list.allowLinkedEditing=false;
            tile.sourceId=options.querySelector('[data-list-setting="linkedSource"]')?.value||model.sources.find(item=>item.id!==tile.list.ownedSourceId)?.id||tile.list.ownedSourceId;
            releaseUnusedOwnedSource();
          }else{
            const source=ensureOwnedSource();tile.list.storage="embedded";tile.list.allowLinkedEditing=false;tile.sourceId=source.id;
            tile.list.fields=structuredClone(tile.list.embeddedFields||source.localTable?.listSchema||window.CanvasListTile.fieldsFor(tile.list.preset));
          }
          window.CanvasListTile.normalize(tile,current());draw();commit();return;
        }
        if(setting==="linkedSource"){
          tile.sourceId=value;tile.list.allowLinkedEditing=false;tile.list.fields=[];window.CanvasListTile.normalize(tile,current());draw();commit();return;
        }
        if(setting==="datasourceName"){
          tile.list.datasourceName=value.trim()||"List items";if(owned())owned().name=tile.list.datasourceName;
        }else if(setting.startsWith("appearance.")){
          tile.list.appearance[setting.split(".")[1]]=value;
        }else if(setting.startsWith("form.")){
          tile.list.form||={};tile.list.form[setting.split(".")[1]]=value;
        }else tile.list[setting]=value;
        if(setting==="exposeAsDatasource"&&owned())owned().localTable.private=!value;
        if(["viewMode","allowLinkedEditing","form.columns"].includes(setting)){window.CanvasListTile.normalize(tile,current());redrawPreservingGroups();}
        commit();return;
      }
      if(permission){tile.list.permissions[permission]=event.target.checked;commit();return;}
      if(appearance){tile.list.appearance[appearance]=event.target.value;commit();return;}
      if(row&&fieldSetting){
        const item=tile.list.fields[+row.dataset.listDesignerField];if(!item)return;
        const value=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?+event.target.value:event.target.value;
        if(fieldSetting.startsWith("form.")){
          item.form||={};item.form[fieldSetting.split(".")[1]]=value;if(fieldSetting==="form.renderer")draw();
        }else if(fieldSetting==="widthMode"){
          item.width||={};item.width.mode=value;draw();
        }else if(fieldSetting==="widthValue"){
          item.width||={};item.width.value=value;
        }else if(fieldSetting==="choicesText"){
          item.choices=String(value).split(",").map(part=>part.trim()).filter(Boolean).map(part=>{const split=part.indexOf("=");return split<0?{code:part,label:part}:{code:part.slice(0,split).trim(),label:part.slice(split+1).trim()};});
        }else if(fieldSetting==="lookupSourceId"){
          const source=sourceById(value),columns=source?.query?.data?.columns||[];item.lookup={sourceId:value,valueField:columns[0]||"",labelField:columns[1]||columns[0]||""};refreshLookupChoices(item);draw();
        }else if(fieldSetting==="lookupValueField"||fieldSetting==="lookupLabelField"){
          item.lookup||={};item.lookup[fieldSetting==="lookupValueField"?"valueField":"labelField"]=value;refreshLookupChoices(item);
        }else{
          if(fieldSetting==="readOnly")item.readOnlyOverride=value;
          item[fieldSetting]=value;
          if(fieldSetting==="readOnly"){commit();redrawPreservingGroups();return;}
          if(fieldSetting==="type"){
            item.multiline=value==="longText";if(value==="choice"&&!item.choices?.length)item.choices=[{code:"option_1",label:"Option 1"}];if(value==="lookup")item.lookup||={sourceId:"",valueField:"",labelField:""};draw();
          }
        }
        commit();
      }
    });
    preview.addEventListener("click",event=>{const button=event.target.closest("[data-list-form-action]");if(!button)return;event.preventDefault();event.stopImmediatePropagation();const name=selectedFormField,item=formFieldByName(name),action=button.dataset.listFormAction,index=tile.list.fields.indexOf(item);if(!item)return;if(action==="previous"&&index>0){moveListField(index,index-1);return;}if(action==="next"&&index<tile.list.fields.length-1){moveListField(index,index+1);return;}updateFormLayout(name,layout=>{if(action==="column-left")layout.column-=1;if(action==="column-right")layout.column+=1;if(action==="span-less")layout.columnSpan-=1;if(action==="span-more")layout.columnSpan+=1;if(action==="row-less")layout.rowSpan-=1;if(action==="row-more")layout.rowSpan+=1;});});
    preview.addEventListener("pointerdown",event=>{const handle=event.target.closest("[data-list-form-preview-drag]");if(!handle||event.button!==0)return;formPointerDrag={name:handle.dataset.listFormPreviewDrag,pointerId:event.pointerId,handle};selectedFormField=formPointerDrag.name;handle.closest(".list-form-design-field")?.classList.add("is-dragging");handle.setPointerCapture?.(event.pointerId);event.preventDefault();event.stopImmediatePropagation();});
    preview.addEventListener("pointermove",event=>{if(!formPointerDrag||event.pointerId!==formPointerDrag.pointerId)return;const target=document.elementFromPoint(event.clientX,event.clientY)?.closest?.("[data-list-form-column-drop],[data-list-form-field]");preview.querySelectorAll(".is-drop-target").forEach(node=>node.classList.remove("is-drop-target"));if(target&&!target.contains(formPointerDrag.handle))target.classList.add("is-drop-target");event.preventDefault();});
    const finishFormPointerDrag=event=>{if(!formPointerDrag||event.pointerId!==formPointerDrag.pointerId)return;const drag=formPointerDrag,target=document.elementFromPoint(event.clientX,event.clientY)?.closest?.("[data-list-form-column-drop],[data-list-form-field]");drag.handle.releasePointerCapture?.(event.pointerId);preview.querySelectorAll(".is-drop-target,.is-dragging").forEach(node=>node.classList.remove("is-drop-target","is-dragging"));formPointerDrag=null;if(target?.matches("[data-list-form-column-drop]"))updateFormLayout(drag.name,layout=>{layout.column=+target.dataset.listFormColumnDrop;});else if(target?.dataset.listFormField&&target.dataset.listFormField!==drag.name)moveFormField(drag.name,target.dataset.listFormField);event.preventDefault();event.stopImmediatePropagation();};
    preview.addEventListener("pointerup",finishFormPointerDrag);
    preview.addEventListener("pointercancel",finishFormPointerDrag);
