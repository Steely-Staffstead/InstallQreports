      const results=menu.querySelector(".designer-search-select-options"),search=menu.querySelector("input"),entries=[];
      let looseGroup=null;
      const group=(name,loose=false)=>{const section=document.createElement("section");section.dataset.searchSelectGroup="";if(name){const heading=document.createElement("strong");heading.textContent=name;section.append(heading);}results.append(section);if(loose)looseGroup=section;return section;};
      for(const child of select.children){
        const section=child.tagName==="OPTGROUP"?group(child.label):looseGroup||group("",true),options=child.tagName==="OPTGROUP"?[...child.children]:[child];
        for(const option of options){if(option.tagName!=="OPTION")continue;const button=document.createElement("button"),text=option.textContent.trim();button.type="button";button.textContent=text;button.dataset.searchSelectValue=option.value;button.dataset.searchText=`${text} ${option.value} ${child.label||""}`.toLocaleLowerCase();button.setAttribute("role","option");button.setAttribute("aria-selected",String(option.selected));button.disabled=option.disabled;section.append(button);entries.push({button,section});}
      }
