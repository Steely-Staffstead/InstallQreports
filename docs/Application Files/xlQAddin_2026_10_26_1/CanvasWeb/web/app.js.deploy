    if(!section){section=document.createElement("details");section.id=id;section.innerHTML=`<summary>${label}</summary><div class="property-section-body"></div>`;$("#tileProperties")?.append(section);}
    return section;
  }
  function propertySectionBody(section){let body=section?.querySelector(":scope > .property-section-body");if(!body&&section){body=document.createElement("div");body.className="property-section-body";section.append(body);}return body;}
  function propertyNodeHasContent(node){if(!node||node.nodeType!==Node.ELEMENT_NODE||node.matches("summary,.hidden"))return false;if(node.matches('input:not([type="hidden"]),select,textarea,button,[contenteditable="true"],a[href],img,svg,canvas'))return true;const children=[...node.children].filter(child=>!child.matches("summary"));if(children.some(propertyNodeHasContent))return true;return !children.length&&node.textContent.trim().length>0;}
  function hideEmptyPropertySections(root){root?.querySelectorAll(".property-section").forEach(section=>{const content=[...section.children].filter(child=>!child.matches("summary")).some(propertyNodeHasContent);section.classList.toggle("property-section-empty",!content);});}
