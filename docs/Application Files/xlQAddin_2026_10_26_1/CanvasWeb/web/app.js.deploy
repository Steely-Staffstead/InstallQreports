  function visualFilterBindings(){
    const bindings=(page().filters||[]).map((filter,index)=>({scope:"page",filter,owner:page(),label:`Page · ${filter.column||`Filter ${index+1}`}`})),seen=new Set();for(const owner of allObjects(page()))for(const filter of owner.filters||[]){const id=filter.id||filter.sharedFilterId;if(!id||seen.has(id))continue;seen.add(id);bindings.push({scope:"tile",filter,owner,label:`Tile · ${owner.title||owner.kind} · ${filter.column||"Filter"}`});}return bindings;
