  }
  function renderSubtotalProperties(){let panel=$("#subtotalFormatting");if(!panel){panel=document.createElement("details");panel.id="subtotalFormatting";panel.innerHTML='<summary>Rows & hierarchy</summary><div id="matrixHierarchyProperties"></div><h4 class="subtotal-format-heading">Subtotal formatting</h4><p class="property-empty">Matrix designer area formats take priority over these defaults.</p><div class="property-grid"><label>Font<select data-subtotal="fontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-subtotal="fontSize" type="number" min="8" max="72"></label></div><div class="property-grid"><label>Text color<input data-subtotal="textColor" type="color"></label><label>Background<input data-subtotal="background" type="color"></label></div><div class="header-emphasis"><label class="check"><input data-subtotal="bold" type="checkbox"> Bold</label><label class="check"><input data-subtotal="italic" type="checkbox"> Italic</label><label class="check"><input data-subtotal="underline" type="checkbox"> Underline</label></div>';$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="matrix")return;t.design||={};t.design.matrixSpec||={};const spec=t.design.matrixSpec,setting=event.target.dataset.matrixSetting,rowKey=event.target.dataset.matrixRowOption,key=event.target.dataset.subtotal;if(event.target.dataset.matrixRowSelect!=null){activeMatrixSubtotalRow=event.target.value;renderSubtotalProperties();return;}if(setting){spec[setting]=event.target.type==="checkbox"?event.target.checked:event.target.value;if(setting==="layout"&&spec.layout!=="outline")spec.collapsedGroups={};}else if(rowKey&&activeMatrixSubtotalRow){spec.rowOptions||={};spec.rowOptions[activeMatrixSubtotalRow]||={};spec.rowOptions[activeMatrixSubtotalRow][rowKey]=event.target.type==="checkbox"?event.target.checked:event.target.value;if(rowKey==="startCollapsed")spec.collapsedGroups={};}else if(key){spec.subtotalStyle||={};spec.subtotalStyle[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?Math.max(8,+event.target.value||12):event.target.value;if(event.target.type==="color"){spec.subtotalStyle.colorOverrides||={};spec.subtotalStyle.colorOverrides[key]=true;if(t.themeBindings)delete t.themeBindings[`design.matrixSpec.subtotalStyle.${key}`];}}else return;markDirty();render();});}const t=selectedTile(),visible=t?.kind==="matrix";panel.classList.toggle("hidden",!visible);if(!visible)return;const spec=t.design?.matrixSpec||{},style=spec.subtotalStyle||{},rows=spec.rows||[];activeMatrixSubtotalRow=rows.includes(activeMatrixSubtotalRow)?activeMatrixSubtotalRow:rows[0]||"";const option=spec.rowOptions?.[activeMatrixSubtotalRow]||{},outline=(spec.layout||"tabular")==="outline",hierarchy=panel.querySelector("#matrixHierarchyProperties");hierarchy.innerHTML=`<div class="matrix-property-group"><h4>Row layout</h4><label>Layout<select data-matrix-setting="layout"><option value="tabular" ${!outline?"selected":""}>Tabular</option><option value="outline" ${outline?"selected":""}>Outline</option></select></label>${outline?`<label>Row header caption<input data-matrix-setting="outlineCaption" value="${esc(spec.outlineCaption||"Rows")}"></label>`:`<label class="check"><input data-matrix-setting="repeatLabels" type="checkbox" ${spec.repeatLabels!==false?"checked":""}> Repeat row labels</label>`}<label class="check"><input data-matrix-setting="blankLineAfterGroup" type="checkbox" ${spec.blankLineAfterGroup?"checked":""}> Insert blank line after each group</label></div><div class="matrix-property-group ${outline?"":"is-disabled"}"><h4>Expansion controls</h4><label class="check"><input data-matrix-setting="showGroupActions" type="checkbox" ${spec.showGroupActions?"checked":""} ${outline?"":"disabled"}> Show hierarchy level controls</label><div class="property-grid"><label>Buttons<select data-matrix-setting="groupControlMode" ${outline?"":"disabled"}><option value="levels" ${(spec.groupControlMode||"levels")==="levels"?"selected":""}>Excel-style levels</option><option value="all" ${spec.groupControlMode==="all"?"selected":""}>Expand / collapse all</option></select></label><label>Placement<select data-matrix-setting="groupControlPlacement" ${outline?"":"disabled"}><option value="rowHeader" ${(spec.groupControlPlacement||"rowHeader")==="rowHeader"?"selected":""}>Inside row header</option><option value="left" ${spec.groupControlPlacement==="left"?"selected":""}>Above, left</option><option value="right" ${spec.groupControlPlacement==="right"?"selected":""}>Above, right</option></select></label></div></div>${rows.length?`<div class="matrix-property-group"><h4>Selected row level</h4><label>Row<select data-matrix-row-select>${rows.map(field=>`<option value="${esc(field)}" ${field===activeMatrixSubtotalRow?"selected":""}>${esc(spec.rowCaptions?.[field]||field)}</option>`).join("")}</select></label><label class="check"><input data-matrix-row-option="subtotal" type="checkbox" ${option.subtotal?"checked":""}> Show subtotal for this level</label><label>Subtotal label<input data-matrix-row-option="pretext" value="${esc(option.pretext||"SUM")}"></label><label class="check"><input data-matrix-row-option="showExpandCollapse" type="checkbox" ${option.showExpandCollapse?"checked":""} ${outline?"":"disabled"}> Show + / − button on row headers</label><label class="check"><input data-matrix-row-option="startCollapsed" type="checkbox" ${option.startCollapsed?"checked":""} ${outline?"":"disabled"}> Start this level collapsed</label><label>Subtotal position<select data-matrix-setting="subtotalPosition"><option value="top" ${spec.subtotalPosition!=="bottom"?"selected":""}>Top (group header)</option><option value="bottom" ${spec.subtotalPosition==="bottom"?"selected":""}>Bottom (after values)</option></select></label></div>`:""}`;panel.querySelector('[data-subtotal="fontFamily"]').value=style.fontFamily||"Segoe UI";panel.querySelector('[data-subtotal="fontSize"]').value=style.fontSize||12;panel.querySelector('[data-subtotal="textColor"]').value=style.colorOverrides?.textColor?style.textColor:matrixPaletteLook("subtotal1","rowHeader").textColor;panel.querySelector('[data-subtotal="background"]').value=style.colorOverrides?.background?style.background:matrixPaletteLook("subtotal1","rowHeader").background;panel.querySelector('[data-subtotal="bold"]').checked=style.bold!==false;panel.querySelector('[data-subtotal="italic"]').checked=!!style.italic;panel.querySelector('[data-subtotal="underline"]').checked=!!style.underline;enhanceStyleToolbar(panel,"subtotal","Subtotal preview",{alignValue:style.alignment||"left",before:panel.querySelector(".subtotal-format-heading")});}
  function renderCardProperties(){const field=$("#tileField")?.closest("label"),panel=$("#cardProperties");if(panel){for(const section of panel.querySelectorAll(":scope > details")){const label=section.querySelector("summary")?.textContent,name=["Data fields","Content"].includes(label)?"Target and variance":label==="Value appearance"?"Card formatting":label==="Text & template"?"Text":label;if(name)cardSectionState.set(name,section.open);}}if(field&&panel?.contains(field))$("#tileGeneralSettings")?.append(field);renderCardPropertiesInner();renderGeneralSettings();schedulePropertyOrganization();}
  function renderCardPropertiesInner(){let panel=$("#cardProperties");if(!panel){panel=document.createElement("div");panel.id="cardProperties";panel.className="card-properties hidden";$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="card")return;t.card||={};const value=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?(event.target.value===""?null:+event.target.value):event.target.value;let changed=false;if(event.target.dataset.card){t.card[event.target.dataset.card]=value;changed=true;}else if(event.target.dataset.cellRenderer){t.card.renderer||={};t.card.renderer[event.target.dataset.cellRenderer]=value;changed=true;}else if(event.target.dataset.bar){t.card.bar||={};t.card.bar[event.target.dataset.bar]=value;changed=true;}else if(event.target.dataset.conditional){t.card.conditional||={};t.card.conditional[event.target.dataset.conditional]=value;changed=true;}if(changed){markDirty();render();}});}const t=selectedTile();panel.classList.toggle("hidden",t?.kind!=="card");if(t?.kind!=="card")return;const card=t.card||={},q=sourceForTile(t)?.query||query(),local=[...(q.data?.columns||[]),...(q.measures||[]).map(item=>item.Name??item.OutputName??item.name??item.outputName).filter(Boolean)],linked=linkedMeasureEntries(t.sourceId||"main").map(item=>item.token),fields=[...new Set([...local,...linked])],current=card.numberFormat||"Auto",formatPreset=formatChoices.includes(current)?current:"Custom",customFormat=current!=="Custom"&&!formatChoices.includes(current)?current:(card.customFormat||"#,##0.0");panel.innerHTML=`<h4>Card formatting</h4><div class="property-grid"><label>Number format<select data-card="numberFormat">${formatChoices.map(value=>`<option ${value===formatPreset?"selected":""}>${value}</option>`).join("")}</select></label><label class="${formatPreset==="Custom"?"":"hidden"}">Custom format<input data-card="customFormat" value="${esc(customFormat)}" placeholder="+#,##0.0;-#,##0.0;–"></label><label>Percent format<select data-card="percentFormat">${["P0","P1","P2"].map(value=>`<option ${value===(card.percentFormat||"P1")?"selected":""}>${value}</option>`).join("")}</select></label><label>Alignment<select data-card="align">${["left","center","right"].map(value=>`<option value="${value}" ${value===(card.align||"center")?"selected":""}>${value[0].toUpperCase()+value.slice(1)}</option>`).join("")}</select></label><label>Value font<select data-card="fontFamily">${["Segoe UI","Arial","Calibri","Georgia","Consolas"].map(value=>`<option ${value===(card.fontFamily||"Segoe UI")?"selected":""}>${value}</option>`).join("")}</select></label><label>Value size<input data-card="fontSize" type="number" min="8" max="120" value="${card.fontSize||30}"></label><label>Weight<select data-card="fontWeight">${[[400,"Normal"],[600,"Semibold"],[700,"Bold"],[800,"Extra bold"]].map(([value,label])=>`<option value="${value}" ${+card.fontWeight===value?"selected":""}>${label}</option>`).join("")}</select></label><label>Default color<input data-card="valueColor" type="color" value="${card.valueColor||"#1d4f8f"}"></label></div><div class="header-emphasis"><label class="check"><input data-card="italic" type="checkbox" ${card.italic?"checked":""}> Italic</label><label class="check"><input data-card="underline" type="checkbox" ${card.underline?"checked":""}> Underline</label></div>${cellRendererPropertiesHtml(card)}${dataBarPropertiesHtml(card,fields)}${matrixConditionalPropertiesHtml(card,fields)}<h4>Target and variance</h4><label>Target field / measure<select data-card="targetField"><option value="">Manual target</option>${fields.map(value=>`<option ${value===card.targetField?"selected":""}>${esc(value)}</option>`).join("")}</select></label><label>Manual target<input data-card="targetValue" type="number" step="any" value="${card.targetValue??""}"></label><label class="check"><input data-card="showDifference" type="checkbox" ${card.showDifference?"checked":""}> Show difference</label><label class="check"><input data-card="showPercentDifference" type="checkbox" ${card.showPercentDifference?"checked":""}> Show percent difference</label><label class="check"><input data-card="higherIsBetter" type="checkbox" ${card.higherIsBetter!==false?"checked":""}> Higher is better</label><div class="property-grid"><label>Positive color<input data-card="positiveColor" type="color" value="${card.positiveColor||"#16844a"}"></label><label>Negative color<input data-card="negativeColor" type="color" value="${card.negativeColor||"#c43d4b"}"></label></div><h4>Text</h4><div class="property-grid"><label>Prefix<input data-card="prefix" type="text" value="${esc(card.prefix||"")}"></label><label>Suffix<input data-card="suffix" type="text" value="${esc(card.suffix||"")}"></label></div><label>Advanced template<textarea data-card="template" rows="3" placeholder="This is @value for today {{parameter1}}">${esc(card.template||"")}</textarea></label><small class="card-help">Right-click to insert fields, measures, parameters, or @value functions.</small>`;}
  function renderCardCaptionProperties(){let panel=$("#cardCaptionProperties");if(!panel){panel=document.createElement("details");panel.id="cardCaptionProperties";panel.innerHTML='<summary>Caption</summary><label class="check"><input data-card-caption="showCaption" type="checkbox"> Show caption</label><label>Caption template<textarea data-card-caption="captionTemplate" rows="3" placeholder="@field"></textarea></label><small class="card-help">Right-click to insert a field, measure, parameter, @field, or @value.</small><div class="property-grid"><label>Font<select data-card-caption="captionFontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-card-caption="captionFontSize" type="number" min="8" max="72"></label></div><label>Text color<input data-card-caption="captionColor" type="color"></label><div class="header-emphasis"><label class="check"><input data-card-caption="captionBold" type="checkbox"> Bold</label><label class="check"><input data-card-caption="captionItalic" type="checkbox"> Italic</label><label class="check"><input data-card-caption="captionUnderline" type="checkbox"> Underline</label></div><label class="check"><input data-card-caption="transparentBackground" type="checkbox"> Transparent tile background</label>';$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.cardCaption;if(t?.kind!=="card"||!key)return;t.card||={};t.card[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?Math.max(8,+event.target.value||12):event.target.value;markDirty();render();});}const t=selectedTile(),visible=t?.kind==="card";panel.classList.toggle("hidden",!visible);if(!visible)return;const card=t.card||{};panel.querySelector('[data-card-caption="showCaption"]').checked=card.showCaption!==false;panel.querySelector('[data-card-caption="captionTemplate"]').value=card.captionTemplate||"@field";panel.querySelector('[data-card-caption="captionFontFamily"]').value=card.captionFontFamily||"Segoe UI";panel.querySelector('[data-card-caption="captionFontSize"]').value=card.captionFontSize||12;panel.querySelector('[data-card-caption="captionColor"]').value=card.captionColor||"#475467";panel.querySelector('[data-card-caption="captionBold"]').checked=!!card.captionBold;panel.querySelector('[data-card-caption="captionItalic"]').checked=!!card.captionItalic;panel.querySelector('[data-card-caption="captionUnderline"]').checked=!!card.captionUnderline;panel.querySelector('[data-card-caption="transparentBackground"]').checked=!!card.transparentBackground;}
  function renderCardBorderControl(){const panel=$("#cardCaptionProperties");if(!panel)return;let label=$("#cardBorderControl");if(!label){label=document.createElement("label");label.id="cardBorderControl";label.className="check";label.innerHTML='<input type="checkbox"> Remove tile border and shadow';panel.append(label);label.querySelector("input").addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="card")return;t.card||={};t.card.noBorder=event.target.checked;markDirty();render();});}const t=selectedTile();label.classList.toggle("hidden",t?.kind!=="card");if(t?.kind==="card")label.querySelector("input").checked=!!t.card?.noBorder;}
  function duplicateName(source){
    const title=String(source?.title||source?.kind||"Object").trim();
    const base=String(source?.duplicateBaseName||(/^Text box \d+$/i.test(title)?"Text box":title.replace(/(?:\s+copy)+$/i,""))).trim()||"Object";
    const used=new Set(model.pages.flatMap(p=>allObjects(p).map(item=>String(item.title||"").toLowerCase())));
    let number=1;while(used.has(`${base} ${number}`.toLowerCase()))number++;
    return {base,title:`${base} ${number}`};
  }
  function matchingSelectedObjects(){const t=selectedTile();if(!t)return[];const matches=allObjects(page()).filter(item=>selectedIds.has(item.id)&&item.kind===t.kind&&(t.kind!=="graphicText"||!!item.boxed===!!t.boxed));return matches.length?matches:[t];}
  function reverseConnector(t){if(t?.kind!=="connector")return;[t.fromId,t.toId]=[t.toId,t.fromId];[t.fromAnchor,t.toAnchor]=[t.toAnchor,t.fromAnchor];[t.x1,t.x2]=[t.x2,t.x1];[t.y1,t.y2]=[t.y2,t.y1];markDirty();render();}
  function formatPainterFamily(item){if(!item)return"";return item.kind==="graphicText"?`${item.kind}:${item.boxed?"box":"plain"}`:item.kind;}
  function formatPainterCompatible(item){return !!formatPainter&&formatPainter.family===formatPainterFamily(item);}
  function copyFormatKeys(source,keys){return Object.fromEntries(keys.filter(key=>source?.[key]!==undefined).map(key=>[key,structuredClone(source[key])]));}
  function metricFormat(metric){const copy=structuredClone(metric||{});for(const key of ["id","field","measure","sourceId","aggregation","caption"])delete copy[key];return copy;}
  function applyMetricFormats(targets=[],formats=[]){targets.forEach((metric,index)=>{if(formats[index])Object.assign(metric,structuredClone(formats[index]));});}
  function chartFormat(tile){const spec=tile.design?.chartSpec||{},options=structuredClone(spec.ChartOptions||{}),style=structuredClone(spec.Style||{}),series=(spec.SeriesSpecs||spec.seriesSpecs||[]).map(item=>{const copy=structuredClone(item);for(const key of ["Id","id","ColumnName","column","Field","field","Measure","measure","Expression","expression","LegendText","legend","aggregation","SourceId","sourceId","Kind","kind"])delete copy[key];return copy;});for(const key of ["TooltipFields","TitleText"])delete options[key];for(const key of ["Xcolumn","Ycolumn","GroupBy","SubgroupBy","HeaderText"])delete style[key];return{options,style,series};}
  function svgFieldFormat(field={}){return copyFormatKeys(field,["fontSize","fontFamily","fontWeight","fill","stroke","strokeWidth"]);}
  function reportGridFormat(grid={}){return{...copyFormatKeys(grid,["showGrid","showColumnLetters","showRowNumbers","showTopFormatControls","showFormulaBar","showTopGridControls","paddingTop","paddingBottom","style","headerStyle"]),columns:(grid.columns||[]).map(column=>copyFormatKeys(column,["width","style"])),rows:(grid.rows||[]).map(row=>({...(copyFormatKeys(row,["height","style"])),cells:(row.cells||[]).map(cell=>copyFormatKeys(cell,["style"]))}))};}
  function formatSnapshot(source){
    const snapshot={family:formatPainterFamily(source),kind:source.kind,sourceId:source.id,title:source.title||source.kind,common:copyFormatKeys(source,["background","borderColor","borderThickness","rounding","showHeader","transparentBackground","noBorder","header","themeBindings"]),specific:{}};
    if(source.kind==="chart")snapshot.specific.chart=chartFormat(source);
    else if(source.kind==="card"){const card=structuredClone(source.card||{});for(const key of ["template","captionTemplate","targetField","targetValue"])delete card[key];snapshot.specific.card=card;}
    else if(source.kind==="multiCard"){const spec=multiCardSpec(source);snapshot.specific.multiCard={...copyFormatKeys(spec,["cardColumns","minCardWidth","metricColumns","metricColumnWidths","appearance","typography","showHeading"]),metrics:(spec.metrics||[]).map(metricFormat)};}
    else if(source.kind==="visualFilter"){const spec=source.visualFilter||{};snapshot.specific.visualFilter={...copyFormatKeys(spec,["layout","selectionStyle","selectedBorderWidth","columns","metricColumns","metricColumnWidths","gap","padding","rounding","useTheme","themeRoles","textColor","backgroundColor","borderColor","selectedTextColor","selectedBackgroundColor","selectedBorderColor","hoverTextColor","hoverBackgroundColor","hoverBorderColor","headingFontSize","supportingFontSize"]),values:(spec.values||[]).map(metricFormat)};}
    else if(["table","matrix"].includes(source.kind)){snapshot.specific.appearance=structuredClone(source.appearance||{});if(source.kind==="matrix"){const spec=source.design?.matrixSpec||{};snapshot.specific.matrix={...copyFormatKeys(spec,["areaStyles","groupControlMode","groupControlPlacement","groupControlStyle","layout","repeatLabels","showExpandCollapse","showGroupActions","showTotalColumn","subtotalStyle","valueGroups"]),values:(spec.values||[]).map(metricFormat)};}}
    else if(source.kind==="list"){const spec=source.list||{};snapshot.specific.list={...copyFormatKeys(spec,["density","rowHeight","frozenColumns","appearance","viewMode","form"]),fields:(spec.fields||[]).map(field=>copyFormatKeys(field,["width","hidden","multiline","form"]))};}
    else if(source.kind==="reportGrid")snapshot.specific.reportGrid=reportGridFormat(source.reportGrid);
    else if(source.kind==="gantt"){const spec=source.design?.ganttSpec||{};snapshot.specific.gantt=copyFormatKeys(spec,["appearance","timeScale","timelineZoom","showToday","showWeekends","weekendShadeOpacity","showWeekNumbers","rowHeight","labelWidth","useThemeColors","barRole","progressRole","dependencyRole","progressLevels","lowPrioritySymbol","lowPriorityColorMode","lowPriorityThemeRole","lowPriorityColor","highPrioritySymbol","highPriorityColorMode","highPriorityThemeRole","highPriorityColor"]);}
    else if(["text","graphicText"].includes(source.kind))snapshot.specific.text=copyFormatKeys(source,["fontFamily","fontSize","textColor","paddingY","verticalAlign","textOverflow","boxed","boxShape"]);
    else if(source.kind==="picture")snapshot.specific.picture=copyFormatKeys(source,["imageSizing","hideScrollbars"]);
    else if(source.kind==="valueSelector"){const selector=source.valueSelector||{};snapshot.specific.valueSelector=copyFormatKeys(selector,["style","fontFamily","fontSize","bold","italic","useThemeColors","useThemeUnselectedText","useThemeUnselectedBackground","textColor","activeTextColor","backgroundColor","activeBackgroundColor"]);}
    else if(source.kind==="pageLink")snapshot.specific.pageLink=copyFormatKeys(source.pageLink||{},["style","icon","useTheme","accent","backgroundRole","themeRoles","headingFontSize","lineFontSize","captionFontSize"]);
    else if(source.kind==="svgGraphic"){const graphic=source.svgGraphic||{};snapshot.specific.svgGraphic={...copyFormatKeys(graphic,["textSize","subtextSize","textPosition","valueSize","direction","calendarStyle","timelineStyle","timelineTextPosition","timelinePointerStyle","timelinePointerLength","timelineShowLine","calloutPointerLength","iconName","color","textColor","backgroundColor","belowColor"]),svgFields:Object.fromEntries(Object.entries(graphic.svgFields||{}).map(([id,field])=>[id,svgFieldFormat(field)]))};}
    else if(["line","rectangle","connector"].includes(source.kind))snapshot.specific.shape=copyFormatKeys(source,["color","fill","noFill","thickness","lineStyle","shadePercent","startStyle","endStyle","arrowSize","route"]);
    return snapshot;
  }
  function applyFormatSnapshot(target,snapshot){
    if(!target||snapshot.family!==formatPainterFamily(target))return false;Object.assign(target,structuredClone(snapshot.common));const specific=snapshot.specific||{};
    if(target.kind==="chart"&&specific.chart){target.design||={};target.design.chartSpec||={};target.design.chartSpec.ChartOptions={...(target.design.chartSpec.ChartOptions||{}),...structuredClone(specific.chart.options)};target.design.chartSpec.Style={...(target.design.chartSpec.Style||{}),...structuredClone(specific.chart.style)};const series=target.design.chartSpec.SeriesSpecs||target.design.chartSpec.seriesSpecs||[];series.forEach((item,index)=>Object.assign(item,structuredClone(specific.chart.series[index]||{})));}
    else if(target.kind==="card"&&specific.card)target.card={...(target.card||{}),...structuredClone(specific.card)};
    else if(target.kind==="multiCard"&&specific.multiCard){target.design||={};const spec=target.design.multiCardSpec||={},settings=structuredClone(specific.multiCard);delete settings.metrics;Object.assign(spec,settings);applyMetricFormats(spec.metrics||[],specific.multiCard.metrics);}
    else if(target.kind==="visualFilter"&&specific.visualFilter){target.visualFilter||={};const settings=structuredClone(specific.visualFilter);delete settings.values;Object.assign(target.visualFilter,settings);applyMetricFormats(target.visualFilter.values||[],specific.visualFilter.values);}
    else if(["table","matrix"].includes(target.kind)&&specific.appearance){target.appearance=structuredClone(specific.appearance);if(target.kind==="matrix"&&specific.matrix){target.design||={};const spec=target.design.matrixSpec||={},settings=structuredClone(specific.matrix);delete settings.values;Object.assign(spec,settings);applyMetricFormats(spec.values||[],specific.matrix.values);}}
    else if(target.kind==="list"&&specific.list){target.list||={};const settings=structuredClone(specific.list);delete settings.fields;Object.assign(target.list,settings);(target.list.fields||[]).forEach((field,index)=>Object.assign(field,structuredClone(specific.list.fields[index]||{})));}
    else if(target.kind==="reportGrid"&&specific.reportGrid){const grid=target.reportGrid||={},settings=structuredClone(specific.reportGrid);delete settings.columns;delete settings.rows;Object.assign(grid,settings);(grid.columns||[]).forEach((column,index)=>Object.assign(column,structuredClone(specific.reportGrid.columns[index]||{})));(grid.rows||[]).forEach((row,rowIndex)=>{const sourceRow=specific.reportGrid.rows[rowIndex];if(!sourceRow)return;const rowSettings=structuredClone(sourceRow);delete rowSettings.cells;Object.assign(row,rowSettings);(row.cells||[]).forEach((cell,columnIndex)=>Object.assign(cell,structuredClone(sourceRow.cells?.[columnIndex]||{})));});}
    else if(target.kind==="gantt"&&specific.gantt){target.design||={};target.design.ganttSpec={...(target.design.ganttSpec||{}),...structuredClone(specific.gantt)};}
    else if(["text","graphicText"].includes(target.kind)&&specific.text)Object.assign(target,structuredClone(specific.text));
    else if(target.kind==="picture"&&specific.picture)Object.assign(target,structuredClone(specific.picture));
    else if(target.kind==="valueSelector"&&specific.valueSelector)target.valueSelector={...(target.valueSelector||{}),...structuredClone(specific.valueSelector)};
    else if(target.kind==="pageLink"&&specific.pageLink)target.pageLink={...(target.pageLink||{}),...structuredClone(specific.pageLink)};
    else if(target.kind==="svgGraphic"&&specific.svgGraphic){target.svgGraphic||=window.CanvasSvgGraphic.defaults();const settings=structuredClone(specific.svgGraphic);delete settings.svgFields;Object.assign(target.svgGraphic,settings);target.svgGraphic.svgFields||={};for(const[id,format]of Object.entries(specific.svgGraphic.svgFields||{}))if(target.svgGraphic.svgFields[id])Object.assign(target.svgGraphic.svgFields[id],structuredClone(format));}
    else if(["line","rectangle","connector"].includes(target.kind)&&specific.shape)Object.assign(target,structuredClone(specific.shape));
    return true;
  }
  function finishFormatPainter(message="Format painter finished"){formatPainter=null;document.querySelector("#formatPainterBanner")?.remove();document.body.classList.remove("format-painter-mode");document.querySelectorAll(".format-painter-source,.format-painter-eligible,.page-has-format-targets").forEach(node=>node.classList.remove("format-painter-source","format-painter-eligible","page-has-format-targets"));document.querySelectorAll("[data-format-target-count]").forEach(node=>delete node.dataset.formatTargetCount);if(message)$("#saveStatus").textContent=message;}
  function syncFormatPainterUi(){
    const canvas=$("#canvas");if(!formatPainter){document.querySelector("#formatPainterBanner")?.remove();document.body.classList.remove("format-painter-mode");return;}document.body.classList.add("format-painter-mode");canvas?.querySelectorAll(":scope>.tile").forEach(node=>{const item=allObjects(page()).find(candidate=>candidate.id===node.dataset.id),source=item?.id===formatPainter.sourceId;node.classList.toggle("format-painter-source",source);node.classList.toggle("format-painter-eligible",!source&&formatPainterCompatible(item));});document.querySelectorAll(".page-item[data-page]").forEach(button=>{const index=+button.dataset.page,count=allObjects(model.pages[index]).filter(item=>item.id!==formatPainter.sourceId&&formatPainter.family===formatPainterFamily(item)).length;button.classList.toggle("page-has-format-targets",count>0);if(count)button.dataset.formatTargetCount=String(count);else delete button.dataset.formatTargetCount;});let banner=document.querySelector("#formatPainterBanner");if(!banner){banner=document.createElement("div");banner.id="formatPainterBanner";banner.className="format-painter-banner";banner.innerHTML='<span aria-hidden="true">🖌</span><div><b></b><small>Click any outlined target. Change pages to continue.</small></div><button type="button">Done</button>';banner.querySelector("button").onclick=()=>finishFormatPainter();document.body.append(banner);}banner.querySelector("b").textContent=`Copying ${formatPainter.label} formatting · ${formatPainter.applications?`${formatPainter.applications} applied`:`choose a ${formatPainter.kind} target`}`;
  }
  function beginFormatPainter(source){if(!source)return false;formatPainter={...formatSnapshot(source),label:source.title||source.kind,applications:0};syncFormatPainterUi();$("#saveStatus").textContent=`Format painter active for ${formatPainter.label}`;return true;}
  function paintTarget(target){if(!formatPainterCompatible(target)||target.id===formatPainter.sourceId)return false;if(!applyFormatSnapshot(target,formatPainter))return false;formatPainter.applications++;selectedId=target.id;selectedIds=new Set([target.id]);markDirty();render();$("#saveStatus").textContent=`Applied ${formatPainter.label} formatting to ${target.title||target.kind} · painter remains active`;return true;}
  function copyCanvasSelection(){const ids=selectedIds.size?new Set(selectedIds):new Set(selectedId?[selectedId]:[]),objects=allObjects(page()).filter(item=>ids.has(item.id));if(!objects.length)return false;canvasClipboard={objects:structuredClone(objects),pasteCount:0};$("#saveStatus").textContent=`Copied ${objects.length} ${objects.length===1?"object":"objects"}`;return true;}
  function cloneOwnedListSource(original,copy){if(original?.kind!=="list"||copy?.kind!=="list"||original.list?.storage==="linked")return;const source=sourceById(original.list?.ownedSourceId||original.sourceId);if(!source)return;const cloned=structuredClone(source),sourceId=`list:${copy.id}`,base=source.name||copy.title||"List items";let name=base,suffix=2;while(model.sources.some(item=>String(item.name).toLowerCase()===name.toLowerCase()))name=`${base} ${suffix++}`;cloned.id=sourceId;cloned.name=name;cloned.localTable={storage:"embedded",format:"jsonl",...(cloned.localTable||{}),ownerTileId:copy.id,listOwned:true,private:copy.list?.exposeAsDatasource===false,listSchema:structuredClone(copy.list?.fields||[])};model.sources.push(cloned);copy.sourceId=sourceId;copy.list.ownedSourceId=sourceId;copy.list.datasourceName=name;}
  function pasteCanvasSelection(){if(!canvasClipboard?.objects?.length)return false;const offset=20*++canvasClipboard.pasteCount,idMap=new Map(canvasClipboard.objects.map(item=>[item.id,uid()])),existingIds=new Set(allObjects(page()).map(item=>item.id)),added=[];for(const source of canvasClipboard.objects){const copy=structuredClone(source),oldId=copy.id;copy.id=idMap.get(oldId);copy.x=Math.max(0,(Number(copy.x)||0)+offset);copy.y=Math.max(0,(Number(copy.y)||0)+offset);copy.layer=Math.max(-1,...allObjects(page()).map(item=>Number(item.layer)||0))+1;if(copy.kind==="connector"){for(const key of ["fromId","toId"]){const value=copy[key];copy[key]=idMap.get(value)||(existingIds.has(value)?value:"");}copy.fromAnchor=null;copy.toAnchor=null;}else{const name=duplicateName(source);copy.title=name.title;copy.duplicateBaseName=name.base;if(copy.sourceId&&!model.sources?.some(item=>item.id===copy.sourceId))copy.sourceId=activeSourceId||"main";if(copy.kind==="gantt"&&copy.design?.ganttSpec?.publishAsSource){copy.design.ganttSpec.publishedSourceId=ganttSourceId(copy);if(copy.sourceId===ganttSourceId(source))copy.sourceId="main";}cloneOwnedListSource(source,copy);}(graphicKinds.has(copy.kind)?page().graphics:page().tiles).push(copy);existingIds.add(copy.id);added.push(copy);}syncPublishedGanttSources(model);selectedIds=new Set(added.map(item=>item.id));selectedId=added.at(-1)?.id||null;markDirty();render();$("#saveStatus").textContent=`Pasted ${added.length} ${added.length===1?"object":"objects"}`;return true;}
  function duplicateTile(withConnectors=false){const source=selectedTile();if(!source)return;const copy=structuredClone(source),name=duplicateName(source);copy.id=uid();copy.title=name.title;copy.duplicateBaseName=name.base;copy.x+=20;copy.y+=20;copy.layer=Math.max(-1,...allObjects(page()).map(t=>Number(t.layer)||0))+1;cloneOwnedListSource(source,copy);(graphicKinds.has(copy.kind)?page().graphics:page().tiles).push(copy);if(withConnectors){for(const connector of [...(page().graphics||[])].filter(item=>item.kind==="connector"&&(item.fromId===source.id||item.toId===source.id))){const linked=structuredClone(connector);linked.id=uid();linked.layer=Math.max(-1,...allObjects(page()).map(item=>Number(item.layer)||0))+1;if(linked.fromId===source.id)linked.fromId=copy.id;if(linked.toId===source.id)linked.toId=copy.id;page().graphics.push(linked);}}selectedId=copy.id;selectedIds=new Set([copy.id]);markDirty();render();}
  function duplicateConnectorAsChild(connectorId){
    const source=selectedTile(),connector=(page().graphics||[]).find(item=>item.kind==="connector"&&item.id===connectorId&&(item.fromId===source?.id||item.toId===source?.id));
    if(!source||!connector)return;
    const neighborId=connector.fromId===source.id?connector.toId:connector.fromId,neighbor=allObjects(page()).find(item=>item.id===neighborId);
    if(!neighbor)return;
    const copy=structuredClone(source);
    const name=duplicateName(source);copy.id=uid();copy.title=name.title;copy.duplicateBaseName=name.base;
    copy.x=Math.max(0,Math.round(2*(source.x+source.width/2)-(neighbor.x+neighbor.width/2)-source.width/2));
    copy.y=Math.max(0,Math.round(2*(source.y+source.height/2)-(neighbor.y+neighbor.height/2)-source.height/2));
    copy.layer=Math.max(-1,...allObjects(page()).map(item=>Number(item.layer)||0))+1;
    (graphicKinds.has(copy.kind)?page().graphics:page().tiles).push(copy);
    const linked=structuredClone(connector);linked.id=uid();linked.layer=copy.layer+1;
    linked.fromId=copy.id;linked.toId=source.id;
    linked.fromAnchor=null;linked.toAnchor=null;
    page().graphics.push(linked);selectedId=copy.id;selectedIds=new Set([copy.id]);markDirty();render();
  }
  async function deleteTile(){
    const removing=selectedIds.size?new Set(selectedIds):new Set(selectedId?[selectedId]:[]);
    if(!removing.size)return;
    const ownedListSources=new Set(model.pages.flatMap(item=>item.tiles||[]).filter(tile=>removing.has(tile.id)&&tile.kind==="list"&&tile.list?.storage!=="linked").map(tile=>tile.list?.ownedSourceId||tile.sourceId).filter(Boolean));
    const published=[...removing].map(id=>model.pages.flatMap(item=>item.tiles||[]).find(tile=>tile.id===id)).filter(tile=>tile?.kind==="gantt"&&tile.design?.ganttSpec?.publishAsSource).map(tile=>ganttSourceId(tile)),consumers=model.pages.flatMap(item=>allObjects(item)).filter(tile=>published.includes(tile.sourceId));
    const dependencyWarning=consumers.length?` ${consumers.length} visual${consumers.length===1?"":"s"} using the published Gantt datasource will switch to Main source.`:"";
    if(window.QReportsSettings?.get()?.confirmDeleteTiles!==false&&!await themedConfirm(removing.size===1?"Delete tile":"Delete tiles",`Delete ${removing.size===1?"this tile":`${removing.size} tiles`}?${dependencyWarning}`))return;
    page().tiles=(page().tiles||[]).filter(tile=>!removing.has(tile.id));
    page().graphics=(page().graphics||[]).filter(item=>!removing.has(item.id)&&!(item.kind==="connector"&&(removing.has(item.fromId)||removing.has(item.toId))));
    model.sources=(model.sources||[]).filter(source=>!ownedListSources.has(source.id)||model.pages.some(item=>allObjects(item).some(tile=>!removing.has(tile.id)&&tile.sourceId===source.id)));
    syncPublishedGanttSources(model);selectedId=null;selectedIds.clear();markDirty();render();
  }
  function openGanttDesigner(tile){
    const overlay=designerShell("gantt","Gantt designer"),draft={...window.CanvasGantt.defaults(),...structuredClone(tile.design?.ganttSpec||{})},options=overlay.querySelector("[data-designer-options]"),fieldsPanel=overlay.querySelector("[data-designer-fields]"),preview=overlay.querySelector("[data-designer-preview]");
