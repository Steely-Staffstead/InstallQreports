data-vf="borderColor" type="color" value="${draft.borderColor||"#cbd5e1"}" ${appearanceDisabled}></label><label>Selected text<input data-vf="selectedTextColor" type="color" value="${draft.selectedTextColor||"#ffffff"}" ${appearanceDisabled}></label><label>Selected background<input data-vf="selectedBackgroundColor" type="color" value="${draft.selectedBackgroundColor||"#4f6ee8"}" ${appearanceDisabled}></label><label>Selected border<input data-vf="selectedBorderColor" type="color" value="${draft.selectedBorderColor||"#4f6ee8"}" ${appearanceDisabled}></label></div>`;options.querySelectorAll("[data-vf-value-index] details").forEach(detail=>{const index=+detail.closest("[data-vf-value-index]").dataset.vfValueIndex,metric=draft.values[index];if(opened.has(`${metric?.id}:${detail.className}`))detail.open=true;});preview();};
    const visualFilterTokenLookup=createDesignerTokenLookup(dialog,()=>{const {fields,measureEntries,parameters}=sourceParts();return[{label:"Text functions",items:[["Value","{{value}}"],["Count","{{count}}"],["UPPER(value)","{{upper:value}}"],["lower(value)","{{lower:value}}"]]},{label:"Fields",items:fields.map(name=>[name,`{{field:${name}}}`])},{label:"Measures",items:measureEntries.map(item=>[item.label,`{{measure:${item.value}}}`])},{label:"Parameters",items:parameters.map(name=>[name,`{{parameter:${name}}}`])}].filter(section=>section.items.length);},{dispatchEvent:"input",legacyAttribute:"data-visual-filter-token"});
