    prepareExcelExport(compact=false) { const c = page().canvas, canvas = $("#canvas"); let width=c.width||1280,height=c.height||720;if(c.mode==="preset")[width,height]=String(c.preset||"1280x720").split("x").map(Number);else if(c.mode==="flow")height=Math.max(240,...allObjects(page()).map(tile=>(+tile.y||0)+(+tile.height||0)+20));document.body.classList.remove("busy");document.body.classList.add("excel-export"); canvas.style.width = `${Math.max(compact?1:320, width)}px`; canvas.style.height = `${Math.max(compact?1:240, height)}px`; canvas.querySelectorAll(".tile").forEach(tile => tile.classList.remove("selected")); return JSON.stringify({ width:canvas.offsetWidth, height:canvas.offsetHeight }); },
