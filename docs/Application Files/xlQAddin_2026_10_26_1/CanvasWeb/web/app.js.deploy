  function parameterLookupChoices(result){if(Array.isArray(result.choices))return result.choices;const data=result.data||{},columns=data.columns||[],rows=data.rows||[],index=name=>Math.max(0,columns.findIndex(x=>String(x).toLowerCase()===String(name||"").toLowerCase())),vi=index(result.valueColumn),di=index(result.displayColumn),hi=(result.hierarchyColumns||[]).map(index);return rows.map(row=>({value:row[vi],display:row[di],hierarchyValues:hi.map(i=>row[i]).filter(value=>value!==null&&value!==undefined&&String(value)!=="")}));}
  host?.addEventListener("message",event=>{const message=event.data;if(!pendingExportRefresh)return;if(message.type==="hostError"||(message.type==="bridgeResult"&&message.action==="refresh"&&message.result?.ok!==true)){pendingExportRefresh.reject(new Error(message.result?.error||message.message||"Data refresh failed."));pendingExportRefresh=null;}});
  if(host){if(window.WebExportSettings)window.WebExportSettings.install({model:()=>model,changed:markDirty,post,host,status:message=>$("#saveStatus").textContent=message,ensureCompleteData:ensureCompleteDataForExport});else {const message="Export settings could not be loaded.";$("#saveStatus").textContent=message;document.querySelectorAll('[data-action="exportWebpage"],[data-action="presentationSettings"]').forEach(button=>{button.title=message;button.disabled=true;});}}
