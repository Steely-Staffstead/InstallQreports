    const sourceChoices=()=>model.sources.filter(source=>source.id!==ganttSourceId(tile)).map(source=>`<option value="${esc(source.id)}" ${source.id===sourceId?'selected':''}>${esc(source.name||source.id)}</option>`).join("");
