    dialog.className="visual-filter-designer";dialog.innerHTML=`<form method="dialog"><header><div><h2>Visual filter designer</h2><p>One canvas view of an existing page or linked tile filter.</p></div><button value="cancel" aria-label="Close">×</button></header><div class="visual-filter-designer-body"><section class="visual-filter-designer-options"><h3>Filter binding</h3><label>Page or linked tile filter<select data-vf="binding">${bindingOptions}</select></label><small>Source filters are deliberately not available here.</small><label>Filter column<select data-vf="dimension"></select></label><h3>Layout</h3><div class="field-grid"><label>Display<select data-vf="layout"><option value="buttons">Button group</option><option value="cards">Cards</option><option value="multiCard">Multi-card</option></select></label><label>Selection<select data-vf="selectionMode"><option value="auto">Follow filter type</option><option value="single">Single</option><option value="multiple">Multiple</option></select></label><label>Columns<input data-vf="columns" type="number" min="1" max="12"></label><label>Maximum items<input data-vf="maximumItems" type="number" min="1" max="500"></label><label>Sort<select data-vf="sort"><option value="source">Source order</option><option value="ascending">Ascending</option><option value="descending">Descending</option></select></label></div><label class="check"><input data-vf="showAll" type="checkbox"> Show All / Clear</label><label>All label<input data-vf="allLabel"></label><h3>Card content</h3><label>Heading<input data-vf="heading" placeholder="{{value}}"></label><label>Supporting text<input data-vf="supportingText" placeholder="{{count}} items"></label><label>Image field<select data-vf="imageField">${fieldOptions(draft.imageField)}</select></label><div class="field-grid"><label>Value / measure<select data-vf="valueField">${fieldOptions(draft.valueField)}</select></label><label>Aggregation<select data-vf="valueAggregation"><option>First</option><option>Count</option><option>Sum</option><option>Average</option><option>Min</option><option>Max</option></select></label></div><h3>Appearance</h3><label class="check"><input data-vf="useTheme" type="checkbox"> Follow canvas theme</label><div class="field-grid"><label>Gap<input data-vf="gap" type="number" min="0" max="80"></label><label>Padding<input data-vf="padding" type="number" min="0" max="80"></label><label>Rounding<input data-vf="rounding" type="number" min="0" max="80"></label></div><div class="visual-filter-colors"><label>Text<input data-vf="textColor" type="color"></label><label>Background<input data-vf="backgroundColor" type="color"></label><label>Border<input data-vf="borderColor" type="color"></label><label>Selected text<input data-vf="selectedTextColor" type="color"></label><label>Selected background<input data-vf="selectedBackgroundColor" type="color"></label><label>Selected border<input data-vf="selectedBorderColor" type="color"></label></div></section><section class="visual-filter-designer-preview"><h3>Preview</h3><div data-vf-preview></div><p>The preview reads the current filter state and keeps non-selected choices available.</p></section></div><footer><button value="cancel">Cancel</button><button value="apply" class="primary">Apply design</button></footer></form>`;
