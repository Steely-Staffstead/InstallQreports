    $("#tileProperties")?.addEventListener("change",event=>{const key=event.target.dataset.pageLink,t=selectedTile();if(t?.kind!=="pageLink"||!key)return;t.pageLink||={};const previousStyle=t.pageLink.style||"card",value=event.target.type==="checkbox"?event.target.checked:event.target.value;t.pageLink[key]=value;if(key==="backgroundRole"){t.themeBindings||={};if(value)t.themeBindings['pageLink.background']=value;else delete t.themeBindings['pageLink.background'];}if(key==="style"&&previousStyle!==t.pageLink.style){const sizes={card:[300,180],pill:[260,56],arrowRail:[340,180],compactStrip:[360,74],stepTab:[320,180],splitCommand:[380,180],editorial:[360,160],iconTile:[260,220]},previous=sizes[previousStyle]||sizes.card,next=sizes[t.pageLink.style]||sizes.card;if(t.width===previous[0]&&t.height===previous[1]){t.width=next[0];t.height=next[1];}}if(key==="target"&&t.pageLink.target==="page"&&!t.pageLink.pageId)t.pageLink.pageId=model.pages[0]?.id||"";markDirty();render();});
