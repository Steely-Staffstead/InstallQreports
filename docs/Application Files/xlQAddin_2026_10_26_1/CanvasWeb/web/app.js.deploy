  function addVisualForFilter(scope,filter,owner){const tile=addTile("visualFilter");if(!tile)return;filter.id||=filter.sharedFilterId||uid();tile.visualFilter.filterRef={scope,filterId:filter.id};tile.sourceId=scope==="page"?(filter.sourceId||"main"):(owner.sourceId||"main");markDirty();render();requestAnimationFrame(()=>openVisualFilterDesigner(tile));}
