    dialog.className="visual-filter-designer";dialog.innerHTML=`<form method="dialog"><header><div><h2>Visual filter designer</h2><p>One canvas view of an existing page or linked tile filter.</p></div><button value="cancel" aria-label="Close">×</button></header><div class="visual-filter-designer-body"><section class="visual-filter-designer-options" data-vf-options></section><section class="visual-filter-designer-preview"><div class="designer-preview-heading"><h3>Preview</h3><nav class="designer-preview-nav" aria-label="Preview controls"><button type="button" data-vf-preview-jump="layout">Layout</button><button type="button" data-vf-preview-jump="card-content">Card content</button><button type="button" data-vf-preview-jump="values">Values</button><button type="button" data-vf-preview-jump="appearance">Appearance</button></nav></div><div data-vf-preview></div><p>The preview reads the current filter state and keeps non-selected choices available.</p></section></div><footer><button value="cancel">Cancel</button><button value="apply" class="primary">Apply design</button></footer></form>`;document.body.append(dialog);
