  const ganttFieldDefaults={id:["Task ID",""],task:["Task","New task"],group:["Project / Group",""],start:["Start",""],end:["End",""],progress:["Progress",0],plannedHours:["Planned hours",0],registeredHours:["Hours used",0],milestone:["Milestone",false],dependsOn:["Depends on",""],owner:["Owner",""],status:["Status","Open"],priority:["Priority","Normal"],description:["Description",""]};
