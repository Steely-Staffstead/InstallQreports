    dialog.addEventListener("input",event=>{const input=event.target.closest("[data-vf]");if(!input||input.dataset.vf==="binding")return;const key=input.dataset.vf,value=input.type==="checkbox"?input.checked:input.type==="number"?+input.value:input.value;if(key==="dimension"){const binding=bindingForDraft();if(binding)binding.filter.column=value;}else draft[key]=value;preview();});
    dialog.addEventListener("change",event=>{const input=event.target.closest('[data-vf="binding"]');if(!input)return;const separator=input.value.indexOf(":"),scope=input.value.slice(0,separator),filterId=input.value.slice(separator+1);draft.filterRef={scope,filterId};syncFields();preview();});dialog.addEventListener("click",event=>{if(event.target.closest("[data-visual-filter-choice],[data-visual-filter-clear]")){event.preventDefault();event.stopPropagation();}});dialog.addEventListener("close",()=>{if(dialog.returnValue==="apply"){tile.visualFilter=structuredClone(draft);const binding=visualFilterBinding(tile);tile.sourceId=binding?.source?.id||tile.sourceId;if(binding?.scope==="tile")syncLinkedFilter(binding.filter,binding.owner);markDirty();render();}else originalColumns.forEach((column,filter)=>filter.column=column);dialog.remove();});dialog.showModal();
