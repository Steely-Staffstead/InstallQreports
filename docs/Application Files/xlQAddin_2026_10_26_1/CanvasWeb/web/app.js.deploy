    const additionalDateMarker=(marker,index,textFields)=>`<details class="svg-date-marker-editor" data-svg-date-marker-index="${index}" open><summary><span>${esc(marker.label||`Marker ${index+1}`)}</span><small>${esc(marker.labelField||"Choose label")}</small></summary><label class="check"><input type="checkbox" data-svg-date-enabled ${marker.enabled?"checked":""}> Position this marker automatically</label><label>Marker label<select data-svg-date-label-field>${textFields.map(field=>`<option value="${esc(field.id)}" ${field.id===marker.labelField?"selected":""}>${esc(field.label)}</option>`).join("")}</select></label><label>Label text<input data-svg-date-label value="${esc(marker.label||"")}"></label><label>Date source<select data-svg-date-source><option value="today" ${marker.source==="today"?"selected":""}>Today</option><option value="manual" ${marker.source==="manual"?"selected":""}>Fixed date</option><option value="field" ${marker.source==="field"?"selected":""}>Field</option><option value="parameter" ${marker.source==="parameter"?"selected":""}>Parameter</option></select></label><div data-svg-date-source-control>${marker.source==="field"?`<label>Date field<select data-svg-date-name>${fieldOptions(marker.name)}</select></label>`:marker.source==="parameter"?`<label>Date parameter<select data-svg-date-name>${parameterOptions(marker.name)}</select></label>`:marker.source==="manual"?`<label>Date<input type="date" data-svg-date-value value="${esc(marker.value||dateText(now))}"></label>`:'<p class="property-empty">The marker follows the current local date.</p>'}</div><div class="two-cols"><label>Range starts<input type="date" data-svg-range-start value="${esc(marker.rangeStart||dateText(quarterStart))}"></label><label>Range ends<input type="date" data-svg-range-end value="${esc(marker.rangeEnd||dateText(quarterEnd))}"></label></div><details><summary>Axis placement</summary><div class="two-cols"><label>Axis start X<input type="number" data-svg-axis-start value="${marke