    document.body.append(dialog);dialog.addEventListener("close",()=>{if(dialog.returnValue==="apply"){const wanted=new Set([...dialog.querySelectorAll('input:checked')].map(input=>input.value));if(!wanted.size){window.QReportsDialogs.alert("Select at least one tile.");dialog.remove();return;}linkedFilterEntries(filter,tile).forEach(entry=>{if(!wanted.has(entry.tile.id))entry.tile.filters.splice(entry.index,1);});eligible.filter(item=>wanted.has(item.id)&&!linkedFilterEntries(filter,tile).some(entry=>entry.tile.id===item.id)).forEach(item=>{item.filters||=[];item.filters.push(structuredClone(filter));});selectedIds=wanted;selectedId=[...wanted].at(-1)||tile.id;markDirty();render();showSidePanel("filters");renderFilters();}dialog.remove();});dialog.showModal();
