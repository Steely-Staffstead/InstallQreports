    document.querySelector(".page-import-dialog")?.close();const dialog=document.createElement("dialog");dialog.className="qanvas-confirm-dialog page-import-dialog";
    const initialMode=sourcePages.length?"pages":"sources",pageItems=sourcePages.map((item,index)=>{const objects=(item.tiles?.length||0)+(item.graphics?.length||0),filters=(item.filters?.length||0)+[...(item.tiles||[]),...(item.graphics||[])].reduce((sum,tile)=>sum+(tile.filters?.length||0),0);return`<label><input type="checkbox" value="${index}" ${index===0?"checked":""}><span><b>${esc(item.name||`Page ${index+1}`)}</b><small>${objects} object${objects===1?"":"s"} · ${filters} filter${filters===1?"":"s"}${item.hidden?" · hidden":""}</small></span></label>`;}).join("");
    dialog.innerHTML=`<form method="dialog"><h3 class="page-import-titlebar" title="Drag to move this window">Import from Qanvas</h3><p>Choose what to import from <b>${esc(payload.fileName||sourceDocument.name||"another Qanvas project")}</b>.</p><fieldset class="page-import-mode"><legend>Import content</legend><label><input type="radio" name="import-mode" value="pages" ${initialMode==="pages"?"checked":""} ${sourcePages.length?"":"disabled"}><span><b>Pages and related sources</b><small>Import editable page objects, filters and selected source definitions.</small></span></label><label><input type="radio" name="import-mode" value="sources" ${initialMode==="sources"?"checked":""} ${sourceDefinitions.length?"":"disabled"}><span><b>Sources and measures only</b><small>Import selected definitions without creating pages or tiles.</small></span></label></fieldset><section data-import-pages-ui><div class="page-import-actions"><button type="button" data-import-select="all">Select all</button><button type="button" data-import-select="none">Clear</button></div><div class="page-import-list">${pageItems}</div><label class="check page-import-source-toggle"><input type="checkbox" data-import-sources checked> Import sources and measures used by these pages</label></section><div class="page-import-sources"></div><p class="page-import-note">Expand a source to choose individual measures. New or replaced source definitions contain no cached rows; use Update to load their data.</p><p class="error" data-import-error></p><div><button value="cancel">Cancel</button><button value="import" class="primary" data-import-submit>Import selected</button></div></form>`;
    const checks=()=>[...dialog.querySelectorAll('.page-import-list input[type="checkbox"]')],sourceToggle=dialog.querySelector("[data-import-sources]"),sourcePanel=dialog.querySelector(".page-import-sources"),pagesUi=dialog.querySelector("[data-import-pages-ui]"),submit=dialog.querySelector("[data-import-submit]"),savedChoices=new Map(),savedMeasures=new Map(),measureKey=measure=>String(measure?.Name??measure?.name??measure?.OutputName??measure?.outputName??"").trim().toLowerCase(),measuresOf=source=>source.query?.measures||source.Query?.Measures||source.query?.metrics||source.Query?.Metrics||[];
    const mode=()=>dialog.querySelector('[name="import-mode"]:checked')?.value||initialMode;
    const captureSourceState=()=>{sourcePanel.querySelectorAll("select[data-import-source]").forEach(select=>savedChoices.set(select.dataset.importSource,select.value));sourcePanel.querySelectorAll("[data-import-source-card]").forEach(card=>savedMeasures.set(card.dataset.importSourceCard,new Set([...card.querySelectorAll("[data-import-measure]:checked")].map(input=>input.dataset.importMeasure))));};
    const sourceOptions=(source,choices)=>{const options=[],add=(value,label)=>{if(!options.some(item=>item.value===value))options.push({value,label});},candidates=[...new Map([...choices.equivalent,...choices.collision].map(item=>[item.id,item])).values()];for(const existing of candidates){add(`measures:${existing.id}`,`Use existing ${existing.name} · add selected missing measures`);add(`skip:${existing.id}`,`Use existing ${existing.name} without changes`);if(existing.kind!=="gantt"){add(`replace-source:${existing.id}`,`Replace source definition · keep ${existing.name} measures`);add(`replace:${existing.id}`,`Replace ${existing.name} source + selected measures`);}}add("new",choices.collision.length&&!choices.equivalent.length?"Import new source + selected measures (recommended)":"Import new source + selected measures");add("new-source","Import new source only · no measures");if(!candidates.length)add(mode()==="pages"?"main":"ignore",mode()==="pages"?"Do not import · connect pages to existing Main source":"Do not import this source");const id=String(source.id??source.Id??"main"),recommended=choices.equivalent.length?`measures:${choices.equivalent[0].id}`:choices.recommended;return options.map(option=>`<option value="${esc(option.value)}" ${option.value===(savedChoices.get(id)||recommended)?"selected":""}>${esc(option.label)}</option>`).join("");};
    const sourceCard=source=>{const id=String(source.id??source.Id??"main"),name=String(source.name??source.Name??id),measures=measuresOf(source),choices=importedSourceChoices(source),selected=savedMeasures.get(id),measureRows=measures.map(measure=>{const key=measureKey(measure),caption=String(measure?.Name??measure?.name??measure?.OutputName??measure?.outputName??"Unnamed measure");return`<label><input type="checkbox" data-import-measure="${esc(key)}" ${!selected||selected.has(key)?"checked":""}><span title="${esc(caption)}">${esc(caption)}</span><em data-import-measure-new hidden>New</em></label>`;}).join("");return`<article class="page-import-source-card" data-import-source-card="${esc(id)}"><div class="page-import-source-head"><span><b>${esc(name)}</b><small>${measures.length} measure${measures.length===1?"":"s"} · ${choices.equivalent.length?"matching footprint found":choices.collision.length?"name or ID collision":"new source"}</small></span><select data-import-source="${esc(id)}">${sourceOptions(source,choices)}</select></div><details class="page-import-measures" open ${measures.length?"":"hidden"}><summary>Measures <span data-import-measure-count>${selected?selected.size:measures.length} of ${measures.length}</span></summary><div class="page-import-measure-actions"><button type="button" data-import-measures="all">Select all</button><button type="button" data-import-measures="new">Select new</button><button type="button" data-import-measures="none">Clear</button></div><div class="page-import-measure-list">${measureRows}</div></details></article>`;};
    const updateMeasureNovelty=(card,source)=>{const choice=card.querySelector("select[data-import-source]")?.value||"",separator=choice.indexOf(":"),action=separator<0?choice:choice.slice(0,separator),targetId=separator<0?"":choice.slice(separator+1),target=targetId?sourceById(targetId):action==="main"?sourceById("main"):null,existing=new Set((target?measuresOf(target):[]).map(measureKey)),allNew=action==="new"||action==="new-source";card.querySelectorAll("[data-import-measure]").forEach(input=>{const isNew=allNew||!!target&&!existing.has(input.dataset.importMeasure);input.dataset.importMeasureNew=String(isNew);const row=input.closest("label");row.classList.toggle("new-measure",isNew);row.querySelector("em[data-import-measure-new]").hidden=!isNew;});};
    const growImportDialog=()=>requestAnimationFrame(()=>{if(!dialog.open)return;const bounds=dialog.getBoundingClientRect(),available=Math.max(360,innerHeight-Math.max(8,bounds.top)-8),needed=Math.min(available,dialog.scrollHeight);if(needed>dialog.offsetHeight+1)dialog.style.height=`${Math.ceil(needed)}px`;});
    const drawSources=()=>{captureSourceState();const sourceMode=mode()==="sources",indexes=checks().filter(input=>input.checked).map(input=>+input.value),references=sourceMode?sourceDefinitions.map(source=>String(source.id??source.Id??"main")):importedSourceReferences(sourceDocument,indexes),sources=sourceDefinitions.filter(source=>references.includes(String(source.id??source.Id??"main")));pagesUi.hidden=sourceMode;sourceToggle.closest("label").hidden=sourceMode;sourcePanel.hidden=!sourceMode&&!sourceToggle.checked;submit.textContent=sourceMode?"Import sources":"Import selected";if(sourcePanel.hidden)return;sourcePanel.innerHTML=sources.length?sources.map(sourceCard).join(""):sourceMode?'<p>No data sources are available in this project.</p>':'<p>No data sources are referenced by the selected pages.</p>';sourcePanel.querySelectorAll("[data-import-source-card]").forEach(card=>{const source=sourceDefinitions.find(item=>String(item.id??item.Id??"main")===card.dataset.importSourceCard);if(source)updateMeasureNovelty(card,source);});growImportDialog();};
    const updateMeasureCount=card=>{const selected=card.querySelectorAll("[data-import-measure]:checked").length,total=card.querySelectorAll("[data-import-measure]").length,count=card.querySelector("[data-import-measure-count]");if(count)count.textContent=`${selected} of ${total}`;savedMeasures.set(card.dataset.importSourceCard,new Set([...card.querySelectorAll("[data-import-measure]:checked")].map(input=>input.dataset.importMeasure)));};
    dialog.querySelector('[data-import-select="all"]').onclick=()=>{checks().forEach(input=>input.checked=true);drawSources();};dialog.querySelector('[data-import-select="none"]').onclick=()=>{checks().forEach(input=>input.checked=false);drawSources();};dialog.querySelector(".page-import-list").addEventListener("change",drawSources);dialog.querySelector(".page-import-mode").addEventListener("change",drawSources);sourceToggle.addEventListener("change",drawSources);sourcePanel.addEventListener("change",event=>{const card=event.target.closest("[data-import-source-card]");if(event.target.matches("select")){savedChoices.set(event.target.dataset.importSource,event.target.value);const source=sourceDefinitions.find(item=>String(item.id??item.Id??"main")===card?.dataset.importSourceCard);if(card&&source)updateMeasureNovelty(card,source);}if(card&&event.target.matches("[data-import-measure]"))updateMeasureCount(card);});sourcePanel.addEventListener("click",event=>{const action=event.target.closest("[data-import-measures]");if(!action)return;const card=action.closest("[data-import-source-card]"),selection=action.dataset.importMeasures;card.querySelectorAll("[data-import-measure]").forEach(input=>input.checked=selection==="all"||selection==="new"&&input.dataset.importMeasureNew==="true");updateMeasureCount(card);});sourcePanel.addEventListener("toggle",event=>{if(event.target.matches(".page-import-measures")&&event.target.open)growImportDialog();},true);drawSources();
    dialog.querySelector("form").addEventListener("submit",event=>{if(event.submitter?.value!=="import")return;captureSourceState();const sourceMode=mode()==="sources",indexes=checks().filter(input=>input.checked).map(input=>+input.value);if(!sourceMode&&!indexes.length){event.preventDefault();dialog.querySelector("[data-import-error]").textContent="Select at least one page.";return;}const plan=new Map([...sourcePanel.querySelectorAll("select[data-import-source]")].map(select=>[select.dataset.importSource,{choice:select.value,measureKeys:[...(savedMeasures.get(select.dataset.importSource)||[])]}]));let sourceResult=null;if(sourceMode||sourceToggle.checked)sourceResult=applyImportedSourcePlan(sourceDocument,plan);if(sourceMode){markDirty();render();const counts=sourceResult?.counts||{},details=[`${counts.created||0} source${counts.created===1?"":"s"} added`,`${counts.replaced||0} source${counts.replaced===1?"":"s"} replaced`,`${counts.measuresAdded||0} missing measure${counts.measuresAdded===1?"":"s"} added`,...(sourceResult?.warnings||[])];$("#saveStatus").textContent=details.join(" · ");return;}importPagesFromProject(sourceDocument,indexes,payload.fileName||"",{sourceMap:sourceResult?.sourceMap,sourceResult});});
    document.body.append(dialog);dialog.addEventListener("close",()=>dialog.remove(),{once:true});dialog.showModal();makeFloatingDialog(dialog,dialog.querySelector(".page-import-titlebar"));growImportDialog();
  }
  function themedConfirm(title,message,confirmLabel="Delete"){return new Promise(resolve=>{const dialog=document.createElement("dialog");dialog.className="qanvas-confirm-dialog";dialog.innerHTML=`<form method="dialog"><h3>${esc(title)}</h3><p>${esc(message)}</p><div><button value="cancel">Cancel</button><button value="confirm" class="danger">${esc(confirmLabel)}</button></div></form>`;dialog.addEventListener("close",()=>{const accepted=dialog.returnValue==="confirm";dialog.remove();resolve(accepted);},{once:true});document.body.append(dialog);dialog.showModal();});}
  function unsavedDocumentChoice(){return new Promise(resolve=>{const dialog=document.createElement("dialog");dialog.className="qanvas-confirm-dialog unsaved-document-dialog";dialog.innerHTML='<form method="dialog"><h3>Save changes?</h3><p>This canvas has unsaved changes. Save them before continuing?</p><div><button value="cancel">Cancel</button><button value="discard" class="danger">Don’t save</button><button value="save" class="primary">Save</button></div></form>';dialog.addEventListener("close",()=>{const choice=["save","discard"].includes(dialog.returnValue)?dialog.returnValue:"cancel";dialog.remove();resolve(choice);},{once:true});document.body.append(dialog);dialog.showModal();});}
  function licenseSummary(license){if(!license?.isValid)return license?.errorMessage||"No valid license is installed.";const edition=license.edition?` · ${license.edition}`:"",expiry=license.expiry?` · Expires ${license.expiry}`:" · No expiry date";return `${license.customerName||"Licensed user"}${edition}${expiry}`;}
