    options.addEventListener("input",event=>{const list=ensureBindings(),target=event.target,markerIndex=Number(target.closest("[data-svg-date-marker-index]")?.dataset.svgDateMarkerIndex||0),marker=markerBindings()[markerIndex],id=target.dataset.svgComponentField,key=target.dataset.svgComponentProperty,colorId=target.dataset.svgComponentColor;if(id&&key){const value=target.type==="number"?Number(target.value):target.value;if(key==="text")markerBindings().filter(item=>item.labelField===id).forEach(item=>item.label=String(value));setComponentValue(id,key,value);if(key==="text")target.closest("details")?.querySelector(".svg-component-current")?.replaceChildren(target.value);return;}if(colorId){const property=target.dataset.svgComponentColorProperty||"fill",textInput=target.parentElement?.querySelector(`[data-svg-component-field="${CSS.escape(colorId)}"][data-svg-component-property="${property}"]`);if(textInput)textInput.value=target.value;setComponentValue(colorId,property,target.value);return;}if(target.matches("[data-svg-designer-code]")){draft.svgCode=target.value;analysis=CanvasSvgGraphic.analyzeManualSvg(draft.svgCode);}else if(target.matches("[data-svg-category-target]")){list.targets=[...options.querySelectorAll("[data-svg-category-target]:checked")].map(input=>input.dataset.svgCategoryTarget);}else if(target.matches("[data-svg-category-field]"))list.field=target.value;else if(target.matches("[data-svg-category-sort]"))list.sort=target.value;else if(marker){if(target.matches("[data-svg-date-enabled]"))marker.enabled=target.checked;else if(target.matches("[data-svg-date-label-field]"))marker.labelField=target.value;else if(target.matches("[data-svg-date-label]"))marker.label=target.value;else if(target.matches("[data-svg-date-source]")){marker.source=target.value;renderOptions();}else if(target.matches("[data-svg-date-name]"))marker.name=target.value;else if(target.matches("[data-svg-date-value]"))marker.value=target.value;else if(target.matches("[data-svg-range-