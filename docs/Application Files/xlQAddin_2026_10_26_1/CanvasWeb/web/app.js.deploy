    const sourceId=primary.sourceId||"main",ids=selectedIds.size?selectedIds:new Set([primary.id]),targets=allObjects(page()).filter(tile=>ids.has(tile.id)&&supportsTileFilters(tile)&&(tile.sourceId||"main")===sourceId);
