    const calloutVisualControl=g.template==="callout"?`<div class="svg-timeline-editor svg-callout-editor"><div class="svg-timeline-control"><strong>Pointer direction</strong><div class="svg-visual-choices svg-visual-choices-four">${timelineChoice("direction","right","Right","→",effectiveDirection)}${timelineChoice("direction","left","Left","←",effectiveDirection)}${timelineChoice("direction","up","Up","↑",effectiveDirection)}${timelineChoice("direction","down","Down","↓",effectiveDirection)}</div></div><label class="svg-timeline-length"><span>Pointer length</span><input data-svg="calloutPointerLength" type="range" min="0" max="100" step="5" value="${attribute(g.calloutPointerLength??50)}"><output>${attribute(g.calloutPointerLength??50)}%</output></label><small class="svg-option-help">A longer pointer creates a sharper, more pronounced callout tip.</small></div>`:"";
