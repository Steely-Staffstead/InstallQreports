  async function compressImageData(image,width,height,options){
    const crop=options.crop||{x:0,y:0,width:1,height:1};
    const sourceX=Math.round(crop.x*image.naturalWidth),sourceY=Math.round(crop.y*image.naturalHeight);
    const sourceWidth=Math.max(1,Math.min(image.naturalWidth-sourceX,Math.round(crop.width*image.naturalWidth)));
    const sourceHeight=Math.max(1,Math.min(image.naturalHeight-sourceY,Math.round(crop.height*image.naturalHeight)));
    const multiplier=options.resolution==='original'?Infinity:Number(options.resolution);
    const scale=Math.min(1,Math.min(Math.max(1,width)*multiplier/sourceWidth,Math.max(1,height)*multiplier/sourceHeight));
    const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(sourceWidth*scale));canvas.height=Math.max(1,Math.round(sourceHeight*scale));
    const context=canvas.getContext('2d');if(!context)throw Error('Image compression is unavailable.');
    if(options.format==='image/jpeg'){context.fillStyle='#fff';context.fillRect(0,0,canvas.width,canvas.height);}
    context.drawImage(image,sourceX,sourceY,sourceWidth,sourceHeight,0,0,canvas.width,canvas.height);
    const blob=await new Promise(resolve=>canvas.toBlob(resolve,options.format,Number(options.quality)/100));
    if(!blob)throw Error('The image could not be encoded.');
    const dataUrl=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(reader.error);reader.readAsDataURL(blob);});
    if(!dataUrl.startsWith(`data:${options.format};`))throw Error('This image format is not supported by the browser.');
    return {dataUrl,bytes:blob.size,width:canvas.width,height:canvas.height};
  }
  function askPasteImageCompression(showDetails=true){
    return new Promise(resolve=>{
      const dialog=document.createElement('dialog');dialog.className='picture-paste-dialog';
      dialog.innerHTML=`<form method="dialog"><h2>Paste picture</h2><p>Compress this screenshot before adding it to the canvas?</p><div class="picture-compress-actions"><button value="original">No, keep original</button>${showDetails?'<button value="details">Go to Compress picture…</button>':''}<button value="compress" class="primary">Yes, compress</button></div></form>`;
      document.body.append(dialog);
      dialog.addEventListener('close',()=>{const choice=dialog.returnValue||'cancel';dialog.remove();resolve(choice);},{once:true});
      dialog.showModal();dialog.querySelector(`[value="${window.QReportsSettings?.get()?.compressPastedImages===false?'original':'compress'}"]`)?.focus();
    });
  }
  function openRichTableDialog(editor,insertionRange,onInserted){
    const dialog=document.createElement("dialog");dialog.className="rich-table-dialog";dialog.innerHTML='<form method="dialog"><header><div><h3>Insert table</h3><p>Choose a starting size. Rows and columns remain editable after insertion.</p></div><button type="submit" value="cancel" aria-label="Close">×</button></header><div class="rich-table-options"><label>Columns<input name="columns" type="number" min="1" max="12" value="3"></label><label>Rows<input name="rows" type="number" min="1" max="50" value="3"></label></div><label class="check"><input name="header" type="checkbox" checked> Use first row as table header</label><footer><button type="submit" value="cancel">Cancel</button><button type="submit" value="insert" class="primary">Insert table</button></footer></form>';
    document.body.append(dialog);dialog.addEventListener("close",()=>{const inserting=dialog.returnValue==="insert",data=inserting?new FormData(dialog.querySelector("form")):null;dialog.remove();if(inserting){const columns=Math.max(1,Math.min(12,Number(data.get("columns"))||3)),rows=Math.max(1,Math.min(50,Number(data.get("rows"))||3)),header=data.get("header")==="on",cells=(tag,count,label)=>`<tr>${Array.from({length:count},(_,index)=>`<${tag}>${label?`Column ${index+1}`:"<br>"}</${tag}>`).join("")}</tr>`,head=header?`<thead>${cells("th",columns,true)}</thead>`:"",bodyRows=Math.max(1,rows-(header?1:0)),html=`<table>${head}<tbody>${Array.from({length:bodyRows},()=>cells("td",columns,false)).join("")}</tbody></table><p><br></p>`,selection=window.getSelection(),range=insertionRange&&editor.contains(insertionRange.commonAncestorContainer)?insertionRange.cloneRange():null,before=editor.querySelectorAll("table").length;editor.focus({preventScroll:true});if(range){selection.removeAllRanges();selection.addRange(range);}document.execCommand("insertHTML",false,html);if(editor.querySelectorAll("table").length===before){range||=( ()=>{const value=document.createRange();value.selectNodeContents(editor);value.collapse(false);return value;})();range.deleteContents();const fragment=range.createContextualFragment(html),last=fragment.lastChild;range.insertNode(fragment);if(last){range.setStartAfter(last);range.collapse(true);selection.removeAllRanges();selection.addRange(range);}}editor.dispatchEvent(new Event("input",{bubbles:true}));onInserted?.();}else editor.focus({preventScroll:true});});dialog.showModal();requestAnimationFrame(()=>dialog.querySelector('input[name="columns"]')?.select());return dialog;
  }
  async function pasteRichImage(editor,file,options={}){
    if(file.size>20*1024*1024)throw new Error("Clipboard image is larger than 20 MB.");
    const selection=window.getSelection(),current=selection.rangeCount?selection.getRangeAt(0):null,fallback=options.range||savedLinkRange,range=current&&editor.contains(current.commonAncestorContainer)?current.cloneRange():fallback&&editor.contains(fallback.commonAncestorContainer)?fallback.cloneRange():null;
    const original=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(reader.error);reader.readAsDataURL(file);}),image=new Image();image.src=original;await image.decode();
    const choice=await askPasteImageCompression(false);if(choice==='cancel')return;
    const settings=window.QReportsSettings?.get()||{},availableWidth=Math.max(80,editor.clientWidth||640),displayWidth=Math.min(image.naturalWidth,availableWidth),displayHeight=Math.max(1,Math.round(displayWidth*image.naturalHeight/image.naturalWidth));let source=original;
    if(choice==='compress')try{const compressed=await compressImageData(image,displayWidth,displayHeight,{resolution:settings.pastedImageResolution||'1',format:settings.pastedImageFormat||'image/webp',quality:settings.pastedImageQuality||70});if(compressed.bytes<file.size)source=compressed.dataUrl;}catch(error){$("#jsonError").textContent=`Image inserted without compression: ${error.message}`;}
    const width=Math.max(5,Math.min(100,Math.round(displayWidth/availableWidth*100))),html=`<figure data-qanvas-image="true" style="width:100%;margin:8px 0;text-align:center"><img src="${source}" alt="${esc(file.name||'Pasted image')}" style="width:${width}%;height:auto;max-width:100%" draggable="false"></figure><p><br></p>`;
    editor.focus({preventScroll:true});if(range&&editor.contains(range.commonAncestorContainer)){selection.removeAllRanges();selection.addRange(range);}else{const end=document.createRange();end.selectNodeContents(editor);end.collapse(false);selection.removeAllRanges();selection.addRange(end);}document.execCommand('insertHTML',false,html);editor.dispatchEvent(new Event('input',{bubbles:true}));const inserted=[...editor.querySelectorAll('figure[data-qanvas-image] img')].at(-1);if(inserted&&options.showTools!==false)showRichImageTools(inserted);if(!options.silent)$("#saveStatus").textContent=source===original?'Image inserted in text':'Compressed image inserted in text';options.onInserted?.(inserted);
  }
  async function pasteCanvasImage(file){
    if(file.size>20*1024*1024)throw new Error("Clipboard image is larger than 20 MB.");
    const dataUrl=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(reader.error);reader.readAsDataURL(file);});
    const image=new Image();image.src=dataUrl;await image.decode();
    const scale=Math.min(1,640/image.naturalWidth,480/image.naturalHeight);
    const choice=await askPasteImageCompression();if(choice==='cancel')return;
    const width=Math.max(30,Math.round(image.naturalWidth*scale)),height=Math.max(30,Math.round(image.naturalHeight*scale));
    let pastedText=dataUrl,compressionError='';
    if(choice==='compress'){
      const settings=window.QReportsSettings?.get()||{};
      try{
        const compressed=await compressImageData(image,width,height,{resolution:settings.pastedImageResolution||'1',format:settings.pastedImageFormat||'image/webp',quality:settings.pastedImageQuality||70});
        if(compressed.bytes<file.size)pastedText=compressed.dataUrl;
      }catch(error){compressionError=error.message;}
    }
    const tile=addTile("picture");
    if(!tile)return;
    tile.text=pastedText;
    tile.imageFileName=pastedText===dataUrl?"Pasted image":"Pasted image (compressed)";
    tile.imageSizing="fit";
    tile.showHeader=false;
    tile.hideScrollbars=true;
    tile.width=width;
    tile.height=height;
    markDirty();render();
    if(compressionError)$("#jsonError").textContent=`Image pasted without compression: ${compressionError}`;
    $("#saveStatus").textContent=tile.text===dataUrl?"Image pasted into canvas":"Compressed image pasted into canvas";
    if(choice==='details')openPictureCompression();
  }
  function returnToHost(){if(!hostMode)return;post(hostMode==="powerpoint"?"returnPowerPoint":"returnExcel",{document:model,qrcnDocument:webToQrcn()});}
  function preparePowerPointImport(message){
    if(Array.isArray(message.batchRequests)&&message.batchRequests.length)return;
    if(message.hostType!=="powerpoint"||!message.pageId)return;
    const index=model.pages.findIndex(item=>item.id===message.pageId);
    if(index<0){post("hostSelectionError",{message:"The selected page no longer exists."});return;}
    pageIndex=index;
    const targetPage=model.pages[index],filters=Array.isArray(message.importFilters)?message.importFilters:[];
    if(message.tileId){
      const tile=[...(targetPage.tiles||[]),...(targetPage.graphics||[])].find(item=>item.id===message.tileId);
      if(!tile){post("hostSelectionError",{message:"The selected tile no longer exists."});return;}
      const pageFilters=filters.filter(item=>item.scope==="page").map(item=>({...item,scope:undefined}));
      const tileFilters=filters.filter(item=>item.scope!=="page").map(item=>({...item,scope:undefined}));
      targetPage.filters=[...(targetPage.filters||[]),...pageFilters];
      tile.filters=[...(tile.filters||[]),...tileFilters];
      targetPage.tiles=[tile];targetPage.graphics=[];
      targetPage.canvas={mode:"manual",width:Math.max(1,Math.ceil(tile.width||300)),height:Math.max(1,Math.ceil(tile.height||180)),preset:targetPage.canvas?.preset||"1280x720"};
      tile.x=0;tile.y=0;
      targetPage.background={...targetPage.background,color:"#ffffff",image:""};
    }else targetPage.filters=[...(targetPage.filters||[]),...filters.map(item=>({...item,scope:undefined}))];
    model.pages=[targetPage];pageIndex=0;selectedId=null;selectedIds.clear();render();
  }
  function applyBridgeResult(msg) { if(msg.action==="local-sources-refresh"){document.body.classList.remove("busy");if(!msg.result.ok){refreshingAllSources=false;sourceRefreshQueue=[];returnAfterSourceRefresh=false;$("#jsonError").textContent=msg.result.error||"Underlying source update failed";return;}$("#saveStatus").textContent=`Updated ${msg.result.updated.length} underlying queries`;refreshNextSource();return;} document.body.classList.remove("busy"); const r = msg.result,targetSource=sourceById(msg.requestId)||activeSource();if(msg.action==="canvas-palettes"){if(r.ok){localPalettes=QReportsPalette.catalog(r.palettes);const merged=new Map((model.settings.palettes||[]).map(item=>[item.name,item]));localPalettes.forEach(item=>merged.set(item.name,item));model.settings.palettes=[...merged.values()];markDirty();renderCanvasTheme();renderChartProperties();renderExtendedChartQuickGroup();}else $("#jsonError").textContent=r.error||"Could not load personal palettes";return;}if(msg.action==="edit-query"&&parameterQueryDesigner){const pending=parameterQueryDesigner;parameterQueryDesigner=null;r.ok?pending.resolve(r.query):pending.reject(new Error(r.error||"Query designer was cancelled"));return;} if (r.cancelled) { $("#saveStatus").textContent = "Editor cancelled";if(refreshingAllSources){refreshingAllSources=false;sourceRefreshQueue=[];returnAfterSourceRefresh=false;}return; } if (!r.ok) { $("#jsonError").textContent = `${targetSource?.name||"Datasource"}: ${r.error||"Update failed"}`;if(refreshingAllSources){refreshingAllSources=false;sourceRefreshQueue=[];returnAfterSourceRefresh=false;}return; } const returnedParameters=r.parameters||r.query?.parameters;if(returnedParameters)setDocumentParameters(returnedParameters);let measureRenameSummary=null;if(r.measures){measureRenameSummary=window.CanvasMeasureReferences?.renameDocument(model,targetSource.id,r.renames||[]);targetSource.query.measures=r.measures;} if (r.query) { const savedFilters=targetSource.query.filters||[];targetSource.query = { ...targetSource.query, ...r.query, parameters:model.parameters, totalRows: r.totalRows ?? r.query.data?.rows?.length ?? 0, measureValues: r.measureValues || targetSource.query.measureValues || {}, filters:savedFilters }; } model.pages.forEach(item=>item.query=sourceById("main").query); const designTarget=msg.tileId?model.pages.flatMap(item=>item.tiles).find(tile=>tile.id===msg.tileId):selectedTile();if(r.design&&designTarget)designTarget.design=r.design; markDirty(); render(); $("#saveStatus").textContent = msg.action === "refresh" ? `Updated ${targetSource.query.data.rows.length}${targetSource.query.totalRows > targetSource.query.data.rows.length ? ` of ${targetSource.query.totalRows}` : ""} rows from ${targetSource.name}` : measureRenameSummary?.renamed?`Renamed ${measureRenameSummary.renamed} measure${measureRenameSummary.renamed===1?"":"s"} and updated ${measureRenameSummary.updatedObjects} report object${measureRenameSummary.updatedObjects===1?"":"s"}`:"Editor changes applied"; if(msg.action==="refresh"&&refreshingAllSources){refreshNextSource();return;} if(msg.action!=="refresh"&&r.query&&targetSource.query?.queryText&&targetSource.query?.measures?.length&&targetSource.query.totalRows>targetSource.query.data.rows.length&&host&&!refreshingAllSources){sourceRefreshQueue=[targetSource.id];refreshingAllSources=true;$("#saveStatus").textContent="Loading complete data for measures…";setTimeout(refreshNextSource,0);return;} if(autoReturnHost&&msg.action==="refresh")returnToHost(); }
  const recentFileWithoutExtension=path=>String(path||"").replace(/\.(?:canvasweb\.json|qanvas\.json|qanvas)$/i,"");
  const recentFileIdentity=path=>recentFileWithoutExtension(String(path||"").trim().replace(/\//g,"\\")).toLowerCase();
  function uniqueRecentFiles(files){const seen=new Set(),limit=Math.max(1,Math.min(25,Number(window.QReportsSettings?.get()?.recentFileCount)||10));return (Array.isArray(files)?files:[]).filter(path=>{const key=recentFileIdentity(path);if(!key||seen.has(key))return false;seen.add(key);return true;}).slice(0,limit);}
  function renderRecentFiles(){const menu=$("#recentMenu"),displayName=path=>recentFileWithoutExtension(path.split(/[\\/]/).pop());recentFiles=uniqueRecentFiles(recentFiles);menu.innerHTML=recentFiles.length?recentFiles.map((path,index)=>`<button type="button" data-recent-index="${index}" title="${esc(path)}"><b>${esc(displayName(path))}</b><small>${esc(recentFileWithoutExtension(path))}</small></button>`).join(""):`<div class="recent-empty">No recent reports</div>`;}
  function openEmbeddedLocalTableEditorLegacy(source=activeSource()){
    if(!source||!embeddedLocalSource(source))return;document.querySelector(".local-source-editor")?.close();
    const original=source.query?.data||{},state={columns:(original.columns||[]).map(String),types:(original.types||[]).map(localTypeName),rows:(original.rows||[]).map(row=>Array.isArray(row)?[...row]:(original.columns||[]).map(column=>row?.[column]??null))};while(state.types.length<state.columns.length)state.types.push("System.String");
    const dialog=document.createElement("dialog");dialog.className="source-data-dialog local-source-editor";dialog.innerHTML=`<form method="dialog"><header class="source-data-titlebar"><div><h2>Edit ${esc(source.name)}</h2><p>Embedded local table · saved only inside this Qanvas file</p></div><button value="cancel" aria-label="Close">×</button></header><div class="source-data-toolbar"><button type="button" data-local-add-row>+ Row</button><button type="button" data-local-add-column>+ Column</button><button type="button" data-local-import>Import file…</button><input type="file" data-local-file accept=".csv,.tsv,.json,.jsonl" hidden><span data-local-count></span></div><div class="source-data-grid local-source-grid"><table><thead></thead><tbody></tbody></table></div><footer><span>Column names must be unique. Imported JSON/JSONL should contain objects.</span><button value="cancel">Cancel</button><button value="apply" class="primary">Save table</button></footer></form>`;
    const head=dialog.querySelector("thead"),body=dialog.querySelector("tbody"),count=dialog.querySelector("[data-local-count]"),typeOptions=selected=>[["System.String","Text"],["System.Int32","Integer"],["System.Decimal","Decimal"],["System.Boolean","True / false"],["System.DateTime","Date / time"]].map(([value,label])=>`<option value="${value}" ${value===selected?"selected":""}>${label}</option>`).join("");
    const draw=()=>{head.innerHTML=`<tr><th class="local-source-row-number">#</th>${state.columns.map((column,index)=>`<th><div><input data-local-column="${index}" value="${esc(column)}" aria-label="Column ${index+1} name"><button type="button" data-local-delete-column="${index}" title="Delete column">×</button></div><select data-local-type="${index}" aria-label="${esc(column)} type">${typeOptions(state.types[index])}</select></th>`).join("")}</tr>`;body.innerHTML=state.rows.map((row,rowIndex)=>`<tr><th>${rowIndex+1}<button type="button" data-local-delete-row="${rowIndex}" title="Delete row">×</button></th>${state.columns.map((_,columnIndex)=>`<td><input data-local-cell="${rowIndex}:${columnIndex}" value="${esc(row[columnIndex]??"")}" aria-label="Row ${rowIndex+1}, ${esc(state.columns[columnIndex])}"></td>`).join("")}</tr>`).join("");count.textContent=`${state.rows.length} row${state.rows.length===1?"":"s"} · ${state.columns.length} column${state.columns.length===1?"":"s"}`;};
    const capture=()=>{dialog.querySelectorAll("[data-local-column]").forEach(input=>state.columns[+input.dataset.localColumn]=input.value.trim());dialog.querySelectorAll("[data-local-type]").forEach(select=>state.types[+select.dataset.localType]=select.value);dialog.querySelectorAll("[data-local-cell]").forEach(input=>{const [row,column]=input.dataset.localCell.split(":").map(Number);state.rows[row][column]=input.value;});};
