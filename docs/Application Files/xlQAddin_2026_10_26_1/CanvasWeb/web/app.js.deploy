    queueMicrotask(()=>{const general=panel.querySelector('[data-graphic-general]');if(!general||['graphicText','svgGraphic','valueSelector'].includes(t.kind)||panel.querySelector('[data-graphic-shape]'))return;const nodes=[...panel.childNodes].filter(n=>n!==general),shape=document.createElement('details');shape.dataset.graphicShape='';shape.open=shapeOpen;const summary=document.createElement('summary');summary.textContent=t.kind[0].toUpperCase()+t.kind.slice(1)+' settings';shape.append(summary,...nodes);panel.append(shape);schedulePropertyOrganization();});
    if(t.kind==="graphicText"||t.kind==="svgGraphic"||t.kind==="valueSelector"){
      const roleNames=Object.keys(CanvasTheme.roles(model.settings.theme)),roleOptions=selected=>roleNames.map(role=>`<option value="${esc(role)}" ${role===selected?"selected":""}>${/^color\d+$/.test(role)?`Palette ${role.slice(5)}`:esc(role.replace(/([A-Z])/g," $1"))}</option>`).join(""),required=model.settings.theme?.requireColors===true,resolved=CanvasTheme.resolve(t,model.settings.theme),textRole=t.themeBindings?.textColor||"text",backgroundRole=t.themeBindings?.background||"surface",textUsesTheme=required||!!t.themeBindings?.textColor,backgroundUsesTheme=required||!!t.themeBindings?.background;
      const appearance=t.kind==="graphicText"?`<details data-graphic-appearance open><summary>Text appearance</summary><label class="check"><input data-graphic="useThemeText" type="checkbox" ${textUsesTheme?"checked":""} ${required?"disabled":""}> Use canvas theme text color</label><label>Text theme<select data-graphic="textThemeRole" ${textUsesTheme?"":"disabled"}>${roleOptions(textRole)}</select></label><label>Custom text color<input data-graphic="textColor" type="color" value="${resolved.textColor||"#1f2937"}" ${textUsesTheme?"disabled":""}></label></details>`:"";
      const shape=t.kind==="graphicText"&&t.boxed?`<details data-graphic-shape open><summary>Text box shape</summary><label class="check"><input data-graphic="useThemeBackground" type="checkbox" ${backgroundUsesTheme?"checked":""} ${required?"disabled":""}> Use canvas theme background</label><label>Background theme<select data-graphic="backgroundThemeRole" ${backgroundUsesTheme?"":"disabled"}>${roleOptions(backgroundRole)}</select></label><label>Custom background<input data-graphic="background" type="color" value="${resolved.background||"#ffffff"}" ${backgroundUsesTheme?"disabled":""}></label><label>Shape<select data-graphic="boxShape"><optgroup label="Basic">${[["rectangle","Rectangle"],["circle","Circle"],["oval","Oval"],["diamond","Diamond"],["cylinder","Cylinder"]].map(([value,label])=>`<option value="${value}" ${value===(t.boxShape||"rectangle")?"selected":""}>${label}</option>`).join("")}</optgroup><optgroup label="Flowchart / mind map">${[["tablet","Tablet / terminator"],["document","Document"],["inputOutput","Input / output"],["predefinedProcess","Predefined process"],["preparation","Preparation"],["callout","Callout" ]].map(([value,label])=>`<option value="${value}" ${value===t.boxShape?"selected":""}>${label}</option>`).join("")}</optgroup></select></label></details>`:"";
      panel.innerHTML=geometry+appearance+shape;return;
    }
    const targets=allObjects(page()).filter(item=>item.id!==t.id&&!["connector","line"].includes(item.kind)),choices=value=>`<option value="">Free endpoint</option>${targets.map(item=>`<option value="${item.id}" ${item.id===value?'selected':''}>${esc(item.title||item.kind)}</option>`).join('')}`;
    const styles=[['solid','Solid'],['dotted','Dotted'],['tightDotted','Tight dotted'],['dashed','Dashed'],['longDashed','Long dashed']];
    panel.innerHTML=`${geometry}<div class="property-grid"><label>Line color<input data-graphic="color" type="color" value="${CanvasTheme.resolve(t,model.settings.theme).color||'#475467'}" ${t.themeBindings?.color?"disabled":""}></label>${t.kind==='connector'?`<label class="check"><input data-graphic="useThemeColor" type="checkbox" ${t.themeBindings?.color?"checked":""}> Use canvas theme stroke</label>`:""}${t.kind==='rectangle'?`<label>Fill<input data-graphic="fill" type="color" value="${t.fill||'#ffffff'}" ${t.noFill?'disabled':''}></label>`:''}<label>Thickness<input data-graphic="thickness" type="number" min="1" max="20" value="${t.thickness||2}"></label><label>Line style<select data-graphic="lineStyle">${styles.map(([value,label])=>`<option value="${value}" ${value===(t.lineStyle||'solid')?'selected':''}>${label}</option>`).join('')}</select></label></div>${['line','rectangle'].includes(t.kind)?`<label>Line shading %<input data-graphic="shadePercent" type="range" min="0" max="100" step="5" value="${t.shadePercent||0}"><span>${t.shadePercent||0}%</span></label>`:''}${t.kind==='line'?`<label>Angle<input data-graphic="angle" type="number" min="-180" max="180" value="${t.angle||0}"></label>`:''}${t.kind==='rectangle'?`<label class="check"><input data-graphic="noFill" type="checkbox" ${t.noFill?'checked':''}> No fill (transparent)</label><label>Corner rounding %<input data-graphic="rounding" type="number" min="0" max="50" value="${t.rounding||0}"></label>`:''}${t.kind==='connector'?`<label>Start object<select data-graphic="fromId">${choices(t.fromId)}</select></label><label>End object<select data-graphic="toId">${choices(t.toId)}</select></label><div class="property-grid"><label>Start style<select data-graphic="startStyle">${['none','arrow','point','many'].map(v=>`<option ${v===t.startStyle?'selected':''}>${v}</option>`).join('')}</select></label><label>End style<select data-graphic="endStyle">${['none','arrow','point','many'].map(v=>`<option ${v===t.endStyle?'select