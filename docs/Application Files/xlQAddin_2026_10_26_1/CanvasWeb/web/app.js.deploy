  function renderCanvasObjects(){
    const canvas=$("#canvas");
    canvas.querySelectorAll(".tile").forEach(n=>n.remove());
    const objects=allObjects(page());
    canvas.classList.toggle("canvas-has-visible-text",objects.some(item=>["text","graphicText"].includes(item.kind)&&item.textOverflow==="visible"));
    const emptyState=$("#emptyState"),showLayoutChooser=objects.length===0&&!page().canvas?.layoutChoice;
    emptyState.classList.toggle("hidden",!showLayoutChooser);
    const emptyGallery=emptyState.querySelector("[data-empty-page-layout-gallery]");
    if(showLayoutChooser&&emptyGallery&&!emptyGallery.children.length)emptyGallery.innerHTML=pageLayoutGalleryHtml("data-empty-page-layout");
    [...objects].sort((a,b)=>(a.layer??0)-(b.layer??0)).forEach(t=>{renderQueryContext=displayQueryForTile(t);canvas.insertAdjacentHTML("beforeend",tileHtml(t));renderQueryContext=null;});
    objects.forEach(t=>{const node=canvas.querySelector(`.tile[data-id="${t.id}"]`);if(node)node.style.zIndex=t.layer??0;});
    renderedConnectorSelectionId=selectedTile()?.kind==="connector"?selectedId:null;
    canvas.querySelectorAll("[data-visual-filter-choice],[data-visual-filter-clear],[data-visual-filter-design],[data-visual-filter-select]").forEach(control=>control.addEventListener("pointerdown",event=>event.stopPropagation()));
    bindTiles();
    correctFixedChartText(canvas);
    syncFormatPainterUi();
