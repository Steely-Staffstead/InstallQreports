    let pageLinkSelection=null;
    const savePageLinkSelection=editor=>{
      const selection=window.getSelection();if(!selection?.rangeCount)return;
      const range=selection.getRangeAt(0);if(!editor.contains(range.commonAncestorContainer))return;
      const before=range.cloneRange();before.selectNodeContents(editor);before.setEnd(range.startContainer,range.startOffset);
      pageLinkSelection={editor,start:before.toString().length,end:before.toString().length+range.toString().length};
    };
    const pageLinkTextRange=(editor,start,end)=>{
      const range=document.createRange(),points=[];const walker=document.createTreeWalker(editor,NodeFilter.SHOW_TEXT);let node;
      while(node=walker.nextNode()){
        const before=document.createRange();before.selectNodeContents(editor);before.setEnd(node,0);
        points.push({node,start:before.toString().length,end:before.toString().length+node.length});
      }
      const find=(offset,preferNext=false)=>{for(let index=0;index<points.length;index++){const point=points[index];if(offset<point.start)return {node:point.node,index:0};if(offset<point.end||offset===point.end&&(!preferNext||points[index+1]?.start!==offset))return {node:point.node,index:offset-point.start};}const last=points.at(-1);return last?{node:last.node,index:last.node.length}:null;};
      const first=find(start,true),last=find(end);
