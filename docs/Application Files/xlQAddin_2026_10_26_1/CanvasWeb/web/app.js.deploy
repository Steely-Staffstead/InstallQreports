    if(horizontal&&bar&&workspace){if(position==="top")workspace.prepend(bar);else workspace.querySelector(".statusbar")?.before(bar);}
    leftHeading?.classList.toggle("hidden",horizontal);leftList?.classList.toggle("hidden",horizontal);bar?.classList.toggle("hidden",!horizontal);
    workspace?.classList.toggle("pages-at-top",position==="top");workspace?.classList.toggle("pages-at-bottom",position==="bottom");bar?.classList.toggle("page-list-tabs",tabs);bar?.classList.toggle("page-list-buttons",!tabs);document.querySelector(".left-panel")?.classList.toggle("page-list-tabs",tabs);document.querySelector(".left-panel")?.classList.toggle("page-list-buttons",!tabs);
