  function bindDesignerResize(overlay){const layout=overlay.querySelector(".visual-designer-layout");let resizeState=null;layout.querySelectorAll("[data-splitter]").forEach(splitter=>{splitter.addEventListener("pointerdown",event=>{const box=layout.getBoundingClientRect(),fields=layout.querySelector(".designer-fields").getBoundingClientRect(),options=layout.querySelector(".designer-options").getBoundingClientRect();resizeState={kind:splitter.dataset.splitter,left:box.left,fields:fields.width,options:options.width,pointerId:event.pointerId};splitter.setPointerCapture(event.pointerId);event.preventDefault();});splitter.addEventListener("lostpointercapture",event=>{if(resizeState?.pointerId===event.pointerId)resizeState=null;});});layout.addEventListener("pointermove",event=>{if(!resizeState)return;if(overlay.classList.contains("list-designer-overlay")){if(resizeState.kind!=="preview")return;const gap=6,width=layout.clientWidth,minimumOptions=Math.min(310,Math.max(220,width-gap-280)),minimumPreview=Math.min(380,Math.max(280,width-gap-minimumOptions)),maximumOptions=Math.max(minimumOptions,width-gap-minimumPreview),options=Math.max(minimumOptions,Math.min(event.clientX-resizeState.left,maximumOptions));layout.style.gridTemplateColumns=`${options}px ${gap}px minmax(${minimumPreview}px,1fr)`;return;}const collapsed=layout.classList.contains("fields-collapsed");let fields=collapsed?34:resizeState.fields,options=resizeState.options;if(resizeState.kind==="fields"&&!collapsed)fields=Math.max(180,Math.min(event.clientX-resizeState.left,layout.clientWidth-560));else if(resizeState.kind==="preview")options=Math.max(220,Math.min(event.clientX-resizeState.left-fields-(collapsed?6:12),layout.clientWidth-fields-300));layout.style.gridTemplateColumns=`${fields}px ${collapsed?0:6}px ${options}px 6px minmax(280px,1fr)`;});const finish=event=>{if(!resizeState||event.pointerId!==resizeState.pointerId)return;resizeState=null;};layout.addEventListener("pointerup",finish);layout.addEventLis