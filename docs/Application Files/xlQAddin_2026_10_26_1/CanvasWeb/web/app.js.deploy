    const body=$("#textBodySettings"),textLayout=$("#textLayoutSettings");if(body){general.after(body);if(textLayout)body.after(textLayout);}
    const imageSettings=$("#pictureProperties");if(imageSettings){general.after(imageSettings);imageSettings.append($("#plainTextLabel"));}
