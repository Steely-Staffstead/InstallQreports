    const openSections=new Map(),detailKind=detail=>["multi-card-value-more","multi-card-value-placement","multi-card-cell-display","column-bars","matrix-conditional-options"].find(name=>detail.classList.contains(name))||detail.querySelector(":scope>summary")?.textContent.trim()||"details",detailKey=detail=>{const row=detail.closest("[data-metric-index]");if(row){const metric=state.metrics[+row.dataset.metricIndex];return`metric:${metric?.id||row.dataset.metricIndex}:${detailKind(detail)}`;}return`section:${detailKind(detail)}`;},rememberOpenSections=()=>options.querySelectorAll("details").forEach(detail=>openSections.set(detailKey(detail),detail.open)),restoreOpenSections=()=>options.querySelectorAll("details").forEach(detail=>{const key=detailKey(detail);if(openSections.has(key))detail.open=openSections.get(key);});
    function compactMultiCardValueRows(){for(const row of options.querySelectorAll("[data-metric-index]")){if(row.querySelector(":scope > .multi-card-value-more"))continue;const formatControl=row.querySelector(":scope > .multi-card-value-format"),alignControl=row.querySelector(":scope > .multi-card-value-align");if(!formatControl||!alignControl)continue;const details=document.createElement("details"),summary=document.createElement("summary"),body=document.createElement("div");details.className="multi-card-value-more";summary.textContent="More";body.className="multi-card-value-more-body";row.insertBefore(details,formatControl);details.append(summary,body);for(const control of [formatControl,alignControl,...row.querySelectorAll(":scope > .multi-card-value-placement, :scope > .multi-card-cell-display, :scope > .column-bars, :scope > .matrix-conditional-options")])body.append(control);}}
    const drawPreview=()=>{compactMultiCardValueRows();preview.innerHTML=tileBody({...tile,design:{...(tile.design||{}),multiCardSpec:state}});};
    const rendererEditor=metric=>{const renderer=metric.renderer||={type:"Number"},type=renderer.type||"Number",roles=["accent","positive","negative","color1","color2","color3","color4"];return`<details class="multi-card-cell-display"><summary>Cell display · ${esc(type)}</summary><label>Renderer<select data-metric-renderer="type">${["Number","Image","Badge","Icon","DataBar"].map(value=>`<option value="${value}" ${type===value?"selected":""}>${value}</option>`).join("")}</select></label>${type==="Image"?`<div class="property-grid"><label>Height<input type="number" min="20" max="160" data-metric-renderer="height" value="${+renderer.height||48}"></label><label>Fit<select data-metric-renderer="fit"><option value="contain" ${renderer.fit!=="cover"&&renderer.fit!=="fill"?"selected":""}>Contain</option><option value="cover" ${renderer.fit==="cover"?"selected":""}>Cover</option><option value="fill" ${renderer.fit==="fill"?"selected":""}>Fill</option></select></label></div>`:""}${type==="Badge"?`<label>Badge shape<select data-metric-renderer="shape">${[["pill","Pill"],["rounded","Rounded"],["square","Square"],["circle","Circle"]].map(([value,label])=>`<option value="${value}" ${renderer.shape===value?"selected":""}>${label}</option>`).join("")}</select></label>`:""}${type==="Icon"?`<div class="property-grid"><label>Icon<select data-metric-renderer="icon">${["Circle","Check","Warning","Up","Down","Diamond"].map(value=>`<option ${renderer.icon===value?"selected":""}>${value}</option>`).join("")}</select></label><label>Position<select data-metric-renderer="iconPosition"><option value="left" ${renderer.iconPosition!=="right"?"selected":""}>Left</option><option value="right" ${renderer.iconPosition==="right"?"selected":""}>Right</option></select></label></div><label class="check"><input type="checkbox" data-metric-renderer="showValue" ${renderer.showValue!==false?"checked":""}> Show value</label>`:""}${["Badge","Icon"].includes(type)?`<div class="property-grid"><label>Color sourc