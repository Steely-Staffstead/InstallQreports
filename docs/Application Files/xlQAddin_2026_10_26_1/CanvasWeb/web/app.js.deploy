    };
    for(const index of selectedIndexes||[]){const selected=pages[+index];if(!selected)continue;visit(selected);if((selected.tiles||[]).some(tile=>!tile.sourceId))ids.add("main");}
    return[...ids];
  }
  function importedSourceChoices(source){
    const footprint=importedSourceFootprint(source),equivalent=(model.sources||[]).filter(candidate=>importedSourceFootprint(candidate)===footprint),id=String(source.id??source.Id??"main"),name=String(source.name??source.Name??id),collision=(model.sources||[]).filter(candidate=>String(candidate.id).toLowerCase()===id.toLowerCase()||String(candidate.name||"").toLowerCase()===name.toLowerCase());
