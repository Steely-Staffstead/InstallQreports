    const svgInstructionField=panel.querySelector("[data-svg-instructions]");
    if(svgInstructionField)svgInstructionField.value=`When editing a complete Qanvas document, the containing object must use kind "svgGraphic" and nested svgGraphic.template "manual" (lowercase), with the standalone SVG stored only in nested svgGraphic.svgCode. Never omit the template or add root-level template/svgCode. When pasting into this Manual SVG code field, paste only the standalone <svg> element.\n\nFor reusable data-driven custom graphics, use nested svgGraphic.dataBindings. categoryLists bind unique source values to ordered data-qanvas-field text targets. dateMarker binds a detected Today/I dag label and marker line to today, a fixed date, a field, or a parameter over an explicit visible date range. Keep these semantic bindings separate from the raw SVG geometry so users can edit them in the SVG designer.\n\n${svgInstructionField.value}`;
    panel.querySelector('[data-group="content"]')?.insertAdjacentHTML("beforeend",'<p class="property-empty">Updates when you leave Text or Subtext. Use {{week}}, {{measure:maxtemperature_last}}, or {{field:date}}.</p>');
