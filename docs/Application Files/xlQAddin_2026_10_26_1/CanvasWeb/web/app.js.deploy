  document.addEventListener("contextmenu",event=>{
    const node=event.target.closest?.(".tile"),target=allObjects(page()).find(item=>item.id===node?.dataset.id),command=target?.kind==="multiCard"?"designMultiCard":target?.kind==="svgGraphic"?"designSvg":"";
