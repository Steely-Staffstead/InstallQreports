    const metricVisualEditors=metric=>`${dataBarPropertiesHtml(metric,all)}${matrixConditionalPropertiesHtml(metric,all,{band:true})}`;
    const placementEditor=metric=>{const columns=Math.max(1,Math.min(6,+state.metricColumns||3)),span=metric.rowSpan==="full"?"full":Math.max(1,Math.min(6,+metric.rowSpan||1)),summaryColumn=+metric.column?`column ${metric.column}`:"Auto",summarySpan=span==="full"?"full column":`${span} row${span===1?"":"s"}`;return`<details class="multi-card-value-placement"><summary>Placement · ${summaryColumn} · ${summarySpan}</summary><div class="property-grid"><label>Column<select data-metric="column"><option value="0" ${!+metric.column?"selected":""}>Auto flow</option>${Array.from({length:columns},(_,index)=>`<option value="${index+1}" ${+metric.column===index+1?"selected":""}>Column ${index+1}</option>`).join("")}</select></label><label>Height<select data-metric="rowSpan">${[1,2,3,4,5,6].map(value=>`<option value="${value}" ${span===value?"selected":""}>${value} row${value===1?"":"s"}</option>`).join("")}<option value="full" ${span==="full"?"selected":""}>Full column</option></select></label></div><small>Fix a visual to a column and let the other values flow around it. Full column spans the rows needed by the remaining values.</small></details>`;};
    const drawOptions=()=>{const appearance=state.appearance||={};options.innerHTML=`<details open><summary>Grouping and layout</summary><div class="svg-binding-drop" data-drop-zone="multi-group"><b>${state.groupField?esc(state.groupField):"Drop a grouping dimension here"}</b><small>One card is created for every unique value.</small></div><label>Group by<select data-mc="groupField">${optionList(fields,state.groupField,"One card (no grouping)")}</select></label><label>Group order<select data-mc="groupSort"><option value="source" ${state.groupSort==="source"?"selected":""}>Source order</option><option value="ascending" ${state.groupSort==="ascending"?"selected":""}>A–Z</option><option value="descending" ${state.groupSort==="descending"?"selected":""}>Z–A</option></select></label><div class="property-grid"><label>Cards per row<select data-mc="cardColumns"><option value="0" ${!+state.cardColumns?"selected":""}>Automatic</option>${[1,2,3,4,5,6].map(value=>`<option value="${value}" ${+state.cardColumns===value?"selected":""}>${value}</option>`).join("")}</select></label><label>Values per card row<select data-mc="metricColumns">${[1,2,3,4,5,6].map(value=>`<option value="${value}" ${+state.metricColumns===value?"selected":""}>${value}</option>`).join("")}</select></label><label>Auto minimum width<input type="number" min="160" max="800" data-mc="minCardWidth" value="${+state.minCardWidth||260}"></label><label>Maximum cards<input type="number" min="1" max="500" data-mc="limit" value="${+state.limit||100}"></label></div></details><details open><summary>Card text</summary><label>Heading template<input data-mc="headerTemplate" value="${esc(state.headerTemplate||"{{group}}")}"></label><label>Supporting text<input data-mc="subheaderTemplate" value="${esc(state.subheaderTemplate||"")}" placeholder="Optional text or {{field:Date}}"></label><small>Tokens: <code>{{group}}</code>, <code>{{field:Amount|Sum}}</code>, <code>{{measure:Sales}}</code>, and <code>{{parameter:Year}}</code>.</small></details><details open><summary>Values</summary><div class="multi-card-values-well" data-drop-zone="multi-values">${state.metrics.map((metric,index)=>`<div class="multi-card-value-row" data-metric-index="${index}"><span class="designer-drag-handle" title="Value ${index+1}">☷</span><select data-metric="field">${optionList(all,metric.field,"Choose field or measure…")}</select>${measureSet.has(String(metric.field||"").toLowerCase())?'<span class="chart-measure-badge">Measure</span>':`<select data-metric="aggregation" aria-label="Aggregation">${aggregationOptions(metric.aggregation)}</select>`}<label class="multi-card-value-caption">Caption<input data-metric="caption" value="${esc(metric.caption||metric.field||"")}"></label><label class="multi-card-value-format">Format<select data-metric="format">${formatOptions(metric.format)}</select></label><label class="multi-card-value-align">Align<select data-metric="align">${["left","center","right"].map(value=>`<option ${value===metric.align?"selected":""}>${value[0].toUpperCase()+value.slice(1)}</option>`).join("")}</select></label><div class="multi-card-value-actions"><button type="button" data-metric-move="-1" ${index===0?"disabled":""} title="Move up">↑</button><button type="button" data-metric-move="1" ${index===state.metrics.length-1?"disabled":""} title="Move down">↓</button><button type="button" data-metric-remove title="Remove">×</button></div></div>`).join("")||'<p class="property-empty">Drop fields or measures here.</p>'}</div><button type="button" data-metric-add>+ Add value</button></details><details><summary>Card appearance</summary><label class="check"><input type="checkbox" data-mc-appearance="useTheme" ${appearance.useTheme!==false?"checked":""}> Use canvas theme colors</label><div class="property-grid"><label>Background<input type="color" data-mc-appearance="background" value="${appearance.background||"#ffffff"}" ${appearance.useTheme!==false?"disabled":""}></label><label>Border<input type="color" data-mc