  const propertySectionState=new Map();
  function schedulePropertyOrganization(){if(schedulePropertyOrganization.queued)return;schedulePropertyOrganization.queued=true;queueMicrotask(()=>{schedulePropertyOrganization.queued=false;organizeTilePropertySections(false);});}
  function propertySummary(section,label){const summary=section?.querySelector(":scope > summary");if(!summary||!label)return summary;const text=[...summary.childNodes].find(node=>node.nodeType===Node.TEXT_NODE);if(text)text.textContent=label;else summary.prepend(document.createTextNode(label));return summary;}
