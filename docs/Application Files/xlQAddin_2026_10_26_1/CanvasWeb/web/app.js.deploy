    if(!controls){controls=document.createElement("div");controls.id="visualTypography";controls.innerHTML='<div class="property-grid"><label>Font<select data-visual-type="fontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-visual-type="fontSize" type="number" min="8" max="72"></label></div><div class="property-grid"><label>Background<input data-visual-type="background" type="color"></label></div><div class="header-emphasis"><label class="check"><input data-visual-type="bold" type="checkbox"> Bold</label><label class="check"><input data-visual-type="italic" type="checkbox"> Italic</label><label class="check"><input data-visual-type="underline" type="checkbox"> Underline</label></div>';panel.querySelector("summary")?.after(controls);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.visualType;if(!["table","matrix"].includes(t?.kind)||!key)return;t.appearance||={};t.appearance[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?Math.max(8,+event.target.value||12):event.target.value;if(key==="background"){t.appearance.colorOverrides||={};t.appearance.colorOverrides.background=true;}markDirty();render();});}
