    const kind=$("#activeSourceKind"),queryAction=summary.querySelector("[data-source-query-action]"),measureAction=summary.querySelector("[data-source-measure-action]"),ganttAction=summary.querySelector("[data-source-gantt-action]"),destructive=summary.querySelector("[data-source-destructive]"),destructiveLabel=summary.querySelector("[data-source-destructive-label]");
