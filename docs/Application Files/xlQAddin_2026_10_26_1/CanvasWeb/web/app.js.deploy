    overlay.classList.add("multi-card-designer");const previewHeading=overlay.querySelector(".designer-preview h3");previewHeading.textContent="Repeated card preview";previewHeading.insertAdjacentHTML("afterend",'<nav class="designer-preview-nav" aria-label="Preview controls"><button type="button" data-mc-preview-jump="layout">Layout</button><button type="button" data-mc-preview-jump="spacing">Column spacing</button><button type="button" data-mc-preview-jump="heading">Heading</button><button type="button" data-mc-preview-jump="supporting">Supporting text</button><button type="button" data-mc-preview-jump="caption">Value caption</button><button type="button" data-mc-preview-jump="value">Value</button><button type="button" data-mc-preview-jump="appearance">Card appearance</button></nav>');overlay.querySelector(".designer-fields h3").textContent="Fields & measures";overlay.querySelector(".designer-fields p").textContent="Drag a dimension to Group, or a field/measure to Values.";state.metrics=(state.metrics||[]).map(item=>({id:item.id||uid(),aggregation:"First",format:"Auto",...item,align:String(item.align||"left").toLowerCase(),renderer:{type:"Number",...(item.renderer||{})}}));
    const optionList=(items,selected,empty="None")=>`<option value="">${empty}</option>${items.map(name=>`<option value="${esc(name)}" ${name===selected?"selected":""}>${esc(name)}</option>`).join("")}`,aggregationOptions=current=>["First","Sum","Average","Min","Max","Count"].map(value=>`<option ${value===(current||"First")?"selected":""}>${value}</option>`).join(""),formatOptions=current=>["Auto","N0","N1","N2","K0","K1","M0","M1","P0","P1","P2","yyyy-MM-dd","MMM yyyy"].map(value=>`<option ${value===(current||"Auto")?"selected":""}>${value}</option>`).join(""),typographyEditor=(level,label)=>{const value=state.typography[level],fonts=["inherit","Segoe UI","Arial","Calibri","Georgia","Tahoma","Times New Roman","Verdana"];return`<fieldset class="multi-card-typography"><legend>${label}</legend><div class="property-grid"><label>Font<select data-mc-text="fontFamily" data-mc-text-level="${level}">${fonts.map(font=>`<option value="${font}" ${value.fontFamily===font?"selected":""}>${font==="inherit"?"Canvas default":font}</option>`).join("")}</select></label><label>Size<input type="number" min="8" max="72" data-mc-text="fontSize" data-mc-text-level="${level}" value="${value.fontSize}"></label><label>Weight<select data-mc-text="fontWeight" data-mc-text-level="${level}">${[[300,"Light"],[400,"Regular"],[500,"Medium"],[600,"Semi-bold"],[700,"Bold"],[800,"Extra-bold"]].map(([weight,name])=>`<option value="${weight}" ${+value.fontWeight===weight?"selected":""}>${name}</option>`).join("")}</select></label><label>Align<select data-mc-text="align" data-mc-text-level="${level}">${["left","center","right"].map(align=>`<option value="${align}" ${value.align===align?"selected":""}>${align[0].toUpperCase()+align.slice(1)}</option>`).join("")}</select></label><label class="check"><input type="checkbox" data-mc-text="italic" data-mc-text-level="${level}" ${value.italic?"checked":""}> Italic</label><label class="check"><input type="checkbox" data-mc-text="underline" data-mc-text-level="${