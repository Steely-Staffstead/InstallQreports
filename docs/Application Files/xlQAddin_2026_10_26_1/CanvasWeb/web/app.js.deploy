    const gantt=source.kind==="gantt";queryAction?.classList.toggle("hidden",gantt);measureAction?.classList.toggle("hidden",gantt);ganttAction?.classList.toggle("hidden",!gantt);if(queryAction){queryAction.dataset.action=local?"editLocalData":"editQuery";queryAction.title=storage==="file"?"Edit this machine-local Manual table":local?"Edit rows and columns stored inside this Qanvas file":"Edit this source query";queryAction.innerHTML=local?'<span aria-hidden="true">▦</span> Data':'<span aria-hidden="true">⌁</span> Query';}
