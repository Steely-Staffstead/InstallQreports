    const rendererEditor=metric=>{const renderer=metric.renderer||={type:"Number"},type=renderer.type||"Number",roles=["accent","positive","negative","color1","color2","color3","color4"];return`<details class="multi-card-cell-display"><summary>Cell display · ${esc(type)}</summary><label>Renderer<select data-metric-renderer="type">${["Number","Image","Badge","Icon","DataBar"].map(value=>`<option value="${value}" ${type===value?"selected":""}>${value}</option>`).join("")}</select></label>${type==="Image"?`<div class="property-grid"><label>Height<input type="number" min="20" max="160" data-metric-renderer="height" value="${+renderer.height||48}"></label><label>Fit<select data-metric-renderer="fit"><option value="contain" ${renderer.fit!=="cover"&&renderer.fit!=="fill"?"selected":""}>Contain</option><option value="cover" ${renderer.fit==="cover"?"selected":""}>Cover</option><option value="fill" ${renderer.fit==="fill"?"selected":""}>Fill</option></select></label></div>`:""}${type==="Badge"?`<label>Badge shape<select data-metric-renderer="shape">${[["pill","Pill"],["rounded","Rounded"],["square","Square"],["circle","Circle"]].map(([value,label])=>`<option value="${value}" ${renderer.shape===value?"selected":""}>${label}</option>`).join("")}</select></label>`:""}${type==="Icon"?`<div class="property-grid"><label>Icon<select data-metric-renderer="icon">${["Circle","Check","Warning","Up","Down","Diamond"].map(value=>`<option ${renderer.icon===value?"selected":""}>${value}</option>`).join("")}</select></label><label>Position<select data-metric-renderer="iconPosition"><option value="left" ${renderer.iconPosition!=="right"?"selected":""}>Left</option><option value="right" ${renderer.iconPosition==="right"?"selected":""}>Right</option></select></label></div><label class="check"><input type="checkbox" data-metric-renderer="showValue" ${renderer.showValue!==false?"checked":""}> Show value</label>`:""}${["Badge","Icon"].includes(type)?`<div class="property-grid"><label>Color sourc