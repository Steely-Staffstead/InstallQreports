    const placementEditor=metric=>{const columns=Math.max(1,Math.min(6,+draft.metricColumns||2)),span=metric.rowSpan==="full"?"full":Math.max(1,Math.min(6,+metric.rowSpan||1)),summaryColumn=+metric.column?`column ${metric.column}`:"Auto",summarySpan=span==="full"?"full column":`${span} row${span===1?"":"s"}`;return`<details class="multi-card-value-placement"><summary>Placement · ${summaryColumn} · ${summarySpan}</summary><div class="property-grid"><label>Column<select data-vf-value="column"><option value="0" ${!+metric.column?"selected":""}>Auto flow</option>${Array.from({length:columns},(_,index)=>`<option value="${index+1}" ${+metric.column===index+1?"selected":""}>Column ${index+1}</option>`).join("")}</select></label><label>Height<select data-vf-value="rowSpan">${[1,2,3,4,5,6].map(value=>`<option value="${value}" ${span===value?"selected":""}>${value} row${value===1?"":"s"}</option>`).join("")}<option value="full" ${span==="full"?"selected":""}>Full column</option></select></label></div><small>Fix a value to a column, span several rows, or let values flow automatically.</small></details>`;};
    const valueRow=(metric,index)=>`<div class="multi-card-value-row visual-filter-value-editor" data-vf-value-index="${index}"><span class="designer-drag-handle" title="Value ${index+1}">☷</span><select data-vf-value="field">${fieldOptions(metric.field,true)}</select>${sourceParts().measures.some(name=>name.toLowerCase()===String(metric.field).toLowerCase())||metric.field==="__count__"?'<span class="chart-measure-badge">Value</span>':`<select data-vf-value="aggregation" aria-label="Aggregation">${aggregationOptions(metric.aggregation)}</select>`}<label class="multi-card-value-caption">Caption<input data-vf-value="caption" data-vf-token value="${esc(metric.caption||"")}" placeholder="Optional caption"></label><details class="multi-card-value-more"><summary>More</summary><div class="multi-card-value-more-body"><label class="multi-card-value-format">Format<select data-vf-value="format">${formatOptions(metric.format)}</select></label>${metric.format==="Custom"?`<label class="multi-card-value-custom-format">Custom format<input data-vf-value="customFormat" value="${esc(metric.customFormat||"+0.0;-0.0;0.0")}" placeholder="+0.0;-0.0;0.0"><small>Positive; negative; zero. Example: <code>+0.0;-0.0;0.0</code></small></label>`:""}<label class="multi-card-value-font-size">Font size<input data-vf-value="fontSize" type="number" min="8" max="72" value="${Math.max(8,Math.min(72,+metric.fontSize||14))}"></label><label class="multi-card-value-align">Align<select data-vf-value="align">${["left","center","right"].map(value=>`<option value="${value}" ${value===(metric.align||"right")?"selected":""}>${value[0].toUpperCase()+value.slice(1)}</option>`).join("")}</select></label><label class="multi-card-value-caption-position">Caption position<select data-vf-value="captionPosition">${[["below","Below value"],["left","Left of value"],["right","Right of value"]].map(([value,label])=>`<option value="${value}" ${value===(metric.captionPosition||"below")?"selected":""}>${label}</option>`).join(""