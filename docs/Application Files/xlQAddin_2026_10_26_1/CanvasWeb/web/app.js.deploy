    const send=()=>{const attachments=pendingAttachments.filter(item=>item.path&&!item.error).map(item=>item.path),message=composer.value.trim()||(attachments.length?"Use the attached workspace files as context for this change.":"");if(!message||!available||pendingAttachments.some(item=>item.saving))return;const attachmentNames=pendingAttachments.filter(item=>item.path).map(item=>item.name);if(aiMode==="cli"){post("sendAiTurn",{message,attachments,document:fileDocument()});const providerName=cliProvider==="copilot"?"GitHub Copilot":cliProvider==="claude"?"Claude Code":"Codex";status.textContent=running?"Request added to the queue.":`Starting ${providerName}${attachmentNames.length?` with ${attachmentNames.length} file${attachmentNames.length===1?"":"s"}`:""}…`;}else{post("updateAiRequest",{question:message,attachments,recordChat:aiMode==="external",external:aiMode==="external"});status.textContent=aiMode==="external"?"Request added to the external queue.":"Request updated. Upload the support-pack files when ready.";}composer.value="";pendingAttachments=[];renderAttachments();chatFollow=true;appendBubble("user",message+(attachmentNames.length?`\n\nAttached: ${attachmentNames.join(", ")}`:""));chat.scrollTop=chat.scrollHeight;};
    applyMode(aiMode);setAvailability(false);
    const aiLauncher=document.querySelector('[data-action="exportAiAssistant"]'),syncAiLauncher=()=>{const open=dialog.open;aiLauncher?.setAttribute("aria-expanded",String(open));aiLauncher?.setAttribute("aria-label",open?"Close Qanvas AI":"Open Qanvas AI");if(aiLauncher)aiLauncher.title=open?"Close Qanvas AI":"Open Qanvas AI";};
    dialog.addEventListener("close",syncAiLauncher);syncAiLauncher();
    aiLauncher?.addEventListener("click",()=>{if(!host){$("#saveStatus").textContent="AI collaboration requires the desktop application.";return;}if(dialog.open){dialog.close();return;}updatePrompt();if(aiMode!=="manual")composer.value="";dialog.show();syncAiLauncher();post("initializeAiAssistant");if(aiMode!=="manual")composer.focus();});
    const addAttachmentFiles=files=>{if(!files.length)return;if(!available){status.textContent="Create or reconnect an AI workspace before attaching files.";return;}for(const file of files.slice(0,8-pendingAttachments.length)){if(file.size>16*1024*1024){status.textContent=`${file.name||"A file"} is larger than 16 MB.`;continue;}const id=crypto.randomUUID(),reader=new FileReader(),image=file.type.startsWith("image/"),item={id,name:file.name||"attachment",path:"",preview:"",image,saving:true,error:""};pendingAttachments.push(item);reader.onload=()=>{item.preview=String(reader.result||"");renderAttachments();post("addAiAttachment",{requestId:id,name:item.name,dataUrl:item.preview});status.textContent="Saving attached file in the workspace…";};reader.onerror=()=>{item.saving=false;item.error="Could not read file";renderAttachments();};reader.readAsDataURL(file);}renderAttachments();};
    composer.addEventListener("paste",event=>{const files=[...(event.clipboardData?.items||[])].filter(item=>item.kind==="file").map(item=>item.getAsFile()).filter(Boolean);if(!files.length)return;event.preventDefault();addAttachmentFiles(files);});
    fileInput.addEventListener("change",()=>{addAttachmentFiles([...fileInput.files]);fileInput.value="";});
    composer.addEventListener("keydown",event=>{if(event.key==="Enter"&&!event.shiftKey){event.preventDefault();send();}});
    const contextMenu=document.createElement("div");contextMenu.className="canvas-ai-context-menu";contextMenu.hidden=true;document.body.append(contextMenu);const hideContextMenu=()=>{contextMenu.hidden=true;contextMenu.replaceChildren();};const showContextMenu=(event,label,action)=>{event.preventDefault();contextMenu.replaceChildren();const button=document.createElement("button");button.type="button";button.textContent=label;button.onclick=()=>{hideContextMenu();action();};contextMenu.append(button);contextMenu.hidden=false;const width=190,height=42;contextMenu.style.left=`${Math.min(event.clientX,innerWidth-width-8)}px`;contextMenu.style.top=`${Math.min(event.clientY,innerHeight-height-8)}px`;button.focus();};
    chat.addEventListener("contextmenu",event=>{const bubble=event.target.closest(".canvas-ai-message");if(!bubble)return;showContextMenu(event,"Copy message",async()=>{const text=bubble.querySelector("pre")?.textContent||"";try{await navigator.clipboard.writeText(text);}catch{const range=document.createRange();range.selectNodeContents(bubble.querySelector("pre"));const selection=getSelection();selection.removeAllRanges();selection.addRange(range);document.execCommand("copy");selection.removeAllRanges();}status.textContent="Message copied.";});});
    queueList.addEventListener("contextmenu",event=>{const row=event.target.closest("li[data-turn-id]");if(!row)return;if(row.dataset.queueState==="running"){event.preventDefault();status.textContent="Stop the active AI turn before removing it.";return;}showContextMenu(event,"Remove from queue",()=>{post("deleteAiQueueItem",{turnId:row.dataset.turnId});status.textContent="Removing request from the queue…";});});
    document.addEventListener("pointerdown",event=>{if(!contextMenu.hidden&&!contextMenu.contains(event.target))hideContextMenu();});window.addEventListener("blur",hideContextMenu);window.addEventListener("resize",hideContextMenu);
    dialog.addEventListener("click",async event=>{const modeButton=event.target.closest("button[data-ai-mode]");if(modeButton){applyMode(modeButton.dataset.aiMode);setAvailability(available);return;}const target=event.target.closest("[data-ai]"),action=target?.dataset.ai;if(!action)return;if(action==="send")send();else if(action==="attachFiles")fileInput.click();else if(action==="stop")post("stopAiTurn");else if(action==="removeAttachment"){pendingAttachments=pendingAttachments.filter(item=>item.id!==target.dataset.attachmentId);renderAttachments();}else if(action==="newConversation"){if(await window.QReportsDialogs.confirm("Start a new AI conversation? This clears the chat history but keeps the current canvas."))post("resetAiConversation");}else if(action==="copyPrompt"){const field=dialog.querySelector('[data-ai-prompt]');try{await navigator.clipboard.writeText(field.value);}catch{field.select();document.execCommand('copy');}status.textContent="Prompt copied.";}else if(action==="pack"||action==="skill"){status.textContent="Choose the parent folder for a new AI workspace…";post("exportAiPack",{document:fileDocument(),question:aiMode==="manual"?"":composer.value,includeSkill:action==="skill"||aiMode==="external",workflowMode:action==="skill"?"cli":aiMode});}else if(action==="choose")post("chooseAiWorkingFile");else if(action==="reload"){if(dirty&&!await window.QReportsDialogs.confirm("Reload the AI working file and discard unsaved changes in the current canvas?"))return;post("reloadAiWorkingFile");}else if(action==="folder")post("openAiWorkingFolder");});
    setInterval(()=>{if(dialog.open&&host)post("getAiConversationState");},900);
    host?.addEventListener("message",event=>{const message=event.data;if(message.type==="aiPackExported"||message.type==="aiWorkingFileState"){available=!!message.file;workingFolder=available?message.folder:"";workingFileName=available?String(message.file).split(/[\\/]/).pop():workingFileName;updatePrompt();updateConnectionSummary(message);setAvailability(available);workspaceLabel.textContent=available?workingFolder:"No workspace connected";workspaceLabel.title=available?workingFolder:"No workspace connected";if(aiMode==="manual"&&message.type==="aiWorkingFileState"&&message.question&&!composer.value)composer.value=message.question;status.textContent=message.type==="aiPackExported"?(message.mode==="external"?"External workspace created. Attach it to ChatGPT Work and keep that task active while it monitors requests.":message.mode==="manual"?"Support pack created. Upload its files to your chosen AI chat.":"CLI workspace created. Write a request and choose Send."):(available?`Connected to ${workingFileName}.`:"No workspace is connected to this report. Create a new workspace or reconnect one explicitly.");if(available)post("getAiConversationState");}else if(message.type==="aiConversationState"){available=!!message.available;if(message.folder){workingFolder=message.folder;workingFileName=String(message.file||workingFileName).split(/[\\/]/).pop();workspaceLabel.textContent=workingFolder;workspaceLabel.title=workingFolder;updatePrompt();}setAvailability(available);renderConversation(message);}else if(message.type==="aiAttachmentAdded"){const attachment=pendingAttachments.find(item=>item.id===message.requestId);if(attachment){attachment.path=message.path;attachment.name=message.name;attachment.saving=false;renderAttachments();status.textContent="File attached. Add your explanation and choose Send.";}}else if(message.type==="aiAttachmentFailed"){const attachment=pendingAttachments.find(item=>item.id===message.requestId);if(attachment){attachment.saving=false;attachment.error=message.message||"Could not save file";renderAttachments();}status.textContent=message.message||"Could not save file.";}else if(message.type==="aiQueueAttachmentPreview"){if(queueEditor.open&&queueEditor.dataset.turnId===message.turnId){const figure=[...queueEditor.querySelectorAll('figure')].find(node=>node.dataset.path===message.path),image=figure?.querySelector('img');if(image&&message.dataUrl)image.src=message.dataUrl;}}else if(message.type==="aiQueueItemUpdated"){status.textContent="Queued request updated.";post("getAiConversationState");}else if(message.type==="aiQueueItemDeleted"){status.textContent="Request removed from the queue.";post("getAiConversationState");}else if(message.type==="aiRequestUpdated")status.textContent=message.external?"Request published. Keep the external Work task active and monitoring this folder.":`REQUEST.md updated in ${message.folder}. Upload the support pack when ready.`;else if(message.type==="aiPackFailed")status.textContent=message.message||"AI operation failed.";});
  }
  const baseCellRendererPropertiesHtml=cellRendererPropertiesHtml;
  cellRendererPropertiesHtml=selected=>{
    if(!selected)return"";
    const renderer=selected.renderer||{},type=renderer.type||(imageFieldName(selected.field)?"Image":"Number");
    let output=baseCellRendererPropertiesHtml(selected),options=["Number","Image","Badge","Icon","DataBar"].map(value=>`<option ${type===value?"selected":""}>${value}</option>`).join("");
    output=output.replace(/<select data-cell-renderer="type">[\s\S]*?<\/select>/,`<select data-cell-renderer="type">${options}</select>`);
    if(type==="Image"){
      const controls=`<div class="property-grid"><label>Image height<input type="number" min="20" max="160" data-cell-renderer="height" value="${Math.max(20,Math.min(160,+renderer.height||48))}"></label><label>Fit<select data-cell-renderer="fit"><option value="contain" ${renderer.fit!=="cover"&&renderer.fit!=="fill"?"selected":""}>Contain</option><option value="cover" ${renderer.fit==="cover"?"selected":""}>Cover</option><option value="fill" ${renderer.fit==="fill"?"selected":""}>Stretch</option></select></label></div><label>Corner rounding<input type="number" min="0" max="50" data-cell-renderer="radius" value="${Math.max(0,Math.min(50,+renderer.radius||6))}"></label><small>HTTP(S), data-image, and blob URLs are supported. Click an image to open it.</small>`;
      output=output.replace(/(<select data-cell-renderer="type">[\s\S]*?<\/select><\/label>)/,`$1${controls}`);
    }
    return output;
  };
  bindCellRenderer=(container,selected,refresh,redraw=refresh)=>{container.querySelectorAll("[data-cell-renderer]").forEach(input=>input.addEventListener("change",()=>{selected.renderer||={};selected.renderer[input.dataset.cellRenderer]=input.type==="checkbox"?input.checked:input.type==="number"?Number(input.value):input.value;if(input.dataset.cellRenderer==="type"){if(input.value==="Image"&&selected.aggregation==="Sum")selected.aggregation="Max";redraw();}else refresh();}));};
  const tileTitleInput=$("#tileTitle");if(tileTitleInput){tileTitleInput.placeholder="Title or {{parameter:name}}";tileTitleInput.title="Use {{name}} or {{parameter:name}} to insert a parameter value.";}
  setupAiAssistant();
  const sourceLabel=document.querySelector(".query-summary dt");if(sourceLabel)sourceLabel.textContent="Source";
  const themeControls=CanvasThemeControls.install({model:()=>model,selected:selectedTile,selection:matchingSelectedObjects,changed:()=>{markDirty();render();}});window.addEventListener("qreports-settings-changed",()=>{if(!dirty&&!originalQrcn&&model.name==="Untitled report"&&!allObjects(page()).length){model=newDocument();model=normalize(model);resetHistory();}render();});setupUpdateMenu();setupAlignMenu();setupCanvasComponents();render();resetHistory();post("ready");
})();
