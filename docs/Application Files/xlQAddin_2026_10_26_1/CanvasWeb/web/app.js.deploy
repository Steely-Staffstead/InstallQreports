  const matrixValueText=(value,column)=>esc(matrixValueMissing(value)?(column.missingText??""):format(value,column.format||column.Format||"Auto"));
  const imageFieldName=field=>/(?:^|[^a-z0-9])(image(?:_?url)?|avatar|photo|thumbnail|logo)(?:$|[^a-z0-9])/i.test(String(field||""));
  function safeCellImageUrl(value){const text=String(value??"").trim(),markdown=/^\[[^\]]*\]\((https?:\/\/[^\s)]+)(?:\s+"[^"]*")?\)$/.exec(text),url=markdown?.[1]||text;return /^(?:https?:\/\/|data:image\/(?:png|jpeg|jpg|gif|webp|svg\+xml);|blob:)/i.test(url)?url:"";}
  function imageCell(value,column,renderer){const url=safeCellImageUrl(value);if(!url)return esc(format(value,column.format||column.Format||"Auto"));const height=Math.max(20,Math.min(160,+renderer.height||48)),radius=Math.max(0,Math.min(50,+renderer.radius||6)),fit=["cover","fill"].includes(renderer.fit)?renderer.fit:"contain",label=column.caption||column.field||"Image";return `<a class="cell-renderer-image" href="${esc(url)}" target="_blank" rel="noopener noreferrer" title="Open ${esc(label)}" style="display:inline-flex;align-items:center;justify-content:center;max-width:180px;vertical-align:middle"><img src="${esc(url)}" alt="${esc(label)}" loading="lazy" style="display:block;width:auto;max-width:100%;min-width:20px;height:${height}px;object-fit:${fit};border-radius:${radius}px"></a>`;}
  function matrixVisualCell(value,column,row,columns,maxAbs=1,rowKind="detail"){
    if(matrixValueMissing(value))return esc(column.missingText??"");
    return matrixConditionalCell(value,column,row,columns,maxAbs,visualCell(value,column,row,columns,maxAbs,rowKind));
  }
  const conditionalFieldIndex=(fields,name)=>fields.findIndex(field=>String(field).toLowerCase()===String(name||"").toLowerCase());
  const conditionalSourceValue=(value,rule,row,fields)=>{const index=rule.valueField?conditionalFieldIndex(fields,rule.valueField):-1;return index>=0?row[index]:value;};
  const conditionalHex=value=>/^#[0-9a-f]{6}$/i.test(value||"")?value:null;
  function conditionalStrengthColor(numeric,rule,range){if(!Number.isFinite(numeric)||!Number.isFinite(range?.minimum)||!Number.isFinite(range?.maximum))return"";const low=conditionalHex(rule.lowColor)||"#f1f5ff",high=conditionalHex(rule.highColor)||"#536ee1",amount=Math.max(0,Math.min(1,(numeric-range.minimum)/(range.maximum-range.minimum||1))),channel=index=>Math.round(parseInt(low.slice(index,index+2),16)*(1-amount)+parseInt(high.slice(index,index+2),16)*amount).toString(16).padStart(2,"0");return`#${channel(1)}${channel(3)}${channel(5)}`;}
  function matrixConditionalBandColor(value,column,row,fields,range){const rule=column.conditional||{},roles=CanvasTheme.roles(model.settings.theme),directIndex=rule.bandColorField?conditionalFieldIndex(fields,rule.bandColorField):-1,direct=directIndex>=0?String(row[directIndex]??"").trim():"";if(conditionalHex(direct))return direct;const role=/^(?:theme:)?([a-z][\w-]*)$/i.exec(direct)?.[1];if(role&&roles[role])return roles[role];const numeric=Number(conditionalSourceValue(value,rule,row,fields));if(rule.strength||rule.badgeStrength){const strength=conditionalStrengthColor(numeric,rule,range);if(strength)return strength;}const compareIndex=rule.compareMode==="measure"?conditionalFieldIndex(fields,rule.compareField):-1,comparison=rule.compareMode==="measure"?(compareIndex>=0?Number(row[compareIndex]):NaN):Number(rule.threshold);if(Number.isFinite(numeric)&&Number.isFinite(comparison))return numeric>=comparison?(conditionalHex(rule.goodColor)||"#16844a"):(conditionalHex(rule.badColor)||"#c43d4b");if(rule.negativeText&&Number.isFinite(numeric)&&numeric<0)return roles.negative;return conditionalHex(rule.textColor)||roles.accent;}
  function matrixConditionalCell(value,column,row,fields,range,content){
    const rule=column.conditional||{},color=conditionalHex,styles=[],sourceValue=conditionalSourceValue(value,rule,row,fields),numeric=sourceValue!==null&&sourceValue!==undefined&&sourceValue!==''?Number(sourceValue):NaN;
    if(color(rule.textColor))styles.push(`color:${rule.textColor}`);
    if(rule.negativeText&&Number.isFinite(numeric)&&numeric<0)styles.push(`color:${CanvasTheme.roles(model.settings.theme).negative}`);
    if(color(rule.backgroundColor))styles.push(`background-color:${rule.backgroundColor}`);
