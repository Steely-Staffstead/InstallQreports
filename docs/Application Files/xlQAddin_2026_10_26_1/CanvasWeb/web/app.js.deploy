      const valuesHtml=`<section><h4>Values</h4><div class="field-well" data-drop-zone="values">${state.values.map((value,index)=>`<div class="matrix-value ${value.field===selectedValue?"selected":""}" data-select-value="${esc(value.field)}" data-reorder-index="${index}" title="${esc(value.sourceId?`${sourceById(value.sourceId)?.name||value.sourceId} · ${value.measure||value.field}`:value.field)}"><span class="designer-drag-handle" draggable="true" data-reorder-zone="values" data-reorder-index="${index}">☷</span><b>${esc(value.caption||value.measure||value.field)}</b>${measureNameSet.has(String(value.field).toLowerCase())?`<small>${esc(value.sourceId&&value.sourceId!==source.id?sourceById(value.sourceId)?.name||"Related measure":"Measure")}</small>`:`<select data-aggregation="${index}">${["Sum","Average","Count","Min","Max"].map(mode=>`<option ${mode===(value.aggregation||"Sum")?"selected":""}>${mode}</option>`).join("")}</select>`}<button data-remove-value="${index}">×</button></div>`).join("")||"Drag fields or measures here"}</div></section>`;
      const selectedHtml=selected?`<details class="matrix-selected-value" ${selectedValueOpen?'open':''}><summary>Selected value · ${esc(selected.caption||selected.field)}</summary><div class="matrix-selected-value-body">${columnPropertiesHtml(selected,allFields,false,true,true)}${dataBarPropertiesHtml(selected,allFields)}</div></details>`:"";
      const subtotalsHtml=state.rows.length?`<details class="matrix-subtotal-options" ${hierarchyOpen?'open':''}><summary>Rows & hierarchy</summary><section><h4>Row layout</h4><label>Layout<select data-matrix-layout><option value="tabular" ${state.layout==="tabular"?"selected":""}>Tabular</option><option value="outline" ${state.layout==="outline"?"selected":""}>Outline</option></select></label>${state.layout==="outline"?`<label>Row header caption<input data-outline-caption value="${esc(state.outlineCaption||"Rows")}"></label>`:`<label class="check"><input data-repeat-labels type="checkbox" ${state.repeatLabels?"checked":""}> Repeat row labels</label>`}<label class="check"><input data-blank-line type="checkbox" ${state.blankLineAfterGroup?"checked":""}> Insert blank line after each group</label></section><section class="matrix-hierarchy-controls ${state.layout==="outline"?"":"is-disabled"}"><h4>Expansion controls</h4><label class="check"><input type="checkbox" data-matrix-group-actions ${state.showGroupActions?"checked":""} ${state.layout==="outline"?"":"disabled"}> Show hierarchy level controls</label><div class="property-grid"><label>Buttons<select data-matrix-control-mode ${state.layout==="outline"?"":"disabled"}><option value="levels" ${state.groupControlMode==="levels"?"selected":""}>Excel-style levels</option><option value="all" ${state.groupControlMode==="all"?"selected":""}>Expand / collapse all</option></select></label><label>Placement<select data-matrix-control-placement ${state.layout==="outline"?"":"disabled"}><option value="rowHeader" ${state.groupControlPlacement==="rowHeader"?"selected":""}>Inside row header</option><option value="left" ${state.groupControlPlacement==="left"?"selected":""}>Above, left</option><option value="right" ${state.groupControlPlacement==="right"?"selected":""}>Above, right</option></select></label></div>${matrixControlAppearanceHtml()}</section><section><h4>Selected row level</h4><label>Row<select data-selected-row>${state.rows