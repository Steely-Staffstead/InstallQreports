    options.addEventListener("change",event=>{if(event.target.matches("[data-subtotal-position]")){state.subtotalPosition=event.target.value;refreshPreview();}});options.addEventListener("input",event=>{if(event.target.matches("[data-outline-caption]")){state.outlineCaption=event.target.value;refreshPreview();}});
    options.addEventListener("click",event=>{if(!event.target.matches("[data-remove-row],[data-remove-column],[data-remove-value]"))return;setTimeout(()=>{normalizeSorts();draw();});});
    const sortFields=()=>[...state.rows,...state.values.map(value=>value.field)];
    function normalizeSorts(){const allowed=new Set(sortFields().map(field=>String(field).toLowerCase())),seen=new Set();state.sorts=state.sorts.filter(sort=>{const key=String(sort.field||"").toLowerCase();if(!allowed.has(key)||seen.has(key))return false;seen.add(key);return true;});}
    function reconcileValueGroups(){
      if(state.valueGroups==null)return {ok:true,changed:false,message:""};
      if(!Array.isArray(state.valueGroups))return {ok:false,changed:false,message:"Grouped value headers could not be updated because valueGroups is not an array. Open Advanced matrix JSON and replace it with an array of group objects."};
      if(!state.valueGroups.length)return {ok:true,changed:false,message:""};
      const count=state.values.length,original=state.valueGroups.map(group=>group&&typeof group==="object"&&!Array.isArray(group)?{...group}:group);
      if(!count){state.valueGroups=[];const message="Removed grouped value headers because the matrix has no value columns.";valueGroupsMessage=message;return {ok:true,changed:true,message};}
      const normalized=state.valueGroups.slice(0,count).map((group,index)=>{const valid=group&&typeof group==="object"&&!Array.isArray(group),span=Math.max(1,Math.floor(Number(valid?group.span:1)||1));return {...(valid?group:{}),caption:valid?String(group.caption??""):`Group ${index+1}`,span};});
      let remaining=count;
      normalized.forEach((group,index)=>{const groupsAfter=normalized.length-index-1,maxForGroup=Math.max(1,remaining-groupsAfter);group.span=index===normalized.length-1?remaining:Math.min(group.span,maxForGroup);remaining-=group.span;});
      const before=original.map(group=>Number(group?.span)||0),after=normalized.map(group=>group.span),changed=JSON.stringify(original)!==JSON.stringify(normalized);
      state.valueGroups=normalized;
      if(!changed)return {ok:true,changed:false,message:""};
      const removed=Math.max(0,original.length-normalized.length),last=normalized.at(-1),details=removed?` Removed ${removed} trailing ${removed===1?"group":"groups"} because every group needs at least one value column.`:"";
      const message=`Adjusted grouped value headers from ${before.join(" + ")||"0"} to ${after.join(" + ")} columns so they cover all ${count} value ${count===1?"column":"columns"}.${details}${last?` The final group “${last.caption||`Group ${normalized.length}`}” now covers ${last.span}.`:""}`;
      valueGroupsMessage=message;
      return {ok:true,changed:true,message};
    }
    function add(field,zone){const dimension=dimensionByToken.get(field);if(zone==="rows"&&dimensions.includes(field)&&!state.rows.includes(field)){state.columns=state.columns.filter(item=>item!==field);state.rows.push(field);state.rowCaptions[field]||=dimension?.name||field;selectedRow=field;}if(zone==="columns"&&dimensions.includes(field)&&!state.columns.includes(field)){state.rows=state.rows.filter(item=>item!==field);state.columns.push(field);state.rowCaptions[field]||=dimension?.name||field;}if(zone==="values"&&!dimension?.relatedField&&!state.values.some(value=>value.field===field)){const entry=measureByToken.get(field),related=entry&&entry.sourceId!==source.id;state.values.push({field,caption:entry?.name||field,aggregation:"Sum",format:entry?.measure?.FormatString??entry?.measure?.formatString??"Auto",align:"Auto",...(related?{sourceId:entry.sourceId,measure:entry.name}:{})});selectedValue=field;reconcileValueGroups();}state.collapsedGroups={};normalizeSorts();draw();}
