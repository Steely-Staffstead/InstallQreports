  }
  function uniqueImportedPageName(name,reserved){
    const base=String(name||"Imported page").trim()||"Imported page";
    if(!reserved.has(base.toLowerCase())){reserved.add(base.toLowerCase());return base;}
    let suffix=2,candidate=`${base} (imported)`;
    while(reserved.has(candidate.toLowerCase()))candidate=`${base} (imported ${suffix++})`;
    reserved.add(candidate.toLowerCase());return candidate;
  }
  function stableImportJson(value){
    if(Array.isArray(value))return`[${value.map(stableImportJson).join(",")}]`;
    if(value&&typeof value==="object")return`{${Object.keys(value).sort().map(key=>`${JSON.stringify(key)}:${stableImportJson(value[key])}`).join(",")}}`;
    return JSON.stringify(value);
  }
  function importedSourceFootprint(source){
    const copy=structuredClone(source||{}),query=copy.query||copy.Query||{};
    for(const key of ["id","Id","name","Name","tileId","TileId"])delete copy[key];
    for(const key of ["measures","Measures","metrics","Metrics","parameters","Parameters","previewLimit","PreviewLimit","totalRows","TotalRows","data","Data","measureValues","MeasureValues"])delete query[key];
    copy.query=query;delete copy.Query;copy.kind=String(copy.kind||copy.Kind||"global").toLowerCase()==="gantt"?"gantt":"query";delete copy.Kind;
    return stableImportJson(copy);
