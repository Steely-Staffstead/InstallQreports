  function buildImportedPages(sourceDocument,selectedIndexes,options={}){
    const sourcePages=Array.isArray(sourceDocument?.pages)?sourceDocument.pages:[],indexes=[...new Set((selectedIndexes||[]).map(Number).filter(index=>Number.isInteger(index)&&index>=0&&index<sourcePages.length))];
    if(!indexes.length)return{pages:[],fallbackSources:[],retargetedLinks:0};
    const targetSources=model.sources||[],sourceMap=new Map(options.sourceMap||[]),fallbackSources=new Set(),sourceSummaries=Array.isArray(sourceDocument.sources)?sourceDocument.sources:[];
    const sourceName=id=>sourceSummaries.find(source=>String(source.id??source.Id??"")===String(id))?.name??sourceSummaries.find(source=>String(source.id??source.Id??"")===String(id))?.Name??"";
    const mapSource=id=>{
      const key=String(id||"main");if(sourceMap.has(key))return sourceMap.get(key);
      const exact=targetSources.find(source=>String(source.id).toLowerCase()===key.toLowerCase()),name=sourceName(key),named=name&&targetSources.filter(source=>String(source.name||"").toLowerCase()===String(name).toLowerCase());
      const target=exact?.id||(named?.length===1?named[0].id:null)||targetSources.find(source=>source.id==="main")?.id||targetSources[0]?.id||"main";
      if(!exact&&named?.length!==1&&key!=="main")fallbackSources.add(name||key);sourceMap.set(key,target);return target;
    };
    sourceSummaries.forEach(source=>mapSource(source.id??source.Id??"main"));
    const pageIdMap=new Map(),objectIdMap=new Map(),sharedFilterMap=new Map(),copies=indexes.map(index=>structuredClone(sourcePages[index]));
    copies.forEach((copy,position)=>{const source=sourcePages[indexes[position]],newId=uid();pageIdMap.set(String(source.id||source.name||`@${indexes[position]}`),newId);if(source.id)pageIdMap.set(String(source.id),newId);if(source.name)pageIdMap.set(String(source.name),newId);copy.id=newId;});
    copies.forEach(copy=>{for(const item of allObjects(copy)){const previous=String(item.id||uid()),next=uid();objectIdMap.set(previous,next);item.id=next;}});
    let retargetedLinks=0;
    const rewrite=(value,key="")=>{
      if(Array.isArray(value)){if(key==="targetIds")return value.map(id=>objectIdMap.get(String(id))).filter(Boolean);return value.map(item=>rewrite(item,key));}
      if(value&&typeof value==="object"){for(const [childKey,childValue] of Object.entries(value))value[childKey]=rewrite(childValue,childKey);return value;}
      if(typeof value!=="string")return value;
      if(/sourceId$/i.test(key)){
        const gantt=/^gantt:(.+)$/i.exec(value);return gantt&&objectIdMap.has(gantt[1])?`gantt:${objectIdMap.get(gantt[1])}`:mapSource(value);
      }
      if(key==="fromId"||key==="toId")return objectIdMap.get(value)||"";
      if(key==="pageId"){
        const mapped=pageIdMap.get(value);if(mapped)return mapped;
        if(value)retargetedLinks++;return "";
      }
      if(key==="sharedFilterId"){if(!sharedFilterMap.has(value))sharedFilterMap.set(value,uid());return sharedFilterMap.get(value);}
      let result=value;
      for(const [oldId,newId] of sourceMap)result=result.replaceAll(`${oldId}::`,`${newId}::`);
      for(const [oldId,newId] of pageIdMap){result=result.replaceAll(`#qanvas-page=${encodeURIComponent(oldId)}`,`#qanvas-page=${encodeURIComponent(newId)}`);result=result.replaceAll(`#qanvas-page=${oldId}`,`#qanvas-page=${newId}`);}
      return result;
    };
    const reserved=new Set(model.pages.map(item=>String(item.name||"").toLowerCase()));
    copies.forEach(copy=>{
      delete copy.query;delete copy.PageQuery;copy.hidden=false;copy.tiles=Array.isArray(copy.tiles)?copy.tiles:[];copy.graphics=Array.isArray(copy.graphics)?copy.graphics:[];copy.filters=Array.isArray(copy.filters)?copy.filters:[];
      rewrite(copy);copy.name=uniqueImportedPageName(copy.name,reserved);copy.query=sourceById("main")?.query||model.sources[0]?.query||blankQuery();
      for(const item of allObjects(copy))if(item.kind==="pageLink"&&item.pageLink?.target==="page"&&!item.pageLink.pageId)item.pageLink.target="next";
    });
    return{pages:copies,fallbackSources:[...fallbackSources],retargetedLinks};
  }
  function importPagesFromProject(sourceDocument,selectedIndexes,fileName="",options={}){
    const imported=buildImportedPages(sourceDocument,selectedIndexes,options);if(!imported.pages.length)return imported;
    model.pages.push(...imported.pages);pageIndex=model.pages.length-imported.pages.length;selectedId=null;selectedIds.clear();markDirty();render();
    const details=[`${imported.pages.length} page${imported.pages.length===1?"":"s"} imported${fileName?` from ${fileName}`:""}`];
    const counts=options.sourceResult?.counts;if(counts?.created)details.push(`${counts.created} source${counts.created===1?"":"s"} added`);if(counts?.replaced)details.push(`${counts.replaced} source${counts.replaced===1?"":"s"} replaced`);if(counts?.reused)details.push(`${counts.reused} source${counts.reused===1?"":"s"} reused`);details.push(...(options.sourceResult?.warnings||[]));
    if(imported.fallbackSources.length)details.push(`${imported.fallbackSources.length} unmatched source${imported.fallbackSources.length===1?"":"s"} connected to Main`);
    if(imported.retargetedLinks)details.push(`${imported.retargetedLinks} unavailable page link${imported.retargetedLinks===1?"":"s"} changed to Next page`);
