    const incoming=Array.isArray(sourceDocument?.sources)?sourceDocument.sources:Array.isArray(sourceDocument?.Sources)?sourceDocument.Sources:[],sourceMap=new Map(),warnings=[],reserved=new Set(model.sources.map(source=>String(source.name||"").toLowerCase())),includeDefinitions=new Set(),counts={created:0,replaced:0,reused:0,measuresAdded:0,sourceOnly:0};
