    const filtersPanel=$("#filtersPanel");if(filtersPanel&&!$("#tileFilterList")){filtersPanel.querySelector(".panel-title").textContent="Source query filters";const note=filtersPanel.querySelector(".property-empty");if(note)note.textContent="Source filters use the data already loaded for this source and affect every tile connected to it.";note?.insertAdjacentHTML("afterend",'<hr class="filter-divider"><div class="panel-title">Tile filters</div><div id="tileFilterContext" class="filter-context">Select a data tile or text object to add a local filter.</div><div id="tileFilterList"></div><button data-action="addTileFilter">+ Add local filter</button><button class="primary" data-action="applyTileFilters">Apply filter</button><p class="property-empty">Tile filters use loaded source data and affect only the referenced tile or text object.</p>');}
    organizeFilterPanel();
