        else {const resolved=CanvasTheme.resolve(selected,model.settings.theme);selected.header||={};selected.header.background=resolved.header?.background||selected.header.background;selected.header.color=resolved.header?.color||selected.header.color;delete selected.themeBindings["header.background"];delete selected.themeBindings["header.color"];}
