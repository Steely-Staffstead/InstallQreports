    if(!section)return null;
    section.classList.add("property-section");section.dataset.propertySection=key;section.style.setProperty("--property-section-order",String((propertySectionOrder[key]??800)+offset));propertySummary(section,label);
    const tile=selectedTile(),identity=`${tile?.kind||"none"}:${key}:${section.id||section.dataset.propertyIdentity||label||"section"}`;
    section.dataset.propertyStateKey=identity;
    if(propertySectionState.has(identity))section.open=propertySectionState.get(identity);else section.open=defaultOpen;
    if(!section.dataset.propertyStateBound){section.dataset.propertyStateBound="1";section.addEventListener("toggle",()=>{if(section.dataset.propertyStateKey)propertySectionState.set(section.dataset.propertyStateKey,section.open);});}
    return section;
  }
  function ensurePropertySection(id,label){
