  function renderProperties() { themeControls.render();const t = selectedTile(); $("#noSelection").classList.toggle("hidden", !!t); $("#tileProperties").classList.toggle("hidden", !t); const designButton=$("#designTileButton"),designVisible=!!t&&["table", "matrix", "chart", "reportGrid", "gantt"].includes(t.kind);designButton?.classList.toggle("hidden",!designVisible);const designLabel=designButton?.querySelector("b");if(designLabel)designLabel.textContent=t?.kind==="chart"?"Chart designer":"Design"; if (!t) { propertyTextEditId=null;syncTextEditMode?.();$("#selectionStatus").textContent = "No tile selected"; return; } const graphic=graphicKinds.has(t.kind),dataBound=t.kind==="card";["tileTitle","tileText","tileX","tileY","tileWidth","tileHeight","tileHeader","tileBackground"].forEach(id=>$("#"+id)?.closest("label")?.classList.toggle("hidden",graphic));$("#tileField")?.closest("label")?.classList.toggle("hidden",graphic||!dataBound);const settingsSummary=document.querySelector(".tile-settings summary");if(settingsSummary)settingsSummary.textContent=graphic?"Graphic settings":"Tile settings";$("#selectionStatus").textContent = selectedIds.size>1?`${selectedIds.size} objects selected`:`${t.title} selected`; const fields = [...query().data.columns, ...query().measures.map(m => m.Name ?? m.name ?? m.OutputName ?? m.outputName).filter(Boolean)]; $("#tileField").innerHTML = `<option value="">Select field or measure…</option>${[...new Set(fields)].map(f => `<option ${f === t.field ? "selected" : ""}>${esc(f)}</option>`).join("")}`; $("#tileTitle").value = t.title || ""; $("#tileText").value = t.text || ""; const rich = ["text","graphicText"].includes(t.kind); $("#plainTextLabel").classList.toggle("hidden", t.kind !== "picture"); $("#richTextGroup").classList.toggle("hidden", !rich); $("#textTileFont").classList.toggle("hidden", !rich||graphic); if (rich && document.activeElement !== $("#richTextEditor")) {$("#richTextEditor").innerHTML = sanitizeHtml(t.html || "");prepareC