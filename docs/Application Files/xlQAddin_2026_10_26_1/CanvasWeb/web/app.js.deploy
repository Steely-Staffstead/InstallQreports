      menu.addEventListener("click",event=>{const option=event.target.closest("[data-search-select-value]");if(option){returnFocus=false;select.value=option.dataset.searchSelectValue;refresh();close();select.dispatchEvent(new Event("input",{bubbles:true}));select.dispatchEvent(new Event("change",{bubbles:true}));return;}if(event.target.closest(".designer-search-select-search button"))close();});
      menu.addEventListener("keydown",event=>{if(event.key==="Escape"){event.preventDefault();event.stopPropagation();close();return;}const buttons=visibleButtons(),current=buttons.indexOf(document.activeElement);if(event.key==="ArrowDown"){event.preventDefault();buttons[Math.min(buttons.length-1,current+1)]?.focus();}else if(event.key==="ArrowUp"){event.preventDefault();if(current<=0)search.focus();else buttons[current-1]?.focus();}});
      search.addEventListener("input",filter);
      const bounds=trigger.getBoundingClientRect(),width=Math.max(280,Math.min(520,bounds.width*1.65)),left=Math.max(8,Math.min(bounds.left,innerWidth-width-8)),spaceBelow=innerHeight-bounds.bottom-8,above=bounds.top-8,maxHeight=Math.max(220,Math.min(520,Math.max(spaceBelow,above)));
      menu.style.width=`${width}px`;menu.style.maxHeight=`${maxHeight}px`;menu.style.left=`${left}px`;menu.style.top=spaceBelow>=Math.min(320,maxHeight)||spaceBelow>=above?`${bounds.bottom+4}px`:"auto";menu.style.bottom=spaceBelow>=Math.min(320,maxHeight)||spaceBelow>=above?"auto":`${innerHeight-bounds.top+4}px`;trigger.setAttribute("aria-expanded","true");requestAnimationFrame(()=>search.focus({preventScroll:true}));outside=event=>{if(menu&&!menu.contains(event.target)&&event.target!==trigger)close();};document.addEventListener("pointerdown",outside,true);
