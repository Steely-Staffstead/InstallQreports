    const drawColumnWidths=()=>{state.metricColumnWidths=multiCardColumnWidths(state);const details=options.querySelector("details"),anchor=details?.querySelector(".property-grid");if(!anchor)return;const rows=state.metricColumnWidths.map((item,index)=>`<label class="multi-card-column-width-row"><b>Column ${index+1}</b><select data-mc-column-mode data-mc-column-index="${index}"><option value="auto" ${item.mode==="auto"?"selected":""}>Auto / remaining</option><option value="percent" ${item.mode==="percent"?"selected":""}>Percent</option><option value="fixed" ${item.mode==="fixed"?"selected":""}>Fixed</option></select><input type="number" data-mc-column-value data-mc-column-index="${index}" min="${item.mode==="fixed"?40:1}" max="${item.mode==="fixed"?1200:100}" value="${item.value}" ${item.mode==="auto"?"disabled":""} aria-label="Column ${index+1} width"><span>${item.mode==="fixed"?"px":item.mode==="percent"?"%":""}</span></label>`).join("");anchor.insertAdjacentHTML("afterend",`<div class="multi-card-column-widths"><strong>Value column widths</strong>${rows}<small>Auto columns share the remaining width. Percent values are relative to each other after fixed-pixel columns are reserved, so 15% + Auto + 25% becomes 15 / 60 / 25.</small></div>`);};
    const drawAppearanceOptions=()=>{const appearance=state.appearance||={},useTheme=options.querySelector('[data-mc-appearance="useTheme"]'),transparent=appearance.transparentBackground===true,borderSides=["all","top-sides","horizontal","none"].includes(appearance.borderSides)?appearance.borderSides:"all";useTheme?.closest("label")?.insertAdjacentHTML("afterend",`<label class="check"><input type="checkbox" data-mc-appearance="transparentBackground" ${transparent?"checked":""}> No background (transparent)</label>`);const background=options.querySelector('[data-mc-appearance="background"]'),width=options.querySelector('[data-mc-appearance="borderWidth"]');if(background)background.disabled=appearance.useTheme!==false||transparent;if(width){width.step="0.25";width.disabled=borderSides==="none";width.closest("label")?.insertAdjacentHTML("afterend",`<label>Border sides<select data-mc-appearance="borderSides"><option value="all" ${borderSides==="all"?"selected":""}>All sides</option><option value="top-sides" ${borderSides==="top-sides"?"selected":""}>Top and sides</option><option value="horizontal" ${borderSides==="horizontal"?"selected":""}>Horizontal separators</option><option value="none" ${borderSides==="none"?"selected":""}>None</option></select></label>`);}};
    const draw=()=>{rememberOpenSections();drawFields();drawOptions();drawColumnWidths();drawAppearanceOptions();options.querySelectorAll('[data-metric="align"] option').forEach(option=>option.value=option.textContent.trim().toLowerCase());options.querySelectorAll("[data-metric-index]").forEach(row=>{const index=+row.dataset.metricIndex,metric=state.metrics[index];row.querySelector(".multi-card-value-align")?.insertAdjacentHTML("afterend",placementEditor(metric)+rendererEditor(metric)+metricVisualEditors(metric));});const textDetails=[...options.querySelectorAll("details")].find(item=>item.querySelector(":scope>summary")?.textContent==="Card text"),headingInput=textDetails?.querySelector('[data-mc="headerTemplate"]');headingInput?.closest("label")?.insertAdjacentHTML("beforebegin",`<label class="check"><input type="checkbox" data-mc="showHeading" ${state.showHeading!==false?"checked":""}> Show heading</label>`);if(headingInput)headingInput.disabled=state.showHeading===false;textDetails?.insertAdjacentHTML("beforeend",`<div class="multi-card-typography-list">${typographyEditor("heading","Heading")}${typographyEditor("supporting","Supporting text")}${typographyEditor("value","Value")}${typographyEditor("caption","Value caption")}</div>`);drawPreview();restoreOpenSections();};
