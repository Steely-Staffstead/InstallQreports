    powerPointCapture(mode,id){
      const canvas=$('#canvas');
      if(!powerPointCaptureState)powerPointCaptureState={background:canvas.style.background,backgroundImage:canvas.style.backgroundImage};
      canvas.style.background=mode==='background'?powerPointCaptureState.background:'transparent';
      canvas.style.backgroundImage=mode==='background'?powerPointCaptureState.backgroundImage:'none';
      canvas.querySelectorAll('.tile').forEach(tile=>{
