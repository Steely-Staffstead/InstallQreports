.report-grid-view { width:100%; height:100%; overflow:auto; }
.tile-reportGrid .tile-body { padding:var(--report-grid-padding-top,0) 0 var(--report-grid-padding-bottom,0); overflow:hidden; }
.tile-reportGrid .report-grid-view { user-select:none; -webkit-user-select:none; }
.tile-reportGrid .report-grid-inline-editor,.tile-reportGrid .report-grid-inline-input { user-select:text; -webkit-user-select:text; }
.report-grid-view table { width:100%; border-collapse:separate; border-spacing:0; table-layout:fixed; }
.report-grid-top-tools { position:sticky; top:0; z-index:8; display:flex; align-items:center; gap:6px; min-width:max-content; padding:4px 6px; border-bottom:1px solid var(--qreports-grid,#c6ced9); background:color-mix(in srgb,var(--qreports-surface,#fff) 92%,var(--qreports-header,#e5eaf2)); color:var(--qreports-text,#182230); }
.report-grid-top-group { display:flex; align-items:center; gap:3px; padding-right:6px; border-right:1px solid var(--qreports-grid,#c6ced9); }
.report-grid-top-tools button { box-sizing:border-box; min-width:28px; height:28px; padding:2px 5px; border:1px solid var(--qreports-grid,#62758d); border-radius:5px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); font:600 12px/1 "Segoe UI",Arial,sans-serif; cursor:pointer; }
.report-grid-top-tools button[aria-pressed=true] { background:var(--qreports-accent,#425f9a); color:var(--qreports-on-accent,#fff); }
.report-grid-top-tools button:disabled { opacity:.38; cursor:default; }
.report-grid-top-color { position:relative; display:inline-flex!important; align-items:center; justify-content:center; box-sizing:border-box; width:30px!important; height:28px; margin:0!important; padding:0; border:1px solid var(--qreports-grid,#62758d); border-radius:5px; background:var(--qreports-surface,#fff); overflow:hidden; }
.report-grid-top-color>span { position:absolute; top:3px; left:0; width:100%; color:var(--qreports-text,#182230); font:700 13px/1 "Segoe UI",Arial,sans-serif; text-align:center; pointer-events:none; }
.report-grid-top-color input { position:absolute; right:3px; bottom:2px; left:3px; width:24px!important; height:6px!important; min-height:0!important; margin:0!important; padding:0!important; border:0!important; opacity:1; cursor:pointer; }
.report-grid-top-color input::-webkit-color-swatch-wrapper { padding:0; }
.report-grid-top-color input::-webkit-color-swatch { border:0; }
.report-grid-top-font-size { display:inline-flex!important; align-items:center; box-sizing:border-box; height:28px; margin:0!important; padding:0 4px; border:1px solid var(--qreports-grid,#62758d); border-radius:5px; background:var(--qreports-surface,#fff); }
.report-grid-top-font-size input { box-sizing:border-box; width:39px!important; height:24px!important; min-height:0!important; margin:0!important; padding:2px!important; border:0!important; background:transparent!important; color:var(--qreports-text,#182230)!important; text-align:right; }
.report-grid-top-font-size span { color:var(--qreports-muted,#667085); font-size:10px; }
.report-grid-top-color:has(input:disabled),.report-grid-top-font-size:has(input:disabled) { opacity:.38; }
.report-grid-top-formula { display:flex; align-items:center; flex:1 1 260px; min-width:210px; margin:0!important; }
.report-grid-top-formula span { flex:none; min-width:36px; padding:0 6px; color:var(--qreports-muted,#667085); font:600 11px/1 "Segoe UI",Arial,sans-serif; text-align:center; }
.report-grid-top-formula input { box-sizing:border-box; width:100%; min-width:150px; height:28px; margin:0; padding:3px 7px; border:1px solid var(--qreports-grid,#62758d); border-radius:5px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); font:12px/1.2 Consolas,"Segoe UI",sans-serif; }
.report-grid-view th,.report-grid-view td { padding:8px 12px; overflow-wrap:anywhere; vertical-align:middle; }
.report-grid-view th { position:sticky; top:0; z-index:1; }
.report-grid-view td:not(.report-grid-caption) { font-variant-numeric:tabular-nums; }
.report-grid-view .report-grid-compact-row td { padding-top:0; padding-bottom:0; }
.report-grid-view .report-grid-tiny-row td { height:0; padding:0; font-size:0!important; line-height:0!important; }
.tile-reportGrid [data-report-grid-cell] { cursor:pointer; }
.tile-reportGrid .report-grid-cell-selected { outline:2px solid #5b74e8; outline-offset:-2px; box-shadow:inset 0 0 0 2px #ffffff; }
.tile-reportGrid .report-grid-cell-cut { outline:2px dashed #5b74e8; outline-offset:-3px; }
