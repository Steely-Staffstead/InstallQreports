.report-grid-resize-handle.row { left:0; right:0; bottom:0; height:9px; cursor:row-resize; }
.report-grid-resize-handle:hover { background:var(--qreports-accent,#425f9a); opacity:.45; }
.report-grid-dimensions { min-width:0; margin:10px 0; padding:8px 10px; border:1px solid var(--qreports-grid,#62758d); border-radius:7px; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; }
.report-grid-dimensions legend { padding:0 4px; font-weight:700; }
.report-grid-dimension-row { display:flex; align-items:center; min-width:0; gap:3px; margin:0; }
