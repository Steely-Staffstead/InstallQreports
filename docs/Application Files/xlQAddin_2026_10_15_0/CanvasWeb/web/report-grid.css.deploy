.report-grid-painting [data-report-grid-cell] { cursor:copy; }
.report-grid-painting [data-report-grid-cell]:hover { outline:3px solid #4d80ec; outline-offset:-3px; background-image:linear-gradient(#608eff22,#608eff22)!important; }
.report-grid-painting .report-grid-paint-range { outline:3px solid #4d80ec; outline-offset:-3px; background-image:linear-gradient(#608eff33,#608eff33)!important; }
#reportGridCellProperties .report-grid-selected-label { font-weight:700; margin:8px 0 12px; }
.report-grid-cell-identity { display:flex; align-items:center; gap:8px; margin:8px 0 2px; }
