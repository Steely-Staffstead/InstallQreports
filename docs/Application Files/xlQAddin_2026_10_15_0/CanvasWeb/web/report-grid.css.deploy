.report-grid-dimension-row input { width:100%; min-width:0; }
.report-grid-dimension-row button { flex:none; height:34px; padding:4px 5px; }
.report-grid-sheet-editor { margin:12px 0; }
.report-grid-sheet-editor legend { font-weight:700; }
.report-grid-input-mode { display:flex; gap:5px; margin:5px 0 10px; }
.report-grid-input-mode button { flex:1; padding:7px 4px; border:1px solid var(--qreports-grid,#62758d); border-radius:6px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); }
.report-grid-input-mode button[aria-pressed="true"] { background:var(--qreports-accent,#425f9a); color:var(--qreports-on-accent,#fff); }
.report-grid-context-menu { position:fixed; z-index:2147483647; min-width:206px; padding:6px; border:1px solid var(--qreports-grid,#62758d); border-radius:9px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); box-shadow:0 12px 30px #101b3380; }
