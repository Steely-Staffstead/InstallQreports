.report-grid-spacing { grid-column:1/-1; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; padding-top:6px; border-top:1px solid var(--qreports-grid,#c6ced9); }
.report-grid-spacing label { display:grid!important; gap:4px!important; margin:0!important; white-space:normal!important; }
.report-grid-spacing input { box-sizing:border-box; width:100%!important; min-width:0; }
.report-grid-show-lines th,.report-grid-show-lines td { box-shadow:inset -1px -1px 0 #d9d9d9; }
.report-grid-view .report-grid-address-heading th,.report-grid-view .report-grid-row-number { background:var(--qreports-header,#e5eaf2); color:var(--qreports-text,#182230); text-align:center; font-size:11px; font-weight:600; padding:3px 5px; user-select:none; }
.report-grid-view .report-grid-axis-column,.report-grid-view .report-grid-axis-row { position:relative; cursor:pointer; }
.report-grid-view .report-grid-axis-column:hover,.report-grid-view .report-grid-axis-row:hover { background:color-mix(in srgb,var(--qreports-accent,#425f9a) 18%,var(--qreports-header,#e5eaf2)); }
.report-grid-resize-handle { position:absolute; z-index:4; }
