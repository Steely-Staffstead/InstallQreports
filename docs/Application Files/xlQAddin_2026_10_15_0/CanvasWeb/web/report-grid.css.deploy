#reportGridCellProperties .report-grid-copy-format.active { background:#4d80ec; color:#fff; }
.report-grid-clipboard-actions { display:flex; flex-wrap:wrap; gap:6px; margin:8px 0 12px; }
.report-grid-clipboard-actions button { flex:1 1 130px; }
.report-grid-mini-toolbar { display:grid; gap:0; margin:8px 0 14px; padding:4px 7px; border:1px solid var(--qreports-grid,#c6ced9); border-radius:9px; background:color-mix(in srgb,var(--qreports-surface,#fff) 88%,var(--qreports-header,#e5eaf2)); }
.report-grid-tool-group { display:flex; align-items:center; gap:8px; min-width:0; padding:5px 0; }
.report-grid-tool-group+.report-grid-tool-group { border-top:1px solid var(--qreports-grid,#c6ced9); }
.report-grid-tool-label { flex:0 0 62px; color:var(--qreports-text,#182230); font-size:11px; font-weight:600; line-height:1.15; }
.report-grid-tool-buttons { display:flex; flex-wrap:wrap; gap:5px; min-width:0; }
.report-grid-mini-toolbar button { min-width:38px; height:38px; padding:3px 7px; font-size:16px; line-height:1; border:1px solid var(--qreports-grid,#62758d); border-radius:6px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); cursor:pointer; }
.report-grid-mini-toolbar button:hover:not(:disabled) { background:var(--qreports-accent,#425f9a); color:var(--qreports-on-accent,#fff); }
.report-grid-mini-toolbar button:disabled { opacity:.38; cursor:default; }
.tile-reportGrid .report-grid-cell-editing { white-space:pre-wrap; overflow-wrap:anywhere; }
.tile-reportGrid td.report-grid-cell-editing,.tile-reportGrid th.report-grid-cell-editing { position:relative; overflow:visible; z-index:5; }
.report-grid-inline-editor { position:absolute; top:0; left:0; width:max(100%,230px); min-height:100%; z-index:6; color:var(--qreports-text,#182230); font:inherit; line-height:inherit; text-align:left; background:var(--qreports-surface,#fff); border:2px solid var(--qreports-accent,#5b74e8); box-shadow:0 5px 18px #10204030; }
.report-grid-inline-highlight,.report-grid-inline-input { box-sizing:border-box; display:block; width:100%; min-height:28px; padding:5px 7px; margin:0; border:0; font:inherit; line-height:1.35; letter-spacing:inherit; white-space:pre-wrap; overflow-wrap:anywhere; text-align:left; }
.report-grid-inline-highlight { pointer-events:none; color:var(--qreports-text,#182230); }
.report-grid-inline-input { position:absolute; inset:0; height:100%; resize:none; overflow:hidden; outline:0; background:transparent; color:transparent; -webkit-text-fill-color:transparent; caret-color:var(--qreports-text,#182230); }
html[data-qreports-app-theme] .report-grid-inline-editor textarea.report-grid-inline-input { background:transparent; color:transparent; -webkit-text-fill-color:transparent; border:0; caret-color:var(--qreports-text,#182230); }
.report-grid-inline-input::selection { background:#7ca3ef88; color:var(--qreports-text,#182230); -webkit-text-fill-color:var(--qreports-text,#182230); }
.report-grid-function-token { color:var(--qreports-accent,#3167c9); font-weight:700; }
.report-grid-inline-hint { position:absolute; top:calc(100% + 5px); left:0; min-width:min(300px,80vw); max-width:min(440px,80vw); padding:5px 7px; border:1px solid var(--qreports-grid,#b8c5d8); border-radius:7px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); box-shadow:0 8px 20px #10204030; font:12px/1.35 Segoe UI,Arial,sans-serif; white-space:normal; }
.report-grid-inline-hint[hidden] { display:none; }
.report-grid-inline-hint:not(:has(button)) { pointer-events:none; }
.report-grid-inline-hint strong,.report-grid-inline-hint small { display:block; }
.report-grid-inline-hint small { color:var(--qreports-muted,#667085); }
.report-grid-inline-hint button { display:block; width:100%; padding:5px 7px; border:0; border-radius:4px; background:transparent; color:inherit; text-align:left; cursor:pointer; }
.report-grid-inline-hint button:hover { background:color-mix(in srgb,var(--qreports-accent,#5b74e8) 15%,var(--qreports-surface,#fff)); }
.report-grid-view-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px 14px; margin:8px 0 2px; padding:4px 2px; }
.report-grid-view-options>button,.report-grid-view-options>small { grid-column:1/-1; }
