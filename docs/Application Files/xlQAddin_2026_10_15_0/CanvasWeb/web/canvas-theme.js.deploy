(() => {
  const defaults={text:'#182230',accent:'#4f6ee8',onAccent:'#ffffff',surface:'#ffffff',headerBackground:'#eef3f9',headerText:'#344054',grid:'#dce3ec',positive:'#16844a',negative:'#c43d4b'};
  const paths={background:'surface',borderColor:'grid','header.background':'headerBackground','header.color':'headerText',textColor:'text',color:'accent',fill:'surface','card.valueColor':'accent','card.positiveColor':'positive','card.negativeColor':'negative','card.captionColor':'text','appearance.textColor':'text','appearance.headerColor':'headerBackground','appearance.rowHeaderColor':'headerBackground','appearance.totalRowColor':'headerBackground','appearance.alternateColor':'surface','appearance.gridColor':'grid','design.matrixSpec.subtotalStyle.textColor':'text','design.matrixSpec.subtotalStyle.background':'headerBackground','design.ganttSpec.barColor':'accent','design.ganttSpec.progressColor':'positive','svgGraphic.color':'accent','svgGraphic.textColor':'onAccent','svgGraphic.backgroundColor':'surface','svgGraphic.belowColor':'negative','pageLink.background':'surface','pageLink.accent':'accent','valueSelector.textColor':'text','valueSelector.activeTextColor':'onAccent','valueSelector.backgroundColor':'surface','valueSelector.activeBackgroundColor':'accent'};
  const get=(object,path)=>path.split('.').reduce((value,key)=>value?.[key],object);
  function set(object,path,value){const parts=path.split('.'),last=parts.pop();let owner=object;parts.forEach(key=>owner=owner[key]||={});owner[last]=value;}
  function roles(theme){const palette=Object.fromEntries((theme?.colors||[]).map((color,index)=>[`color${index+1}`,color]));return {...defaults,accent:theme?.colors?.[0]||defaults.accent,...theme?.roles,...palette};}
  function fields(tile){const result=[];if(!['line','connector','rectangle','svgGraphic','pageLink'].includes(tile.kind)&&(tile.kind!=='graphicText'||tile.boxed))result.push('background','borderColor');if(tile.showHeader===true&&!['graphicText','svgGraphic','valueSelector','line','rectangle','connector'].includes(tile.kind))result.push('header.background','header.color');if(['line','rectangle','connector'].includes(tile.kind))result.push('color');if(tile.kind==='rectangle')result.push('fill');if(['text','graphicText'].includes(tile.kind))result.push('textColor');if(tile.kind==='svgGraphic')result.push('svgGraphic.color','svgGraphic.textColor','svgGraphic.backgroundColor','svgGraphic.belowColor');if(tile.kind==='pageLink')result.push('pageLink.background','pageLink.accent');if(tile.kind==='valueSelector')result.push('valueSelector.textColor','valueSelector.activeTextColor','valueSelector.backgroundColor','valueSelector.activeBackgroundColor');if(tile.kind==='card')result.push('card.valueColor','card.positiveColor','card.negativeColor','card.captionColor');if(tile.kind==='gantt')result.push('design.ganttSpec.barColor','design.ganttSpec.progressColor');if(['table','matrix'].includes(tile.kind))result.push(...Object.keys(paths).filter(path=>path.startsWith('appearance.')));if(tile.kind==='matrix'&&tile.design?.matrixSpec)result.push('design.matrixSpec.subtotalStyle.textColor','design.matrixSpec.subtotalStyle.background');return result;}
  function resolve(tile,theme){if(!tile?.themeBindings&&!theme?.requireColors)return tile;const copy=structuredClone(tile),colors=roles(theme),applicable=fields(tile),bindings=theme?.requireColors?{...inherit(tile),...tile.themeBindings}:tile.themeBindings||{};Object.entries(bindings).forEach(([path,role])=>{const color=colors[role]||colors[paths[path]];if(applicable.includes(path)&&color)set(copy,path,color);});return copy;}
  const inherit=tile=>Object.fromEntries(fields(tile).map(path=>[path,paths[path]]));
  globalThis.CanvasTheme={defaults,paths,get,set,roles,fields,resolve,inherit};
})();
