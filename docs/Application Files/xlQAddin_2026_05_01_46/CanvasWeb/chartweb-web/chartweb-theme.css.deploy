html[data-qreports-app-theme] {
  color-scheme: var(--qreports-color-scheme, light);
}

html[data-qreports-app-theme] body {
  color: var(--qreports-text);
  background: var(--qreports-surface);
}

html[data-qreports-app-theme] body > header {
  color: var(--qreports-header-text);
  background: var(--qreports-header);
}

html[data-qreports-app-theme] .brand > span,
html[data-qreports-app-theme] button.primary,
html[data-qreports-app-theme] .chart-direct-popover button.active {
  color: var(--qreports-on-accent);
  background: var(--qreports-accent);
  border-color: var(--qreports-accent);
}

html[data-qreports-app-theme] .brand small {
  color: var(--qreports-header-text);
  opacity: .82;
}

html[data-qreports-app-theme] body > header button:not(.primary) {
  color: var(--qreports-header-text);
  background: transparent;
  border-color: color-mix(in srgb, var(--qreports-header-text) 48%, transparent);
}

html[data-qreports-app-theme] body > header button:not(.primary):is(:hover, :focus-visible) {
  background: color-mix(in srgb, var(--qreports-header-text) 12%, transparent);
  border-color: var(--qreports-header-text);
}

html[data-qreports-app-theme] .types {
  background: color-mix(in srgb, var(--qreports-surface) 94%, var(--qreports-header));
  border-color: var(--qreports-grid);
}

html[data-qreports-app-theme] .type-button {
  color: var(--qreports-text);
}

html[data-qreports-app-theme] .type-button span {
  color: var(--qreports-accent);
}

html[data-qreports-app-theme] .type-button.active,
html[data-qreports-app-theme] .type-button:is(:hover, :focus-visible),
html[data-qreports-app-theme] .chart-options-context button:hover {
  color: var(--qreports-text);
  background: color-mix(in srgb, var(--qreports-accent) 15%, var(--qreports-surface));
}

html[data-qreports-app-theme] .panel,
html[data-qreports-app-theme] .chart-options-context,
html[data-qreports-app-theme] .chart-direct-popover,
html[data-qreports-app-theme] .chart-inline-title,
html[data-qreports-app-theme] .group-shading-controls {
  color: var(--qreports-text);
  background: var(--qreports-surface);
  border-color: var(--qreports-grid);
}

html[data-qreports-app-theme] .bindings,
html[data-qreports-app-theme] .options,
html[data-qreports-app-theme] hr,
html[data-qreports-app-theme] .format-section,
html[data-qreports-app-theme] .type-options,
html[data-qreports-app-theme] .chart-options-context .menu-title {
  border-color: var(--qreports-grid);
}

html[data-qreports-app-theme] .panel h2,
html[data-qreports-app-theme] .panel label,
html[data-qreports-app-theme] .format-section summary,
html[data-qreports-app-theme] .type-options summary,
html[data-qreports-app-theme] .section-help,
html[data-qreports-app-theme] .type-options p,
html[data-qreports-app-theme] .preview #status {
  color: color-mix(in srgb, var(--qreports-text) 76%, var(--qreports-surface));
}

html[data-qreports-app-theme] .panel :is(select, input, textarea),
html[data-qreports-app-theme] .chart-inline-title,
html[data-qreports-app-theme] button:not(.primary) {
  color: var(--qreports-text);
  background: var(--qreports-surface);
  border-color: var(--qreports-grid);
}

html[data-qreports-app-theme] button:not(.primary):is(:hover, :focus-visible) {
  background: color-mix(in srgb, var(--qreports-accent) 10%, var(--qreports-surface));
  border-color: var(--qreports-accent);
}

html[data-qreports-app-theme] .preview {
  background: color-mix(in srgb, var(--qreports-surface) 86%, var(--qreports-header));
}

html[data-qreports-app-theme] .preview #chart,
html[data-qreports-app-theme] .chart-small-multiple {
  border-color: var(--qreports-grid);
  box-shadow: 0 12px 30px color-mix(in srgb, var(--qreports-text) 10%, transparent);
}

html[data-qreports-app-theme] .chart-general-options,
html[data-qreports-app-theme] .series-target,
html[data-qreports-app-theme] .options-pane-tab,
html[data-qreports-app-theme] .data-pane-tab {
  color: var(--qreports-text);
  background: color-mix(in srgb, var(--qreports-surface) 90%, var(--qreports-header));
  border-color: var(--qreports-grid);
}

html[data-qreports-app-theme] .series-row [data-theme-color] {
  color: var(--qreports-accent);
}
