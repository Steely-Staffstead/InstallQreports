:root{font-family:Inter,"Segoe UI",Arial,sans-serif;color:#1e2b45;background:#edf1f7}*{box-sizing:border-box}body{margin:0;min-width:900px}button,input,select,textarea{font:inherit}header{height:72px;padding:0 26px;display:flex;align-items:center;justify-content:space-between;background:#1f3158;color:#fff}.brand{display:flex;align-items:center;gap:14px}.brand>span{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#6386ee;font-size:22px;font-weight:800}.brand strong{display:block;font-size:21px}.brand small{display:block;color:#cbd7f4;margin-top:2px}.header-actions{display:flex;gap:10px}button{border:1px solid #c8d1e2;border-radius:8px;background:#fff;color:#23324e;padding:9px 14px;cursor:pointer}button:hover{border-color:#6c8fe9}.primary{background:#5d7fe3;color:#fff;border-color:#5d7fe3}.types{height:82px;display:flex;align-items:stretch;gap:3px;padding:9px 22px;background:#fff;border-bottom:1px solid #d8dfeb;overflow-x:auto}.type-button{min-width:92px;display:grid;place-items:center;gap:2px;border:0;background:transparent}.type-button span{font-size:25px;color:#4f6ee8}.type-button.active{background:#eaf0ff;color:#294caa}.type-button b{font-size:12px}main{height:calc(100vh - 154px);display:grid;grid-template-columns:280px minmax(420px,1fr) 300px}.panel{padding:20px;background:#f9fafc;overflow:auto}.bindings{border-right:1px solid #d7deea}.options{border-left:1px solid #d7deea}.panel h2{margin:4px 0 14px;font-size:14px;text-transform:uppercase;letter-spacing:.08em;color:#64728d}.panel label{display:grid;gap:6px;margin:0 0 13px;font-size:13px;color:#59667e}.panel select,.panel input,.panel textarea{width:100%;padding:9px;border:1px solid #cad3e3;border-radius:7px;background:#fff;color:#1e2b45}.check{display:flex!important;grid-template-columns:auto 1fr;align-items:center}.check input{width:auto}.preview{min-width:0;display:grid;grid-template-rows:minmax(0,1fr) 34px;padding:22px;background:#e7ecf4}.preview #chart{min-width:0;min-height:0;background:#fff;border:1px solid #d6deeb;border-radius:12px;box-shadow:0 12px 30px #26395e18;overflow:hidden}.preview #status{align-self:end;color:#71809a;font-size:12px;padding-top:9px}.chart-web-surface{position:relative;width:100%;height:100%;min-height:300px}.chart-web-svg{display:block;width:100%;height:100%;font-family:Segoe UI,Arial,sans-serif}.chart-title{fill:#253653;font-size:20px;font-weight:700}.chart-grid{stroke:#dfe5ee}.chart-axis{stroke:#73809a;stroke-width:1.2}.chart-axis-label,.chart-legend{fill:#65718a;font-size:11px}.chart-total{fill:#253653;font-size:18px;font-weight:700}.chart-web-empty{height:100%;display:grid;place-content:center;gap:6px;text-align:center;color:#7a869e}.chart-web-warning{position:absolute;right:8px;bottom:6px;padding:5px 8px;border-radius:5px;background:#fff4ce;color:#725500;font-size:11px}.series-row{display:grid;grid-template-columns:1fr 82px 34px;gap:5px;margin-bottom:8px}.series-row select{padding:7px}.series-row input{width:34px;height:34px;padding:2px}.series-row button{padding:4px;color:#a33}hr{border:0;border-top:1px solid #dce2ec;margin:20px 0}details{margin-top:22px}summary{cursor:pointer;font-weight:700}textarea#json{height:280px;margin-top:10px;font:11px Consolas,monospace}#error{color:#b42318;font-size:12px;margin-top:12px}@media(max-width:1100px){main{grid-template-columns:240px minmax(360px,1fr) 250px}}
:root{font-family:Inter,"Segoe UI",Arial,sans-serif;color:#1e2b45;background:#edf1f7}*{box-sizing:border-box}body{margin:0;min-width:900px}button,input,select,textarea{font:inherit}header{height:72px;padding:0 26px;display:flex;align-items:center;justify-content:space-between;background:#1f3158;color:#fff}.brand{display:flex;align-items:center;gap:14px}.brand>span{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#6386ee;font-size:22px;font-weight:800}.brand strong{display:block;font-size:21px}.brand small{display:block;color:#cbd7f4;margin-top:2px}.header-actions{display:flex;gap:10px}button{border:1px solid #c8d1e2;border-radius:8px;background:#fff;color:#23324e;padding:9px 14px;cursor:pointer}button:hover{border-color:#6c8fe9}.primary{background:#5d7fe3;color:#fff;border-color:#5d7fe3}.hidden{display:none!important}.types{height:82px;display:flex;align-items:stretch;gap:3px;padding:9px 22px;background:#fff;border-bottom:1px solid #d8dfeb;overflow-x:auto}.type-button{min-width:92px;display:grid;place-items:center;gap:2px;border:0;background:transparent}.type-button span{font-size:25px;color:#4f6ee8}.type-button.active{background:#eaf0ff;color:#294caa}.type-button b{font-size:12px}main{height:calc(100vh - 154px);display:grid;grid-template-columns:280px minmax(420px,1fr) 300px}.panel{padding:20px;background:#f9fafc;overflow:auto}.bindings{border-right:1px solid #d7deea}.options{border-left:1px solid #d7deea}.panel h2{margin:4px 0 14px;font-size:14px;text-transform:uppercase;letter-spacing:.08em;color:#64728d}.panel label{display:grid;gap:6px;margin:0 0 13px;font-size:13px;color:#59667e}.panel select,.panel input,.panel textarea{width:100%;padding:9px;border:1px solid #cad3e3;border-radius:7px;background:#fff;color:#1e2b45}.check{display:flex!important;grid-template-columns:auto 1fr;align-items:center}.check input{width:auto}.preview{min-width:0;display:grid;grid-template-rows:minmax(0,1fr) 34px;padding:22px;background:#e7ecf4}.preview #chart{min-width:0;min-height:0;background:#fff;border:1px solid #d6deeb;border-radius:12px;box-shadow:0 12px 30px #26395e18;overflow:hidden}.preview #status{align-self:end;color:#71809a;font-size:12px;padding-top:9px}.chart-web-surface{position:relative;width:100%;height:100%;min-height:300px}.chart-web-svg{display:block;width:100%;height:100%;font-family:Segoe UI,Arial,sans-serif}.chart-title{fill:#253653;font-size:20px;font-weight:700}.chart-grid{stroke:#dfe5ee}.chart-axis{stroke:#73809a;stroke-width:1.2}.chart-axis-label,.chart-legend{fill:#65718a;font-size:11px}.chart-total{fill:#253653;font-size:18px;font-weight:700}.chart-web-empty{height:100%;display:grid;place-content:center;gap:6px;text-align:center;color:#7a869e}.chart-web-warning{position:absolute;right:8px;bottom:6px;padding:5px 8px;border-radius:5px;background:#fff4ce;color:#725500;font-size:11px}.series-row{display:grid;grid-template-columns:1fr 82px 34px;gap:5px;margin-bottom:8px}.series-row select{padding:7px}.series-row input{width:34px;height:34px;padding:2px}.series-row button{padding:4px;color:#a33}hr{border:0;border-top:1px solid #dce2ec;margin:20px 0}details{margin-top:22px}summary{cursor:pointer;font-weight:700}textarea#json{height:280px;margin-top:10px;font:11px Consolas,monospace}#error{color:#b42318;font-size:12px;margin-top:12px}@media(max-width:1100px){main{grid-template-columns:240px minmax(360px,1fr) 250px}}
.chart-value-label{fill:#42516b;font-size:10px;font-weight:600}.gauge-value{fill:#253653;font-size:18px;font-weight:700}.treemap-label{fill:#fff;font-size:12px;font-weight:700}.treemap-value{fill:#ffffffd9;font-size:10px}.type-options{display:none;border-top:1px solid #dce2ec;margin-top:18px;padding-top:16px}.type-options.active{display:block}.type-options p{font-size:12px;line-height:1.45;color:#68758d}.threshold-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.threshold-grid label{margin-bottom:3px}
.format-section{border-top:1px solid #dce2ec;margin-top:18px;padding-top:14px}.format-section summary{margin-bottom:12px;text-transform:uppercase;letter-spacing:.08em;color:#64728d;font-size:13px}.two-cols{display:grid;grid-template-columns:1fr 1fr;gap:8px}.label-parts{display:grid;grid-template-columns:1fr 1fr;gap:4px}.chart-data-label{fill:#344054;font-weight:600;paint-order:stroke;stroke:#fff;stroke-width:2px;stroke-linejoin:round}.chart-group-label{fill:#526071;font-size:11px;font-weight:700}.treemap-group-label{fill:#fff;font-size:12px;font-weight:800;paint-order:stroke;stroke:#0005;stroke-width:2px}
.section-help{margin:0 0 12px;color:#71809a;font-size:12px;line-height:1.4}.preview #chart{position:relative}.chart-title[data-chart-action]{cursor:move}.chart-legend-control{cursor:pointer}.chart-margin-controls line{stroke:transparent;stroke-width:14;pointer-events:stroke}.chart-margin-controls line[data-margin-handle="left"],.chart-margin-controls line[data-margin-handle="right"]{cursor:ew-resize}.chart-margin-controls line[data-margin-handle="top"],.chart-margin-controls line[data-margin-handle="bottom"]{cursor:ns-resize}.chart-margin-controls line:hover{stroke:#5d7fe3;stroke-opacity:.42;stroke-dasharray:5 4}.chart-margin-dragging,.chart-title-dragging{user-select:none;cursor:grabbing}.chart-inline-title{position:absolute;z-index:5;left:18px;top:12px;width:min(430px,70%);padding:7px 10px;border:2px solid #5d7fe3;border-radius:7px;background:#fff;box-shadow:0 6px 20px #1f315833}.chart-direct-popover{position:absolute;z-index:6;top:54px;right:18px;max-width:310px;padding:10px;border:1px solid #c8d1e2;border-radius:9px;background:#fff;box-shadow:0 10px 28px #1f31582e}.chart-direct-popover strong{display:block;margin-bottom:8px;font-size:12px}.chart-direct-popover>div{display:flex;flex-wrap:wrap;gap:5px}.chart-direct-popover button{padding:6px 8px;font-size:11px}.chart-direct-popover button.active{background:#5d7fe3;color:#fff;border-color:#5d7fe3}
.chart-lollipop{stroke:#8492a8;stroke-width:1.5;stroke-dasharray:3 2;opacity:.75}
.type-options[open] summary{margin-bottom:12px}.type-options summary{text-transform:uppercase;letter-spacing:.08em;color:#64728d;font-size:13px}
.chart-doughnut-resize{fill:#fff;stroke:#5d7fe3;stroke-width:3;cursor:ew-resize;opacity:.65}.chart-doughnut-resize:hover{opacity:1;stroke-width:4}.chart-doughnut-dragging{user-select:none;cursor:ew-resize}
.preview #chart{align-self:stretch;width:100%;height:100%;max-height:none;aspect-ratio:auto;background:#fff}
.chart-web-surface{height:100%;min-height:0}
.axis-visibility{margin-bottom:12px!important}
.chart-web-svg.hide-category-axis .chart-axis-label:not(.value-axis-label),.chart-web-svg.hide-category-axis .chart-group-label{display:none}
.chart-web-svg.hide-value-axis .value-axis-label{display:none}
.chart-options-context{position:fixed;z-index:1000;display:grid;min-width:190px;padding:6px;border:1px solid #c8d1e2;border-radius:9px;background:#fff;box-shadow:0 12px 32px #1f315838}.chart-options-context button{border:0;border-radius:5px;padding:7px 10px;text-align:left;background:transparent;font-size:12px}.chart-options-context button:hover{background:#eaf0ff;color:#294caa}.group-shading-controls{margin:0 0 13px;padding:10px;border:1px solid #dce2ec;border-radius:8px;background:#fff}
.chart-axis-label{cursor:pointer}.chart-direct-popover [data-hide-legend]{color:#a33}.chart-legend text{pointer-events:none}
.chart-options-context .menu-title{padding:7px 10px;border-bottom:1px solid #dce2ec;color:#344054;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
html,body{width:100%;height:100%;min-width:0;overflow:hidden}body{display:grid;grid-template-rows:72px 82px minmax(0,1fr)}header{width:100%;min-width:0}.types{width:100%;min-width:0;overflow:hidden;padding-inline:12px}.type-button{min-width:58px;flex:1 1 72px;padding-inline:3px}.type-button b{white-space:normal;line-height:1.05}main{width:100%;height:auto;min-width:0;min-height:0;grid-template-columns:minmax(205px,280px) minmax(0,1fr) minmax(225px,300px);overflow:hidden}.panel{min-width:0;min-height:0}.preview{min-width:0;min-height:0;overflow:hidden}.preview #chart,.chart-web-surface{width:100%;height:100%;min-width:0;min-height:0}@media(max-width:1100px){main{grid-template-columns:minmax(185px,240px) minmax(0,1fr) minmax(210px,250px)}.types{padding-inline:4px}.type-button{min-width:48px}.type-button b{font-size:10px}}
.chart-small-multiples{display:grid;grid-template-columns:repeat(var(--multiple-columns,2),minmax(0,1fr));grid-auto-rows:minmax(0,1fr);gap:8px;padding:8px;overflow:hidden}.chart-small-multiple{display:grid;grid-template-rows:auto minmax(0,1fr);min-width:0;min-height:0;border:1px solid #dfe5ee;border-radius:6px;overflow:hidden}.chart-small-multiple>b{padding:4px 7px;color:#34425e;font-size:11px}.chart-small-multiple>.chart-web-surface{min-height:0}
.options-heading{display:flex;align-items:center;justify-content:space-between;gap:8px}.options-heading h2{margin-bottom:14px}.options-heading>div{display:flex;gap:5px}.options-heading button{padding:5px 7px;font-size:11px}.options-pane-tab{display:none;position:absolute;inset:0;padding:0;writing-mode:vertical-rl;border:0;border-radius:0;background:#eef2fa;color:#354365;font-weight:700;text-transform:uppercase;letter-spacing:.08em}main.options-collapsed{grid-template-columns:280px minmax(420px,1fr) 34px}main.options-collapsed .options{padding:0;overflow:hidden;position:relative}main.options-collapsed .options>*:not(.options-pane-tab){display:none}main.options-collapsed .options-pane-tab{display:block}
.data-heading{display:flex;align-items:center;justify-content:space-between}.data-heading button{padding:5px 8px}.data-pane-tab{display:none;position:absolute;inset:0;padding:0;writing-mode:vertical-rl;border:0;border-radius:0;background:#eef2fa;color:#354365;font-weight:700;text-transform:uppercase;letter-spacing:.08em}main.data-collapsed{grid-template-columns:34px minmax(420px,1fr) 300px}main.data-collapsed.options-collapsed{grid-template-columns:34px minmax(420px,1fr) 34px}main.data-collapsed .bindings{padding:0;overflow:hidden;position:relative}main.data-collapsed .bindings>*:not(.data-pane-tab){display:none}main.data-collapsed .data-pane-tab{display:block}
.panel input[type="color"]{height:40px;padding:4px;cursor:pointer}.panel input[type="color"]::-webkit-color-swatch-wrapper{padding:0}.panel input[type="color"]::-webkit-color-swatch{border:1px solid #aeb9ca;border-radius:5px}.chart-general-options{padding:12px;margin-bottom:8px;border:1px solid #dce3ee;border-radius:9px;background:#f3f6fb}.chart-general-options label:last-child{margin-bottom:0}.chart-legend-control{cursor:move}.chart-legend-dragging,.chart-size-dragging{user-select:none;cursor:grabbing}.chart-size-resize{fill:#fff;stroke:#5d7fe3;stroke-width:3;cursor:ew-resize;opacity:.72}.chart-size-resize:hover{opacity:1;stroke-width:4}
.chart-overlay-resize{position:absolute;right:9%;top:50%;width:18px;height:18px;padding:0;border:4px solid #8294ec;border-radius:50%;background:#fff;opacity:.8;cursor:ew-resize;transform:translateY(-50%)}.chart-overlay-resize:hover{opacity:1}
.chart-radial-group-label{fill:#526071;font-size:11px;font-weight:700;cursor:pointer}
.series-row{grid-template-columns:minmax(70px,1fr) 74px 34px 30px 30px}.series-row [data-remove-series]{color:#a33}.series-row [data-theme-color]{font-size:14px;color:#4d5d78}
.chart-small-multiples{gap:var(--multiple-gap,8px)}
.series-target{margin:8px 0 12px;padding:8px;border-radius:7px;background:#eef2ff}.series-target select{margin-top:5px}
