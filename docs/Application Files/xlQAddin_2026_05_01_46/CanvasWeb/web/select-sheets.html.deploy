<!doctype html><html><head><meta charset="utf-8"><title>Load selected sheets</title><style>:root{font:15px "Segoe UI",sans-serif;color:#17213d;background:#eef2f8}*{box-sizing:border-box}body{margin:0;height:100vh;display:grid;grid-template-rows:90px auto 1fr 75px}header{background:#283456;color:white;padding:18px 28px;display:flex;align-items:center;gap:14px}header b{font-size:24px}header span{width:48px;height:48px;border-radius:13px;background:#6682ee;display:grid;place-items:center;font-size:28px;font-weight:800}.tools{padding:16px 26px;display:flex;gap:10px}.tools input{flex:1}button,input{font:inherit;border:1px solid #c6d1e2;border-radius:9px;padding:10px 13px;background:white}button{cursor:pointer}.primary{background:#627dea;color:white}.list{margin:0 26px;overflow:auto;background:white;border:1px solid #d4ddeb;border-radius:12px}.row{display:grid;grid-template-columns:35px 1.4fr .8fr 1fr;gap:10px;align-items:center;padding:10px 15px;border-bottom:1px solid #e1e6ef}.row:hover{background:#f5f7fc}.row small{color:#69758d}footer{padding:14px 26px;display:flex;justify-content:space-between;align-items:center}</style><script src="shared-settings.js?v=20260922-dialogs-1"></script></head><body><header><span>Q</span><div><b>Load selected sheets</b><div>Choose workbook sheets to refresh</div></div></header><div class="tools"><input id="search" placeholder="Search sheets"><button id="all">Select all</button><button id="none">Clear</button></div><div id="list" class="list"></div><footer><label><input id="templates" type="checkbox"> Show template sheets next time</label><div><button id="cancel">Cancel</button> <button id="load" class="primary">Load selected</button></div></footer><script>let sheets=[];const $=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function render(){const q=$('search').value.toLowerCase();$('list').innerHTML=sheets.map((s,i)=>({s,i})).filter(x=>!q||x.s.Name.toLowerCase().includes(q)).map(x=>`<label class="row"><input type="checkbox" data-i="${x.i}" ${x.s.selected?'checked':''}><b>${esc(x.s.Name)}</b><small>${esc(x.s.Template||'')}</small><span>${esc(x.s.Action||'Update sheet')}</span></label>`).join('');document.querySelectorAll('[data-i]').forEach(x=>x.onchange=()=>sheets[+x.dataset.i].selected=x.checked)}$('search').oninput=render;$('all').onclick=()=>{sheets.forEach(x=>x.selected=true);render()};$('none').onclick=()=>{sheets.forEach(x=>x.selected=false);render()};$('cancel').onclick=()=>chrome.webview.postMessage({type:'closeWindow'});$('load').onclick=()=>chrome.webview.postMessage({type:'sheetApply',selected:sheets.filter(x=>x.selected).map(x=>x.Name),showTemplates:$('templates').checked});chrome.webview.addEventListener('message',e=>{if(e.data.type==='loadSheetWorkspace'){sheets=(e.data.sheets||[]).map(x=>({...x,selected:false}));render()}});addEventListener('DOMContentLoaded',()=>chrome.webview.postMessage({type:'ready'}));</script></body></html>
