const $=id=>document.getElementById(id);let query={},measures=[],data={columns:[],rows:[]},selected=-1,pending=new Map(),zones={rows:[],columns:[],values:[]},view={data:{columns:[],rows:[]},sort:-1,dir:0,hidden:new Set(),formats:new Map()};
const metricValue=m=>m?.Value&&typeof m.Value==='object'?m.Value:m?.value&&typeof m.value==='object'?m.value:m;
const normalizeMetric=input=>{const m=metricValue(input)||{},name=m.Name??m.name??m.OutputName??m.outputName??m.MeasureName??m.measureName??m.MetricName??m.metricName??m.Caption??m.caption??m.Key??m.key??'',expression=m.Expression??m.expression??m.CustomFormula??m.customFormula??m.Formula??m.formula??m.DaxExpression??m.daxExpression??m.FormulaText??m.formulaText??'';return {...m,Name:String(name??''),Expression:String(expression??'')};};
const metricList=q=>{const source=q?.measures??q?.Measures??q?.metrics??q?.Metrics??[];return Array.isArray(source)?source:Array.isArray(source?.$values)?source.$values:[];};
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const columnName=c=>typeof c==='string'?c:c.name??c.Name??'';const actions={daxLoad:'dax-load',daxValidate:'dax-validate',daxMatrix:'dax-matrix'};function toast(t){$('toast').textContent=t;$('toast').classList.remove('hidden');setTimeout(()=>$('toast').classList.add('hidden'),3000)}function call(type,payload={}){return new Promise((resolve,reject)=>{pending.set(actions[type],{resolve,reject});chrome.webview.postMessage({type,...payload})})}
const measureTemplates=(field)=>[{label:'Add SUM measure',suffix:'_sum',expression:`SUM(${field})`},{label:'Add MIN measure',suffix:'_min',expression:`MIN(${field})`},{label:'Add MAX measure',suffix:'_max',expression:`MAX(${field})`},{label:'Add AVERAGE measure',suffix:'_avg',expression:`AVERAGE(${field})`},{label:'Add DISTINCTCOUNT measure',suffix:'_dc',expression:`DISTINCTCOUNT(${field})`},{label:'Add prior-year SUM measure',suffix:'_py',expression:`VAR _curYear = MAX(year)\nVAR _py = _curYear - 1\nRETURN CALCULATE(SUM(${field}), REMOVEFILTERS(year), year = _py)`},{label:'Add prior-year SUM by period',suffix:'_py_period',expression:`VAR _curPeriod = MAX(period)\nVAR _pyPeriod = _curPeriod - 100\nRETURN CALCULATE(SUM(${field}), REMOVEFILTERS(period), period = _pyPeriod)`},{label:'Add current-year SUM measure',suffix:'_cy',expression:`VAR _curYear = MAX(year)\nRETURN CALCULATE(SUM(${field}), REMOVEFILTERS(year), year = _curYear)`},{label:'Add 12-month rolling SUM',suffix:'_r12',expression:`VAR _curPeriod = MAX(period)\nVAR _startPeriod = _curPeriod - 11\nRETURN CALCULATE(SUM(${field}), REMOVEFILTERS(period), period >= _startPeriod AND period <= _curPeriod)`},{label:'Add YTD SUM',suffix:'_ytd',expression:`VAR _curYear = MAX(year)\nVAR _curMonth = MAX(month)\nRETURN CALCULATE(SUM(${field}), REMOVEFILTERS(year, month), year = _curYear AND month <= _curMonth)`},{label:'Add Rank',suffix:'_rank',expression:`RANK(${field}, "DESC", "SKIP")`}];
const calcTemplates=(field)=>[{label:'Concatenate',suffix:'_text',expression:`"example " & ${field}`},{label:'Format value',suffix:'_formatted',expression:`FORMAT(${field}, "N0")`},{label:'Format date',suffix:'_date_text',expression:`FORMAT(${field}, "yyyy-MM-dd")`},{label:'Date offset (days)',suffix:'_offset',expression:`DATEOFFSET(${field}, 0, 0, 7, 0)`},{label:'Round',suffix:'_rounded',expression:`ROUND(${field}, 0)`},{label:'Divide',suffix:'_divided',expression:`DIVIDE(${field}, 1000)`},{label:'Left',suffix:'_left',expression:`LEFT(${field}, 3)`},{label:'Right',suffix:'_right',expression:`RIGHT(${field}, 3)`},{label:'Year',suffix:'_year',expression:`YEAR(${field})`},{label:'Month',suffix:'_month',expression:`MONTH(${field})`},{label:'MonthString',suffix:'_month_text',expression:`RIGHT("00" & MONTH(${field}), 2)`},{label:'IF',suffix:'_if',expression:`IF(${field} > 0, "pos", "neg")`},{label:'SWITCH',suffix:'_switch',expression:`SWITCH(TRUE(), ${field} < 0, "neg", ${field} = 0, "zero", "pos")`},{label:'Month name',suffix:'_month_name',expression:`SWITCH(TRUE(), ${field} = 1, "jan", ${field} = 2, "feb", ${field} = 3, "mar", ${field} = 4, "apr", ${field} = 5, "mai", ${field} = 6, "jun", ${field} = 7, "jul", ${field} = 8, "aug", ${field} = 9, "sep", ${field} = 10, "okt", ${field} = 11, "nov", ${field} = 12, "des", BLANK())`},{label:'Quarter',suffix:'_quarter',expression:`SWITCH(TRUE(), ${field} >= 1 AND ${field} <= 3, "Q1", ${field} >= 4 AND ${field} <= 6, "Q2", ${field} >= 7 AND ${field} <= 9, "Q3", ${field} >= 10 AND ${field} <= 12, "Q4", BLANK())`}];
function uniqueName(base){let n=base,i=2;while(measures.some(m=>String(m.Name).toLowerCase()===n.toLowerCase()))n=`${base}_${i++}`;return n}function calcResultType(label){if(/date offset/i.test(label))return'Date';if(/round|divide|year|^month$/i.test(label))return'Number';return'Text'}function createMetric(field,t,kind=0){saveDraft();const dataType=kind?calcResultType(t.label):'Number',metric={Name:uniqueName(field+t.suffix),Expression:t.expression,DataType:dataType,FormatString:dataType==='Date'?'yyyy-MM-dd':dataType==='Number'?'N0':'',ShowInMatrix:true,BarInMatrix:false,IsCustom:true,Kind:kind};measures.push(metric);selected=measures.length-1;$('name').value=metric.Name;$('expression').value=metric.Expression;renderMeasures();hideMenus();$('expression').focus()}
function fieldMenu(e,field){const menu=$('fieldMenu');menu.className='menu field-menu';menu.style.left=`${Math.min(e.clientX,innerWidth-300)}px`;menu.style.top=`${Math.min(e.clientY,innerHeight-630)}px`;menu.innerHTML=`<div class="section">Measures</div>${measureTemplates(field).map((t,i)=>`<button data-measure-template="${i}">${esc(t.label)}</button>`).join('')}<hr><div class="section">Calculated columns</div>${calcTemplates(field).map((t,i)=>`<button data-calc-template="${i}">${esc(t.label)}</button>`).join('')}`;menu.querySelectorAll('[data-measure-template]').forEach(b=>b.onclick=()=>createMetric(field,measureTemplates(field)[+b.dataset.measureTemplate],0));menu.querySelectorAll('[data-calc-template]').forEach(b=>b.onclick=()=>createMetric(field,calcTemplates(field)[+b.dataset.calcTemplate],1))}
function renderFields(){const q=$('fieldSearch').value.toLowerCase(),types=data.types||[];$('fields').innerHTML=(data.columns||[]).map((c,i)=>({name:columnName(c),type:String(types[i]||c.type||c.Type||'').split('.').pop()})).filter(x=>!q||x.name.toLowerCase().includes(q)).map(x=>`<div class="field" draggable="true" data-field="${esc(x.name)}"><span>${esc(x.name)}</span>${x.type?`<small>${esc(x.type)}</small>`:''}</div>`).join('')||'<p>No fields loaded.</p>';document.querySelectorAll('[data-field]').forEach(x=>{x.ondragstart=e=>e.dataTransfer.setData('text/plain',`field:${x.dataset.field}`);x.ondblclick=()=>addZone('rows',x.dataset.field);x.oncontextmenu=e=>{e.preventDefault();fieldMenu(e,x.dataset.field)}})}
function renderMeasures(){const q=$('measureSearch').value.toLowerCase();$('measureList').innerHTML=measures.map((m,i)=>({m,i})).filter(x=>!q||String(x.m.Name||'').toLowerCase().includes(q)).map(x=>`<div class="measure ${x.i===selected?'active':''} ${+x.m.Kind===1?'calculated':''}" draggable="true" data-measure="${x.i}"><b>${esc(x.m.Name||'Unnamed')}</b><small>${esc(x.m.FormatString||'Auto')} · ${esc(x.m.DataType||'Number')}</small></div>`).join('');document.querySelectorAll('[data-measure]').forEach(x=>{x.onclick=()=>selectMeasure(+x.dataset.measure);x.oncontextmenu=e=>{e.preventDefault();measureMenu(e,+x.dataset.measure)};x.ondragstart=e=>e.dataTransfer.setData('text/plain',`measure:${x.dataset.measure}`)})}
function selectMeasure(i){saveDraft();selected=i;$('name').value=measures[i]?.Name||'';$('expression').value=measures[i]?.Expression||'';renderMeasures()}function saveDraft(){if(selected<0||!measures[selected])return;measures[selected].Name=$('name').value.trim()||measures[selected].Name;measures[selected].Expression=$('expression').value}function newMeasure(){saveDraft();measures.push({Name:uniqueName('New measure'),Expression:'',DataType:'Number',FormatString:'',ShowInMatrix:true,BarInMatrix:false,IsCustom:true,Kind:0});selectMeasure(measures.length-1);$('name').select()}
function measureMenu(e,index){const metric=measures[index],menu=$('fieldMenu'),formats=['Auto','N0','N1','N2','P0','P1','P2','K0','K1','M0','M1','yyyy-MM-dd','MMM yyyy','Custom'];selectMeasure(index);menu.className='menu measure-menu';menu.style.left=`${Math.min(e.clientX,innerWidth-300)}px`;menu.style.top=`${Math.min(e.clientY,innerHeight-430)}px`;const current=metric.FormatString||'Auto',known=formats.includes(current)?current:'Custom';menu.innerHTML=`<div class="section">${esc(metric.Name)}</div><label>Format<select id="measureFormat">${formats.map(f=>`<option ${f===known?'selected':''}>${f}</option>`).join('')}</select></label><label id="customFormatWrap" class="${known==='Custom'?'':'hidden'}">Custom format<input id="customFormat" value="${esc(known==='Custom'?current:'#,##0.0')}"></label><div id="formatPreview" class="format-preview"></div><hr><button id="deleteMeasureMenu" class="danger">Delete ${+metric.Kind===1?'calculated column':'measure'}</button>`;const select=$('measureFormat'),custom=$('customFormat'),preview=()=>{$('formatPreview').textContent=`Preview: ${format(1234567.89,select.value==='Custom'?custom.value:select.value)}`},saveFormat=()=>{metric.FormatString=select.value==='Auto'?'':select.value==='Custom'?custom.value:select.value;renderMeasures();applyMeasureFormats(view.data);renderResult(view.data);preview()};select.onchange=()=>{$('customFormatWrap').classList.toggle('hidden',select.value!=='Custom');saveFormat()};custom.oninput=saveFormat;$('deleteMeasureMenu').onclick=()=>{measures.splice(index,1);for(const z of Object.keys(zones))zones[z]=zones[z].filter(x=>x!==metric.Name);selected=-1;$('name').value='';$('expression').value='';renderMeasures();renderZones();hideMenus();toast('Item deleted')};preview()}
function addZone(zone,name,index){if(!name)return;if(zone==='columns'){zones.columns=[name]}else{const old=zones[zone].indexOf(name);if(old>=0)zones[zone].splice(old,1);zones[zone].splice(index==null?zones[zone].length:index,0,name)}renderZones()}function moveChip(raw,to,index){const[,from,position]=raw.split(':'),item=zones[from]?.[+position];if(!item)return;zones[from].splice(+position,1);if(from===to&&+position<index)index--;addZone(to,item,index)}function renderZones(){for(const zone of Object.keys(zones)){$(zone).innerHTML=zones[zone].map((x,i)=>`<span class="chip" draggable="true" data-chip="${zone}:${i}">${esc(x)} <span data-remove="${zone}:${i}">×</span></span>`).join('');$(zone).ondragover=e=>e.preventDefault();$(zone).ondrop=e=>{e.preventDefault();const raw=e.dataTransfer.getData('text/plain');if(raw.startsWith('chip:'))moveChip(raw,zone,zones[zone].length);else{const[kind,...rest]=raw.split(':');addZone(zone,kind==='measure'?measures[+rest.join(':')]?.Name:rest.join(':'))}}}document.querySelectorAll('[data-chip]').forEach(x=>{x.ondragstart=e=>{e.dataTransfer.setData('text/plain',`chip:${x.dataset.chip}`);x.classList.add('dragging')};x.ondragover=e=>e.preventDefault();x.ondrop=e=>{e.preventDefault();e.stopPropagation();const[to,index]=x.dataset.chip.split(':'),raw=e.dataTransfer.getData('text/plain');if(raw.startsWith('chip:'))moveChip(raw,to,+index)}});document.querySelectorAll('[data-remove]').forEach(x=>x.onclick=e=>{e.stopPropagation();const[z,i]=x.dataset.remove.split(':');zones[z].splice(+i,1);renderZones()})}
function format(v,f){if(v==null)return'';const n=Number(v),code=String(f||'Auto');if(code==='Auto'||code==='auto'||code==='text')return String(v);if(code==='integer'||/^N\d$/i.test(code)){const d=code==='integer'?0:+code.slice(1);return Number.isFinite(n)?n.toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d}):String(v)}if(code==='number')return Number.isFinite(n)?n.toLocaleString():String(v);if(code==='percent'||/^P\d$/i.test(code)){const d=code==='percent'?0:+code.slice(1);return Number.isFinite(n)?`${(n*100).toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d})}%`:String(v)}if(/^[KM]\d$/i.test(code)){const scale=code[0].toUpperCase()==='K'?1e3:1e6,d=+code[1],suffix=code[0].toUpperCase();return Number.isFinite(n)?`${(n/scale).toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d})}${suffix}`:String(v)}if(code==='excelDate'){const d=new Date(Date.UTC(1899,11,30)+n*86400000);return isNaN(d)?v:d.toLocaleDateString()}if(/y|M{3}/.test(code)){const d=v instanceof Date?v:new Date(v);if(!isNaN(d))return code==='MMM yyyy'?d.toLocaleDateString(undefined,{month:'short',year:'numeric'}):d.toLocaleDateString('sv-SE')}if(Number.isFinite(n)&&/[#0]/.test(code)){const decimal=Math.max(code.lastIndexOf('.'),code.lastIndexOf(',')),digits=decimal>=0?(code.slice(decimal+1).match(/[0#]/g)||[]).length:0,group=/[.,].*[0#]/.test(code);return n.toLocaleString(undefined,{useGrouping:group,minimumFractionDigits:(code.slice(decimal+1).match(/0/g)||[]).length,maximumFractionDigits:Math.min(10,digits)})}return String(v)}
function applyMeasureFormats(result){const names=(result?.columns||[]).map(columnName);if(zones.columns.length&&zones.values.length){for(let i=zones.rows.length;i<names.length;i++){const metric=measures.find(m=>m.Name===zones.values[(i-zones.rows.length)%zones.values.length]);if(metric?.FormatString)view.formats.set(i,metric.FormatString)}}else names.forEach((name,i)=>{const metric=measures.find(m=>String(m.Name).toLowerCase()===String(name).toLowerCase());if(metric?.FormatString)view.formats.set(i,metric.FormatString)})}
function pivotResult(result){const names=(result.columns||[]).map(columnName);if(!zones.columns.length){const requested=[...zones.rows,...zones.values],indexes=requested.map(name=>names.indexOf(name)).filter((index,position,list)=>index>=0&&list.indexOf(index)===position),filtered=indexes.length?{columns:indexes.map(index=>result.columns[index]),rows:(result.rows||[]).map(row=>indexes.map(index=>row[index]))}:result;applyMeasureFormats(filtered);return filtered}const rowIdx=zones.rows.map(x=>names.indexOf(x)).filter(x=>x>=0),colIdx=names.indexOf(zones.columns[0]),valNames=zones.values.length?zones.values:names.filter((_,i)=>!rowIdx.includes(i)&&i!==colIdx),valIdx=valNames.map(x=>names.indexOf(x));if(colIdx<0||!valIdx.length){applyMeasureFormats(result);return result}const colValues=[...new Set((result.rows||[]).map(r=>String(r[colIdx]??'')))],groups=new Map();for(const r of result.rows||[]){const key=JSON.stringify(rowIdx.map(i=>r[i]));if(!groups.has(key))groups.set(key,[...rowIdx.map(i=>r[i]),...Array(colValues.length*valIdx.length).fill(null)]);const target=groups.get(key),ci=colValues.indexOf(String(r[colIdx]??''));valIdx.forEach((vi,j)=>target[rowIdx.length+ci*valIdx.length+j]=r[vi])}const columns=[...zones.rows,...colValues.flatMap(c=>valNames.map(v=>valNames.length===1?c:`${c} · ${v}`))],pivoted={columns,rows:[...groups.values()]};applyMeasureFormats(pivoted);return pivoted}
function renderResult(result){view.data=result||{columns:[],rows:[]};const cols=view.data.columns||[],visible=cols.map((c,i)=>({c,i})).filter(x=>!view.hidden.has(x.i));let rows=[...(view.data.rows||[])];if(view.sort>=0&&view.dir)rows.sort((a,b)=>String(a[view.sort]??'').localeCompare(String(b[view.sort]??''),undefined,{numeric:true})*view.dir);$('resultHead').innerHTML=`<tr>${visible.map(x=>`<th data-col="${x.i}">${esc(columnName(x.c))}${view.sort===x.i?(view.dir===1?' ▲':' ▼'):''}</th>`).join('')}</tr>`;$('resultBody').innerHTML=rows.map(r=>`<tr>${visible.map(x=>`<td>${esc(format(r[x.i],view.formats.get(x.i)||'auto'))}</td>`).join('')}</tr>`).join('');$('resultCount').textContent=`${rows.length} row(s) · ${cols.length} column(s)`;document.querySelectorAll('[data-col]').forEach(th=>{th.onclick=()=>{const i=+th.dataset.col;if(view.sort!==i){view.sort=i;view.dir=1}else if(view.dir===1)view.dir=-1;else{view.sort=-1;view.dir=0}renderResult(view.data)};th.oncontextmenu=e=>{e.preventDefault();columnMenu(e,+th.dataset.col)}})}
function columnMenu(e,index){const cols=view.data.columns||[],menu=$('columnMenu');menu.style.left=`${Math.min(e.clientX,innerWidth-290)}px`;menu.style.top=`${Math.min(e.clientY,innerHeight-500)}px`;menu.innerHTML=`<b>${esc(columnName(cols[index]))}</b><button data-sort="1">Sort ascending</button><button data-sort="-1">Sort descending</button><button data-sort="0">Clear sorting</button><label>Format <select id="fmt"><option value="auto">Auto</option><option value="number">Number</option><option value="integer">Integer</option><option value="percent">Percent</option><option value="excelDate">Excel date</option><option value="text">Text</option></select></label><hr><b>Visible columns</b>${cols.map((c,i)=>`<label><input type="checkbox" data-visible="${i}" ${view.hidden.has(i)?'':'checked'}> ${esc(columnName(c))}</label>`).join('')}`;menu.classList.remove('hidden');$('fmt').value=view.formats.get(index)||'auto';$('fmt').onchange=x=>{view.formats.set(index,x.target.value);renderResult(view.data);menu.classList.add('hidden')};menu.querySelectorAll('[data-sort]').forEach(b=>b.onclick=()=>{view.sort=+b.dataset.sort?index:-1;view.dir=+b.dataset.sort;renderResult(view.data);menu.classList.add('hidden')});menu.querySelectorAll('[data-visible]').forEach(x=>x.onchange=()=>{x.checked?view.hidden.delete(+x.dataset.visible):view.hidden.add(+x.dataset.visible);renderResult(view.data)})}
function hideMenus(){$('columnMenu').classList.add('hidden');$('fieldMenu').classList.add('hidden')}function setupResizers(){document.querySelectorAll('[data-collapse]').forEach(b=>b.onclick=()=>$('layout').classList.add(`${b.dataset.collapse}-collapsed`));document.querySelectorAll('[data-expand]').forEach(b=>b.onclick=()=>$('layout').classList.remove(`${b.dataset.expand}-collapsed`));document.querySelectorAll('[data-resize]').forEach(bar=>bar.onpointerdown=e=>{e.preventDefault();const kind=bar.dataset.resize,start=e.clientX,initial=parseFloat(getComputedStyle(document.documentElement).getPropertyValue(`--${kind}`));bar.setPointerCapture(e.pointerId);bar.onpointermove=m=>document.documentElement.style.setProperty(`--${kind}`,`${Math.max(150,initial+m.clientX-start)}px`);bar.onpointerup=()=>bar.onpointermove=null});$('matrixSplitter').onpointerdown=e=>{const start=e.clientY,initial=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--editor'));$('matrixSplitter').setPointerCapture(e.pointerId);$('matrixSplitter').onpointermove=m=>document.documentElement.style.setProperty('--editor',`${Math.max(120,initial+m.clientY-start)}px`);$('matrixSplitter').onpointerup=()=> $('matrixSplitter').onpointermove=null}}
async function validateCurrent(){saveDraft();const metric=measures[selected]||{};const r=await call('daxValidate',{name:metric.Name,expression:metric.Expression,kind:+metric.Kind||0,metrics:measures,data});if(r.data){data=r.data;query.data=data;const ci=(data.columns||[]).findIndex(c=>columnName(c).toLowerCase()===String(metric.Name).toLowerCase());if(ci>=0){const type=String(data.types?.[ci]||'').split('.').pop();metric.DataType=/Date/i.test(type)?'Date':/String|Char/i.test(type)?'Text':/Boolean/i.test(type)?'Boolean':'Number'}$('dataStatus').textContent=`${data.rows.length} rows loaded`;renderFields();renderMeasures()}$('validation').className='validation ok';$('validation').textContent=`${r.message}${r.value==null?'':` Result: ${r.value}`}`;return r}
$('loadData').onclick=async()=>{try{$('status').textContent='Loading…';const r=await call('daxLoad',{query,metrics:measures});data=r.data;query.data=data;$('dataStatus').textContent=`${data.rows.length} rows loaded`;renderFields();$('status').textContent='Ready'}catch(e){toast(e.message);$('status').textContent='Error'}};$('newMeasure').onclick=newMeasure;$('save').onclick=async()=>{saveDraft();renderMeasures();try{if(+measures[selected]?.Kind===1&&data.columns?.length)await validateCurrent();toast(`${+measures[selected]?.Kind===1?'Calculated column':'Measure'} saved in workspace`)}catch(e){$('validation').className='validation error';$('validation').textContent=e.message}};$('delete').onclick=()=>{if(selected<0)return;measures.splice(selected,1);selected=-1;$('name').value='';$('expression').value='';renderMeasures()};$('validate').onclick=async()=>{try{await validateCurrent()}catch(e){$('validation').className='validation error';$('validation').textContent=e.message}};$('testMatrix').onclick=async()=>{saveDraft();try{const r=await call('daxMatrix',{metrics:measures,data,...zones});renderResult(pivotResult(r.data))}catch(e){toast(e.message)}};$('apply').onclick=()=>{saveDraft();chrome.webview.postMessage({type:'measureApply',measures})};$('close').onclick=()=>chrome.webview.postMessage({type:'closeWindow'});$('fieldSearch').oninput=renderFields;$('measureSearch').oninput=renderMeasures;$('name').oninput=()=>{saveDraft();renderMeasures()};document.onpointerdown=e=>{if(!e.target.closest('.menu'))hideMenus()};chrome.webview.addEventListener('message',e=>{const m=e.data;if(m.type==='loadMeasureWorkspace'){query=m.query||{};measures=metricList(query).map(normalizeMetric);query.measures=measures;data=query.data||query.Data||data;renderFields();renderMeasures();renderZones();if(measures.length)selectMeasure(0)}else if(m.type==='bridgeResult'){const p=pending.get(m.action);if(!p)return;pending.delete(m.action);m.result?.ok?p.resolve(m.result):p.reject(new Error(m.result?.error||'Operation failed'))}});addEventListener('DOMContentLoaded',()=>{setupResizers();chrome.webview.postMessage({type:'ready'})});
