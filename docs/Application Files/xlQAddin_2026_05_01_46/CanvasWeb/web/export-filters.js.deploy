(() => {
  function dateRange(box,from,to,apply,single=false){
    from.hidden=to.hidden=true;
    const row=document.createElement('div');row.className='date-range-display';box.append(row);
    const open=document.createElement('button');open.type='button';open.className='date-picker-selected';open.textContent=single?'Choose date':'Choose dates';box.append(open);
    function sync(){row.replaceChildren();row.hidden=!from.value&&!to.value;if(row.hidden)return;[from,to].slice(0,single?1:2).forEach((input,i)=>{if(i){const dash=document.createElement('span');dash.textContent='—';row.append(dash);}const button=document.createElement('button');button.type='button';button.className='date-picker-value';button.textContent=input.value||(i?'To':'From');button.setAttribute('aria-label',(i?'To ':'From ')+input.value);button.onclick=()=>open.click();row.append(button);});}
    sync();
    const iso=date=>`${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
    open.onclick=()=>{
      const dialog=document.createElement('dialog');dialog.className='range-calendar';
      dialog.innerHTML='<form method="dialog"><h3>Choose date range</h3><p data-summary>Select a start date, then an end date.</p><div class="range-calendar-navigation"><button type="button" data-prev aria-label="Previous month">‹</button><button type="button" data-next aria-label="Next month">›</button></div><div class="range-calendar-months"></div><div class="date-range-fields"><label>From<input type="date" data-from></label><label>To<input type="date" data-to></label></div><p data-error role="alert"></p><div class="range-calendar-actions"><button type="button" data-clear>Clear</button><button value="cancel">Cancel</button><button value="apply">Apply</button></div></form>';
      const a=dialog.querySelector('[data-from]'),b=dialog.querySelector('[data-to]');a.value=from.value;b.value=to.value;
      if(single){dialog.querySelector('h3').textContent='Choose date';a.parentElement.firstChild.textContent='Date';b.parentElement.hidden=true;}
      let month=new Date((a.value||iso(new Date()))+'T12:00:00');month.setDate(1);let choosingEnd=false;
      function draw(){
        const months=dialog.querySelector('.range-calendar-months');months.replaceChildren();
        dialog.querySelector('[data-summary]').textContent=single?(a.value||'Select a date.'):(a.value?(a.value+' — '+(b.value||'Select end date')):'Select a start date, then an end date.');
        for(let offset=0;offset<2;offset++){
          const date=new Date(month.getFullYear(),month.getMonth()+offset,1),panel=document.createElement('section');panel.className='range-calendar-month';
          const heading=document.createElement('h4');heading.textContent=date.toLocaleDateString(undefined,{month:'long',year:'numeric'});panel.append(heading);
          const grid=document.createElement('div');grid.className='range-calendar-grid';panel.append(grid);
          ['Mo','Tu','We','Th','Fr','Sa','Su'].forEach(text=>{const span=document.createElement('span');span.textContent=text;grid.append(span);});
          for(let i=0;i<(date.getDay()+6)%7;i++)grid.append(document.createElement('span'));
          const count=new Date(date.getFullYear(),date.getMonth()+1,0).getDate();
          for(let day=1;day<=count;day++){
            const value=iso(new Date(date.getFullYear(),date.getMonth(),day)),button=document.createElement('button');button.type='button';button.textContent=day;button.setAttribute('aria-label',value);button.setAttribute('aria-pressed',String(value===a.value||value===b.value));
            if(value===a.value||value===b.value)button.classList.add('endpoint');else if(a.value&&b.value&&value>a.value&&value<b.value)button.classList.add('in-range');
            if(value===iso(new Date())){button.classList.add('today');button.setAttribute('aria-current','date');}
            button.onclick=()=>{if(single){a.value=value;b.value='';}else if(!choosingEnd){a.value=value;b.value='';choosingEnd=true;}else{if(value<a.value){b.value=a.value;a.value=value;}else b.value=value;choosingEnd=false;}draw();};grid.append(button);
          }months.append(panel);
        }
      }
      dialog.querySelector('[data-prev]').onclick=()=>{month.setMonth(month.getMonth()-1);draw();};dialog.querySelector('[data-next]').onclick=()=>{month.setMonth(month.getMonth()+1);draw();};a.onchange=b.onchange=draw;
      dialog.querySelector('[data-clear]').onclick=()=>{a.value=b.value='';choosingEnd=false;draw();};
      dialog.querySelector('form').onsubmit=event=>{if(event.submitter.value==='apply'&&a.value&&b.value&&a.value>b.value){event.preventDefault();dialog.querySelector('[data-error]').textContent='From must be on or before To.';}};
      dialog.addEventListener('close',()=>{if(dialog.returnValue==='apply'){from.value=a.value;to.value=single?'':b.value;sync();apply();}dialog.remove();});document.body.append(dialog);draw();dialog.showModal();
    };
    return sync;
  }
  function numericRange(box,values,apply,between=false){
    const numbers=values.map(Number).filter(Number.isFinite),minimum=numbers.length?Math.min(...numbers):0,maximum=numbers.length?Math.max(...numbers):100,step=Number.isInteger(minimum)&&Number.isInteger(maximum)?1:Math.max((maximum-minimum)/100,.01),wrap=document.createElement('div');wrap.className='export-number-range';
    const make=(value,label,className)=>{const slider=document.createElement('input');slider.type='range';slider.className=className;slider.min=minimum;slider.max=maximum;slider.step=step;slider.value=value;slider.setAttribute('aria-label',label);return slider;},low=make(minimum,'Minimum value','range-low'),high=make(maximum,between?'Maximum value':'Value','range-high');
    const fields=document.createElement('div');fields.className='number-range-values';const lowValue=document.createElement('input'),highValue=document.createElement('input');[lowValue,highValue].forEach(input=>{input.type='number';input.min=minimum;input.max=maximum;input.step=step;});lowValue.value=minimum;highValue.value=maximum;
    const label=(text,input)=>{const node=document.createElement('label');node.textContent=text;node.append(input);return node;};
    const paint=()=>{const span=maximum-minimum||1;wrap.style.setProperty('--range-start',`${Math.max(0,Math.min(100,(+low.value-minimum)/span*100))}%`);wrap.style.setProperty('--range-end',`${Math.max(0,Math.min(100,(+high.value-minimum)/span*100))}%`);};let active=false;const sync=(changed)=>{if(between&&+low.value>+high.value){if(changed===low)high.value=low.value;else low.value=high.value;}lowValue.value=low.value;highValue.value=high.value;paint();active=true;apply();};
    if(between){const track=document.createElement('div');track.className='dual-number-range';track.append(low,high);wrap.append(track);fields.append(label('From',lowValue),label('To',highValue));const raise=slider=>{low.style.zIndex=slider===low?'4':'2';high.style.zIndex=slider===high?'4':'3';};low.onpointerdown=()=>raise(low);high.onpointerdown=()=>raise(high);low.oninput=()=>{lowValue.value=low.value;paint();};high.oninput=()=>{highValue.value=high.value;paint();};low.onchange=()=>sync(low);high.onchange=()=>sync(high);lowValue.onchange=()=>{low.value=lowValue.value;sync(low);raise(low);};highValue.onchange=()=>{high.value=highValue.value;sync(high);raise(high);};}
    else{wrap.append(high);fields.append(label('Up to',highValue));high.oninput=()=>{highValue.value=high.value;paint();};high.onchange=()=>sync(high);highValue.onchange=()=>{high.value=highValue.value;sync(high);};}
    wrap.append(fields);box.append(wrap);paint();
    return {filters:filter=>!active?[]:between?[filter('>=',low.value),filter('<=',high.value)]:[filter('<=',high.value)],reset(){active=false;low.value=lowValue.value=minimum;high.value=highValue.value=maximum;paint();}};
  }
  function relativeBounds(preset){const day=new Date(),start=new Date(day.getFullYear(),day.getMonth(),day.getDate()),end=new Date(start);if(preset==='yesterday')start.setDate(start.getDate()-1);if(preset==='yesterday')end.setDate(end.getDate()-1);if(preset==='thisWeek'){start.setDate(start.getDate()-((start.getDay()+6)%7));end.setDate(start.getDate()+6);}if(preset==='last7')start.setDate(start.getDate()-6);if(preset==='last30')start.setDate(start.getDate()-29);if(preset==='thisMonth'){start.setDate(1);end.setMonth(end.getMonth()+1,0);}if(preset==='thisYear'){start.setMonth(0,1);end.setMonth(11,31);}const iso=date=>`${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;return[iso(start),iso(end)+'T23:59:59.999'];}
  window.ExportFilters={attachDateRange:dateRange,install(doc,parent,changed){
    if(!document.querySelector('#range-calendar-style')){const style=document.createElement('style');style.id='range-calendar-style';style.textContent='.date-range-fields{display:flex;gap:12px;flex-wrap:wrap;margin:8px 0}.date-range-fields label{display:flex;flex:1;min-width:130px;flex-direction:column;gap:4px;font-size:12px}.date-range-fields input{box-sizing:border-box;width:100%;min-width:0;padding:8px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:6px;background:var(--qreports-surface,var(--viewer-unselected-bg,#fff));color:var(--qreports-text,var(--viewer-unselected-color,#34425e));color-scheme:var(--qreports-color-scheme,light)}.range-calendar{width:min(620px,calc(100vw - 48px));max-height:85vh;overflow:auto;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:12px;padding:20px;color:var(--viewer-unselected-color,var(--qreports-text,#34425e));background:var(--viewer-unselected-bg,var(--qreports-surface,#fff))}.range-calendar::backdrop{background:color-mix(in srgb,var(--qreports-header,#172033) 55%,transparent)}.range-calendar-navigation,.range-calendar-actions{display:flex;gap:8px;justify-content:flex-end}.range-calendar-months{display:grid;grid-template-columns:1fr 1fr;gap:20px}.range-calendar-month h4{text-align:center}.range-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center}.range-calendar-grid span{font-size:12px;padding:6px 0}.range-calendar button{border:1px solid var(--qreports-grid,#dbe1eb);border-radius:6px;background:var(--viewer-unselected-bg,var(--qreports-surface,#fff));color:var(--viewer-unselected-color,var(--qreports-text,#34425e));padding:8px;cursor:pointer}.range-calendar-grid button{border-color:transparent;padding:9px 0}.range-calendar button:hover{background:color-mix(in srgb,var(--viewer-selected-bg,#4f6ee8) 14%,var(--viewer-unselected-bg,var(--qreports-surface,#fff)));color:var(--viewer-unselected-color,var(--qreports-text,#34425e))}.range-calendar .in-range{background:color-mix(in srgb,var(--viewer-selected-bg,#4f6ee8) 24%,var(--viewer-unselected-bg,var(--qreports-surface,#fff)));color:var(--viewer-unselected-color,var(--qreports-text,#34425e))}.range-calendar .endpoint,.range-calendar button[value=apply]{background:var(--viewer-selected-bg,#4f6ee8);color:var(--viewer-selected-color,white)}.export-number-range{display:grid;gap:8px;margin-top:6px}.export-number-range>input[type=range]{width:100%;height:28px;margin:0;padding:0!important;border:0!important;appearance:none;background:linear-gradient(to right,var(--viewer-selected-bg,#4f6ee8) 0 var(--range-end,100%),var(--qreports-grid,#cbd5e1) var(--range-end,100%) 100%) center/100% 6px no-repeat!important;color:var(--qreports-text,var(--viewer-unselected-color,#34425e))}.export-number-range>input[type=range]::-webkit-slider-runnable-track{height:6px;background:transparent}.export-number-range>input[type=range]::-webkit-slider-thumb{appearance:none;width:20px;height:20px;margin-top:-7px;border:0;border-radius:50%;background:var(--viewer-selected-bg,#4f6ee8)}.export-number-range>input[type=range]::-moz-range-track{height:6px;background:transparent}.export-number-range>input[type=range]::-moz-range-thumb{width:20px;height:20px;border:0;border-radius:50%;background:var(--viewer-selected-bg,#4f6ee8)}.dual-number-range{position:relative;height:28px;background:linear-gradient(to right,#cbd5e1 0 var(--range-start,0%),var(--viewer-selected-bg,#4f6ee8) var(--range-start,0%) var(--range-end,100%),#cbd5e1 var(--range-end,100%) 100%) center/100% 6px no-repeat;border-radius:999px}.dual-number-range input{position:absolute;inset:0;width:100%;margin:0;padding:0!important;border:0!important;background:transparent!important;color:var(--qreports-text,var(--viewer-unselected-color,#34425e));pointer-events:none;appearance:none}.dual-number-range input::-webkit-slider-runnable-track{height:6px;background:transparent}.dual-number-range input::-webkit-slider-thumb{appearance:none;width:20px;height:20px;margin-top:-7px;border:0;border-radius:50%;background:var(--viewer-selected-bg,#4f6ee8);pointer-events:auto}.dual-number-range input::-moz-range-track,.dual-number-range input::-moz-range-progress{height:6px;background:transparent}.dual-number-range input::-moz-range-thumb{width:20px;height:20px;border:0;border-radius:50%;background:var(--viewer-selected-bg,#4f6ee8);pointer-events:auto}.number-range-values{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.number-range-values:has(>label:only-child){grid-template-columns:1fr}.number-range-values label{display:grid;gap:3px;font-size:12px}.number-range-values input{box-sizing:border-box;width:100%;padding:7px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:6px;background:var(--qreports-surface,var(--viewer-unselected-bg,#fff));color:var(--qreports-text,var(--viewer-unselected-color,#34425e))}.search-multiple{display:grid;gap:6px;margin-top:6px}.search-multiple-list{display:grid;gap:3px;max-height:180px;overflow:auto;padding:6px;border:1px solid #cbd5e1;border-radius:7px}.search-multiple-list label{display:flex!important;align-items:center;gap:6px;margin:0;min-width:0!important}@media(max-width:580px){.range-calendar-months{grid-template-columns:1fr}.range-calendar-month:nth-child(2){display:none}}';document.head.append(style);}
    if(!document.querySelector('#export-filter-polish')){const polish=document.createElement('style');polish.id='export-filter-polish';polish.textContent='.range-calendar-grid button.today{box-shadow:inset 0 0 0 2px #d92d20!important}.export-filter{box-sizing:border-box;margin:0 0 14px;padding:10px;border:1px solid color-mix(in srgb,var(--viewer-unselected-color,#34425e) 18%,transparent);border-radius:9px;background:color-mix(in srgb,var(--viewer-unselected-bg,#fff) 94%,var(--viewer-selected-bg,#4f6ee8))}.export-filter:last-child{margin-bottom:4px}';document.head.append(polish);}
    const originals=doc.sources.map(s=>structuredClone(s.query.filters||[])),states=[];
    function apply(){doc.sources.forEach((source,i)=>{source.query.filters=structuredClone(originals[i]);states.filter(s=>s.source===source).forEach(s=>source.query.filters.push(...s.filters()));});changed();}
    doc.sources.forEach(source=>{
      const group=document.createElement("fieldset"),legend=document.createElement("legend");legend.textContent=source.name;group.append(legend);
      source.query.data.columns.forEach((column,index)=>{
        const config=(doc.viewerOptions?.filterColumns||[]).find(c=>c.sourceId===source.id&&c.column===column);
        if(doc.viewerOptions?.filterMode==="pick"&&!config)return;
        const type=config?.filterType||"basic",box=document.createElement("div");box.className="export-filter";box.textContent=column;group.append(box);
        const values=[...new Set(source.query.data.rows.map(r=>r[index]).filter(v=>v!=null).map(String))].sort();
        const state={source,filters:()=>[],reset:()=>{}};states.push(state);
        const filter=(operator,value)=>({column,operator,value,enabled:true});
        const input=()=>{const control=document.createElement("input");box.append(control);control.onchange=apply;return control;};
        if(type==="advanced"||type==="date"||type==="dateSingle"){
          let operator;
          if(type==="advanced"){operator=document.createElement("select");[["between","From / to"],["equals","Equals"],["notequals","Does not equal"],["contains","Contains"],["notcontains","Does not contain"],[">=","At least"],["<=","At most"]].forEach(([value,text])=>operator.add(new Option(text,value)));box.append(operator);}
          const from=input(),to=input();from.placeholder="From";to.placeholder="To";if(type!=="advanced")from.type=to.type="date";
          const sync=type!=="advanced"?dateRange(box,from,to,apply,type==="dateSingle"):()=>{};
          if(type==='advanced'){box.classList.add('advanced-filter');const fields=document.createElement('div');fields.className='advanced-filter-fields';[from,to].forEach((control,i)=>{const label=document.createElement('label');label.textContent=i?'To':'From / value';control.setAttribute('aria-label',i?'To':'From or value');label.append(control);fields.append(label);});box.append(fields);}
          if(operator)operator.onchange=()=>{to.hidden=operator.value!=="between";to.closest('label').hidden=to.hidden;apply();};
          state.filters=()=>{if(type==="dateSingle")return from.value?[filter(">=",from.value),filter("<=",from.value+"T23:59:59.999")]:[];if(type==="date")return [...(from.value?[filter(">=",from.value)]:[]),...(to.value?[filter("<=",to.value+"T23:59:59.999")]:[])];if(operator.value==="between")return [...(from.value?[filter(">=",from.value)]:[]),...(to.value?[filter("<=",to.value)]:[])];return from.value?[filter(operator.value,from.value)]:[];};state.reset=()=>{from.value=to.value="";sync();};
        }else if(type==="relativeDate"){
          const select=document.createElement('select');select.add(new Option('All dates',''));[['today','Today'],['yesterday','Yesterday'],['thisWeek','This week'],['last7','Last 7 days'],['last30','Last 30 days'],['thisMonth','This month'],['thisYear','This year']].forEach(([value,label])=>select.add(new Option(label,value)));select.onchange=apply;box.append(select);state.filters=()=>{if(!select.value)return[];const[from,to]=relativeBounds(select.value);return[filter('>=',from),filter('<=',to)];};state.reset=()=>select.value='';
        }else if(type==="searchMultiple"){
          const selected=new Set(),wrap=document.createElement('div'),search=document.createElement('input'),list=document.createElement('div'),count=document.createElement('small');wrap.className='search-multiple';search.type='search';search.placeholder='Search values…';list.className='search-multiple-list';const checks=values.map(value=>{const label=document.createElement('label'),check=document.createElement('input');check.type='checkbox';label.append(check,document.createTextNode(value));label.dataset.searchValue=value.toLowerCase();check.onchange=()=>{check.checked?selected.add(value):selected.delete(value);count.textContent=selected.size+' selected';apply();};list.append(label);return check;});search.oninput=()=>{const term=search.value.trim().toLowerCase();[...list.children].forEach(label=>label.hidden=!label.dataset.searchValue.includes(term));};count.textContent='0 selected';wrap.append(search,list,count);box.append(wrap);state.filters=()=>selected.size?[{column,mode:'Basic',basicValues:[...selected],enabled:true}]:[];state.reset=()=>{selected.clear();checks.forEach(check=>check.checked=false);search.value='';[...list.children].forEach(label=>label.hidden=false);count.textContent='0 selected';};
        }else if(type==="range"||type==="rangeBetween"){
          const range=numericRange(box,values,apply,type==="rangeBetween");state.filters=()=>range.filters(filter);state.reset=()=>range.reset();
        }else if(type==='toggle'){
          const boolean=values.some(v=>/^(true|false)$/i.test(v)),on=boolean?(values.find(v=>/^true$/i.test(v))||'true'):'1',off=boolean?(values.find(v=>/^false$/i.test(v))||'false'):'0';let selected=null;
          const row=document.createElement('div');row.className='toggle-filter-row';const status=document.createElement('span'),toggle=document.createElement('button'),clear=document.createElement('button');toggle.type=clear.type='button';toggle.className='export-toggle';toggle.setAttribute('role','switch');toggle.setAttribute('aria-label',column);toggle.innerHTML='<span></span>';clear.textContent='All values';
          const draw=()=>{toggle.setAttribute('aria-checked',String(selected===on));toggle.classList.toggle('active',selected===on);status.textContent=selected===null?'All values':selected===on?'On ('+on+')':'Off ('+off+')';};
          toggle.onclick=()=>{selected=selected===on?off:on;draw();apply();};clear.onclick=()=>{selected=null;draw();apply();};row.append(status,toggle,clear);box.append(row);draw();state.filters=()=>selected===null?[]:[filter('equals',selected)];state.reset=()=>{selected=null;draw();};
        }else if(type==="buttons"){
          const selected=new Set(),buttons=[];
          const strip=document.createElement("div");strip.className="filter-buttons";box.append(strip);
          values.forEach(value=>{const button=document.createElement("button");button.type="button";button.textContent=value;button.onclick=()=>{selected.has(value)?selected.delete(value):selected.add(value);button.classList.toggle("active",selected.has(value));button.setAttribute("aria-pressed",String(selected.has(value)));apply();};button.setAttribute("aria-pressed","false");buttons.push(button);strip.append(button);});
          state.filters=()=>selected.size?[{column,mode:"Basic",basicValues:[...selected],enabled:true}]:[];state.reset=()=>{selected.clear();buttons.forEach(b=>{b.classList.remove("active");b.setAttribute("aria-pressed","false");});};
        }else{
          if(values.length>2000&&type==="basic"){const control=input();control.placeholder="Enter a value";state.filters=()=>control.value?[filter("equals",control.value)]:[];state.reset=()=>control.value="";}
          else {const select=document.createElement("select");box.append(select);select.onchange=apply;
            if(type==="multiple"){select.multiple=true;select.size=Math.min(6,Math.max(2,values.length));}
            else select.add(new Option("All (within saved filters)",""));
            const choices=type==="toggle"?(values.some(v=>/^(true|false)$/i.test(v))?["true","false"]:["1","0"]):values;
            choices.forEach(value=>select.add(new Option(value,value)));
            state.filters=()=>type==="multiple"?[...select.selectedOptions].length?[{column,mode:"Basic",basicValues:[...select.selectedOptions].map(o=>o.value),enabled:true}]:[]:select.value?[filter("equals",select.value)]:[];
            state.reset=()=>{[...select.options].forEach(o=>o.selected=false);if(!select.multiple)select.value="";};
            if(type==="multiple"){
              const actions=document.createElement("div");actions.className="filter-buttons";box.append(actions);
              const all=document.createElement("button"),clear=document.createElement("button");all.type=clear.type="button";all.textContent="All values";clear.textContent="Clear selection";
              all.onclick=()=>{[...select.options].forEach(o=>o.selected=true);apply();};
              clear.onclick=()=>{state.reset();apply();};actions.append(all,clear);
            }
          }
        }
      });if(group.querySelector(".export-filter"))parent.append(group);
    });
    const reset=document.createElement("button");reset.textContent="Reset filters";reset.onclick=()=>{states.forEach(s=>s.reset());apply();};parent.append(reset);
  }};
})();
