:root{font:15px "Segoe UI",sans-serif;color:#17213d;background:#f5f7fb;--fields:260px;--measures:270px;--editor:220px}*{box-sizing:border-box}body{margin:0;height:100vh;display:grid;grid-template-rows:88px 1fr;overflow:hidden}button,input,textarea,select{font:inherit}button{border:1px solid #657397;background:#354365;color:white;border-radius:10px;padding:10px 15px;cursor:pointer}.primary{background:#657fee}.run{background:#388b58}header{background:#273356;color:#fff;display:flex;align-items:center;padding:16px 24px;gap:24px}.brand{display:flex;gap:13px;align-items:center}.brand>span{width:48px;height:48px;border-radius:13px;background:#6683ed;display:grid;place-items:center;font-size:28px;font-weight:800}.brand strong{font-size:22px;display:block}.brand small{color:#d6def3}nav{margin-left:auto;display:flex;gap:8px}main{display:grid;grid-template-columns:var(--fields) 6px var(--measures) 6px minmax(430px,1fr);min-height:0}aside,.measures{padding:16px;border-right:1px solid #d6deec;overflow:auto;background:#f8faff;position:relative}.pane-head{display:flex;align-items:center;justify-content:space-between}.pane-head h2{margin:0}.collapse{padding:2px 8px;background:white;color:#273356;border-color:#c9d3e3}.pane-tab{display:none;position:absolute;inset:0;padding:0;writing-mode:vertical-rl;border:0;border-radius:0;background:#eef2fa;color:#354365;font-weight:700}.fields-collapsed{--fields:34px}.measures-collapsed{--measures:34px}.fields-collapsed #fieldsPane,.measures-collapsed #measuresPane{padding:0;overflow:hidden}.fields-collapsed #fieldsPane .pane-head,.fields-collapsed #fieldsPane .pane-body,.measures-collapsed #measuresPane .pane-head,.measures-collapsed #measuresPane .pane-body{display:none}.fields-collapsed #fieldsPane .pane-tab,.measures-collapsed #measuresPane .pane-tab{display:block}.side-splitter{cursor:col-resize;background:#dce3ef;border-left:1px solid #c6d0df;border-right:1px solid #c6d0df}.fields-collapsed [data-resize=fields],.measures-collapsed [data-resize=measures]{pointer-events:none;background:#eef2fa}h3{margin:0 0 8px}h3 small{font-size:11px;font-weight:400;color:#6c7890}aside p{color:#69758e}input,textarea{width:100%;border:1px solid #c9d3e3;border-radius:8px;padding:9px;background:white}.field,.measure{padding:9px 10px;margin:6px 0;background:white;border:1px solid #d6deea;border-radius:8px;cursor:pointer}.field{font-size:13px}.measure{display:grid}.measure small{color:#748099}.measure.active{border-color:#657fee;background:#edf1ff}.measure.calculated b:after{content:"Calculated column";font-size:10px;font-weight:400;margin-left:7px;color:#596fae}.workspace{display:grid;grid-template-rows:auto minmax(120px,var(--editor)) auto auto 8px auto minmax(150px,1fr);min-height:0;padding:16px 18px 18px}.editor-head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:15px}.editor-head label,.formula-label{display:grid;gap:5px;color:#5e6a83}.formula-label{min-height:0}.formula-label textarea{font:15px Consolas,monospace;resize:vertical;height:100%;min-height:110px;line-height:1.5}.validation{padding:8px 12px;color:#5f6c84}.validation.ok{color:#247044}.validation.error{color:#b0443b}.matrix-builder{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;align-items:end;border-top:1px solid #d6deea;padding:12px 0}.dropzone{min-height:45px;border:1px dashed #9aa9c4;border-radius:8px;padding:5px;display:flex;gap:5px;flex-wrap:wrap;background:white}.chip{font-size:12px;padding:5px 7px;border-radius:6px;background:#e9eefb;cursor:grab}.chip.dragging{opacity:.45}.matrix-splitter{cursor:row-resize;background:#dce3ef;display:grid;place-items:center}.matrix-splitter span{width:55px;height:3px;border-radius:3px;background:#8995aa}.result-head{background:#596176;color:#fff;padding:6px 10px;display:flex;justify-content:space-between}.result{overflow:auto;background:white}.result table{border-collapse:collapse;min-width:100%;white-space:nowrap}.result th,.result td{padding:8px 12px;border-bottom:1px solid #dce2ec;text-align:left}.result th{background:#eef2f8;position:sticky;top:0;cursor:pointer}.menu{position:fixed;z-index:50;width:280px;max-height:min(620px,calc(100vh - 20px));overflow:auto;background:white;border:1px solid #cbd4e2;border-radius:10px;padding:10px;box-shadow:0 15px 45px #17213d44}.menu button,.menu label{display:block;width:100%;color:#273356;background:white;border:0;text-align:left;padding:7px}.menu .section{font-size:11px;text-transform:uppercase;color:#69758e;font-weight:700;padding:9px 7px 3px}.menu hr{border:0;border-top:1px solid #dce2ec}.hidden{display:none!important}.toast{position:fixed;right:25px;bottom:22px;background:#17213d;color:#fff;padding:12px 16px;border-radius:9px;z-index:100}
