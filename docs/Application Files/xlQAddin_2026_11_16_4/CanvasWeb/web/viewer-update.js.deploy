(() => {
  if(!document.querySelector('link[href*="viewer-update.css"]')){const link=document.createElement("link"),script=document.currentScript?.src||"";link.rel="stylesheet";link.href=`${script.includes("/app/")?"app/":""}viewer-update.css?v=20261115-theme-1`;document.head.append(link);}
  let dialog=null,send=null,requiredVersion="";
  const ensure=()=>{if(dialog?.isConnected)return dialog;dialog=document.createElement("dialog");dialog.className="viewer-update-dialog";dialog.innerHTML='<div class="viewer-update-shell"><header><div><p>Qvitr Viewer update</p><h2 data-update-title>Checking for updates</h2><span data-update-subtitle>Comparing the installed Viewer with the latest signed release.</span></div><button type="button" data-update-close aria-label="Close update window">×</button></header><section><div class="viewer-update-versions"><article><span>Installed</span><strong data-update-installed>—</strong></article><article><span>Required by report</span><strong data-update-required>—</strong></article><article><span>Latest available</span><strong data-update-available>Checking…</strong></article></div><div class="viewer-update-progress" data-update-progress hidden><div><span data-update-progress-label>Preparing…</span><b data-update-progress-value></b></div><progress max="100"></progress></div><div class="viewer-update-notes"><h3>What’s new</h3><p data-update-notes>Release information will appear after the check completes.</p></div><p class="viewer-update-error" data-update-error hidden></p></section><footer><button type="button" data-update-notes-button hidden>Full release notes</button><span></span><button type="button" data-update-retry hidden>Try again</button><button type="button" class="primary" data-update-install hidden>Download and install</button><button type="button" class="primary" data-update-restart hidden>Restart Qvitr</button></footer></div>';document.body.append(dialog);dialog.querySelector('[data-update-close]').onclick=()=>dialog.close();dialog.querySelector('[data-update-retry]').onclick=()=>check();dialog.querySelector('[data-update-install]').onclick=()=>{send?.("downloadUpdate");render({state:"downloading",percent:0});};dialog.querySelector('[data-update-notes-button]').onclick=()=>send?.("openUpdateReleaseNotes");dialog.querySelector('[data-update-restart]').onclick=()=>send?.("restartApplication");return dialog;};
  function render(message={}){const root=ensure(),state=message.state||"checking",title=root.querySelector('[data-update-title]'),subtitle=root.querySelector('[data-update-subtitle]'),installed=root.querySelector('[data-update-installed]'),required=root.querySelector('[data-update-required]'),available=root.querySelector('[data-update-available]'),notes=root.querySelector('[data-update-notes]'),error=root.querySelector('[data-update-error]'),progress=root.querySelector('[data-update-progress]'),bar=progress.querySelector('progress'),label=root.querySelector('[data-update-progress-label]'),value=root.querySelector('[data-update-progress-value]'),install=root.querySelector('[data-update-install]'),retry=root.querySelector('[data-update-retry]'),restart=root.querySelector('[data-update-restart]'),notesButton=root.querySelector('[data-update-notes-button]');if(message.installedVersion)installed.textContent=message.installedVersion;required.textContent=requiredVersion||"No minimum";if(message.availableVersion)available.textContent=message.availableVersion;error.hidden=true;progress.hidden=!["downloading","verifying","launching"].includes(state);install.hidden=state!=="available";retry.hidden=state!=="error";restart.hidden=state!=="installer-launched";notesButton.hidden=!["available","current","installer-launched"].includes(state);if(state==="checking"){title.textContent="Checking for updates";subtitle.textContent="Reading the signed Qvitr release manifest.";available.textContent="Checking…";}else if(state==="current"){title.textContent="Qvitr Viewer is up to date";subtitle.textContent="This installation matches the latest available release.";notes.textContent=message.releaseNotes||"No additional release notes were supplied.";}else if(state==="available"){title.textContent="A Qvitr update is available";subtitle.textContent=`Installer ${message.installerVersion||message.availableVersion||""} is ready to download.`;notes.textContent=message.releaseNotes||"This release contains Viewer compatibility and reliability improvements.";}else if(state==="downloading"){title.textContent="Downloading the verified installer";subtitle.textContent="You can keep this window open while the package downloads.";const percent=Number(message.percent);if(Number.isFinite(percent))bar.value=percent;else bar.removeAttribute("value");label.textContent="Downloading update…";value.textContent=Number.isFinite(percent)?`${Math.round(percent)}%`:"";}else if(state==="verifying"){title.textContent="Verifying the update";subtitle.textContent="Qvitr is checking SHA-256 integrity and the Windows publisher signature.";bar.removeAttribute("value");label.textContent=message.message||"Verifying installer…";value.textContent="";}else if(state==="launching"){title.textContent="Starting Qvitr Setup";subtitle.textContent="Windows may ask for permission to run the verified installer.";bar.removeAttribute("value");label.textContent=message.message||"Opening installer…";value.textContent="";}else if(state==="installer-launched"){title.textContent="Finish setup, then restart Qvitr";subtitle.textContent="Close Office applications, complete Qvitr Setup, and restart when installation finishes.";available.textContent=message.availableVersion||available.textContent;notes.textContent="The verified installer is running. Restart only after Setup reports that installation is complete.";}else if(state==="error"){title.textContent="The update could not continue";subtitle.textContent="Your current Qvitr installation was not changed.";error.hidden=false;error.textContent=message.message||"An unexpected update error occurred.";}root.dataset.state=state;}
  function check(){render({state:"checking"});send?.("checkForUpdates");}
  function open(options={}){send=options.post||send||(type=>window.chrome?.webview?.postMessage?.({type}));requiredVersion=options.requiredVersion||requiredVersion;const root=ensure();if(!root.open)root.showModal();check();}
  function handle(message){if(message?.type!=="updateStatus")return false;render(message);if(!dialog.open)dialog.showModal();return true;}
  function requireVersion(value){requiredVersion=String(value||"");}
  window.chrome?.webview?.addEventListener?.("message",event=>handle(event.data));
  document.addEventListener("click",event=>{if(!event.target.closest?.('[data-action="checkForUpdates"]'))return;event.preventDefault();event.stopImmediatePropagation();open();},true);
  window.QvitrUpdateUi={open,handle,requireVersion};
})();
