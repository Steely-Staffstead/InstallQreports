.field-menu button { font-size: 12px; padding: 5px 7px; }
.measure-menu label { font-size: 12px; }
.measure-menu select,
.measure-menu input { margin-top: 4px; }
.format-preview { padding: 7px; color: #526079; background: #f3f6fb; border-radius: 6px; font-size: 12px; }
.danger { color: #b23b35 !important; }
.field { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px; align-items: center; }
.field small { color: #7a859d; font-size: 10px; }
.metric-task-guide{display:grid;gap:5px;margin:0 0 8px;padding:10px;border-bottom:1px solid var(--qreports-grid,#d6deea);color:var(--qreports-text,#273356);font-size:11px;line-height:1.35}.metric-task-guide>b{color:var(--qreports-accent,#657fee);font-size:10px;letter-spacing:.06em;text-transform:uppercase}.metric-task-guide span{white-space:nowrap}.metric-task-guide strong{font-weight:650}
