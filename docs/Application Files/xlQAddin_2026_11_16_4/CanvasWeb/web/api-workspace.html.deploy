<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>API Workspace</title><link rel="stylesheet" href="api-workspace.css?v=20261111-projection-workbench-1"><link rel="stylesheet" href="api-workspace-overrides.css?v=20261007-graphql-split-3"><link rel="stylesheet" href="api-workspace-enhancements.css?v=20260922-1"><link rel="stylesheet" href="api-workspace-query-integration.css?v=20260907-1"><link rel="stylesheet" href="api-parameter-mapping.css?v=20261115-validation-1"><link rel="stylesheet" href="workspace-theme-header.css?v=20261108-source-context-1"><link rel="stylesheet" href="parameter-editor.css?v=20261005-resizable-manager"><link rel="stylesheet" href="parameter-editor-theme.css?v=20260921-2"><script src="shared-settings.js?v=20261013-page-navigation-tabs-2"></script><script src="workspace-completion.js?v=20261114-1"></script></head><body data-hide-shared-settings>
<header><div class="brand"><span>Q</span><div><strong>API Workspace</strong><small id="apiWorkspaceBreadcrumb" class="workspace-breadcrumb" aria-label="Current editing context"><span>API library</span><i aria-hidden="true">›</i><b>New request</b><em>Standalone</em></small></div></div><nav><span id="apiApplyStatus" class="workspace-apply-status" aria-live="polite">No unapplied changes</span><button id="newRequest">＋ New</button><button id="saveEndpoint" title="Save this reusable definition to the API library. Save never applies or refreshes data.">Save</button><button id="secrets">Secrets</button><button id="run" class="run">▶ Send</button><button id="returnExcel" class="primary">Apply</button><button id="close" title="Discard unapplied changes and close the workspace.">Cancel</button></nav></header>
<main id="workspaceMain"><aside id="library"><div class="pane-title"><div><h2>Saved APIs</h2><p>Connections and endpoints</p></div><div class="pane-title-actions"><button id="collapseLeft" title="Hide saved APIs">‹</button><button id="reload">↻</button></div></div><input id="search" placeholder="Search APIs"><div id="libraryList"></div></aside><div id="leftResize" class="pane-resizer" title="Resize sources pane"></div><section class="workspace">
<div class="request-line"><select id="method"><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option></select><select id="connection"></select><input id="path" placeholder="/v1/resources"><span id="status">Ready</span></div>
<div class="tabs" id="requestTabs"><button class="active" data-panel="params">Parameters</button><button data-panel="body">Body</button><button class="connection-scope-tab" data-panel="auth" title="Authentication is shared by every API using this connection">Connection auth <small>Shared</small></button><button data-panel="paging">Pagination & loop</button><button data-panel="shape">Response shape</button></div>
<div class="request-panels"><section id="params" class="panel active"><div class="split"><div><h3>Query parameters</h3><div id="queryRows" class="kv"></div><button data-add="queryRows">＋ Add query parameter</button></div><div><h3>Headers</h3><div id="headerRows" class="kv"></div><button data-add="headerRows">＋ Add header</button></div></div></section>
<section id="body" class="panel"><div class="form-row"><label>Body type<select id="bodyMode"><option value="0">None</option><option value="1">Raw</option><option value="2">GraphQL</option><option value="3">Form URL encoded</option></select></label><label>Raw format<select id="rawFormat"><option value="0">JSON</option><option value="1">Text</option><option value="2">XML</option><option value="3">JavaScript</option></select></label><label>Content type<input id="contentType" value="application/json"></label></div><div id="rawBody"><textarea id="bodyText" class="code" spellcheck="false" placeholder="Request body"></textarea></div><div id="graphBody" class="hidden split"><label>GraphQL query<textarea id="graphql" class="code"></textarea></label><label>Variables JSON<textarea id="variables" class="code"></textarea></label></div><div id="formBody" class="hidden"><div id="formRows" class="kv"></div><button data-add="formRows">＋ Add field</button></div></section>
<section id="auth" class="panel"><div class="form-grid"><label>Authentication<select id="authKind"><option value="0">None</option><option value="1">API key</option><option value="2">Azure Function key</option><option value="3">Bearer token</option><option value="4">Bearer token workflow</option><option value="5">Basic authentication</option><option value="6">Email code session</option><option value="7">Microsoft Entra SSO</option></select></label><label>Secret reference<input id="secretRef" placeholder="Generated automatically"></label><label>Key / header name<input id="keyName"></label><label>Key location<select id="keyLocation"><option value="0">Header</option><option value="1">Query parameter</option></select></label></div><div id="simpleCredentials" class="credential-card"><h3>Secure credentials</h3><p>Values are saved through QReports SecretManager. Leave blank to keep an existing value.</p><div class="form-grid"><label id="singleSecretLabel">Secret value<input id="singleSecretValue" type="password" autocomplete="new-password"></label><label>Basic username<input id="basicSecretUsername" autocomplete="off"></label><label>Basic password<input id="basicSecretPassword" type="password" autocomplete="new-password"></label></div></div><details id="workflow"><summary>Token workflow</summary><div class="form-grid"><label>Request mode<select id="wfRequestMode"><option value="0">OAuth form fields</option><option value="1">API request JSON</option></select></label><label>Token URL<input id="tokenUrl"></label><label>Grant type<select id="grantType"><option value="0">Client credentials</option><option value="1">Password</option></select></label><label>Scope<input id="scope"></label><label>Audience<input id="audience"></label><label>Token JSON path<input id="tokenPath" value="access_token"></label><label>Expiry JSON path<input id="expiresPath" value="expires_in"></label><label>Workflow secret reference<input id="workflowSecretRef" placeholder="Generated automatically"></label><label>Apply token as<select id="applyMode"><option value="0">Bearer header</option><option value="1">Basic auth password</option><option value="2">Custom header</option><option value="3">Query parameter</option><option value="4">Raw authorization header</option></select></label><label>Output header<input id="outputHeader" value="Authorization"></label><label>Output prefix<input id="outputPrefix" value="Bearer "></label><label>Output query name<input id="outputQuery"></label><label>Basic username<input id="basicUsername"></label><label class="wide">Token request JSON<textarea id="requestSpec" class="code"></textarea></label></div><div class="credential-card"><h3>Workflow credentials</h3><p>Stored as one protected SecretManager value. Leave blank to preserve existing credentials.</p><div class="form-grid"><label>Client ID<input id="clientId"></label><label>Client secret<input id="clientSecret" type="password"></label><label>Username<input id="workflowUsername"></label><label>Password<input id="workflowPassword" type="password"></label></div></div><div class="split"><div><h3>Extra form fields</h3><div id="workflowParamRows" class="kv"></div><button data-add="workflowParamRows">＋ Add form field</button></div><div><h3>Extra token headers</h3><div id="workflowHeaderRows" class="kv"></div><button data-add="workflowHeaderRows">＋ Add header</button></div></div><button id="testToken">Test token workflow</button></details><div id="microsoftEntraWorkflow" class="credential-card"><h3>Microsoft Entra SSO</h3><p>Qvitr uses MSAL to obtain an API access token. It first reuses the encrypted token cache silently and opens the system browser only when interaction is required.</p><div class="form-grid"><label>Authentication profile ID<input id="entraProfileId" placeholder="forecast-portal-sso"></label><label>Allowed origins<input id="entraAllowedOrigins" placeholder="https://portal.example.com"></label><label>Tenant ID<input id="entraTenantId" placeholder="Tenant GUID or domain"></label><label>Public client/application ID<input id="entraClientId" placeholder="Application (client) ID"></label><label class="wide">API scopes<input id="entraScopes" placeholder="api://application-id/access_as_user"></label><label>Authority (optional)<input id="entraAuthority" placeholder="https://login.microsoftonline.com/tenant-id"></label><label>Redirect URI<input id="entraRedirectUri" value="http://localhost"></label><label>Header name<input id="entraHeaderName" value="Authorization"></label><label>Header prefix<input id="entraHeaderPrefix" value="Bearer "></label></div><div class="connection-actions"><button id="entraSignIn" type="button" class="primary">Sign in with work account</button><button id="entraSignOut" type="button">Sign out</button></div><p id="entraSessionStatus" class="muted">Not signed in.</p></div><div id="emailCodeWorkflow" class="credential-card"><h3>Email code session</h3><p>The connection settings can be shared. The access token is encrypted for the current Windows user and reused until shortly before expiry.</p><div class="form-grid"><label>Authentication profile ID<input id="emailProfileId" placeholder="forecast-portal"></label><label>Allowed origins<input id="emailAllowedOrigins" placeholder="https://portal.example.com"></label><label>Request-code path<input id="emailRequestPath" value="request-login-code"></label><label>Verify-code path<input id="emailVerifyPath" value="verify-login-code"></label><label>Token JSON path<input id="emailTokenPath" value="token"></label><label>Expires-at JSON path<input id="emailExpiresAtPath" value="expiresAt"></label><label>Header name<input id="emailHeaderName" value="Authorization"></label><label>Header prefix<input id="emailHeaderPrefix" value="Bearer "></label></div><div class="form-grid"><label>Email<input id="emailLoginAddress" type="email" autocomplete="username"></label><label>Login code<input id="emailLoginCode" inputmode="numeric" autocomplete="one-time-code"></label></div><div class="connection-actions"><button id="emailRequestCode" type="button">Send code</button><button id="emailVerifyCode" type="button" class="primary">Verify and sign in</button><button id="emailSignOut" type="button">Sign out</button></div><p id="emailSessionStatus" class="muted">Not signed in.</p></div></section>
<section id="paging" class="panel"><div class="form-grid"><label class="check"><input id="pagingEnabled" type="checkbox"> Enable pagination</label><label>Type<select id="pagingType"><option value="0">None</option><option value="1">Next link / OData</option><option value="2">Offset</option></select></label><label>Data property<input id="dataProperty"></label><label>Next-link property<input id="nextLink" value="@odata.nextLink"></label><label>Offset parameter<input id="offsetParam" value="skip"></label><label>Limit parameter<input id="limitParam" value="first"></label><label>Start offset<input id="startOffset" type="number" value="0"></label><label>Page size<input id="pageSize" type="number" value="100"></label><label>Maximum pages<input id="maxPages" type="number" value="100"></label><label class="check"><input id="loopEnabled" type="checkbox"> Enable request loop</label><label>Loop connection<input id="loopConnection"></label><label class="wide">Loop query<div class="loop-query-control"><textarea id="loopQuery" class="code"></textarea><button id="designLoopQuery" type="button">Design…</button></div></label><label>Value column<input id="loopColumn"></label><label>Replacement token<input id="loopToken" value="value"></label><label>Maximum requests<input id="maxRequests" type="number" value="0"></label><label>Delay (ms)<input id="delayMs" type="number" value="0"></label></div></section>
<section id="shape" class="panel"><div class="form-grid">
<label title="Choose the JSON array that represents rows. CSV is already tabular and does not need a flatten path.">Array / flatten path (JSON only)<div class="input-button"><input id="flattenPath" value="value"><button id="pickPath">Choose…</button></div></label>
<label>Maximum rows<input id="maxRows" type="number" value="1000"></label>
<label class="check wide" title="Keeps a read-only copy of the JSON response beside the normal flattened table. Only App and HTML tiles receive this companion payload."><input id="preserveStructuredJson" type="checkbox"> Preserve structured JSON for App and HTML tiles</label>
<label class="wide" title="Optional JSONPath selecting the part of the response exposed to App and HTML tiles. Leave blank to preserve the complete response.">Structured JSON root path<input id="structuredJsonPath" placeholder="Optional, for example $.financialOverview"></label>
<label class="wide" title="Applied to the tabular result for both JSON and CSV. Example: Amount > 0">Post-filter expression<textarea id="postFilter" placeholder="Example: Amount > 0"></textarea></label>
<label class="wide" title="One column per line. Existing comma-separated lists also work; quote column names that contain commas.">Excluded columns (one per line)<textarea id="excluded" rows="2"></textarea></label>
<label class="wide" title="One source=alias pair per line. Source names may contain commas.">Column aliases (one source=alias per line)<textarea id="aliases" rows="3" placeholder="customer.name=Customer&#10;amount=Revenue"></textarea></label>
<section class="table-projections wide" aria-labelledby="tableProjectionsTitle"><div class="table-projections-head"><div><h3 id="tableProjectionsTitle">Projected tables</h3><p>Choose the primary table and add related tables from one API response. All outputs stay grouped under this API source and update together.</p></div><button id="setupTableProjections" type="button" class="primary">Set up from response…</button></div><div id="primaryProjectionSummary" class="primary-projection-summary" aria-live="polite"></div><div class="projection-list-head"><strong>Additional tables</strong><button id="addTableProjection" type="button">＋ Add manually</button></div><div id="tableProjectionList"></div></section>
</div></section></div>
<div id="responseResize" class="horizontal-resizer" title="Resize request and response"></div><div class="response-head"><div class="tabs" id="responseTabs"><button class="active" data-response="grid">Data</button><button data-response="raw">Raw response</button><button data-response="submitted">Submitted request</button><button data-response="jsonRequest">JSON request</button></div><div class="response-actions"><span id="responseSummary">No request sent</span></div></div><div class="response"><div id="grid" class="response-panel active"></div><pre id="raw" class="response-panel"></pre><pre id="submitted" class="response-panel"></pre><div id="jsonRequest" class="response-panel"><div class="json-request-actions"><button id="manualJson" type="button" title="Edit the generated request specification directly">Manual JSON: off</button></div><pre id="jsonRequestEditor" class="code" spellcheck="false"></pre></div></div>
</section><div id="rightResize" class="pane-resizer" title="Resize details pane"></div><aside id="inspector"><div class="pane-title inspector-title"><div><h2>Configuration</h2><p>Saved API and connection</p></div><button id="collapseRight" title="Hide configuration">›</button></div><section class="inspector-card api-definition-settings" aria-labelledby="apiDefinitionSettingsTitle"><header><div><h3 id="apiDefinitionSettingsTitle">API definition</h3><p>The request settings in the center are saved with this API.</p></div><span class="scope-badge api">Per API</span></header><label>Saved API name<input id="endpointName" value="AdhocEndpoint"></label><button id="apiParameters" class="scope-action" type="button" title="Optional fallbacks stored only with this API">API fallback parameters</button><p class="scope-help">Method, path, request parameters, body, pagination and response shape belong to this API definition.</p><div class="connection-actions"><button id="duplicateEndpoint">Duplicate API</button><button id="moveEndpoint" title="Choose the destination in the connection dropdown, then click this button.">Move API…</button></div><div class="card-danger"><button id="deleteEndpoint">Delete API</button></div></section><section class="inspector-card connection-settings" aria-labelledby="connectionSettingsTitle"><header><div><h3 id="connectionSettingsTitle">Connection</h3><p>Shared by every API using this connection. Usually configured once.</p></div><span class="scope-badge shared">Shared</span></header><label>Connection name<input id="connectionName"></label><label>Base URL<input id="baseUrl" placeholder="https://api.example.com"></label><label>Timeout seconds<input id="timeout" type="number" value="100"></label><label title="Headers sent with every API definition using this connection. Example: Accept, User-Agent, or an API version header. Secrets should use Authentication instead.">Default headers (JSON)<textarea id="defaultHeaders" class="code">{}</textarea></label><button id="connectionParameters" class="scope-action" type="button" title="Defaults shared by every API using this connection">Connection parameters</button><div class="connection-actions"><button id="newConnection">＋ New connection</button><button id="saveConnection" class="primary">Save connection</button></div><p class="scope-help">Connection and authentication changes are shared and must be saved separately.</p><div class="card-danger"><button id="deleteConnection">Delete connection</button></div></section></aside></main>
<button id="formatBody" class="hidden" aria-hidden="true" tabindex="-1"></button><div id="pathModal" class="modal hidden"><div class="modal-card path-card"><div class="modal-head"><div><h2>Choose flatten path and columns</h2><p>Select the array that represents rows, then choose which fields to include.</p></div><button id="closePath">×</button></div><div id="pathList" class="path-tree"></div><div class="modal-actions"><button id="applyPath" class="primary">Apply selection</button><button id="cancelPath">Cancel</button></div></div></div><div id="projectionWorkbenchModal" class="modal hidden"><div class="modal-card projection-workbench-card" role="dialog" aria-modal="true" aria-labelledby="projectionWorkbenchTitle"><div class="modal-head"><div><h2 id="projectionWorkbenchTitle">Set up projected tables</h2><p>Choose what becomes the primary Qanvas source, then add any other arrays as grouped tables.</p></div><button id="closeProjectionWorkbench" type="button" aria-label="Close">×</button></div><div id="projectionWorkbenchIntro" class="projection-workbench-intro"></div><div id="projectionCandidateList" class="projection-candidate-list"></div><div class="modal-actions"><button id="finishProjectionWorkbench" class="primary" type="button">Done</button></div></div></div><div id="columnMenu" class="context-menu hidden"></div><div id="toast"></div><script src="parameter-editor.js?v=20261109-sql-lookup-1"></script><script src="api-workspace.js?v=20261111-projection-workbench-1"></script><script src="api-manual-json.js?v=20260922-1"></script><script src="api-workspace-query-integration.js?v=20261108-source-context-1"></script><script src="api-parameter-mapping.js?v=20261109-1"></script><script src="api-workspace-apply-state.js?v=20261108-1"></script></body></html>
