.creator-guide-launch{display:grid!important;grid-template-columns:auto auto;grid-template-rows:auto auto;align-items:center;column-gap:5px;min-width:72px;padding:5px 9px!important;line-height:1.05}.creator-guide-launch>span:first-child{grid-row:1/span 2;display:grid;place-items:center;width:20px;height:20px;border:1px solid currentColor;border-radius:50%;font-weight:800}.creator-guide-launch [data-guide-label]{font-weight:700}.creator-guide-launch small{font-size:9px;opacity:.72}.creator-guide-launch.complete>span:first-child{background:var(--qreports-positive,#2f855a);color:var(--qreports-on-accent,#fff);border-color:transparent}
.creator-start-heading{display:grid;gap:5px;max-width:780px}.creator-start-heading h1{margin:0;color:var(--qreports-text,#182230);font-size:clamp(22px,3vw,34px);line-height:1.08}.creator-start-heading p{margin:0;color:var(--qreports-muted,#667085);font-size:13px}.creator-start-heading-row{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;width:min(920px,calc(100% - 32px))}.creator-start-heading-row .creator-start-heading{min-width:0}.creator-layout-launch{display:inline-flex!important;align-items:center;gap:7px;flex:none;margin:0!important;padding:8px 11px!important;font-size:11px!important;font-weight:700}.creator-start-content{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(250px,.65fr);gap:14px;width:min(920px,calc(100% - 32px));margin-top:10px}.creator-start-journeys{display:grid;grid-template-columns:1fr;gap:10px}.creator-journey{display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-rows:auto 1fr auto;gap:4px 12px;min-width:0;min-height:104px;padding:15px 16px!important;margin:0!important;text-align:left;border-color:var(--qreports-grid,#cbd5e1)!important;background:color-mix(in srgb,var(--qreports-surface,#fff) 94%,var(--qreports-accent,#5369ce))!important;color:var(--qreports-text,#182230)!important}.creator-journey>span{grid-row:1/span 2;display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:color-mix(in srgb,var(--qreports-accent,#5369ce) 14%,var(--qreports-surface,#fff));color:var(--qreports-accent,#5369ce);font-size:20px;font-weight:800}.creator-journey b{font-size:14px}.creator-journey small{grid-column:2;color:var(--qreports-muted,#667085);font-size:11px;line-height:1.35}.creator-journey em{grid-column:1/span 2;margin-top:7px;color:var(--qreports-accent,#5369ce);font-size:11px;font-style:normal;font-weight:750}.creator-start-side{display:grid;grid-template-rows:1fr auto;gap:12px;min-width:0}.creator-secondary-tasks{display:grid;grid-template-columns:1fr;align-content:start;gap:10px}.creator-secondary-tasks button{display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-rows:auto auto;gap:3px 10px;min-width:0;min-height:78px;margin:0!important;padding:13px 14px!important;text-align:left!important;background:var(--qreports-surface,#fff)!important;color:var(--qreports-text,#182230)!important}.creator-secondary-tasks button>span{grid-row:1/span 2;align-self:start;color:var(--qreports-accent,#5369ce);font-size:17px}.creator-secondary-tasks b{font-size:12px}.creator-secondary-tasks small{color:var(--qreports-muted,#667085);font-size:10px;line-height:1.35}.creator-empty-footer{display:grid;gap:8px;padding-top:10px;border-top:1px solid var(--qreports-grid,#cbd5e1);font-size:11px;color:var(--qreports-muted,#667085)}.creator-empty-progress{display:flex;gap:8px;align-items:center}.creator-empty-progress b{color:var(--qreports-accent,#5369ce)}.creator-empty-progress.complete b{color:var(--qreports-positive,#2f855a)}.creator-empty-footer button{justify-self:start;margin:0!important;padding:6px 9px;font-size:11px}.creator-layout-label{display:flex;align-items:center;gap:10px;width:min(920px,calc(100% - 32px));margin:2px 0 -2px;color:var(--qreports-muted,#667085);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.creator-layout-label::before,.creator-layout-label::after{content:"";height:1px;flex:1;background:var(--qreports-grid,#cbd5e1)}.creator-layout-dialog{box-sizing:border-box;width:min(940px,calc(100vw - 28px));max-height:min(820px,calc(100vh - 28px));margin:auto;padding:0;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:18px;background:var(--qreports-panel,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);box-shadow:0 24px 80px #0006}.creator-layout-dialog::backdrop{background:#10182899;backdrop-filter:blur(4px)}.creator-layout-shell{display:grid;grid-template-rows:auto minmax(0,1fr) auto;max-height:inherit}.creator-layout-shell>header{display:flex;justify-content:space-between;gap:18px;padding:20px 22px 15px;border-bottom:1px solid var(--qreports-grid,#cbd5e1)}.creator-layout-shell header p{margin:0 0 3px;color:var(--qreports-accent,#5369ce);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.creator-layout-shell header h2{margin:0 0 4px;font-size:22px}.creator-layout-shell header span{color:var(--qreports-muted,#667085);font-size:12px}.creator-layout-shell header button{width:38px;height:38px;padding:0;font-size:22px}.creator-layout-dialog .empty-page-layout-gallery{box-sizing:border-box;width:100%;max-height:min(600px,calc(100vh - 220px));margin:0;padding:18px 22px;overflow:visible}.creator-layout-shell>footer{display:flex;justify-content:flex-end;padding:12px 22px;border-top:1px solid var(--qreports-grid,#cbd5e1)}
.creator-guide-dialog{width:min(760px,calc(100vw - 28px));max-height:min(820px,calc(100vh - 28px));padding:0;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:18px;background:var(--qreports-panel,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);box-shadow:0 24px 80px #0006}.creator-guide-dialog::backdrop{background:#10182899;backdrop-filter:blur(4px)}.creator-guide-shell>header{display:flex;justify-content:space-between;gap:18px;padding:22px 24px 17px;border-bottom:1px solid var(--qreports-grid,#cbd5e1)}.creator-guide-shell header p{margin:0 0 3px;color:var(--qreports-accent,#5369ce);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.11em}.creator-guide-shell header h2{margin:0 0 5px;font-size:24px}.creator-guide-shell header span{color:var(--qreports-muted,#667085);font-size:13px}.creator-guide-shell header button{width:38px;height:38px;padding:0;font-size:22px}.creator-guide-progress{height:5px;background:color-mix(in srgb,var(--qreports-grid,#cbd5e1) 65%,transparent)}.creator-guide-progress i{display:block;height:100%;width:0;background:var(--qreports-accent,#5369ce);transition:width .2s}.creator-guide-shell>section{display:grid;gap:9px;padding:18px 24px}.creator-guide-step{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:13px;padding:13px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:12px;background:var(--qreports-surface,#fff)}.creator-guide-check{display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:50%;color:var(--qreports-muted,#667085);font-size:10px;font-weight:800;text-transform:uppercase}.creator-guide-step.complete .creator-guide-check{border-color:color-mix(in srgb,var(--qreports-positive,#2f855a) 45%,transparent);background:color-mix(in srgb,var(--qreports-positive,#2f855a) 15%,var(--qreports-surface,#fff));color:var(--qreports-positive,#2f855a);font-size:15px}.creator-guide-step h3{margin:0 0 3px;font-size:14px}.creator-guide-step p{margin:0;color:var(--qreports-muted,#667085);font-size:12px;line-height:1.35}.creator-guide-step button{min-width:134px;font-size:11px}.creator-guide-shell>footer{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 24px;border-top:1px solid var(--qreports-grid,#cbd5e1);color:var(--qreports-muted,#667085);font-size:11px}
@media(max-width:760px){.creator-start-heading-row{align-items:flex-start;flex-direction:column}.creator-start-content{grid-template-columns:1fr}.creator-start-journeys,.creator-secondary-tasks{grid-template-columns:1fr}.creator-guide-step{grid-template-columns:auto minmax(0,1fr)}.creator-guide-step button{grid-column:2;justify-self:start}.creator-guide-shell>footer{align-items:flex-start;flex-direction:column}}
@media(max-height:700px){.creator-layout-dialog .empty-page-layout-gallery{overflow:auto}}
