:root{--surface:#f6f8f3;--panel:#fff;--soft:#edf2e9;--text:#17351f;--muted:#667569;--line:#ccd8c8;--accent:#477c50;--accent-strong:#285d36;--on-accent:#fff;--header:#e6efe2;--shadow:0 18px 55px rgba(28,62,35,.12)}
*{box-sizing:border-box}html,body{height:100%;margin:0}body{font-family:Segoe UI,Inter,system-ui,sans-serif;background:var(--surface);color:var(--text);overflow:hidden}button,input,select{font:inherit;color:inherit}button{cursor:pointer}.app-header{height:118px;display:flex;align-items:center;gap:20px;padding:20px 28px;background:var(--header);border-bottom:1px solid var(--line)}.brand-mark{width:62px;height:62px;border-radius:18px;display:grid;place-items:center;background:linear-gradient(145deg,#1f5130,#77946e);color:#fff;font:800 32px Georgia;box-shadow:0 8px 20px rgba(29,73,41,.22)}.title-block{min-width:0}.title-block span,.eyebrow{display:block;font-size:11px;font-weight:800;letter-spacing:.16em;color:var(--accent)}h1,h2,p{margin:0}h1{font-size:30px;letter-spacing:-.03em;margin:2px 0}.title-block p{color:var(--muted)}.header-actions{margin-left:auto;display:flex;gap:10px;align-items:center}.save-state{display:flex;align-items:center;gap:8px;margin-right:10px;color:var(--muted);font-size:13px}.save-state i{width:9px;height:9px;border-radius:50%;background:#63b978;box-shadow:0 0 0 4px rgba(99,185,120,.15)}button{border:1px solid var(--line);border-radius:10px;background:var(--panel);padding:10px 16px}.primary{background:var(--accent-strong);border-color:var(--accent-strong);color:var(--on-accent);font-weight:700}.ghost{background:transparent}.secondary{background:var(--panel)}main{display:grid;grid-template-columns:300px minmax(530px,1fr) 360px;height:calc(100% - 118px)}aside,.builder{min-height:0;overflow:auto}.library{padding:24px 20px;border-right:1px solid var(--line);background:#fbfcf9}.aside-head,.preview-head,.builder-intro,.section-title{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}.aside-head h2,.preview-head h2,.builder-intro h2,.section-title h2{font-size:22px;margin-top:3px}.icon{width:38px;height:38px;padding:0;display:grid;place-items:center;font-size:20px}.search{height:44px;border:1px solid var(--line);border-radius:12px;background:var(--panel);display:flex;align-items:center;gap:8px;padding:0 12px;margin:18px 0 12px}.search input{min-width:0;width:100%;border:0;outline:0;background:transparent}.library-tabs{display:flex;gap:4px;padding:4px;background:var(--soft);border-radius:10px;margin-bottom:16px}.library-tabs button{flex:1;padding:7px 4px;border:0;background:transparent;border-radius:7px;font-size:12px;color:var(--muted)}.library-tabs button.active{background:var(--panel);color:var(--text);box-shadow:0 2px 8px rgba(30,60,35,.09);font-weight:700}.item-group{margin-bottom:18px}.item-group h3{font-size:11px;letter-spacing:.1em;color:var(--muted);text-transform:uppercase;margin:0 0 7px}.field-item{width:100%;display:flex;align-items:center;text-align:left;gap:10px;border:0;padding:9px 8px;background:transparent;border-radius:9px}.field-item:hover,.field-item:focus-visible{background:var(--soft)}.field-icon{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;background:#e4eee2;color:var(--accent-strong);font-size:11px;font-weight:800}.field-item small{margin-left:auto;color:var(--muted)}.drag-tip{border:1px dashed var(--line);background:var(--soft);border-radius:12px;padding:12px;font-size:12px;display:flex;gap:8px;color:var(--muted)}.drag-tip b{color:var(--text)}.builder{padding:28px 30px}.summary{padding:7px 10px;border-radius:999px;background:var(--soft);color:var(--muted);font-size:12px}.choice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0 22px}.choice{min-height:112px;display:grid;grid-template-columns:42px 1fr 18px;gap:10px;align-items:start;text-align:left;padding:16px;background:var(--panel);box-shadow:0 3px 12px rgba(30,60,35,.04)}.choice.active{border:2px solid var(--accent);background:color-mix(in srgb,var(--accent) 7%,var(--panel));padding:15px}.choice-icon{width:40px;height:40px;border-radius:12px;background:var(--soft);display:grid;place-items:center;font-weight:800}.choice b{display:block}.choice small{display:block;color:var(--muted);line-height:1.35;margin-top:5px}.choice i{font-style:normal;opacity:0;color:var(--accent);font-weight:800}.choice.active i{opacity:1}.type-row{display:grid;grid-template-columns:220px 1fr;gap:18px;padding:18px;border:1px solid var(--line);border-radius:14px;background:var(--panel);margin-bottom:30px}.type-row label span{display:block;font-size:12px;font-weight:700;margin-bottom:7px}.type-row select{width:100%;height:42px;border:1px solid var(--line);border-radius:9px;background:var(--surface);padding:0 10px}.type-help{display:flex;flex-direction:column;justify-content:center;border-left:1px solid var(--line);padding-left:18px}.type-help span{color:var(--muted);font-size:13px;margin-top:4px}.section-title{align-items:end;margin-bottom:12px}.section-title p{color:var(--muted);font-size:12px}.option-card{border:1px solid var(--line);border-radius:13px;background:var(--panel);margin-bottom:10px;overflow:hidden;transition:.18s}.option-card.open{border-color:var(--accent);box-shadow:0 6px 20px rgba(35,74,43,.07)}.option-toggle{width:100%;border:0;border-radius:0;background:transparent;padding:15px 16px;display:grid;grid-template-columns:36px 1fr auto 20px;align-items:center;gap:10px;text-align:left}.option-symbol{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;background:var(--soft);color:var(--accent-strong);font-weight:800}.option-toggle b{display:block}.option-toggle small{color:var(--muted)}.option-count{font-size:11px;color:var(--accent);background:var(--soft);padding:4px 8px;border-radius:999px}.chevron{transition:.18s}.open .chevron{transform:rotate(180deg)}.option-body{display:none;padding:0 16px 16px 62px}.open .option-body{display:block}.token-input{min-height:46px;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:7px;display:flex;gap:6px;flex-wrap:wrap;align-items:center}.token-input input{flex:1;min-width:130px;border:0;outline:0;background:transparent;padding:5px}.token{display:inline-flex;align-items:center;gap:6px;background:#dfeadc;border-radius:7px;padding:6px 8px;font-size:12px}.token button{border:0;background:transparent;padding:0;color:var(--muted)}.option-hint{font-size:12px;color:var(--muted);margin-top:8px}.preview-pane{padding:24px 22px;border-left:1px solid var(--line);background:#f0f4ed}.preview-pane pre{min-height:160px;white-space:pre-wrap;word-break:break-word;padding:18px;border-radius:14px;background:#17351f;color:#eaf3e8;font:14px/1.65 Consolas,monospace;box-shadow:var(--shadow);margin:18px 0}.explain,.active-list{padding:16px;border:1px solid var(--line);background:var(--panel);border-radius:12px;margin-bottom:12px}.explain>span,.active-list>span{font-size:11px;font-weight:800;letter-spacing:.08em;color:var(--muted);text-transform:uppercase}.explain p{font-size:13px;line-height:1.5;margin-top:8px}.active-list #activeList{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.active-pill{padding:5px 8px;background:var(--soft);border-radius:7px;font-size:11px}.wide{width:100%;margin-top:9px}.footnote{text-align:center;color:var(--muted);font-size:11px;margin:12px}#toast{position:fixed;right:24px;bottom:24px;background:#17351f;color:#fff;padding:11px 16px;border-radius:9px;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none}#toast.show{opacity:1;transform:none}@media(max-width:1100px){main{grid-template-columns:250px 1fr}.preview-pane{position:fixed;right:0;top:118px;bottom:0;width:350px;box-shadow:-15px 0 40px rgba(25,50,30,.15);transform:translateX(calc(100% - 8px));transition:.2s}.preview-pane:hover,.preview-pane:focus-within{transform:none}.choice-grid{grid-template-columns:1fr}}
