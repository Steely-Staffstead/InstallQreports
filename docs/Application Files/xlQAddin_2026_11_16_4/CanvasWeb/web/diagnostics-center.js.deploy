    if(schemaDrift?.changes.length&&schemaDrift.status!=="resolved"){const removed=schemaDrift.changes.filter(item=>item.kind==="removed"),types=schemaDrift.changes.filter(item=>item.kind==="type"),added=schemaDrift.changes.filter(item=>item.kind==="added"),parts=[removed.length&&`${removed.length} removed`,types.length&&`${types.length} type change${types.length===1?"":"s"}`,added.length&&`${added.length} added`].filter(Boolean),suggestions=removed.map(item=>({from:item.name,matches:renameSuggestions(item.name,added.map(entry=>entry.name))})).filter(item=>item.matches.length);messages.push({level:removed.length||types.length?"blocker":"warning",text:`Schema drift detected: ${parts.join(" · ")}. Review column types and affected report bindings.${suggestions.length?` Possible rename: ${suggestions.map(item=>`${item.from} → ${item.matches[0].name}`).join(", ")}.`:""}`});}
    if(query.updateRequired)messages.push({level:"warning",text:pendingReasons.length?`Update required: ${pendingReasons.join(" · ")}`:"Source changes are waiting to be updated."});
