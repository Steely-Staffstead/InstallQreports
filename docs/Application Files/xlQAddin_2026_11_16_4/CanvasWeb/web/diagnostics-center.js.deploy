      dialog.querySelectorAll("[data-diagnostics-close]").forEach(button=>button.onclick=()=>dialog.close());dialog.addEventListener("close",()=>launch?.focus());dialog.querySelector("[data-diagnostics-recheck]").onclick=()=>{update();dialog.querySelector("[data-diagnostics-summary]").textContent=`Re-check complete. ${dialog.querySelector("[data-diagnostics-summary]").textContent}`;};dialog.querySelector("[role=tablist]").addEventListener("keydown",event=>{if(!["ArrowLeft","ArrowRight","Home","End"].includes(event.key))return;const tabs=[...dialog.querySelectorAll('[role="tab"]:not([hidden])')],current=tabs.indexOf(document.activeElement);if(current<0)return;event.preventDefault();const next=event.key==="Home"?0:event.key==="End"?tabs.length-1:(current+(event.key==="ArrowRight"?1:-1)+tabs.length)%tabs.length;tabs[next].focus();tabs[next].click();});
      dialog.addEventListener("click",event=>{const tabButton=event.target.closest("[data-diagnostics-tab]");if(tabButton){tab=tabButton.dataset.diagnosticsTab;update();return;}const repairButton=event.target.closest("[data-binding-repair]");if(repairButton){const article=repairButton.closest("[data-binding-issue]"),report=analyze(model()),issue=report.bindings[+article.dataset.bindingIssue],repair=issue?.repair;if(!repair)return;if(repairButton.dataset.bindingRepair==="replace"){const replacement=article.querySelector("[data-binding-replacement]")?.value;if(!replacement)return;const changed=replaceFieldReferences(model(),repair.sourceId,repair.field,replacement);const source=(model().sources||[]).find(item=>item.id===repair.sourceId);if(source?.query?.schemaDrift){source.query.schemaDrift.status="resolved";source.query.schemaDrift.resolvedUtc=new Date().toISOString();source.query.schemaDrift.resolution={kind:"rename",from:repair.field,to:replacement,changed};}}else if(repair.collection){const index=repair.collection.indexOf(repair.target);if(index>=0)repair.collection.splice(index,1);}else delete repair.target[repair.property];ctx.changed?.();record({status:"success",title:repairButton.dataset.bindingRepair==="replace"?`Mapped ${repair.field}`:`Removed broken ${repair.kind}`,detail:repairButton.dataset.bindingRepair==="replace"?`Replaced downstream references with ${article.querySelector("[data-binding-replacement]")?.value}.`:issue.detail});update();return;}const button=event.target.closest("[data-diagnostics-action]"),id=button?.dataset.sourceId;if(!button)return;const action=button.dataset.diagnosticsAction;if(action==="refresh-pending"){dialog.close();ctx.refreshPending?.();return;}if(action==="acknowledge-drift"&&id){const source=(model().sources||[]).find(item=>item.id===id);if(source?.query?.schemaDrift){source.query.schemaDrift.status="resolved";source.query.schemaDrift.resolvedUtc=new Date().toISOString();source.query.schemaDrift.resolution={kind:"acknowledged"};ctx.changed?.();record({sourceId:id,status:"success",title:`${source.name||"Source"} schema drift reviewed`,detail:"The recorded schema change was acknowledged without changing bindings."});update();}return;}if(!id)return;dialog.close();if(action==="select")ctx.selectSource?.(id);else if(action==="refresh")ctx.refreshSource?.(id);else if(action==="authentication")ctx.openAuthentication?.(id);else if(action==="types")ctx.openTypes?.(id);else if(action==="edit")ctx.editSource?.(id);});return dialog;
    }
    function update(){
      const report=analyze(model()),problemCount=report.blockers+report.warnings;if(!report.hasSources&&tab==="sources")tab="bindings";else if(report.hasSources&&!dialog&&tab==="bindings")tab="sources";if(launch){launch.querySelector("[data-diagnostics-count]").textContent=String(problemCount);launch.classList.toggle("has-problems",problemCount>0);launch.title=problemCount?`${report.blockers} blocker${report.blockers===1?"":"s"} · ${report.warnings} warning${report.warnings===1?"":"s"}${report.pending?` · ${report.pending} source${report.pending===1?"":"s"} need update`:""}`:report.hasSources?"Sources and document bindings look healthy":"Document looks healthy";}
      if(!dialog)return report;dialog.querySelector("[data-diagnostics-summary]").textContent=report.blockers?`${report.blockers} blocker${report.blockers===1?"":"s"} need attention`:report.warnings?`${report.warnings} item${report.warnings===1?"":"s"} should be reviewed`:report.hasSources?"Sources and document bindings look healthy":"Document looks healthy · no sources required";const sourceTab=dialog.querySelector('[data-diagnostics-tab="sources"]'),bindingTab=dialog.querySelector('[data-diagnostics-tab="bindings"]');sourceTab.hidden=!report.hasSources;bindingTab.childNodes[0].textContent=report.hasSources?"Bindings ":"Document ";dialog.querySelector("[data-source-count]").textContent=String(report.sources.length);dialog.querySelector("[data-binding-count]").textContent=String(report.bindings.length);dialog.querySelector("[data-activity-count]").textContent=String(events.length);dialog.querySelectorAll("[data-diagnostics-tab]").forEach(button=>{const selected=button.dataset.diagnosticsTab===tab;button.classList.toggle("active",selected);button.setAttribute("aria-selected",String(selected));button.tabIndex=selected?0:-1;});const content=dialog.querySelector("[data-diagnostics-content]");
      if(tab==="sources"){
        if(!report.sources.some(source=>source.id===selectedSourceId))selectedSourceId=report.sources[0]?.id||"";
        const selected=report.sources.find(source=>source.id===selectedSourceId);
        content.innerHTML=`<section class="diagnostics-source-toolbar"><div class="diagnostics-overview"><div class="blocker"><b>${report.blockers}</b><span>Blockers</span></div><div class="warning"><b>${report.warnings}</b><span>Warnings</span></div><div class="pass"><b>${report.healthy}</b><span>Healthy</span></div></div><label><span>Inspect source</span><select data-diagnostics-source-select>${report.sources.map(source=>`<option value="${esc(source.id)}" ${source.id===selectedSourceId?"selected":""}>${esc(source.name)} · ${esc(toneLabel(source.level))}</option>`).join("")}</select></label><small>${report.sources.length} source${report.sources.length===1?"":"s"}</small>${report.pending?`<button type="button" class="primary" data-diagnostics-action="refresh-pending" ${ctx.canRefresh&&!ctx.canRefresh()?"disabled":""}>Update ${report.pending} affected</button>`:""}</section><section class="diagnostics-source-list">${sourceHtml(selected)}</section>`;
        content.querySelector("[data-diagnostics-source-select]")?.addEventListener("change",event=>{selectedSourceId=event.target.value;update();});
        if(selected?.schemaDrift?.changes?.length&&selected.schemaDrift.status!=="resolved"){
          const footer=content.querySelector("[data-diagnostics-source] > footer"),source=(model().sources||[]).find(item=>item.id===selected.id);
          for(const suggestion of selected.renameSuggestions||[]){const match=suggestion.matches[0],button=document.createElement("button");button.type="button";button.className="primary";button.textContent=`Map ${suggestion.from} → ${match.name}`;button.title=`Update downstream bindings and mark this schema drift resolved (${Math.round(match.score*100)}% match)`;button.onclick=()=>resolveSchemaDrift(source,{kind:"rename",from:suggestion.from,to:match.name,score:match.score});footer?.prepend(button);}
          const acknowledge=document.createElement("button");acknowledge.type="button";acknowledge.textContent="Mark drift reviewed";acknowledge.onclick=()=>resolveSchemaDrift(source,{kind:"acknowledged"});footer?.append(acknowledge);
        }
      }
      else if(tab==="bindings")content.innerHTML=`<section class="diagnostics-section-heading"><div><h3>${report.hasSources?"Report bindings":"Document health"}</h3><p>${report.hasSources?"Checks source references, fields, filters and relationship keys against the loaded schema.":"This Qanvas uses document content without data sources. Pages, presentations, HTML and Apps can work without source configuration."}</p></div>${ctx.openPublish?'<button type="button" data-diagnostics-publish>Open publish checks</button>':""}</section><section class="diagnostics-issue-list">${report.bindings.length?report.bindings.map(issueHtml).join(""):`<p class="diagnostics-empty success">✓ ${report.hasSources?"No broken source or field bindings were found.":"Document content is ready. No source configuration is required."}</p>`}</section>`;
      else content.innerHTML=`<section class="diagnostics-section-heading"><div><h3>Refresh activity</h3><p>Recent activity from this Qanvas session. Authentication secrets are excluded.</p></div><button type="button" data-diagnostics-clear>Clear</button></section><section class="diagnostics-event-list">${events.length?[...events].reverse().map(eventHtml).join(""):'<p class="diagnostics-empty">No source activity has been recorded in this session.</p>'}</section>`;
      content.querySelector("[data-diagnostics-publish]")?.addEventListener("click",()=>{dialog.close();ctx.openPublish?.();});content.querySelector("[data-diagnostics-clear]")?.addEventListener("click",()=>{events=[];update();});return report;
    }
    function open(){if(!opened){tab=analyze(model()).hasSources?"sources":"bindings";opened=true;}ensureDialog();globalThis.qvitrApplyApplicationTheme?.(dialog);update();dialog.showModal();requestAnimationFrame(()=>dialog.querySelector('[role="tab"][aria-selected="true"]')?.focus());}
    function record(item){const time=item?.time||new Date().toISOString(),sourceId=item?.sourceId;if(sourceId&&item?.resetTrace)runtimeStages.delete(sourceId);if(sourceId&&item?.stage){const stages=runtimeStages.get(sourceId)||{},previous=stages[item.stage]||{};stages[item.stage]={...previous,status:normalizedStageStatus(item.stageStatus||item.status),detail:item.stageDetail||item.detail||previous.detail||"",time,durationMs:item.durationMs};runtimeStages.set(sourceId,stages);}if(item?.title){const next={...item,time},existing=item.activityKey?events.findIndex(event=>event.activityKey===item.activityKey):-1;if(existing>=0)events[existing]=next;else events.push(next);if(events.length>60)events=events.slice(-60);}update();}
    launch?.addEventListener("click",event=>{event.preventDefault();open();});update();return{open,update,record,analyze:()=>analyze(model())};
  },renameSuggestions,replaceFieldReferences,normalizedIdentifier};
})();
