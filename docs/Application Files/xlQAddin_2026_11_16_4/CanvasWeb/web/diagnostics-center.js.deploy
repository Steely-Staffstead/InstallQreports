    if(mode==="preview"&&total>loaded)messages.push({level:"warning",text:`Only ${loaded.toLocaleString()} of ${total.toLocaleString()} rows are saved.`});
    const level=messages.some(item=>item.level==="blocker")?"blocker":messages.length?"warning":"pass",isApi=apiSource(source),lastRefreshUtc=query.lastRefreshUtc||source.localTable?.updatedUtc||"",lastRefreshAttemptUtc=query.lastRefreshAttemptUtc||lastRefreshUtc,parameterCount=(query.parameters||[]).length,connection=query.connectionName||source.localTable?.name||"Not set",snapshotLabel=mode==="all"?"Complete snapshot":mode==="none"?"No snapshot":"Preview snapshot";
    const stages=[
      {name:"Parameters",status:parameterCount?"pass":"neutral",detail:parameterCount?`${parameterCount} mapped`:"No parameters"},
      {name:"Connection",status:connectionHealth.missing?"error":configured?"pass":"error",detail:connectionHealth.missing?`${connectionHealth.name} · Missing on this computer`:configured?connection:"Not configured"},
      {name:"Authentication",status:isApi?(query.connectionName?"pass":"warning"):"neutral",detail:isApi?(query.connectionName?"Managed by connection":"Review connection"):"Not required"},
      {name:"Request",status:refreshError?"error":dynamic?(lastRefreshUtc?"pass":"warning"):"neutral",detail:refreshError|| (dynamic?(lastRefreshUtc?displayDate(lastRefreshUtc):"Not run yet"):"Local data")},
      {name:"Schema",status:schemaDrift?.status==="resolved"?"pass":schemaDrift?.changes.length?(schemaDrift.changes.some(item=>item.kind==="removed"||item.kind==="type")?"error":"warning"):(data.columns||[]).length?"pass":configured?"warning":"neutral",detail:schemaDrift?.status==="resolved"?`Reviewed ${displayDate(schemaDrift.resolvedUtc)}`:schemaDrift?.changes.length?`${schemaDrift.changes.length} change${schemaDrift.changes.length===1?"":"s"} detected`:(data.columns||[]).length?`${data.columns.length} columns`:"No loaded schema"},
      {name:"Snapshot",status:mode==="none"?"warning":loaded?"pass":"neutral",detail:`${snapshotLabel} · ${loaded.toLocaleString()} rows`}
