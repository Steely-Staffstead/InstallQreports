      for(const key of relationship.keys||[]){const fromField=key.fromField??key.FromField??key.from??key.fromColumn??key.source,toField=key.toField??key.ToField??key.to??key.toColumn??key.target;if(simpleField(fromField)&&!sourceColumns(from).has(String(fromField).toLocaleLowerCase()))add("warning",`${from.name} → ${to.name}`,`Relationship field '${fromField}' is missing from ${from.name}.`);if(simpleField(toField)&&!sourceColumns(to).has(String(toField).toLocaleLowerCase()))add("warning",`${from.name} → ${to.name}`,`Relationship field '${toField}' is missing from ${to.name}.`);}
    }
    return issues;
  }
  function sourceStatus(source){
    const query=source?.query||{},data=queryData(source),loaded=data.rows?.length||0,total=Number(query.totalRows)||loaded,mode=query.savedDataMode||"preview",configured=sourceConfigured(source),dynamic=!!query.queryText||apiSource(source),messages=[],schemaDrift=query.schemaDrift&&Array.isArray(query.schemaDrift.changes)?query.schemaDrift:null,refreshError=String(query.lastRefreshError||"").trim();
