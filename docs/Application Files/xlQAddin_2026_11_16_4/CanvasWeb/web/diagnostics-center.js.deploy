  loadStyles();
  window.QvitrDiagnostics={analyze,bindingIssues,sourceStatus,connectionStatus,setConnections(items){availableConnections=Array.isArray(items)?new Set(items.map(item=>String(typeof item==="string"?item:item?.name||"").trim().toLocaleLowerCase()).filter(Boolean)):null;},install(ctx){
    const fileActions=document.querySelector(".file-actions"),guide=fileActions?.querySelector(".creator-guide-launch"),help=fileActions?.querySelector(".help-menu-wrap");let launch=fileActions?.querySelector('[data-action="diagnostics"]'),dialog=null,tab="sources",selectedSourceId="",events=[],opened=false;const runtimeStages=new Map();
