  function replaceFieldReferences(model,sourceId,from,to){let count=0;const replace=value=>{const next=replaceFormulaField(value,from,to);if(next!==value)count++;return next;},visitObject=item=>{if(!item||typeof item!=="object")return;for(const [key,value] of Object.entries(item)){if(typeof value==="string"&&["field","column","name","valueField","imageField","relatedField","fromField","toField","expression","Expression","htmlDocument","heading","supportingText"].includes(key))item[key]=replace(value);else if(value&&typeof value==="object")visitObject(value);}};const source=(model?.sources||[]).find(item=>item.id===sourceId);if(source){for(const filter of source.query?.filters||[])if(filter.column===from){filter.column=to;count++;}for(const measure of source.query?.measures||[])if(measure.Expression||measure.expression){const key=measure.Expression!==undefined?"Expression":"expression";measure[key]=replace(measure[key]);}}for(const page of model?.pages||[]){for(const filter of page.filters||[])if((filter.sourceId||"main")===sourceId&&filter.column===from){filter.column=to;count++;}for(const item of [...(page.tiles||[]),...(page.graphics||[])])if((item.sourceId||"main")===sourceId)visitObject(item);}for(const relationship of model?.relationships||[])if(relationship.fromSourceId===sourceId||relationship.toSourceId===sourceId)visitObject(relationship);for(const app of model?.apps||[])visitObject(app);for(const column of model?.viewerOptions?.filterColumns||[])if((column.sourceId||"main")===sourceId&&column.column===from){column.column=to;count++;}return count;}
  const connectionStatus=name=>{
    const value=String(name||"").trim();
