        for(const filter of item.filters||[]){const column=simpleField(filter.column);if(column&&!columns.has(column.toLocaleLowerCase()))add("warning",item.title||item.kind||"Report object",`Tile filter uses missing field '${column}'.`,page.name,{kind:"filter",sourceId,field:column,candidates:sourceColumnNames(source),target:filter,property:"column",collection:item.filters});}
      }
      for(const filter of page.filters||[]){const sourceId=filter.sourceId||"main",source=sources.get(sourceId),column=simpleField(filter.column);if(!source)add("blocker",`${page.name||"Page"} filter`,`References a source that no longer exists.`,page.name);else if(column&&!sourceColumns(source).has(column.toLocaleLowerCase()))add("warning",`${page.name||"Page"} filter`,`Uses missing field '${column}'.`,page.name,{kind:"filter",sourceId,field:column,candidates:sourceColumnNames(source),target:filter,property:"column",collection:page.filters});}
    }
    for(const relationship of model?.relationships||[]){
