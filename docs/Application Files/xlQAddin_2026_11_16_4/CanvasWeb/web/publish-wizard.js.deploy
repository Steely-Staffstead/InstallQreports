    function saveMetadata(){if(!dialog)return;const meta=publication();meta.publisherName=dialog.querySelector('[data-publisher-name]').value.trim();meta.publisherContact=dialog.querySelector('[data-publisher-contact]').value.trim();const freshness=dialog.querySelector('[data-freshness]').value;meta.dataFreshnessUtc=freshness?new Date(freshness).toISOString():"";meta.notes=dialog.querySelector('[data-publisher-notes]').value.trim();meta.exportLayout=dialog.querySelector('[data-publication-layout]')?.value||meta.exportLayout||"footer";const protection=meta.protection||={mode:"editable",protectedUtc:"",protectedBy:"",note:""},protect=dialog.querySelector('[data-protect-qanvas]')?.checked===true;protection.mode=protect?"protected":"editable";protection.note=dialog.querySelector('[data-protection-note]')?.value.trim()||"";if(protect){protection.protectedUtc=protection.protectedUtc||new Date().toISOString();protection.protectedBy=meta.publisherName||protection.protectedBy||"Publisher";}else{protection.protectedUtc="";protection.protectedBy="";}const policy=meta.reconciliationPolicy||={};policy.minimumCoverage=Math.max(0,Math.min(100,Number(dialog.querySelector('[data-reconciliation-coverage]')?.value??policy.minimumCoverage??100)));policy.maximumRowGap=Math.max(0,Number(dialog.querySelector('[data-reconciliation-gap]')?.value??policy.maximumRowGap??0));policy.maximumSpreadHours=Math.max(0,Number(dialog.querySelector('[data-reconciliation-spread]')?.value??policy.maximumSpreadHours??24));policy.enforcement=dialog.querySelector('[data-reconciliation-enforcement]')?.value||policy.enforcement||"review";policy.requireSignoff=dialog.querySelector('[data-reconciliation-require-signoff]')?.checked===true;ctx.changed();}
    function renderManifest(manifest){const current=model();return `<div class="viewer-manifest-summary"><strong>Requires ${esc(manifest.contract.runtime)} ${esc(manifest.contract.version)}+</strong><span><b>${manifest.fieldImpact?.checked||0}</b> fields checked</span><span><b>${manifest.counts.embedded}</b> embedded</span><span><b>${manifest.counts.signIn}</b> after sign-in</span><span><b>${manifest.counts.unavailable}</b> unavailable</span></div><div class="viewer-manifest-list">${manifest.dependencies.map((item,index)=>{const page=current.pages?.find(value=>value.id===item.pageId),source=current.sources?.find(value=>value.id===item.sourceId),context=page?`${page.name||"Page"} · ${item.kind}${item.usage?` · ${item.usage}`:""}`:source?`${source.name||"Source"} · data source`:item.kind,action=item.objectId?(item.kind==="html"?"Edit HTML":item.kind==="app"||item.kind==="permission"?"Open App settings":"Go to object"):item.sourceId?"Open source":item.status!=="embedded"?"Open diagnostics":"";return `<article data-state="${esc(item.status)}"><span>${item.status==="embedded"?"✓":item.status==="sign-in"?"!":"×"}</span><details><summary><b>${esc(item.name)}</b><small>${esc(context)}</small></summary><p>${esc(item.detail)}</p>${item.field?`<small>Field ${esc(item.field)} · Source ${esc(item.sourceId)}</small>`:item.objectId?`<small>Object ${esc(item.objectId)}</small>`:item.sourceId?`<small>Source ${esc(item.sourceId)}</small>`:""}</details><em>${item.status==="embedded"?"Embedded":item.status==="sign-in"?"Verify":"Unavailable"}</em>${action?`<button type="button" data-manifest-dependency="${index}">${action}</button>`:""}</article>`;}).join("")}</div>`;}
    function renderReconciliation(assessment){const summary=assessment.summary;if(!summary.sourceCount)return `<div class="reconciliation-empty"><strong>No source reconciliation required</strong><span>This Qanvas can be published as a document without data sources.</span></div>`;const labels={complete:"Reconciled",partial:"Partial coverage",unrecorded:"Refresh not recorded","no-snapshot":"No snapshot"},percent=Math.round(summary.coverage*100),verdict=assessment.status==="passed"?"Ready for finance review":assessment.status==="blocked"?"Publishing blocked":"Finance review required",guidance=assessment.status==="passed"?"Saved rows, refresh timing and evidence are within the selected thresholds.":assessment.breaches.length?`${assessment.breaches.length} threshold check${assessment.breaches.length===1?" needs":"s need"} attention before sign-off.`:"Review the saved source evidence before publishing.",breaches=assessment.breaches.length?`<div class="reconciliation-breaches">${assessment.breaches.map(item=>`<span><b>${esc(item.label)}</b> ${esc(item.actual)} · ${esc(item.limit)}</span>`).join("")}</div>`:"";return `<div class="finance-reconciliation" data-state="${esc(assessment.status)}"><div><span>Finance data confidence</span><strong>${verdict}</strong><small>${guidance}</small></div><time>${summary.oldestUtc?`Data as of ${esc(displayDate(summary.oldestUtc))}`:"Refresh date not recorded"}</time></div><div class="reconciliation-head" data-state="${esc(summary.status)}"><div><strong>${summary.status==="complete"?"Source data reconciles":summary.status==="unrecorded"?"Refresh evidence incomplete":"Review source coverage"}</strong><small>${summary.sourceCount} source${summary.sourceCount===1?"":"s"} · ${summary.totalLoaded.toLocaleString()} of ${summary.totalExpected.toLocaleString()} rows saved</small></div><div><b>${percent}%</b><span>coverage</span></div><div><b>${summary.difference.toLocaleString()}</b><span>row gap</span></div><div><b>${summary.spreadHours}h</b><span>refresh spread</span></div></div>${breaches}<details class="reconciliation-source-menu" ${summary.status==="complete"?"":"open"}><summary><span>Source evidence</span><small>${summary.counts.complete}/${summary.sourceCount} complete · ${summary.sourceCount} total</small></summary><div class="reconciliation-sources">${summary.sources.map(source=>`<article data-state="${esc(source.status)}"><div><strong>${esc(source.name)}</strong><span>${esc(labels[source.status]||source.status)}</span></div><small>${source.loaded.toLocaleString()} / ${source.total.toLocaleString()} rows · ${esc(source.mode)} snapshot</small><time>${source.lastSuccess?`Refreshed ${esc(displayDate(source.lastSuccess))}`:"Refresh not recorded"}</time></article>`).join("")}</div><p class="reconciliation-range">${summary.oldestUtc?`Refresh range: ${esc(displayDate(summary.oldestUtc))} – ${esc(displayDate(summary.newestUtc))}${summary.spreadHours?` · ${summary.spreadHours} hour spread`:""}`:"No successful refresh timestamps recorded."}</p></details>`;}
    function renderReconciliationApproval(assessment){const signoff=assessment.signoff||{},state=assessment.signed?"signed":signoff.approvedUtc?"stale":assessment.policy.requireSignoff?"required":"optional",label=assessment.signed?"Approved":state==="stale"?"Approval is stale":assessment.policy.requireSignoff?"Approval required":"Approval optional";return `<div class="reconciliation-approval-state" data-state="${state}"><div><strong>${label}</strong><small>${assessment.signed?`${esc(signoff.name||"Publisher")} · ${esc(displayDate(signoff.approvedUtc))}`:state==="stale"?"Evidence or thresholds changed after approval.":assessment.breaches.length?`${assessment.breaches.length} threshold exception${assessment.breaches.length===1?"":"s"} to review.`:"Current evidence is within thresholds."}</small></div><label>Approved by<input data-reconciliation-signer value="${esc(signoff.name||publication().publisherName||"")}" placeholder="Publisher or reviewer"></label><button type="button" data-reconciliation-approve ${!assessment.summary.sourceCount?"disabled":""}>${assessment.signed?"Approve again":"Approve current evidence"}</button></div>`;}
    function openDependency(index){const item=report?.manifest?.dependencies?.[index];if(!item)return;dialog.close();if(item.objectId)ctx.focusObject?.(item.pageId,item.objectId,item.kind);else if(item.sourceId)ctx.focusSource?.(item.sourceId);else ctx.openDiagnostics?.();}
    function refreshReport(){report=readiness(model());if(!dialog)return;dialog.querySelector('[data-blockers]').textContent=report.blockers;dialog.querySelector('[data-warnings]').textContent=report.warnings;dialog.querySelector('[data-passes]').textContent=report.passes;dialog.querySelector('[data-checks]').innerHTML=report.checks.map(item=>`<div class="publish-check ${item.level}"><span class="publish-check-icon">${item.level==="pass"?"✓":item.level==="warning"?"!":"×"}</span><div><b>${esc(item.title)}</b><small>${esc(item.detail)}</small></div>${item.action?`<button type="button" data-publish-repair="${esc(item.action)}">${item.action==="publisher"||item.action==="freshness"?"Add details":item.action==="pages"?"Review pages":"Open diagnostics"}</button>`:""}</div>`).join("");dialog.querySelector('[data-compatibility-manifest]').innerHTML=renderManifest(report.manifest);const assessment=reconciliationAssessment(model());dialog.querySelector('[data-reconciliation-summary]').innerHTML=renderReconciliation(assessment);dialog.querySelector('[data-reconciliation-approval]').innerHTML=renderReconciliationApproval(assessment);const state=dialog.querySelector('[data-viewer-state]'),stale=publication().viewerCompatibility?.status==="stale";state.textContent=stale?"Retest required":report.blockers?"Not ready":report.warnings?"Compatible with warnings":"Ready for Viewer";state.dataset.state=report.blockers?"blocker":stale||report.warnings?"warning":"pass";}
    function repair(action){if(action==="publisher"||action==="freshness"){showStep(1);requestAnimationFrame(()=>dialog.querySelector(action==="publisher"?'[data-publisher-name]':'[data-freshness]')?.focus());return;}dialog.close();if(action==="pages")ctx.openPages?.();else ctx.openDiagnostics?.();}
    function showStep(next){saveMetadata();step=Math.max(0,Math.min(3,next));if(step===0)refreshReport();dialog.querySelectorAll("[data-publish-step]").forEach((node,index)=>node.classList.toggle("active",index===step));dialog.querySelectorAll("[data-publish-nav]").forEach((node,index)=>{node.classList.toggle("active",index===step);node.setAttribute("aria-current",index===step?"step":"false");});dialog.querySelector('[data-back]').disabled=step===0;dialog.querySelector('[data-next]').hidden=step===3;}
    function compatibilityRecord(testedUtc="",tested=false){const previous=publication().viewerCompatibility||{},fingerprint=compatibilityFingerprint(model()),baseStatus=report?.blockers?"blocked":report?.warnings?"warnings":"passed",validPrevious=!!testedUtc&&previous.fingerprint===fingerprint;return{status:tested?baseStatus:testedUtc?(validPrevious?baseStatus:"stale"):"not-tested",testedUtc,issues:(report?.checks||[]).filter(item=>item.level!=="pass").map(item=>item.title),requiredViewerVersion:viewerContract.version,documentVersion:viewerContract.documentVersion,manifest:report?.manifest||dependencyManifest(model()),fingerprint:tested?fingerprint:previous.fingerprint||"",currentFingerprint:fingerprint,...(!tested&&testedUtc&&!validPrevious?{previousStatus:previous.status||"not-tested",staleUtc:previous.staleUtc||new Date().toISOString()}: {})};}
    function markPublished(target){saveMetadata();const meta=publication();meta.publishedUtc=new Date().toISOString();meta.lastTarget=target;meta.viewerCompatibility=compatibilityRecord(meta.viewerCompatibility?.testedUtc||"",false);ctx.changed();}
    function publicationPayload(){const meta=publication(),roles=window.CanvasTheme?.roles?.(model().settings?.theme)||model().settings?.theme?.roles||{};return{...meta,reportName:model().name,reconciliation:reconciliationSummary(model()),themeSurface:roles.surface||"#ffffff",themeText:roles.text||"#182230",themeGrid:roles.grid||"#cbd5e1",themeAccent:roles.accent||"#4f6ee8",themeOnAccent:roles.onAccent||"#ffffff"};}
    async function publish(target){refreshReport();if(report.blockers){showStep(0);ctx.status("Resolve the publish blockers before sharing this Qanvas.");return;}markPublished(target);const publicationLayout=publication().exportLayout||"footer",details=publicationPayload();if(target==="viewer")ctx.post("saveAs",{document:ctx.document()});else if(target==="pdf")ctx.post("exportPdf",{name:model().name,publicationLayout,publication:details});else if(target==="powerpoint"){const pages=(model().pages||[]).map((item,index)=>({item,index})).filter(entry=>entry.item.hidden!==true);ctx.post("exportPowerPoint",{name:model().name,pageIndex:ctx.pageIndex?.()||0,pages:pages.map(entry=>entry.item.name),pageIndexes:pages.map(entry=>entry.index),publicationLayout,publication:details});}else if(target==="web"){const id=dialog.querySelector('[data-web-profile]').value,definition=(model().webExports||[]).find(item=>item.id===id);if(!definition){window.openWebExportSettings?.("export");return;}try{ctx.status("Loading complete data for publish…");await ctx.ensureCompleteData?.();ctx.post("exportWebpage",{document:ctx.document(),definition});}catch(error){ctx.status(`Publish failed: ${error.message}`);return;}}ctx.status(`Publishing ${model().name}…`);}
    function testViewer(){refreshReport();publication().viewerCompatibility=compatibilityRecord(new Date().toISOString(),true);ctx.changed();dialog.close();ctx.preview();}
    function open(){
      if(ctx.canEdit&&!ctx.canEdit())return;
      if(dialog){dialog.showModal();return;}const meta=publication();report=readiness(model());dialog=document.createElement("dialog");dialog.className="publish-dialog";
      dialog.innerHTML=`<div class="publish-shell"><header class="publish-heading"><div><h2>Publish Qanvas</h2><p>Check, identify, test and share with confidence.</p></div><button type="button" data-close aria-label="Close">×</button></header><div class="publish-main"><nav class="publish-steps" aria-label="Publish steps">${["Readiness","Publisher & data","Viewer test","Publish"].map((name,index)=>`<button type="button" data-publish-nav><span class="publish-step-number">${index+1}</span><span>${name}</span></button>`).join("")}</nav><section class="publish-content">
      <div class="publish-panel" data-publish-step><h3>Publish readiness</h3><p class="publish-lead">Qvitr checks the recipient experience before anything is shared.</p><div class="publish-summary"><div><strong data-blockers>0</strong><small>Blockers</small></div><div><strong data-warnings>0</strong><small>Warnings</small></div><div><strong data-passes>0</strong><small>Passed checks</small></div></div><div class="publish-checks" data-checks></div></div>
      <div class="publish-panel" data-publish-step><h3>Publisher and data freshness</h3><p class="publish-lead">This information follows the report into Qvitr Viewer and exported webpages.</p><section class="publication-reconciliation" data-reconciliation-summary aria-label="Data reconciliation summary"></section><fieldset class="reconciliation-policy"><legend>Reconciliation thresholds</legend><label>Minimum row coverage (%)<input type="number" min="0" max="100" step="0.1" data-reconciliation-coverage value="${esc(meta.reconciliationPolicy?.minimumCoverage??100)}"></label><label>Maximum row gap<input type="number" min="0" step="1" data-reconciliation-gap value="${esc(meta.reconciliationPolicy?.maximumRowGap??0)}"></label><label>Maximum refresh spread (hours)<input type="number" min="0" step="1" data-reconciliation-spread value="${esc(meta.reconciliationPolicy?.maximumSpreadHours??24)}"></label><label>When exceeded<select data-reconciliation-enforcement><option value="review"${meta.reconciliationPolicy?.enforcement!=="block"?" selected":""}>Require review</option><option value="block"${meta.reconciliationPolicy?.enforcement==="block"?" selected":""}>Block publishing</option></select></label><label class="reconciliation-require"><input type="checkbox" data-reconciliation-require-signoff ${meta.reconciliationPolicy?.requireSignoff?"checked":""}> Require reconciliation sign-off before publishing</label></fieldset><section class="reconciliation-approval" data-reconciliation-approval aria-label="Reconciliation approval"></section><div class="publish-fields"><label>Publisher name<input data-publisher-name value="${esc(meta.publisherName)}" placeholder="Team or report owner"></label><label>Contact<input data-publisher-contact value="${esc(meta.publisherContact)}" placeholder="Email or support channel"></label><label>Data is current as of<input type="datetime-local" data-freshness value="${esc(localInput(meta.dataFreshnessUtc||deriveFreshness(model())))}"></label><label>Last published<input value="${esc(displayDate(meta.publishedUtc))}" readonly></label><label class="wide">Recipient note<textarea rows="4" data-publisher-notes placeholder="Scope, caveats or refresh guidance">${esc(meta.notes)}</textarea></label><fieldset class="publication-protection wide"><legend>File protection</legend><label><input type="checkbox" data-protect-qanvas ${meta.protection?.mode==="protected"?"checked":""}> Protect the shared .qanvas from design changes</label><textarea rows="4" data-protection-note placeholder="Optional reason or editing guidance">${esc(meta.protection?.note||"")}</textarea><small>This prevents accidental editing in Qvitr. It is not encryption or tamper-proof signing.</small></fieldset></div><p class="publish-hint">Freshness defaults to the oldest recorded source refresh, because that is the safest statement about the complete report.</p></div>
      <div class="publish-panel" data-publish-step><h3>Viewer compatibility test</h3><p class="publish-lead">Open the exact locked, interactive experience a free Viewer recipient will receive.</p><div class="viewer-test-card"><div><h4 data-viewer-state>Ready for Viewer</h4><p>Buttons, filters, parameters, scrolling and declared App actions remain interactive. Design controls stay locked.</p></div><button type="button" class="primary" data-test-viewer>Open Viewer test</button></div><section class="viewer-dependency-manifest" data-compatibility-manifest aria-label="Viewer dependency manifest"></section><p class="publish-hint">After checking the report, leave presentation mode and open Publish again. The test date and dependency manifest are stored with the Qanvas.</p></div>
      <div class="publish-panel" data-publish-step><h3>Choose how to share</h3><p class="publish-lead">Every target uses the same checked report and publication information.</p><label class="publication-export-layout">Publication details in PDF and PowerPoint<select data-publication-layout><option value="footer"${(meta.exportLayout||"footer")==="footer"?" selected":""}>Compact footer on every page</option><option value="cover"${meta.exportLayout==="cover"?" selected":""}>Dedicated cover page</option><option value="none"${meta.exportLayout==="none"?" selected":""}>Do not print details</option></select><small>Viewer files and webpages always retain the publication information.</small></label><div class="publish-targets"><article class="publish-target"><div><h4>Qvitr Viewer file</h4><p>Save a portable .qanvas file for the free Viewer.</p></div><button type="button" class="primary" data-publish-target="viewer">Save Viewer file…</button></article><article class="publish-target"><div><h4>Web page</h4><p>Publish a self-contained or folder-based web report.</p></div><select data-web-profile aria-label="Web export profile">${(model().webExports||[]).map(item=>`<option value="${esc(item.id)}">${esc(item.name)}</option>`).join("")}<option value="">Configure export…</option></select><button type="button" data-publish-target="web">Publish web page</button></article><article class="publish-target"><div><h4>PDF</h4><p>Create a fixed report for printing and archival.</p></div><button type="button" data-publish-target="pdf">Export PDF…</button></article><article class="publish-target"><div><h4>PowerPoint</h4><p>Send visible pages to a presentation deck.</p></div><button type="button" data-publish-target="powerpoint">Export PowerPoint…</button></article></div></div>
      </section></div><footer class="publish-footer"><small>Publication details are saved in the Qanvas document.</small><div><button type="button" data-back>Back</button><button type="button" class="primary" data-next>Next</button></div></footer></div>`;
      document.body.append(dialog);dialog.querySelector('[data-close]').onclick=()=>dialog.close();dialog.querySelector('[data-checks]').onclick=event=>{const action=event.target.closest('[data-publish-repair]')?.dataset.publishRepair;if(action)repair(action);};dialog.querySelector('[data-compatibility-manifest]').onclick=event=>{const index=event.target.closest('[data-manifest-dependency]')?.dataset.manifestDependency;if(index!==undefined)openDependency(+index);};dialog.querySelector('[data-reconciliation-approval]').onclick=event=>{if(!event.target.closest('[data-reconciliation-approve]'))return;saveMetadata();const assessment=reconciliationAssessment(model()),name=dialog.querySelector('[data-reconciliation-signer]').value.trim()||publication().publisherName||"Publisher";publication().reconciliationSignoff={name,approvedUtc:new Date().toISOString(),fingerprint:assessment.fingerprint,status:assessment.breaches.length?"exception-approved":"approved",breaches:assessment.breaches};ctx.changed();refreshReport();};dialog.querySelector('.reconciliation-policy').addEventListener('change',()=>{saveMetadata();refreshReport();});dialog.addEventListener("close",()=>saveMetadata());dialog.querySelectorAll('[data-publish-nav]').forEach((node,index)=>node.onclick=()=>showStep(index));dialog.querySelector('[data-back]').onclick=()=>showStep(step-1);dialog.querySelector('[data-next]').onclick=()=>showStep(step+1);dialog.querySelector('[data-test-viewer]').onclick=testViewer;dialog.querySelectorAll('[data-publish-target]').forEach(node=>node.onclick=()=>publish(node.dataset.publishTarget));showStep(0);dialog.showModal();
    }
    button?.addEventListener("click",event=>{event.preventDefault();event.stopPropagation();exportMenu?.classList.add("hidden");open();});
    let viewerHome=null,viewerHomeShown="";
    function viewerManifest(){const current=model(),visible=(current.pages||[]).filter(page=>page.hidden!==true),sources=(current.sources||[]).filter(source=>sourceConfigured(source)),objects=visible.flatMap(page=>[...(page.tiles||[]),...(page.graphics||[])]),interactive=objects.filter(item=>["app","html","gantt","reportGrid","valueSelector","visualFilter","pageLink"].includes(item.kind)).length,authSources=sources.filter(source=>{const text=String(source.query?.queryText||"");return !!(source.query?.authenticationProfileId||source.webApi?.authenticationProfileId||/authentication(profile)?id|authprofile/i.test(text));}).length,snapshots=sources.filter(source=>source.localTable?.storage||source.query?.savedDataMode==="full"||source.query?.savedDataMode==="preview").length;return{pages:visible.length,sources:sources.length,objects:objects.length,interactive,authSources,snapshots};}
    function ensureViewerHome(){
      if(viewerHome?.isConnected)return viewerHome;
      viewerHome=document.createElement("dialog");viewerHome.className="viewer-home-dialog";viewerHome.innerHTML='<div class="viewer-home-shell"><header><div><p>Qvitr Viewer · Free</p><h2 data-viewer-home-title></h2><span data-viewer-home-status></span></div><button type="button" data-viewer-home-close aria-label="Close report information">×</button></header><section class="viewer-home-summary"><article><span>Published by</span><strong data-viewer-home-publisher></strong><small data-viewer-home-contact></small></article><article><span>Data current as of</span><strong data-viewer-home-freshness></strong><small data-viewer-home-published></small></article><article><span>Viewer compatibility</span><strong data-viewer-home-compatibility></strong><small data-viewer-home-tested></small></article></section><section class="viewer-home-body"><div><h3>About this report</h3><p data-viewer-home-note></p><h3>Recipient guidance</h3><p data-viewer-home-guidance></p></div><aside><h3>Portable report contents</h3><dl data-viewer-home-manifest></dl><h3>Data reconciliation</h3><dl data-viewer-home-reconciliation></dl></aside></section><footer><span>Design controls stay locked. Report interactions remain available.</span><div><div class="viewer-home-file-actions" data-viewer-home-file-actions></div><button type="button" data-viewer-home-diagnostics>Export diagnostics…</button><button type="button" class="primary" data-viewer-home-open>Open report</button></div></footer></div>';document.body.append(viewerHome);
      viewerHome.querySelectorAll("[data-viewer-home-close],[data-viewer-home-open]").forEach(node=>node.onclick=()=>viewerHome.close());viewerHome.querySelector("[data-viewer-home-diagnostics]").onclick=()=>ctx.post("exportViewerDiagnostics",{name:model().name||"Qvitr-report",report:viewerDiagnostics(model())});return viewerHome;
    }
    function addAvailableActions(home){const body=home.querySelector(".viewer-home-body>div"),footerActions=home.querySelector("[data-viewer-home-file-actions]"),current=model(),access=globalThis.QvitrDocumentAccess?.policy?.()||{},manifest=dependencyManifest(current),protection=current.publication?.protection||{mode:"editable"};let section=body.querySelector("[data-viewer-home-actions]");if(!section){section=document.createElement("section");section.dataset.viewerHomeActions="";body.append(section);}const sourceGuidance=manifest.dependencies.filter(item=>item.kind==="source").map(item=>`<li><b>${esc(item.name)} (${esc(item.sourceType||"Source")})</b><span>${esc(item.recipientAction||item.detail)}</span></li>`).join(""),action=access.documentProtected?'<button type="button" data-create-editable-copy>Create editable copy…</button>':access.useWithoutEditing?'<button type="button" data-exit-safe-session>Exit use without editing</button>':access.canEdit?'<button type="button" data-start-safe-session>Use without editing</button>':"";section.innerHTML=`<h3>Available actions</h3><p><b>${protection.mode==="protected"?"Protected by publisher":"Editable file"}</b>${protection.note?` · ${esc(protection.note)}`:""}</p><h3>Connection and sign-in guidance</h3><ul class="viewer-source-guidance">${sourceGuidance||"<li>No data connection is required.</li>"}</ul>`;footerActions.innerHTML=action;footerActions.querySelector("[data-create-editable-copy]")?.addEventListener("click",()=>globalThis.QvitrDocumentAccess?.createEditableCopy?.());footerActions.querySelector("[data-start-safe-session]")?.addEventListener("click",()=>{home.close();globalThis.QvitrDocumentAccess?.setUseWithoutEditing?.(true);});footerActions.querySelector("[data-exit-safe-session]")?.addEventListener("click",()=>{home.close();globalThis.QvitrDocumentAccess?.setUseWithoutEditing?.(false);});}
    function openViewerHome(){const current=model(),meta=current.publication||{},manifest=viewerManifest(),assessment=reconciliationAssessment(current),reconciliation=assessment.summary,home=ensureViewerHome(),compatibility=meta.viewerCompatibility||{},status=compatibility.status||"not-tested";home.querySelector("[data-viewer-home-title]").textContent=current.name||"Report";home.querySelector("[data-viewer-home-status]").textContent=meta.publishedUtc?`Published ${displayDate(meta.publishedUtc)}`:"Shared Qanvas report";home.querySelector("[data-viewer-home-publisher]").textContent=meta.publisherName||"Publisher not recorded";home.querySelector("[data-viewer-home-contact]").textContent=meta.publisherContact||"No support contact recorded";home.querySelector("[data-viewer-home-freshness]").textContent=meta.dataFreshnessUtc?displayDate(meta.dataFreshnessUtc):"Not recorded";home.querySelector("[data-viewer-home-published]").textContent=meta.publishedUtc?`File published ${displayDate(meta.publishedUtc)}`:"Publish date not recorded";home.querySelector("[data-viewer-home-compatibility]").textContent=status==="passed"?"Tested and ready":status==="warnings"?"Ready with warnings":status==="blocked"?"Compatibility issues":"Not tested";home.querySelector("[data-viewer-home-compatibility]").dataset.state=status;home.querySelector("[data-viewer-home-tested]").textContent=compatibility.testedUtc?`Tested ${displayDate(compatibility.testedUtc)}`:"No Viewer test date";home.querySelector("[data-viewer-home-note]").textContent=meta.notes||"No additional message was supplied by the publisher.";home.querySelector("[data-viewer-home-guidance]").textContent=!manifest.sources?"This Qanvas is document-only and does not require a data source.":manifest.authSources?`${manifest.authSources} source${manifest.authSources===1?" uses":"s use"} protected connections. Qvitr will ask you to sign in only when an update needs it.`:"The shared snapshot opens without the author's connection. Refresh options depend on the connections available to this Windows user.";home.querySelector("[data-viewer-home-manifest]").innerHTML=`<div><dt>Visible pages</dt><dd>${manifest.pages}</dd></div><div><dt>Data sources</dt><dd>${manifest.sources}</dd></div><div><dt>Saved snapshots</dt><dd>${manifest.sources?`${manifest.snapshots}/${manifest.sources}`:"Not required"}</dd></div><div><dt>Interactive objects</dt><dd>${manifest.interactive}</dd></div>`;home.querySelector("[data-viewer-home-reconciliation]").innerHTML=!reconciliation.sourceCount?`<div><dt>Status</dt><dd>Not applicable</dd></div>`:`<div><dt>Threshold status</dt><dd>${assessment.status==="passed"?"Passed":assessment.status==="blocked"?"Blocked":"Review"}</dd></div><div><dt>Approval</dt><dd>${assessment.signed?`${esc(assessment.signoff.name||"Publisher")} · ${esc(displayDate(assessment.signoff.approvedUtc))}`:assessment.policy.requireSignoff?"Required":"Not required"}</dd></div><div><dt>Row coverage</dt><dd>${Math.round(reconciliation.coverage*100)}%</dd></div><div><dt>Saved rows</dt><dd>${reconciliation.totalLoaded.toLocaleString()} / ${reconciliation.totalExpected.toLocaleString()}</dd></div><div><dt>Complete sources</dt><dd>${reconciliation.counts.complete}/${reconciliation.sourceCount}</dd></div><div><dt>Row gap</dt><dd>${reconciliation.difference.toLocaleString()}</dd></div><div><dt>Refresh range</dt><dd>${reconciliation.oldestUtc?`${displayDate(reconciliation.oldestUtc)} – ${displayDate(reconciliation.newestUtc)}`:"Not recorded"}</dd></div>`;home.showModal();}
    const addPresentationInfo=()=>{const header=document.querySelector("#presentationHeader"),title=header?.querySelector(".presentation-title");if(!title||title.querySelector(".publication-info"))return;const meta=model().publication||{},parts=[];if(!ctx.canEdit?.())parts.push("Qvitr Viewer · Free");if(meta.dataFreshnessUtc)parts.push(`Data updated ${displayDate(meta.dataFreshnessUtc)}`);if(meta.publisherName)parts.push(`Published by ${meta.publisherName}`);if(!parts.length)return;const info=document.createElement("small");info.className="publication-info";info.textContent=parts.join(" · ");info.title=[meta.publisherContact,meta.notes].filter(Boolean).join("\n");title.append(info);if(!ctx.canEdit?.()){const actions=header.querySelector(".presentation-actions"),button=document.createElement("button");button.type="button";button.className="viewer-report-info";button.textContent="Report info";button.title="Publisher, freshness and portable report details";button.onclick=openViewerHome;actions?.prepend(button);const key=`${model().name||"Report"}|${meta.publishedUtc||"unpublished"}`;if(viewerHomeShown!==key){viewerHomeShown=key;requestAnimationFrame(openViewerHome);}}};
    const openViewerHomeWithoutActions=openViewerHome;
    openViewerHome=()=>{const home=ensureViewerHome();addAvailableActions(home);return openViewerHomeWithoutActions();};
    if(reportInfoButton)reportInfoButton.onclick=()=>{exportMenu?.classList.add("hidden");openViewerHome();};
    new MutationObserver(addPresentationInfo).observe(document.body,{childList:true});
    return{open,readiness:()=>readiness(model())};
  }};
})();
