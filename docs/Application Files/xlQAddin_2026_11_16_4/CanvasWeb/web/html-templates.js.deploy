(() => {
  const commonCss = `
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font:14px/1.45 Inter,"Segoe UI",sans-serif;color:var(--qanvas-text);background:var(--qanvas-surface)}body{padding:18px}main{display:grid;gap:16px;max-width:1500px;margin:auto}.hero{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.hero h1{margin:0;font-size:clamp(22px,3vw,36px);line-height:1.08}.hero p{margin:6px 0 0;color:color-mix(in srgb,var(--qanvas-text) 62%,transparent)}.badge{padding:6px 10px;border:1px solid var(--qanvas-grid);border-radius:999px;background:color-mix(in srgb,var(--qanvas-accent) 10%,var(--qanvas-surface));color:var(--qanvas-accent);font-size:12px;font-weight:750;white-space:nowrap}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}.card,.panel{border:1px solid var(--qanvas-grid);border-radius:14px;background:color-mix(in srgb,var(--qanvas-surface) 96%,var(--qanvas-accent));box-shadow:0 8px 26px color-mix(in srgb,var(--qanvas-text) 8%,transparent)}.card{padding:14px}.card small{display:block;color:color-mix(in srgb,var(--qanvas-text) 58%,transparent);font-weight:650}.card strong{display:block;margin-top:4px;font-size:20px;overflow-wrap:anywhere}.panel{padding:14px;min-width:0}.panel>header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.panel h2{margin:0;font-size:16px}input,select,button{min-height:36px;padding:7px 10px;border:1px solid var(--qanvas-grid);border-radius:8px;background:var(--qanvas-surface);color:var(--qanvas-text);font:inherit}input{min-width:170px}button{cursor:pointer}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}th,td{padding:9px 10px;border-bottom:1px solid color-mix(in srgb,var(--qanvas-grid) 72%,transparent);text-align:left;white-space:nowrap}th{position:sticky;top:0;z-index:1;background:color-mix(in srgb,var(--qanvas-surface) 88%,var(--qanvas-accent));font-size:11px;text-transform:uppercase;letter-spacing:.04em}.table-wrap{max-width:100%;overflow:auto;border:1px solid var(--qanvas-grid);border-radius:10px}.muted{color:color-mix(in srgb,var(--qanvas-text) 55%,transparent)}.empty{padding:35px;text-align:center;color:color-mix(in srgb,var(--qanvas-text) 60%,transparent)}@media(max-width:640px){body{padding:12px}.hero{display:grid}.panel>header{align-items:stretch;flex-direction:column}.panel>header :is(input,select){width:100%}}
`;
  const shell = (id, title, subtitle, body, script, extraCss = "") => `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="qanvas-template" content="${id}"><title>${title}</title><style>${commonCss}${extraCss}</style></head><body><main><section class="hero"><div><h1 id="title">${title}</h1><p>${subtitle}</p></div><span class="badge" id="badge">Live source</span></section>${body}</main><script>(()=>{${script}})();<\/script></body></html>`;

  const sourceProfile = () => shell("source-profile", "Source profile", "Completeness, descriptive statistics and distributions for the selected source.", `
<section class="cards" id="summary"></section>
<section class="panel"><header><h2>Column distribution</h2><select id="distributionColumn" aria-label="Distribution column"></select></header><div id="distribution" class="distribution"></div></section>
<section class="panel"><header><div><h2>Column statistics</h2><small class="muted">Statistics use the rows currently available to this HTML tile.</small></div><input id="search" type="search" placeholder="Find a column"></header><div class="table-wrap"><table><thead><tr><th>Column</th><th>Type</th><th>Null</th><th>Complete</th><th>Unique</th><th>Average</th><th>Low</th><th>High</th><th>Median</th><th>Mode</th></tr></thead><tbody id="columns"></tbody></table></div></section>`, `
const summary=document.querySelector('#summary'),body=document.querySelector('#columns'),picker=document.querySelector('#distributionColumn'),chart=document.querySelector('#distribution'),search=document.querySelector('#search'),fmt=new Intl.NumberFormat(undefined,{maximumFractionDigits:2});let source=null,profiles=[];const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));const blank=value=>value===null||value===undefined||value==='';const number=value=>{if(typeof value==='number')return Number.isFinite(value)?value:null;if(typeof value!=='string'||!value.trim())return null;const normalized=value.trim().replace(/\s/g,'').replace(',','.');const parsed=Number(normalized);return Number.isFinite(parsed)?parsed:null};const mode=values=>{const counts=new Map();values.forEach(value=>{const key=String(value);counts.set(key,(counts.get(key)||0)+1)});return [...counts].sort((a,b)=>b[1]-a[1])[0]?.[0]??''};const profile=(name,type,index)=>{const all=(source.rows||[]).map(row=>row?.[index]),values=all.filter(value=>!blank(value)),numbers=values.map(number).filter(value=>value!==null),numeric=numbers.length>0&&numbers.length>=values.length*.8,sorted=numeric?[...numbers].sort((a,b)=>a-b):[];return{name,type:type||typeof values[0]||'Unknown',index,all,values,numbers,numeric,nulls:all.length-values.length,unique:new Set(values.map(String)).size,average:numeric?numbers.reduce((a,b)=>a+b,0)/numbers.length:null,low:numeric?sorted[0]:values.map(String).sort()[0],high:numeric?sorted.at(-1):values.map(String).sort().at(-1),median:numeric?(sorted.length%2?sorted[(sorted.length-1)/2]:(sorted[sorted.length/2-1]+sorted[sorted.length/2])/2):null,mode:mode(values)}};const value=value=>value===null||value===undefined||value===''?'—':typeof value==='number'?fmt.format(value):esc(value);const drawTable=()=>{const term=search.value.trim().toLowerCase();body.innerHTML=profiles.filter(item=>!term||item.name.toLowerCase().includes(term)).map(item=>'<tr><td><strong>'+esc(item.name)+'</strong></td><td>'+esc(item.type)+'</td><td>'+fmt.format(item.nulls)+' <span class="muted">('+fmt.format(item.all.length?item.nulls/item.all.length*100:0)+'%)</span></td><td>'+fmt.format(item.all.length-item.nulls)+'</td><td>'+fmt.format(item.unique)+'</td><td>'+value(item.average)+'</td><td>'+value(item.low)+'</td><td>'+value(item.high)+'</td><td>'+value(item.median)+'</td><td>'+value(item.mode)+'</td></tr>').join('')||'<tr><td colspan="10" class="empty">No matching columns</td></tr>'};const drawDistribution=()=>{const item=profiles[picker.selectedIndex]||profiles[0];if(!item){chart.innerHTML='<div class="empty">No columns available</div>';return}let entries=[];if(item.numeric&&item.numbers.length){const min=Math.min(...item.numbers),max=Math.max(...item.numbers),count=Math.min(12,Math.max(4,Math.ceil(Math.sqrt(item.numbers.length)))),step=(max-min)/count||1,bins=Array.from({length:count},(_,index)=>({label:fmt.format(min+step*index)+' – '+fmt.format(min+step*(index+1)),count:0}));item.numbers.forEach(number=>bins[Math.min(count-1,Math.floor((number-min)/step))].count++);entries=bins}else{const counts=new Map();item.values.forEach(value=>counts.set(String(value),(counts.get(String(value))||0)+1));entries=[...counts].sort((a,b)=>b[1]-a[1]).slice(0,14).map(([label,count])=>({label,count}))}const maxCount=Math.max(1,...entries.map(entry=>entry.count));chart.innerHTML=entries.map(entry=>'<div class="bar-row"><span title="'+esc(entry.label)+'">'+esc(entry.label)+'</span><i style="--size:'+entry.count/maxCount*100+'%"></i><b>'+fmt.format(entry.count)+'</b></div>').join('')||'<div class="empty">No values in this column</div>'};const render=payload=>{source=payload?.source||payload?.sourceList?.[0];if(!source)return;document.querySelector('#title').textContent=(source.name||'Source')+' profile';document.querySelector('#badge').textContent=source.truncated?'Sampled rows':'Live source';const rows=source.rows||[],columns=source.columns||[],types=source.types||[];profiles=columns.map((name,index)=>profile(name,types[index],index));const nulls=profiles.reduce((sum,item)=>sum+item.nulls,0),cells=Math.max(1,rows.length*columns.length);summary.innerHTML=[['Source type',source.sourceType||'Query'],['Connection',source.connectionName||'Local / embedded'],['Rows',fmt.format(source.totalRows??rows.length)],['Loaded',fmt.format(rows.length)],['Columns',fmt.format(columns.length)],['Completeness',fmt.format((1-nulls/cells)*100)+'%'],['Last refresh',source.lastRefreshUtc?new Date(source.lastRefreshUtc).toLocaleString():'Not recorded']].map(item=>'<article class="card"><small>'+esc(item[0])+'</small><strong>'+esc(item[1])+'</strong></article>').join('');picker.innerHTML=profiles.map(item=>'<option>'+esc(item.name)+'</option>').join('');drawTable();drawDistribution()};picker.onchange=drawDistribution;search.oninput=drawTable;qanvas.init(render);qanvas.subscribe(render);
`, `.distribution{display:grid;gap:7px}.bar-row{display:grid;grid-template-columns:minmax(100px,220px) minmax(120px,1fr) 56px;align-items:center;gap:10px}.bar-row>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-row i{display:block;height:13px;border-radius:999px;background:linear-gradient(90deg,var(--qanvas-accent) var(--size),color-mix(in srgb,var(--qanvas-grid) 55%,transparent) var(--size));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--qanvas-grid) 65%,transparent)}.bar-row b{text-align:right;font-size:12px}@media(max-width:600px){.bar-row{grid-template-columns:100px 1fr 42px}}`);

  const recordExplorer = () => shell("record-explorer", "Record explorer", "Search and inspect the selected source without configuring a table tile.", `
<section class="cards" id="summary"></section><section class="panel"><header><h2>Records</h2><input id="search" type="search" placeholder="Search all columns"></header><div class="table-wrap"><table><thead id="head"></thead><tbody id="rows"></tbody></table></div><p class="muted" id="status"></p></section>`, `
const summary=document.querySelector('#summary'),head=document.querySelector('#head'),body=document.querySelector('#rows'),search=document.querySelector('#search'),status=document.querySelector('#status'),fmt=new Intl.NumberFormat();let source=null;const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));const draw=()=>{if(!source)return;const term=search.value.trim().toLowerCase(),columns=source.columns||[],matches=(source.rows||[]).filter(row=>!term||row.some(value=>String(value??'').toLowerCase().includes(term))),shown=matches.slice(0,250);head.innerHTML='<tr>'+columns.map(column=>'<th>'+esc(column)+'</th>').join('')+'</tr>';body.innerHTML=shown.map(row=>'<tr>'+columns.map((_,index)=>'<td>'+esc(row[index]??'')+'</td>').join('')+'</tr>').join('')||'<tr><td colspan="'+Math.max(1,columns.length)+'" class="empty">No matching records</td></tr>';status.textContent='Showing '+fmt.format(shown.length)+' of '+fmt.format(matches.length)+' matching loaded records'+(matches.length>shown.length?' · refine the search to see more':'')};const render=payload=>{source=payload?.source||payload?.sourceList?.[0];if(!source)return;document.querySelector('#title').textContent=source.name||'Record explorer';summary.innerHTML=[['Source type',source.sourceType||'Query'],['Connection',source.connectionName||'Local / embedded'],['Rows',fmt.format(source.totalRows??source.rows?.length??0)],['Columns',fmt.format(source.columns?.length??0)]].map(item=>'<article class="card"><small>'+esc(item[0])+'</small><strong>'+esc(item[1])+'</strong></article>').join('');draw()};search.oninput=draw;qanvas.init(render);qanvas.subscribe(render);
`);

  const kpiSnapshot = () => shell("kpi-snapshot", "Automatic KPI snapshot", "A compact overview generated from the numeric and categorical columns in the selected source.", `
<section class="cards" id="summary"></section><section class="kpi-grid" id="kpis"></section><section class="panel"><header><h2>Top categorical values</h2></header><div class="category-grid" id="categories"></div></section>`, `
const summary=document.querySelector('#summary'),kpis=document.querySelector('#kpis'),categories=document.querySelector('#categories'),fmt=new Intl.NumberFormat(undefined,{maximumFractionDigits:2});const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));const number=value=>{if(typeof value==='number')return Number.isFinite(value)?value:null;const parsed=Number(String(value??'').trim().replace(/\s/g,'').replace(',','.'));return Number.isFinite(parsed)?parsed:null};const render=payload=>{const source=payload?.source||payload?.sourceList?.[0];if(!source)return;document.querySelector('#title').textContent=(source.name||'Source')+' snapshot';const columns=source.columns||[],rows=source.rows||[];summary.innerHTML=[['Rows',fmt.format(source.totalRows??rows.length)],['Loaded',fmt.format(rows.length)],['Columns',fmt.format(columns.length)],['Connection',source.connectionName||'Local / embedded']].map(item=>'<article class="card"><small>'+esc(item[0])+'</small><strong>'+esc(item[1])+'</strong></article>').join('');const profiles=columns.map((name,index)=>{const values=rows.map(row=>row[index]).filter(value=>value!==null&&value!==undefined&&value!==''),numbers=values.map(number).filter(value=>value!==null);return{name,values,numbers,numeric:values.length>0&&numbers.length>=values.length*.8}});kpis.innerHTML=profiles.filter(item=>item.numeric).slice(0,12).map(item=>{const sum=item.numbers.reduce((a,b)=>a+b,0),avg=sum/item.numbers.length,min=Math.min(...item.numbers),max=Math.max(...item.numbers);return'<article class="kpi"><small>'+esc(item.name)+'</small><strong>'+fmt.format(avg)+'</strong><span>Average</span><footer><b>'+fmt.format(min)+'</b><i></i><b>'+fmt.format(max)+'</b></footer></article>'}).join('')||'<div class="panel empty">No numeric columns detected</div>';categories.innerHTML=profiles.filter(item=>!item.numeric&&item.values.length).slice(0,8).map(item=>{const counts=new Map();item.values.forEach(value=>counts.set(String(value),(counts.get(String(value))||0)+1));const top=[...counts].sort((a,b)=>b[1]-a[1]).slice(0,5),max=Math.max(1,...top.map(item=>item[1]));return'<article><h3>'+esc(item.name)+'</h3>'+top.map(([label,count])=>'<div><span>'+esc(label)+'</span><i style="--size:'+count/max*100+'%"></i><b>'+fmt.format(count)+'</b></div>').join('')+'</article>'}).join('')||'<div class="empty">No categorical columns detected</div>'};qanvas.init(render);qanvas.subscribe(render);
`, `.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}.kpi{padding:16px;border:1px solid var(--qanvas-grid);border-radius:14px;background:linear-gradient(145deg,color-mix(in srgb,var(--qanvas-accent) 13%,var(--qanvas-surface)),var(--qanvas-surface))}.kpi small,.kpi span{display:block;color:color-mix(in srgb,var(--qanvas-text) 58%,transparent)}.kpi strong{display:block;margin:8px 0 0;font-size:28px}.kpi footer{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;margin-top:14px;font-size:11px}.kpi footer i{height:4px;border-radius:9px;background:var(--qanvas-accent)}.category-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}.category-grid article h3{margin:0 0 9px}.category-grid article>div{display:grid;grid-template-columns:minmax(80px,1fr) minmax(80px,2fr) 45px;align-items:center;gap:7px;margin:6px 0}.category-grid span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.category-grid i{height:9px;border-radius:9px;background:linear-gradient(90deg,var(--qanvas-accent) var(--size),color-mix(in srgb,var(--qanvas-grid) 55%,transparent) var(--size))}.category-grid b{text-align:right;font-size:11px}`);

  const dataQualityMonitor = () => shell("data-quality-monitor", "Data quality monitor", "Find incomplete, duplicated, or suspicious source values before they reach a report.", `
<section class="cards" id="summary"></section><section class="quality-controls"><div class="quality-tabs" role="group" aria-label="Column quality filter"><button type="button" class="active" data-quality-filter="all">All columns</button><button type="button" data-quality-filter="review">Needs review</button><button type="button" data-quality-filter="critical">Critical only</button></div><span class="muted" id="columnCount"></span></section><section class="panel quality-panel"><div class="table-wrap"><table><thead><tr><th>Column</th><th>Detected type</th><th>Complete</th><th>Distinct</th><th>Issue</th></tr></thead><tbody id="qualityRows"></tbody></table></div></section>`, `
const summary=document.querySelector('#summary'),body=document.querySelector('#qualityRows'),count=document.querySelector('#columnCount'),fmt=new Intl.NumberFormat(),tabs=[...document.querySelectorAll('[data-quality-filter]')];let source=null,profiles=[],filter='all';const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));const blank=value=>value===null||value===undefined||String(value).trim()==='';const classify=(value,type)=>{const name=String(type||'').toLowerCase();if(name.includes('date'))return'Date';if(name.includes('bool'))return'Boolean';if(name.includes('int'))return'Integer';if(/double|decimal|single|number/.test(name))return'Decimal';if(typeof value==='boolean')return'Boolean';if(typeof value==='number')return Number.isInteger(value)?'Integer':'Decimal';return'Text'};const profile=(name,type,index)=>{const values=(source.rows||[]).map(row=>row?.[index]),present=values.filter(value=>!blank(value)),complete=values.length?present.length/values.length*100:100,distinct=new Set(present.map(value=>String(value))).size,detected=classify(present[0],type),numberShare=present.length?present.filter(value=>Number.isFinite(typeof value==='number'?value:Number(String(value).replace(',','.')))).length/present.length:0,dateShare=present.length?present.filter(value=>!Number.isNaN(Date.parse(String(value)))).length/present.length:0,mixed=(detected==='Decimal'||detected==='Integer')&&numberShare<.95||detected==='Date'&&dateShare<.95;let severity='healthy',issue='Healthy';if(mixed){severity='critical';issue='Mixed formats'}else if(complete<80){severity='critical';issue=fmt.format(values.length-present.length)+' blanks'}else if(complete<95){severity='review';issue=fmt.format(values.length-present.length)+' blanks'}else if(present.length-distinct>Math.max(10,present.length*.9)&&/id|key|code/i.test(name)){severity='review';issue='Possible duplicates'}return{name,detected,complete,distinct,severity,issue}};const draw=()=>{const shown=profiles.filter(item=>filter==='all'||item.severity===filter||(filter==='review'&&item.severity==='critical'));count.textContent=fmt.format(shown.length)+' columns';body.innerHTML=shown.map(item=>'<tr><td><strong>'+esc(item.name)+'</strong></td><td>'+esc(item.detected)+'</td><td><div class="complete"><div class="quality-meter"><i style="width:'+item.complete+'%"></i></div><span>'+item.complete.toFixed(item.complete===100?0:1)+'%</span></div></td><td>'+fmt.format(item.distinct)+'</td><td><span class="quality-status '+item.severity+'">'+esc(item.issue)+'</span></td></tr>').join('')||'<tr><td colspan="5" class="empty">No columns match this filter</td></tr>'};const render=payload=>{source=payload?.source||payload?.sourceList?.[0];if(!source)return;document.querySelector('#title').textContent=(source.name||'Source')+' quality';document.querySelector('#badge').textContent=(source.connectionName||source.sourceType||'Source')+' · refreshed '+(source.lastRefreshUtc?new Date(source.lastRefreshUtc).toLocaleString():'not recorded');profiles=(source.columns||[]).map((name,index)=>profile(name,source.types?.[index],index));const cells=Math.max(1,(source.rows?.length||0)*Math.max(1,profiles.length)),missing=profiles.reduce((total,item)=>total+Math.round((100-item.complete)/100*(source.rows?.length||0)),0),review=profiles.filter(item=>item.severity!=='healthy').length;summary.innerHTML=[['Rows checked',fmt.format(source.rows?.length||0),fmt.format(profiles.length)+' columns'],['Complete cells',((cells-missing)/cells*100).toFixed(1)+'%',fmt.format(missing)+' missing'],['Columns to review',fmt.format(review),'Below quality target']].map((item,index)=>'<article class="card"><small>'+item[0]+'</small><strong class="'+(index===2&&review?'attention':'')+'">'+item[1]+'</strong><span>'+item[2]+'</span></article>').join('');draw()};tabs.forEach(button=>button.onclick=()=>{filter=button.dataset.qualityFilter;tabs.forEach(item=>item.classList.toggle('active',item===button));draw()});qanvas.init(render);qanvas.subscribe(render);
`, `.quality-controls{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.quality-tabs{display:flex;gap:7px;flex-wrap:wrap}.quality-tabs button{border:1px solid var(--qanvas-grid);background:var(--qanvas-surface)}.quality-tabs button.active{background:var(--qanvas-text);color:var(--qanvas-surface);border-color:var(--qanvas-text)}.quality-panel{padding:0}.card span{display:block;margin-top:3px;color:color-mix(in srgb,var(--qanvas-text) 60%,transparent)}.card strong.attention{color:var(--qanvas-negative)}.complete{display:grid;grid-template-columns:minmax(90px,1fr) 58px;align-items:center;gap:9px}.quality-meter{height:8px;border-radius:999px;background:color-mix(in srgb,var(--qanvas-grid) 45%,transparent);overflow:hidden}.quality-meter i{display:block;height:100%;border-radius:inherit;background:var(--qanvas-positive)}.quality-status{display:inline-block;padding:5px 9px;border-radius:999px;background:color-mix(in srgb,var(--qanvas-positive) 14%,transparent);color:var(--qanvas-positive)}.quality-status.review{background:color-mix(in srgb,var(--qanvas-accent) 16%,transparent);color:var(--qanvas-accent)}.quality-status.critical{background:color-mix(in srgb,var(--qanvas-negative) 14%,transparent);color:var(--qanvas-negative)}@media(max-width:650px){.complete{grid-template-columns:1fr}.quality-panel th:nth-child(4),.quality-panel td:nth-child(4){display:none}}`);

  const sourceLineageAudit = () => shell("source-lineage-audit", "Source lineage & join audit", "Explain where a report gets its data and whether relationship keys cover the loaded rows.", `
<section class="lineage-layout"><article class="lineage-stage" id="lineageStage"><svg id="lineageLinks" aria-hidden="true"></svg><div class="lineage-hub"><small>Qanvas</small><strong id="reportName">Current report</strong><span id="visualCount">Live model</span></div><div id="sourceNodes"></div></article><aside class="panel lineage-inspector"><header><div><small class="eyebrow">Selected source</small><h2 id="selectedName">Choose a source</h2></div></header><div id="selectedDetails" class="lineage-details"></div></aside></section>`, `
const stage=document.querySelector('#lineageStage'),nodes=document.querySelector('#sourceNodes'),links=document.querySelector('#lineageLinks'),details=document.querySelector('#selectedDetails'),selectedName=document.querySelector('#selectedName'),fmt=new Intl.NumberFormat();let sources=[],relationships=[],selected='';const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));const sourceId=source=>String(source?.id||source?.sourceId||''),sourceRows=source=>source?.rows||[],fieldIndex=(source,name)=>(source?.columns||[]).findIndex(column=>String(column).toLowerCase()===String(name).toLowerCase());const linkAudit=relationship=>{const from=sources.find(source=>sourceId(source)===relationship.fromSourceId),to=sources.find(source=>sourceId(source)===relationship.toSourceId),keys=relationship.keys||[];if(!from||!to||!keys.length)return{coverage:null,message:'Relationship data is not loaded in this HTML tile.'};const left=keys.map(key=>fieldIndex(from,key.fromField)),right=keys.map(key=>fieldIndex(to,key.toField));if(left.some(index=>index<0)||right.some(index=>index<0))return{coverage:null,message:'One or more relationship columns are unavailable.'};const values=(row,indexes)=>JSON.stringify(indexes.map(index=>row?.[index]??null)),dimensionId=relationship.dimensionSourceId||relationship.toSourceId,fact=sourceId(from)===dimensionId?to:from,dimension=sourceId(from)===dimensionId?from:to,factIndexes=sourceId(from)===dimensionId?right:left,dimensionIndexes=sourceId(from)===dimensionId?left:right,known=new Set(sourceRows(dimension).map(row=>values(row,dimensionIndexes))),factRows=sourceRows(fact),missing=factRows.filter(row=>!known.has(values(row,factIndexes))).length,coverage=factRows.length?(factRows.length-missing)/factRows.length*100:100;return{coverage,missing,message:missing?fmt.format(missing)+' loaded fact rows do not match the dimension key.':'All loaded fact rows match the dimension key.'}};const drawLinks=()=>{const stageBox=stage.getBoundingClientRect();links.setAttribute('viewBox','0 0 '+stageBox.width+' '+stageBox.height);links.replaceChildren();relationships.forEach(relationship=>{const a=stage.querySelector('[data-source-id="'+CSS.escape(relationship.fromSourceId)+'"]'),b=stage.querySelector('[data-source-id="'+CSS.escape(relationship.toSourceId)+'"]');if(!a||!b)return;const ar=a.getBoundingClientRect(),br=b.getBoundingClientRect(),x1=ar.left-stageBox.left+ar.width/2,y1=ar.top-stageBox.top+ar.height/2,x2=br.left-stageBox.left+br.width/2,y2=br.top-stageBox.top+br.height/2,path=document.createElementNS('http://www.w3.org/2000/svg','path'),bend=Math.max(35,Math.abs(x2-x1)*.35);path.setAttribute('d','M '+x1+' '+y1+' C '+(x1+bend)+' '+y1+', '+(x2-bend)+' '+y2+', '+x2+' '+y2);links.append(path)})};const select=id=>{selected=id;nodes.querySelectorAll('[data-source-id]').forEach(node=>node.classList.toggle('active',node.dataset.sourceId===id));const source=sources.find(item=>sourceId(item)===id);if(!source)return;selectedName.textContent=source.name||id;const related=relationships.filter(item=>item.fromSourceId===id||item.toSourceId===id),audits=related.map(linkAudit),known=audits.filter(item=>item.coverage!==null),coverage=known.length?known.reduce((sum,item)=>sum+item.coverage,0)/known.length:null,warnings=audits.filter(item=>item.missing||item.coverage===null);details.innerHTML='<dl><div><dt>Connection</dt><dd>'+esc(source.connectionName||source.sourceType||'Local / embedded')+'</dd></div><div><dt>Rows</dt><dd>'+fmt.format(source.totalRows??source.rows?.length??0)+'</dd></div><div><dt>Refresh</dt><dd>'+(source.lastRefreshUtc?esc(new Date(source.lastRefreshUtc).toLocaleString()):'Not recorded')+'</dd></div><div><dt>Join coverage</dt><dd>'+(coverage===null?'Not available':coverage.toFixed(1)+'%')+'</dd></div></dl>'+(warnings.length?warnings.map(item=>'<p class="lineage-warning">⚠ '+esc(item.message)+'</p>').join(''):'<p class="lineage-ok">✓ Loaded relationship keys are covered.</p>')+'<h3>Relationships</h3><p class="muted">'+(related.length?related.map(item=>(item.keys||[]).map(key=>key.fromField+' ↔ '+key.toField).join(', ')).join('<br>'):'No relationships use this source.')+'</p>'};const render=payload=>{sources=payload?.sourceList?.length?payload.sourceList:payload?.sourceCatalog||[];relationships=(payload?.relationships||[]).filter(item=>item.enabled!==false&&item.active!==false);document.querySelector('#title').textContent=(payload?.context?.reportName||'Qanvas')+' lineage';document.querySelector('#badge').textContent=fmt.format(sources.length)+' sources · '+fmt.format(relationships.length)+' relationships';document.querySelector('#reportName').textContent=payload?.context?.reportName||'Current report';const radius=Math.min(38,Math.max(28,30+sources.length)),positions=sources.map((source,index)=>{const angle=(Math.PI*2*index/Math.max(1,sources.length))-Math.PI/2;return{x:50+Math.cos(angle)*radius,y:50+Math.sin(angle)*radius,source}});nodes.innerHTML=positions.map(item=>'<button type="button" class="source-node '+(sourceId(item.source)===selected?'active':'')+'" data-source-id="'+esc(sourceId(item.source))+'" style="left:'+item.x+'%;top:'+item.y+'%"><span class="source-icon">▦</span><strong>'+esc(item.source.name||sourceId(item.source))+'</strong><small>'+fmt.format(item.source.totalRows??item.source.rows?.length??0)+' rows</small></button>').join('');nodes.querySelectorAll('[data-source-id]').forEach(node=>node.onclick=()=>select(node.dataset.sourceId));if(!sources.some(item=>sourceId(item)===selected))selected=sourceId(sources[0]);select(selected);requestAnimationFrame(drawLinks)};addEventListener('resize',()=>requestAnimationFrame(drawLinks));qanvas.init(render);qanvas.subscribe(render);
`, `.lineage-layout{display:grid;grid-template-columns:minmax(430px,1.7fr) minmax(260px,.72fr);gap:14px;min-height:620px}.lineage-stage{position:relative;min-height:620px;border:1px solid var(--qanvas-grid);border-radius:16px;overflow:hidden;background-color:color-mix(in srgb,var(--qanvas-surface) 96%,var(--qanvas-accent));background-image:radial-gradient(color-mix(in srgb,var(--qanvas-grid) 55%,transparent) 1px,transparent 1px);background-size:22px 22px}.lineage-stage svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.lineage-stage path{fill:none;stroke:color-mix(in srgb,var(--qanvas-grid) 88%,var(--qanvas-accent));stroke-width:2}.source-node,.lineage-hub{position:absolute;transform:translate(-50%,-50%);display:grid;grid-template-columns:auto minmax(0,1fr);gap:2px 9px;align-items:center;padding:12px 14px;border:1px solid var(--qanvas-grid);border-radius:13px;background:var(--qanvas-surface);color:var(--qanvas-text);text-align:left;min-width:180px;box-shadow:0 8px 22px color-mix(in srgb,var(--qanvas-text) 9%,transparent)}.source-node{z-index:2}.source-node.active{border-color:var(--qanvas-accent);box-shadow:0 0 0 2px color-mix(in srgb,var(--qanvas-accent) 25%,transparent)}.source-node strong,.source-node small{grid-column:2}.source-node small,.lineage-hub span,.lineage-hub small{color:color-mix(in srgb,var(--qanvas-text) 60%,transparent)}.source-icon{grid-row:1/3;color:var(--qanvas-accent);font-size:20px}.lineage-hub{z-index:1;left:50%;top:50%;min-width:160px;background:color-mix(in srgb,var(--qanvas-accent) 10%,var(--qanvas-surface))}.lineage-hub>*{grid-column:1/3}.lineage-inspector header{display:block}.eyebrow{color:var(--qanvas-accent);font-weight:750;text-transform:uppercase;letter-spacing:.08em}.lineage-inspector h2{margin-top:8px;font-size:22px}.lineage-details{padding:14px}.lineage-details dl{display:grid;gap:9px;margin:0}.lineage-details dl>div{padding:11px;border-radius:10px;background:color-mix(in srgb,var(--qanvas-grid) 22%,transparent)}.lineage-details dt{color:color-mix(in srgb,var(--qanvas-text) 58%,transparent)}.lineage-details dd{margin:3px 0 0;font-weight:750}.lineage-warning,.lineage-ok{padding:11px;border-radius:10px}.lineage-warning{background:color-mix(in srgb,var(--qanvas-negative) 12%,transparent);color:var(--qanvas-negative)}.lineage-ok{background:color-mix(in srgb,var(--qanvas-positive) 12%,transparent);color:var(--qanvas-positive)}@media(max-width:850px){.lineage-layout{grid-template-columns:1fr}.lineage-stage{min-height:520px}.lineage-inspector{min-height:0}}@media(max-width:540px){.lineage-stage{min-height:600px}.source-node{min-width:140px;padding:9px}.lineage-hub{min-width:125px}}`);

  const combinedSourceProfile = () => shell("source-profile", "Source profile", "A compact source audit with column quality and validation rules.", `
<nav class="profile-tabs" aria-label="Source profile views"><button type="button" class="active" data-profile-view="overview">Compact audit</button><button type="button" data-profile-view="matrix">Column quality matrix</button><button type="button" data-profile-view="rules">Validation rule audit</button></nav>
<section data-profile-panel="overview"><section class="cards" id="profileSummary"></section><section class="profile-overview"><article class="panel health-panel"><header><div><small class="eyebrow">Overall source health</small><h2 id="healthLabel">Analysing source</h2></div><strong class="health-score" id="healthScore">—</strong></header><div class="health-track"><i id="healthMeter"></i></div><p class="muted" id="healthNote"></p></article><article class="panel"><header><h2>Priority review</h2><span class="muted" id="issueCount"></span></header><div class="issue-list" id="issueList"></div></article></section><section class="panel"><header><div><h2>Column overview</h2><small class="muted">Select a column for a compact statistical profile.</small></div><select id="profileColumn" aria-label="Column to inspect"></select></header><div class="column-detail" id="columnDetail"></div></section></section>
<section data-profile-panel="matrix" hidden><section class="panel matrix-panel"><header><div><h2>Column quality matrix</h2><small class="muted">Row count is shown in the source badge above. Colored badges make healthy, review and critical results easy to scan.</small></div><input id="matrixSearch" type="search" placeholder="Find a column"></header><div class="table-wrap"><table class="quality-matrix"><thead><tr><th title="The field name supplied by the selected source." data-tip="The field name supplied by the selected source.">Column</th><th title="The type declared by the source, or inferred from the available values." data-tip="The type declared by the source, or inferred from the available values.">Detected type</th><th title="Share and count of loaded rows containing a non-empty value." data-tip="Share and count of loaded rows containing a non-empty value.">Complete</th><th title="Share of populated values matching the detected data type." data-tip="Share of populated values matching the detected data type.">Valid type</th><th title="Share and count of populated values that are distinct. High is useful for identifiers; low can be correct for categories." data-tip="Share and count of populated values that are distinct. High is useful for identifiers; low can be correct for categories.">Unique</th><th title="Consistency of the value pattern in the loaded sample, such as date or text shape." data-tip="Consistency of the value pattern in the loaded sample, such as date or text shape.">Stable</th><th title="The most important quality observation detected for this column." data-tip="The most important quality observation detected for this column.">Finding</th></tr></thead><tbody id="matrixRows"></tbody></table></div></section></section>
<section data-profile-panel="rules" hidden><section class="cards" id="ruleSummary"></section><section class="panel"><header><div><h2>Validation rule audit</h2><small class="muted">A generated checklist based on type, completeness, identifier and range checks.</small></div><select id="ruleFilter" aria-label="Validation result filter"><option value="all">All checks</option><option value="failed">Needs attention</option><option value="passed">Passed</option></select></header><div class="rule-list" id="ruleList"></div></section></section>`, `
const summary=document.querySelector('#profileSummary'),issueList=document.querySelector('#issueList'),issueCount=document.querySelector('#issueCount'),picker=document.querySelector('#profileColumn'),detail=document.querySelector('#columnDetail'),matrixRows=document.querySelector('#matrixRows'),matrixSearch=document.querySelector('#matrixSearch'),ruleList=document.querySelector('#ruleList'),ruleFilter=document.querySelector('#ruleFilter'),ruleSummary=document.querySelector('#ruleSummary'),fmt=new Intl.NumberFormat(undefined,{maximumFractionDigits:2});let source=null,profiles=[],rules=[];const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));const blank=value=>value===null||value===undefined||String(value).trim()==='';const number=value=>{if(typeof value==='number')return Number.isFinite(value)?value:null;const parsed=Number(String(value??'').trim().replace(/\s/g,'').replace(',','.'));return Number.isFinite(parsed)?parsed:null};const declaredType=(type,value)=>{const name=String(type||'').toLowerCase();if(name.includes('date'))return'Date';if(name.includes('bool'))return'Boolean';if(name.includes('int'))return'Integer';if(/double|decimal|single|number/.test(name))return'Decimal';if(typeof value==='boolean')return'Boolean';if(typeof value==='number')return Number.isInteger(value)?'Integer':'Decimal';if(value&&!Number.isNaN(Date.parse(String(value)))&&/[\-/:]/.test(String(value)))return'Date';return'Text'};const valid=(value,type)=>{if(blank(value))return true;if(type==='Boolean')return typeof value==='boolean'||/^(true|false|0|1|yes|no)$/i.test(String(value));if(type==='Integer')return Number.isInteger(number(value));if(type==='Decimal')return number(value)!==null;if(type==='Date')return!Number.isNaN(Date.parse(String(value)));return true};const shape=value=>String(value??'').trim().replace(/[A-Za-zÆØÅæøå]/g,'A').replace(/[0-9]/g,'9').replace(/\s+/g,' ');const mode=values=>{const counts=new Map();values.forEach(value=>counts.set(String(value),(counts.get(String(value))||0)+1));return[...counts].sort((a,b)=>b[1]-a[1])[0]?.[0]??'—'};const profile=(name,type,index)=>{const all=(source.rows||[]).map(row=>row?.[index]),values=all.filter(value=>!blank(value)),detected=declaredType(type,values[0]),validCount=values.filter(value=>valid(value,detected)).length,distinct=new Set(values.map(String)).size,shapes=values.map(shape),dominant=shapes.length?Math.max(...[...new Set(shapes)].map(pattern=>shapes.filter(item=>item===pattern).length)):0,numbers=values.map(number).filter(value=>value!==null),sorted=[...numbers].sort((a,b)=>a-b),complete=all.length?values.length/all.length*100:100,typeValid=values.length?validCount/values.length*100:100,unique=values.length?distinct/values.length*100:100,stable=values.length?dominant/values.length*100:100,identifier=/id|key|code|number|nr$/i.test(name),duplicates=Math.max(0,values.length-distinct);let severity='healthy',finding='Healthy';if(typeValid<95){severity='critical';finding='Mixed or invalid formats'}else if(complete<80){severity='critical';finding=fmt.format(all.length-values.length)+' blank values'}else if(complete<95){severity='review';finding=fmt.format(all.length-values.length)+' blank values'}else if(identifier&&duplicates){severity=duplicates>Math.max(5,values.length*.02)?'critical':'review';finding=fmt.format(duplicates)+' possible duplicate keys'}else if(stable<70&&detected!=='Text'){severity='review';finding='Inconsistent value pattern'}return{name,index,all,values,detected,complete,typeValid,unique,stable,distinct,duplicates,identifier,severity,finding,numbers,average:numbers.length?numbers.reduce((a,b)=>a+b,0)/numbers.length:null,low:sorted[0],high:sorted.at(-1),median:sorted.length?(sorted.length%2?sorted[(sorted.length-1)/2]:(sorted[sorted.length/2-1]+sorted[sorted.length/2])/2):null,mode:mode(values)}};const metric=value=>value===null||value===undefined?'—':typeof value==='number'?fmt.format(value):esc(value);const pct=value=>Math.max(0,Math.min(100,value)).toFixed(value===100?0:1);const makeRules=()=>profiles.flatMap(item=>[{column:item.name,label:'Required values',description:'No blank values are present in the loaded rows.',passed:item.complete===100,value:pct(item.complete)+'% complete'},{column:item.name,label:'Type consistency',description:'Populated values match the detected '+item.detected+' type.',passed:item.typeValid>=95,value:pct(item.typeValid)+'% valid'},...(item.identifier?[{column:item.name,label:'Identifier uniqueness',description:'Identifier-like columns should not contain duplicate populated values.',passed:item.duplicates===0,value:item.duplicates?fmt.format(item.duplicates)+' duplicates':'Unique'}]:[]),...(item.numbers.length?[{column:item.name,label:'Numeric range',description:'Numeric values can be profiled and contain finite values.',passed:item.numbers.length===item.values.length,value:metric(item.low)+' – '+metric(item.high)}]:[])]);const drawIssues=()=>{const issues=profiles.filter(item=>item.severity!=='healthy').sort((a,b)=>(a.severity==='critical'?0:1)-(b.severity==='critical'?0:1)||a.complete-b.complete);issueCount.textContent=fmt.format(issues.length)+' columns';issueList.innerHTML=issues.slice(0,6).map(item=>'<button type="button" data-column-index="'+item.index+'" class="issue '+item.severity+'"><span><b>'+esc(item.name)+'</b><small>'+esc(item.finding)+'</small></span><strong>'+pct(item.complete)+'%</strong></button>').join('')||'<div class="empty compact">No quality issues detected in the loaded rows.</div>';issueList.querySelectorAll('[data-column-index]').forEach(button=>button.onclick=()=>{picker.selectedIndex=+button.dataset.columnIndex;showColumn();document.querySelector('[data-profile-view="overview"]').click()})};const showColumn=()=>{const item=profiles[picker.selectedIndex]||profiles[0];if(!item){detail.innerHTML='<div class="empty">No columns available</div>';return}detail.innerHTML='<div><small>Detected type</small><strong>'+esc(item.detected)+'</strong></div><div><small>Complete</small><strong>'+pct(item.complete)+'%</strong></div><div><small>Distinct</small><strong>'+fmt.format(item.distinct)+'</strong></div><div><small>Average</small><strong>'+metric(item.average)+'</strong></div><div><small>Median</small><strong>'+metric(item.median)+'</strong></div><div><small>Low / high</small><strong>'+metric(item.low)+' / '+metric(item.high)+'</strong></div><div><small>Mode</small><strong>'+metric(item.mode)+'</strong></div><div><small>Finding</small><strong class="status-text '+item.severity+'">'+esc(item.finding)+'</strong></div>'};const drawMatrix=()=>{const term=matrixSearch.value.trim().toLowerCase(),shown=profiles.filter(item=>!term||item.name.toLowerCase().includes(term));matrixRows.innerHTML=shown.map(item=>'<tr><td><strong>'+esc(item.name)+'</strong></td><td>'+esc(item.detected)+'</td><td><span class="matrix-score '+(item.complete<80?'poor':item.complete<95?'mid':'good')+'">'+pct(item.complete)+'%<small>'+fmt.format(item.values.length)+' / '+fmt.format(item.all.length)+'</small></span></td><td><span class="matrix-score '+(item.typeValid<95?'poor':'good')+'">'+pct(item.typeValid)+'%</span></td><td><span class="matrix-score '+(item.identifier&&item.unique<100?'mid':'good')+'">'+pct(item.unique)+'%<small>'+fmt.format(item.distinct)+' values</small></span></td><td><span class="matrix-score '+(item.stable<70?'mid':'good')+'">'+pct(item.stable)+'%</span></td><td><span class="finding '+item.severity+'">'+esc(item.finding)+'</span></td></tr>').join('')||'<tr><td colspan="7" class="empty">No matching columns</td></tr>'};const drawRules=()=>{const filter=ruleFilter.value,shown=rules.filter(rule=>filter==='all'||(filter==='passed')===rule.passed);ruleList.innerHTML=shown.map(rule=>'<article class="rule '+(rule.passed?'passed':'failed')+'"><span class="rule-icon">'+(rule.passed?'✓':'!')+'</span><div><small>'+esc(rule.column)+'</small><strong>'+esc(rule.label)+'</strong><p>'+esc(rule.description)+'</p></div><b>'+esc(rule.value)+'</b></article>').join('')||'<div class="empty">No checks match this filter.</div>';const passed=rules.filter(rule=>rule.passed).length;ruleSummary.innerHTML=[['Checks',fmt.format(rules.length)],['Passed',fmt.format(passed)],['Needs attention',fmt.format(rules.length-passed)]].map(item=>'<article class="card"><small>'+item[0]+'</small><strong>'+item[1]+'</strong></article>').join('')};const render=payload=>{source=payload?.source||payload?.sourceList?.[0];if(!source)return;document.querySelector('#title').textContent=(source.name||'Source')+' profile';document.querySelector('#badge').textContent=(source.connectionName||source.sourceType||'Source')+' · '+fmt.format(source.totalRows??source.rows?.length??0)+' rows';profiles=(source.columns||[]).map((name,index)=>profile(name,source.types?.[index],index));rules=makeRules();const totalChecks=Math.max(1,profiles.length*4),score=profiles.reduce((sum,item)=>sum+item.complete+item.typeValid+(item.identifier?item.unique:100)+item.stable,0)/totalChecks,issues=profiles.filter(item=>item.severity!=='healthy').length,critical=profiles.filter(item=>item.severity==='critical').length;summary.innerHTML=[['Source type',source.sourceType||'Query'],['Connection',source.connectionName||'Local / embedded'],['Loaded rows',fmt.format(source.rows?.length||0)],['Columns',fmt.format(profiles.length)],['Columns to review',fmt.format(issues)],['Last refresh',source.lastRefreshUtc?new Date(source.lastRefreshUtc).toLocaleString():'Not recorded']].map(item=>'<article class="card"><small>'+esc(item[0])+'</small><strong>'+esc(item[1])+'</strong></article>').join('');document.querySelector('#healthScore').textContent=pct(score);document.querySelector('#healthMeter').style.width=pct(score)+'%';document.querySelector('#healthLabel').textContent=critical?'Action recommended':issues?'Review recommended':'Healthy source';document.querySelector('#healthNote').textContent=critical?fmt.format(critical)+' critical column findings should be reviewed before publishing.':issues?fmt.format(issues)+' columns contain non-critical findings.':'No significant issues were detected in the loaded rows.';picker.innerHTML=profiles.map(item=>'<option>'+esc(item.name)+'</option>').join('');drawIssues();showColumn();drawMatrix();drawRules()};document.querySelectorAll('[data-profile-view]').forEach(button=>button.onclick=()=>{document.querySelectorAll('[data-profile-view]').forEach(item=>item.classList.toggle('active',item===button));document.querySelectorAll('[data-profile-panel]').forEach(panel=>panel.hidden=panel.dataset.profilePanel!==button.dataset.profileView)});picker.onchange=showColumn;matrixSearch.oninput=drawMatrix;ruleFilter.onchange=drawRules;qanvas.init(render);qanvas.subscribe(render);
`, `.profile-tabs{display:flex;gap:7px;flex-wrap:wrap;padding:5px;border:1px solid var(--qanvas-grid);border-radius:12px;background:color-mix(in srgb,var(--qanvas-grid) 15%,transparent);width:max-content;max-width:100%}.profile-tabs button{border-color:transparent;background:transparent}.profile-tabs button.active{background:var(--qanvas-text);color:var(--qanvas-surface)}[data-profile-panel]{display:grid;gap:16px}[data-profile-panel][hidden]{display:none}.profile-overview{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(360px,1.25fr);gap:12px}.eyebrow{color:var(--qanvas-accent);font-weight:750;text-transform:uppercase;letter-spacing:.07em}.health-score{font-size:36px;color:var(--qanvas-positive)}.health-track{height:12px;border-radius:999px;overflow:hidden;background:color-mix(in srgb,var(--qanvas-grid) 45%,transparent)}.health-track i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--qanvas-accent),var(--qanvas-positive))}.issue-list{display:grid;gap:7px}.issue{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;text-align:left}.issue span,.issue small{display:block}.issue small{margin-top:2px;color:color-mix(in srgb,var(--qanvas-text) 60%,transparent)}.issue.review{border-left:4px solid var(--qanvas-accent)}.issue.critical{border-left:4px solid var(--qanvas-negative)}.column-detail{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:9px}.column-detail>div{padding:11px;border-radius:10px;background:color-mix(in srgb,var(--qanvas-grid) 20%,transparent)}.column-detail small,.column-detail strong{display:block}.column-detail small{color:color-mix(in srgb,var(--qanvas-text) 58%,transparent)}.status-text.review{color:var(--qanvas-accent)}.status-text.critical{color:var(--qanvas-negative)}.matrix-panel{padding:0}.matrix-panel>header{padding:14px 14px 0}.quality-matrix th{overflow:visible}.quality-matrix th[data-tip]{cursor:help}.quality-matrix th[data-tip]::after{content:' ?';display:inline-grid;place-items:center;width:15px;height:15px;margin-left:4px;border:1px solid currentColor;border-radius:50%;font-size:9px}.quality-matrix th[data-tip]:hover::before{content:attr(data-tip);position:fixed;z-index:20;max-width:270px;padding:9px 10px;border:1px solid var(--qanvas-grid);border-radius:8px;background:var(--qanvas-text);color:var(--qanvas-surface);font-size:12px;line-height:1.35;text-transform:none;letter-spacing:normal;white-space:normal;box-shadow:0 10px 28px color-mix(in srgb,var(--qanvas-text) 18%,transparent);transform:translateY(22px)}.matrix-score{display:inline-grid;gap:1px;min-width:70px;padding:5px 7px;text-align:center;border-radius:7px;background:color-mix(in srgb,var(--qanvas-positive) 16%,transparent);color:var(--qanvas-positive)}.matrix-score small{font-size:9px;line-height:1.1;opacity:.78}.matrix-score.mid{background:color-mix(in srgb,var(--qanvas-accent) 18%,transparent);color:var(--qanvas-accent)}.matrix-score.poor{background:color-mix(in srgb,var(--qanvas-negative) 15%,transparent);color:var(--qanvas-negative)}.finding{display:inline-block;padding:5px 8px;border-radius:999px;background:color-mix(in srgb,var(--qanvas-positive) 14%,transparent);color:var(--qanvas-positive)}.finding.review{background:color-mix(in srgb,var(--qanvas-accent) 17%,transparent);color:var(--qanvas-accent)}.finding.critical{background:color-mix(in srgb,var(--qanvas-negative) 14%,transparent);color:var(--qanvas-negative)}.rule-list{display:grid;gap:8px}.rule{display:grid;grid-template-columns:32px minmax(0,1fr) auto;align-items:center;gap:12px;padding:12px;border:1px solid var(--qanvas-grid);border-radius:11px}.rule-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:color-mix(in srgb,var(--qanvas-positive) 16%,transparent);color:var(--qanvas-positive);font-weight:800}.rule.failed .rule-icon{background:color-mix(in srgb,var(--qanvas-negative) 15%,transparent);color:var(--qanvas-negative)}.rule small,.rule strong{display:block}.rule small{color:var(--qanvas-accent)}.rule p{margin:2px 0 0;color:color-mix(in srgb,var(--qanvas-text) 60%,transparent)}.empty.compact{padding:16px}@media(max-width:760px){.profile-overview{grid-template-columns:1fr}.profile-tabs{width:100%}.profile-tabs button{flex:1}.rule{grid-template-columns:32px 1fr}.rule>b{grid-column:2}.quality-matrix{min-width:840px}}`);

  const catalog = [
    { id: "source-profile", label: "Source profile", description: "Compact audit, quality matrix and validation rules" },
    { id: "data-quality-monitor", label: "Data quality monitor", description: "Completeness, duplicates and suspicious values" },
    { id: "source-lineage-audit", label: "Source lineage & join audit", description: "Sources, relationships and loaded-key coverage" },
    { id: "record-explorer", label: "Record explorer", description: "Searchable read-only source browser" },
    { id: "kpi-snapshot", label: "KPI snapshot", description: "Automatic numeric and categorical overview" },
    { id: "json-reader", label: "Structured JSON reader", description: "Guided inspection and table projection", requiresStructured: true }
  ];
  window.CanvasHtmlTemplates = Object.freeze({
    catalog,
    document(id) {
      if (id === "source-profile") return combinedSourceProfile();
      if (id === "data-quality-monitor") return dataQualityMonitor();
      if (id === "source-lineage-audit") return sourceLineageAudit();
      if (id === "record-explorer") return recordExplorer();
      if (id === "kpi-snapshot") return kpiSnapshot();
      return "";
    }
  });
})();
