.viewer-launch-guard{box-sizing:border-box;width:min(690px,calc(100vw - 32px));max-height:min(720px,calc(100vh - 32px));margin:auto;padding:0;overflow:hidden;border:1px solid var(--qreports-grid,#46536b);border-radius:18px;background:var(--qreports-surface,#171b22);color:var(--qreports-text,#eef2f7);box-shadow:0 30px 90px #0009}.viewer-launch-guard::backdrop{background:#071019d9;backdrop-filter:blur(5px)}.viewer-launch-shell{display:grid;grid-template-rows:auto minmax(0,1fr) auto;max-height:inherit}.viewer-launch-shell header{padding:25px 28px 20px;border-bottom:1px solid var(--qreports-grid,#46536b);background:var(--qreports-header-background,#11151b)}.viewer-launch-shell header p{margin:0 0 6px;color:var(--qreports-accent,#72c7a5);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.viewer-launch-shell h2{margin:0 0 5px;font-size:25px}.viewer-launch-shell header span{color:color-mix(in srgb,var(--qreports-text,#eef2f7) 65%,transparent);font-size:12px}.viewer-launch-shell>section{padding:22px 28px;overflow:auto}.viewer-launch-shell>section>p{margin:0 0 16px;line-height:1.5}.viewer-launch-items{display:grid;gap:9px}.viewer-launch-items article{display:grid;grid-template-columns:25px minmax(0,1fr);gap:10px;padding:13px;border:1px solid var(--qreports-grid,#46536b);border-radius:11px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff)}.viewer-launch-items article>span{color:#efc66a;font-size:18px;font-weight:900}.viewer-launch-items b,.viewer-launch-items small{display:block}.viewer-launch-items small{margin-top:3px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 65%,transparent)}.viewer-launch-shell footer{display:flex;justify-content:flex-end;gap:9px;padding:16px 28px;border-top:1px solid var(--qreports-grid,#46536b);background:var(--qreports-header-background,#11151b)}.viewer-launch-shell footer .primary{background:var(--qreports-accent,#72c7a5);color:var(--qreports-on-accent,#10221b);border-color:var(--qreports-accent,#72c7a5)}
@media(max-width:600px){.viewer-launch-shell footer{align-items:stretch;flex-direction:column}.viewer-launch-shell footer button{width:100%}}
.viewer-unavailable-tile{box-sizing:border-box;display:grid;grid-template-columns:34px minmax(0,1fr);gap:12px;align-content:center;width:100%;height:100%;min-height:90px;padding:18px;background:repeating-linear-gradient(135deg,color-mix(in srgb,var(--qreports-negative,#c43d4b) 5%,transparent) 0 10px,transparent 10px 20px);color:var(--qreports-text,#182230)}.viewer-unavailable-tile>span{display:grid;place-items:center;width:30px;height:30px;border:1px solid color-mix(in srgb,var(--qreports-negative,#c43d4b) 65%,transparent);border-radius:50%;color:var(--qreports-negative,#c43d4b);font-weight:900}.viewer-unavailable-tile b,.viewer-unavailable-tile small{display:block}.viewer-unavailable-tile p{margin:5px 0;color:color-mix(in srgb,var(--qreports-text,#182230) 72%,transparent);font-size:12px;line-height:1.4}.viewer-unavailable-tile small{color:color-mix(in srgb,var(--qreports-text,#182230) 58%,transparent);font-size:10px}
.viewer-recovery-workspace{width:min(460px,calc(100vw - 36px))}.viewer-recovery-workspace article p{margin:7px 0 0;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 82%,transparent);font-size:11px;line-height:1.45}.viewer-recovery-workspace article button{margin-top:9px}.viewer-recovery-workspace article[data-state=unavailable]>span{color:#ff8790}.viewer-recovery-workspace article[data-state=success] p{color:#72d6a0}@media(max-width:520px){.viewer-source-progress{right:10px;bottom:10px;width:calc(100vw - 20px)}.viewer-source-progress>div{max-height:45vh}.viewer-recovery-workspace article button{width:100%}}
.viewer-source-progress{position:fixed;right:18px;bottom:18px;z-index:10020;width:min(390px,calc(100vw - 36px));overflow:hidden;border:1px solid var(--qreports-grid,#46536b);border-radius:14px;background:var(--qreports-surface,#171b22);color:var(--qreports-text,#eef2f7);box-shadow:0 16px 55px #0008}.viewer-source-progress header{display:flex;justify-content:space-between;gap:12px;padding:13px 15px;border-bottom:1px solid var(--qreports-grid,#46536b);background:var(--qreports-header-background,#11151b)}.viewer-source-progress header b,.viewer-source-progress header small{display:block}.viewer-source-progress header small{margin-top:2px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 65%,transparent)}.viewer-source-progress header button{padding:2px 9px;font-size:18px}.viewer-source-progress>div{max-height:260px;overflow:auto}.viewer-source-progress article{display:grid;grid-template-columns:23px minmax(0,1fr);gap:9px;padding:11px 15px;border-top:1px solid color-mix(in srgb,var(--qreports-grid,#46536b) 60%,transparent)}.viewer-source-progress article:first-child{border-top:0}.viewer-source-progress article>span{font-weight:900}.viewer-source-progress article b,.viewer-source-progress article small{display:block}.viewer-source-progress article small{margin-top:2px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 65%,transparent)}.viewer-source-progress article[data-state=running]>span{color:var(--qreports-accent,#72c7a5)}.viewer-source-progress article[data-state=sign-in]>span{color:#efc66a}.viewer-source-progress article[data-state=success]>span{color:#72d6a0}.viewer-source-progress article[data-state=error]>span,.viewer-source-progress article[data-state=cancelled]>span{color:#ff8790}
.viewer-source-progress.viewer-recovery-workspace{width:min(460px,calc(100vw - 36px))}.viewer-recovery-history{margin-top:9px}.viewer-recovery-history summary{color:color-mix(in srgb,var(--qreports-text,#eef2f7) 72%,transparent);font-size:11px}.viewer-recovery-history ol{display:grid;gap:5px;margin:7px 0 0;padding:0;list-style:none}.viewer-recovery-history li{display:grid;grid-template-columns:72px minmax(0,1fr);gap:7px;font-size:10px}.viewer-recovery-history time{color:color-mix(in srgb,var(--qreports-text,#eef2f7) 58%,transparent);font-variant-numeric:tabular-nums}.viewer-recovery-history li[data-state=success] span{color:#72d6a0}.viewer-recovery-history li[data-state=error] span,.viewer-recovery-history li[data-state=cancelled] span{color:#ff8790}
.viewer-recovery-history>button{margin-top:8px;font-size:10px}
