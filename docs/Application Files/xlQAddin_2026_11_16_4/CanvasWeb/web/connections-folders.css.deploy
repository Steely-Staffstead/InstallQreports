.secret-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.secret-list {
  gap: 12px;
}

.secret-folder,
.secret-folder-items {
  display: grid;
  gap: 7px;
}

.secret-folder-title {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 4px 3px;
  color: #56647e;
  font-size: 12px;
  font-weight: 750;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.secret-folder-title::before {
  content: "▾";
  font-size: 10px;
}

.secret-folder-title[data-depth="1"] { padding-left: 13px; }
.secret-folder-title[data-depth="2"] { padding-left: 25px; }
.secret-item strong { display: block; }

html[data-qreports-app-theme] .secret-folder-title {
  color: var(--sources-muted);
}
