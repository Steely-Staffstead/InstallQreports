body { display:flex!important; flex-direction:column; height:100vh; overflow:hidden; background:var(--viewer-theme-surface,#fff); color:var(--viewer-theme-text,#182230); }
body > header.app-header,body > .toolbar,body > .commandbar,.left-panel,.right-panel,.pane-splitter,.statusbar { display:none!important; }
body > main { display:block!important; flex:1; min-height:0; }
.workspace { display:block!important; height:100%; }
.canvas-viewport { height:100%; overflow:auto; scrollbar-gutter:auto; background:var(--viewer-page-background,var(--viewer-theme-surface,#fff)); }
#canvas { background-image:none; }
.tile { outline:none!important; }
.resize-handle,.corner-rounding-handle,.connection-port,.tile-kind { display:none!important; }
.tile-header { cursor:default; }
#viewerHeader { display:block; position:relative; z-index:3000; padding:12px; background:var(--viewer-theme-header-background,#fff); color:var(--viewer-theme-header-text,#34425e); border-bottom:1px solid var(--viewer-theme-grid,#ccd5e0); max-height:45vh; overflow:visible; }
#viewerHeader .viewer-filter-toggle { margin:0; white-space:nowrap; }

#viewerHeader nav { display:flex; min-width:0; align-items:center; flex-wrap:nowrap; gap:6px; margin:8px 0; overflow:visible; }
.viewer-page-list { display:flex; min-width:0; flex:1 1 auto; gap:6px; overflow:hidden; }
.viewer-page-hidden { display:none!important; }
.viewer-page-overflow,.viewer-control-menu { position:relative; flex:0 0 auto; margin:0; }
.viewer-page-overflow[open] { z-index:3400; }
.viewer-control-menu[open] { z-index:3500; }
.viewer-page-overflow>summary,.viewer-control-menu>summary { display:flex; box-sizing:border-box; min-height:34px; align-items:center; justify-content:center; gap:6px; padding:7px 10px; list-style:none; cursor:pointer; user-select:none; border:1px solid var(--viewer-theme-grid,#ccd5e0); border-radius:7px; background:var(--viewer-unselected-bg,#fff); color:var(--viewer-unselected-color,#34425e); white-space:nowrap; }
.viewer-page-overflow>summary::-webkit-details-marker,.viewer-control-menu>summary::-webkit-details-marker { display:none; }
.viewer-page-overflow>summary { min-width:40px; font-size:18px; font-weight:800; letter-spacing:2px; }
.viewer-page-overflow[open]>summary,.viewer-control-menu[open]>summary { border-color:var(--viewer-selected-bg,#4f6ee8); box-shadow:0 0 0 1px var(--viewer-selected-bg,#4f6ee8); }
.viewer-page-overflow-menu,.viewer-control-menu>:not(summary) { position:absolute; z-index:3300; top:calc(100% + 6px); right:0; }
.viewer-page-overflow-menu { display:grid; width:min(280px,70vw); max-height:min(420px,65vh); gap:2px; padding:6px; overflow:auto; border:1px solid var(--viewer-theme-grid,#ccd5e0); border-radius:8px; background:var(--viewer-theme-header-background,#fff); box-shadow:0 14px 34px #10182838; }
.viewer-page-overflow-menu button { width:100%; overflow:hidden; text-align:left; text-overflow:ellipsis; white-space:nowrap; }
#viewerHeader button.active { background:#e8edff; border-color:#4f6ee8; }
body.viewer-tab-navigation #viewerHeader nav { align-self:end; gap:0; margin-bottom:-13px; }
body.viewer-tab-navigation #viewerHeader nav .viewer-page-list { gap:0; }
body.viewer-tab-navigation:not(.viewer-left-tabs) > #viewerHeader { padding-bottom:0; overflow:visible; }
body.viewer-tab-navigation:not(.viewer-left-tabs) > #viewerHeader nav { margin-bottom:-1px; }
body.viewer-tab-navigation #viewerHeader nav button { background:transparent; color:var(--viewer-unselected-color,var(--viewer-theme-header-text,#34425e)); border-color:var(--viewer-theme-grid,#ccd5e0); border-radius:8px 8px 0 0; }
body.viewer-tab-navigation #viewerHeader nav button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); border-bottom-color:var(--viewer-theme-surface,#fff); box-shadow:inset 0 -3px color-mix(in srgb,var(--viewer-selected-color,#fff) 45%,transparent); }
#viewerHeader details { margin:8px 0; }
#viewerHeader fieldset { display:flex; flex-wrap:wrap; gap:12px; margin:8px 0; }
#viewerHeader label { min-width:140px; max-width:240px; }
.filter-buttons { display:flex; flex-wrap:wrap; gap:4px; max-height:180px; overflow:auto; }
.date-range-display { display:flex; align-items:center; gap:6px; flex-wrap:nowrap; margin:8px 0; }
.date-range-display[hidden] { display:none; }
.date-picker-actions { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:8px; }
#viewerHeader .date-picker-selected,#viewerFiltersPane .date-picker-selected { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border:1px solid var(--viewer-selected-bg,#4f6ee8); border-radius:6px; padding:7px 9px; white-space:nowrap; }
#viewerHeader .date-picker-clear,#viewerFiltersPane .date-picker-clear { background:var(--viewer-unselected-bg,#fff); color:var(--viewer-unselected-color,#34425e); border:1px solid var(--viewer-theme-grid,#cdd5df); border-radius:6px; padding:7px 9px; white-space:nowrap; }
.range-calendar .range-calendar-grid button.today { border:1px solid currentColor; border-radius:50%; }
#viewerHeader .date-picker-selected,#viewerFiltersPane .date-picker-selected { font-size:12px; }
#viewerHeader .date-picker-value,#viewerFiltersPane .date-picker-value { background:var(--viewer-unselected-bg,#fff); color:var(--viewer-unselected-color,#34425e); border:1px solid #cdd5df; border-radius:6px; padding:7px 9px; white-space:nowrap; }
.advanced-filter { width:240px; max-width:100%; }
.advanced-filter > select,.advanced-filter-fields { box-sizing:border-box; width:100%; }
.advanced-filter-fields label { display:flex; flex-direction:column; gap:4px; margin-top:8px; font-size:12px; }
.advanced-filter-fields label[hidden] { display:none; }
.advanced-filter-fields input { box-sizing:border-box; width:100%; text-align:right; padding:8px; border:1px solid #cdd5df; border-radius:6px; }
.toggle-filter-row { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin-top:8px; }
#viewerHeader .export-toggle,#viewerFiltersPane .export-toggle { width:52px; height:30px; padding:3px; border-radius:20px; border:1px solid #cdd5df; background:var(--viewer-unselected-bg,#fff); color:var(--viewer-unselected-color,#34425e); }
.export-toggle span { display:block; width:22px; height:22px; border-radius:50%; background:currentColor; transition:transform .15s; }
#viewerHeader .export-toggle.active,#viewerFiltersPane .export-toggle.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); }
.export-toggle.active span { transform:translateX(22px); }
.filter-buttons button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); }
#viewerHeader button,#viewerFiltersPane button { background:var(--viewer-unselected-bg,#fff); color:var(--viewer-unselected-color,#34425e); }
#viewerHeader button.active,#viewerFiltersPane button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); }
[data-tile-sort] { cursor:pointer; }
body:not(.viewer-resize) .chart-margin-controls { pointer-events:none; }
body:not(.viewer-resize) .chart-margin-controls line { pointer-events:none; }
#viewerFiltersPane { display:none; }
body.viewer-left-tabs { display:grid!important; grid-template-columns:minmax(200px,260px) minmax(0,1fr); grid-template-rows:auto minmax(0,1fr); }
body.viewer-left-tabs > #viewerHeader { grid-column:1 / -1; grid-row:1; }
body.viewer-left-tabs > #viewerPageNav { display:flex; grid-column:1; grid-row:2; min-width:200px; width:auto; flex-direction:column; align-items:stretch; gap:4px; padding:14px 10px; overflow:auto; background:var(--viewer-theme-header-background,#fff); border-right:1px solid var(--viewer-theme-grid,#ccd5e0); }
body.viewer-left-tabs > #viewerPageNav .viewer-page-list { flex-direction:column; overflow:visible; }
body.viewer-left-tabs > #viewerPageNav button { width:100%; min-height:38px; text-align:left; white-space:normal; overflow-wrap:anywhere; background:transparent; color:var(--viewer-unselected-color,var(--viewer-theme-header-text,#34425e)); border-color:transparent; }
body.viewer-left-tabs > #viewerPageNav button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); }
body.viewer-left-tabs > main { grid-column:2; grid-row:2; min-width:0; }
body.viewer-vertical-filters { display:grid!important; grid-template-columns:0 minmax(0,1fr); grid-template-rows:auto minmax(0,1fr); }
body.viewer-vertical-filters > #viewerHeader { grid-column:1 / -1; grid-row:1; }
body.viewer-vertical-filters > main { grid-column:2; grid-row:2; }
body.viewer-vertical-filters.viewer-filters-open { grid-template-columns:minmax(260px,340px) minmax(0,1fr); }
body.viewer-filters-open > #viewerFiltersPane { display:block; grid-column:1; grid-row:2; overflow:auto; padding:12px; background:var(--viewer-theme-surface,#fff); color:var(--viewer-theme-text,#182230); border-right:1px solid var(--viewer-theme-grid,#ccd5e0); min-width:0; }
body.viewer-vertical-filters.viewer-right-filters { grid-template-columns:minmax(0,1fr) 0; }
body.viewer-vertical-filters.viewer-right-filters > main { grid-column:1; }
body.viewer-vertical-filters.viewer-right-filters.viewer-filters-open { grid-template-columns:minmax(0,1fr) minmax(260px,340px); }
body.viewer-right-filters.viewer-filters-open > #viewerFiltersPane { grid-column:2; border-right:0; border-left:1px solid var(--viewer-theme-grid,#ccd5e0); }
body.viewer-left-tabs.viewer-vertical-filters { grid-template-columns:minmax(200px,260px) 0 minmax(0,1fr); }
body.viewer-left-tabs.viewer-vertical-filters > #viewerPageNav { grid-column:1; }
body.viewer-left-tabs.viewer-vertical-filters > main { grid-column:3; }
body.viewer-left-tabs.viewer-vertical-filters.viewer-filters-open { grid-template-columns:minmax(200px,260px) minmax(260px,340px) minmax(0,1fr); }
body.viewer-left-tabs.viewer-filters-open > #viewerFiltersPane { grid-column:2; }
body.viewer-left-tabs.viewer-vertical-filters.viewer-right-filters { grid-template-columns:minmax(200px,260px) minmax(0,1fr) 0; }
body.viewer-left-tabs.viewer-vertical-filters.viewer-right-filters > main { grid-column:2; }
body.viewer-left-tabs.viewer-vertical-filters.viewer-right-filters.viewer-filters-open { grid-template-columns:minmax(200px,260px) minmax(0,1fr) minmax(260px,340px); }
body.viewer-left-tabs.viewer-right-filters.viewer-filters-open > #viewerFiltersPane { grid-column:3; }
#viewerFiltersPane fieldset { margin:8px 0; min-width:0; }
#viewerFiltersPane .export-filter { display:block; max-width:100%; }
#viewerFiltersPane details { margin:0; }
@media (max-width:560px) {

  body.viewer-vertical-filters > #viewerHeader { padding-right:12px; }
}

#canvas { position:relative; zoom:var(--viewer-canvas-zoom,1); }
body.viewer-fit-window .canvas-viewport { display:grid; place-items:center; }
#viewerHeader .viewer-zoom { display:flex; align-items:center; flex-wrap:nowrap; gap:4px; margin:0; }
.viewer-zoom > span { margin-right:4px; }
.viewer-zoom output { min-width:5ch; text-align:center; font-variant-numeric:tabular-nums; }
#viewerHeader .viewer-zoom button:disabled { opacity:.45; cursor:default; }

.viewer-top-row { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:8px; }
.viewer-heading { min-width:0; overflow-wrap:anywhere; }
.viewer-top-row>#viewerPageNav { min-width:0; margin:0; }
.viewer-actions { display:flex; min-width:0; align-items:center; justify-content:flex-end; flex-wrap:nowrap; gap:8px; margin-left:auto; }
.viewer-zoom { white-space:nowrap; }
.viewer-control-menu>.viewer-zoom,.viewer-control-menu>.viewer-annotation-tools { box-sizing:border-box; width:max-content; max-width:min(720px,calc(100vw - 24px)); padding:8px; border:1px solid var(--viewer-theme-grid,#ccd5e0); border-radius:8px; background:var(--viewer-theme-header-background,#fff); box-shadow:0 14px 34px #10182838; }
.viewer-control-menu>summary::after { content:"▾"; font-size:10px; opacity:.72; }
.viewer-control-menu[open]>summary::after { content:"▴"; }
.viewer-control-menu>summary output { min-width:4ch; font:inherit; font-variant-numeric:tabular-nums; opacity:.72; }
.viewer-annotation-tools { display:flex; align-items:center; gap:4px; padding-left:8px; border-left:1px solid var(--viewer-theme-grid,#ccd5e0); white-space:nowrap; }
.viewer-annotation-tools button[aria-pressed="true"] { background:var(--viewer-selected-bg,#4f6ee8)!important; color:var(--viewer-selected-color,#fff)!important; border-color:var(--viewer-selected-bg,#4f6ee8)!important; }
.viewer-pointer-icon { display:inline-block; width:10px; height:10px; margin-right:4px; border-radius:50%; background:#e1242b; box-shadow:0 0 0 2px #fff,0 0 5px rgba(0,0,0,.35); vertical-align:-1px; }
.viewer-draw-label { margin-left:2px; font-size:12px; opacity:.8; }
.viewer-icon-tool { min-width:34px; padding-inline:7px!important; font-size:21px; line-height:1; }
#viewerPointer { position:fixed; z-index:100000; width:14px; height:14px; transform:translate(-50%,-50%); border-radius:50%; background:#e1242b; box-shadow:0 0 0 3px rgba(255,255,255,.92),0 0 9px rgba(0,0,0,.55); pointer-events:none; }
.viewer-annotation-layer { position:absolute; inset:0; z-index:900; width:100%; height:100%; overflow:visible; pointer-events:none; }
.viewer-annotation-layer.drawing,.viewer-annotation-layer.erasing { pointer-events:auto; }
.viewer-annotation-layer.drawing { cursor:crosshair; }
.viewer-annotation-layer.erasing { cursor:not-allowed; }
.viewer-annotation { fill:rgba(225,36,43,.055); stroke:#e1242b; stroke-width:2; pointer-events:none; }
.viewer-annotation-layer.erasing .viewer-annotation { pointer-events:visiblePainted; cursor:pointer; }
.viewer-annotation.preview { stroke-dasharray:7 5; }
@media(max-width:900px){
  #viewerHeader{padding:8px}
  .viewer-top-row{grid-template-columns:minmax(0,1fr) auto;gap:6px}
  .viewer-heading{display:none}
  .viewer-top-row>#viewerPageNav{grid-column:1;grid-row:1}
  .viewer-actions{grid-column:2;grid-row:1}
}
