    if(!sources.length){window.alert("This export has no refreshable public API. SQL, files, authenticated APIs and saved connections remain snapshot-only.");return;}
    note.textContent=`Updating ${sources.length} public API source${sources.length===1?"":"s"}…`;
    try{
      for(const source of sources){
        const response=await fetch(source.webApi.url,{method:"GET",cache:"no-store",credentials:"omit",referrerPolicy:"no-referrer",headers:{Accept:"application/json"}});
        if(!response.ok)throw new Error(`${source.name||"API"}: HTTP ${response.status} ${response.statusText}`);
        const data=publicApiData(await response.json(),source.webApi);source.query.data=data;source.query.totalRows=data.rows.length;source.query.measureValues={};
      }
      api.viewerLoad(doc);draw();note.textContent=`Updated ${sources.length} public API source${sources.length===1?"":"s"} · ${new Date().toLocaleTimeString()}`;
    }catch(error){
      note.textContent="Public API update failed";
      window.alert(`The public API could not be updated. ${error?.message||error}\n\nThe API must allow browser cross-origin requests (CORS). SQL, authenticated APIs and local files require QanvasWeb.`);
    }
  }
  function reportObject(id,value=doc.pages[page],seen=new Set()){
    if(!value||typeof value!=="object"||seen.has(value))return null;
    seen.add(value);if(value.id===id)return value;
    for(const child of Array.isArray(value)?value:Object.values(value)){const found=reportObject(id,child,seen);if(found)return found;}
    return null;
  }
  function updateGantt(tileNode,change){
    const tile=reportObject(tileNode?.dataset.id);if(!tile?.design?.ganttSpec)return;
    const scroll=tileNode.querySelector(".gantt-scroll"),position=scroll?{left:scroll.scrollLeft,top:scroll.scrollTop}:null;
    change(tile.design.ganttSpec);draw();
    if(position)requestAnimationFrame(()=>{const current=document.querySelector(`.tile-gantt[data-id="${CSS.escape(tile.id)}"] .gantt-scroll`);if(current){current.scrollLeft=position.left;current.scrollTop=position.top;current.closest(".gantt-root")?.style.setProperty("--gantt-scroll-top",`${position.top}px`);}});
  }
  function openReadOnlyGanttDescription(trigger){
    const popover=trigger?.querySelector(".gantt-description-popover");if(!popover)return;
    document.querySelector(".gantt-description-dialog")?.remove();
    const dialog=document.createElement("dialog");dialog.className="gantt-description-dialog gantt-description-readonly-dialog";
    dialog.innerHTML='<form method="dialog"><header><strong></strong><span class="gantt-description-readonly-label">Read only</span><button value="close" aria-label="Close">×</button></header><div class="gantt-description-editor" role="document" tabindex="0"></div><footer><button value="close" class="primary">Close</button></footer></form>';
    dialog.querySelector("header strong").textContent=trigger.getAttribute("aria-label")?.replace(/^Description for\s*/i,"")||"Task description";
    dialog.querySelector(".gantt-description-editor").innerHTML=popover.innerHTML;
    Object.entries({surface:roles.surface,text:roles.text,header:roles.headerBackground,headerText:roles.headerText,grid:roles.grid,accent:roles.accent,onAccent:roles.onAccent||"#fff"}).forEach(([name,value])=>dialog.style.setProperty(`--gantt-description-${name}`,value));
    dialog.addEventListener("click",event=>{const link=event.target.closest('a[href^="#qanvas-page="]');if(!link)return;event.preventDefault();const key=decodeURIComponent(link.getAttribute("href").slice(13)),index=doc.pages.findIndex(item=>(item.id||item.name)===key);dialog.close();if(index>=0)navigatePage(index);});
    dialog.addEventListener("close",()=>dialog.remove(),{once:true});document.body.append(dialog);dialog.showModal();requestAnimationFrame(()=>dialog.querySelector(".gantt-description-editor")?.focus());
  }
  function openGanttTimelineMenu(tileNode,x,y){
    const tile=reportObject(tileNode?.dataset.id),spec=tile?.design?.ganttSpec;if(!spec)return;document.querySelector(".gantt-timeline-menu")?.remove();const menu=document.createElement("div");
    menu.className="tile-context-menu gantt-timeline-menu";menu.innerHTML=`<strong>Timeline layout</strong><div class="gantt-timeline-fields"><label>Scale<select data-gantt-timeline="timeScale"><option value="auto">Automatic</option><option value="day">Days</option><option value="week">Weeks</option><option value="month">Months</option></select></label><label>Row height<input type="number" min="28" max="64" data-gantt-timeline="rowHeight"></label><label>Table width<input type="number" min="270" max="620" data-gantt-timeline="labelWidth"></label></div><div class="gantt-timeline-toggles"><label class="check"><input type="checkbox" data-gantt-timeline="showToday"> Today line</label><label class="check"><input type="checkbox" data-gantt-timeline="showWeekends"> Weekends</label></div>`;
    document.body.append(menu);menu.querySelector('[data-gantt-timeline="timeScale"]').value=spec.timeScale||"auto";menu.querySelector('[data-gantt-timeline="rowHeight"]').value=spec.rowHeight||36;menu.querySelector('[data-gantt-timeline="labelWidth"]').value=spec.labelWidth||360;menu.querySelector('[data-gantt-timeline="showToday"]').checked=spec.showToday!==false;menu.querySelector('[data-gantt-timeline="showWeekends"]').checked=spec.showWeekends!==false;const bounds=menu.getBoundingClientRect();menu.style.left=`${Math.max(8,Math.min(x,innerWidth-bounds.width-8))}px`;menu.style.top=`${Math.max(8,Math.min(y,innerHeight-bounds.height-8))}px`;
    menu.addEventListener("change",event=>{const input=event.target.closest("[data-gantt-timeline]");if(!input)return;updateGantt(tileNode,current=>{current[input.dataset.ganttTimeline]=input.type==="checkbox"?input.checked:input.type==="number"?+input.value:input.value;});menu.remove();});
    setTimeout(()=>document.addEventListener("pointerdown",event=>{if(!event.target.closest(".gantt-timeline-menu"))menu.remove();},{capture:true,once:true}),0);
  }
  window.addEventListener("dblclick",event=>{
    if(["rectangle","oval"].includes(viewerAnnotationMode)||event.target instanceof Element&&event.target.closest("button,input,textarea,select,a,[contenteditable],#viewerHeader,#viewerPageNav,#viewerFiltersPane,.viewer-annotation-layer,.range-calendar,.pw-overlay,.gantt-timeline-menu"))return;
    const tile=event.target instanceof Element?event.target.closest("#canvas>.tile:not(.connector-object)"):null;if(!tile)return;event.preventDefault();event.stopImmediatePropagation();focusTile(tile);
  },true);
  window.addEventListener("keydown",event=>{
    if(event.target instanceof Element&&event.target.closest("input,textarea,select,[contenteditable],.range-calendar,.pw-overlay,.gantt-timeline-menu"))return;
    if((event.ctrlKey||event.metaKey)&&!event.altKey&&!event.shiftKey&&event.key.toLowerCase()==="z"&&viewerTools){event.preventDefault();event.stopImmediatePropagation();pageAnnotations().pop();renderAnnotations();return;}
    if(event.key==="Escape"&&focusView&&!document.fullscreenElement){event.preventDefault();event.stopImmediatePropagation();restoreTileFocus();return;}
    if(!["ArrowLeft","ArrowRight"].includes(event.key)||event.ctrlKey||event.metaKey||event.altKey||event.shiftKey)return;const next=page+(event.key==="ArrowRight"?1:-1);if(next<0||next>=doc.pages.length)return;event.preventDefault();event.stopImmediatePropagation();navigatePage(next);
  },true);
  // Stop designer interaction at the window capture boundary. Keep viewer
  // controls, matrix expansion, scrolling and native SVG tooltips available.
  window.addEventListener("click",event=>{const header=event.target.closest?.("[data-matrix-name-sort]");if(!header||event.target.closest("[data-matrix-all],[data-matrix-level],[data-matrix-toggle]"))return;event.preventDefault();event.stopImmediatePropagation();api.viewerSortByName(header.closest(".tile").dataset.id);},true);
  ["pointerdown","click","change","dblclick","contextmenu","keydown"].forEach(type=>window.addEventListener(type,event=>{
    if(event.target.closest("#viewerHeader,#viewerPageNav,#viewerFiltersPane,.viewer-annotation-layer,.range-calendar,.pw-overlay,.gantt-timeline-menu,.gantt-description-dialog"))return;
    if(type==="contextmenu"){const header=event.target.closest(".tile-gantt .gantt-date-header");if(header){event.preventDefault();event.stopImmediatePropagation();openGanttTimelineMenu(header.closest(".tile-gantt"),event.clientX,event.clientY);return;}}
    if(type==="change"){
      const selector=event.target.closest("[data-value-selector-select]");if(selector)api.viewerSelectValue(selector.closest(".tile").dataset.id,selector.value);
      const ganttControl=event.target.closest(".tile-gantt [data-gantt-visible-column],.tile-gantt [data-gantt-group-by],.tile-gantt [data-gantt-resource-view],.tile-gantt [data-gantt-show-dependencies]");if(ganttControl){event.preventDefault();const tileNode=ganttControl.closest(".tile-gantt");updateGantt(tileNode,spec=>{if(ganttControl.matches("[data-gantt-visible-column]")){const visible=new Set(Array.isArray(spec.visibleColumns)?spec.visibleColumns:["task","start","end"]),key=ganttControl.dataset.ganttVisibleColumn;ganttControl.checked?visible.add(key):visible.delete(key);spec.visibleColumns=[...visible];}else if(ganttControl.matches("[data-gantt-group-by]")){spec.groupByGroup=ganttControl.checked;if(spec.groupByGroup)spec.resourceView=false;spec.collapsedGroups={};}else if(ganttControl.matches("[data-gantt-resource-view]")){spec.resourceView=ganttControl.checked;if(spec.resourceView)spec.groupByGroup=false;spec.collapsedGroups={};}else{spec.showDependencies=ganttControl.checked;if(!spec.showDependencies)spec.selectedDependency=null;}});}
    }
    if(type==="click"){const action=event.target.closest('[href^="#qanvas-action="]')?.getAttribute("href")?.slice(15);if(action){event.preventDefault();if(action==="refresh")void refreshPublicApis();else window.alert("Parameter selection is available in QanvasWeb. This export uses its saved parameter values.");}const selector=event.target.closest("[data-value-selector]");if(selector){event.preventDefault();api.viewerSelectValue(selector.closest(".tile").dataset.id,selector.dataset.valueSelector);}const link=event.target.closest('a[href^="#qanvas-page="]');if(link){event.preventDefault();const key=decodeURIComponent(link.getAttribute('href').slice(13)),index=doc.pages.findIndex(p=>(p.id||p.name)===key);if(index>=0)navigatePage(index);}const toggleAll=event.target.closest("[data-matrix-all]");if(toggleAll)api.viewerToggleAll(toggleAll.closest(".tile").dataset.id,toggleAll.dataset.matrixAll==="collapse");const level=event.target.closest("[data-matrix-level]");if(level)api.viewerSetLevel(level.closest(".tile").dataset.id,+level.dataset.matrixLevel);const toggle=event.target.closest("[data-matrix-toggle]");if(toggle)api.viewerToggle(toggle.closest(".tile").dataset.id,decodeURIComponent(toggle.dataset.matrixToggle));const sort=event.target.closest("[data-tile-sort]");if(sort&&!event.target.closest("[data-matrix-all],[data-matrix-level],[data-matrix-toggle]"))api.viewerSort(sort.closest(".tile").dataset.id,sort.dataset.tileSort,event.shiftKey);const ganttDescription=event.target.closest(".tile-gantt .gantt-description-trigger");if(ganttDescription&&!event.target.closest("a[href]")){event.preventDefault();openReadOnlyGanttDescription(ganttDescription);}const ganttToolbar=event.target.closest(".tile-gantt [data-gantt-toolbar-toggle]");if(ganttToolbar){event.preventDefault();updateGantt(ganttToolbar.closest(".tile-gantt"),spec=>{spec.hideToolbar=ganttToolbar.getAttribute("aria-expanded")==="true";});}const ganttTable=event.target.closest(".tile-gantt [data-gantt-toggle-table]");if(ganttTable){event.preventDefault();updateGantt(ganttTable.closest(".tile-gantt"),spec=>{spec.hideTable=spec.hideTable!==true;});}const ganttLevel=event.target.closest('.tile-gantt [data-gantt-command="collapseGroups"],.tile-gantt [data-gantt-command="expandGroups"]');if(ganttLevel&&!ganttLevel.disabled){event.preventDefault();const tileNode=ganttLevel.closest(".tile-gantt"),keys=[...tileNode.querySelectorAll("[data-gantt-toggle-group]")].map(button=>decodeURIComponent(button.dataset.ganttToggleGroup));updateGantt(tileNode,spec=>{spec.collapsedGroups=ganttLevel.dataset.ganttCommand==="collapseGroups"?Object.fromEntries(keys.map(key=>[key,true])):{};});}const ganttGroup=event.target.closest(".tile-gantt [data-gantt-toggle-group]");if(ganttGroup){event.preventDefault();const key=decodeURIComponent(ganttGroup.dataset.ganttToggleGroup);updateGantt(ganttGroup.closest(".tile-gantt"),spec=>{spec.collapsedGroups||={};spec.collapsedGroups[key]=!spec.collapsedGroups[key];});}const ganttSort=event.target.closest(".tile-gantt [data-gantt-sort]");if(ganttSort){event.preventDefault();updateGantt(ganttSort.closest(".tile-gantt"),spec=>{const key=ganttSort.dataset.ganttSort;if(spec.sortBy===key)spec.sortDirection=spec.sortDirection==="asc"?"desc":"asc";else{spec.sortBy=key;spec.sortDirection="asc";}});}const ganttBar=event.target.closest(".tile-gantt .gantt-bar[data-gantt-row]");if(ganttBar){event.preventDefault();updateGantt(ganttBar.closest(".tile-gantt"),spec=>{spec.selectedRow=+ganttBar.dataset.ganttRow;spec.selectedDependency=null;});}}
    event.stopImmediatePropagation();if(type==="contextmenu"||type==="dblclick")event.preventDefault();
  },true));
  draw();
})();
