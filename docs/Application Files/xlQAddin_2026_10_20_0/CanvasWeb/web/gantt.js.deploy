    const cell=(item,key)=>{const common=`data-gantt-field="${key}" title="${esc(columnLabels[key])}" ${editable?"":"disabled"}`;if(key==="priority")return `<select class="gantt-priority-select gantt-priority-${priorityValue(item.priority)}" ${common} aria-label="Priority"><option value="Low" ${priorityValue(item.priority)==="low"?"selected":""}>↓ Low</option><option value="Normal" ${priorityValue(item.priority)==="normal"?"selected":""}>Normal</option><option value="High" ${priorityValue(item.priority)==="high"?"selected":""}>! High</option></select>`;if(key==="description"){const description=plainText(item.description).replace(/\s+/g," ").trim(),preview=description.length>100?`${description.slice(0,100).trimEnd()}…`:description;return `<button type="button" class="gantt-description-cell" data-gantt-edit-description data-gantt-row="${item.sourceIndex}" ${editable?"":"disabled"} title="${esc(description||"No description")}"><span>${esc(preview||"Add...")}</span>${descriptionCounter(item)}</button>`;}if(key==="start"||key==="end"){const mode=spec.dateDisplay?.[key]||"day";return mode==="day"?`<input type="date" ${common} value="${iso(item[key])}">`:`<input type="text" data-gantt-date-summary="${mode}" title="${iso(item[key])}" disabled value="${esc(dateDisplayValue(item[key],mode))}">`;}if(key==="progress"){const percent=Math.round(item.progress*100),color=progressColorFor(item.progress);return spec.progressDisplay==="badge"?`<input class="gantt-progress-badge" style="--gantt-progress-color:${color}" type="number" min="0" max="100" ${common} value="${percent}">`:`<label class="gantt-progress-cell" style="--gantt-progress:${percent}%;--gantt-progress-color:${color}"><span></span><input type="number" min="0" max="100" ${common} value="${percent}"></label>`;}if(["plannedHours","registeredHours"].includes(key))return `<input type="number" min="0" step="0.5" ${common} value="${item[key]}">`;if(key==="milestone")return `<label class="gantt-check"><input type="checkbox" ${common} ${item.milestone?"checked":""}><span>Milestone</span></label>`;if(key==="dependsOn")return `<select ${common}><option value="">None</option>${allItems.filter(other=>other.id&&other!==item).map(other=>`<option value="${esc(other.id)}" ${item.dependsOn===other.id?"selected":""}>${esc(other.id)} · ${esc(other.task)}</option>`).join("")}</select>`;if(key==="group"||key==="owner"||key==="status"){const registry=key==="group"?groupOptions:key==="owner"?ownerOptions:statusOptions,fixed=key==="group"?spec.groupListMode:key==="owner"?spec.ownerListMode:spec.statusListMode,current=optionFor(registry,item[key]),color=configuredColor(current,palette,palette.accent),badge=current?.badge===true;if(fixed&&registry.length)return `<select class="${badge?'gantt-badge':''}" style="${badge?`--gantt-badge-color:${color}`:''}" ${common}><option value=""></option>${registry.map(option=>`<option value="${esc(option.value)}" ${String(item[key])===String(option.value)?"selected":""}>${esc(key==="status"?(option.label||option.value):option.value)}</option>`).join("")}</select>`;return `<input class="${badge?'gantt-badge':''}" style="${badge?`--gantt-badge-color:${color}`:''}" ${common} value="${esc(item[key]??"")}">`;}return `<input ${common} value="${esc(item[key]??"")}">`;};
    const rows=layoutRows.map(entry=>{if(entry.type!=="group")return `<div class="gantt-table-row${selectedDependency&&(+selectedDependency.parentRow===entry.item.sourceIndex||+selectedDependency.childRow===entry.item.sourceIndex)?' gantt-related-row':''}" style="height:${rowHeight}px;grid-template-columns:${gridColumns}" ${dropAttributes(entry)} data-gantt-row="${entry.item.sourceIndex}">${visible.map(key=>cell(entry.item,key)).join("")}</div>`;const groupItems=allItems.filter(item=>groupKey(item)===entry.key),summary=resourceView?resourceSummaryHtml(groupItems,palette):groupSummaryHtml(spec,groupItems,available),ownerOption=resourceView?optionFor(ownerOptions,entry.key):null,ownerColor=configuredColor(ownerOption,palette,palette.accent),ownerBadge=ownerOption?.badge===true;return `<div class="gantt-group-row" style="height:${rowHeight}px" ${dropAttributes(entry)} data-gantt-group-key="${esc(entry.key)}" data-gantt-group-kind="${entry.groupKind}"><button type="button" data-gantt-toggle-group="${encodeURIComponent(entry.key)}" aria-expanded="${!collapsed[entry.key]}">${collapsed[entry.key]?"＋":"−"}</button><span class="${ownerBadge?'gantt-owner-group-badge':''}" style="${ownerBadge?`--gantt-owner-color:${ownerColor}`:''}">${esc(entry.label)}</span>${summary}</div>`;}).join("");
    const headers=visible.map(key=>`<button type="button" data-gantt-sort="${key}" data-gantt-column="${key}" title="Click to sort · right-click for filter and column options"><span>${esc(columnLabels[key])}${spec.sortBy===key?(spec.sortDirection==="desc"?" ▼":" ▲"):""}${spec.columnFilters?.[key]&&((spec.columnFilters[key].values||[]).length||spec.columnFilters[key].from||spec.columnFilters[key].to)?" ●":""}</span>${options.presentation?"":`<i class="gantt-column-resizer" data-gantt-column-resize="${key}" title="Drag to resize column" aria-hidden="true"></i>`}</button>`).join("");
    return `<div class="gantt-root${spec.hideTable===true?" gantt-table-hidden":""}${toolbarClass}" style="--gantt-left:${left}px;--gantt-text:${rowText};--gantt-surface:${tileBackground};--gantt-row:${rowBackground};--gantt-row-alt:${alternateBackground};--gantt-group:${groupBackground};--gantt-group-text:${groupText};--gantt-header:${headerBackground};--gantt-header-text:${headerText};--gantt-grid:${palette.grid};--gantt-accent:${barColor};--gantt-label-color:${labelTextColor};--gantt-label-size:${Math.max(8,Math.min(24,+appearance.label.fontSize||11))}px;--gantt-label-weight:${appearance.label.bold===false?400:700};--gantt-label-style:${appearance.label.italic?'italic':'normal'};--gantt-header-size:${Math.max(9,+appearance.header.fontSize||12)}px;--gantt-header-weight:${appearance.header.bold===false?400:700};--gantt-header-style:${appearance.header.italic?'italic':'normal'};--gantt-group-size:${Math.max(9,+appearance.group.fontSize||12)}px;--gantt-group-weight:${appearance.group.bold===false?400:700};--gantt-group-style:${appearance.group.italic?'italic':'normal'};--gantt-row-size:${Math.max(9,+appearance.row.fontSize||12)}px;--gantt-row-weight:${appearance.row.bold?700:400};--gantt-row-style:${appearance.row.italic?'italic':'normal'}" data-gantt-tile="${esc(tile.id)}" data-gantt-start="${iso(start)}" data-gantt-day-width="${dayWidth}" data-gantt-row-height="${rowHeight}" data-gantt-editable="${editable}" data-gantt-local="${local}">${toolbarToggle}${toolbar(allItems)}<div class="gantt-scroll"><div class="gantt-stage" style="width:${left+timelineWidth}px;height:${totalHeight}px">${spec.hideTable===true?"":`<div class="gantt-table" style="width:${left}px"><div class="gantt-table-head" style="height:${headerHeight}px;grid-template-columns:${gridColumns}">${headers}</div>${rows}</div>`}<svg class="gantt-svg" style="left:${left}px;width:${timelineWidth}px;height:${totalHeight}px" viewBox="0 0 ${timelineWidth} ${totalHeight}" preserveAspectRatio="none"><defs><marker id="gantt-arrow-${esc(tile.id)}" markerWidth="${dependencyArrowSize}" markerHeight="${dependencyArrowSize}" refX="${dependencyArrowSize-1}" refY="${dependencyArrowSize/2}" orient="auto"><path d="M0 0 L${dependencyArrowSize} ${dependencyArrowSize/2} L0 ${dependencyArrowSize} Z" fill="context-stroke"/></marker></defs>${backgrounds}${grid}${groupSummaryBars}${resourcePeriodSummaries}${dependencies}${missingWarnings}${bars}${todayX}${dateHeader}</svg>${descriptionPopovers.join("")}</div></div></div>`;
  }
  globalThis.CanvasGantt={defaults:()=>({...defaults(),...priorityDefaults}),autoConfigure,dateValue,iso,addDays,difference,configuration,tasks,dependencyAudit,render};
})();
