<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ChartWeb</title><link rel="stylesheet" href="styles.css?v=20261018-doughnut-labels-1"><link rel="stylesheet" href="chartweb-theme.css?v=20260919-1"><script src="shared-settings.js?v=20260913-2"></script></head>
<body>
  <header><div class="brand"><span>Q</span><div><strong>Chart Designer</strong><small>Edit data, layout and formatting</small></div></div><div class="header-actions"><button id="undo" type="button" title="Undo (Ctrl+Z)" disabled>Undo</button><button id="redo" type="button" title="Redo (Ctrl+Y)" disabled>Redo</button><button id="reset" type="button">Revert changes</button><button id="cancel" type="button">Cancel</button><button id="return" class="primary" type="button">Apply &amp; close</button></div></header>
  <nav id="types" class="types"></nav>
  <main id="chartLayout">
    <aside class="bindings panel"><button id="expandData" class="data-pane-tab" type="button">Data</button><div class="data-heading"><h2>Data</h2><button id="hideData" type="button" title="Hide data">‹</button></div><label>Values<select id="value"></select></label><label>Category <small>plotted level</small><select id="category"></select></label><label>Group <small>parent level</small><select id="group"></select></label><label id="heatmapRowBinding" class="hidden">Rows / split by <small>matrix Y axis</small><select id="heatmapRowField"></select></label><label id="scatterSizeBinding" class="hidden">Size by <small>default marker size field</small><select id="scatterSizeFieldDefault"></select></label><label title="Split the chart into series or small charts">Multiple <small>split series or small charts</small><select id="subgroup"></select></label><hr><h2>Series</h2><div id="series"></div><button id="addSeries">+ Add series</button></aside>
    <section class="preview"><div id="chart"></div><div id="status">Ready</div></section>
    <aside class="options panel">
      <button id="expandOptions" class="options-pane-tab" type="button">Chart options</button>
      <div class="options-heading"><h2>Chart options</h2><div><button id="optionMode" type="button" aria-pressed="false" title="Show advanced settings">Basic</button><button id="collapseAll" type="button">Collapse all</button><button id="hideOptions" type="button" title="Hide chart options">›</button></div></div><label class="option-search"><span>Search settings</span><input id="optionSearch" type="search" placeholder="Title, labels, margins…"></label><div id="optionSearchEmpty" class="option-search-empty hidden">No matching chart settings.</div>
      <details class="format-section chart-general-options" open><summary>Chart settings</summary><label>Chart type<select id="chartType"></select></label><label>Background<input id="background" type="color" value="#ffffff"></label><label>Color theme<select id="paletteName"><option value="Canvas">Use canvas theme</option><option>Default</option><option>Bright</option><option>Pastel</option><option>Muted</option><option>Excel</option><option>EarthTones</option><option>Berry</option><option>SeaGreen</option><option>Fire</option><option>Grayscale</option><option>NightOcean</option><option>NightAmber</option><option>NightViolet</option></select><small>Choosing a theme returns series and special chart colors to theme control.</small></label><label class="check"><input id="showGrid" type="checkbox" checked> Show gridlines</label></details>
      <details id="multipleOptions" class="format-section"><summary>Multiple settings</summary><label>Maximum number of multiples<input id="multipleMax" type="number" min="1" max="60" value="12"></label><label class="check"><input id="multipleAlignValue" type="checkbox" checked> Align value axes</label><label class="check"><input id="multipleAlignCategory" type="checkbox" checked> Align category axes</label><div class="two-cols"><label>Rows<input id="multipleRows" type="number" min="1" max="12" placeholder="Auto"></label><label>Columns<input id="multipleColumns" type="number" min="1" max="12" placeholder="Auto"></label></div><label>Spacing<input id="multipleSpacing" type="number" min="0" max="60" value="8"></label><div class="two-cols"><label>Header alignment<select id="multipleHeaderAlignment"><option>Left</option><option>Center</option><option>Right</option></select></label><label>Header size<input id="multipleHeaderSize" type="number" min="7" max="40" value="11"></label></div><label>Header color<input id="multipleHeaderColor" type="color" value="#34425e"></label><div class="three-checks"><label class="check"><input id="multipleHeaderBold" type="checkbox" checked> Bold</label><label class="check"><input id="multipleHeaderItalic" type="checkbox"> Italic</label><label class="check"><input id="multipleHeaderUnderline" type="checkbox"> Underline</label></div></details>
      <details class="format-section" open><summary>Title settings</summary><label>Title<input id="title"></label><label class="check"><input id="showTitle" type="checkbox" checked> Show title</label><label>Title alignment<select id="titleAlignment"><option value="Left">Left</option><option value="Center">Center</option><option value="Right">Right</option></select></label><label>Placement<select id="titlePosition"><option value="Automatic">Automatic (existing alignment)</option><option value="TopLeft">Top left</option><option value="TopCenter">Top center</option><option value="TopRight">Top right</option><option value="MiddleLeft">Middle left</option><option value="Center">Center</option><option value="MiddleRight">Middle right</option><option value="BottomLeft">Bottom left</option><option value="BottomCenter">Bottom center</option><option value="BottomRight">Bottom right</option><option value="VerticalLeft">Vertical left</option><option value="VerticalRight">Vertical right</option></select></label><div class="two-cols"><label>Title size<input id="titleSize" type="number" min="8" max="48" value="20"></label><label>Title color<input id="titleColor" type="color" value="#253653"></label></div><div class="two-cols"><label>Angle (°)<input id="titleAngle" type="number" min="-180" max="180" value="0"></label><label>Horizontal offset<input id="titleOffsetX" type="number" min="-1100" max="1100" value="0"></label></div><label>Vertical offset<input id="titleOffsetY" type="number" min="-440" max="440" value="0"></label><small>Drag the title on the preview for precise placement.</small></details>
      <details class="format-section"><summary>Legend</summary><label class="check"><input id="showLegend" type="checkbox" checked> Show legend</label><label>Legend text<select id="legendTextMode"><option value="Category">Category</option><option value="ValueCategory">Series - category</option></select></label><div class="two-cols"><label>Legend position<select id="legendPosition"><option value="Bottom">Bottom left</option><option value="BottomCenter">Bottom center</option><option value="Top">Top left</option><option value="TopCenter">Top center</option><option value="Left">Left side</option><option value="Right">Right side</option></select></label><label>Legend size<input id="legendSize" type="number" min="7" max="24" value="11"></label></div><p class="section-help">Drag the legend directly on the chart to fine-tune its position.</p></details>
      <details class="format-section"><summary>Category axis</summary><div class="two-cols"><label>Angle<input id="categoryAngle" type="number" min="-90" max="90" value="0"></label><label>Text size<input id="categorySize" type="number" min="7" max="28" value="11"></label></div><label>Format<select id="categoryFormat" data-format-select></select></label><label data-custom-format-for="categoryFormat" class="hidden">Custom format<input id="categoryFormatCustom" placeholder='yyyy-MM-dd'></label><label>Order<select id="categoryOrder"><option value="Natural">Natural</option><option value="AlphabeticalAsc">Category ascending</option><option value="AlphabeticalDesc">Category descending</option><option value="ByYAsc">Value ascending</option><option value="ByYDesc">Value descending</option></select></label><div class="two-cols"><label>Minimum<input id="categoryMin" type="number" step="any" placeholder="Auto"></label><label>Maximum<input id="categoryMax" type="number" step="any" placeholder="Auto"></label></div></details>
      <details id="groupLabelOptions" class="format-section"><summary>Group labels</summary><p class="section-help">Applies to the parent grouping above Category. Click a group label in the chart to open this section.</p><div class="two-cols"><label>Text size<input id="groupLabelSize" type="number" min="7" max="28" value="11"></label><label>Angle<input id="groupLabelAngle" type="number" min="-90" max="90" value="0"></label></div><label>Format<select id="groupLabelFormat" data-format-select></select></label><label data-custom-format-for="groupLabelFormat" class="hidden">Custom format<input id="groupLabelFormatCustom" placeholder='yyyy-MM-dd'></label><label>Vertical position<input id="groupLabelOffset" type="range" min="-55" max="55" value="0"></label></details>
      <details class="format-section"><summary>Value axis</summary><div class="two-cols"><label>Text size<input id="valueAxisSize" type="number" min="7" max="28" value="11"></label><label>Direction<select id="valueAxisOrder"><option value="Ascending">Ascending</option><option value="Descending">Descending</option></select></label></div><label>Number/date format<select id="valueAxisFormat" data-format-select></select></label><label data-custom-format-for="valueAxisFormat" class="hidden">Custom format<input id="valueAxisFormatCustom" placeholder='#,##0.0 "NOK"'></label><div class="two-cols"><label>Minimum<input id="valueMin" type="number" step="any" placeholder="Auto"></label><label>Maximum<input id="valueMax" type="number" step="any" placeholder="Auto"></label></div></details>
      <details id="heatmapRowLabelOptions" class="type-options format-section"><summary>Row labels</summary><p class="section-help">Formats Matrix row labels and Calendar weekdays without changing the value axis of other chart types.</p><label class="check"><input id="heatmapShowRowLabels" type="checkbox" checked> Show row labels</label><div class="two-cols"><label>Text size<input id="heatmapRowLabelSize" type="number" min="7" max="28" value="11"></label><label>Angle<input id="heatmapRowLabelAngle" type="number" min="-90" max="90" value="0"></label></div><label>Format<select id="heatmapRowLabelFormat" data-format-select></select></label><label data-custom-format-for="heatmapRowLabelFormat" class="hidden">Custom format<input id="heatmapRowLabelFormatCustom" placeholder='yyyy-MM-dd'></label><label>Font color<input id="heatmapRowLabelColor" type="color" value="#65718a"></label><label>Spacing %<input id="heatmapRowLabelSpacing" type="number" min="0.1" max="100" step="0.1" placeholder="Auto"></label><label>Order<select id="heatmapRowOrder"><option value="Natural">Natural</option><option value="Ascending">Ascending</option><option value="Descending">Descending</option></select></label></details>
      <details id="dataLabelOptions" class="format-section"><summary>Data labels</summary><label class="check"><input id="showValueLabels" type="checkbox"> Show labels</label><div class="label-parts"><label class="check"><input id="labelCategory" type="checkbox"> Category</label><label class="check"><input id="labelSeries" type="checkbox"> Series name</label><label class="check"><input id="labelValue" type="checkbox" checked> Value</label></div><div class="two-cols"><label>Delimiter<select id="labelDelimiter"><option value="Space">Space</option><option value="LineBreak">Line break</option><option value="Hyphen">Hyphen (-)</option><option value="MiddleDot">Middle dot (·)</option></select></label><label>Placement<select id="labelPosition"><option value="Auto">Automatic</option><option value="TopCenter">Top center</option><option value="Center">Center</option><option value="BottomCenter">Bottom center</option></select></label></div><label>Value format<select id="valueLabelFormat" data-format-select></select></label><label data-custom-format-for="valueLabelFormat" class="hidden">Custom format<input id="valueLabelFormatCustom" placeholder='#,##0.0 "NOK"'></label><div class="two-cols"><label>Angle<input id="valueLabelAngle" type="number" min="-90" max="90" value="0"></label><label>Text size<input id="valueLabelSize" type="number" min="7" max="28" value="10"></label></div></details>
      <details id="tooltipOptions" class="format-section"><summary>Tooltips</summary><p class="section-help">Add supporting fields to the standard category, series and value tooltip. Values are calculated for the hovered data point.</p><div id="tooltipFields" class="chart-list-editor"></div><button id="addTooltipField" type="button">+ Add tooltip field</button></details>
      <details id="referenceOptions" class="format-section"><summary>Reference lines &amp; bands</summary><p class="section-help">Use a number, <code>{{measure:kpi}}</code>, or a canvas parameter such as <code>{{Target}}</code>.</p><div id="referenceItems" class="chart-list-editor"></div><div class="inline-actions"><button id="addReferenceLine" type="button">+ Line</button><button id="addReferenceBand" type="button">+ Band</button></div></details>
      <details id="conditionalFormatOptions" class="format-section"><summary>Conditional formatting</summary><p class="section-help">Apply a different data color when a value meets the condition. Measure comparisons use the same category and group rows as the displayed value.</p><label class="check"><input id="conditionalEnabled" type="checkbox"> Apply conditional formatting</label><div class="two-cols"><label>Condition<select id="conditionalOperator"><option value="<">Less than</option><option value="<=">Less than or equal</option><option value=">">Greater than</option><option value=">=">Greater than or equal</option><option value="=">Equal</option><option value="<>">Not equal</option></select></label><label>Compare to<select id="conditionalCompareMode"><option value="fixed">Fixed value</option><option value="measure">Measure</option></select></label></div><label id="conditionalThresholdLabel">Fixed value<input id="conditionalThreshold" type="number" step="any" value="0"></label><label id="conditionalMeasureLabel" class="hidden">Comparison measure<select id="conditionalMeasure"></select></label><label class="check"><input id="conditionalUseThemeColor" type="checkbox" checked> Use canvas negative color</label><label>Matching value color<input id="conditionalColor" type="color" value="#c43d4b"></label></details>
      <details class="format-section"><summary>Plot margins</summary><p class="section-help">Use negative values to reclaim reserved space, or drag the plot edges directly in the chart.</p><div class="two-cols"><label>Top<input id="marginTop" type="number" min="-80" max="140" value="0"></label><label>Bottom<input id="marginBottom" type="number" min="-80" max="140" value="0"></label><label>Left<input id="marginLeft" type="number" min="-55" max="200" value="0"></label><label>Right<input id="marginRight" type="number" min="-20" max="200" value="0"></label></div><button id="resetMargins" type="button">Reset margins</button></details>
      <details id="barOptions" class="type-options"><summary>Bar layout</summary><label>Orientation<select id="barOrientation"><option value="Column">Columns (vertical)</option><option value="Bar">Bars (horizontal)</option></select></label><div class="two-cols"><label>Bar width %<input id="barWidth" type="number" min="10" max="100" value="76"></label><label>Shading<select id="barShading"><option value="None">Solid</option><option value="LightToDark">Light to dark</option><option value="DarkToLight">Dark to light</option><option value="Angled">Angled highlight</option><option value="Emboss">Soft emboss</option></select></label></div><label>Shading %<input id="shadingPercent" type="range" min="0" max="100" value="35"></label></details>
      <details id="markerOptions" class="type-options"><summary>Line and markers</summary><div class="two-cols"><label>Line thickness<input id="lineThickness" type="number" min="1" max="12" step="0.5" value="3"></label><label>Line style<select id="lineStyle"><option value="Solid">Solid</option><option value="Dotted">Dotted</option><option value="TightDotted">Tight dotted</option><option value="Dashed">Dashed</option><option value="LongDashed">Long dashed</option><option value="DashDot">Dash-dot</option></select></label></div><label>Line shading %<input id="lineShadePercent" type="range" min="0" max="100" value="0"></label><label class="check"><input id="showMarkers" type="checkbox" checked> Show markers</label><label class="check"><input id="filledMarkers" type="checkbox"> Filled markers</label><div class="two-cols"><label>Type<select id="markerType"><option value="Circle">Circle</option><option value="Square">Square</option><option value="Diamond">Diamond</option><option value="Triangle">Triangle</option></select></label><label>Size<input id="markerSize" type="number" min="2" max="30" value="7"></label></div></details>
      <details id="scatterOptions" class="type-options"><summary>Scatter / plot</summary><label id="scatterSizeOverride">Size by override<select id="scatterSizeField"></select></label><div class="two-cols"><label>Minimum dot size<input id="scatterSizeMin" type="number" min="2" max="30" value="5"></label><label>Maximum dot size<input id="scatterSizeMax" type="number" min="3" max="50" value="18"></label></div><label class="check"><input id="scatterRegression" type="checkbox"> Regression line</label><label class="check"><input id="scatterConnect" type="checkbox"> Connect points</label><label>Lollipop<select id="scatterLollipop"><option value="None">Off</option><option value="Zero">From zero</option><option value="SlotRange">Per slot (minimum–maximum)</option></select></label></details>
      <details id="doughnutOptions" class="type-options" open>
        <summary>Doughnut</summary>
        <p class="section-help">Ring and center labels are independent. Category labels stay in the outer ring by default.</p>
        <fieldset class="option-subgroup"><legend>Geometry</legend><div class="two-cols"><label>Chart size<input id="doughnutRadius" type="number" min="80" max="205" value="175"></label><label>Hole size %<input id="doughnutHole" type="number" min="20" max="75" value="38"></label></div><small>Drag the handle on the chart edge to resize.</small></fieldset>
        <fieldset class="option-subgroup"><legend>Outer ring labels</legend><div class="two-cols"><label>Content<select id="doughnutCategoryLabels"><option value="Name">Label</option><option value="Value">Value</option><option value="NameValue">Label + value</option><option value="None">Hidden</option></select></label><label>Separator<select id="doughnutCategoryDelimiter"><option value="Space">Space</option><option value="LineBreak">Line break</option><option value="Hyphen">Hyphen (-)</option><option value="MiddleDot">Middle dot (·)</option></select></label><label>Direction<select id="doughnutCategoryDirection"><option value="Radial">Radial</option><option value="Horizontal">Horizontal</option></select></label><label>Position in ring<select id="doughnutCategoryPlacement"><option value="Inner">Start at inner edge</option><option value="Center">Centered</option><option value="Outer">End at outer edge</option></select></label><label>Text size<input id="doughnutCategorySize" type="number" min="7" max="28" value="10"></label><label>Text color<input id="doughnutCategoryColor" type="color" value="#42516b"></label><label>Value format<select id="doughnutCategoryFormat" data-format-select></select></label><label data-custom-format-for="doughnutCategoryFormat" class="hidden">Custom format<input id="doughnutCategoryFormatCustom" placeholder='#,##0.0 "NOK"'></label><label>Angle<input id="doughnutCategoryAngle" type="number" min="-90" max="90" value="0"></label><label>Extra overflow %<input id="doughnutCategoryOverflow" type="number" min="0" max="150" value="0"></label></div></fieldset>
        <fieldset class="option-subgroup"><legend>Inner ring labels</legend><div class="two-cols"><label>Content<select id="doughnutGroupLabels"><option value="Name">Label</option><option value="Value">Value</option><option value="NameValue">Label + value</option><option value="None">Hidden</option></select></label><label>Direction<select id="doughnutGroupDirection"><option value="Horizontal">Horizontal</option><option value="Radial">Radial</option></select></label><label>Text size<input id="doughnutGroupSize" type="number" min="7" max="28" value="11"></label><label>Text color<input id="doughnutGroupColor" type="color" value="#65718a"></label><label>Value format<select id="doughnutGroupFormat" data-format-select></select></label><label data-custom-format-for="doughnutGroupFormat" class="hidden">Custom format<input id="doughnutGroupFormatCustom" placeholder='#,##0.0 "NOK"'></label><label>Angle<input id="doughnutGroupAngle" type="number" min="-90" max="90" value="0"></label></div></fieldset>
        <fieldset class="option-subgroup"><legend>Center label</legend><div class="two-cols"><label>Content<select id="doughnutCenterContent"><option value="Value">Total value</option><option value="LabelValue">Label + total</option><option value="Label">Label only</option><option value="None">Hidden</option></select></label><label>Text size<input id="doughnutCenterSize" type="number" min="7" max="48" value="18"></label></div><label>Label<input id="doughnutCenterText" placeholder="Measure name"></label><label>Value format<select id="doughnutCenterFormat" data-format-select></select></label><label data-custom-format-for="doughnutCenterFormat" class="hidden">Custom format<input id="doughnutCenterFormatCustom" placeholder='#,##0.0 "NOK"'></label><label>Text color<input id="doughnutCenterColor" type="color" value="#253653"></label></fieldset>
        <button id="resetDoughnut" type="button">Reset doughnut settings</button>
      </details>
      <details id="pieOptions" class="type-options"><summary>Pie layout</summary><label>Chart size<input id="pieRadius" type="number" min="80" max="205" value="150"></label></details>
      <details id="waterfallOptions" class="type-options"><summary>Waterfall</summary><label>Grouped layout<select id="waterfallLayout"><option value="MiniWaterfall">Two-level mini waterfall</option><option value="Split">Split groups</option></select></label><label class="check"><input id="waterfallTotal" type="checkbox" checked> Show final total</label><label class="check"><input id="waterfallCustomColors" type="checkbox"> Override theme colors</label><div class="two-cols"><label>Increase<input id="waterfallIncreaseColor" type="color" value="#16a085"></label><label>Decrease<input id="waterfallDecreaseColor" type="color" value="#d64562"></label></div><label>Total<input id="waterfallTotalColor" type="color" value="#3158b5"></label></details>
      <details id="histogramOptions" class="type-options"><summary>Distribution</summary><label>Number of bins<input id="bins" type="number" min="1" max="60" value="10"></label><label>Round range and intervals<select id="histogramRound"><option value="0">Automatic</option><option value="0.1">Nearest 0.1</option><option value="1">Nearest 1</option><option value="10">Nearest 10</option><option value="100">Nearest 100</option><option value="1000">Nearest 1,000</option><option value="10000">Nearest 10,000</option><option value="100000">Nearest 100,000</option><option value="1000000">Nearest 1,000,000</option></select></label><label class="check"><input id="useBinSize" type="checkbox"> Use fixed bin size</label><label>Bin size<input id="binSize" type="number" min="0.000001" step="any" value="1"></label></details>
      <section id="boxplotOptions" class="type-options"><h2>Boxplot</h2><label class="check"><input id="showOutliers" type="checkbox" checked> Show outliers</label></section>
      <details id="gaugeOptions" class="type-options"><summary>Gauge</summary><label class="check"><input id="gaugeUseThemeColors" type="checkbox" checked> Use theme colors</label><div id="gaugeColorControls" class="two-cols"><label>Low<input id="gaugeColor1" type="color" value="#d64562"></label><label>Mid-low<input id="gaugeColor2" type="color" value="#e67e22"></label><label>Mid-high<input id="gaugeColor3" type="color" value="#f0c419"></label><label>High<input id="gaugeColor4" type="color" value="#16a085"></label><label>Needle<input id="gaugeNeedleColor" type="color" value="#263653"></label></div><label>Target source<select id="gaugeTargetColumn"></select></label><label>Fixed target<input id="gaugeTarget" type="number" step="any" value="100"></label><div class="threshold-grid"><label>Low %<input id="gaugeLevel1" type="number" value="40"></label><label>Mid %<input id="gaugeLevel2" type="number" value="60"></label><label>High %<input id="gaugeLevel3" type="number" value="80"></label><label>Maximum %<input id="gaugeMaximum" type="number" value="110"></label></div></details>
      <details id="treemapOptions" class="type-options"><summary>Treemap</summary><p>Group is the parent rectangle and Category is the detailed rectangle. Values control rectangle size. Map colors use the shared chart palette.</p><label>Map colors<select id="treemapPaletteName"></select></label><label>Layout<select id="treemapLayout"><option value="Columns">Columns</option><option value="Hierarchical">Hierarchical</option></select></label><label>Category labels<select id="treemapCategoryLabels"><option value="Name">Label</option><option value="NameValue">Label + value</option><option value="None">Hidden</option></select></label><label>Group labels<select id="treemapGroupLabels"><option value="Name">Label</option><option value="NameValue">Label + value</option><option value="None">Hidden</option></select></label><label>Group border width<input id="treemapBorder" type="number" min="1" max="12" value="3"></label></details>
      <select id="heatmapCellLabels" hidden aria-hidden="true"></select>
      <details id="heatmapOptions" class="type-options"><summary>Heatmap</summary><p class="section-help"><b>Matrix</b> uses Category and Group on X, with Rows / split by on Y. <b>Calendar</b> derives weekdays automatically. Multiple works for both layouts. Configure cell text in <b>Data labels</b> and color-scale visibility in <b>Legend</b>.</p><label>Layout<select id="heatmapLayout"><option value="Matrix">Matrix · category × rows</option><option value="Calendar">Calendar · date × weekday</option></select></label><label class="check"><input id="heatmapCustomColors" type="checkbox"> Override theme colors</label><div class="two-cols"><label>Low color<input id="heatmapLowColor" type="color" value="#eef5ff"></label><label>High color<input id="heatmapHighColor" type="color" value="#315fba"></label></div><label>Empty cell color<input id="heatmapEmptyColor" type="color" value="#edf1f5"></label><div class="two-cols"><label>Color steps<input id="heatmapColorSteps" type="number" min="0" max="12" value="5"></label><label>Cell gap<input id="heatmapCellGap" type="number" min="0" max="12" value="2"></label><label>Corner rounding<input id="heatmapCellRounding" type="number" min="0" max="12" value="1"></label><label>Week starts<select id="heatmapWeekStart"><option>Monday</option><option>Sunday</option></select></label></div><div class="two-cols"><label>Scale minimum<input id="heatmapMinimum" type="number" step="any" placeholder="Auto"></label><label>Scale maximum<input id="heatmapMaximum" type="number" step="any" placeholder="Auto"></label></div><label class="check"><input id="heatmapMonthDividers" type="checkbox"> Outline month boundaries</label><div class="two-cols"><label>Divider color<input id="heatmapMonthDividerColor" type="color" value="#8a94a6"></label><label>Divider width<input id="heatmapMonthDividerWidth" type="number" min="0.5" max="8" step="0.5" value="1.5"></label></div><label class="check"><input id="heatmapSeparateMonths" type="checkbox"> Separate month blocks</label><label>Month spacing<input id="heatmapMonthGap" type="number" min="2" max="40" value="12"></label><label class="check"><input id="heatmapHighlightToday" type="checkbox"> Mark today</label><div class="two-cols"><label>Today outline<input id="heatmapTodayColor" type="color" value="#61a9e8"></label><label>Today width<input id="heatmapTodayWidth" type="number" min="0.5" max="10" step="0.5" value="3"></label></div><label class="check"><input id="heatmapHighlightCurrentWeek" type="checkbox"> Mark current week</label><div class="two-cols"><label>Week outline<input id="heatmapCurrentWeekColor" type="color" value="#2457a6"></label><label>Week width<input id="heatmapCurrentWeekWidth" type="number" min="0.5" max="10" step="0.5" value="2"></label></div><label class="check"><input id="heatmapShowEmpty" type="checkbox" checked> Show empty cells</label></details>
      <details><summary>Chart document JSON</summary><textarea id="json"></textarea><button id="applyJson">Apply JSON</button></details><div id="error"></div>
    </aside>
  </main>
