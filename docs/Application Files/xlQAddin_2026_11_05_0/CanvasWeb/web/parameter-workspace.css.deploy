html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:"Segoe UI",Arial,sans-serif;background:#eef2f8}.parameter-host{display:contents}.parameter-workspace .pw-overlay{position:static;inset:auto;width:100%;height:100%;padding:0;background:transparent;backdrop-filter:none;display:block}.parameter-workspace .pw-dialog,.parameter-workspace .pw-dialog.input{width:100%;height:100%;max-width:none;max-height:none;border:0;border-radius:0;box-shadow:none}.parameter-workspace .pw-head{min-height:76px;padding:13px 22px}.parameter-workspace .pw-head:before{content:"Q";display:grid;place-items:center;flex:0 0 44px;height:44px;border-radius:12px;background:#6686ee;color:white;font-size:25px;font-weight:800}.parameter-workspace .pw-head h2{font-size:20px}.parameter-workspace .pw-input-body{padding:14px 20px}.parameter-workspace .pw-dialog.input .pw-input-body{display:grid;align-content:stretch;grid-auto-rows:min-content;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:8px;overflow:auto}.parameter-workspace .pw-dialog.input .pw-input-row{margin:0;padding:10px 12px;border-radius:8px}.parameter-workspace .pw-dialog.input .pw-input-row>label>span{font-size:12px}.parameter-workspace .pw-dialog.input input,.parameter-workspace .pw-dialog.input select{padding:6px 8px;font-size:12px}.parameter-workspace .pw-dialog.input .pw-multi{max-height:none;min-height:0;font-size:12px}.parameter-workspace .pw-dialog.input .pw-multi label{padding:3px 5px}.parameter-workspace .pw-foot{padding:10px 20px;min-height:56px}.parameter-workspace .pw-dialog button{border:1px solid #c8d1df;border-radius:8px;background:white;color:#263451;padding:7px 11px;font-size:12px;cursor:pointer}.parameter-workspace .pw-head .pw-close{border-color:#7180a5;background:transparent;color:white}.parameter-workspace .pw-primary{box-shadow:none}.parameter-workspace .pw-body{grid-template-columns:minmax(280px,340px) 1fr}@media(max-width:760px){.parameter-workspace .pw-dialog.input .pw-input-body{grid-template-columns:1fr;padding:10px}.parameter-workspace .pw-head{padding:10px 14px}.parameter-workspace .pw-foot{padding:8px 12px}}
.parameter-workspace .pw-dialog.input .pw-input-body{grid-template-columns:1fr;align-content:start}.parameter-workspace .pw-dialog.input .pw-input-row{width:min(900px,100%);justify-self:center}
