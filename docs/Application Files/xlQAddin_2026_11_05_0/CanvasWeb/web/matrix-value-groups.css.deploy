.matrix-value-group-editor,.matrix-advanced-json{border-top:1px solid var(--qreports-grid,#d6deea);padding:12px 0}
.matrix-value-group-editor>summary,.matrix-advanced-json>summary{cursor:pointer;font-weight:700}
.matrix-value-group-editor p,.matrix-advanced-json p{font-size:13px;line-height:1.4;opacity:.78}
.matrix-value-group-row{display:grid;grid-template-columns:minmax(0,1fr) 78px 34px;gap:7px;align-items:end;margin:10px 0}
.matrix-value-group-row label{min-width:0;font-size:12px}
.matrix-value-group-row input{width:100%;min-width:0}
.matrix-value-group-row button{min-width:0;padding:7px 0}
.matrix-value-group-row small{grid-column:1/-1;opacity:.7;overflow-wrap:anywhere}
.matrix-value-group-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px}
.matrix-value-group-actions button:disabled{opacity:.45;cursor:default}
.matrix-value-group-warning,[data-matrix-json-error]{color:#d45a57;font-weight:700}
.matrix-value-group-message{border-left:3px solid var(--qreports-accent,#5c7cfa);padding:7px 9px;background:color-mix(in srgb,var(--qreports-accent,#5c7cfa) 10%,transparent);color:var(--qreports-text,#172033);font-weight:650;opacity:1!important}
.matrix-advanced-json textarea{width:100%;min-height:260px;resize:vertical;font:12px/1.45 Consolas,monospace;tab-size:2}
