:root{font:15px "Segoe UI",sans-serif;color:#17213d;background:#f5f7fb;--fields:260px;--measures:270px;--editor:180px}*{box-sizing:border-box}body{margin:0;height:100vh;display:grid;grid-template-rows:88px 1fr;overflow:hidden}button,input,textarea,select{font:inherit}button{border:1px solid #657397;background:#354365;color:white;border-radius:10px;padding:10px 15px;cursor:pointer}.primary{background:#657fee}.run{background:#388b58}header{background:#273356;color:#fff;display:flex;align-items:center;padding:16px 24px;gap:24px}.brand{display:flex;gap:13px;align-items:center}.brand>span{width:48px;height:48px;border-radius:13px;background:#6683ed;display:grid;place-items:center;font-size:28px;font-weight:800}.brand strong{font-size:22px;display:block}.brand small{color:#d6def3}nav{margin-left:auto;display:flex;gap:8px}main{display:grid;grid-template-columns:var(--fields) 6px var(--measures) 6px minmax(430px,1fr);min-height:0}aside,.measures{padding:16px;border-right:1px solid #d6deec;overflow:auto;background:#f8faff;position:relative}.pane-head{display:flex;align-items:center;justify-content:space-between}.pane-head h2{margin:0}.collapse{padding:2px 8px;background:white;color:#273356;border-color:#c9d3e3}.pane-tab{display:none;position:absolute;inset:0;padding:0;writing-mode:vertical-rl;border:0;border-radius:0;background:#eef2fa;color:#354365;font-weight:700}.fields-collapsed{--fields:34px}.measures-collapsed{--measures:34px}.fields-collapsed #fieldsPane,.measures-collapsed #measuresPane{padding:0;overflow:hidden}.fields-collapsed #fieldsPane .pane-head,.fields-collapsed #fieldsPane .pane-body,.measures-collapsed #measuresPane .pane-head,.measures-collapsed #measuresPane .pane-body{display:none}.fields-collapsed #fieldsPane .pane-tab,.measures-collapsed #measuresPane .pane-tab{display:block}.side-splitter{cursor:col-resize;background:#dce3ef;border-left:1px solid #c6d0df;border-right:1px solid #c6d0df}.fields-collapsed [data-resize=fields],.measures-collapsed [data-resize=measures]{pointer-events:none;background:#eef2fa}h3{margin:0 0 8px}h3 small{font-size:11px;font-weight:400;color:#6c7890}aside p{color:#69758e}input,textarea{width:100%;border:1px solid #c9d3e3;border-radius:8px;padding:9px;background:white}.field,.measure{padding:9px 10px;margin:6px 0;background:white;border:1px solid #d6deea;border-radius:8px;cursor:pointer}.field{font-size:13px}.measure{display:grid}.measure small{color:#748099}.measure.active{border-color:#657fee;background:#edf1ff}.measure.calculated b:after{content:"Calculated column";font-size:10px;font-weight:400;margin-left:7px;color:#596fae}.workspace{display:grid;grid-template-rows:auto minmax(120px,var(--editor)) auto auto 8px auto minmax(150px,1fr);min-height:0;padding:16px 18px 18px}.editor-head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:15px}.editor-head label,.formula-label{display:grid;gap:5px;color:#5e6a83}.formula-label{min-height:0}.formula-label textarea{font:15px Consolas,monospace;resize:vertical;height:100%;min-height:110px;line-height:1.5}.validation{padding:8px 12px;color:#5f6c84}.validation.ok{color:#247044}.validation.error{color:#b0443b}.matrix-builder{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;align-items:end;border-top:1px solid #d6deea;padding:12px 0}.dropzone{min-height:45px;border:1px dashed #9aa9c4;border-radius:8px;padding:5px;display:flex;gap:5px;flex-wrap:wrap;background:white}.chip{font-size:12px;padding:5px 7px;border-radius:6px;background:#e9eefb;cursor:grab}.chip.dragging{opacity:.45}.matrix-splitter{cursor:row-resize;background:#dce3ef;display:grid;place-items:center}.matrix-splitter span{width:55px;height:3px;border-radius:3px;background:#8995aa}.result-head{background:#596176;color:#fff;padding:6px 10px;display:flex;justify-content:space-between}.result{overflow:auto;background:white}.result table{border-collapse:collapse;min-width:100%;white-space:nowrap}.result th,.result td{padding:8px 12px;border-bottom:1px solid #dce2ec;text-align:left}.result th{background:#eef2f8;position:sticky;top:0;cursor:pointer}.menu{position:fixed;z-index:50;width:280px;max-height:min(620px,calc(100vh - 20px));overflow:auto;background:white;border:1px solid #cbd4e2;border-radius:10px;padding:10px;box-shadow:0 15px 45px #17213d44}.menu button,.menu label{display:block;width:100%;color:#273356;background:white;border:0;text-align:left;padding:7px}.menu .section{font-size:11px;text-transform:uppercase;color:#69758e;font-weight:700;padding:9px 7px 3px}.menu hr{border:0;border-top:1px solid #dce2ec}.hidden{display:none!important}.toast{position:fixed;right:25px;bottom:22px;background:#17213d;color:#fff;padding:12px 16px;border-radius:9px;z-index:100}

.workspace{grid-template-rows:auto auto var(--editor) auto auto 8px auto minmax(150px,1fr);overflow-y:auto}
.formula-label{grid-template-rows:auto minmax(0,1fr)}
.calculated-column-settings{display:grid;grid-template-columns:minmax(160px,220px) minmax(260px,1fr);align-items:end;gap:10px;margin:8px 0 2px;padding:9px 11px;border:1px solid #d6deea;border-radius:9px;background:#f8faff}.calculated-column-settings label{display:grid;gap:4px;color:#5e6a83;font-size:12px}.calculated-column-settings input,.calculated-column-settings select{min-height:36px;padding:7px 9px}.calculated-column-settings>small{grid-column:1/-1;color:#69758e}.calculated-column-settings.hidden{display:none}
.workspace>.editor-head{grid-row:1}.workspace>.calculated-column-settings{grid-row:2}.workspace>.formula-label{grid-row:3}.workspace>.validation{grid-row:4}.workspace>.matrix-builder{grid-row:5}.workspace>.matrix-splitter{grid-row:6}.workspace>.result-head{grid-row:7}.workspace>.result{grid-row:8}
.measure-audit-dialog{width:min(720px,calc(100vw - 36px));max-height:calc(100vh - 48px);padding:0;border:1px solid var(--qreports-grid,#cbd4e2);border-radius:12px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#17213d);box-shadow:0 24px 70px #0008}.measure-audit-dialog::backdrop{background:#0009}.measure-audit-dialog form{display:grid;gap:12px;padding:16px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#17213d)}.measure-audit-dialog header,.measure-audit-dialog footer{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.measure-audit-dialog h2,.measure-audit-dialog p{margin:0}.measure-audit-dialog header>button{width:34px;height:34px;padding:0;font-size:20px}.measure-audit-dialog footer{justify-content:flex-end}.measure-audit-progress{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:8px;color:var(--qreports-text,#17213d);font-size:12px}.measure-audit-progress progress{width:100%;height:12px;accent-color:var(--qreports-accent,#657fee)}.measure-audit-progress span{min-width:92px;text-align:right;font-variant-numeric:tabular-nums}.measure-audit-results{display:grid;gap:7px;max-height:55vh;overflow:auto}.measure-audit-item{display:grid;grid-template-columns:minmax(130px,1fr) minmax(220px,2fr);gap:10px;padding:8px 10px;border:1px solid var(--qreports-grid,#cbd4e2);border-left:4px solid var(--qreports-negative,#c43d4b);border-radius:7px;background:color-mix(in srgb,var(--qreports-surface,#fff) 92%,var(--qreports-header,#eef3f9));color:var(--qreports-text,#17213d)}.measure-audit-item.ok{border-left-color:var(--qreports-positive,#16844a)}.measure-audit-item b{overflow:hidden;text-overflow:ellipsis}.measure-audit-item span{font-size:12px}
.toolbar-tools{position:relative}.toolbar-tools>summary{list-style:none;border:1px solid #657397;background:#354365;color:white;border-radius:10px;padding:10px 15px;cursor:pointer;user-select:none}.toolbar-tools>summary::-webkit-details-marker{display:none}.toolbar-tools[open]>summary{border-color:#9fb1e2}.toolbar-tools>div{position:absolute;z-index:120;right:0;top:calc(100% + 7px);display:grid;min-width:170px;padding:7px;border:1px solid #657397;border-radius:10px;background:#273356;box-shadow:0 15px 40px #0007}.toolbar-tools>div button{width:100%;border:0;border-radius:7px;text-align:left;background:transparent;white-space:nowrap}.toolbar-tools>div button:hover,.toolbar-tools>div button:focus-visible{background:#ffffff1c}
.new-metric-menu>div{left:0;right:auto;min-width:260px}.new-metric-menu button{display:grid;gap:2px}.new-metric-menu button small{color:#d6def3;font-size:11px;font-weight:400}
.measure-rename-dialog{width:min(520px,calc(100vw - 36px));padding:0;border:1px solid var(--line,#cbd4e2);border-radius:12px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#17213d);box-shadow:0 24px 70px #0008}.measure-rename-dialog::backdrop{background:#0009}.measure-rename-dialog form{display:grid;gap:12px;padding:18px}.measure-rename-dialog h2,.measure-rename-dialog p{margin:0}.measure-rename-dialog ul{margin:0;padding-left:22px;max-height:180px;overflow:auto}.measure-rename-dialog footer{display:flex;justify-content:flex-end;gap:8px}.measure-rename-dialog .primary{background:var(--qreports-accent,#657fee);color:var(--qreports-on-accent,#fff)}
.measure-color-dialog{width:min(520px,calc(100vw - 36px));padding:0;border:1px solid var(--qreports-grid,#cbd4e2);border-radius:14px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#17213d);box-shadow:0 24px 70px #0008}.measure-color-dialog::backdrop{background:#0009}.measure-color-dialog form{display:grid;gap:14px;padding:18px}.measure-color-dialog header,.measure-color-dialog footer{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;background:transparent;color:inherit;padding:0;height:auto}.measure-color-dialog h2,.measure-color-dialog p{margin:0}.measure-color-dialog p{margin-top:4px;color:color-mix(in srgb,var(--qreports-text,#17213d) 72%,var(--qreports-surface,#fff));font-size:13px}.measure-color-dialog header>button{width:34px;height:34px;padding:0;font-size:20px}.measure-color-dialog fieldset{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;margin:0;padding:12px;border:1px solid var(--qreports-grid,#cbd4e2);border-radius:9px}.measure-color-dialog legend{padding:0 6px;font-weight:700}.measure-color-dialog label{display:grid;gap:5px;font-size:12px}.measure-color-dialog select,.measure-color-dialog input[type=color]{width:100%;height:38px;border:1px solid var(--qreports-grid,#cbd4e2);border-radius:7px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#17213d)}.measure-color-dialog input[type=color]{padding:3px}.measure-color-dialog .color-source-choice{display:flex;align-items:flex-start;gap:8px}.measure-color-dialog .color-source-choice input{flex:none;width:auto;margin-top:3px}.measure-color-dialog .color-source-choice span{display:grid;gap:2px}.measure-color-dialog .color-source-choice small{color:color-mix(in srgb,var(--qreports-text,#17213d) 70%,var(--qreports-surface,#fff));line-height:1.35}.measure-color-preview{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--qreports-grid,#cbd4e2);border-radius:9px;background:color-mix(in srgb,var(--qreports-surface,#fff) 92%,var(--qreports-header,#eef3f9))}.measure-color-preview>span{width:52px;height:52px;flex:none;border:1px solid var(--qreports-grid,#cbd4e2);border-radius:8px;background:#4f6ee8}.measure-color-preview>div{display:grid;gap:5px}.measure-color-preview small{color:color-mix(in srgb,var(--qreports-text,#17213d) 70%,var(--qreports-surface,#fff))}.measure-color-preview code{font:14px Consolas,monospace}.measure-color-dialog footer{justify-content:flex-end}.measure-color-dialog footer .primary{background:var(--qreports-accent,#657fee);color:var(--qreports-on-accent,#fff);border-color:var(--qreports-accent,#657fee)}
.brand{min-width:0}.brand>span{min-width:48px;flex:0 0 48px;overflow:hidden}.brand>span>img{display:block;width:48px!important;height:48px!important;max-width:48px;max-height:48px;border-radius:13px;object-fit:cover}.brand>div{min-width:0}.brand strong,.brand small{white-space:nowrap}
.measure.unused{border-left:4px solid var(--qreports-warning,#c47b18)}.measure-unused-badge{display:inline-block;margin-left:7px;padding:1px 5px;border-radius:999px;background:color-mix(in srgb,var(--qreports-warning,#c47b18) 18%,transparent);color:var(--qreports-warning,#9a5c08);font-size:10px;font-weight:700;text-transform:uppercase;vertical-align:1px}
.field-group{display:grid;gap:0;margin-top:14px}.field-group:first-child{margin-top:16px}.field-group>h3{display:flex;align-items:center;justify-content:space-between;margin:0 2px 7px;padding-bottom:6px;border-bottom:1px solid #d6deea;font-size:13px;text-transform:uppercase;letter-spacing:.04em}.field-group>h3 small{min-width:24px;padding:1px 6px;border-radius:999px;background:#e8eef8;color:#596a87;text-align:center}.field{display:flex;align-items:center;justify-content:space-between;gap:8px}.field small{color:#748099}.field-empty{margin:6px 2px 10px;font-size:12px;color:#748099}.calculated-field{border-left:3px solid var(--qreports-accent,#657fee)}.calculated-field.active{border-color:var(--qreports-accent,#657fee);background:color-mix(in srgb,var(--qreports-accent,#657fee) 10%,white)}.calculated-field>span{display:flex;align-items:center;min-width:0;gap:6px}.field-kind{flex:none;color:var(--qreports-accent,#657fee);font-family:Consolas,monospace}.calculated-field>span:not(.field-kind){overflow:hidden;text-overflow:ellipsis}

/* Compact command bar: keep the primary workflow visible without letting secondary tools consume the header. */
body{grid-template-rows:72px 1fr}
body>header{padding:9px 16px;gap:14px}
body>header .brand{gap:10px;min-width:230px}
body>header .brand>span{width:42px;height:42px;min-width:42px;flex-basis:42px;border-radius:11px;font-size:24px}
body>header .brand>span>img{width:42px!important;height:42px!important;max-width:42px!important;max-height:42px!important;border-radius:11px}
body>header .brand strong{font-size:20px}
body>header .brand small{max-width:420px;overflow:hidden;text-overflow:ellipsis;font-size:12px}
body>header nav{align-items:center;gap:6px;min-width:0}
body>header nav>button,body>header nav>.toolbar-tools>summary{min-height:38px;padding:7px 10px;border-radius:8px;white-space:nowrap;line-height:1.15}
body>header nav>#apply{font-weight:700}
body>header nav .toolbar-tools>div{top:calc(100% + 5px)}
body>header nav .toolbar-tools>div .toolbar-menu-danger{color:var(--qreports-negative,#e66b65)}
@media(max-width:1250px){body>header .brand small{display:none}body>header .brand{min-width:175px}}
@media(max-width:980px){body>header .brand>div{display:none}body>header .brand{min-width:42px}body>header nav{overflow-x:auto;scrollbar-width:thin}}

body.measure-ai-panel-docked{grid-template-columns:minmax(0,1fr) minmax(330px,var(--quick-ai-width,390px))}
body.measure-ai-panel-docked>header,body.measure-ai-panel-docked>main{grid-column:1}
body.measure-designer-ai-docked{grid-template-columns:minmax(0,1fr) minmax(340px,var(--measure-designer-ai-width,440px))}
body.measure-designer-ai-docked>header,body.measure-designer-ai-docked>main{grid-column:1}
body.measure-designer-ai-docked>.designer-ai-workbench.embedded{position:relative;grid-column:2;grid-row:1 / 3;width:100%;height:100%;min-width:0;min-height:0;border-width:0 0 0 1px;border-radius:0;box-shadow:-8px 0 28px #1826321f;resize:none;z-index:120}
.quick-ai-panel{z-index:1200;display:flex;flex-direction:column;min-width:330px;min-height:360px;overflow:hidden;border:1px solid var(--qreports-grid,#c7d8d1);background:var(--qreports-surface,#f8fbf8);color:var(--qreports-text,#243b35);box-shadow:0 18px 55px #18263247}
.quick-ai-panel.floating{position:fixed;right:22px;top:86px;width:min(520px,calc(100vw - 44px));height:min(700px,calc(100vh - 108px));border-radius:18px;resize:both}
.quick-ai-panel.docked{position:relative;grid-column:2;grid-row:1 / 3;width:100%;height:100%;min-width:0;border-width:0 0 0 1px;box-shadow:-8px 0 28px #1826321f}
.quick-ai-head{display:flex;align-items:center;gap:8px;padding:14px 15px;border-bottom:1px solid var(--qreports-grid,#c7d8d1);background:var(--qreports-header-background,#e7f0eb);cursor:move;user-select:none}.quick-ai-panel.docked .quick-ai-head{cursor:default}.quick-ai-head strong{flex:1;font-size:18px}.quick-ai-head button{padding:6px 9px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#243b35);border-color:var(--qreports-grid,#c7d8d1)}
.quick-ai-body{display:flex;flex:1;min-height:0;flex-direction:column;gap:9px;padding:15px}.quick-ai-body>p.muted{margin:0;color:var(--qreports-muted-text,#657772)}.quick-ai-body label{display:grid;gap:5px;font-weight:600}.quick-ai-body label small{color:var(--qreports-muted-text,#657772);font-weight:400}.quick-ai-body textarea{width:100%;padding:10px 11px;border:1px solid var(--qreports-grid,#c7d8d1);border-radius:9px;background:var(--qreports-surface,#fff);color:inherit;resize:vertical}.quick-ai-result-label{flex:1;min-height:140px}.quick-ai-body [data-ai-result]{height:100%;min-height:140px;font-family:Consolas,"Courier New",monospace}
.quick-ai-submit,.quick-ai-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:7px}.quick-ai-submit [data-ai-send]{min-width:110px;background:var(--qreports-accent,#657fee);border-color:var(--qreports-accent,#657fee);color:var(--qreports-on-accent,#fff)}.quick-ai-status{min-height:22px;margin:0;color:var(--qreports-text,#526078);white-space:pre-wrap;overflow:auto}.quick-ai-actions button,.quick-ai-submit [data-ai-cancel]{background:var(--qreports-surface,#fff);color:var(--qreports-text,#243b35);border-color:var(--qreports-grid,#c7d8d1)}
