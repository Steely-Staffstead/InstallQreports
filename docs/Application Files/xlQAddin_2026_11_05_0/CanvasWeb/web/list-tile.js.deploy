    }
    const headers=visible.map(item=>`<button type="button" data-list-sort="${escape(item.field)}" title="Sort by ${escape(item.label||item.field)}"><span class="list-head-label">${escape(item.label||item.field)}${sort.field===item.field?(sort.direction==="desc"?" ▼":" ▲"):""}</span>${options.resizable===true?`<span class="list-column-resizer" data-list-column-resize="${escape(item.field)}" title="Drag to resize column" aria-hidden="true"></span>`:""}</button>`).join("")+(rowActionsEnabled?"<span>Actions</span>":"");
    const body=rows.map(entry=>`<div class="list-row${entry.key===String(spec.selectedRecordId||"")?" is-selected":""}" data-list-row-index="${entry.index}" data-list-row-key="${escape(entry.key)}" style="grid-template-columns:${template}">${visible.map(item=>{const title=spec.urlTitles?.[item.field]?.[entry.key]||item.defaultLinkTitle||"";return control(item,entry.row[sourceIndexes.get(item.field)],entry.index,editable,title,entry.key);}).join("")}${rowActionsEnabled?`<span class="list-row-actions">${spec.permissions?.move!==false?`<button type="button" data-list-command="up" data-list-row="${entry.index}" data-list-row-key="${escape(entry.key)}" title="Move row up">↑</button><button type="button" data-list-command="down" data-list-row="${entry.index}" data-list-row-key="${escape(entry.key)}" title="Move row down">↓</button>`:""}${spec.permissions?.duplicate!==false?`<button type="button" data-list-command="duplicate" data-list-row="${entry.index}" data-list-row-key="${escape(entry.key)}" title="Duplicate row">⧉</button>`:""}${spec.preset==="task"&&spec.permissions?.markComplete!==false?`<button type="button" data-list-command="complete" data-list-row="${entry.index}" data-list-row-key="${escape(entry.key)}" title="Mark complete">✓</button>`:""}${spec.permissions?.delete!==false?`<button type="button" class="danger" data-list-command="delete" data-list-row="${entry.index}" data-list-row-key="${escape(entry.key)}" title="Delete row">×</button>`:""}</span>`:""}</div>`).join("");
    return`<section class="qanvas-list list-view-table list-density-${escape(spec.density||"compact")}${appearance.alternatingRows!==false?" list-alternating":""}${appearance.highlightSelectedRow!==false?" list-highlight-selection":""}" style="${style}" data-list-editable="${editable}">${toolbar}<div class="list-grid"><div class="list-head" style="grid-template-columns:${template}">${headers}</div>${body||`<div class="list-empty"><b>${search?"No matching rows":"No rows yet"}</b><span>${editable?"Use Add row to start this list.":"This list is empty."}</span></div>`}</div></section>`;
  }
  globalThis.CanvasListTile={defaults,fieldsFor,createPreset,sourceData,normalize,createRow,renumber,touch,coerce,render,gridTemplate,gridMinimumWidth,formTemplate,typeNames,systemFields,safeUrl,rowKey,colorScheme};
})();
