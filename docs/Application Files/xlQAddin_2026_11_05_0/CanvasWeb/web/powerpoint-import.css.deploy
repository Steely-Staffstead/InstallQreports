:root{font:15px/1.4 "Segoe UI",system-ui,sans-serif;color:var(--qreports-text,#182230);background:var(--qreports-surface,#f7f9fc)}*{box-sizing:border-box}body{margin:0;height:100vh;display:grid;grid-template-rows:76px minmax(0,1fr) 64px;overflow:hidden;background:var(--qreports-surface,#f7f9fc);color:var(--qreports-text,#182230)}button,input,select{font:inherit}.workspace-header{display:flex;align-items:center;gap:14px;padding:12px 22px;background:var(--qreports-header,#e8eef7);color:var(--qreports-header-text,#263d59);border-bottom:1px solid var(--qreports-grid,#cbd5e2)}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border-radius:11px;background:var(--qreports-accent,#4f6ee8);color:var(--qreports-on-accent,#fff);font-size:23px;font-weight:800}.workspace-header h1{margin:0;font-size:21px}.workspace-header p{margin:2px 0 0;opacity:.82}.header-settings{margin-left:auto;min-width:112px}main{min-height:0;display:grid;grid-template-columns:390px minmax(0,1fr)}.source-pane{min-height:0;display:grid;grid-template-rows:auto 1fr;border-right:1px solid var(--qreports-grid,#cbd5e2);background:color-mix(in srgb,var(--qreports-surface,#fff) 88%,var(--qreports-header,#e8eef7))}.pane-heading,.selection-heading,.filter-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 18px;border-bottom:1px solid var(--qreports-grid,#cbd5e2)}.pane-heading strong,.pane-heading small,.selection-heading strong,.selection-heading small,.filter-heading strong,.filter-heading small{display:block}.pane-heading small,.selection-heading small,.filter-heading small{margin-top:2px;color:color-mix(in srgb,var(--qreports-text,#182230) 68%,var(--qreports-surface,#fff));font-size:12px}.text-toggle{display:flex;align-items:center;gap:6px;white-space:nowrap;font-size:12px}.source-tree{min-height:0;overflow:auto;padding:10px}.source-node{margin:0 0 8px;border:1px solid var(--qreports-grid,#cbd5e2);border-radius:10px;background:var(--qreports-surface,#fff);overflow:hidden}.source-root,.tree-item{width:100%;display:flex;align-items:center;gap:9px;border:0;text-align:left;color:var(--qreports-text,#182230);cursor:pointer}.source-root{padding:11px 12px;background:color-mix(in srgb,var(--qreports-header,#e8eef7) 50%,var(--qreports-surface,#fff));font-weight:700}.source-root:hover,.tree-item:hover{background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 10%,var(--qreports-surface,#fff))}.source-root .chevron{width:14px}.source-root small{margin-left:auto;font-weight:400;opacity:.7}.source-children{padding:5px}.source-node.collapsed .source-children{display:none}.source-loading{padding:12px 14px;color:color-mix(in srgb,var(--qreports-text,#182230) 68%,var(--qreports-surface,#fff));font-size:13px}.tree-item{min-height:38px;padding:7px 10px;border-radius:7px}.tree-item.page{font-weight:650}.tree-item.tile{padding-left:34px;font-size:13px}.tree-item.active{background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 16%,var(--qreports-surface,#fff));box-shadow:inset 3px 0 var(--qreports-accent,#4f6ee8)}.tree-item img{width:54px;height:31px;object-fit:cover;border:1px solid var(--qreports-grid,#cbd5e2);border-radius:4px;background:var(--qreports-header,#e8eef7)}.content-pane{--filter-height:38%;min-width:0;min-height:0;display:grid;grid-template-rows:64px minmax(180px,1fr) 10px minmax(170px,var(--filter-height));background:var(--qreports-surface,#fff)}.preview-shell{position:relative;display:grid;place-items:center;min-height:0;padding:18px;background:color-mix(in srgb,var(--qreports-header,#e8eef7) 42%,var(--qreports-surface,#fff));overflow:hidden}.preview-shell img{display:none;max-width:100%;max-height:100%;object-fit:contain;border:1px solid var(--qreports-grid,#cbd5e2);border-radius:8px;box-shadow:0 12px 35px #0002;background:#fff}.preview-empty{text-align:center;color:color-mix(in srgb,var(--qreports-text,#182230) 66%,var(--qreports-surface,#fff))}.preview-empty b,.preview-empty span{display:block}.preview-empty b{font-size:20px;color:var(--qreports-text,#182230)}.filter-splitter{display:grid;place-items:center;cursor:row-resize;background:var(--qreports-header,#e8eef7);border-top:1px solid var(--qreports-grid,#cbd5e2);border-bottom:1px solid var(--qreports-grid,#cbd5e2);touch-action:none}.filter-splitter span{width:54px;height:3px;border-radius:4px;background:color-mix(in srgb,var(--qreports-text,#182230) 35%,transparent)}.filter-splitter:hover,.filter-splitter.dragging{background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 16%,var(--qreports-header,#e8eef7))}.filter-card{min-height:0;display:grid;grid-template-rows:auto 1fr}.filter-heading{padding:10px 14px}.filter-tools{display:flex;align-items:end;gap:8px}.filter-tools label{font-size:12px}.filter-tools input{display:block;width:76px;margin-top:3px}.filter-table{min-height:0;overflow:auto;padding:0 14px 12px}.filter-columns,.filter-row{display:grid;grid-template-columns:90px 150px minmax(160px,1fr) 140px minmax(180px,1.2fr) 38px;gap:6px;align-items:center}.filter-columns{position:sticky;top:0;z-index:1;padding:8px 7px;background:var(--qreports-header,#e8eef7);border:1px solid var(--qreports-grid,#cbd5e2);font-weight:700}.filter-row{padding:5px 7px;border:1px solid var(--qreports-grid,#cbd5e2);border-top:0}.filter-row select,.filter-row input,.filter-tools input{min-width:0;width:100%;padding:7px 8px;border:1px solid var(--qreports-grid,#cbd5e2);border-radius:6px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);color-scheme:var(--qreports-color-scheme,light)}select option{background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230)}button{padding:8px 13px;border:1px solid var(--qreports-grid,#cbd5e2);border-radius:7px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);cursor:pointer}button:hover{border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 10%,var(--qreports-surface,#fff))}button.primary{min-width:175px;background:var(--qreports-accent,#4f6ee8);color:var(--qreports-on-accent,#fff);border-color:var(--qreports-accent,#4f6ee8);font-weight:650}button:disabled{opacity:.55;cursor:not-allowed}.remove-filter{padding:5px 9px;color:var(--qreports-negative,#c43d4b)}footer{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:10px 18px;border-top:1px solid var(--qreports-grid,#cbd5e2);background:var(--qreports-header,#e8eef7)}.footer-actions{display:flex;align-items:center;gap:10px}.footer-actions label{display:flex;align-items:center;gap:7px}.lookup-menu,.source-menu{position:fixed;z-index:100;min-width:190px;max-width:420px;max-height:330px;overflow:auto;padding:6px;border:1px solid var(--qreports-grid,#cbd5e2);border-radius:8px;background:var(--qreports-surface,#fff);box-shadow:0 14px 38px #0004}.lookup-menu button,.source-menu button{display:block;width:100%;border:0;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.lookup-empty{padding:8px 10px;opacity:.7}@media(max-width:1050px){main{grid-template-columns:320px}.filter-columns,.filter-row{grid-template-columns:75px 115px minmax(130px,1fr) 110px minmax(140px,1fr) 34px}}
