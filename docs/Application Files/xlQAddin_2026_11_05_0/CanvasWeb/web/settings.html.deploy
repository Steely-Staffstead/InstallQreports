<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QReports settings</title><script src="shared-settings.js?v=20261013-page-navigation-tabs-2"></script></head><body data-settings-host><script>if(window.chrome?.webview){chrome.webview.addEventListener('message',event=>{if(event.data.type==='sharedSettings'&&!event.data.saved)requestAnimationFrame(()=>QReportsSettings.open());});chrome.webview.postMessage({type:'ready'});}else document.addEventListener('DOMContentLoaded',()=>QReportsSettings.open());</script></body></html>
