.kv-row input { font-size: 13px; }
.kv-row button { font-size: 13px; padding: 5px 8px; }
.response-actions { display: flex; align-items: center; gap: 10px; padding-right: 12px; }
.json-request-actions { display: flex; justify-content: flex-end; padding: 8px 12px; border-bottom: 1px solid #d9e0ec; }
.json-request-actions button { padding: 6px 9px; background: #70798d; color: #fff; border-color: #8d97aa; font-size: 12px; }
.json-request-actions button.active { background: #6686ee; border-color: #aebdff; }
#jsonRequestEditor { min-height: calc(100% - 52px); margin: 0; }
#jsonRequestEditor[contenteditable="true"] { outline: 2px solid #6686ee; outline-offset: -2px; background: #fbfcff; white-space: pre; tab-size: 2; }
#params>.split { display:flex; flex-direction:column; gap:12px; }
#params details { margin:0; padding:12px; }
#params details summary { margin-bottom:12px; }
#params .kv-row { grid-template-columns:28px minmax(140px,1fr) minmax(180px,2fr) 32px; }
.api-output-menu { position:fixed; z-index:10000; min-width:210px; max-width:90vw; padding:6px; background:white; border:1px solid #cbd5e5; border-radius:9px; box-shadow:0 6px 24px #17213c33; }
.api-output-menu button { display:block; width:100%; text-align:left; border:0; }
.api-output-menu button:hover { background:#edf1f8; }
#apiBack { margin-right:6px; }
