let entries=[];const $=id=>document.getElementById(id),esc=value=>String(value??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function visible(){const rank={Info:0,Warning:1,Error:2},minimum=rank[$("level").value]||0,search=$("search").value.toLowerCase();return entries.filter(entry=>(rank[entry.level]||0)>=minimum&&(!search||`${entry.message} ${entry.details}`.toLowerCase().includes(search)));}
function text(items=visible()){return items.map(entry=>`${entry.timestamp} [${entry.level}] ${entry.message}${entry.details?`\n${entry.details}`:""}`).join("\n");}
function render(){const items=visible();$("summary").textContent=`${items.length} of ${entries.length} entries`;$("entries").innerHTML=items.map(entry=>`<article class="entry ${String(entry.level).toLowerCase()}"><time>${esc(entry.timestamp)}</time><span class="level">${esc(entry.level)}</span><span>${esc(entry.message)}</span>${entry.details?`<div class="details">${esc(entry.details)}</div>`:""}</article>`).join("")||'<div class="empty">No log entries match this filter.</div>';}
$("level").onchange=render;$("search").oninput=render;$("clear").onclick=()=>{entries=[];render();};$("copy").onclick=()=>navigator.clipboard.writeText(text());$("save").onclick=()=>{const blob=new Blob([text(entries)],{type:"text/plain"}),link=document.createElement("a");link.href=URL.createObjectURL(blob);link.download="QReports-log.txt";link.click();setTimeout(()=>URL.revokeObjectURL(link.href),500);};$("close").onclick=()=>chrome.webview.postMessage({type:"closeWindow"});
chrome.webview.addEventListener("message",event=>{if(event.data.type==="loadLogWorkspace"){entries=event.data.entries||[];render();}});window.addEventListener("DOMContentLoaded",()=>chrome.webview.postMessage({type:"ready"}));
