const $=id=>document.getElementById(id);let connections=[],selectedName='',secrets=[],selectedSecret=null,pending=new Map(),exportOptions=null,importPreview=null;
const bridgeNames={connectionsList:'connections-list',connectionsSave:'connections-save',connectionsDelete:'connections-delete',connectionsTest:'connections-test',mcpDiscover:'mcp-discover',mcpReadResource:'mcp-read-resource',mcpCallTool:'mcp-call-tool',connectionsExport:'connections-export',connectionsExportOptions:'connections-export-options',connectionsImportPreview:'connections-import-preview',connectionsImportApply:'connections-import-apply',connectionsFileOpen:'connections-file-open',connectionsOpenApi:'connections-open-api',secretsList:'secrets-list',secretsSave:'secrets-save',secretsDelete:'secrets-delete',secretsReveal:'secrets-reveal'};
function call(type,payload={}){return new Promise((resolve,reject)=>{const action=bridgeNames[type];pending.set(action,{resolve,reject});chrome.webview.postMessage({type,...payload})})}
function setStatus(text,kind=''){const e=$('status');e.textContent=text;e.className='status '+kind}
function toast(text){const e=$('toast');e.textContent=text;e.classList.remove('hidden');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.add('hidden'),3500)}
function escapeHtml(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function current(){return{name:$('name').value.trim(),type:$('type').value,order:Number($('order').value)||0,details:$('details').value.trim(),delimiter:$('delimiter').value||',',hasHeaders:$('hasHeaders').checked,encoding:$('encoding').value}}
function renderConnections(){const q=$('search').value.toLowerCase();$('connectionList').innerHTML=connections.filter(c=>!q||c.name.toLowerCase().includes(q)||c.type.toLowerCase().includes(q)).map(c=>`<div class="connection-item ${c.name===selectedName?'active':''}" data-name="${escapeHtml(c.name)}"><strong>${escapeHtml(c.name)}</strong><small><span>${escapeHtml(c.type)}</span><span>Order ${c.order}</span></small></div>`).join('')||'<p class="help">No connections found.</p>';document.querySelectorAll('.connection-item').forEach(e=>{e.onclick=()=>selectConnection(e.dataset.name);e.oncontextmenu=event=>openConnectionMenu(event,e.dataset.name)})}
function selectConnection(name){const c=connections.find(x=>x.name===name);if(!c)return;selectedName=name;$('name').value=c.name;$('type').value=c.type;$('order').value=c.order;$('details').value=c.details;$('delimiter').value=c.delimiter||',';$('hasHeaders').checked=c.hasHeaders!==false;$('encoding').value=c.encoding||'UTF-8';$('editorTitle').textContent=c.name;configureType();parseDetails();renderConnections()}
function newConnection(){selectedName='';$('name').value='';$('type').value='SQL';$('order').value='0';$('details').value='';$('server').value='';$('database').value='';$('user').value='';$('password').value='';$('filePath').value='';$('apiUrl').value='';$('apiComment').value='';$('mcpUrl').value='';$('mcpCommand').value='';$('mcpArgs').value='';$('mcpHeaders').value='';$('mcpEnvironment').value='';$('mcpTransport').value='streamableHttp';$('mcpCodex').checked=$('mcpClaude').checked=$('mcpCopilot').checked=true;renderMcpDiscovery(null);$('editorTitle').textContent='New source';configureType();renderConnections();$('name').focus()}
function isFile(){return['EXCEL','CSV','TEXT'].includes($('type').value)}
function configureType(){const t=$('type').value;const file=isFile(),api=t==='API',mcp=t==='MCP';$('databaseFields').classList.toggle('hidden',file||api||mcp);$('fileFields').classList.toggle('hidden',!file);$('apiFields').classList.toggle('hidden',!api);$('mcpFields').classList.toggle('hidden',!mcp);$('delimiterLabel').classList.toggle('hidden',t==='EXCEL');$('detailsLabel').firstChild.textContent=api?'API definition (JSON or Base URL)':mcp?'MCP definition (JSON)':file?'Source file':'Connection string';if(t==='SQL'&&!$('port').value)$('port').value=1433;if(t==='MYSQL'&&!$('port').value)$('port').value=3306;if(t==='SNOWFLAKE')$('port').value=443;if(mcp)configureMcpTransport()}
function parseDetails(){const t=$('type').value,d=$('details').value;if(isFile()){$('filePath').value=d;return}if(t==='API'){try{const a=JSON.parse(d),auth=a.Auth||a.auth||{},kinds=['None','ApiKey','AzureFunctionKey','BearerToken','BearerTokenWorkflow','Basic'];$('apiUrl').value=a.BaseUrl||a.baseUrl||'';$('apiComment').value=a.Comment||a.comment||'';$('apiAuth').value=typeof auth.Kind==='number'?kinds[auth.Kind]||'None':auth.Kind||'None';$('apiSecret').value=auth.SecretRef||''}catch{$('apiUrl').value=d;$('apiComment').value=''}return}if(t==='MCP'){try{const m=JSON.parse(d),providers=m.AiProviders||m.aiProviders||['codex','claude','copilot'];$('mcpTransport').value=m.Transport||m.transport||'streamableHttp';$('mcpUrl').value=m.Url||m.url||'';$('mcpCommand').value=m.Command||m.command||'';$('mcpArgs').value=(m.Arguments||m.arguments||[]).join('\n');$('mcpHeaders').value=formatJson(m.Headers||m.headers||{});$('mcpEnvironment').value=formatJson(m.Environment||m.environment||{});$('mcpCodex').checked=providers.includes('codex');$('mcpClaude').checked=providers.includes('claude');$('mcpCopilot').checked=providers.includes('copilot');renderMcpDiscovery(m);configureMcpTransport()}catch{renderMcpDiscovery(null)}return}try{const parts={};d.split(';').forEach(p=>{const i=p.indexOf('=');if(i>0)parts[p.slice(0,i).trim().toLowerCase()]=p.slice(i+1).trim()});let server=parts.server||parts['data source']||parts.account||'';const comma=server.lastIndexOf(',');if(comma>0&&!isNaN(server.slice(comma+1))){$('port').value=server.slice(comma+1);server=server.slice(0,comma)}$('server').value=server;$('database').value=parts.database||parts['initial catalog']||parts.db||'';$('user').value=parts['user id']||parts.uid||parts.user||'';$('password').value=parts.password||parts.pwd||'';$('encrypt').checked=/true|required|yes/i.test(parts.encrypt||parts.sslmode||'');$('trust').checked=/true|yes/i.test(parts.trustservercertificate||'')}catch{}}
function formatJson(value){return Object.keys(value||{}).length?JSON.stringify(value,null,2):''}
function parseObject(id){const text=$(id).value.trim();if(!text)return{};const value=JSON.parse(text);if(!value||Array.isArray(value)||typeof value!=='object')throw new Error(`${id==='mcpHeaders'?'Headers':'Environment'} must be a JSON object.`);return value}
function configureMcpTransport(){const stdio=$('mcpTransport').value==='stdio';$('mcpUrlLabel').classList.toggle('hidden',stdio);$('mcpCommandLabel').classList.toggle('hidden',!stdio);$('mcpArgsLabel').classList.toggle('hidden',!stdio)}
function renderMcpDiscovery(spec){const tools=spec?.DiscoveredTools||spec?.discoveredTools||[],resources=spec?.DiscoveredResources||spec?.discoveredResources||[],prompts=spec?.DiscoveredPrompts||spec?.discoveredPrompts||[],at=spec?.LastDiscoveredUtc||spec?.lastDiscoveredUtc||'';$('mcpDiscovery').classList.toggle('hidden',!tools.length&&!resources.length&&!prompts.length&&!at);$('mcpDiscoveredAt').textContent=at?`Last tested ${new Date(at).toLocaleString()}`:'';for(const [id,items] of [['mcpTools',tools],['mcpResources',resources],['mcpPrompts',prompts]])$(id).innerHTML=items.length?items.map(item=>`<li title="${escapeHtml(typeof item==='string'?item:item.name||item.uri||'')}">${escapeHtml(typeof item==='string'?item:item.name||item.uri||'')}</li>`).join(''):'<li class="muted">None</li>'}
function applyStructured(){const t=$('type').value;if(isFile()){$('details').value=$('filePath').value.trim()}else if(t==='API'){const url=$('apiUrl').value.trim(),comment=$('apiComment').value.trim(),auth=$('apiAuth').value,secret=$('apiSecret').value.trim();const a={Name:$('name').value.trim()||'API Connection',Comment:comment,BaseUrl:url,Auth:{Kind:auth}};if(secret)a.Auth.SecretRef=secret;$('details').value=JSON.stringify(a,null,2)}else if(t==='MCP'){let existing={};try{existing=JSON.parse($('details').value||'{}')}catch{};const m={...existing,Transport:$('mcpTransport').value,Url:$('mcpUrl').value.trim(),Command:$('mcpCommand').value.trim(),Arguments:$('mcpArgs').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean),Headers:parseObject('mcpHeaders'),Environment:parseObject('mcpEnvironment'),AiProviders:[['mcpCodex','codex'],['mcpClaude','claude'],['mcpCopilot','copilot']].filter(([id])=>$(id).checked).map(([,provider])=>provider),IsReadOnly:true};$('details').value=JSON.stringify(m,null,2)}else{let s=$('server').value.trim(),port=Number($('port').value)||0,db=$('database').value.trim(),u=$('user').value.trim(),p=$('password').value;if(t==='MYSQL')$('details').value=`Server=${s};Port=${port||3306};Database=${db};Uid=${u};Pwd=${p};SslMode=${$('encrypt').checked?'Required':'None'};Connection Timeout=15;`;else if(t==='SNOWFLAKE')$('details').value=`account=${s};user=${u};password=${p};db=${db};connection_timeout=15;`;else{$('details').value=`Server=${s}${port&&port!==1433?','+port:''};Database=${db};${u?`User ID=${u};Password=${p};`:'Integrated Security=True;'}Encrypt=${$('encrypt').checked};TrustServerCertificate=${$('trust').checked};Connection Timeout=15;`}}document.querySelector('[data-tab="manual"]').click();toast('Structured details applied')}
function template(){const t=$('type').value;if(t==='API'){$('details').value=JSON.stringify({Name:'API Connection',BaseUrl:'https://api.example.com/',Auth:{Kind:'None'}},null,2)}else if(t==='MCP')$('details').value=JSON.stringify({Transport:'streamableHttp',Url:'https://mcp.example.com/mcp',Headers:{Authorization:'Bearer {{secret:mcp_token}}'},AiProviders:['codex','claude','copilot'],IsReadOnly:true},null,2);else if(t==='SQL')$('details').value='Server=YOUR-SERVER\\SQLEXPRESS;Database=YOUR_DB;User ID=YOUR_USER;Password={{secret:sql_password}};Encrypt=True;TrustServerCertificate=True;Connection Timeout=15;';else if(t==='MYSQL')$('details').value='Server=your-mysql-host;Port=3306;Database=your_db;Uid=your_user;Pwd={{secret:mysql_password}};SslMode=Preferred;Connection Timeout=15;';else if(t==='SNOWFLAKE')$('details').value='account=your_account;user=your_user;password={{secret:snowflake_password}};role=SYSADMIN;warehouse=COMPUTE_WH;db=YOUR_DB;schema=PUBLIC;connection_timeout=15';else document.querySelector('[data-action="browse"]').click();if(!$('name').value)$('name').value=t+' Connection';parseDetails()}
async function loadConnections(){setStatus('Loading…','busy');const r=await call('connectionsList');connections=r.connections||[];renderConnections();setStatus('Ready')}
function syncBeforeAction(){if(!$('structuredPanel').classList.contains('hidden'))applyStructured()}
async function save(){syncBeforeAction();setStatus('Saving…','busy');const r=await call('connectionsSave',{connection:current()});selectedName=r.connection.name;await loadConnections();selectConnection(selectedName);setStatus('Saved','ok');toast('Connection saved')}
async function remove(){if(!selectedName||!await window.QReportsDialogs.confirm(`Delete source '${selectedName}'?`))return;await call('connectionsDelete',{name:selectedName});newConnection();await loadConnections();toast('Source deleted')}
async function test(){syncBeforeAction();setStatus('Testing…','busy');const r=await call('connectionsTest',{connection:current()});if($('type').value==='MCP'&&r.details){$('details').value=r.details;parseDetails()}setStatus('Test successful','ok');toast(r.message||'Connection successful')}
async function browse(){const r=await call('connectionsFileOpen',{connectionType:$('type').value});if(r.path){$('filePath').value=r.path;$('details').value=r.path;if(!$('name').value)$('name').value=r.path.split(/[\\/]/).pop().replace(/\.[^.]+$/,'')}}
function closeConnectionMenu(){$('connectionMenu').classList.add('hidden')}
function openConnectionMenu(event,name){event.preventDefault();selectConnection(name);if($('type').value!=='API')return;const menu=$('connectionMenu');menu.classList.remove('hidden');const width=menu.offsetWidth,height=menu.offsetHeight;menu.style.left=Math.max(8,Math.min(event.clientX,innerWidth-width-8))+'px';menu.style.top=Math.max(8,Math.min(event.clientY,innerHeight-height-8))+'px'}
function definitionMarkup(item,index,prefix,checked=true){const name=item.name??item.Name??`API ${index+1}`,method=item.method??item.Method??'GET',path=item.path??item.RelativePath??'';return `<label class="definition-option"><input type="checkbox" data-definition="${prefix}" data-index="${index}" ${checked?'checked':''}><span><strong>${escapeHtml(name)}</strong><small>${escapeHtml(path||'Connection root')}</small></span><small>${escapeHtml(method)}</small></label>`}
function renderDefinitions(containerId,items,prefix,checked=true){$(containerId).innerHTML=items.length?items.map((item,index)=>definitionMarkup(item,index,prefix,checked)).join(''):'<div class="empty-definitions">No saved API definitions for this connection.</div>'}
function selectedDefinitionIndices(prefix){return [...document.querySelectorAll(`input[data-definition="${prefix}"]:checked`)].map(input=>Number(input.dataset.index))}
function toggleDefinitions(prefix,button){const boxes=[...document.querySelectorAll(`input[data-definition="${prefix}"]`)],select=boxes.some(box=>!box.checked);boxes.forEach(box=>box.checked=select);button.textContent=select?'Clear all':'Select all'}
async function openExport(connectionOnly=false){syncBeforeAction();if(!$('name').value.trim())throw new Error('Select or enter a connection first.');exportOptions=await call('connectionsExportOptions',{connection:current()});$('exportConnectionName').textContent=exportOptions.connectionName;const postmanOption=$('exportFormat').querySelector('option[value="postman"]');postmanOption.disabled=exportOptions.connectionType!=='API';$('exportFormat').value='qreports';renderDefinitions('exportDefinitionList',exportOptions.apiDefinitions||[],'export',!connectionOnly);$('exportModal').classList.remove('hidden');updateExportFormat();const toggle=document.querySelector('[data-action="toggleExportDefinitions"]');if(toggle)toggle.textContent=connectionOnly?'Select all':'Clear all'}
function updateExportFormat(){const postman=$('exportFormat').value==='postman';$('exportFormatNote').textContent=postman?'Postman Collection v2.1 is portable, but QReports-specific pagination, flattening and parameter settings may not round-trip through other tools. Stored QReports secret values are never included.':'QReports format preserves all supported connection and API settings. Stored QReports secret values are never included.'}
async function confirmExport(){const indices=selectedDefinitionIndices('export'),definitions=exportOptions?.apiDefinitions||[],endpointNames=indices.map(index=>definitions[index]?.name).filter(Boolean);const result=await call('connectionsExport',{connection:current(),format:$('exportFormat').value,endpointNames});if(result.cancelled)return;$('exportModal').classList.add('hidden');toast(`Exported ${result.definitionCount||0} API definition${result.definitionCount===1?'':'s'}`)}
async function openImport(){const result=await call('connectionsImportPreview');if(result.cancelled)return;importPreview=result;$('importFormat').textContent=result.format;$('importPath').textContent=result.path;$('importPath').title=result.path;$('importConnectionName').textContent=result.connection?.name||'';$('importConnection').checked=true;renderDefinitions('importDefinitionList',result.apiDefinitions||[],'import',true);$('importModal').classList.remove('hidden');const toggle=document.querySelector('[data-action="toggleImportDefinitions"]');if(toggle)toggle.textContent='Clear all'}
async function confirmImport(){if(!importPreview)return;const definitions=importPreview.apiDefinitions||[],selected=selectedDefinitionIndices('import').map(index=>definitions[index]);if(!$('importConnection').checked&&!selected.length)throw new Error('Select the connection or at least one API definition.');const result=await call('connectionsImportApply',{connection:importPreview.connection,includeConnection:$('importConnection').checked,apiDefinitions:selected});$('importModal').classList.add('hidden');await loadConnections();selectConnection(result.connection.name);toast(`Imported ${result.definitionCount||0} API definition${result.definitionCount===1?'':'s'}`)}
function renderSecrets(){const list=$('secretList');list.innerHTML=secrets.map(s=>`<div class="secret-item ${selectedSecret&&selectedSecret.key===s.key&&selectedSecret.scope===s.scope?'active':''}" data-key="${escapeHtml(s.key)}" data-scope="${s.scope}"><strong>${escapeHtml(s.key)}</strong><small>${s.scope==='shared'?'Shared company secret':'Private user secret'} · ${escapeHtml(s.token)}</small></div>`).join('')||'<p class="help">No secrets saved.</p>';document.querySelectorAll('.secret-item').forEach(e=>e.onclick=()=>selectSecret(e.dataset.key,e.dataset.scope))}
function resetSecretReveal(){$('secretValue').type='password';$('secretValue').value='';const b=document.querySelector('[data-action="showSecret"]');if(b)b.textContent='Show'}
function selectSecret(key,scope){selectedSecret=secrets.find(s=>s.key===key&&s.scope===scope);$('secretKey').value=key;$('secretScope').value=scope;$('secretKey').readOnly=true;$('secretScope').disabled=true;resetSecretReveal();$('secretTitle').textContent='Change secret value';$('secretToken').textContent=`{{secret:${key}}}`;renderSecrets()}
function newSecret(){selectedSecret=null;$('secretKey').readOnly=false;$('secretScope').disabled=false;$('secretKey').value='';$('secretScope').value='private';resetSecretReveal();$('secretTitle').textContent='Create secret';$('secretToken').textContent='{{secret:key}}';renderSecrets();$('secretKey').focus()}
async function loadSecrets(){const r=await call('secretsList');secrets=r.secrets||[];renderSecrets()}
async function showSecrets(){$('secretModal').classList.remove('hidden');newSecret();await loadSecrets()}
$('secretForm').onsubmit=async e=>{e.preventDefault();const key=$('secretKey').value.trim(),value=$('secretValue').value,scope=$('secretScope').value;if(!key||!value)return toast('Key and value are required');await call('secretsSave',{key,value,scope});await loadSecrets();newSecret();toast('Secret saved')};
async function deleteSecret(){if(!selectedSecret||!await window.QReportsDialogs.confirm(`Delete secret '${selectedSecret.key}'?`))return;await call('secretsDelete',selectedSecret);await loadSecrets();newSecret();toast('Secret deleted')}
async function toggleSecret(button){const field=$('secretValue');if(field.type==='text'){field.type='password';field.value='';button.textContent='Show';return}if(selectedSecret){const result=await call('secretsReveal',selectedSecret);field.value=result.value||''}field.type='text';button.textContent='Hide'}
document.addEventListener('click',async e=>{if(!e.target.closest('#connectionMenu'))closeConnectionMenu();const b=e.target.closest('button[data-action]');if(!b)return;try{switch(b.dataset.action){case'new':newConnection();break;case'save':await save();break;case'test':await test();break;case'template':template();break;case'export':await openExport();break;case'import':await openImport();break;case'contextExport':closeConnectionMenu();await openExport();break;case'contextExportConnection':closeConnectionMenu();await openExport(true);break;case'confirmExport':await confirmExport();break;case'closeExport':$('exportModal').classList.add('hidden');break;case'toggleExportDefinitions':toggleDefinitions('export',b);break;case'confirmImport':await confirmImport();break;case'closeImport':$('importModal').classList.add('hidden');break;case'toggleImportDefinitions':toggleDefinitions('import',b);break;case'openApi':await call('connectionsOpenApi',{name:selectedName||$('name').value.trim()});break;case'secrets':await showSecrets();break;case'close':chrome.webview.postMessage({type:'closeWindow'});break;case'delete':await remove();break;case'browse':await browse();break;case'applyStructured':applyStructured();break;case'closeSecrets':document.body.classList.contains('secrets-only')?chrome.webview.postMessage({type:'closeWindow'}):$('secretModal').classList.add('hidden');break;case'newSecret':newSecret();break;case'showSecret':await toggleSecret(b);break;case'deleteSecret':await deleteSecret();break}}catch(err){setStatus('Error');toast(err.message||String(err))}});
document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));$('manualPanel').classList.toggle('hidden',b.dataset.tab!=='manual');$('structuredPanel').classList.toggle('hidden',b.dataset.tab!=='structured');if(b.dataset.tab==='structured')parseDetails()});
$('type').onchange=()=>{configureType();parseDetails()};$('mcpTransport').onchange=configureMcpTransport;$('search').oninput=renderConnections;$('secretKey').oninput=()=>$('secretToken').textContent=`{{secret:${$('secretKey').value.trim()||'key'}}`;$('exportFormat').onchange=updateExportFormat;
document.addEventListener('keydown',event=>{if(event.key!=='Escape')return;closeConnectionMenu();$('exportModal').classList.add('hidden');$('importModal').classList.add('hidden')});
chrome.webview.addEventListener('message',e=>{const m=e.data;if(m.type==='bridgeBusy'){setStatus('Working…','busy');return}if(m.type==='bridgeResult'){const p=pending.get(m.action);if(!p)return;pending.delete(m.action);if(m.result?.ok)p.resolve(m.result);else if(m.result?.cancelled)p.resolve(m.result);else p.reject(new Error(m.result?.error||'Operation failed'))}else if(m.type==='hostError'){toast(m.message)}});
window.addEventListener('DOMContentLoaded',()=>{const secretsOnly=new URLSearchParams(location.search).get('secrets')==='1';if(secretsOnly){document.body.classList.add('secrets-only');showSecrets().catch(e=>toast(e.message))}else{configureType();newConnection();loadConnections().catch(e=>toast(e.message))}chrome.webview.postMessage({type:'ready'})});
