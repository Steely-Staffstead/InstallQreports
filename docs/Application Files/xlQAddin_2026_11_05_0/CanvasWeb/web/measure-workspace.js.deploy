function matrixItemKind(name){
  return measures.some(metric=>+metric.Kind!==1&&String(metric.Name||'').toLowerCase()===String(name||'').toLowerCase())?'measure':'field';
}
function canUseMatrixRole(zone,name,kind=matrixItemKind(name)){
  return zone==='values'?kind==='measure':kind==='field';
}
function invalidMatrixRoleMessage(zone,kind){
  return kind==='measure'?`Measures can only be added to Values`:`Fields and calculated columns can only be added to Rows or Columns`;
}
function beginMatrixDrag(kind,name){
  activeMatrixDrag={kind,name};
  document.querySelectorAll('.matrix-builder .dropzone').forEach(target=>{
    const valid=canUseMatrixRole(target.dataset.zone,'',kind);
    target.classList.toggle('dropzone-valid',valid);
    target.classList.toggle('dropzone-invalid',!valid);
    target.setAttribute('aria-dropeffect',valid?'move':'none');
  });
}
function matrixDropItem(raw){
  const[payloadKind,...payloadParts]=String(raw||'').split(':'),payload=payloadParts.join(':');
  if(payloadKind==='field')return {kind:'field',name:payload||activeMatrixDrag?.name};
  if(payloadKind==='measure')return {kind:'measure',name:measures[+payload]?.Name||activeMatrixDrag?.name};
  return activeMatrixDrag?.kind&&activeMatrixDrag?.name?{kind:activeMatrixDrag.kind,name:activeMatrixDrag.name}:null;
}
function endMatrixDrag(){
  activeMatrixDrag=null;
  document.querySelectorAll('.matrix-builder .dragging,.matrix-builder .drop-before,.matrix-builder .dropzone-active,.matrix-builder .dropzone-invalid-active,.matrix-builder .dropzone-valid,.matrix-builder .dropzone-invalid').forEach(element=>element.classList.remove('dragging','drop-before','dropzone-active','dropzone-invalid-active','dropzone-valid','dropzone-invalid'));
  document.querySelectorAll('.matrix-builder .dropzone[aria-dropeffect]').forEach(target=>target.removeAttribute('aria-dropeffect'));
}
function addZone(zone,name,index,kind=matrixItemKind(name)){
  if(!name)return;
  if(!canUseMatrixRole(zone,name,kind)){
    toast(invalidMatrixRoleMessage(zone,kind));
    return false;
  }
  if(zone==='columns')zones.columns=[name];
  else{
    const old=zones[zone].indexOf(name);
    if(old>=0){
      zones[zone].splice(old,1);
      if(index!=null&&old<index)index--;
    }
    zones[zone].splice(index==null?zones[zone].length:index,0,name);
  }
  renderZones();
  return true;
}
function moveChip(raw,to,index){
  const[,from,position]=raw.split(':'),item=zones[from]?.[+position];
  if(!item)return;
  const kind=matrixItemKind(item);
  if(!canUseMatrixRole(to,item,kind)){
    toast(invalidMatrixRoleMessage(to,kind));
    return false;
  }
  zones[from].splice(+position,1);
  if(from===to&&+position<index)index--;
  return addZone(to,item,index,kind);
}
function removeMatrixChip(zone,name){
  const index=zones[zone]?.indexOf(name)??-1;
  if(index<0)return false;
  zones[zone].splice(index,1);
  renderZones();
  toast(`Removed ${name} from ${zone}`);
  return true;
}
function renderZones(){
  for(const zone of Object.keys(zones)){
    const target=$(zone);
    target.innerHTML=zones[zone].map((name,index)=>`<span class="chip" draggable="true" tabindex="0" data-chip="${zone}:${index}" title="Drag to reorder. Alt + Left/Right also moves this field."><span class="chip-handle" aria-hidden="true">⋮⋮</span><span class="chip-name">${esc(name)}</span><button type="button" class="chip-remove" draggable="false" data-remove="${zone}:${index}" aria-label="Remove ${esc(name)} from ${zone}" title="Remove ${esc(name)}">×</button></span>`).join('');
    target.ondragover=event=>{const valid=!activeMatrixDrag||canUseMatrixRole(zone,'',activeMatrixDrag.kind);event.preventDefault();event.dataTransfer.dropEffect=valid?'move':'none';target.classList.toggle('dropzone-active',valid);target.classList.toggle('dropzone-invalid-active',!valid);};
    target.ondragleave=event=>{if(!target.contains(event.relatedTarget))target.classList.remove('dropzone-active','dropzone-invalid-active');};
    target.ondrop=event=>{
      event.preventDefault();
      event.stopPropagation();
      target.classList.remove('dropzone-active','dropzone-invalid-active');
      const raw=event.dataTransfer.getData('text/plain');
      if(raw.startsWith('chip:'))moveChip(raw,zone,zones[zone].length);
      else{
        const item=matrixDropItem(raw);
        if(item)addZone(zone,item.name,null,item.kind);
      }
    };
  }
  document.querySelectorAll('.matrix-builder [data-chip]').forEach(chip=>{
    chip.onkeydown=event=>{
      const[zone,indexText]=chip.dataset.chip.split(':'),index=Number(indexText);
      if(event.altKey&&(event.key==='ArrowLeft'||event.key==='ArrowRight')){
        const next=index+(event.key==='ArrowLeft'?-1:1);
        if(next<0||next>=zones[zone].length)return;
        event.preventDefault();
        [zones[zone][index],zones[zone][next]]=[zones[zone][next],zones[zone][index]];
        renderZones();
        $(zone).querySelector(`[data-chip="${zone}:${next}"]`)?.focus();
      }
    };
    chip.ondragstart=event=>{
      if(event.target.closest('[data-remove]')){event.preventDefault();return;}
      event.dataTransfer.setData('text/plain',`chip:${chip.dataset.chip}`);
      event.dataTransfer.effectAllowed='move';
      const[zone,index]=chip.dataset.chip.split(':');
      activeMatrixChip={zone,name:zones[zone]?.[+index]};
      beginMatrixDrag(matrixItemKind(activeMatrixChip.name),activeMatrixChip.name);
      chip.classList.add('dragging');
    };
    chip.ondragend=()=>{endMatrixDrag();setTimeout(()=>activeMatrixChip=null,0)};
    chip.ondragover=event=>{const[to]=chip.dataset.chip.split(':'),valid=!activeMatrixDrag||canUseMatrixRole(to,'',activeMatrixDrag.kind);event.preventDefault();event.stopPropagation();event.dataTransfer.dropEffect=valid?'move':'none';document.querySelectorAll('.matrix-builder .drop-before').forEach(element=>element.classList.remove('drop-before'));if(valid)chip.classList.add('drop-before');};
    chip.ondragleave=()=>chip.classList.remove('drop-before');
    chip.ondrop=event=>{
      event.preventDefault();event.stopPropagation();
      const[to,index]=chip.dataset.chip.split(':'),raw=event.dataTransfer.getData('text/plain');
      if(raw.startsWith('chip:'))moveChip(raw,to,+index);
      else{
        const item=matrixDropItem(raw);
        if(item)addZone(to,item.name,+index,item.kind);
      }
    };
  });
  document.querySelectorAll('.matrix-builder [data-remove]').forEach(button=>{
    button.onclick=event=>{event.stopPropagation();const[zone,index]=button.dataset.remove.split(':');zones[zone].splice(+index,1);renderZones();};
  });
}
document.addEventListener('dragover',event=>{if(activeMatrixChip&&!event.target.closest('.dropzone'))event.preventDefault()});
document.addEventListener('drop',event=>{
  if(!activeMatrixChip||event.target.closest('.dropzone'))return;
  event.preventDefault();
  removeMatrixChip(activeMatrixChip.zone,activeMatrixChip.name);
  activeMatrixChip=null;
});
function format(v,f){if(v==null)return'';const n=Number(v),code=String(f||'Auto');if(/^auto$|^text$/i.test(code))return String(v);if(code==='integer'||/^N\d$/i.test(code)){const d=code==='integer'?0:+code.slice(1);return Number.isFinite(n)?n.toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d}):String(v)}if(code==='number')return Number.isFinite(n)?n.toLocaleString():String(v);if(code==='percent'||/^P\d$/i.test(code)){const d=code==='percent'?0:+code.slice(1);return Number.isFinite(n)?`${(n*100).toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d})}%`:String(v)}if(/^[KM]\d$/i.test(code)){const scale=code[0].toUpperCase()==='K'?1e3:1e6,d=+code[1],suffix=code[0].toUpperCase();return Number.isFinite(n)?`${(n/scale).toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d})}${suffix}`:String(v)}if(code==='excelDate'){const d=new Date(Date.UTC(1899,11,30)+n*86400000);return isNaN(d)?v:d.toLocaleDateString()}if(/y|M{3}/.test(code)){const d=v instanceof Date?v:new Date(v);if(!isNaN(d))return code==='MMM yyyy'?d.toLocaleDateString(undefined,{month:'short',year:'numeric'}):d.toLocaleDateString('sv-SE')}if(Number.isFinite(n)&&/[#0]/.test(code)){const decimal=Math.max(code.lastIndexOf('.'),code.lastIndexOf(',')),digits=decimal>=0?(code.slice(decimal+1).match(/[0#]/g)||[]).length:0,group=/[.,].*[0#]/.test(code);return n.toLocaleString(undefined,{useGrouping:group,minimumFractionDigits:(code.slice(decimal+1).match(/0/g)||[]).length,maximumFractionDigits:Math.min(10,digits)})}return String(v)}
function applyMeasureFormats(result){const names=(result?.columns||[]).map(columnName);if(zones.columns.length&&zones.values.length){for(let i=zones.rows.length;i<names.length;i++){const metric=measures.find(m=>m.Name===zones.values[(i-zones.rows.length)%zones.values.length]);if(metric?.FormatString)view.formats.set(i,metric.FormatString)}}else names.forEach((name,i)=>{const metric=measures.find(m=>String(m.Name).toLowerCase()===String(name).toLowerCase());if(metric?.FormatString)view.formats.set(i,metric.FormatString)})}
function pivotResult(result){const names=(result.columns||[]).map(columnName);if(!zones.columns.length){const requested=[...zones.rows,...zones.values],indexes=requested.map(name=>names.indexOf(name)).filter((index,position,list)=>index>=0&&list.indexOf(index)===position),filtered=indexes.length?{columns:indexes.map(index=>result.columns[index]),rows:(result.rows||[]).map(row=>indexes.map(index=>row[index]))}:result;applyMeasureFormats(filtered);return filtered}const rowIdx=zones.rows.map(x=>names.indexOf(x)).filter(x=>x>=0),colIdx=names.indexOf(zones.columns[0]),valNames=zones.values.length?zones.values:names.filter((_,i)=>!rowIdx.includes(i)&&i!==colIdx),valIdx=valNames.map(x=>names.indexOf(x));if(colIdx<0||!valIdx.length){applyMeasureFormats(result);return result}const colValues=[...new Set((result.rows||[]).map(r=>String(r[colIdx]??'')))],groups=new Map();for(const r of result.rows||[]){const key=JSON.stringify(rowIdx.map(i=>r[i]));if(!groups.has(key))groups.set(key,[...rowIdx.map(i=>r[i]),...Array(colValues.length*valIdx.length).fill(null)]);const target=groups.get(key),ci=colValues.indexOf(String(r[colIdx]??''));valIdx.forEach((vi,j)=>target[rowIdx.length+ci*valIdx.length+j]=r[vi])}const columns=[...zones.rows,...colValues.flatMap(c=>valNames.map(v=>valNames.length===1?c:`${c} · ${v}`))],pivoted={columns,rows:[...groups.values()]};applyMeasureFormats(pivoted);return pivoted}
function renderResult(result){view.data=result||{columns:[],rows:[]};const cols=view.data.columns||[],visible=cols.map((c,i)=>({c,i})).filter(x=>!view.hidden.has(x.i));let rows=[...(view.data.rows||[])];if(view.sort>=0&&view.dir)rows.sort((a,b)=>String(a[view.sort]??'').localeCompare(String(b[view.sort]??''),undefined,{numeric:true})*view.dir);$('resultHead').innerHTML=`<tr>${visible.map(x=>`<th data-col="${x.i}">${esc(columnName(x.c))}${view.sort===x.i?(view.dir===1?' ▲':' ▼'):''}</th>`).join('')}</tr>`;$('resultBody').innerHTML=rows.map(r=>`<tr>${visible.map(x=>`<td>${esc(format(r[x.i],view.formats.get(x.i)||'auto'))}</td>`).join('')}</tr>`).join('');$('resultCount').textContent=`${rows.length} row(s) · ${cols.length} column(s)`;document.querySelectorAll('[data-col]').forEach(th=>{th.onclick=()=>{const i=+th.dataset.col;if(view.sort!==i){view.sort=i;view.dir=1}else if(view.dir===1)view.dir=-1;else{view.sort=-1;view.dir=0}renderResult(view.data)};th.oncontextmenu=e=>{e.preventDefault();columnMenu(e,+th.dataset.col)}})}
function columnMenu(e,index){const cols=view.data.columns||[],menu=$('columnMenu');menu.style.left=`${Math.min(e.clientX,innerWidth-290)}px`;menu.style.top=`${Math.min(e.clientY,innerHeight-500)}px`;menu.innerHTML=`<b>${esc(columnName(cols[index]))}</b><button data-sort="1">Sort ascending</button><button data-sort="-1">Sort descending</button><button data-sort="0">Clear sorting</button><label>Format <select id="fmt"><option value="auto">Auto</option><option value="number">Number</option><option value="integer">Integer</option><option value="percent">Percent</option><option value="excelDate">Excel date</option><option value="text">Text</option></select></label><hr><b>Visible columns</b>${cols.map((c,i)=>`<label><input type="checkbox" data-visible="${i}" ${view.hidden.has(i)?'':'checked'}> ${esc(columnName(c))}</label>`).join('')}`;menu.classList.remove('hidden');$('fmt').value=view.formats.get(index)||'auto';$('fmt').onchange=x=>{view.formats.set(index,x.target.value);renderResult(view.data);menu.classList.add('hidden')};menu.querySelectorAll('[data-sort]').forEach(b=>b.onclick=()=>{view.sort=+b.dataset.sort?index:-1;view.dir=+b.dataset.sort;renderResult(view.data);menu.classList.add('hidden')});menu.querySelectorAll('[data-visible]').forEach(x=>x.onchange=()=>{x.checked?view.hidden.delete(+x.dataset.visible):view.hidden.add(+x.dataset.visible);renderResult(view.data)})}
function hideMenus(){$('columnMenu').classList.add('hidden');$('fieldMenu').classList.add('hidden')}function setupResizers(){document.querySelectorAll('[data-collapse]').forEach(b=>b.onclick=()=>$('layout').classList.add(`${b.dataset.collapse}-collapsed`));document.querySelectorAll('[data-expand]').forEach(b=>b.onclick=()=>$('layout').classList.remove(`${b.dataset.expand}-collapsed`));document.querySelectorAll('[data-resize]').forEach(bar=>bar.onpointerdown=e=>{e.preventDefault();const kind=bar.dataset.resize,start=e.clientX,initial=parseFloat(getComputedStyle(document.documentElement).getPropertyValue(`--${kind}`));bar.setPointerCapture(e.pointerId);bar.onpointermove=m=>document.documentElement.style.setProperty(`--${kind}`,`${Math.max(150,initial+m.clientX-start)}px`);bar.onpointerup=()=>bar.onpointermove=null});$('matrixSplitter').onpointerdown=e=>{const start=e.clientY,initial=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--editor'));$('matrixSplitter').setPointerCapture(e.pointerId);$('matrixSplitter').onpointermove=m=>document.documentElement.style.setProperty('--editor',`${Math.max(120,initial+m.clientY-start)}px`);$('matrixSplitter').onpointerup=()=> $('matrixSplitter').onpointermove=null}}
async function validateCurrent(){saveDraft();const metric=measures[selected]||{},parameters=query.parameters||query.Parameters||[],typeIssue=(+metric.Kind||0)===1?formulaTypeIssue(metric.Expression):'';if(typeIssue)throw new Error(typeIssue);const useFullQuery=(+metric.Kind||0)!==1&&!!query.queryText&&(Number(query.totalRows)>data.rows.length||(Number(query.totalRows)<=0&&Number(query.previewLimit)>0&&data.rows.length>=Number(query.previewLimit)));const r=await call('daxValidate',{name:metric.Name,expression:metric.Expression,kind:+metric.Kind||0,dataType:metric.DataType||'',dataTypeIsExplicit:!!metric.DataTypeIsExplicit,formatString:metric.FormatString||'',metrics:measures,parameters,data,query:useFullQuery?{connectionName:query.connectionName,queryText:query.queryText,parameters}:undefined,useFullQuery});if(r.data){data=r.data;query.data=data;const ci=(data.columns||[]).findIndex(c=>columnName(c).toLowerCase()===String(metric.Name).toLowerCase());if(ci>=0&&!metric.DataType){const type=String(data.types?.[ci]||'').split('.').pop();metric.DataType=/Int16|Int32|Int64/i.test(type)?'Integer':/Date/i.test(type)?'Date':/String|Char/i.test(type)?'Text':/Boolean/i.test(type)?'Boolean':'Number'}$('dataStatus').textContent=`${data.rows.length} rows loaded`;renderFields();renderMeasures();renderCalculatedColumnSettings()}$('validation').className='validation ok';$('validation').textContent=`${r.message}${r.value==null?'':` Result: ${r.value}`}`;return r}
$('insertColorValue').onclick=openColorValueDialog;$('applyColorValue').onclick=insertColorValue;$('colorValueDialog').querySelectorAll('[name="measureColorSource"]').forEach(input=>input.onchange=refreshColorValueDialog);$('measureColorThemeRole').onchange=refreshColorValueDialog;$('measureColorManual').oninput=refreshColorValueDialog;
$('calculatedColumnType').onchange=()=>{const metric=measures[selected];if(+metric?.Kind!==1)return;const type=$('calculatedColumnType').value;metric.DataType=type;metric.DataTypeIsExplicit=!!type;if(type==='Integer')metric.FormatString='N0';else if(type==='Number'&&!/^N\d+$/i.test(metric.FormatString||''))metric.FormatString='N2';else if(type==='Date'&&!metric.FormatString)metric.FormatString='yyyy-MM-dd';else if(['','Text','Boolean'].includes(type))metric.FormatString='';renderCalculatedColumnSettings();renderMeasures()};
$('calculatedColumnFormat').oninput=updateCalculatedColumnSettings;
$('loadData').onclick=async()=>{try{$('status').textContent='Loading…';const r=await call('daxLoad',{query,metrics:measures,parameters:query.parameters||query.Parameters||[]});data=r.data;query.data=data;query.totalRows=r.totalRows??data.rows.length;$('dataStatus').textContent=`${data.rows.length} of ${query.totalRows} rows loaded`;renderFields();$('status').textContent='Ready'}catch(e){toast(e.message);$('status').textContent='Error'}};$('newMeasure').onclick=newMeasure;$('newCalculatedColumn').onclick=newCalculatedColumn;$('save').onclick=async()=>{saveDraft();renderMeasures();try{if(+measures[selected]?.Kind===1&&data.columns?.length)await validateCurrent();toast(`${+measures[selected]?.Kind===1?'Calculated column':'Measure'} saved in workspace`)}catch(e){$('validation').className='validation error';$('validation').textContent=e.message}};$('delete').onclick=()=>{if(selected<0)return;measures.splice(selected,1);selected=-1;$('name').value='';$('expression').value='';renderCalculatedColumnSettings();renderMeasures()};$('validate').onclick=async()=>{try{await validateCurrent()}catch(e){$('validation').className='validation error';$('validation').textContent=e.message}};$('testMatrix').onclick=async()=>{saveDraft();try{const r=await call('daxMatrix',{metrics:measures,parameters:query.parameters||query.Parameters||[],data,...zones});renderResult(pivotResult(r.data))}catch(e){toast(e.message)}};$('apply').onclick=()=>{saveDraft();chrome.webview.postMessage({type:'measureApply',measures})};$('close').onclick=()=>chrome.webview.postMessage({type:'closeWindow'});$('fieldSearch').oninput=renderFields;$('measureSearch').oninput=renderMeasures;$('name').oninput=()=>{saveDraft();renderMeasures()};document.onpointerdown=e=>{if(!e.target.closest('.menu'))hideMenus()};chrome.webview.addEventListener('message',e=>{const m=e.data;if(m.type==='loadMeasureWorkspace'){query=m.query||{};reportDocument=m.document||null;reportSourceId=m.sourceId||'main';unusedMeasureNames.clear();measu