function setupExpressionResize(){const handle=document.getElementById("expressionResizeHandle");if(!handle)return;handle.addEventListener("pointerdown",event=>{event.preventDefault();const start=event.clientY,initial=parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--editor"));handle.setPointerCapture(event.pointerId);handle.onpointermove=move=>document.documentElement.style.setProperty("--editor",Math.max(120,Math.min(480,initial+move.clientY-start))+"px");handle.onpointerup=()=>handle.onpointermove=null;});}

let quickMeasureAiRequest='';
function cleanMeasureAi(value){return String(value||'').trim().replace(/^```(?:dax|minidax)?\s*/i,'').replace(/\s*```$/,'').trim()}
function openQuickMeasureAi(){if(selected<0){toast('Select or create a measure first');return}let modal=$('quickMeasureAi');if(!modal){modal=document.createElement('div');modal.id='quickMeasureAi';modal.className='modal';modal.innerHTML=`<div class="dialog"><div class="filter-head"><div><h2>Ask AI for a measure</h2><p class="muted">Uses the selected measure, available fields and existing measures. No workspace is required.</p></div><button data-ai-close>×</button></div><label>What should the measure calculate?<textarea data-ai-question rows="4"></textarea></label><label>Suggested expression<textarea data-ai-result rows="10" spellcheck="false"></textarea></label><p data-ai-status role="status"></p><div class="dialog-actions"><button data-ai-instructions>Shared instructions…</button><button data-ai-apply>Use expression</button><button class="primary" data-ai-send>Generate</button></div></div>`;document.body.append(modal);modal.querySelector('[data-ai-close]').onclick=()=>modal.remove();modal.querySelector('[data-ai-instructions]').onclick=()=>chrome.webview.postMessage({type:'openAiInstructionsFolder'});modal.querySelector('[data-ai-send]').onclick=()=>{const question=modal.querySelector('[data-ai-question]').value.trim();if(!question)return;saveDraft();quickMeasureAiRequest=crypto.randomUUID();modal.querySelector('[data-ai-status]').textContent='Generating…';chrome.webview.postMessage({type:'quickAiRequest',requestId:quickMeasureAiRequest,scope:'measures',question,context:{selected:measures[selected],fields:(data.columns||[]).map(columnName),measures:measures.map(metric=>({name:metric.Name,expression:metric.Expression,kind:metric.Kind}))}})};modal.querySelector('[data-ai-apply]').onclick=()=>{$('expression').value=cleanMeasureAi(modal.querySelector('[data-ai-result]').value);$('expression').dispatchEvent(new Event('input',{bubbles:true}));saveDraft();modal.remove()};}modal.querySelector('[data-ai-question]').focus()}
(()=>{const button=document.createElement('button');button.type='button';button.dataset.focusedAiHelp='';button.textContent='Code / AI';button.title='Open measure code and AI workbench';button.onclick=openQuickMeasureAi;document.querySelector('header nav #validate')?.before(button)})();
chrome.webview.addEventListener('message',event=>{const message=event.data;if(message?.type!=='quickAiResult'||message.scope!=='measures'||message.requestId!==quickMeasureAiRequest)return;const modal=$('quickMeasureAi');if(!modal)return;modal.querySelector('[data-ai-status]').textContent=message.error||'Suggestion ready';if(!message.error)modal.querySelector('[data-ai-result]').value=cleanMeasureAi(message.text)});

let quickMeasureAiStarted=0,quickMeasureAiClock=0;
function miniDaxAiContract(){return{dialect:'QReports MiniDAX (not Microsoft or Power BI DAX)',functionCatalog:(globalThis.MiniDaxFunctionCatalog||[]).map(item=>({name:item[0],signature:item[1],description:item[2],example:item[3]})),rules:['Use only functions in functionCatalog.','MAX(column) returns the greatest value in the current filter context. LAST(expression) returns the last nonblank source row and must not be used as a synonym for MAX.','CALCULATE supports simple column comparisons plus ALL and REMOVEFILTERS.','SUMX, FILTER, ADDCOLUMNS, SUMMARIZE, RELATED, SAMEPERIODLASTYEAR, DATESYTD, DATEADD and RANKX are not supported.','Measures require explicit aggregation for source fields. Calculated columns must not use aggregate or context functions.','Use brackets around field or measure names containing spaces, punctuation or periods.','Return an expression only, without a measure name, leading equals sign, Markdown or explanation.']}}
function quickMeasureAiContext(){saveDraft();const metric=measures[selected]||{};return{miniDax:miniDaxAiContract(),selected:{name:metric.Name,expression:metric.Expression,kind:metric.Kind,formatString:metric.FormatString,dataType:metric.DataType,folder:metric.Folder},fields:(data.columns||[]).map((column,index)=>({name:columnName(column),type:data.types?.[index]||''})),measures:measures.map(item=>({name:item.Name,expression:item.Expression,kind:item.Kind,formatString:item.FormatString,dataType:item.DataType,folder:item.Folder})),parameters:query.parameters||query.Parameters||[]}}
async function validateMeasureAiDraft(expression){const value=cleanMeasureAi(expression),metric=measures[selected]||{},parameters=query.parameters||query.Parameters||[];if(!value)throw new Error('The MiniDAX expression is empty.');const useFullQuery=(+metric.Kind||0)!==1&&!!query.queryText&&(Number(query.totalRows)>data.rows.length||(Number(query.totalRows)<=0&&Number(query.previewLimit)>0&&data.rows.length>=Number(query.previewLimit))),result=await call('daxValidate',{name:metric.Name||'AI draft',expression:value,kind:+metric.Kind||0,metrics:measures,parameters,data,query:useFullQuery?{connectionName:query.connectionName,queryText:query.queryText,parameters}:undefined,useFullQuery});return`${result.message||'Formula is valid.'}${result.value==null?'':` Result: ${result.value}`}`}
function setQuickMeasureAiBusy(panel,busy,status){if(!panel)return;panel.dataset.aiBusy=busy?'true':'false';panel.querySelector('[data-ai-send]').disabled=busy;panel.querySelector('[data-ai-cancel]').hidden=!busy;panel.querySelector('[data-ai-status]').textContent=status||'';clearInterval(quickMeasureAiClock);quickMeasureAiClock=0;if(busy){quickMeasureAiStarted=Date.now();const base=status||'Generating';quickMeasureAiClock=setInterval(()=>{const current=$('quickMeasureAiPanel');if(!current||current.dataset.aiBusy!=='true'){clearInterval(quickMeasureAiClock);return}const seconds=Math.floor((Date.now()-quickMeasureAiStarted)/1000);current.querySelector('[data-ai-status]').textContent=`${base.replace(/….*$/,'')}… ${seconds}s`},1000)}}
function cancelQuickMeasureAi(panel,closing=false){if(panel?.dataset.aiBusy==='true'&&quickMeasureAiRequest)chrome.webview.postMessage({type:'quickAiCancel',requestId:quickMeasureAiRequest});setQuickMeasureAiBusy(panel,false,closing?'':'Cancelled')}
function closeQuickMeasureAiPanel(){const panel=$('quickMeasureAiPanel');cancelQuickMeasureAi(panel,true);document.body.classList.remove('measure-ai-panel-docked');panel?.remove()}
function setQuickMeasureAiLayout(panel,docked){panel.classList.toggle('docked',docked);panel.classList.toggle('floating',!docked);document.body.classList.toggle('measure-ai-panel-docked',docked);panel.querySelector('[data-ai-dock]').textContent=docked?'Float':'Dock';panel.querySelector('[data-ai-dock]').title=docked?'Show as a floating, movable panel':'Dock on the right';localStorage.setItem('qreports-measure-ai-layout',docked?'dock':'float')}
function makeQuickMeasureAiDraggable(panel){const handle=panel.querySelector('.quick-ai-head');handle.addEventListener('pointerdown',event=>{if(panel.classList.contains('docked')||event.target.closest('button'))return;event.preventDefault();const rect=panel.getBoundingClientRect(),offsetX=event.clientX-rect.left,offsetY=event.clientY-rect.top;handle.setPointerCapture(event.pointerId);handle.onpointermove=move=>{panel.style.left=Math.max(0,Math.min(innerWidth-panel.offsetWidth,move.clientX-offsetX))+'px';panel.style.top=Math.max(0,Math.min(innerHeight-panel.offsetHeight,move.clientY-offsetY))+'px';panel.style.right='auto'};handle.onpointerup=()=>{handle.onpointermove=null;handle.onpointerup=null}})}
function openQuickMeasureAiPanel(){if(selected<0){toast('Select or create a measure first');return}let panel=$('quickMeasureAiPanel');if(panel){panel.querySelector('[data-ai-question]').focus();return}panel=document.createElement('aside');panel.id='quickMeasureAiPanel';panel.className='quick-ai-panel';panel.innerHTML=`<div class="quick-ai-head"><strong>✦ Ask AI for a measure</strong><button type="button" data-ai-dock>Dock</button><button type="button" data-ai-close title="Close">×</button></div><div class="quick-ai-body"><p class="muted">Uses the configured CLI and automatically includes the selected expression, fields, measures and parameters. Requests stop after two minutes.</p><label>What should the measure calculate?<textarea data-ai-question rows="4" placeholder="For example: calculate rolling 12-month revenue"></textarea><small>The current measure context is included automatically.</small></label><div class="quick-ai-submit"><button type="button" data-ai-send>Generate</button><button type="button" data-ai-cancel hidden>Cancel</button></div><label class="quick-ai-result-label">Suggested expression<textarea data-ai-result spellcheck="false" placeholder="The MiniDAX suggestion appears here"></textarea></label><p class="quick-ai-status" data-ai-status role="status"></p><div class="quick-ai-actions"><button type="button" data-ai-instructions>Shared instructions…</button><button type="button" data-ai-apply>Use expression</button></div></div>`;document.body.append(panel);setQuickMeasureAiLayout(panel,localStorage.getItem('qreports-measure-ai-layout')==='dock');makeQuickMeasureAiDraggable(panel);const send=panel.querySelector('[data-ai-send]'),question=panel.querySelector('[data-ai-question]');panel.querySelector('[data-ai-close]').onclick=closeQuickMeasureAiPanel;panel.querySelector('[data-ai-dock]').onclick=()=>setQuickMeasureAiLayout(panel,!panel.classList.contains('docked'));panel.querySelector('[data-ai-instructions]').onclick=()=>chrome.webview.postMessage({type:'openAiInstructionsFolder'});panel.querySelector('[data-ai-cancel]').onclick=()=>cancelQuickMeasureAi(panel);send.onclick=()=>{const text=question.value.trim();if(!text)return;quickMeasureAiRequest=crypto.randomUUID();setQuickMeasureAiBusy(panel,true,'Preparing measure context…');chrome.webview.postMessage({type:'quickAiRequest',requestId:quickMeasureAiRequest,scope:'measures',question:text,context:quickMeasureAiContext()})};question.addEventListener('keydown',event=>{if(event.key==='Enter'&&(event.ctrlKey||event.metaKey)){event.preventDefault();send.click()}});panel.querySelector('[data-ai-apply]').onclick=()=>{$('expression').value=cleanMeasureAi(panel.querySelector('[data-ai-result]').value);$('expression').dispatchEvent(new Event('input',{bubbles:true}));saveDraft();$('expression').focus()};question.focus()}
openQuickMeasureAi=openQuickMeasureAiPanel;
document.querySelectorAll('header nav button').forEach(button=>{if(button.textContent.includes('Ask AI'))button.onclick=openQuickMeasureAiPanel});
chrome.webview.addEventListener('message',event=>{const message=event.data;if(!['quickAiProgress','quickAiResult'].includes(message?.type)||message.scope!=='measures'||message.requestId!==quickMeasureAiRequest)return;const panel=$('quickMeasureAiPanel');if(!panel)return;if(message.type==='quickAiProgress'){setQuickMeasureAiBusy(panel,true,message.text||'Generating…');return}setQuickMeasureAiBusy(panel,false,message.error||'Suggestion ready');if(!message.error)panel.querySelector('[data-ai-result]').value=cleanMeasureAi(message.text)});

(()=>{const menu=$('measureToolsMenu')?.querySelector(':scope>div'),rename=$('renameMeasure'),functions=$('showDaxFunctions'),remove=$('delete'),apply=$('apply'),close=$('close');if(!menu)return;const divider=document.createElement('hr'),fragment=document.createDocumentFragment();for(const button of [rename,functions,remove]){if(!button)continue;if(button===remove)button.classList.add('toolbar-menu-danger');fragment.append(button)}fragment.append(divider);menu.prepend(fragment);if(apply){apply.textContent='Return';apply.title='Return measures to Qanvas'}if(close){close.textContent='Close';close.title='Close Measures'}})();

// Measures use the same manual-first workbench as SQL, SVG and HTML.
let sharedMeasureWorkbench=null;
function openSharedMeasureWorkbench(){
 if(selected<0){toast('Select or create a measure first');return}
 if(sharedMeasureWorkbench?.root?.isConnected){sharedMeasureWorkbench.focus();return}
 sharedMeasureWorkbench=globalThis.QanvasDesignerAi?.create({
  mode:'floating',dockable:true,defaultLayout:'floating',layoutStorageKey:'qreports-measure-designer-ai-layout',title:'Measure Designer',scope:'measures',language:'minidax',codeLabel:'MiniDAX expression',
  intro:'Edit or paste the expression directly. Focused AI is optional and only becomes active after a CLI is tested in Settings.',
  getCode:()=>$('expression').value,getContext:()=>quickMeasureAiContext(),
  parseResponse:value=>({message:'Measure draft ready to review.',code:cleanMeasureAi(value)}),
  validateDraft:value=>validateMeasureAiDraft(value),
  onApply:value=>{$('expression').value=cleanMeasureAi(value);$('expression').dispatchEvent(new Event('input',{bubbles:true}));saveDraft();$('expression').focus();sharedMeasureWorkbench.status.textContent='Expression applied'},
  onLayoutChange:layout=>document.body.classList.toggle('measure-designer-ai-docked',layout==='embedded'),
  onClose:()=>{document.body.classList.remove('measure-designer-ai-docked');sharedMeasureWorkbench=null}
 });
 sharedMeasureWorkbench?.focus()
}
if(globalThis.QanvasDesignerAi){
 openQuickMeasureAi=openSharedMeasureWorkbench;
 document.querySelectorAll('header nav button').forEach(button=>{if(button.matches('[data-focused-ai-help]')||button.textContent.includes('Ask AI')){button.hidden=false;button.textContent='Code / AI';button.title='Open measure code and AI workbench';button.onclick=openSharedMeasureWorkbench}});
}
