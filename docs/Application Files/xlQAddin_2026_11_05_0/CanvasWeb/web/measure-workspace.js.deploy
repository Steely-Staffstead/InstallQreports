$('close').onclick=()=>{saveDraft();if(measureSignature()!==returnedMeasureSignature&&!confirm('Saved measure changes have not been returned to Qanvas. Close without Return measures?'))return;chrome.webview.postMessage({type:'closeWindow'});};
