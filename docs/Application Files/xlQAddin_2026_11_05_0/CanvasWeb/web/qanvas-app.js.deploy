      if (blockComment) { output += char; if (char === "*" && next === "/") { output += next; index++; blockComment = false; } continue; }
      if (quote) { output += char; if (escaped) escaped = false; else if (char === "\\") escaped = true; else if (char === quote) quote = ""; continue; }
      if (char === "/" && next === "/") { output += char + next; index++; lineComment = true; continue; }
      if (char === "/" && next === "*") { output += char + next; index++; blockComment = true; continue; }
      if (char === "'" || char === '"' || char === "`") { quote = char; output += char; continue; }
      if (char === "(") { parens++; output += char; continue; }
      if (char === ")") { parens = Math.max(0, parens - 1); output += char; continue; }
      if (char === "{") { output = output.trimEnd() + " {"; indent++; newline(); continue; }
      if (char === "}") { indent = Math.max(0, indent - 1); output = output.trimEnd(); newline(); output += "}"; if (![";", ",", ")", "]"].includes(next)) newline(); continue; }
      if (char === ";" && parens === 0) { output += char; newline(); continue; }
      if (char === "\n" || char === "\r") { if (char === "\n" && output.trimEnd() && !output.endsWith("\n")) newline(); continue; }
