    return formatted;
  }

  function formatSource(path, source) {
    const filePath = String(path || "").toLowerCase();
    if (filePath.endsWith(".html")) return formatMarkup(source);
    if (filePath.endsWith(".css")) return formatCode(source);
    if (filePath.endsWith(".js")) return formatJavaScript(source);
    return String(source || "");
  }

  const explicitWholeAppReplacement = prompt => /\b(?:replace|rebuild|redesign)\s+(?:the\s+)?(?:entire|whole)\s+app\b|\bstart\s+(?:the\s+app\s+)?over\b|\bfrom\s+scratch\b|\berstatt\s+hele\s+appen\b|\bbygg\s+hele\s+appen\s+p[åa]\s+nytt\b|\blag\s+en\s+helt\s+ny\s+app\b/i.test(String(prompt || ""));
  const exactOccurrences = (source, search) => { let count = 0, index = 0; if (!search) return 0; while ((index = source.indexOf(search, index)) >= 0) { count++; index += search.length; } return count; };

  function aiDefinition(text, current, prompt = "") {
    let source = String(text || "").trim().replace(/^```(?:json)?\s*/i, "").replace(/\s*```$/, "");
    let value;
    try { value = JSON.parse(source); }
    catch {
      const first = source.indexOf("{"), last = source.lastIndexOf("}");
      if (first < 0 || last <= first) return { definition: copy(current), assistantMessage: source || "I could not produce a response.", changed: false };
      value = JSON.parse(source.slice(first, last + 1));
    }
    const result = copy(current), before = JSON.stringify({ name: result.name, currentSpec: result.currentSpec, bindings: result.bindings, files: result.files }), incoming = Array.isArray(value.files)
      ? value.files
      : Object.entries(value.files || {}).map(([path, content]) => ({ path, content })), edits = Array.isArray(value.edits) ? value.edits : [];
    if (incoming.length && edits.length) throw new Error("App AI returned both full files and exact edits. The draft was left unchanged.");
    const allowed = new Set(requiredFiles), byPath = new Map(result.files.map(file => [file.path, file])), unsupported = [];
    for (const edit of edits) {
      const path = String(edit?.path || "").replace(/\\/g, "/"), currentFile = byPath.get(path), search = typeof edit?.search === "string" ? edit.search : "";
      if (!allowed.has(path)) { unsupported.push(path || "(missing path)"); continue; }
      if (!currentFile) throw new Error(`The current app does not contain ${path}.`);
      if (!search) throw new Error(`App AI returned an empty search value for ${path}. The draft was left unchanged.`);
      if (typeof edit?.replace !== "string") throw new Error(`App AI did not return replacement text for ${path}. The draft was left unchanged.`);
      const matches = exactOccurrences(currentFile.content, search);
      if (matches !== 1) throw new Error(`The App AI edit for ${path} matched ${matches} places instead of exactly one. The draft was left unchanged.`);
      const content = currentFile.content.replace(search, edit.replace);
      if (content.length > 750_000) throw new Error(`${path} is too large for an embedded app.`);
      byPath.set(path, { ...currentFile, content });
    }
    for (const candidate of incoming) {
      const path = String(candidate?.path || "").replace(/\\/g, "/");
      if (!allowed.has(path)) { unsupported.push(path || "(missing path)"); continue; }
      const content = String(candidate?.content ?? ""), previous = byPath.get(path)?.content ?? "";
      if (content.length > 750_000) throw new Error(`${path} is too large for an embedded app.`);
      if (!explicitWholeAppReplacement(prompt) && previous.length >= 4_000 && content !== previous)
        throw new Error(`App AI tried to replace the complete ${path} during a targeted change. The draft was protected; use an exact edit instead.`);
      byPath.set(path, { path, type: path.endsWith(".html") ? "text/html" : path.endsWith(".css") ? "text/css" : "text/javascript", content });
    }
    if (unsupported.length) throw new Error(`App AI returned unsupported file${unsupported.length === 1 ? "" : "s"}: ${unsupported.join(", ")}. Use only index.html, styles.css and app.js.`);
    result.files = requiredFiles.map(path => byPath.get(path)).filter(Boolean);
    if (result.files.length !== requiredFiles.length) throw new Error("The app must contain index.html, styles.css and app.js.");
