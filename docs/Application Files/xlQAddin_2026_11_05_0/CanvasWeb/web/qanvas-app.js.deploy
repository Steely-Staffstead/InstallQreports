    const requirementQueue = [];
    draft.currentSpec = String(draft.currentSpec || "").slice(0, 1200);
    draft.designHistory = Array.isArray(draft.designHistory) ? draft.designHistory.slice(-6) : [];
    draft.bindings = normalizeBindings(draft.bindings);
    draft.assets = normalizeAssets(draft.assets);
    draft.permissions ||= {};
    draft.permissions.external = normalizeExternalPermissions(draft.permissions.external);
    const dialog = document.createElement("dialog");
    dialog.className = "qanvas-app-designer";
    dialog.innerHTML = `<form method="dialog">
      <header><div><h2>App designer</h2><p>Iterate on a sandboxed mini-app with AI and a live canvas-themed preview.</p></div><div class="qanvas-app-designer-header-actions"><span data-app-designer-save-state>Draft</span><button type="button" data-app-designer-preview-refresh title="Refresh preview" aria-label="Refresh preview">↻</button><button type="button" data-app-advanced-settings aria-expanded="false">Advanced settings</button><button value="cancel" aria-label="Close">×</button></div></header>
      <div class="qanvas-app-designer-body">
        <section class="qanvas-app-preview-panel"><div class="qanvas-app-designer-section-title"><b>Live preview</b><div class="qanvas-app-preview-actions"><small>Canvas theme · selected source context</small><button type="button" data-app-preview-mode="inspect" aria-pressed="false">Select</button><button type="button" data-app-preview-mode="interact" aria-pressed="true">Interact</button></div></div><iframe title="App preview" sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe></section>
        <div class="qanvas-app-splitter" data-app-splitter="main" role="separator" aria-label="Resize preview and AI panes" aria-orientation="vertical" tabindex="0"></div>
        <section class="qanvas-app-ai-panel">
          <div class="qanvas-app-designer-section-title"><div><b>✦ Design with AI</b><small data-app-ai-provider>${html(options.provider || "Configured CLI")}</small></div></div>
          <details class="qanvas-app-current-spec"><summary><span>Current scope</span><small>A brief, persistent summary of the app being built.</small></summary><textarea data-app-current-spec maxlength="1200" rows="4" placeholder="The main behavior, data and interactions of this app…"></textarea></details>
          <div class="qanvas-app-ai-chat" data-app-ai-chat><p class="assistant">Enter changes to the app. AI can inspect the whole Qanvas document in a read-only designer context. The app itself remains limited to its selected sources and declared permissions.</p></div>
          <div class="qanvas-app-splitter" data-app-splitter="chat" role="separator" aria-label="Resize chat history" aria-orientation="horizontal" tabindex="0"></div>
          <label class="qanvas-app-ai-compose"><span>Describe changes to the app</span><textarea data-app-ai-question rows="5" placeholder="For example: Add a region selector and show revenue in the tooltip."></textarea></label>
          <div class="qanvas-app-ai-attachment-tools"><input type="file" data-app-ai-attachment-input multiple hidden><button type="button" data-app-ai-attachment-add>＋ Attach files</button><small>Paste a screenshot here, or drag and drop images and files.</small></div>
          <div class="qanvas-app-ai-attachments" data-app-ai-attachments hidden></div>
          <details class="qanvas-app-ai-queue"><summary>Requirements queue <span data-app-ai-queue-count>0</span></summary><div data-app-ai-queue-list></div></details>
          <div class="qanvas-app-ai-actions"><small data-app-ai-status>${options.requestAi ? "Ready" : "AI requires the desktop application and a configured CLI."}</small><button type="button" class="primary" data-app-ai-send ${options.requestAi ? "" : "disabled"}>Send</button></div>
          <details class="qanvas-app-advanced"><summary hidden>Advanced settings</summary><div class="qanvas-app-advanced-body">
