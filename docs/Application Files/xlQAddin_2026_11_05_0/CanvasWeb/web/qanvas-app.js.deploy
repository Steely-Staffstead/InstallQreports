    if (!requestId || !action || !entry.execute) {
      entry.iframe.contentWindow.postMessage({ type: "qanvas.action.result", requestId, ok: false, error: action ? "This app action is unavailable in the current host." : "The app is not permitted to run that action." }, "*");
      return;
    }
    try {
      const result = await entry.execute(action, event.data.parameters || {}, entry.payload);
      entry.iframe.contentWindow.postMessage({ type: "qanvas.action.result", requestId, ok: true, result }, "*");
    } catch (error) {
      entry.iframe.contentWindow.postMessage({ type: "qanvas.action.result", requestId, ok: false, error: error?.message || String(error) }, "*");
    }
  });
