    const entry = `• ${clean}`;
    if (!lines.some(line => line.toLowerCase() === entry.toLowerCase())) lines.push(entry);
    return lines.slice(-6).join("\n").slice(0, 1200);
  }

  function openDesigner(options = {}) {
    const original = options.definition;
    if (!original) return null;
