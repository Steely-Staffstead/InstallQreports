  function formatCode(source) {
    const text = String(source || ""); let output = "", indent = 0, parens = 0, quote = "", escaped = false, lineComment = false, blockComment = false;
    const newline = () => { output = output.replace(/[ \t]+$/g, ""); if (!output.endsWith("\n")) output += "\n"; output += "  ".repeat(indent); };
    for (let index = 0; index < text.length; index++) {
