    if (!script.includes("qanvas.ready")) throw new Error("App AI removed the required qanvas.ready startup signal. The draft was left unchanged.");
    try { new Function(script); }
    catch (error) { throw new Error(`App AI returned invalid JavaScript: ${error.message}. The draft was left unchanged.`); }
    result.name = String(value.name || result.name || "Qanvas App").trim().slice(0, 120) || "Qanvas App";
