  function formatJavaScript(source) {
    const original = String(source || "");
    if (!original.trim()) return original;
    const lines = original.replace(/\r\n?/g, "\n").split("\n"), result = [];
    let indent = 0, quote = "", escaped = false, blockComment = false, templateExpressionDepth = 0;
    for (const raw of lines) {
      const trimmed = raw.trim();
      if (!trimmed) { if (result.length && result[result.length - 1] !== "") result.push(""); continue; }
      const protectedLineStart = Boolean(quote || blockComment);
      let leadingClose = false, lineComment = false, regex = false, regexClass = false, previous = "";
      for (let index = 0; index < trimmed.length; index++) {
        const char = trimmed[index], next = trimmed[index + 1] || "";
        if (lineComment) break;
        if (blockComment) { if (char === "*" && next === "/") { blockComment = false; index++; } continue; }
        if (regex) { if (escaped) escaped = false; else if (char === "\\") escaped = true; else if (char === "[") regexClass = true; else if (char === "]") regexClass = false; else if (char === "/" && !regexClass) regex = false; continue; }
