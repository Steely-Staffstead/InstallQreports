      return;
    }
    if (event.data?.type === "qanvas.measure") {
      const requestId = String(event.data.requestId || "");
      if (!requestId || entry.payload.definition.permissions?.measures !== "read" || !entry.evaluateMeasure) {
        entry.iframe.contentWindow.postMessage({ type: "qanvas.measure.result", requestId, ok: false, error: "This app is not permitted to evaluate MiniDAX measures." }, "*");
        return;
      }
      try {
        const result = await entry.evaluateMeasure({ measure: String(event.data.measure || ""), ...(event.data.options || {}) }, entry.payload);
        entry.iframe.contentWindow.postMessage({ type: "qanvas.measure.result", requestId, ok: true, result }, "*");
      } catch (error) {
        entry.iframe.contentWindow.postMessage({ type: "qanvas.measure.result", requestId, ok: false, error: error?.message || String(error) }, "*");
      }
      return;
    }
    if (event.data?.type === "qanvas.table") {
      const requestId = String(event.data.requestId || "");
      if (!requestId || !entry.mutateTable) {
        entry.iframe.contentWindow.postMessage({ type: "qanvas.table.result", requestId, ok: false, error: "Embedded-table access is unavailable in the current host." }, "*");
        return;
      }
      try {
        const result = await entry.mutateTable({ operation: String(event.data.operation || ""), sourceId: String(event.data.sourceId || ""), ...(event.data.payload || {}) }, entry.payload);
        entry.iframe.contentWindow.postMessage({ type: "qanvas.table.result", requestId, ok: true, result }, "*");
      } catch (error) {
        entry.iframe.contentWindow.postMessage({ type: "qanvas.table.result", requestId, ok: false, error: error?.message || String(error) }, "*");
      }
      return;
    }
    if (event.data?.type === "qanvas.parameter") {
      const requestId = String(event.data.requestId || "");
      if (!requestId || !entry.updateParameters) {
        entry.iframe.contentWindow.postMessage({ type: "qanvas.parameter.result", requestId, ok: false, error: "Parameter changes are unavailable in the current host." }, "*");
        return;
      }
      try {
        const result = await entry.updateParameters({ values: event.data.values, options: event.data.options }, entry.payload);
        entry.iframe.contentWindow.postMessage({ type: "qanvas.parameter.result", requestId, ok: true, result }, "*");
