  const copy = value => typeof structuredClone === "function" ? structuredClone(value) : JSON.parse(JSON.stringify(value));
  const html = value => String(value ?? "").replace(/[&<>\"]/g, character => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[character]);
  const requiredFiles = ["index.html", "styles.css", "app.js"];

  function formatMarkup(source) {
    const protectedBlocks = [];
    const protectedSource = String(source || "").replace(/<(script|style|svg|pre|textarea)\b[\s\S]*?<\/\1\s*>/gi, value => {
      const token = `\uE000QANVAS_RAW_${protectedBlocks.length}\uE001`;
