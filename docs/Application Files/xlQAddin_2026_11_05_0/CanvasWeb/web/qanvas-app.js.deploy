    const lines = protectedSource.replace(/>\s*</g, ">\n<").split(/\r?\n/), result = [];
    let depth = 0;
    for (const raw of lines) {
      const line = raw.trim(); if (!line) continue;
      const closes = /^<\//.test(line), standalone = /^<(?:!doctype|meta|link|img|input|br|hr)\b/i.test(line) || /\/>$/.test(line), inlinePair = /^<([\w:-]+)\b[^>]*>.*<\/\1>$/.test(line);
      if (closes) depth = Math.max(0, depth - 1);
