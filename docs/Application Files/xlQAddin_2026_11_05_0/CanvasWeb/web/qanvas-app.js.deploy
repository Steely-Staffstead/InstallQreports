      if (!query) return [];
      const lowerSource = source.toLocaleLowerCase(), lowerQuery = query.toLocaleLowerCase(), matches = [];
      let index = 0;
      while ((index = lowerSource.indexOf(lowerQuery, index)) >= 0) { matches.push(index); index += Math.max(1, lowerQuery.length); }
      return matches;
