  };
  addEventListener("keydown", event => {
    if (event.key === "Escape") stopProtectedInteraction();
  });
  addEventListener("click", event => {
    const interact = event.target.closest?.("[data-qanvas-app-interact]");
    if (!interact) return;
    const host = interact.closest(".qanvas-app-host"), iframe = host?.querySelector("iframe.qanvas-app-frame");
    if (!host || !iframe) return;
    event.preventDefault();
    event.stopImmediatePropagation();
