    const renderCodeSearchHighlight = () => {
      if (!codeSearchLocation || !codeSearch.value) { codeHighlight.hidden = true; return; }
      const source = editor.value, start = codeSearchLocation.start, matchText = source.slice(start, start + codeSearchLocation.length).split("\n")[0];
      if (!matchText) { codeHighlight.hidden = true; return; }
      const before = source.slice(0, start), lineStart = before.lastIndexOf("\n") + 1, lineIndex = before.split("\n").length - 1, prefix = source.slice(lineStart, start).replace(/\t/g, "  ");
      const style = getComputedStyle(editor), lineHeight = parseFloat(style.lineHeight) || 18.6, paddingTop = parseFloat(style.paddingTop) || 0, paddingLeft = parseFloat(style.paddingLeft) || 0;
      const canvas = renderCodeSearchHighlight.canvas ||= document.createElement("canvas"), context = canvas.getContext("2d"); context.font = style.font;
      const top = editor.offsetTop + paddingTop + lineIndex * lineHeight - editor.scrollTop, left = editor.offsetLeft + paddingLeft + context.measureText(prefix).width - editor.scrollLeft;
      codeHighlightLine.style.cssText = `top:${top}px;left:${editor.offsetLeft}px;width:${editor.clientWidth}px;height:${lineHeight}px`;
      codeHighlightMatch.style.cssText = `top:${top}px;left:${left}px;width:${Math.max(3, context.measureText(matchText).width)}px;height:${lineHeight}px`;
