(() => {
  "use strict";

  const APP_VERSION = 1;
  const frames = new Map();
  const designerPaneSizes = { ai: 430, advanced: 360, code: 500 };
  const bindingSources = new Set(["theme", "measure", "field", "parameter", "constant"]);
  const bindingTypes = new Set(["text", "number", "color", "boolean", "table"]);
  const tableOperations = new Set(["read", "insert", "update", "upsert", "delete"]);
  const imageTypes = new Set(["image/png", "image/jpeg", "image/webp", "image/gif"]);
  const maxAssetBytes = 5 * 1024 * 1024;
  const maxAssetTotalBytes = 20 * 1024 * 1024;
  const maxAssetCount = 50;

  const normalizeHost = value => {
    let host = String(value || "").trim().toLowerCase();
    if (!host) return "";
    try { host = new URL(host.includes("://") ? host : `https://${host}`).hostname.toLowerCase(); }
    catch { return ""; }
    return /^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(host) ? host : "";
  };

  const normalizeExternalPermissions = value => {
    const source = value && typeof value === "object" ? value : {};
    return {
      openLinks: source.openLinks === true,
      remoteImages: source.remoteImages === true,
      linkHosts: [...new Set((Array.isArray(source.linkHosts) ? source.linkHosts : []).map(normalizeHost).filter(Boolean))].slice(0, 40),
      imageHosts: [...new Set((Array.isArray(source.imageHosts) ? source.imageHosts : []).map(normalizeHost).filter(Boolean))].slice(0, 40)
    };
  };

  const normalizeAssets = value => {
    const used = new Set(), result = [];
    let totalBytes = 0;
    for (const [index, item] of (Array.isArray(value) ? value : []).entries()) {
      if (result.length >= maxAssetCount) break;
      let name = String(item?.name || `image-${index + 1}`).trim().replace(/[\\/:*?"<>|]/g, "-").slice(0, 120) || `image-${index + 1}`;
      const base = name; let suffix = 2; while (used.has(name.toLowerCase())) name = `${base}-${suffix++}`; used.add(name.toLowerCase());
      const type = imageTypes.has(String(item?.type || "").toLowerCase()) ? String(item.type).toLowerCase() : "";
      const dataUrl = String(item?.dataUrl || "");
      const prefix = `data:${type};base64,`;
      if (!type || !dataUrl.startsWith(prefix)) continue;
      const encoded = dataUrl.slice(prefix.length);
      if (!/^[a-z0-9+/]*={0,2}$/i.test(encoded)) continue;
      const padding = encoded.endsWith("==") ? 2 : encoded.endsWith("=") ? 1 : 0;
      const bytes = Math.max(0, Math.floor(encoded.length * 3 / 4) - padding);
      if (bytes > maxAssetBytes || totalBytes + bytes > maxAssetTotalBytes) continue;
      totalBytes += bytes;
      result.push({ name, type, dataUrl });
    }
    return result;
  };

  const normalizeParameterAccess = value => (Array.isArray(value) ? value : []).map(item => ({
    name: String(item?.name || "").trim(),
    read: item?.read !== false || item?.write === true,
    write: item?.write === true
  })).filter(item => item.name);

  const normalizeTablePermissions = value => (Array.isArray(value) ? value : []).map(item => ({
    sourceId: String(item?.sourceId || ""),
    operations: [...new Set((Array.isArray(item?.operations) ? item.operations : ["read"]).map(String).filter(operation => tableOperations.has(operation)))],
    key: String(item?.key || "")
  })).filter(item => item.sourceId);

  const normalizeBindings = value => {
    const used = new Set();
    return (Array.isArray(value) ? value : []).map((item, index) => {
      let id = String(item?.id || `binding${index + 1}`).trim().replace(/[^a-zA-Z0-9_-]/g, "-").slice(0, 80) || `binding${index + 1}`;
      const base = id; let suffix = 2; while (used.has(id)) id = `${base}-${suffix++}`; used.add(id);
      const source = bindingSources.has(item?.source) ? item.source : "constant";
      return { id, label: String(item?.label || id).slice(0, 120), valueType: bindingTypes.has(item?.valueType) ? item.valueType : "text", source, sourceId: String(item?.sourceId || ""), name: String(item?.name || ""), groupBy: String(item?.groupBy || ""), aggregation: String(item?.aggregation || (source === "field" ? "First" : "Sum")), value: item?.value ?? "", fallback: item?.fallback ?? "" };
    });
  };

  const blankHtml = `<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Untitled app</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <main id="app"></main>
  <script src="app.js"><\/script>
</body>
</html>`;
  const blankCss = `:root {
  --surface: #fff;
  --text: #182230;
  --accent: #4f6ee8;
  --on-accent: #fff;
  --grid: #d8dee8;
  --positive: #16844a;
  --negative: #c43d4b;
  --muted: #667085;
  font-family: "Segoe UI", system-ui, sans-serif;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  min-height: 100%;
  background: var(--surface);
  color: var(--text);
}

body { padding: 16px; }`;
  const blankJs = `const applyTheme = theme => {
  for (const [key, value] of Object.entries(theme || {})) {
    const property = "--" + key.replace(/[A-Z]/g, match => "-" + match.toLowerCase());
    document.documentElement.style.setProperty(property, value);
  }
};

addEventListener("message", event => {
  if (event.data?.type !== "qanvas.init") return;
  applyTheme(event.data.payload?.theme);
});

parent.postMessage({ type: "qanvas.ready" }, "*");`;
  const clientBridge = `(()=>{
let sequence=0;const pending=new Map(),commandHandlers=new Map(),parameterHandlers=new Map(),parameterCache={},embeddedAssets=Object.freeze({...((window.__qanvasEmbeddedAssets&&typeof window.__qanvasEmbeddedAssets==='object')?window.__qanvasEmbeddedAssets:{})});
const request=(type,payload,timeout=120000)=>new Promise((resolve,reject)=>{const requestId='app-'+Date.now()+'-'+(++sequence);pending.set(requestId,{resolve,reject,type});parent.postMessage({type,requestId,...payload},'*');setTimeout(()=>{if(pending.delete(requestId)){const label=type==='qanvas.measure'?'MiniDAX':type==='qanvas.table'?'embedded-table':type==='qanvas.parameter'?'parameter':'Qanvas action';reject(new Error('The '+label+' request timed out.'));}},timeout);});
const removeHandler=(map,name,handler)=>{const key=String(name||'').trim(),handlers=map.get(key);if(!handlers)return false;const removed=handlers.delete(handler);if(!handlers.size)map.delete(key);return removed;};
const notifyParameters=values=>{for(const [name,value] of Object.entries(values||{})){const previous=parameterCache[name];parameterCache[name]=value;if(Object.is(previous,value))continue;for(const handler of [...(parameterHandlers.get(name)||[]),...(parameterHandlers.get('*')||[])])try{handler(value,{name,previous,parameters:{...parameterCache}});}catch(error){console.error('Qanvas parameter subscriber failed',error);}}};
addEventListener('message',event=>{const message=event.data;if(message?.type==='qanvas.init'){notifyParameters(message.payload?.context?.parameters||{});return;}if(message?.type==='qanvas.parameters.changed'){notifyParameters(message.values||{});return;}if(message?.type==='qanvas.command'){const name=String(message.command||'').trim(),parameters=message.parameters&&typeof message.parameters==='object'&&!Array.isArray(message.parameters)?message.parameters:{};for(const handler of [...(commandHandlers.get(name)||[]),...(commandHandlers.get('*')||[])])try{handler(parameters,{name,tileId:String(message.tileId||'')});}catch(error){console.error('Qanvas app command failed',error);}return;}if(!['qanvas.action.result','qanvas.measure.result','qanvas.table.result','qanvas.parameter.result','qanvas.navigation.result'].includes(message?.type))return;const pendingRequest=pending.get(message.requestId);if(!pendingRequest)return;pending.delete(message.requestId);if(message.ok){if(message.type==='qanvas.parameter.result')notifyParameters(message.result?.values||{});pendingRequest.resolve(message.result);}else pendingRequest.reject(new Error(message.error||'The Qanvas request failed.'));});
const tableRequest=(operation,sourceId,payload={})=>request('qanvas.table',{operation,sourceId:String(sourceId||''),payload:payload&&typeof payload==='object'?payload:{}},60000);
const setParameters=(values,options={})=>request('qanvas.parameter',{values:values&&typeof values==='object'&&!Array.isArray(values)?values:{},options:options&&typeof options==='object'?options:{}},30000);
window.qanvas=Object.freeze({actions:Object.freeze({execute:(actionId,parameters={})=>request('qanvas.action',{actionId:String(actionId||''),parameters:parameters&&typeof parameters==='object'?parameters:{}})}),measures:Object.freeze({evaluate:(measure,options={})=>request('qanvas.measure',{measure:String(measure||''),options:options&&typeof options==='object'?options:{}},60000)}),tables:Object.freeze({read:(sourceId,options={})=>tableRequest('read',sourceId,{options}),insert:(sourceId,values,options={})=>tableRequest('insert',sourceId,{values,options}),update:(sourceId,selector,changes,options={})=>tableRequest('update',sourceId,{selector,changes,options}),upsert:(sourceId,values,options={})=>tableRequest('upsert',sourceId,{values,options}),delete:(sourceId,selector,options={})=>tableRequest('delete',sourceId,{selector,options})}),parameters:Object.freeze({get:name=>parameterCache[String(name||'').trim()],set:(name,value,options={})=>setParameters({[String(name||'').trim()]:value},options),setMany:setParameters,subscribe:(name,handler)=>{const key=String(name||'*').trim()||'*';if(typeof handler!=='function')throw new TypeError('A parameter subscriber must be a function.');const handlers=parameterHandlers.get(key)||new Set();handlers.add(handler);parameterHandlers.set(key,handlers);return()=>removeHandler(parameterHandlers,key,handler);}}),assets:Object.freeze({get:name=>embeddedAssets[String(name||'').trim()]||'',list:()=>Object.keys(embeddedAssets)}),navigation:Object.freeze({openExternal:url=>request('qanvas.navigation',{operation:'openExternal',url:String(url||'')},30000),openMap:address=>request('qanvas.navigation',{operation:'openMap',address:String(address||'')},30000)}),commands:Object.freeze({on:(name,handler)=>{const key=String(name||'').trim();if(!key||typeof handler!=='function')throw new TypeError('A command name and handler are required.');const handlers=commandHandlers.get(key)||new Set();handlers.add(handler);commandHandlers.set(key,handlers);return()=>removeHandler(commandHandlers,key,handler);},off:(name,handler)=>removeHandler(commandHandlers,name,handler)})});
})();`;

  const analysisHtml = `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Source analysis</title><link rel="stylesheet" href="styles.css"></head><body><main id="app"><div class="loading"><span></span><p>Analyzing source…</p></div></main><script src="app.js"><\/script></body></html>`;
  const analysisCss = `
:root{color-scheme:light dark;--surface:#fff;--text:#182230;--accent:#4f6ee8;--on-accent:#fff;--grid:#d8dee8;--positive:#16844a;--negative:#c43d4b;--muted:#667085;font-family:Segoe UI,system-ui,sans-serif}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--surface);color:var(--text)}body{padding:14px}.loading{min-height:180px;display:grid;place-content:center;text-align:center;color:var(--muted)}.loading span{width:28px;height:28px;border:3px solid var(--grid);border-top-color:var(--accent);border-radius:50%;margin:auto;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:12px}h1{font-size:clamp(16px,2vw,22px);margin:0}header p{margin:4px 0 0;color:var(--muted);font-size:12px}.badge{border:1px solid var(--grid);border-radius:999px;padding:5px 9px;font-size:11px;white-space:nowrap}.summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(112px,1fr));gap:8px;margin-bottom:12px}.metric{border:1px solid var(--grid);border-radius:10px;padding:10px;background:color-mix(in srgb,var(--surface) 92%,var(--accent) 8%)}.metric b{display:block;font-size:clamp(18px,3vw,27px);line-height:1.1}.metric span{font-size:11px;color:var(--muted)}
.quality{display:flex;gap:8px;align-items:center;border-left:4px solid var(--positive);padding:8px 10px;margin:0 0 12px;background:color-mix(in srgb,var(--surface) 92%,var(--positive) 8%);font-size:12px}.quality.warn{border-color:var(--negative);background:color-mix(in srgb,var(--surface) 92%,var(--negative) 8%)}
.table-wrap{overflow:auto;border:1px solid var(--grid);border-radius:10px}table{border-collapse:collapse;width:100%;min-width:580px;font-size:12px}th,td{padding:8px 10px;border-bottom:1px solid var(--grid);text-align:right;white-space:nowrap}th:first-child,td:first-child{text-align:left}th{position:sticky;top:0;background:color-mix(in srgb,var(--surface) 88%,var(--accent) 12%);font-weight:650}tr:last-child td{border-bottom:0}.type{color:var(--muted);font-size:10px}.bar{height:5px;width:88px;background:var(--grid);border-radius:99px;overflow:hidden;margin-left:auto}.bar i{display:block;height:100%;background:var(--accent);border-radius:inherit}.empty{padding:24px;text-align:center;color:var(--muted)}
`;
  const analysisJs = `
const root=document.getElementById('app');
const esc=value=>String(value??'').replace(/[&<>\"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[ch]));
const number=value=>{if(value==null||value==='')return NaN;const parsed=typeof value==='number'?value:Number(String(value).replace(/\\s/g,'').replace(',','.'));return Number.isFinite(parsed)?parsed:NaN};
const fmt=value=>Number.isFinite(value)?new Intl.NumberFormat(undefined,{maximumFractionDigits:2}).format(value):'—';
function applyTheme(theme){for(const [key,value] of Object.entries(theme||{})){const css='--'+key.replace(/[A-Z]/g,m=>'-'+m.toLowerCase());document.documentElement.style.setProperty(css,value)}}
function analyze(payload){applyTheme(payload.theme);const columns=payload.schema?.columns||[],types=payload.schema?.types||[],rows=payload.rows||[],total=payload.totalRows??rows.length;let missing=0;const stats=columns.map((name,index)=>{const values=rows.map(row=>row[index]),present=values.filter(value=>value!==null&&value!==undefined&&value!=='');missing+=values.length-present.length;const numeric=present.map(number).filter(Number.isFinite),unique=new Set(present.map(value=>typeof value==='object'?JSON.stringify(value):String(value))).size;return{name,type:types[index]||typeof present[0]||'unknown',present:present.length,missing:values.length-present.length,unique,numeric:numeric.length,min:numeric.length?Math.min(...numeric):NaN,max:numeric.length?Math.max(...numeric):NaN,mean:numeric.length?numeric.reduce((a,b)=>a+b,0)/numeric.length:NaN}});const cells=Math.max(1,rows.length*columns.length),quality=Math.max(0,100-Math.round(missing/cells*100)),numericCount=stats.filter(item=>item.numeric).length;
root.innerHTML='<header><div><h1>'+esc(payload.title||'Source analysis')+'</h1><p>'+esc(payload.sourceName||'Data source')+' · filtered canvas context</p></div><span class="badge">Read only</span></header><section class="summary"><div class="metric"><b>'+fmt(total)+'</b><span>rows in source</span></div><div class="metric"><b>'+fmt(columns.length)+'</b><span>columns</span></div><div class="metric"><b>'+fmt(numericCount)+'</b><span>numeric fields</span></div><div class="metric"><b>'+quality+'%</b><span>populated cells</span></div></section><p class="quality '+(quality<90?'warn':'')+'">'+(missing?fmt(missing)+' empty values found in the analyzed rows.':'No empty values found in the analyzed rows.')+'</p>'+(columns.length?'<div class="table-wrap"><table><thead><tr><th>Field</th><th>Present</th><th>Missing</th><th>Unique</th><th>Minimum</th><th>Average</th><th>Maximum</th><th>Coverage</th></tr></thead><tbody>'+stats.map(item=>{const coverage=rows.length?Math.round(item.present/rows.length*100):0;return '<tr><td><b>'+esc(item.name)+'</b><br><span class="type">'+esc(item.type)+'</span></td><td>'+fmt(item.present)+'</td><td>'+fmt(item.missing)+'</td><td>'+fmt(item.unique)+'</td><td>'+fmt(item.min)+'</td><td>'+fmt(item.mean)+'</td><td>'+fmt(item.max)+'</td><td><div class="bar" title="'+coverage+'%"><i style="width:'+coverage+'%"></i></div></td></tr>'}).join('')+'</tbody></table></div>':'<div class="empty">Load or connect a data source to analyze it.</div>');}
addEventListener('message',event=>{if(event.data?.type==='qanvas.init')analyze(event.data.payload||{})});parent.postMessage({type:'qanvas.ready'},'*');
`;

  const defaultDefinition = (id, name = "Untitled app") => ({
    id,
    name,
    version: APP_VERSION,
    runtime: "sandboxed-html",
    template: "blank",
    entry: "index.html",
    permissions: { data: "read", measures: "read", parameters: "read", parameterAccess: [], filters: "read", navigation: "read", network: "none", storage: "none", external: normalizeExternalPermissions(), actions: [], tables: [] },
    currentSpec: "",
    designHistory: [],
    bindings: [],
    assets: [],
    files: [
      { path: "index.html", type: "text/html", content: blankHtml },
      { path: "styles.css", type: "text/css", content: blankCss },
      { path: "app.js", type: "text/javascript", content: blankJs }
    ]
  });

  function normalizeDefinitions(value, createId) {
    const result = Array.isArray(value) ? value.filter(item => item && typeof item === "object") : [];
    for (const definition of result) {
      definition.id ||= createId();
      definition.name ||= "Qanvas App";
      definition.version ||= APP_VERSION;
      definition.runtime ||= "sandboxed-html";
      definition.entry ||= "index.html";
      definition.permissions ||= { data: "read", measures: "read", network: "none", storage: "none", actions: [] };
      definition.permissions.measures ??= "read";
      definition.permissions.actions = Array.isArray(definition.permissions.actions) ? definition.permissions.actions : [];
      definition.permissions.tables = normalizeTablePermissions(definition.permissions.tables);
      definition.permissions.parameterAccess = normalizeParameterAccess(definition.permissions.parameterAccess);
      definition.permissions.external = normalizeExternalPermissions(definition.permissions.external);
      definition.currentSpec = String(definition.currentSpec || "").slice(0, 1200);
      definition.designHistory = Array.isArray(definition.designHistory) ? definition.designHistory.slice(-8).map(item => ({ role: item?.role === "assistant" ? "assistant" : "user", text: String(item?.text || "").slice(0, 2000) })) : [];
      definition.bindings = normalizeBindings(definition.bindings);
      definition.assets = normalizeAssets(definition.assets);
      definition.files = Array.isArray(definition.files) ? definition.files : [];
    }
    return result;
  }

  function normalizeTile(tile, definitions, createId) {
    tile.app ||= {};
    let definition = definitions.find(item => item.id === tile.app.appId);
    if (!definition) {
      definition = defaultDefinition(createId());
      definitions.push(definition);
      tile.app.appId = definition.id;
    }
    tile.app.maxRows = Math.max(100, Math.min(20000, Number(tile.app.maxRows) || 5000));
    tile.app.sourceId ||= tile.sourceId || "main";
    tile.app.sourceIds = [...new Set((Array.isArray(tile.app.sourceIds) && tile.app.sourceIds.length ? tile.app.sourceIds : [tile.app.sourceId]).map(String).filter(Boolean))];
    if (!tile.app.sourceIds.length) tile.app.sourceIds = ["main"];
    tile.app.sourceId = tile.app.sourceIds[0];
    tile.app.useFilteredContext ??= true;
    tile.app.allowInteraction ??= true;
    return definition;
  }

  function file(definition, path) {
    return definition.files?.find(item => item.path === path)?.content || "";
  }

  function assemble(definition, initialPayload) {
    const html = file(definition, definition.entry || "index.html") || blankHtml;
    const css = file(definition, "styles.css");
    const js = file(definition, "app.js");
    const external = normalizeExternalPermissions(definition.permissions?.external);
    const remoteImageSources = external.remoteImages ? external.imageHosts.map(host => `https://${host}`).join(" ") : "";
    const policy = `<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data: blob:${remoteImageSources ? ` ${remoteImageSources}` : ""}; style-src 'unsafe-inline'; script-src 'unsafe-inline'; font-src data:; connect-src 'none'">`;
    const assets = Object.fromEntries(normalizeAssets(definition.assets).map(asset => [asset.name, asset.dataUrl]));
    const serializedAssets = JSON.stringify(assets).replace(/</g, "\\u003c").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");
    const assetBootstrap = `<script>window.__qanvasEmbeddedAssets=${serializedAssets};<\/script>`;
    const serialized = initialPayload === undefined ? "" : JSON.stringify(initialPayload).replace(/</g, "\\u003c").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");
    const bootstrap = serialized ? `<script>dispatchEvent(new MessageEvent('message',{data:{type:'qanvas.init',payload:${serialized}}}));parent.postMessage({type:'qanvas.bootstrapped'},'*');<\/script>` : "";
    const assembled = html
      .replace(/<head([^>]*)>/i, `<head$1>${policy}`)
      .replace(/<link[^>]+href=["']styles\.css["'][^>]*>/i, `<style>${css}</style>`)
      .replace(/<script[^>]+src=["']app\.js["'][^>]*><\/script>/i, `${assetBootstrap}<script>${clientBridge}<\/script><script>${js}<\/script>`);
    return bootstrap ? assembled.replace(/<\/body>/i, `${bootstrap}</body>`) : assembled;
  }

  function placeholder(tile, definition) {
    const protectedInteraction = tile.app?.allowInteraction === false;
    return `<div class="qanvas-app-host${protectedInteraction ? " is-protected" : ""}" data-qanvas-app-tile="${String(tile.id).replace(/["&<>]/g, "")}" data-qanvas-app-interaction="${protectedInteraction ? "protected" : "direct"}" aria-label="${String(definition?.name || "Qanvas App").replace(/["&<>]/g, "")}"><div class="qanvas-app-loading"><span></span><b>Loading ${definition?.name || "Qanvas App"}…</b></div><button type="button" data-qanvas-app-interact title="Enable interaction with this app">Interact</button></div>`;
  }

  function mountAll(options) {
    for (const [source, entry] of frames) if (!entry.iframe?.isConnected) frames.delete(source);
    document.querySelectorAll("[data-qanvas-app-tile]").forEach(host => {
      const tileId = host.dataset.qanvasAppTile;
      const directInteraction = host.dataset.qanvasAppInteraction !== "protected" &&
        (!!window.QanvasReport || document.body.classList.contains("presentation-mode"));
      if (directInteraction) host.classList.add("is-interacting");
      if (host.dataset.qanvasAppMounted === "1") return;
      const payload = options.resolve(tileId);
      if (!payload?.definition) return;
      host.dataset.qanvasAppMounted = "1";
      const iframe = document.createElement("iframe");
      iframe.className = "qanvas-app-frame";
      iframe.title = payload.definition.name || "Qanvas App";
      iframe.setAttribute("sandbox", "allow-scripts");
      iframe.setAttribute("referrerpolicy", "no-referrer");
      host.querySelector(".qanvas-app-loading")?.replaceWith(iframe);
      // Editing keeps the activation affordance so the tile can still be
      // selected and moved. Presentation and standalone webpages are directly
      // interactive by default; an app tile can explicitly request protection.
      host.classList.toggle("is-interacting", directInteraction);
      const entry = {
        iframe,
        payload,
        execute: options.execute,
        evaluateMeasure: options.evaluateMeasure,
        mutateTable: options.mutateTable,
        updateParameters: options.updateParameters,
        readySeen: false,
        bootstrapped: false,
        initTimer: 0,
        initialize(reason = "ready") {
          if (!this.iframe.contentWindow) return;
          if (reason === "ready") {
            if (this.readySeen) return;
            this.readySeen = true;
          } else if (this.readySeen) return;
          clearTimeout(this.initTimer);
          // Send on the next task. Posting back synchronously from the child's
          // ready event can race Chromium's srcdoc navigation during a canvas
          // rerender, even though the correct WindowProxy is already present.
          this.initTimer = setTimeout(() => {
            if (!this.iframe.isConnected || !this.iframe.contentWindow) return;
            this.iframe.contentWindow.postMessage({ type: "qanvas.init", payload: this.payload.initial }, "*");
          }, 0);
        }
      };
      // Register the WindowProxy before srcdoc starts. Small embedded apps can
      // announce qanvas.ready synchronously while their document is loading.
      // Registering after srcdoc made source/sidebar renders intermittently lose
      // the only init message, leaving both data and canvas theme unavailable.
      frames.set(iframe.contentWindow, entry);
      iframe.srcdoc = assemble(payload.definition, payload.initial);
