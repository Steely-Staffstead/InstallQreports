    };
    const renderPreview = () => {
      clearTimeout(previewTimer); saveEditor(false);
      const previewPayload = options.resolvePayload?.(copy(draft)) || options.payload || {};
      unregisterPreview();
      previewFrameSource = iframe.contentWindow;
      frames.set(previewFrameSource, { iframe, payload: { definition: draft, initial: previewPayload }, evaluateMeasure: options.evaluateMeasure, mutateTable: options.mutateTable, updateParameters: options.updateParameters, execute: null, designerPreview: true, readySeen: true, bootstrapped: false, initTimer: 0, initialize() {} });
      const inspector = `<script>(()=>{let mode='interact';addEventListener('message',event=>{if(event.data?.type==='qanvas.designer.mode')mode=event.data.mode==='inspect'?'inspect':'interact';});addEventListener('click',event=>{if(mode!=='inspect')return;event.preventDefault();event.stopImmediatePropagation();const node=event.target?.closest?.('body *');if(!node)return;const text=String(node.textContent||'').trim().replace(/\\s+/g,' ').slice(0,180),outer=String(node.outerHTML||'').split('>')[0]+'>';parent.postMessage({type:'qanvas.designer.inspect',tag:node.tagName?.toLowerCase(),text,outer},'*');},true);parent.postMessage({type:'qanvas.designer.mode.ready'},'*');})();<\/script>`;
      iframe.srcdoc = assemble(draft, previewPayload).replace(/<\/body>/i,`${inspector}</body>`);
      dialog.querySelector("[data-app-designer-code-status]").textContent = "Preview refreshed";
    };
    const schedulePreview = () => { clearTimeout(previewTimer); previewTimer = setTimeout(renderPreview, 320); };
    const appendChat = (role, text, attachments = []) => { const item = document.createElement("p"); item.className = role; item.textContent = text; if (attachments.length) { const files = document.createElement("small"); files.className = "qanvas-app-ai-chat-files"; files.textContent = `Attached: ${attachments.map(attachment => attachment.name).join(", ")}`; item.append(files); } chat.append(item); chat.scrollTop = chat.scrollHeight; };
    const renderPendingAttachments = () => {
      attachmentList.hidden = !pendingAttachments.length;
      attachmentList.innerHTML = pendingAttachments.map((attachment, index) => `<article>${attachment.type?.startsWith("image/") ? `<img src="${html(attachment.dataUrl)}" alt="">` : `<span>FILE</span>`}<div><b>${html(attachment.name)}</b><small>${Math.max(1, Math.ceil((attachment.size || 0) / 1024))} KB</small></div><button type="button" data-app-ai-attachment-remove="${index}" title="Remove attachment">×</button></article>`).join("");
      attachmentList.querySelectorAll("[data-app-ai-attachment-remove]").forEach(button => button.onclick = () => { pendingAttachments.splice(+button.dataset.appAiAttachmentRemove, 1); renderPendingAttachments(); });
    };
    const addAttachmentFiles = files => {
      const allowed = /\.(png|jpe?g|webp|gif|svg|pdf|txt|md|csv|json|xml|html?|css|js|ts|sql|log|docx?|xlsx?|pptx?)$/i;
      for (const file of [...files].slice(0, Math.max(0, 8 - pendingAttachments.length))) {
        if (file.size > 16 * 1024 * 1024) { aiStatus.textContent = `${file.name || "File"} is larger than 16 MB.`; continue; }
        if (!file.type?.startsWith("image/") && !allowed.test(file.name || "")) { aiStatus.textContent = `${file.name || "File"} is not a supported attachment.`; continue; }
        const reader = new FileReader();
        reader.onload = () => { pendingAttachments.push({ name: file.name || `pasted-image-${Date.now()}.png`, type: file.type || "application/octet-stream", size: file.size, dataUrl: String(reader.result || "") }); renderPendingAttachments(); aiStatus.textContent = "Attachment ready. Add a message and choose Send."; };
        reader.onerror = () => { aiStatus.textContent = `Could not read ${file.name || "the attachment"}.`; };
        reader.readAsDataURL(file);
      }
    };
    const renderQueue = () => {
      const count = requirementQueue.length + (activeRequirement ? 1 : 0); queueCount.textContent = String(count);
      if (count) queueList.closest("details").open = true;
      queueList.innerHTML = count ? `${activeRequirement ? `<article class="processing"><span>Processing${activeRequirement.attachments?.length ? ` · ${activeRequirement.attachments.length} file(s)` : ""}</span><textarea disabled>${html(activeRequirement.text)}</textarea></article>` : ""}${requirementQueue.map((item,index)=>`<article data-app-queue-index="${index}"><span>Waiting ${index+1}${item.attachments?.length ? ` · ${item.attachments.length} file(s)` : ""}</span><textarea data-app-queue-edit="${index}" rows="2">${html(item.text)}</textarea><button type="button" data-app-queue-remove="${index}" title="Delete queued requirement">×</button></article>`).join("")}` : `<p class="property-empty">No queued requirements.</p>`;
      queueList.querySelectorAll("[data-app-queue-edit]").forEach(input => input.oninput = () => { requirementQueue[+input.dataset.appQueueEdit].text = input.value.slice(0, 4000); });
      queueList.querySelectorAll("[data-app-queue-remove]").forEach(button => button.onclick = () => { requirementQueue.splice(+button.dataset.appQueueRemove, 1); renderQueue(); });
      aiSend.textContent = aiRunning ? "Add to queue" : "Send";
    };
    const drainQueue = async () => {
      if (aiRunning || !requirementQueue.length || !options.requestAi) return;
      activeRequirement = requirementQueue.shift(); const prompt = activeRequirement.text.trim(); if (!prompt) { activeRequirement = null; renderQueue(); return drainQueue(); }
      saveEditor(); draft.currentSpec = spec.value.trim().slice(0, 1200); draft.designHistory.push({ role: "user", text: prompt.slice(0, 2000) }); draft.designHistory = draft.designHistory.slice(-8); aiRunning = true; aiStatus.textContent = `Preparing app context…${requirementQueue.length ? ` · ${requirementQueue.length} queued` : ""}`; appendChat("user", prompt, activeRequirement.attachments || []); renderQueue();
      try {
        const response = await options.requestAi(prompt, copy(draft), text => { const progressText = `${text || "Building app…"}${requirementQueue.length ? ` · ${requirementQueue.length} queued` : ""}`; aiStatus.textContent = progressText; aiStatus.title = progressText; }, activeRequirement.attachments || []);
        const previousSpec = draft.currentSpec, parsed = aiDefinition(response, draft, prompt), assistantMessage = parsed.assistantMessage; draft = parsed.definition; if (parsed.changed && (!draft.currentSpec || draft.currentSpec === previousSpec)) draft.currentSpec = updateSpecFallback(previousSpec, prompt); draft.designHistory ||= []; draft.designHistory.push({ role: "assistant", text: assistantMessage.slice(0, 2000) }); draft.designHistory = draft.designHistory.slice(-8); spec.value = draft.currentSpec; name.value = draft.name; activePath = draft.entry || "index.html"; renderFiles(); renderEditor(); renderBindings(); if (parsed.changed) renderPreview(); appendChat("assistant", assistantMessage); aiStatus.textContent = parsed.changed ? "AI changes are ready to review" : "AI replied · no app changes"; if (parsed.changed) state.textContent = "AI draft";
      } catch (error) { appendChat("assistant", error.message || "The app could not be generated."); aiStatus.textContent = error.message || "Generation failed"; }
      finally { aiRunning = false; activeRequirement = null; renderQueue(); question.focus(); if (requirementQueue.length) queueMicrotask(drainQueue); }
    };
    const enqueueRequirement = () => { const attachments = pendingAttachments.map(attachment => ({ ...attachment })), text = question.value.trim() || (attachments.length ? "Use the attached files as context for this app change." : ""); if (!text || !options.requestAi) return; requirementQueue.push({ id: ++requirementSequence, text: text.slice(0,4000), attachments }); question.value = ""; pendingAttachments = []; renderPendingAttachments(); renderQueue(); drainQueue(); };
    name.value = draft.name || "Qanvas App";
    spec.value = draft.currentSpec;
    for (const item of draft.designHistory) appendChat(item.role, item.text);
    name.oninput = () => { draft.name = name.value.trim() || "Qanvas App"; state.textContent = "Unsaved changes"; };
    spec.oninput = () => { draft.currentSpec = spec.value.slice(0, 1200); state.textContent = "Unsaved changes"; };
    editor.addEventListener("input", () => { saveEditor(); resetCodeSearch(); schedulePreview(); });
    editor.addEventListener("scroll", renderCodeSearchHighlight, { passive: true });
    const searchHighlightResizeObserver = new ResizeObserver(renderCodeSearchHighlight); searchHighlightResizeObserver.observe(editor);
    editor.addEventListener("keydown", event => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "s") { event.preventDefault(); renderPreview(); }
      else if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "f") { event.preventDefault(); codeSearch.focus(); codeSearch.select(); }
    });
    filePicker.onchange = () => switchFile(filePicker.value);
    codeSearch.oninput = resetCodeSearch;
    codeSearch.onkeydown = event => { if (event.key === "Enter" || event.key === "Tab") { event.preventDefault(); findCode(event.shiftKey ? -1 : 1); } else if (event.key === "Escape") { event.preventDefault(); codeSearch.value = ""; resetCodeSearch(); } };
    dialog.querySelector("[data-app-code-search-previous]").onclick = () => findCode(-1);
    dialog.querySelector("[data-app-code-search-next]").onclick = () => findCode(1);
    dialog.querySelector("[data-app-format-code]").onclick = () => {
      try {
        const formatted = formatSource(activePath, editor.value);
        if (formatted === editor.value) { state.textContent = "Code is already formatted"; return; }
        editor.value = formatted; saveEditor(); resetCodeSearch(); schedulePreview(); state.textContent = `Formatted ${activePath} · unsaved changes`;
      } catch (error) { state.textContent = error.message || "Formatting was cancelled"; }
    };
    dialog.querySelector("[data-app-code-pane]").onclick = () => setCodePane(true);
    dialog.querySelector("[data-app-code-pane-hide]").onclick = () => setCodePane(false);
    advancedButton.onclick = () => { const open = !advancedPanel.open; if (open && designerBody.classList.contains("code-pane-open")) setCodePane(false); setAdvancedOpen(open); };
    dialog.querySelectorAll("[data-app-preview-mode]").forEach(button => button.onclick = () => setPreviewMode(button.dataset.appPreviewMode));
    const inspectMessage = event => { if (event.source !== iframe.contentWindow) return; if (event.data?.type === "qanvas.designer.inspect") locatePreviewSource(event.data); else if (event.data?.type === "qanvas.designer.mode.ready") setPreviewMode(previewMode); };
    window.addEventListener("message", inspectMessage);
    dialog.querySelector("[data-app-designer-preview-refresh]").onclick = renderPreview;
    dialog.querySelectorAll("[data-app-action-add]").forEach(button => button.onclick = () => { draft.permissions ||= {}; draft.permissions.actions ||= []; const kind = button.dataset.appActionAdd, base = kind === "api" ? "load-api" : "run-procedure"; let id = base, suffix = 2; while (draft.permissions.actions.some(item => item.id === id)) id = `${base}-${suffix++}`; draft.permissions.actions.push({ id, kind, connection: "", endpoint: "", procedure: "", allowViewer:true, outputMode: "replace", outputSource: "App result", maxRows: 5000 }); state.textContent = "Unsaved changes"; renderActions(); });
    dialog.querySelector("[data-app-binding-add]").onclick = () => { draft.bindings ||= []; let id = "binding", suffix = 2; while (draft.bindings.some(item => item.id === id)) id = `binding${suffix++}`; draft.bindings.push({ id, label: "Binding", valueType: "text", source: "constant", sourceId: payloadSources[0]?.sourceId || "", name: "", groupBy: "", aggregation: "Sum", value: "", fallback: "" }); state.textContent = "Unsaved changes"; renderBindings(); schedulePreview(); };
    const updateExternal = () => { draft.permissions.external = normalizeExternalPermissions({ openLinks: dialog.querySelector("[data-app-open-links]").checked, remoteImages: dialog.querySelector("[data-app-remote-images]").checked, linkHosts: dialog.querySelector("[data-app-link-hosts]").value.split(/[\s,;]+/), imageHosts: dialog.querySelector("[data-app-image-hosts]").value.split(/[\s,;]+/) }); state.textContent = "Unsaved changes"; renderExternalPermissions(); schedulePreview(); };
    dialog.querySelectorAll("[data-app-open-links],[data-app-remote-images],[data-app-link-hosts],[data-app-image-hosts]").forEach(control => control.addEventListener("change", updateExternal));
    dialog.querySelector("[data-app-google-maps]").onclick = () => { const hosts = new Set(draft.permissions.external.linkHosts); hosts.add("maps.google.com"); draft.permissions.external.openLinks = true; draft.permissions.external.linkHosts = [...hosts]; state.textContent = "Google Maps approved · unsaved changes"; renderExternalPermissions(); };
    const assetInput = dialog.querySelector("[data-app-asset-input]");
    dialog.querySelector("[data-app-asset-add]").onclick = () => assetInput.click();
    assetInput.onchange = async () => { const selected = [...assetInput.files]; assetInput.value = ""; for (const selectedFile of selected) { if (!imageTypes.has(selectedFile.type)) { state.textContent = `${selectedFile.name}: unsupported image type`; continue; } if (selectedFile.size > maxAssetBytes) { state.textContent = `${selectedFile.name}: image exceeds 5 MB`; continue; } const currentBytes = draft.assets.reduce((total, asset) => total + Math.floor(String(asset.dataUrl || "").length * 3 / 4), 0); if (currentBytes + selectedFile.size > maxAssetTotalBytes) { state.textContent = "Embedded images exceed the 20 MB app limit"; break; } const dataUrl = await new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(String(reader.result || "")); reader.onerror = () => reject(reader.error || new Error("Could not read image")); reader.readAsDataURL(selectedFile); }); draft.assets.push({ name: selectedFile.name, type: selectedFile.type, dataUrl }); } draft.assets = normalizeAssets(draft.assets); state.textContent = "Images added · unsaved changes"; renderAssets(); schedulePreview(); };
    dialog.querySelector("[data-app-ai-attachment-add]").onclick = () => attachmentInput.click();
    attachmentInput.onchange = () => { addAttachmentFiles(attachmentInput.files || []); attachmentInput.value = ""; };
    question.addEventListener("paste", event => { if (event.clipboardData?.files?.length) { event.preventDefault(); addAttachmentFiles(event.clipboardData.files); } });
    aiPanel.addEventListener("dragover", event => { if (event.dataTransfer?.types?.includes("Files")) { event.preventDefault(); aiPanel.classList.add("is-dropping-files"); } });
    aiPanel.addEventListener("dragleave", event => { if (!aiPanel.contains(event.relatedTarget)) aiPanel.classList.remove("is-dropping-files"); });
    aiPanel.addEventListener("drop", event => { aiPanel.classList.remove("is-dropping-files"); if (event.dataTransfer?.files?.length) { event.preventDefault(); addAttachmentFiles(event.dataTransfer.files); } });
    aiSend.onclick = enqueueRequirement;
    question.addEventListener("keydown", event => { if ((event.ctrlKey || event.metaKey) && event.key === "Enter") { event.preventDefault(); enqueueRequirement(); } });
    dialog.querySelector("[data-app-designer-source]").textContent = payloadSources.map(source => `${source.sourceName || "Source"} · ${source.totalRows || 0} rows`).join(" · ");
    dialog.querySelector("[data-app-designer-schema]").textContent = `${payloadSources.length} source${payloadSources.length === 1 ? "" : "s"} · ${payloadSources.reduce((total, source) => total + (source.schema?.columns?.length || 0), 0)} fields available`;
    dialog.querySelector("[data-app-designer-apply]").onclick = () => { saveEditor(); const actions=draft.permissions?.actions||[],ids=new Set(); for(const action of actions){action.id=String(action.id||"").trim();action.connection=String(action.connection||"").trim();const target=String(action.kind==="api"?action.endpoint||"":action.procedure||"").trim();if(!action.id||ids.has(action.id)||!action.connection||!target){state.textContent=!action.id?"Every action needs an ID":ids.has(action.id)?`Duplicate action ID: ${action.id}`:!action.connection?`Choose a connection for ${action.id}`:`Choose a target for ${action.id}`;return;}ids.add(action.id);} draft.name = name.value.trim() || "Qanvas App"; draft.currentSpec = spec.value.trim().slice(0,1200); draft.designHistory = (draft.designHistory||[]).slice(-8); options.onApply?.(copy(draft)); state.textContent = "Applied"; dialog.close("apply"); };
    dialog.addEventListener("close", () => { clearTimeout(previewTimer); unregisterPreview(); searchHighlightResizeObserver.disconnect(); window.removeEventListener("message", inspectMessage); options.onClose?.(); dialog.remove(); }, { once: true });
    applyPaneSizes(); renderFiles(); renderEditor(); renderActions(); renderBindings(); renderAssets(); renderExternalPermissions(); renderQueue(); renderPreview(); dialog.showModal(); question.focus();
    return dialog;
  }

  const style = document.createElement("style");
  style.textContent = `.qanvas-app-host{position:relative;width:100%;height:100%;overflow:hidden;background:var(--tile-background,#fff)}.qanvas-app-frame{display:block;width:100%;height:100%;border:0;background:transparent;pointer-events:none}.qanvas-app-host.is-interacting .qanvas-app-frame{pointer-events:auto}.qanvas-app-host [data-qanvas-app-interact]{position:absolute;right:8px;top:8px;z-index:2;padding:5px 9px;border-radius:999px;border:1px solid rgba(127,127,127,.35);background:rgba(255,255,255,.88);color:#182230;font:600 11px Segoe UI,sans-serif;box-shadow:0 2px 8px rgba(0,0,0,.12);opacity:0;transition:opacity .15s}.tile-app:hover [data-qanvas-app-interact],.qanvas-app-host:focus-within [data-qanvas-app-interact],.qanvas-app-host.is-protected [data-qanvas-app-interact]{opacity:1}.qanvas-app-host.is-interacting [data-qanvas-app-interact]{display:none}.qanvas-app-loading{display:grid;place-content:center;gap:8px;height:100%;text-align:center;color:var(--qreports-muted,#667085)}.qanvas-app-loading span{width:26px;height:26px;margin:auto;border:3px solid var(--qreports-grid,#d8dee8);border-top-color:var(--qreports-accent,#4f6ee8);border-radius:50%;animation:qanvas-app-spin .8s linear infinite}.qanvas-app-properties>[data-qanvas-app-properties-body]{display:grid;gap:10px;padding-top:8px}.qanvas-app-property-hero,.qanvas-app-dialog-preview{display:flex;gap:10px;align-items:center;padding:10px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:10px;background:var(--qreports-panel,var(--qreports-surface,#f4f7f5));color:var(--qreports-text,#182230)}.qanvas-app-property-hero>span,.qanvas-app-dialog-preview>span{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:var(--qreports-accent,#4f6ee8);color:var(--qreports-on-accent,#fff);font-weight:700}.qanvas-app-property-hero div,.qanvas-app-dialog-preview div{display:grid;min-width:0}.qanvas-app-property-hero small,.qanvas-app-dialog-preview small{color:var(--qreports-muted,#667085)}.qanvas-app-permissions{display:grid;grid-template-columns:1fr 1fr;gap:5px;padding:9px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:9px;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 28%,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);font-size:11px}.qanvas-app-permissions b{grid-column:1/-1}.qanvas-app-dialog{box-sizing:border-box;width:min(620px,92vw);padding:0;overflow:hidden;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:14px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);color-scheme:var(--qreports-color-scheme,light);box-shadow:0 24px 70px color-mix(in srgb,var(--qreports-text,#182230) 38%,transparent)}.qanvas-app-dialog::backdrop{background:color-mix(in srgb,var(--qreports-header,#182230) 48%,transparent)}.qanvas-app-dialog form{margin:0;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230)}.qanvas-app-dialog form>header,.qanvas-app-dialog form>footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;background:var(--qreports-header,#eef3f9);color:var(--qreports-header-text,var(--qreports-text,#182230))}.qanvas-app-dialog form>header{border-bottom:1px solid var(--qreports-grid,#cbd5e1)}.qanvas-app-dialog form>footer{justify-content:flex-start;border-top:1px solid var(--qreports-grid,#cbd5e1)}.qanvas-app-dialog form>header h2,.qanvas-app-dialog form>header p{margin:0}.qanvas-app-dialog form>header p{color:var(--qreports-muted,#667085);font-size:12px}.qanvas-app-dialog :is(button,input,select,textarea){border-color:var(--qreports-grid,#cbd5e1);background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230)}.qanvas-app-dialog section{display:grid;gap:14px;padding:18px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230)}.qanvas-app-dialog section>.property-empty{color:var(--qreports-muted,#667085)}.qanvas-app-dialog dl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0}.qanvas-app-dialog dl div{padding:10px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:8px;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 22%,var(--qreports-surface,#fff));color:var(--qreports-text,#182230)}.qanvas-app-dialog dt{font-size:11px;color:var(--qreports-muted,#667085)}.qanvas-app-dialog dd{margin:3px 0 0;font-weight:600}@keyframes qanvas-app-spin{to{transform:rotate(360deg)}}`;
  style.textContent += `#tileProperties:has(#qanvasAppProperties:not(.hidden)) #tileSourceLabel{display:none!important}`;
  style.textContent += `.qanvas-app-source-picker,.qanvas-app-table-access,.qanvas-app-parameter-access{display:grid;gap:7px;margin:0;padding:10px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:9px}.qanvas-app-source-picker legend,.qanvas-app-table-access legend,.qanvas-app-parameter-access legend{padding:0 4px;font-weight:650}.qanvas-app-parameter-access{font-size:12px}.qanvas-app-parameter-access legend{font-size:13px}.qanvas-app-parameter-access article b{font-size:12.5px}.qanvas-app-parameter-access>small,.qanvas-app-parameter-access article small{font-size:11px}.qanvas-app-source-picker label.check,.qanvas-app-table-access label.check,.qanvas-app-parameter-access label.check{display:flex;align-items:center;gap:6px;margin:0}.qanvas-app-source-picker label.check input,.qanvas-app-table-access label.check input,.qanvas-app-parameter-access label.check input{flex:none}.qanvas-app-source-picker small,.qanvas-app-table-access small,.qanvas-app-parameter-access small{margin-top:4px;color:var(--qreports-muted,#667085);line-height:1.35}.qanvas-app-source-picker code{color:var(--qreports-accent,#4f6ee8)}.qanvas-app-table-access article,.qanvas-app-parameter-access article{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;padding:9px;border:1px solid color-mix(in srgb,var(--qreports-grid,#cbd5e1) 72%,transparent);border-radius:8px;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 18%,var(--qreports-surface,#fff))}.qanvas-app-table-access article>div,.qanvas-app-table-access article>label:last-child,.qanvas-app-parameter-access article>div{grid-column:1/-1}.qanvas-app-table-access article>div,.qanvas-app-parameter-access article>div{display:grid}.qanvas-app-table-access article>div small,.qanvas-app-parameter-access article>div small{margin:0}.qanvas-app-table-access select{width:100%}`;
  document.head.append(style);

  const designerStyle = document.createElement("style");
  designerStyle.textContent = `
.qanvas-app-designer{box-sizing:border-box;width:min(1540px,98vw);height:min(920px,96vh);min-width:min(900px,96vw);min-height:600px;max-width:calc(100vw - 12px);max-height:calc(100vh - 12px);padding:0;overflow:hidden;resize:both;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:14px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);color-scheme:var(--qreports-color-scheme,light);box-shadow:0 28px 78px #0007}
.qanvas-app-designer::backdrop{background:color-mix(in srgb,var(--qreports-header,#182230) 56%,transparent)}
.qanvas-app-designer>form{display:grid;grid-template-rows:auto minmax(0,1fr) auto;height:100%;margin:0;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230)}
.qanvas-app-designer>form>header,.qanvas-app-designer>form>footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-color:var(--qreports-grid,#cbd5e1);background:var(--qreports-header,#eef3f9);color:var(--qreports-header-text,var(--qreports-text,#182230))}
.qanvas-app-designer>form>header{border-bottom:1px solid var(--qreports-grid,#cbd5e1)}.qanvas-app-designer>form>footer{justify-content:flex-end;border-top:1px solid var(--qreports-grid,#cbd5e1)}
.qanvas-app-designer h2,.qanvas-app-designer header p{margin:0}.qanvas-app-designer h2{font-size:21px}.qanvas-app-designer header p{margin-top:2px;color:var(--qreports-muted,#667085);font-size:12px}
.qanvas-app-designer-header-actions{display:flex;align-items:center;gap:7px}.qanvas-app-designer-header-actions>span{color:var(--qreports-muted,#667085);font-size:11px}.qanvas-app-designer-header-actions button{width:36px;height:34px;padding:0;font-size:19px}.qanvas-app-designer-header-actions [data-app-advanced-settings]{width:auto;padding:0 11px;font-size:11px;font-weight:650}.qanvas-app-designer-header-actions [data-app-advanced-settings].active{border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 14%,var(--qreports-header,#eef3f9));color:var(--qreports-header-text,var(--qreports-text,#182230))}
.qanvas-app-designer :is(button,input,select,textarea){border-color:var(--qreports-grid,#cbd5e1);background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230)}.qanvas-app-designer button.primary{border-color:var(--qreports-accent,#4f6ee8);background:var(--qreports-accent,#4f6ee8);color:var(--qreports-on-accent,#fff)}
.qanvas-app-designer-body{display:grid;container-type:size;grid-template-columns:var(--app-files-width,220px) 7px minmax(300px,var(--app-code-width,520px)) 7px minmax(330px,1fr);min-height:0;overflow:hidden;background:var(--qreports-surface,#fff)}
.qanvas-app-designer-files,.qanvas-app-designer-code,.qanvas-app-designer-result{min-width:0;min-height:0}.qanvas-app-designer-result{border-right:0}.qanvas-app-splitter{position:relative;z-index:2;min-width:7px;height:100%;cursor:col-resize;touch-action:none;background:var(--qreports-grid,#cbd5e1)}.qanvas-app-splitter::after{content:"";position:absolute;inset:0 2px;background:color-mix(in srgb,var(--qreports-text,#182230) 18%,transparent)}.qanvas-app-splitter:hover,.qanvas-app-splitter:focus-visible,.qanvas-app-splitter.active{outline:0;background:var(--qreports-accent,#4f6ee8)}.qanvas-app-splitter:hover::after,.qanvas-app-splitter:focus-visible::after,.qanvas-app-splitter.active::after{background:var(--qreports-on-accent,#fff)}
.qanvas-app-designer-files{overflow:auto;padding:14px;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 32%,var(--qreports-surface,#fff))}.qanvas-app-designer-files label{margin:0 0 16px;color:var(--qreports-text,#182230);font-weight:650}.qanvas-app-designer-files input{box-sizing:border-box;width:100%}
.qanvas-app-designer-section-title{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px}.qanvas-app-designer-section-title>div{display:grid}.qanvas-app-designer-section-title small{color:var(--qreports-muted,#667085);font-size:10px}
.qanvas-app-designer-files nav{display:grid;gap:5px}.qanvas-app-designer-files nav button{display:grid;grid-template-columns:28px minmax(0,1fr);align-items:center;gap:7px;width:100%;padding:8px;text-align:left}.qanvas-app-designer-files nav button span{display:grid;place-items:center;height:25px;border-radius:5px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 12%,transparent);color:var(--qreports-accent,#4f6ee8);font:700 10px Consolas,monospace}.qanvas-app-designer-files nav button.active{border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 12%,var(--qreports-surface,#fff));box-shadow:inset 3px 0 var(--qreports-accent,#4f6ee8)}
.qanvas-app-designer-files details{margin-top:15px;padding-top:10px;border-top:1px solid var(--qreports-grid,#cbd5e1)}.qanvas-app-designer-files summary{color:var(--qreports-text,#182230)}.qanvas-app-data-contract{display:grid;gap:5px;margin-top:8px;color:var(--qreports-muted,#667085);font-size:10px}.qanvas-app-data-contract code{width:max-content;padding:2px 5px;border-radius:4px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 10%,transparent);color:var(--qreports-accent,#4f6ee8)}
.qanvas-app-external-permissions{display:grid;gap:7px;margin-top:8px}.qanvas-app-external-permissions label{display:grid;gap:3px;margin:0;font-size:10px}.qanvas-app-external-permissions label.check{display:flex;align-items:center;gap:6px}.qanvas-app-external-permissions textarea{box-sizing:border-box;width:100%;min-height:46px;padding:6px;resize:vertical;font:10px/1.35 "Cascadia Mono",Consolas,monospace}.qanvas-app-external-permissions button,.qanvas-app-designer-files [data-app-asset-add]{width:100%;padding:6px;font-size:10px}.qanvas-app-external-permissions small{color:var(--qreports-muted,#667085);font-size:9px;line-height:1.35}
.qanvas-app-asset-list{display:grid;gap:6px;margin:8px 0}.qanvas-app-asset-list article{display:grid;grid-template-columns:34px minmax(0,1fr) 24px 24px;align-items:center;gap:6px;padding:6px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:7px}.qanvas-app-asset-list img{width:34px;height:34px;object-fit:contain;border-radius:4px;background:color-mix(in srgb,var(--qreports-grid,#cbd5e1) 25%,transparent)}.qanvas-app-asset-list article>div{display:grid;min-width:0}.qanvas-app-asset-list b,.qanvas-app-asset-list small,.qanvas-app-asset-list code{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.qanvas-app-asset-list small{color:var(--qreports-muted,#667085);font-size:8px}.qanvas-app-asset-list code{font-size:8px}.qanvas-app-asset-list button{width:24px;height:24px;padding:0}
.qanvas-app-action-list{display:grid;gap:8px;margin-top:9px}.qanvas-app-action-list article{display:grid;gap:6px;padding:8px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:8px;background:var(--qreports-surface,#fff)}.qanvas-app-action-list article>div{display:flex;align-items:center;justify-content:space-between;gap:6px}.qanvas-app-action-list article>div button{width:25px;height:25px;padding:0}.qanvas-app-action-list label{display:grid;gap:2px;margin:0;font-size:10px;font-weight:600}.qanvas-app-action-list label.check{display:flex;align-items:center;font-weight:400}.qanvas-app-action-list input:not([type=checkbox]),.qanvas-app-action-list select{box-sizing:border-box;width:100%;min-width:0;padding:5px;font-size:10px}.qanvas-app-action-buttons{display:flex;gap:5px;margin:8px 0}.qanvas-app-action-buttons button{min-width:0;padding:5px 7px;font-size:10px}.qanvas-app-designer-files details>small{display:block;color:var(--qreports-muted,#667085);font-size:9px;line-height:1.35}.qanvas-app-action-list .hidden{display:none}
.qanvas-app-designer-code{position:relative;display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:42px minmax(0,1fr);height:100cqh;max-height:100cqh;overflow:hidden;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 18%,var(--qreports-surface,#fff))}.qanvas-app-code-heading{position:relative;z-index:3;display:grid;grid-template-columns:124px minmax(150px,1fr) auto;align-items:center;gap:6px;padding:6px 10px;border-bottom:1px solid var(--qreports-grid,#cbd5e1);background:color-mix(in srgb,var(--qreports-header,#eef3f9) 18%,var(--qreports-surface,#fff))}.qanvas-app-code-file,.qanvas-app-code-actions,.qanvas-app-code-search{display:flex;align-items:center;gap:5px;min-width:0}.qanvas-app-code-file{grid-column:1}.qanvas-app-code-file>b{display:none}.qanvas-app-code-file select{box-sizing:border-box;width:124px;min-width:0;padding:4px 24px 4px 7px;font:600 11px/1.2 "Segoe UI",sans-serif}.qanvas-app-code-actions{grid-column:3;justify-content:flex-end}.qanvas-app-code-heading small{display:none;overflow:hidden;color:var(--qreports-muted,#667085);text-overflow:ellipsis;white-space:nowrap}.qanvas-app-code-heading button{padding:4px 7px;font-size:10px}.qanvas-app-code-search{grid-column:2;grid-row:1}.qanvas-app-code-search input{box-sizing:border-box;flex:1;min-width:80px;padding:5px 7px;font:10px/1.2 "Cascadia Mono",Consolas,monospace}.qanvas-app-code-search span{min-width:36px;color:var(--qreports-muted,#667085);font-size:9px;text-align:center}.qanvas-app-code-search button{width:24px;height:25px;padding:0}.qanvas-app-designer .qanvas-app-designer-code>textarea{position:relative;z-index:1;display:block;box-sizing:border-box;width:100%;height:100%;min-width:100%;min-height:0;max-height:none;margin:0;padding:14px;resize:none;border:0;border-radius:0;outline:0;background:color-mix(in srgb,var(--qreports-surface,#fff) 94%,var(--qreports-header,#eef3f9));color:var(--qreports-text,#182230);caret-color:var(--qreports-accent,#4f6ee8);font:12px/1.55 "Cascadia Mono",Consolas,monospace;tab-size:2;white-space:pre;overflow:auto}.qanvas-app-code-highlight{position:absolute;z-index:2;inset:0;pointer-events:none;overflow:hidden}.qanvas-app-code-highlight .line,.qanvas-app-code-highlight .match{position:absolute;display:block;box-sizing:border-box}.qanvas-app-code-highlight .line{border-block:1px solid color-mix(in srgb,var(--qreports-accent,#4f6ee8) 35%,transparent);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 13%,transparent)}.qanvas-app-code-highlight .match{border:1px solid var(--qreports-accent,#4f6ee8);border-radius:2px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 42%,transparent);box-shadow:0 0 0 1px color-mix(in srgb,var(--qreports-on-accent,#fff) 45%,transparent)}
.qanvas-app-designer-result{display:grid;height:100cqh;max-height:100cqh;contain:size layout;grid-template-rows:minmax(160px,var(--app-preview-height,360px)) 7px minmax(190px,1fr);overflow:hidden}.qanvas-app-splitter[data-app-splitter="result"]{grid-column:1/-1;width:100%;min-width:0;height:7px;min-height:7px;cursor:row-resize}.qanvas-app-splitter[data-app-splitter="result"]::after{inset:2px 0}.qanvas-app-preview-panel,.qanvas-app-ai-panel{display:grid;min-height:0;padding:12px}.qanvas-app-preview-panel{grid-template-rows:auto minmax(0,1fr);background:color-mix(in srgb,var(--qreports-header,#eef3f9) 18%,var(--qreports-surface,#fff))}.qanvas-app-preview-panel iframe{display:block;width:100%;height:100%;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:9px;background:#fff}
.qanvas-app-ai-panel{grid-template-rows:auto minmax(54px,1fr) auto auto;gap:8px;overflow:auto;border-top:1px solid var(--qreports-grid,#cbd5e1);background:var(--qreports-surface,#fff)}.qanvas-app-ai-chat{min-height:0;overflow:auto;padding:7px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:8px;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 22%,var(--qreports-surface,#fff))}.qanvas-app-ai-chat p{width:fit-content;max-width:92%;margin:4px 0;padding:7px 9px;border-radius:8px;white-space:pre-wrap;font-size:11px;line-height:1.4}.qanvas-app-ai-chat p.assistant{background:var(--qreports-surface,#fff)}.qanvas-app-ai-chat p.user{margin-left:auto;background:var(--qreports-accent,#4f6ee8);color:var(--qreports-on-accent,#fff)}
.qanvas-app-ai-compose{display:grid;gap:4px;margin:0;color:var(--qreports-text,#182230);font-size:10px;font-weight:650}.qanvas-app-ai-compose textarea{box-sizing:border-box;width:100%;min-height:54px;max-height:120px;margin:0;padding:8px;resize:vertical;font:12px/1.4 "Segoe UI",sans-serif}.qanvas-app-ai-actions{display:flex;align-items:center;justify-content:space-between;gap:8px}.qanvas-app-ai-actions small{overflow:hidden;color:var(--qreports-muted,#667085);font-size:10px;text-overflow:ellipsis;white-space:nowrap}.qanvas-app-ai-actions button{flex:none}
@media(max-width:1080px){.qanvas-app-designer-body{grid-template-columns:minmax(170px,var(--app-files-width,190px)) 7px minmax(300px,var(--app-code-width,420px)) 7px minmax(300px,1fr)}}
@media(max-width:820px){.qanvas-app-designer{min-width:0;resize:vertical}.qanvas-app-designer-body{display:grid;grid-template-columns:180px 7px minmax(0,1fr);grid-template-rows:minmax(330px,1fr) minmax(300px,1fr);overflow:auto}.qanvas-app-designer-body>[data-app-splitter="code"]{display:none}.qanvas-app-designer-result{grid-column:1/-1;grid-template-columns:1fr 1fr;grid-template-rows:minmax(250px,1fr);height:auto;max-height:none;border-top:1px solid var(--qreports-grid,#cbd5e1)}.qanvas-app-designer-result>[data-app-splitter="result"]{display:none}.qanvas-app-ai-panel{border-top:0;border-left:1px solid var(--qreports-grid,#cbd5e1)}}`;
  designerStyle.textContent += `
.qanvas-app-designer-body{position:relative;display:grid;grid-template-columns:minmax(420px,1fr) 7px minmax(320px,var(--app-ai-width,430px));container-type:size;min-height:0;overflow:hidden}
.qanvas-app-ai-panel{display:grid;grid-template-rows:auto auto minmax(90px,var(--app-chat-height,1fr)) 7px auto auto auto auto;gap:9px;min-width:0;min-height:0;height:100cqh;padding:14px;overflow:hidden;border:0;background:var(--qreports-surface,#fff)}
.qanvas-app-preview-panel{display:grid;grid-template-rows:auto minmax(0,1fr);min-width:0;min-height:0;height:100cqh;padding:14px;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 18%,var(--qreports-surface,#fff))}
.qanvas-app-preview-panel iframe{display:block;width:100%;height:100%;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:10px;background:#fff}
.qanvas-app-designer.resizing iframe{pointer-events:none}
.qanvas-app-splitter[data-app-splitter="main"],.qanvas-app-splitter[data-app-splitter="code"],.qanvas-app-splitter[data-app-splitter="advanced"]{width:7px;min-width:7px;height:100%;cursor:col-resize}
.qanvas-app-splitter[data-app-splitter="chat"]{width:100%;min-width:0;height:7px;min-height:7px;cursor:row-resize}.qanvas-app-splitter[data-app-splitter="chat"]::after{inset:2px 0}
.qanvas-app-current-spec{display:grid;min-width:0;margin:0;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:8px;color:var(--qreports-text,#182230);font-size:11px;font-weight:650;overflow:hidden}.qanvas-app-current-spec>summary{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:8px;padding:7px 9px;cursor:pointer;list-style-position:inside;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 28%,var(--qreports-surface,#fff))}.qanvas-app-current-spec>summary small{overflow:hidden;color:var(--qreports-muted,#667085);font-size:9px;font-weight:400;text-overflow:ellipsis;white-space:nowrap}.qanvas-app-current-spec textarea{box-sizing:border-box;width:100%;min-height:66px;max-height:150px;padding:8px;resize:vertical;border:0;border-top:1px solid var(--qreports-grid,#cbd5e1);border-radius:0;font:11px/1.4 "Segoe UI",sans-serif}.qanvas-app-current-spec:not([open]) textarea{display:none}
.qanvas-app-ai-chat{min-height:0;height:auto;overflow:auto;padding:8px}.qanvas-app-ai-compose textarea{min-height:72px;max-height:260px;resize:vertical}
.qanvas-app-ai-attachment-tools{display:flex;align-items:center;gap:7px}.qanvas-app-ai-attachment-tools button{padding:5px 8px;font-size:10px}.qanvas-app-ai-attachment-tools small{color:var(--qreports-muted,#667085);font-size:9px}.qanvas-app-ai-attachments{display:flex;flex-wrap:wrap;gap:6px}.qanvas-app-ai-attachments article{display:grid;grid-template-columns:30px minmax(70px,150px) 22px;align-items:center;gap:6px;padding:5px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:7px;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 24%,var(--qreports-surface,#fff))}.qanvas-app-ai-attachments img,.qanvas-app-ai-attachments article>span{display:grid;place-items:center;width:30px;height:30px;object-fit:cover;border-radius:5px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 12%,transparent);font-size:7px;font-weight:700}.qanvas-app-ai-attachments article>div{display:grid;min-width:0}.qanvas-app-ai-attachments b,.qanvas-app-ai-attachments small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:9px}.qanvas-app-ai-attachments small{color:var(--qreports-muted,#667085)}.qanvas-app-ai-attachments button{width:22px;height:22px;padding:0}.qanvas-app-ai-panel.is-dropping-files{outline:2px dashed var(--qreports-accent,#4f6ee8);outline-offset:-5px}.qanvas-app-ai-chat-files{display:block;margin-top:5px;opacity:.8;font-size:9px}
.qanvas-app-ai-queue{min-height:0;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:8px}.qanvas-app-ai-queue>summary{display:flex;justify-content:space-between;padding:6px 8px;cursor:pointer;font-size:10px;font-weight:650}.qanvas-app-ai-queue>summary span{display:grid;place-items:center;min-width:19px;height:19px;border-radius:99px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 14%,transparent);color:var(--qreports-accent,#4f6ee8)}.qanvas-app-ai-queue [data-app-ai-queue-list]{display:grid;gap:5px;max-height:150px;overflow:auto;padding:0 7px 7px}.qanvas-app-ai-queue article{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:start;gap:6px;padding:6px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:7px;background:color-mix(in srgb,var(--qreports-header,#eef3f9) 22%,var(--qreports-surface,#fff))}.qanvas-app-ai-queue article>span{padding-top:5px;color:var(--qreports-muted,#667085);font-size:9px}.qanvas-app-ai-queue textarea{box-sizing:border-box;width:100%;min-height:42px;padding:5px;resize:vertical;font:10px/1.3 "Segoe UI",sans-serif}.qanvas-app-ai-queue article>button{width:24px;height:24px;padding:0}.qanvas-app-ai-queue article.processing{border-color:var(--qreports-accent,#4f6ee8)}.qanvas-app-ai-queue .property-empty{margin:2px;color:var(--qreports-muted,#667085);font-size:10px}
.qanvas-app-binding-list{display:grid;gap:8px;margin:9px 0}.qanvas-app-binding-list article{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:8px;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:8px;background:var(--qreports-surface,#fff)}.qanvas-app-binding-list article>div{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between}.qanvas-app-binding-list article>div button{width:24px;height:24px;padding:0}.qanvas-app-binding-list label{display:grid;gap:2px;margin:0;font-size:9px;font-weight:600}.qanvas-app-binding-list :is(input,select){box-sizing:border-box;width:100%;min-width:0;padding:5px;font-size:10px}.qanvas-app-binding-list .property-empty{margin:0;color:var(--qreports-muted,#667085);font-size:10px}.qanvas-app-designer-files [data-app-binding-add]{width:100%;padding:6px;font-size:10px}
.qanvas-app-advanced:not([open]){display:none}.qanvas-app-advanced[open]{position:absolute;z-index:8;inset:10px;display:grid;box-sizing:border-box;grid-template-rows:minmax(0,1fr);min-width:0;min-height:0;padding:12px;overflow:hidden;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:11px;background:var(--qreports-surface,#fff);box-shadow:0 18px 48px #0005}
.qanvas-app-advanced-body{display:grid;box-sizing:border-box;grid-template-columns:minmax(190px,var(--app-advanced-width,360px)) 7px minmax(300px,1fr);width:100%;height:100%;min-width:0;min-height:0;max-height:100%;overflow:hidden}.qanvas-app-advanced-body .qanvas-app-designer-files{height:100%;min-height:0;max-height:100%;padding:12px;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable}.qanvas-app-advanced-body .qanvas-app-designer-code{height:100%;max-height:100%;min-height:0}
.qanvas-app-designer-body.code-pane-open{grid-template-columns:minmax(330px,1fr) 7px minmax(300px,var(--app-code-pane-width,500px)) 7px minmax(320px,var(--app-ai-width,430px))}.qanvas-app-designer-body.code-pane-open>.qanvas-app-designer-code{height:100cqh;max-height:100cqh}.qanvas-app-designer-body.code-pane-open>[data-app-splitter="code"]{display:block}
.qanvas-app-preview-actions{display:flex!important;grid-auto-flow:column;align-items:center;gap:5px}.qanvas-app-preview-actions button{padding:4px 7px;font-size:10px}.qanvas-app-preview-actions button[aria-pressed="true"]{border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 14%,var(--qreports-surface,#fff));color:var(--qreports-text,#182230)}
.qanvas-app-parameter-access{display:block!important;padding:0!important;overflow:hidden}.qanvas-app-parameter-access>summary{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 10px;cursor:pointer;font-size:12px;font-weight:650}.qanvas-app-parameter-access>summary span{display:grid;place-items:center;min-width:19px;height:19px;padding:0 4px;border-radius:99px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 14%,transparent);color:var(--qreports-accent,#4f6ee8);font-size:10px}.qanvas-app-parameter-access-body{display:grid;gap:7px;padding:0 10px 10px}.qanvas-app-parameter-access:not([open])>.qanvas-app-parameter-access-body{display:none}
@media(max-width:820px){.qanvas-app-designer-body{grid-template-columns:1fr;grid-template-rows:minmax(320px,1fr) 7px minmax(520px,1.35fr);overflow:auto}.qanvas-app-splitter[data-app-splitter="main"]{width:100%;height:7px;cursor:row-resize}.qanvas-app-ai-panel{height:auto;min-height:520px}.qanvas-app-preview-panel{height:auto;min-height:320px}.qanvas-app-advanced-body{grid-template-columns:190px 7px minmax(300px,1fr);overflow:auto}}
@media(max-height:760px){.qanvas-app-ai-panel{gap:6px;padding:10px}.qanvas-app-current-spec>summary{padding:5px 7px}.qanvas-app-ai-compose textarea{min-height:58px}.qanvas-app-ai-attachment-tools small{display:none}}
`;
  document.head.append(designerStyle);

  window.QanvasAppRuntime = { APP_VERSION, defaultDefinition, normalizeDefinitions, normalizeTile, placeholder, mountAll, dispatchCommand, notifyParameters, assemble, formatSource, openDesigner };
})();
