    if(columnCell){const bounds=columnCell.getBoundingClientRect(),step=Math.max(12,bounds.width);if(event.clientX>bounds.right){column=Math.min(999,lastColumn+Math.max(1,Math.ceil((event.clientX-bounds.right)/step)));extended=true;}}
