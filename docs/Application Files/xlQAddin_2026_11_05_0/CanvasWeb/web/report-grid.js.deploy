    if(!positions.length)return null;
    const top=Math.min(...positions.map(position=>position.row)),bottom=Math.max(...positions.map(position=>position.row)),left=Math.min(...positions.map(position=>position.column)),right=Math.max(...positions.map(position=>position.column));
    if(positions.length!==(bottom-top+1)*(right-left+1))return null;
    const keys=new Set(positions.map(position=>`${position.row}:${position.column}`));
    for(let row=top;row<=bottom;row++)for(let column=left;column<=right;column++)if(!keys.has(`${row}:${column}`))return null;
    return{tileId,top,bottom,left,right,height:bottom-top+1,width:right-left+1};
  }
  function sourceValue(value) {
