  }
  function showSelectedCellDraft(value){const cell=selectedCellElement();if(!cell)return;if(!cell.classList.contains('report-grid-cell-editing'))cell.dataset.gridCommittedHtml=cell.innerHTML;cell.textContent=String(value??'');cell.classList.add('report-grid-cell-editing');}
  function restoreSelectedCellDraft(){const cell=selectedCellElement();if(!cell?.classList.contains('report-grid-cell-editing'))return;cell.innerHTML=cell.dataset.gridCommittedHtml||'';delete cell.dataset.gridCommittedHtml;cell.classList.remove('report-grid-cell-editing');}
