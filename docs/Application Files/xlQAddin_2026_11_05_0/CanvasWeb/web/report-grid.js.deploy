    const bounds=anchor.getBoundingClientRect(),half=(handle.offsetWidth||3)/2;
    handle.style.left=`${Math.round(bounds.right-half)}px`;handle.style.top=`${Math.round(bounds.bottom-half)}px`;
  }
  function showFillHandle() {
