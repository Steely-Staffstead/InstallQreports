    }else{
      const from=direction==='left'?position.column:rectangle.right+1,to=direction==='left'?rectangle.left-1:position.column;
      for(let row=rectangle.top;row<=rectangle.bottom;row++)for(let column=from;column<=to;column++)targets.push({tileId:rectangle.tileId,row,column,kind:'value'});
