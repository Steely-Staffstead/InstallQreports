    for(const [tileId,positions] of byTile){
      const grid=selectionGrid(tileId);if(!grid)continue;
      const coordinates=new Set(positions.map(position=>`${position.row}:${position.column}`)),anchors=new Map();
      for(const position of positions){
        const anchor=visibleCellPosition(grid,position),element=selectedCellElement(anchor);if(!element)continue;
        const key=positionKey(anchor);if(!anchors.has(key))anchors.set(key,{element,coordinates:[]});anchors.get(key).coordinates.push(position);
      }
