    if(!painterDrag)return;
    const start=painterDrag.start,end=painterDrag.end,vertical=Math.abs(end.row-start.row)>Math.abs(end.column-start.column),low=Math.min(vertical?start.row:start.column,vertical?end.row:end.column),high=Math.max(vertical?start.row:start.column,vertical?end.row:end.column);
