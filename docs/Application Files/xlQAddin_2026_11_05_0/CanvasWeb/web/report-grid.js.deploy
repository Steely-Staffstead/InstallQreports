  function formulaGuideHtml() {
    return `<details class="report-grid-formula-help"><summary>Supported formulas</summary><p>Enter plain text directly, or start with <code>=</code> to calculate a formula. A simple entry such as <code>=40,5%</code> becomes <code>=0.405</code> with percent formatting; <code>=10,2</code> becomes <code>=10.2</code>. Function arguments still use commas. Use cell addresses such as <code>B2</code>, named cells, numbers, <code>+ − * /</code> and parentheses. <code>$B$2</code> keeps its row and column fixed when copying.</p><p>Comparisons: <code>= &lt;&gt; &lt; &lt;= &gt; &gt;=</code>. Text goes in double quotes. For example, <code>=IF(I12&lt;0,"GOOD","")</code> returns text or an empty cell. Use <code>&amp;</code> to join text, such as <code>="Year " &amp; B2</code>.</p><p>Functions: <code>IF</code>, <code>IFERROR</code>, <code>ABS</code>, <code>ROUND</code>, <code>SUM</code>, <code>AVG</code> (or <code>AVERAGE</code>), <code>MIN</code>, <code>MAX</code> and <code>DIVIDE</code>. Conditional aggregates use <code>COUNTIF(range, criterion)</code>, <code>SUMIF(range, criterion, sum_range)</code> and <code>AVERAGEIF(range, criterion, average_range)</code>; the last range is optional when it is the same as the condition range. Criteria can be values or text such as <code>"&gt;=10"</code>, <code>"North*"</code> or a cell reference.</p><p>Use ranges such as <code>=SUM(B2:B10)</code> or <code>=AVG(B2:B10)</code>, including rectangular ranges. Blank and text cells in a numeric range are ignored; an average with no numbers shows <code>#DIV/0!</code>. Only the chosen IF branch is calculated. IF calls can be nested, for example <code>=IF(A1&gt;0,"Positive",IF(A1&lt;0,"Negative","Zero"))</code>.</p><p>Results may show <code>#REF!</code>, <code>#DIV/0!</code>, <code>#CYCLE!</code>, <code>#VALUE!</code> or <code>#FORMULA!</code> when a reference or expression is invalid. Double-click a cell or press F2 to edit inside the grid. Click the formula to place the cursor, type a function name to see suggestions, or click another cell to insert its address. Drag across cells to insert a range, or drag an already highlighted reference to move that address. Press <code>F4</code> on a reference to cycle <code>A1 → $A$1 → A$1 → $A1 → A1</code>; with a selected cell, F4 repeats the latest formatting or insert action.</p></details>`;
  }
  function conditionalFormatHtml(cell,context,measures=[]) {
    const rule=cell?.conditionalFormat||{},operator=rule.operator||'<',color=rule.useThemeColor!==false,required=theme(context)?.requireColors===true,compareMode=rule.compareMode||'fixed';
    const picker=(key,defaultColor,defaultRole,legacyTheme=false)=>conditionalColorInput(rule,key,context,{defaultColor,defaultRole,legacyTheme});
    return `<details class="report-grid-conditional"><summary>Conditional formatting</summary><label class="check"><input type="checkbox" data-grid-conditional="enabled" ${rule.enabled?'checked':''}> Apply conditional formatting</label><div class="report-grid-conditional-condition"><label>Condition<select data-grid-conditional="operator">${[['<','Less than'],['<=','Less than or equal'],['>','Greater than'],['>=','Greater than or equal'],['=','Equal'],['<>','Not equal']].map(([value,label])=>`<option value="${escape(value)}" ${operator===value?'selected':''}>${label}</option>`).join('')}</select></label><label>Compare to<select data-grid-conditional="compareMode"><option value="fixed" ${compareMode==='fixed'?'selected':''}>Fixed value</option><option value="measure" ${compareMode==='measure'?'selected':''}>Measure</option></select></label></div>${compareMode==='measure'?`<label>Comparison measure<select data-grid-conditional="compareMeasure"><option value="">Choose measure…</option>${measures.map(measure=>{const name=measureKey(measure);return `<option value="${escape(name)}" ${name===rule.compareMeasure?'selected':''}>${escape(measureOptionLabel(measure))}</option>`;}).join('')}</select></label>`:`<label>Fixed value<input data-grid-conditional="threshold" type="number" step="any" value="${Number.isFinite(Number(rule.threshold))?Number(rule.threshold):0}"></label>`}<div class="two-cols"><label>Icon set<select data-grid-conditional="iconType">${['None','Arrows','Triangles','Circles','Status'].map(value=>`<option value="${value}" ${value===(rule.iconType||'None')?'selected':''}>${value}</option>`).join('')}</select></label><label>Icon position<select data-grid-conditional="iconPosition"><option value="left" ${rule.iconPosition!=='right'?'selected':''}>Left</option><option value="right" ${rule.iconPosition==='right'?'selected':''}>Right</option></select></label></div><label>Text color${picker('textColor','#c43d4b','negative',color||required)}</label><label class="check"><input type="checkbox" data-grid-conditional="useBackground" ${rule.useBackground?'checked':''}> Also color background when condition matches</label><label>Background color${picker('backgroundColor','#fff0f0','surface',required)}</label><label class="check"><input type="checkbox" data-grid-conditional="strength" ${rule.strength?'checked':''}> Color background by value strength</label><div class="two-cols"><label>Low color${picker('lowColor','#f1f5ff','surface')}</label><label>High color${picker('highColor','#536ee1','accent')}</label></div><div class="two-cols"><label>At / above icon color${picker('goodColor','#16844a','positive')}</label><label>Below icon color${picker('badColor','#c43d4b','negative')}</label></div><small>Rules use the underlying number before display formatting. Each color can follow a canvas theme role or use a custom value.</small></details>`;
  }
  function updateConditionalFormat(cell,input) {
    const key=input.dataset.gridConditional;if(!cell||!['enabled','operator','threshold','compareMode','compareMeasure','iconType','iconPosition','useThemeColor','textColor','useBackground','backgroundColor','strength','lowColor','highColor','goodColor','badColor'].includes(key))return false;
    const rule=cell.conditionalFormat||={operator:'<',threshold:0,useThemeColor:true,textColor:'#c43d4b',backgroundColor:'#fff0f0'};
    rule[key]=input.type==='checkbox'?input.checked:key==='threshold'?Number(input.value)||0:input.value;
    if(input.matches('[data-grid-unified-color]')){const role=input.dataset.themeRole||'';rule[`${key}Mode`]=role?'theme':'custom';if(role)rule[`${key}ThemeRole`]=role;else delete rule[`${key}ThemeRole`];if(key==='textColor')rule.useThemeColor=false;}
    if(key==='useThemeColor'){delete rule.textColorMode;delete rule.textColorThemeRole;}
    return true;
  }
  function setSheetCell(grid,position,cell) {
    grid.rows[position.row].cells||=[];grid.rows[position.row].cells[position.column]=cell;
  }
  function rewriteMovedReferences(grid,mapping) {
    const rewrite=cell=>{if(cell?.formula)cell.formula=mapFormulaAddresses(cell.formula,(match,fixedColumn,letters,fixedRow,digits)=>{
      let column=0;for(const letter of letters.toUpperCase())column=column*26+letter.charCodeAt(0)-64;
      const target=mapping.get(`${Number(digits)}:${column}`);
      return target?`${fixedColumn?'$':''}${columnAddress(target.column-1)}${fixedRow?'$':''}${target.row}`:match;
    });};
    for(const row of grid.rows)for(const cell of row.cells||[])rewrite(cell);
  }
  function cutGrid(grid,positions,axis,tileId) {
    if(!positions.length||positions.some(position=>!validPosition(grid,position)))return false;
    const kind=axis==='row'?'row':axis==='column'?'column':'cells';
    const indices=kind==='row'?[...new Set(positions.map(position=>position.row))].filter(index=>index>=0).sort((a,b)=>a-b):kind==='column'?[...new Set(positions.map(position=>position.column))].filter(index=>index>=0).sort((a,b)=>a-b):[];
    if(kind!=='cells'&&!indices.length)return false;
    const origin={row:Math.min(...positions.map(position=>position.row)),column:Math.min(...positions.map(position=>position.column))};
    clipboard={mode:'cut',kind,tileId,grid,origin,indices,positions:positions.map(position=>({...position,cell:structuredClone(sheetCell(grid,position)||{})}))};
    paintFormat=null;updatePainterClass();return true;
  }
  function pasteCutGrid(grid,position) {
    const cut=clipboard;
    if(cut?.mode!=='cut'||cut.grid!==grid||cut.tileId!==position.tileId||!validPosition(grid,position))return false;
    if(cut.kind==='row'||cut.kind==='column'){
      const rowAxis=cut.kind==='row',axis=rowAxis?'row':'column',target=position[axis];
      if(selectionAxis!==axis||target<0)return false;
      const count=rowAxis?grid.rows.length:grid.columns.length,from=cut.indices;
      if(from.some(index=>index>=count)||from.includes(target))return false;
      const order=Array.from({length:count},(_,index)=>index),remaining=order.filter(index=>!from.includes(index));
      const insertAt=remaining.filter(index=>index<target).length;
      remaining.splice(insertAt,0,...from);
      const mapping=new Map();
      order.forEach(oldIndex=>{const newIndex=remaining.indexOf(oldIndex);if(newIndex!==oldIndex){const oldCoordinate=oldIndex+1,newCoordinate=newIndex+1;for(let cross=1;cross<=(rowAxis?grid.columns.length:grid.rows.length);cross++)mapping.set(rowAxis?`${oldCoordinate}:${cross}`:`${cross}:${oldCoordinate}`,rowAxis?{row:newCoordinate,column:cross}:{row:cross,column:newCoordinate});}});
      if(rowAxis)grid.rows=remaining.map(index=>grid.rows[index]);
      else {grid.columns=remaining.map(index=>grid.columns[index]);for(const row of grid.rows){const cells=row.cells||[];row.cells=remaining.map(index=>cells[index]||{});}}
      rewriteMovedReferences(grid,mapping);
      const newIndices=from.map(index=>remaining.indexOf(index)),first=Math.min(...newIndices);
      selectionAxis=axis;
      selectCells(newIndices.flatMap(index=>axisCells(grid,{tileId:position.tileId,row:rowAxis?index:0,column:rowAxis?0:index,kind:'value'},axis)),{tileId:position.tileId,row:rowAxis?first:0,column:rowAxis?0:first,kind:'value'});
    }else{
      const rowDelta=position.row-cut.origin.row,columnDelta=position.column-cut.origin.column;
      const destinations=cut.positions.map(source=>({tileId:position.tileId,row:source.row+rowDelta,column:source.column+columnDelta}));
      for(const dest of destinations){dest.kind='value';if(!validPosition(grid,dest))return false;}
      const mapping=new Map();
      cut.positions.forEach((source,index)=>mapping.set(`${source.row+1}:${source.column+1}`,{row:destinations[index].row+1,column:destinations[index].column+1}));
      for(const source of cut.positions)setSheetCell(grid,source,{});
      cut.positions.forEach((source,index)=>setSheetCell(grid,destinations[index],structuredClone(source.cell)));
      rewriteMovedReferences(grid,mapping);
