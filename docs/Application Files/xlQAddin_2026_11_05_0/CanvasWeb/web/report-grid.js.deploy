      });
      panel.addEventListener('change',event=>restoreSelectionFocusAfterSetting(event.target));
      panel.addEventListener('click',event=>{if(event.target.closest('[data-grid-format-toggle],[data-grid-format-align],[data-border-preset],[data-selection-border],[data-grid-auto],[data-grid-command],[data-grid-input-mode]'))restoreSelectionFocusAfterSetting(event.target);});
      panel.addEventListener('input',event=>{
        if(event.target.dataset.gridProperty==='formula'){const current=propertyContext.tile(),grid=current?.reportGrid;if(grid&&selectedCell?.tileId===current.id&&validPosition(grid,selectedCell)){setCellEntry(grid,selectedCell,event.target.value,false);if(!syncingInlineFormula)showSelectedCellDraft(event.target.value);}highlightFormulaReferences(event.target.value);return;}
        if(!event.target.hasAttribute('data-grid-custom-format'))return;
        const preview=panel.querySelector('[data-grid-format-preview]');
        if(preview)preview.textContent=`Preview: ${propertyContext.format?.(1234567.89,event.target.value)||''}`;
      });
    }
     viewPanel.classList.toggle('hidden',tile?.kind!=='reportGrid');
     controlsPanel.classList.toggle('hidden',tile?.kind!=='reportGrid');
     panel.classList.toggle('hidden',tile?.kind!=='reportGrid');
    if (tile?.kind!=='reportGrid') return;
    const grid=normalizeGrid(tile.reportGrid||defaults()),position=selectedCell;
    viewPanel.querySelector('[data-report-grid-view-properties]').innerHTML=gridViewOptionsHtml(grid);
     viewPanel.after(controlsPanel);
     controlsPanel.after(panel);
     if (!validPosition(grid,position)||position.tileId!==tile.id) {
       controlsPanel.querySelector('[data-report-grid-controls]').innerHTML='<p class="property-empty">Select a grid cell to use these controls.</p>';
       panel.querySelector('[data-report-grid-properties]').innerHTML=`<p class="property-empty">Click a cell, row number, or column letter in the grid to format it here.</p>`;
       return;
     }
     const multi=selectedFormatCells(grid,tile);
    if(multi.length>1){const axisContext=selectedAxisContext(grid,tile),axisIndexes=selectedAxisIndexes(grid,tile),axisLabel=axisIndexes.length?`Selected ${selectionAxis}${axisIndexes.length===1?'':'s'}`:'Selected cells',conditionalOpen=panel.querySelector('.report-grid-conditional')?.open??false;controlsPanel.classList.remove('hidden');controlsPanel.querySelector('[data-report-grid-controls]').innerHTML=`<div class="report-grid-mini-toolbar" role="toolbar" aria-label="Selected grid actions"><div class="report-grid-tool-group" role="group" aria-label="Copy / paste"><span class="report-grid-tool-label">Copy / paste</span><div class="report-grid-tool-buttons"><button type="button" data-grid-command="copy-all" title="Copy selected ${selectionAxis||'cells'} (Ctrl+C)">▣ Copy</button><button type="button" data-grid-command="copy-formula" title="Copy formulas or values">ƒx Values</button><button type="button" data-grid-command="copy-format" title="Copy formats">▧ Formats</button><button type="button" data-grid-command="cut" title="Cut selected ${selectionAxis||'cells'} (Ctrl+X)">✂ Cut</button><button type="button" data-grid-command="paste" title="Paste (Ctrl+V)" ${clipboard?'':'disabled'}>↧ Paste</button></div></div></div>${selectedAxisDimensionsHtml(grid,tile)}`;panel.querySelector('summary').textContent=axisLabel;panel.querySelector('[data-report-grid-properties]').innerHTML=`${axisContext?crossFilterHtml(axisContext.owner,axisContext.sourceId,context,axisContext.axis):''}${multiFormatHtml(grid,tile,context)}`;if(conditionalOpen)panel.querySelector('.report-grid-conditional')?.setAttribute('open','');return;}
     controlsPanel.classList.remove('hidden');panel.querySelector('summary').textContent='Report grid cell';
     const row=grid.rows[position.row],column=grid.columns[position.column],value=sheetCell(grid,position),style=effectiveStyle(grid,position),sources=context.sources();
    const address=formulaAddress(grid,position),axisContext=selectedAxisContext(grid,tile);
    const sourceId=value?.sourceId||column?.sourceId||row?.sourceId||tile.sourceId||sources[0]?.id||'main',measures=context.measures(sourceId);
    const rendered=[...document.querySelectorAll(`.tile-reportGrid[data-id="${CSS.escape(tile.id)}"] [data-report-grid-cell]`)].find(cell=>cell.dataset.reportGridCell===position.kind&&Number(cell.dataset.gridRow??-1)===position.row&&Number(cell.dataset.gridColumn??-1)===position.column);
    const previewText=rendered?.textContent?.trim()||'Cell preview';
    const identityHtml=address?`<div class="report-grid-cell-identity"><strong>${escape(address)}</strong><input data-grid-property="name" value="${escape(value?.name||'')}" placeholder="Cell name" aria-label="Cell name"></div>`:'';
    const selected=(actual,expected)=>actual===expected?'selected':'';
    const conditionalOpen=panel.querySelector('.report-grid-conditional')?.open??false;
    const formulaHelpOpen=panel.querySelector('.report-grid-formula-help')?.open??false;
     controlsPanel.querySelector('[data-report-grid-controls]').innerHTML=gridToolbarHtml(grid,position)+gridDimensionsHtml(grid,position);
     panel.querySelector('[data-report-grid-properties]').innerHTML=`${identityHtml}${axisContext?crossFilterHtml(axisContext.owner,axisContext.sourceId,context,axisContext.axis):''}${effectiveCrossFilterHtml(grid,position,context)}${position.column===0&&row.kind==='heading'?`<label class="check"><input type="checkbox" data-grid-property="spanAllColumns" ${row.spanAllColumns?'checked':''}> Span across all columns</label>`:''}${sheetEditorHtml(grid,position,tile,context)}${conditionalFormatHtml(value,propertyContext,measures)}<h4>Cell formatting</h4>${themeEditorHtml(style,propertyContext)}${formatToolbarHtml(style,previewText,propertyContext)}${borderEditorHtml(style,propertyContext)}`;
    if(conditionalOpen)panel.querySelector('.report-grid-conditional')?.setAttribute('open','');
    if(formulaHelpOpen)panel.querySelector('.report-grid-formula-help')?.setAttribute('open','');
  }
  function gridCodeTableHtml(grid) {
    const codeCell=(position,tag='td')=>{
      const cell=sheetCell(grid,position),formula=String(cell?.formula||''),measure=String(cell?.measure||''),manual=String(cell?.text??'');
      const content=formula||measure||manual,kind=formula?'formula':measure?'measure':content?'text':'blank',address=`${columnAddress(position.column)}${position.row+1}`,source=cell?.sourceId||grid.rows[position.row]?.sourceId||grid.columns[position.column]?.sourceId||'',title=`${address}${source?` · Source: ${source}`:''}${content?` · ${content}`:''}`;
      return `<${tag} class="report-grid-code-cell report-grid-code-${kind}" title="${escape(title)}"><span>${escape(content)}</span></${tag}>`;
    };
    const columns=grid.columns||[],rows=grid.rows||[];
    const letters=`<thead><tr class="report-grid-code-letters"><th class="report-grid-code-axis"></th>${columns.map((item,index)=>{const filter=crossFilterParts(item.crossFilter),value=filter.advanced||filter.field&&`${filter.field}=${filter.value}`;return `<th class="report-grid-code-axis" title="${value?escape(`Filter: ${value}`):''}">${columnAddress(index)}${value?' <small class="report-grid-code-filter">⌄</small>':''}</th>`;}).join('')}</tr></thead>`;
    const body=rows.map((item,row)=>{const filter=crossFilterParts(item.crossFilter),value=filter.advanced||filter.field&&`${filter.field}=${filter.value}`;return `<tr><th class="report-grid-code-axis" title="${value?escape(`Filter: ${value}`):''}">${row+1}${value?' <small class="report-grid-code-filter">⌄</small>':''}</th>${columns.map((_,column)=>codeCell({kind:'value',row,column})).join('')}</tr>`;}).join('');
    return `<table class="report-grid-code-table">${letters}<tbody>${body}</tbody></table>`;
  }
  function makeDialogMovable(dialog,handle) {
    let drag=null;handle.addEventListener('mousedown',event=>{if(event.button!==0||event.target.closest('button,input,select,textarea,a'))return;const rect=dialog.getBoundingClientRect();dialog.style.position='fixed';dialog.style.left=`${rect.left}px`;dialog.style.top=`${rect.top}px`;dialog.style.margin='0';drag={startX:event.clientX,startY:event.clientY,left:rect.left,top:rect.top,width:rect.width,height:rect.height};dialog.classList.add('panel-moving');event.preventDefault();});window.addEventListener('mousemove',event=>{if(!drag)return;dialog.style.left=`${Math.max(8,Math.min(drag.left+event.clientX-drag.startX,innerWidth-drag.width-8))}px`;dialog.style.top=`${Math.max(8,Math.min(drag.top+event.clientY-drag.startY,innerHeight-drag.height-8))}px`;});window.addEventListener('mouseup',()=>{if(!drag)return;drag=null;dialog.classList.remove('panel-moving');});
  }
  function openFindReplace(tile) {
    document.querySelector('.report-grid-find-dialog')?.remove();
    clearGridFindHighlights();
    const grid=normalizeGrid(tile.reportGrid||defaults());
    const selected=activeCells().filter(position=>position.tileId===tile.id&&validPosition(grid,position));
    const selectionScope=selected.length>1;
    const scope=(selectionScope?selected:gridValuePositions(grid,tile.id)).map(position=>({...position}));
    const dialog=document.createElement('dialog');
    dialog.className='report-grid-dialog report-grid-find-dialog';
    dialog.innerHTML=`<div class="report-grid-dialog-head"><div><h2>Find and replace</h2><p>${selectionScope?`Searching ${scope.length} selected cells`:'Searching the entire grid'}</p></div><button type="button" data-close aria-label="Close">×</button></div><div class="report-grid-find-body"><div class="report-grid-find-fields"><label>Find<input type="text" data-find-text autocomplete="off"></label><label>Replace with<input type="text" data-replace-text autocomplete="off"></label></div><div class="report-grid-find-options"><label class="check"><input type="checkbox" data-match-case> Match case</label><p class="report-grid-find-status" data-find-status>Enter text, then choose Find all.</p></div><div class="report-grid-find-actions"><button type="button" data-find-all>Find all</button><button type="button" data-previous disabled>Previous</button><button type="button" data-next disabled>Next</button><button type="button" data-replace-one disabled>Replace</button><button type="button" data-replace-all disabled>Replace all</button><button type="button" data-close>Close</button></div></div>`;
    document.body.append(dialog);
    const findInput=dialog.querySelector('[data-find-text]'),replaceInput=dialog.querySelector('[data-replace-text]'),matchCaseInput=dialog.querySelector('[data-match-case]'),status=dialog.querySelector('[data-find-status]');
    const matchButtons=[...dialog.querySelectorAll('[data-previous],[data-next],[data-replace-one],[data-replace-all]')];
    let matches=[],current=-1,stale=true;
    const updateStatus=(message)=>{status.textContent=message;const enabled=matches.length>0;matchButtons.forEach(button=>button.disabled=!enabled);};
    const selectMatch=index=>{
      if(!matches.length)return;
      current=(index+matches.length)%matches.length;
      const position=matches[current];
      selectCells([position],position);selectionAnchor=position;selectionAxis=null;
      focusSelectedCell(true);highlightSelection();refreshTopToolbar(tile);markGridFindHighlights(matches,current);
      selectedCellElement(position)?.scrollIntoView({block:'nearest',inline:'nearest'});
      updateStatus(`${current+1} of ${matches.length} matches`);
    };
    const findAll=(selectFirst=true)=>{
      const needle=String(findInput.value||'');
      if(!needle){matches=[];current=-1;clearGridFindHighlights();updateStatus('Enter text to search.');return false;}
      const normalize=value=>matchCaseInput.checked?String(value??''):String(value??'').toLocaleLowerCase();
      const expected=normalize(needle);
      matches=scope.filter(position=>normalize(gridSearchText(grid,position)).includes(expected));
      current=-1;stale=false;markGridFindHighlights(matches);
      if(matches.length&&selectFirst)selectMatch(0);else updateStatus(matches.length?`${matches.length} matches found.`:'No matches found.');
      return matches.length>0;
    };
    const changed=()=>{stale=true;matches=[];current=-1;clearGridFindHighlights();updateStatus('Search changed. Choose Find all.');};
    const commit=()=>{propertyContext?.change?.();document.dispatchEvent(new CustomEvent('report-grid-painted',{detail:{tileId:tile.id}}));};
    dialog.addEventListener('click',event=>{
      if(event.target.closest('[data-close]')){dialog.close();return;}
      if(event.target.closest('[data-find-all]')){findAll(true);return;}
      if(event.target.closest('[data-previous]')){if(stale&&!findAll(false))return;selectMatch(current-1);return;}
      if(event.target.closest('[data-next]')){if(stale&&!findAll(false))return;selectMatch(current+1);return;}
      if(event.target.closest('[data-replace-one]')){
        if((stale||!matches.length)&&!findAll(true))return;
        const target=matches[current<0?0:current],nextIndex=Math.max(0,current);
        setGridSearchText(grid,target,replaceGridSearchText(gridSearchText(grid,target),findInput.value,replaceInput.value,matchCaseInput.checked,false));
        commit();requestAnimationFrame(()=>{findAll(false);if(matches.length)selectMatch(Math.min(nextIndex,matches.length-1));else updateStatus('1 cell replaced. No matches remain.');});
        return;
      }
      if(event.target.closest('[data-replace-all]')){
        if((stale||!matches.length)&&!findAll(false))return;
        const affected=[...matches];
        affected.forEach(position=>setGridSearchText(grid,position,replaceGridSearchText(gridSearchText(grid,position),findInput.value,replaceInput.value,matchCaseInput.checked,true)));
        matches=[];current=-1;stale=true;clearGridFindHighlights();commit();updateStatus(`${affected.length} cells replaced.`);
      }
    });
    findInput.addEventListener('input',changed);matchCaseInput.addEventListener('change',changed);
    findInput.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();findAll(true);}});
    dialog.addEventListener('close',()=>{clearGridFindHighlights();dialog.remove();});
    dialog.show();
    makeDialogMovable(dialog,dialog.querySelector('.report-grid-dialog-head'));
    findInput.focus();
  }
  function openDesigner(tile) {
    document.querySelector('.report-grid-dialog')?.remove();
    const grid=normalizeGrid(structuredClone(tile.reportGrid||defaults()));
    const dialog=document.createElement('dialog');
    dialog.className='report-grid-dialog report-grid-code-dialog';
    dialog.innerHTML=`<div class="report-grid-dialog-head"><div><h2>View grid codes</h2><p>Read-only overview of cell text, formulas, measures, and row or column filters.</p></div><button type="button" data-close aria-label="Close">×</button></div><div class="report-grid-code-scroll">${gridCodeTableHtml(grid)}</div><div class="report-grid-code-footer">${grid.rows.length} rows · ${grid.columns.length} columns</div>`;
    document.body.append(dialog);
    dialog.addEventListener('click',event=>{if(event.target.closest('[data-close]'))dialog.close();});
    dialog.addEventListener('close',()=>dialog.remove());
    dialog.showModal();
    makeDialogMovable(dialog,dialog.querySelector('.report-grid-dialog-head'));
  }
  window.CanvasReportGrid = { defaults, render, updateViewport, openDesigner, handleCanvasClick, renderProperties, clearSelection, selectionData };
})();
