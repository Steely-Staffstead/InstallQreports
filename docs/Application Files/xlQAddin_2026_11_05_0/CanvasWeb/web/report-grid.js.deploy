          const address=/^\$?([A-Za-z]+)\$?([1-9]\d*)$/.exec(name);
          if(address){let index=0;for(const letter of address[1].toUpperCase())index=index*26+letter.charCodeAt(0)-64;return at(Number(address[2])-1,index-1);}
