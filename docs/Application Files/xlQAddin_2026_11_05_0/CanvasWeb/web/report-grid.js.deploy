  function selectedCellSummary(){
    const positions=activeCells();if(positions.length<=1)return null;
    const tileId=positions[0].tileId,current=propertyContext?.tile?.(),tile=current?.id===tileId?current:window.canvasWeb?.viewerDocument?.()?.pages?.flatMap(page=>[...(page.tiles||[]),...(page.graphics||[])])?.find(item=>item.id===tileId),grid=tile?.reportGrid;
    const evaluationContext=renderContexts.get(tileId)||propertyContext;
    if(!tile||!grid||!evaluationContext)return{tileId,count:positions.length,numericCount:0,sum:0};
    const calculate=calculateCells(grid,tile,evaluationContext);let numericCount=0,sum=0;
    for(const position of positions){
      if(position.tileId!==tileId||!validPosition(grid,position))continue;
      try{const number=summaryNumber(calculate(position.row,position.column));if(Number.isFinite(number)){numericCount++;sum+=number;}}catch{}
    }
    return{tileId,count:positions.length,numericCount,sum};
