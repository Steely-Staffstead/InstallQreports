    const rowCell=node.querySelector(`[data-report-grid-cell]:not([data-grid-axis])[data-grid-row="${lastRow}"][data-grid-column="${referenceColumn}"]`),columnCell=node.querySelector(`[data-report-grid-cell]:not([data-grid-axis])[data-grid-row="${referenceRow}"][data-grid-column="${lastColumn}"]`);
