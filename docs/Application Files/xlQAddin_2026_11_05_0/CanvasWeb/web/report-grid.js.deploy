        element.classList.add('report-grid-cell-selected');
        if(covered.some(position=>missing(position.row-1,position.column)))element.classList.add('report-grid-selection-top');
        if(covered.some(position=>missing(position.row,position.column+1)))element.classList.add('report-grid-selection-right');
        if(covered.some(position=>missing(position.row+1,position.column)))element.classList.add('report-grid-selection-bottom');
