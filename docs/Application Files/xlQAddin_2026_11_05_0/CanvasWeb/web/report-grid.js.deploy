    document.querySelectorAll('.tile-reportGrid .report-grid-cell-cut').forEach(cell=>cell.classList.remove('report-grid-cell-cut'));
    if(clipboard?.mode==='cut')for(const position of clipboard.positions)selectedCellElement(position)?.classList.add('report-grid-cell-cut');
  }
