    clipboard=null;updatePainterClass();return true;
  }
  function conditionalMatches(rule,number,comparison) {
    const operator=rule.operator||'<';return operator==='<'?number<comparison:operator==='<='?number<=comparison:operator==='>'?number>comparison:operator==='>='?number>=comparison:operator==='='?number===comparison:operator==='<>'?number!==comparison:false;
  }
  function conditionalColorState(rule,key,context,{defaultColor,defaultRole,legacyTheme=false}={}) {
    const mode=rule?.[`${key}Mode`]||(legacyTheme?'theme':'custom'),role=mode==='theme'?(rule?.[`${key}ThemeRole`]||defaultRole):'',resolved=role?roles(context)[role]:rule?.[key];
    return {mode,role,resolved:hex(resolved,defaultColor)};
  }
  function conditionalStrengthColor(rule,number,range) {
    if(!rule.strength||!Number.isFinite(number)||!Number.isFinite(range?.minimum)||!Number.isFinite(range?.maximum))return '';
    const low=conditionalColorState(rule,'lowColor',range.context||null,{defaultColor:'#f1f5ff',defaultRole:'surface'}).resolved,high=conditionalColorState(rule,'highColor',range.context||null,{defaultColor:'#536ee1',defaultRole:'accent'}).resolved,amount=Math.max(0,Math.min(1,(number-range.minimum)/(range.maximum-range.minimum||1))),channel=index=>Math.round(parseInt(low.slice(index,index+2),16)*(1-amount)+parseInt(high.slice(index,index+2),16)*amount).toString(16).padStart(2,'0');return `#${channel(1)}${channel(3)}${channel(5)}`;
  }
  function conditionalStyleCss(cell,value,context,comparisonValue,range) {
    const rule=cell?.conditionalFormat;if(!rule?.enabled||value==null||value==='')return '';
    const number=Number(value),threshold=Number(rule.compareMode==='measure'?comparisonValue:rule.threshold??0);if(!Number.isFinite(number))return '';
    const colorRange={...range,context},strength=conditionalStrengthColor(rule,number,colorRange),matches=Number.isFinite(threshold)&&conditionalMatches(rule,number,threshold);if(!matches&&!strength)return '';
    const themed=theme(context)?.requireColors===true||rule.useThemeColor!==false,negative=hex(roles(context).negative,'#c43d4b'),color=conditionalColorState(rule,'textColor',context,{defaultColor:'#c43d4b',defaultRole:'negative',legacyTheme:themed}).resolved;
    const background=strength||matches&&rule.useBackground?(strength||conditionalColorState(rule,'backgroundColor',context,{defaultColor:'#fff0f0',defaultRole:'surface',legacyTheme:theme(context)?.requireColors===true}).resolved):'';
    return `${matches?`color:${color}!important;`:''}${background?`background:${background}!important;`:''}`;
  }
  function conditionalIconHtml(cell,value,comparisonValue,content,context) {
    const rule=cell?.conditionalFormat||{},number=Number(value),comparison=Number(rule.compareMode==='measure'?comparisonValue:rule.threshold??0),type=rule.iconType||'None';if(!rule.enabled||type==='None'||!Number.isFinite(number))return content;if(!Number.isFinite(comparison))return rule.compareMode==='measure'?`<span class="matrix-conditional-cell"><span class="matrix-conditional-content">${content}</span><span class="matrix-conditional-icon matrix-conditional-unavailable" title="Comparison measure could not be evaluated" aria-label="Comparison measure unavailable">?</span></span>`:content;
    const good=number>=comparison,symbol={Arrows:['↓','↑'],Triangles:['▼','▲'],Circles:['●','●'],Status:['✕','✓']}[type]||['↓','↑'],color=good?conditionalColorState(rule,'goodColor',context,{defaultColor:'#16844a',defaultRole:'positive'}).resolved:conditionalColorState(rule,'badColor',context,{defaultColor:'#c43d4b',defaultRole:'negative'}).resolved,icon=`<span class="matrix-conditional-icon" aria-label="${good?'At or above':'Below'} target" style="color:${color}">${symbol[good?1:0]}</span>`,body=`<span class="matrix-conditional-content">${content}</span>`;return `<span class="matrix-conditional-cell ${rule.iconPosition==='right'?'matrix-conditional-icon-right':'matrix-conditional-icon-left'}">${rule.iconPosition==='right'?body+icon:icon+body}</span>`;
  }
  function calculateCells(grid,tile,context) {
    const cache=new Map(),visiting=new Set(),columns=grid.columns||[],rows=grid.rows||[];
    const position=(row,column)=>({kind:'value',row,column});
    const named=name=>{for(let r=0;r<rows.length;r++)for(let c=0;c<columns.length;c++){const current=position(r,c);if(String(sheetCell(grid,current)?.name||'').toLowerCase()===name.toLowerCase())return[r,c];}return null;};
    const at=(row,column)=>{
      const key=`${row}:${column}`;if(cache.has(key))return cache.get(key);if(visiting.has(key))throw new Error('#CYCLE!');
      const current=position(row,column);if(!validPosition(grid,current))throw new Error('#REF!');
      const cell=sheetCell(grid,current);visiting.add(key);
      try{
        let value;
