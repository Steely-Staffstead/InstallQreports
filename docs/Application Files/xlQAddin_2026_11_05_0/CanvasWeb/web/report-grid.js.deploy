  }
  function selectionData(tile,range=null) {
    const grid=tile?.reportGrid,chosen=range||selectedRectangle(tile?.id,grid),context=renderContexts.get(tile?.id)||propertyContext;
    if(!grid||!chosen||!context)return null;
    const top=Math.trunc(Number(chosen.top)),bottom=Math.trunc(Number(chosen.bottom)),left=Math.trunc(Number(chosen.left)),right=Math.trunc(Number(chosen.right));
    if(top<0||left<0||bottom<top||right<left||bottom>=grid.rows.length||right>=grid.columns.length)return null;
