    const applyButton=root.querySelector("[data-designer-ai-apply]");if(applyButton)applyButton.onclick = async () => { try { if(options.validateDraft){status.textContent="Validating draft…";await options.validateDraft(code.value);}await options.onApply?.(code.value, root); } catch(error) { status.textContent=`Draft is not valid: ${error.message || "Validation failed."}`; } };
