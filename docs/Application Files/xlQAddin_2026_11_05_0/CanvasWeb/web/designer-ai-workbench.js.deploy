    if (infoButton) infoButton.onclick = () => { const collapsed = !root.classList.contains("info-collapsed"); root.classList.toggle("info-collapsed", collapsed); infoButton.textContent = collapsed ? "Show info" : "Hide info"; infoButton.setAttribute("aria-expanded", String(!collapsed)); };
    const searchInput = root.querySelector("[data-designer-ai-search]"), searchCount = root.querySelector("[data-designer-ai-search-count]"), searchHighlight = root.querySelector("[data-designer-ai-code-highlight]"), searchLine = searchHighlight?.querySelector(".line"), searchMatch = searchHighlight?.querySelector(".match");
    let searchIndex = -1, searchLocation = null;
    const matches = () => { const query=searchInput?.value||"";if(!query)return[];const source=code.value.toLocaleLowerCase(),term=query.toLocaleLowerCase(),result=[];let index=0;while((index=source.indexOf(term,index))>=0){result.push(index);index+=Math.max(1,term.length);}return result; };
    const renderSearchHighlight = () => { if(!searchHighlight||!searchLocation||!searchInput?.value){if(searchHighlight)searchHighlight.hidden=true;return;}const source=code.value,start=searchLocation.start,text=source.slice(start,start+searchLocation.length).split("\n")[0];if(!text){searchHighlight.hidden=true;return;}const before=source.slice(0,start),lineStart=before.lastIndexOf("\n")+1,lineIndex=before.split("\n").length-1,prefix=source.slice(lineStart,start).replace(/\t/g,"  "),style=getComputedStyle(code),lineHeight=parseFloat(style.lineHeight)||17.4,paddingTop=parseFloat(style.paddingTop)||0,paddingLeft=parseFloat(style.paddingLeft)||0,canvas=renderSearchHighlight.canvas||=(document.createElement("canvas")),context=canvas.getContext("2d");context.font=style.font;const top=code.offsetTop+paddingTop+lineIndex*lineHeight-code.scrollTop,left=code.offsetLeft+paddingLeft+context.measureText(prefix).width-code.scrollLeft;searchLine.style.cssText=`top:${top}px;left:${code.offsetLeft}px;width:${code.clientWidth}px;height:${lineHeight}px`;searchMatch.style.cssText=`top:${top}px;left:${left}px;width:${Math.max(3,context.measureText(text).width)}px;height:${lineHeight}px`;searchHighlight.hidden=false; };
    const resetSearch = () => { searchIndex=-1;searchLocation=null;if(searchHighlight)searchHighlight.hidden=true;if(searchCount)searchCount.textContent=`0 / ${matches().length}`; };
    const find = direction => { const found=matches(),query=searchInput?.value||"";if(!found.length){resetSearch();return;}searchIndex=direction<0?(searchIndex<=0?found.length-1:searchIndex-1):(searchIndex+1)%found.length;const start=found[searchIndex],source=code.value;code.scrollTop=Math.max(0,source.slice(0,start).split("\n").length*17.4-code.clientHeight/3);const lineStart=source.lastIndexOf("\n",start-1)+1,column=source.slice(lineStart,start).replace(/\t/g,"  ").length,approximateLeft=column*7.2;if(approximateLeft<code.scrollLeft||approximateLeft>code.scrollLeft+code.clientWidth-120)code.scrollLeft=Math.max(0,approximateLeft-code.clientWidth/3);searchLocation={start,length:query.length};searchCount.textContent=`${searchIndex+1} / ${found.length}`;requestAnimationFrame(renderSearchHighlight); };
    if(searchInput){searchInput.oninput=resetSearch;searchInput.onkeydown=event=>{if(event.key==="Enter"||event.key==="Tab"){event.preventDefault();find(event.shiftKey?-1:1);}else if(event.key==="Escape"){event.preventDefault();searchInput.value="";resetSearch();}};root.querySelector("[data-designer-ai-search-previous]").onclick=()=>find(-1);root.querySelector("[data-designer-ai-search-next]").onclick=()=>find(1);code.addEventListener("scroll",renderSearchHighlight,{passive:true});code.addEventListener("input",resetSearch);searchResizeObserver=new ResizeObserver(renderSearchHighlight);searchResizeObserver.observe(code);}
    const layoutButton = root.querySelector("[data-designer-ai-layout]"), layoutKey = options.layoutStorageKey || "", positionKey = layoutKey ? `${layoutKey}-position` : "", defaultLayout = options.defaultLayout === "floating" || options.mode === "floating" ? "floating" : "embedded", readLayout = () => { try { const saved=layoutKey&&localStorage.getItem(layoutKey);return saved === "floating" || saved === "embedded" ? saved : defaultLayout; } catch { return defaultLayout; } }, readPosition = () => { try { const value=positionKey&&JSON.parse(localStorage.getItem(positionKey)||"null");return Number.isFinite(value?.left)&&Number.isFinite(value?.top)?value:null; } catch { return null; } };
    const placeFloating = position => { if (!root.classList.contains("floating")) return; const box=root.getBoundingClientRect(),requestedLeft=Number(position?.left),requestedTop=Number(position?.top),left=Math.max(8,Math.min(Number.isFinite(requestedLeft)?requestedLeft:box.left,innerWidth-box.width-8)),top=Math.max(8,Math.min(Number.isFinite(requestedTop)?requestedTop:box.top,innerHeight-Math.min(box.height,80)-8));root.style.left=`${left}px`;root.style.top=`${top}px`;root.style.right="auto";root.style.bottom="auto"; };
    const setLayout = (value, persist = true) => { const layout = value === "floating" ? "floating" : "embedded"; root.classList.toggle("floating", layout === "floating"); root.classList.toggle("embedded", layout !== "floating"); if (layout === "floating") requestAnimationFrame(()=>placeFloating(readPosition())); else for(const property of ["left","top","right","bottom"])root.style.removeProperty(property); if (layoutButton) { layoutButton.textContent = layout === "floating" ? "Dock right" : "Float"; layoutButton.title = layout === "floating" ? "Dock AI and code tools beside the preview" : "Float AI and code tools over the designer"; layoutButton.setAttribute("aria-pressed", String(layout === "floating")); } if (persist && layoutKey) try { localStorage.setItem(layoutKey, layout); } catch {} options.onLayoutChange?.(layout); return layout; };
    if (layoutButton) { setLayout(readLayout(), false); layoutButton.onclick = () => setLayout(root.classList.contains("floating") ? "embedded" : "floating"); }
    const dragHeader=root.querySelector(":scope>header");let drag=null;
    dragHeader.addEventListener("pointerdown",event=>{if(!root.classList.contains("floating")||event.button!==0||event.target.closest("button,input,select,textarea,a"))return;const box=root.getBoundingClientRect();drag={pointerId:event.pointerId,startX:event.clientX,startY:event.clientY,left:box.left,top:box.top};dragHeader.setPointerCapture(event.pointerId);event.preventDefault();});
    dragHeader.addEventListener("pointermove",event=>{if(!drag||event.pointerId!==drag.pointerId)return;placeFloating({left:drag.left+event.clientX-drag.startX,top:drag.top+event.clientY-drag.startY});});
    const finishDrag=event=>{if(!drag||event.pointerId!==drag.pointerId)return;drag=null;const box=root.getBoundingClientRect();if(positionKey)try{localStorage.setItem(positionKey,JSON.stringify({left:Math.round(box.left),top:Math.round(box.top)}));}catch{}};dragHeader.addEventListener("pointerup",finishDrag);dragHeader.addEventListener("pointercancel",finishDrag);
    const addMessage = (role, text) => { const item = document.createElement("p"); item.className = role; item.textContent = text; chat.append(item); chat.scrollTop = chat.scrollHeight; };
    const sync = () => { const enabled = available(),finalAction=options.finalApplyLabel||"apply it"; root.querySelector("[data-designer-ai-provider]").textContent = enabled ? provider() : "Manual code mode"; capability.dataset.enabled = String(enabled); capability.textContent = enabled ? `Focused AI is active through ${provider()}. Generated code remains a draft until you choose ${finalAction}.` : `Focused AI is unavailable because no tested CLI is enabled. Manual editing, paste, copy and preview remain available${options.showApply===false?` until you choose ${finalAction}`:", including Apply draft"}. Use the main Canvas AI when the complete canvas file should be redesigned.`; send.disabled = !enabled; question.disabled = !enabled; };
    const draftChanged = () => { clearTimeout(previewTimer); previewTimer = setTimeout(() => options.onDraftChange?.(code.value), options.previewDelay ?? 180); };
    code.addEventListener("input", draftChanged);
    send.onclick = async () => { const text = question.value.trim(); if (!text || !available()) return; question.value = ""; addMessage("user", text); send.disabled = true; cancel.hidden = false; status.textContent = "Preparing context…"; activeId = crypto.randomUUID(); try { const response = await request({ scope: options.scope, question: text, context: await options.getContext?.(code.value) || {}, attachments: options.getAttachments?.() || [], progress: value => status.textContent = value, requestId: activeId }); const parsed = options.parseResponse ? await options.parseResponse(response) : defaultParse(response, options.artifactKey || "code", options.language || ""); let validationMessage="";if (parsed.code != null && parsed.code !== "") { code.value = parsed.code; options.onDraftChange?.(code.value); if(options.validateDraft){status.textContent="Validating draft…";validationMessage=String(await options.validateDraft(code.value)||"");} } addMessage("assistant", parsed.message || "Draft ready."); status.textContent = validationMessage || (parsed.code ? "AI draft validated and ready to review" : "AI replied without changing the draft"); } catch (error) { addMessage("assistant", error.message || "The request failed."); status.textContent = `Draft is not valid: ${error.message || "Validation failed."}`; } finally { activeId = ""; send.disabled = !available(); cancel.hidden = true; } };
    cancel.onclick = () => { if (activeId) host?.postMessage({ type: "quickAiCancel", requestId: activeId }); status.textContent = "Cancellation requested…"; };
    root.querySelector("[data-designer-ai-instructions]").onclick = () => host?.postMessage({ type: "openAiInstructionsFolder" });
    root.querySelector("[data-designer-ai-copy]").onclick = async () => { try { await navigator.clipboard.writeText(code.value); status.textContent = "Code copied"; } catch { code.focus(); code.select(); document.execCommand("copy"); status.textContent = "Code copied"; } };
    root.querySelector("[data-designer-ai-paste]").onclick = async () => { try { const value = await navigator.clipboard.readText(); if (value) { code.value = value; code.dispatchEvent(new Event("input", { bubbles: true })); status.textContent = "Code pasted · preview updated"; } } catch { code.focus(); status.textContent = "Use Ctrl+V to paste code into the editor"; } };
