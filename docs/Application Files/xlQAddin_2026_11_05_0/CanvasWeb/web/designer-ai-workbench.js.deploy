    window.addEventListener("qreports-settings-changed", sync); sync();
    return { root, code, question, status, setCode(value) { code.value = String(value || ""); options.onDraftChange?.(code.value); }, setLayout, getCode: () => code.value, focus: () => (available() ? question : code).focus(), destroy: cleanup };
  }
