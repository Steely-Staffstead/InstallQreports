(() => {
  const host = globalThis.chrome?.webview;
  const pending = new Map();
  const providerNames = { chatgpt: "Codex / ChatGPT", claude: "Claude Code", copilot: "GitHub Copilot" };
  const settings = () => globalThis.QReportsSettings?.get?.() || {};
  const available = () => !!host && settings().showFocusedAiHelp === true;
  const provider = () => providerNames[settings().aiCliProvider] || "Configured CLI";
  const html = value => String(value ?? "").replace(/[&<>"']/g, char => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char]));
  const cleanFence = (value, language = "") => String(value || "").trim().replace(new RegExp(`^\\x60\\x60\\x60(?:${language}|json)?\\s*`, "i"), "").replace(/\s*```$/, "").trim();
  function request({ scope, question, context, attachments = [], progress, requestId = crypto.randomUUID() }) {
    if (!available()) return Promise.reject(new Error("Focused designer AI is disabled. Enable and test a CLI in Settings, or use the main Canvas AI for whole-file changes."));
    return new Promise((resolve, reject) => {
      pending.set(requestId, { scope, resolve, reject, progress });
      host.postMessage({ type: "quickAiRequest", requestId, scope, question, context, attachments });
    });
  }
  host?.addEventListener("message", event => {
    const message = event.data;
    if (!message || !["quickAiProgress", "quickAiResult"].includes(message.type)) return;
    const active = pending.get(message.requestId);
    if (!active || active.scope !== message.scope) return;
    if (message.type === "quickAiProgress") { active.progress?.(message.text || "Working…"); return; }
    pending.delete(message.requestId);
    message.error ? active.reject(new Error(message.error)) : active.resolve(message.text || "");
  });
  function defaultParse(value, artifactKey, language) {
    const source = cleanFence(value, language);
    try {
      const parsed = JSON.parse(source);
      return { message: String(parsed.assistantMessage || parsed.message || "Draft ready."), code: String(parsed[artifactKey] ?? parsed.code ?? "") };
    } catch { return { message: "Draft ready.", code: source }; }
  }
  function installStyles() {
    if (document.getElementById("designerAiWorkbenchStyles")) return;
    const style = document.createElement("style"); style.id = "designerAiWorkbenchStyles";
    style.textContent = `.designer-ai-workbench{box-sizing:border-box;display:grid;grid-template-rows:auto minmax(0,1fr);min-width:300px;min-height:0;border:1px solid var(--qreports-grid,#cdd5df);border-radius:10px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);overflow:hidden}.designer-ai-workbench.floating{position:fixed;z-index:4700;right:18px;top:82px;width:min(440px,calc(100vw - 36px));height:min(760px,calc(100vh - 100px));box-shadow:0 20px 60px #10182855;resize:both}.designer-ai-workbench>header{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 12px;border-bottom:1px solid var(--qreports-grid,#cdd5df);background:color-mix(in srgb,var(--qreports-header,#eef2f6) 68%,var(--qreports-surface,#fff));color:var(--qreports-header-text,var(--qreports-text,#182230))}.designer-ai-workbench.floating>header{cursor:move;user-select:none;touch-action:none}.designer-ai-workbench>header>span{display:grid;min-width:0}.designer-ai-workbench>header small{color:color-mix(in srgb,currentColor 72%,transparent);font-size:11px}.designer-ai-header-actions{display:flex;align-items:center;gap:6px}.designer-ai-workbench button{border:1px solid var(--qreports-grid,#cdd5df);border-radius:7px;background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);font:inherit;cursor:pointer}.designer-ai-workbench button:hover:not(:disabled){border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 12%,var(--qreports-surface,#fff))}.designer-ai-workbench>header button{height:30px;padding:0 9px;color:var(--qreports-header-text,var(--qreports-text,#182230));background:color-mix(in srgb,var(--qreports-surface,#fff) 82%,var(--qreports-header,#eef2f6))}.designer-ai-workbench>header [data-designer-ai-close]{width:30px;padding:0}.designer-ai-workbench-body{display:grid;grid-template-rows:auto auto minmax(80px,.6fr) auto minmax(180px,1.4fr) auto;gap:9px;min-height:0;padding:11px;overflow:auto}.designer-ai-workbench.info-collapsed .designer-ai-workbench-body{grid-template-rows:minmax(80px,.45fr) auto minmax(180px,1.55fr) auto}.designer-ai-workbench.info-collapsed :is(.designer-ai-capability,.designer-ai-chat){display:none}.designer-ai-capability{margin:0;padding:8px 10px;border:1px solid var(--qreports-grid,#cdd5df);border-radius:7px;background:color-mix(in srgb,var(--qreports-header,#eef2f6) 45%,var(--qreports-surface,#fff));font-size:11px;line-height:1.4}.designer-ai-capability[data-enabled=true]{border-color:color-mix(in srgb,var(--qreports-positive,#16844a) 45%,var(--qreports-grid,#cdd5df))}.designer-ai-chat{min-height:70px;overflow:auto;padding:7px;border:1px solid var(--qreports-grid,#cdd5df);border-radius:7px}.designer-ai-chat p{margin:5px 0;padding:7px 8px;border-radius:7px;background:color-mix(in srgb,var(--qreports-header,#eef2f6) 55%,transparent);font-size:12px;white-space:pre-wrap}.designer-ai-chat p.user{margin-left:18px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 14%,transparent)}.designer-ai-workbench label{display:grid;gap:4px;min-height:0;font-size:12px}.designer-ai-code-editor{position:relative;display:grid;grid-template-rows:auto minmax(0,1fr);gap:4px;min-height:0;font-size:12px}.designer-ai-code-heading{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0}.designer-ai-code-heading>span{white-space:nowrap}.designer-ai-code-search{display:flex;align-items:center;justify-content:flex-end;gap:4px;min-width:0}.designer-ai-code-search input{box-sizing:border-box;width:min(210px,38vw);min-width:90px;height:27px;padding:4px 6px;border:1px solid var(--qreports-grid,#cdd5df);border-radius:6px;background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);font:11px/1.2 Consolas,monospace}.designer-ai-code-search span{min-width:34px;color:var(--qreports-muted,#667085);font-size:9px;text-align:center}.designer-ai-code-search button{width:25px;height:27px;padding:0}.designer-ai-code-editor>[data-designer-ai-code]{position:relative;z-index:1;height:100%;resize:none}.designer-ai-code-highlight{position:absolute;z-index:2;inset:0;pointer-events:none;overflow:hidden}.designer-ai-code-highlight .line,.designer-ai-code-highlight .match{position:absolute;display:block;box-sizing:border-box}.designer-ai-code-highlight .line{border-block:1px solid color-mix(in srgb,var(--qreports-accent,#4f6ee8) 35%,transparent);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 13%,transparent)}.designer-ai-code-highlight .match{border:1px solid var(--qreports-accent,#4f6ee8);border-radius:2px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 42%,transparent)}.designer-ai-workbench textarea{box-sizing:border-box;width:100%;min-height:0;resize:vertical;padding:8px;border:1px solid var(--qreports-grid,#cdd5df);border-radius:7px;background:var(--qreports-control-background,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);font:12px/1.45 Consolas,monospace;tab-size:2}.designer-ai-question{min-height:70px!important;font-family:"Segoe UI",sans-serif!important}.designer-ai-row{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.designer-ai-row button{min-height:32px;padding:5px 9px}.designer-ai-row [data-designer-ai-send],.designer-ai-row [data-designer-ai-apply]{margin-left:auto;border-color:var(--qreports-accent,#4f6ee8);background:var(--qreports-accent,#4f6ee8);color:var(--qreports-on-accent,#fff)}.designer-ai-status{min-height:18px;color:var(--qreports-muted,#667085);font-size:11px}.designer-ai-workbench [disabled]{opacity:.5;cursor:not-allowed}`;
    document.head.append(style);
  }
  function create(options = {}) {
    installStyles();
    const root = document.createElement(options.tagName || "section");
    root.className = `designer-ai-workbench ${options.mode === "floating" ? "floating" : "embedded"} ${options.className || ""}`.trim();
    root.innerHTML = `<header><span><strong>${html(options.title || "Designer AI")}</strong><small data-designer-ai-provider></small></span><div class="designer-ai-header-actions">${options.collapsibleInfo ? '<button type="button" data-designer-ai-info aria-expanded="true">Hide info</button>' : ""}${options.dockable ? '<button type="button" data-designer-ai-layout></button>' : ""}${options.closable === false ? "" : '<button type="button" data-designer-ai-close aria-label="Close">×</button>'}</div></header><div class="designer-ai-workbench-body"><p class="designer-ai-capability" data-designer-ai-capability></p><div class="designer-ai-chat" data-designer-ai-chat><p class="assistant">${html(options.intro || "Describe a change, or edit and paste code manually below.")}</p></div><label>Request<textarea class="designer-ai-question" data-designer-ai-question rows="3" placeholder="${html(options.placeholder || "Describe the change…")}"></textarea></label><div class="designer-ai-row"><button type="button" data-designer-ai-instructions>Shared instructions…</button><button type="button" data-designer-ai-cancel hidden>Cancel</button><button type="button" data-designer-ai-send>Send</button></div><div class="designer-ai-code-editor"><div class="designer-ai-code-heading"><span>${html(options.codeLabel || "Draft code")}</span>${options.searchable ? '<div class="designer-ai-code-search"><input type="search" data-designer-ai-search placeholder="Find in code" aria-label="Find in code"><span data-designer-ai-search-count>0 / 0</span><button type="button" data-designer-ai-search-previous title="Previous match">↑</button><button type="button" data-designer-ai-search-next title="Next match">↓</button></div>' : ""}</div><textarea data-designer-ai-code spellcheck="false" wrap="off" aria-label="${html(options.codeLabel || "Draft code")}"></textarea>${options.searchable ? '<div class="designer-ai-code-highlight" data-designer-ai-code-highlight hidden aria-hidden="true"><span class="line"></span><span class="match"></span></div>' : ""}</div><div><div class="designer-ai-status" data-designer-ai-status></div><div class="designer-ai-row"><button type="button" data-designer-ai-copy>Copy code</button><button type="button" data-designer-ai-paste>Paste code</button><button type="button" data-designer-ai-preview>Refresh preview</button>${options.showApply === false ? "" : '<button type="button" data-designer-ai-apply>Apply draft</button>'}</div></div></div>`;
    (options.mount || document.body).append(root);
