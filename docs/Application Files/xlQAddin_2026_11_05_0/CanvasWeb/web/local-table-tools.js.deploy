// Import tools use literal search text; filters never evaluate JavaScript expressions.
const LocalTableTools={
 matches(value,rule){const text=String(value??''),needle=String(rule.value??''),a=rule.caseSensitive?text:text.toLowerCase(),b=rule.caseSensitive?needle:needle.toLowerCase();if(rule.operator==='empty')return value==null||text==='';if(rule.operator==='notempty')return value!=null&&text!=='';if(rule.operator==='contains')return a.includes(b);if(rule.operator==='starts')return a.startsWith(b);if(rule.operator==='ends')return a.endsWith(b);if(rule.operator==='eq')return a===b;if(rule.operator==='ne')return a!==b;if(value==null||text==='')return false;const numeric=/Integer|Decimal|Number/i.test(rule.type||''),date=/Date/i.test(rule.type||''),left=numeric?Number(text.replace(',','.')):date?Date.parse(text):a,right=numeric?Number(needle.replace(',','.')):date?Date.parse(needle):b;if((numeric||date)&&(!Number.isFinite(left)||!Number.isFinite(right)))throw new Error('Enter a valid '+(date?'date':'number')+' for the filter.');return rule.operator==='gt'?left>right:rule.operator==='ge'?left>=right:rule.operator==='lt'?left<right:left<=right;},
 replace(value,search,replacement,caseSensitive){if(value==null||!search)return value;const escaped=search.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');return String(value).replace(new RegExp(escaped,caseSensitive?'g':'gi'),()=>replacement);}
};
let localModeState=null,localChosenMode='Manual';
const localModeNames={Manual:'Manual',DelimitedFile:'CSV / Text',ExcelFile:'Excel',HttpFile:'Web'};
const ensureLocalModeBase=ensureLocalDataDialog;
ensureLocalDataDialog=function(){ensureLocalModeBase();const modal=$('localDataModal');if(modal.querySelector('.local-mode-selector'))return;const tabs=document.createElement('div');tabs.className='local-mode-selector';tabs.setAttribute('role','group');tabs.setAttribute('aria-label','Import mode');Object.entries(localModeNames).forEach(([mode,name])=>{const button=document.createElement('button');button.type='button';button.textContent=name;button.dataset.importMode=mode;button.onclick=()=>{localChosenMode=mode;renderLocalModes();};tabs.append(button);});const scrollBody=modal.querySelector('.local-data-scroll-body');scrollBody.before(tabs);modal.querySelector('.local-data-dialog').classList.add('has-fixed-mode-selector');const bar=modal.querySelector('.local-actions');for(const kind of ['filter','replace']){const button=document.createElement('button');button.type='button';button.dataset.localTransform=kind;button.textContent=kind==='filter'?'Filter…':'Replace…';button.onclick=()=>localTransformDialog(kind);bar.append(button);}const gridButton=document.createElement('button');gridButton.type='button';gridButton.dataset.manualGrid='';gridButton.textContent='Save and edit in query grid';gridButton.onclick=async()=>{try{await saveLocalData();await openManualQueryGrid(localState.name);}catch(error){$('localError').textContent=error.message;}};modal.querySelector('.dialog-actions').prepend(gridButton);};
function renderLocalModes(){const modal=$('localDataModal');if(!modal)return;if(localModeState!==localState){localModeState=localState;localChosenMode=localState.sourceMode in localModeNames?localState.sourceMode:'Manual';}modal.querySelectorAll('[data-import-mode]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.importMode===localChosenMode)));const manual=localChosenMode==='Manual';$('localPaste').hidden=!manual;$('localHasHeaders').closest('label').hidden=!manual;for(const [action,mode] of [['parse','Manual'],['import','DelimitedFile'],['importExcel','ExcelFile']])modal.querySelector('[data-local-action='+action+']').hidden=localChosenMode!==mode;const web=modal.querySelector('[data-import-url]');if(web)web.hidden=localChosenMode!=='HttpFile';const reimport=modal.querySelector('[data-local-action=reimport]');if(reimport)reimport.hidden=manual||!localState.sourcePath;modal.querySelectorAll('[data-local-transform]').forEach(button=>button.hidden=manual);modal.querySelector('[data-manual-grid]').hidden=localState.sourceMode!=='Manual';}
const renderLocalModeGridBase=renderLocalGrid;
renderLocalGrid=function(...args){renderLocalModeGridBase(...args);renderLocalModes();};
const useManualPasteBase=useLocalPaste;
useLocalPaste=function(){if(!parseDelimitedText($('localPaste').value).length)return;localState.sourceMode='Manual';localState.sourcePath='';localState.sourceObjectKind='';localState.sourceObjectName='';localState.importSteps=[];localSteps=[];useManualPasteBase();renderLocalModes();};
function makeLocalTransformMovable(panel,handle){
 let drag=null;
 handle.addEventListener('pointerdown',event=>{
  if(event.button!==0||event.target.closest('button,input,select,textarea,label'))return;
  const rect=panel.getBoundingClientRect();
  drag={pointerId:event.pointerId,offsetX:event.clientX-rect.left,offsetY:event.clientY-rect.top};
  panel.style.position='fixed';panel.style.left=rect.left+'px';panel.style.top=rect.top+'px';panel.style.margin='0';
  handle.setPointerCapture?.(event.pointerId);event.preventDefault();
 });
 handle.addEventListener('pointermove',event=>{
  if(!drag||drag.pointerId!==event.pointerId)return;
  const maxLeft=Math.max(8,window.innerWidth-panel.offsetWidth-8),maxTop=Math.max(8,window.innerHeight-panel.offsetHeight-8);
  panel.style.left=Math.min(maxLeft,Math.max(8,event.clientX-drag.offsetX))+'px';
  panel.style.top=Math.min(maxTop,Math.max(8,event.clientY-drag.offsetY))+'px';
 });
 const stop=event=>{if(drag?.pointerId===event.pointerId){handle.releasePointerCapture?.(event.pointerId);drag=null;}};
 handle.addEventListener('pointerup',stop);handle.addEventListener('pointercancel',stop);
}
function localTransformDialog(kind,viewOnly=false){
 const data=viewOnly?resultView.data:localState;
 const columns=viewOnly?resultView.data.columns.map((column,index)=>({name:resultColumnName(column),sourceName:resultColumnName(column),type:editState.localDefinition.Columns?.[index]?.DataType||'Text'})):localState.columns;
 const modal=document.createElement('div');modal.className='modal';modal.innerHTML=`<div class="dialog local-transform-dialog"><div class="filter-head local-transform-drag-handle" title="Drag to move"><h2>${kind==='filter'?'Filter rows':'Replace values'}</h2><button data-transform-close>×</button></div><p class="muted">${viewOnly?'Filters only the displayed rows. Saving keeps every other row.':kind==='filter'?'Keep matching rows in the imported table.':'Replace matching text in the selected column.'}</p><label>Column<select data-transform-column>${columns.map((column,index)=>`<option value="${index}">${esc(column.name)}</option>`).join('')}</select></label>${kind==='filter'?'<label>Condition<select data-transform-operator><option value="eq">Equals</option><option value="ne">Does not equal</option><option value="gt">Greater than</option><option value="ge">Greater than or equal</option><option value="lt">Less than</option><option value="le">Less than or equal</option><option value="contains">Contains</option><option value="starts">Starts with</option><option value="ends">Ends with</option><option value="empty">Is empty</option><option value="notempty">Is not empty</option></select></label>':''}<label>${kind==='filter'?'Value':'Search for'}<input data-transform-value></label>${kind==='filter'?'<label data-transform-pick-wrap>Pick from values<select data-transform-pick><option value="">Choose a value…</option></select><small class="muted" data-transform-pick-summary></small></label>':''}${kind==='replace'?'<label>Replace with<input data-transform-replacement></label>':''}<label class="check"><input type="checkbox" data-transform-case> Match case</label><p data-transform-error class="pw-error"></p><div class="dialog-actions"><button data-transform-close>Cancel</button>${viewOnly?'<button data-transform-clear>Clear filter</button>':''}<button class="apply" data-transform-apply>Apply</button></div></div>`;
 document.body.appendChild(modal);
 const panel=modal.querySelector('.local-transform-dialog'),columnSelect=modal.querySelector('[data-transform-column]'),operatorSelect=modal.querySelector('[data-transform-operator]'),valueInput=modal.querySelector('[data-transform-value]'),pickWrap=modal.querySelector('[data-transform-pick-wrap]'),pickSelect=modal.querySelector('[data-transform-pick]');
 makeLocalTransformMovable(panel,modal.querySelector('.local-transform-drag-handle'));
 let uniqueValues=[];
 const refreshUniqueValues=()=>{
  if(kind!=='filter')return;
  const available=['eq','ne'].includes(operatorSelect.value);pickWrap.hidden=!available;if(!available)return;
  const index=Number(columnSelect.value);uniqueValues=[...new Map((data.rows||[]).map(row=>{const raw=row[index],value=raw==null?'':String(raw),label=value===''?'(blank)':value;return[value,{label,value}]})).values()].sort((a,b)=>a.label.localeCompare(b.label,undefined,{numeric:true,sensitivity:'base'}));
  pickSelect.innerHTML='<option value="">Choose a value…</option>'+uniqueValues.map((item,itemIndex)=>`<option value="${itemIndex}">${esc(item.label)}</option>`).join('');
  modal.querySelector('[data-transform-pick-summary]').textContent=`${uniqueValues.length} unique value${uniqueValues.length===1?'':'s'}`;
 };
 columnSelect.addEventListener('change',refreshUniqueValues);operatorSelect?.addEventListener('change',refreshUniqueValues);pickSelect?.addEventListener('change',()=>{if(pickSelect.value!=='')valueInput.value=uniqueValues[Number(pickSelect.value)]?.value??'';valueInput.focus();});refreshUniqueValues();
 modal.querySelectorAll('[data-transform-close]').forEach(button=>button.onclick=()=>modal.remove());
 modal.querySelector('[data-transform-clear]')?.addEventListener('click',()=>{delete editState.viewFilter;renderResult(resultView.data,true,'Editable: local.'+editState.tableName);modal.remove();});
 modal.querySelector('[data-transform-apply]').onclick=()=>{try{const index=Number(columnSelect.value),rule={column:index,sourceName:columns[index].sourceName||columns[index].name,type:columns[index].type,operator:operatorSelect?.value,value:valueInput.value,caseSensitive:modal.querySelector('[data-transform-case]').checked};
  if(viewOnly){resultView.data.rows.forEach(row=>LocalTableTools.matches(row[index],rule));editState.viewFilter=rule;renderResult(resultView.data,true,'Editable: local.'+editState.tableName);}
  else{const before={rows:structuredClone(localState.rows),indices:[...(localState.sourceRowIndices||[])],excluded:[...(localState.excludedSourceRows||[])]};if(kind==='filter'){const keep=localState.rows.map((row,index)=>({row,index})).filter(entry=>LocalTableTools.matches(entry.row[rule.column],rule));localState.rows=keep.map(entry=>entry.row);localState.sourceRowIndices=keep.map(entry=>before.indices[entry.index]);}else{if(!rule.value)throw new Error('Enter search text.');rule.replacement=modal.querySelector('[data-transform-replacement]').value;localState.rows=localState.rows.map(row=>row.map((value,column)=>column===index?LocalTableTools.replace(value,rule.value,rule.replacement,rule.caseSensitive):value));}addLocalStep((kind==='filter'?'Filter ':'Replace ')+columns[index].name,'',{kind,...rule,before});localState.importSteps=structuredClone(localSteps);renderLocalGrid();}modal.remove();}catch(error){modal.querySelector('[data-transform-error]').textContent=error.message;}};
}
const removeTransformStepBase=removeLocalStep;
removeLocalStep=function(index){const step=localSteps[index];if(!['filter','replace'].includes(step?.kind))return removeTransformStepBase(index);if(index!==localSteps.length-1)return toast('Remove later steps first to undo this transformation.');localState.rows=structuredClone(step.before.rows);localState.sourceRowIndices=[...step.before.indices];localState.excludedSourceRows=[...step.before.excluded];localSteps.splice(index,1);localState.importSteps=structuredClone(localSteps);renderLocalGrid();};
async function openManualQueryGrid(name,requestedQuery='',selectedColumns=null,displayQuery=''){try{if(hasEdits())throw new Error('Save or revert the current edits first.');const lookup=String(name||'').toLowerCase(),table=tables.find(table=>String(table.id||'').toLowerCase()===lookup||qualifiedName(table).toLowerCase()===lookup||table.name.toLowerCase()===lookup);const filterQuery=requestedQuery||(table?'SELECT * FROM '+aliasedTable({...table,schema:''})+filterClause(table):'');const loaded=await call('localTableLoad',{...localSourceReference(table||{name}),filterQuery,query:{parameters:query.parameters||[]}}),definition=loaded.definition;if(definition.SourceMode!=='Manual')throw new Error('Convert this source to Manual before editing in the query grid.');if(selectedColumns){const actual=new Set(definition.Columns.map(column=>column.Name.toLowerCase()));for(const column of selectedColumns)if(!actual.has(column.toLowerCase()))throw new Error(`Column ${column} is not in the manual table.`);}$('connection').value='local';query.connectionName='local';replaceSql(displayQuery||filterQuery||'SELECT * FROM '+sqlColumn(definition.Name));editState={paneFilterQuery:filterQuery,paneVisibleRows:loaded.visibleRows?new Set(loaded.visibleRows):null,paneRowOrder:loaded.visibleRows?new Map(loaded.visibleRows.map((row,index)=>[row,index])):null,selectedColumns,localDefinition:definition,connectionName:'local',schemaName:'local',tableName:definition.Name,columns:definition.Columns.map(column=>({name:column.Name,dbType:column.DataType==='Boolean'?'bit':column.DataType==='Integer'?'bigint':column.DataType==='Decimal'?'decimal':column.DataType==='DateTime'?'datetime':'text',nullable:column.AllowNull,readOnly:false})),originalRows:structuredClone(loaded.data.rows),rowStates:loaded.data.rows.map(row=>definition.Columns.some((column,index)=>column.DataType==='Boolean'&&row[index]==null)?'update':'clean')};loaded.data.rows.forEach(row=>definition.Columns.forEach((column,index)=>{if(column.DataType==='Boolean'&&row[index]==null)row[index]=false;}));resultMode='grid';renderResult(loaded.data,false,'Editable: local.'+definition.Name);if(selectedColumns)resultView.hidden=new Set(loaded.data.columns.map((column,index)=>selectedColumns.some(name=>name.toLowerCase()===resultColumnName(column).toLowerCase())?-1:index).filter(index=>index>=0));await refreshLookupChoices();renderResult(resultView.data,true,'Editable: local.'+definition.Name);$('queryStatus').textContent='Editing manual table';const actions=$('editActions');if(!actions.querySelector('[data-manual-filter]')){const filter=document.createElement('button');filter.dataset.manualFilter='';filter.textContent='Filter…';filter.onclick=()=>localTransformDialog('filter',true);actions.append(filter);}}catch(error){showResultError(error,'Could not edit manual table');}}
async function saveManualQueryGrid(){if(!hasEdits())return;try{const definition=editState.localDefinition,data={...resultView.data,rows:resultView.data.rows.filter((_,index)=>editState.rowStates[index]!=='delete').map(row=>row.map((value,index)=>definition.Columns?.[index]?.DataType==='Boolean'&&value==null?false:value))};const saved=await call('localManualSave',{name:definition.Name,id:definition.Id,updatedUtc:definition.UpdatedUtc,data});if(editState.paneFilterQuery){const filtered=await call('localTableLoad',{name:definition.Name,id:definition.Id,filterQuery:editState.paneFilterQuery,query:{parameters:query.parameters||[]}});editState.paneVisibleRows=new Set(filtered.visibleRows);editState.paneRowOrder=new Map(filtered.visibleRows.map((row,index)=>[row,index]));}editState.localDefinition=saved.definition;editState.originalRows=structuredClone(saved.data.rows);editState.rowStates=saved.data.rows.map(()=>'clean');query.data=saved.data;renderResult(saved.data,true,'Editable: local.'+definition.Name);toast('Manual table saved');await loadSchema();}catch(error){showResultError(error,'Could not save manual table');}}
const updateManualEditActionsBase=updateEditActions;
updateEditActions=function(){updateManualEditActionsBase();$('editActions').querySelector('[data-manual-filter]')?.classList.toggle('hidden',!editState?.localDefinition);};
const showLocalManualMenuBase=showLocalTableMenu;
showLocalTableMenu=function(event,table){showLocalManualMenuBase(event,table);const menu=$('contextMenu'),mode=String(table.sourceMode||table.type||'').toLowerCase(),button=document.createElement('button');button.textContent=mode==='manual'?'Edit in query grid':'Convert to manual table';button.onclick=async()=>{hideContextMenu();if(mode==='manual')return openManualQueryGrid(table.id||table.name);if(!await window.QReportsDialogs.confirm("Convert '"+qualifiedName(table)+"' to Manual? The cached data will stay, and its source query/import link will be removed."))return;try{await call('localTableConvertManual',localSourceReference(table));await loadSchema();toast(qualifiedName(table)+' is now a manual table');}catch(error){showResultError(error,'Could not convert table');}};menu.append(button);};

const exitManualGridBase=exitEditable;
exitEditable=function(render=true){if(editState?.localDefinition)query.data={...resultView.data,rows:structuredClone(editState.originalRows.filter(Boolean))};exitManualGridBase(render);};
