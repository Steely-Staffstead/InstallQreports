<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QReports parameters</title><link rel="stylesheet" href="parameter-editor.css?v=20260901-4"><link rel="stylesheet" href="parameter-workspace.css?v=20260901-4"></head><body class="parameter-workspace"><main class="parameter-host"><p id="parameterLoading" style="padding:24px;font:14px 'Segoe UI',sans-serif;color:#64748b">Loading workbook parameters…</p></main><script>window.addEventListener('error',function(e){var n=document.getElementById('parameterLoading');if(n)n.textContent='Parameters could not be loaded: '+e.message;});</script><script src="parameter-editor.js?v=20260901-4"></script><script src="parameter-workspace.js?v=20260901-4"></script></body></html>
