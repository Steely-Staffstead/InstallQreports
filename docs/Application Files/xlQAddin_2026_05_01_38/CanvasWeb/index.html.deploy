<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ChartWeb</title><link rel="stylesheet" href="styles.css?v=20260904-1"></head>
<body>
  <header><div class="brand"><span>Q</span><div><strong>ChartWeb</strong><small>Experimental web chart designer</small></div></div><div class="header-actions"><button id="reset">Reset</button><button id="return" class="primary">Return chart</button></div></header>
  <nav id="types" class="types"></nav>
  <main id="chartLayout">
    <aside class="bindings panel"><button id="expandData" class="data-pane-tab" type="button">Data</button><div class="data-heading"><h2>Data</h2><button id="hideData" type="button" title="Hide data">‹</button></div><label>Values<select id="value"></select></label><label>Category <small>plotted level</small><select id="category"></select></label><label>Group <small>parent level</small><select id="group"></select></label><label title="Reserved for future small-multiple charts">Group 2 <small>reserved for multiple charts</small><select id="subgroup" disabled></select></label><hr><h2>Series</h2><div id="series"></div><button id="addSeries">+ Add series</button></aside>
    <section class="preview"><div id="chart"></div><div id="status">Ready</div></section>
    <aside class="options panel">
      <button id="expandOptions" class="options-pane-tab" type="button">Chart options</button>
      <div class="options-heading"><h2>Chart options</h2><div><button id="collapseAll" type="button">Collapse all</button><button id="hideOptions" type="button" title="Hide chart options">›</button></div></div>
      <div class="chart-general-options"><label>Chart type<select id="chartType"></select></label><label>Background<input id="background" type="color" value="#ffffff"></label><label>Color theme<select id="paletteName"><option>Default</option><option>Bright</option><option>Pastel</option><option>Muted</option><option>Excel</option><option>EarthTones</option><option>Berry</option><option>SeaGreen</option><option>Fire</option><option>Grayscale</option></select></label><label class="check"><input id="showLegend" type="checkbox" checked> Show legend</label><label class="check"><input id="showGrid" type="checkbox" checked> Show gridlines</label></div>
      <details class="format-section" open><summary>Title settings</summary><label>Title<input id="title"></label><label class="check"><input id="showTitle" type="checkbox" checked> Show title</label><label>Title alignment<select id="titleAlignment"><option value="Left">Left</option><option value="Center">Center</option><option value="Right">Right</option></select></label><div class="two-cols"><label>Title size<input id="titleSize" type="number" min="8" max="48" value="20"></label><label>Title color<input id="titleColor" type="color" value="#253653"></label></div></details>
      <details class="format-section"><summary>Legend</summary><label>Legend text<select id="legendTextMode"><option value="Category">Category</option><option value="ValueCategory">Series - category</option></select></label><div class="two-cols"><label>Legend position<select id="legendPosition"><option value="Bottom">Bottom left</option><option value="BottomCenter">Bottom center</option><option value="Top">Top left</option><option value="TopCenter">Top center</option><option value="Left">Left side</option><option value="Right">Right side</option></select></label><label>Legend size<input id="legendSize" type="number" min="7" max="24" value="11"></label></div><p class="section-help">Drag the legend directly on the chart to fine-tune its position.</p></details>
      <details class="format-section"><summary>Category axis</summary><div class="two-cols"><label>Angle<input id="categoryAngle" type="number" min="-90" max="90" value="0"></label><label>Text size<input id="categorySize" type="number" min="7" max="28" value="11"></label></div><label>Format<input id="categoryFormat" list="categoryFormats" placeholder="Auto or yyyy-MM-dd"><datalist id="categoryFormats"><option value="Auto"><option value="yyyy-MM-dd"><option value="MMM yyyy"><option value="dd MMM yyyy"></datalist></label><label>Order<select id="categoryOrder"><option value="Natural">Natural</option><option value="AlphabeticalAsc">Category ascending</option><option value="AlphabeticalDesc">Category descending</option><option value="ByYAsc">Value ascending</option><option value="ByYDesc">Value descending</option></select></label><div class="two-cols"><label>Minimum<input id="categoryMin" type="number" step="any" placeholder="Auto"></label><label>Maximum<input id="categoryMax" type="number" step="any" placeholder="Auto"></label></div></details>
      <details class="format-section"><summary>Group labels</summary><p class="section-help">Applies to the parent grouping above Category. Click a group label in the chart to open this section.</p><div class="two-cols"><label>Text size<input id="groupLabelSize" type="number" min="7" max="28" value="11"></label><label>Angle<input id="groupLabelAngle" type="number" min="-90" max="90" value="0"></label></div><label>Format<input id="groupLabelFormat" list="categoryFormats" placeholder="Auto"></label><label>Vertical position<input id="groupLabelOffset" type="range" min="-55" max="55" value="0"></label></details>
      <details class="format-section"><summary>Value axis</summary><div class="two-cols"><label>Text size<input id="valueAxisSize" type="number" min="7" max="28" value="11"></label><label>Direction<select id="valueAxisOrder"><option value="Ascending">Ascending</option><option value="Descending">Descending</option></select></label></div><label>Number/date format<input id="valueAxisFormat" list="numberFormats" placeholder="Auto, N1, P1, #,##0,,.0M"></label><div class="two-cols"><label>Minimum<input id="valueMin" type="number" step="any" placeholder="Auto"></label><label>Maximum<input id="valueMax" type="number" step="any" placeholder="Auto"></label></div></details>
      <details class="format-section"><summary>Data labels</summary><label class="check"><input id="showValueLabels" type="checkbox"> Show labels</label><div class="label-parts"><label class="check"><input id="labelCategory" type="checkbox"> Category</label><label class="check"><input id="labelSeries" type="checkbox"> Series name</label><label class="check"><input id="labelValue" type="checkbox" checked> Value</label></div><div class="two-cols"><label>Delimiter<select id="labelDelimiter"><option value="Space">Space</option><option value="LineBreak">Line break</option><option value="Hyphen">Hyphen (-)</option><option value="MiddleDot">Middle dot (·)</option></select></label><label>Placement<select id="labelPosition"><option value="Auto">Automatic</option><option value="TopCenter">Top center</option><option value="Center">Center</option><option value="BottomCenter">Bottom center</option></select></label></div><label>Value format<input id="valueLabelFormat" list="numberFormats" placeholder="Auto, N1, P1, #,##0,.0K"></label><datalist id="numberFormats"><option value="Auto"><option value="N0"><option value="N1"><option value="N2"><option value="#,##0,.0K"><option value="#,##0,,.0M"><option value="P0"><option value="P1"><option value="P2"><option value="yyyy-MM-dd"></datalist><div class="two-cols"><label>Angle<input id="valueLabelAngle" type="number" min="-90" max="90" value="0"></label><label>Text size<input id="valueLabelSize" type="number" min="7" max="28" value="10"></label></div></details>
      <details class="format-section"><summary>Plot margins</summary><p class="section-help">Use negative values to reclaim reserved space, or drag the plot edges directly in the chart.</p><div class="two-cols"><label>Top<input id="marginTop" type="number" min="-80" max="140" value="0"></label><label>Bottom<input id="marginBottom" type="number" min="-80" max="140" value="0"></label><label>Left<input id="marginLeft" type="number" min="-55" max="200" value="0"></label><label>Right<input id="marginRight" type="number" min="-20" max="200" value="0"></label></div><button id="resetMargins" type="button">Reset margins</button></details>
      <section id="barOptions" class="type-options"><h2>Bar layout</h2><label>Orientation<select id="barOrientation"><option value="Column">Columns (vertical)</option><option value="Bar">Bars (horizontal)</option></select></label><div class="two-cols"><label>Bar width %<input id="barWidth" type="number" min="10" max="100" value="76"></label><label>Shading<select id="barShading"><option value="None">Solid</option><option value="LightToDark">Light to dark</option><option value="DarkToLight">Dark to light</option><option value="Angled">Angled highlight</option><option value="Emboss">Soft emboss</option></select></label></div><label>Shading %<input id="shadingPercent" type="range" min="0" max="100" value="35"></label></section>
      <section id="markerOptions" class="type-options"><h2>Line and markers</h2><div class="two-cols"><label>Line thickness<input id="lineThickness" type="number" min="1" max="12" step="0.5" value="3"></label><label>Line style<select id="lineStyle"><option value="Solid">Solid</option><option value="Dotted">Dotted</option><option value="TightDotted">Tight dotted</option><option value="Dashed">Dashed</option><option value="LongDashed">Long dashed</option><option value="DashDot">Dash-dot</option></select></label></div><label>Line shading %<input id="lineShadePercent" type="range" min="0" max="100" value="0"></label><label class="check"><input id="showMarkers" type="checkbox" checked> Show markers</label><label class="check"><input id="filledMarkers" type="checkbox"> Filled markers</label><div class="two-cols"><label>Type<select id="markerType"><option value="Circle">Circle</option><option value="Square">Square</option><option value="Diamond">Diamond</option><option value="Triangle">Triangle</option></select></label><label>Size<input id="markerSize" type="number" min="2" max="30" value="7"></label></div></section>
      <details id="scatterOptions" class="type-options"><summary>Scatter / plot</summary><label>Size by<select id="scatterSizeField"></select></label><div class="two-cols"><label>Minimum dot size<input id="scatterSizeMin" type="number" min="2" max="30" value="5"></label><label>Maximum dot size<input id="scatterSizeMax" type="number" min="3" max="50" value="18"></label></div><label class="check"><input id="scatterRegression" type="checkbox"> Regression line</label><label class="check"><input id="scatterConnect" type="checkbox"> Connect points</label><label>Lollipop<select id="scatterLollipop"><option value="None">Off</option><option value="Zero">From zero</option><option value="SlotRange">Per slot (minimum–maximum)</option></select></label></details>
      <details id="doughnutOptions" class="type-options"><summary>Doughnut layout</summary><p class="section-help">Adjust the size here, or drag the handle on the right edge of the chart.</p><div class="two-cols"><label>Chart size<input id="doughnutRadius" type="number" min="80" max="205" value="175"></label><label>Hole size %<input id="doughnutHole" type="number" min="20" max="75" value="38"></label></div><div class="two-cols"><label>Category labels<select id="doughnutCategoryLabels"><option value="Name">Label</option><option value="NameValue">Label + value</option><option value="None">Hidden</option></select></label><label>Group labels<select id="doughnutGroupLabels"><option value="Name">Label</option><option value="NameValue">Label + value</option><option value="None">Hidden</option></select></label><label>Category direction<select id="doughnutCategoryDirection"><option value="Horizontal">Horizontal</option><option value="Radial">Radial</option></select></label><label>Group direction<select id="doughnutGroupDirection"><option value="Horizontal">Horizontal</option><option value="Radial">Radial</option></select></label><label>Category label overflow %<input id="doughnutCategoryOverflow" type="number" min="0" max="150" value="30"></label></div><button id="resetDoughnut" type="button">Reset size</button></details>
      <details id="pieOptions" class="type-options"><summary>Pie layout</summary><label>Chart size<input id="pieRadius" type="number" min="80" max="205" value="150"></label></details>
      <section id="waterfallOptions" class="type-options"><h2>Waterfall</h2><label>Grouped layout<select id="waterfallLayout"><option value="MiniWaterfall">Two-level mini waterfall</option><option value="Split">Split groups</option></select></label><label class="check"><input id="waterfallTotal" type="checkbox" checked> Show final total</label><label class="check"><input id="waterfallCustomColors" type="checkbox"> Override theme colors</label><div class="two-cols"><label>Increase<input id="waterfallIncreaseColor" type="color" value="#16a085"></label><label>Decrease<input id="waterfallDecreaseColor" type="color" value="#d64562"></label></div><label>Total<input id="waterfallTotalColor" type="color" value="#3158b5"></label></section>
      <section id="histogramOptions" class="type-options"><h2>Distribution</h2><label>Number of bins<input id="bins" type="number" min="1" max="60" value="10"></label><label>Round range and intervals<select id="histogramRound"><option value="0">Automatic</option><option value="0.1">Nearest 0.1</option><option value="1">Nearest 1</option><option value="10">Nearest 10</option><option value="100">Nearest 100</option><option value="1000">Nearest 1,000</option><option value="10000">Nearest 10,000</option><option value="100000">Nearest 100,000</option><option value="1000000">Nearest 1,000,000</option></select></label><label class="check"><input id="useBinSize" type="checkbox"> Use fixed bin size</label><label>Bin size<input id="binSize" type="number" min="0.000001" step="any" value="1"></label></section>
      <section id="boxplotOptions" class="type-options"><h2>Boxplot</h2><label class="check"><input id="showOutliers" type="checkbox" checked> Show outliers</label></section>
      <section id="gaugeOptions" class="type-options"><h2>Gauge</h2><label>Target source<select id="gaugeTargetColumn"></select></label><label>Fixed target<input id="gaugeTarget" type="number" step="any" value="100"></label><div class="threshold-grid"><label>Low %<input id="gaugeLevel1" type="number" value="40"></label><label>Mid %<input id="gaugeLevel2" type="number" value="60"></label><label>High %<input id="gaugeLevel3" type="number" value="80"></label><label>Maximum %<input id="gaugeMaximum" type="number" value="110"></label></div></section>
      <section id="treemapOptions" class="type-options"><h2>Treemap</h2><p>Group is the parent rectangle and Category is the detailed rectangle. Values control rectangle size.</p><label>Layout<select id="treemapLayout"><option value="Columns">Columns</option><option value="Hierarchical">Hierarchical</option></select></label><label>Category labels<select id="treemapCategoryLabels"><option value="Name">Label</option><option value="NameValue">Label + value</option><option value="None">Hidden</option></select></label><label>Group labels<select id="treemapGroupLabels"><option value="Name">Label</option><option value="NameValue">Label + value</option><option value="None">Hidden</option></select></label><label>Group border width<input id="treemapBorder" type="number" min="1" max="12" value="3"></label></section>
      <details><summary>Chart document JSON</summary><textarea id="json"></textarea><button id="applyJson">Apply JSON</button></details><div id="error"></div>
    </aside>
  </main>
  <script src="measure-evaluator.js"></script><script src="chart-renderer.js?v=20260904-1"></script><script src="app.js?v=20260904-1"></script>
</body></html>
