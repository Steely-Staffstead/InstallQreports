<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QReports query workspace</title><link rel="stylesheet" href="query-workspace.css?v=20260920-1"><link rel="stylesheet" href="parameter-editor.css"><link rel="stylesheet" href="query-workspace-theme.css?v=20260920-5"><link rel="stylesheet" href="parameter-editor-theme.css?v=20260919-1"><script src="shared-settings.js?v=20260920-3"></script></head><body>
<header><div class="brand"><span>Q</span><div><strong>Query workspace</strong><small>SQL, API, schema, results and joins</small></div></div><div class="toolbar"><button class="run" data-action="run">▶ Run</button><div class="toolbar-dropdown"><button data-action="toggleOpenMenu" aria-expanded="false">Open ▾</button><div id="openMenu" class="toolbar-dropdown-menu document-menu hidden"><button data-action="openSqlFile">SQL file…</button><button data-action="openWorkspace">Query workspace…</button><div class="menu-separator"></div><div class="menu-heading">Recent</div><div id="recentQueryFiles" class="recent-query-files"><span class="menu-empty">No recent files</span></div></div></div><button id="quickSaveSql" data-action="quickSaveSql" disabled title="Open or save a SQL file or workspace to enable Save">Save</button><div class="toolbar-dropdown"><button data-action="toggleSaveMenu" aria-expanded="false" title="More save options">Save as ▾</button><div id="saveMenu" class="toolbar-dropdown-menu document-menu hidden"><button data-action="saveSqlFile">SQL file…</button><button data-action="saveWorkspace">Query workspace…</button><div class="menu-separator"></div><button data-action="saveSourceView">As source view</button><button data-action="saveCombinedSource">As combined source</button></div></div><div class="toolbar-dropdown"><button data-action="toggleDesignMenu">Design ▾</button><div id="designMenu" class="toolbar-dropdown-menu hidden"><button data-action="editQuery">Edit query</button><button data-action="toggleJoin">Join designer</button><button data-action="apiDesigner">API designer</button><button data-action="format">Format SQL</button></div></div><input id="previewLimit" type="hidden" value="1000"><button class="apply" data-action="apply">Apply query</button><button data-action="cancel">Cancel</button></div></header>
<main><aside class="sources"><div class="pane-head"><h2>Data sources</h2><div><button id="editSources" title="Edit sources">Edit sources</button><button data-action="toggleSources" title="Hide data sources">‹</button><button data-action="refreshSchema">↻</button></div></div><label class="api-toggle"><input id="showApis" type="checkbox"> Show API sources</label><label>Browse source<select id="connection"></select></label><input id="schemaSearch" placeholder="Search tables, APIs and fields"><div id="schema" class="schema"></div></aside><div class="splitter left-splitter" title="Resize or show data sources"></div>
<section class="work"><div class="query-tabbar"><div id="queryTabs" class="query-tabs" role="tablist" aria-label="Query tabs"></div><div class="query-tab-actions"><button type="button" data-workspace-action="new" title="New query tab">＋</button><button type="button" id="setMainTab" data-workspace-action="main" title="Make the active tab the query returned to Excel">Set as Main</button></div></div><div class="query-head"><span>QUERY</span><label class="single-query-connection">Run on <select id="queryRunConnection" aria-label="Query execution connection"></select></label><span id="queryStatus">Ready</span></div><div class="editor-shell"><pre id="queryHighlight" aria-hidden="true"></pre><textarea id="queryText" spellcheck="false" autocomplete="off" placeholder="SELECT * FROM table_name"></textarea></div><div id="autocomplete" class="autocomplete hidden"></div>
<div id="joinPanel" class="join-panel hidden"><div class="join-head"><div><b>Visual join designer</b><small>Double-click tables on the left to add them. Click a join arrow to edit it.</small></div><button data-action="generateSql">Generate SQL</button></div><div id="joinCanvas" class="join-canvas"></div><div id="joinResize" class="join-resize" title="Resize join designer"></div></div>
<div class="result-head" title="Drag to resize the query and result panes"><div class="result-tabs"><button class="active" data-result-view="grid">Grid</button><button data-result-view="json">JSON</button><button data-result-view="sql">Parsed SQL</button><button data-result-view="messages">Messages</button></div><div id="editActions" class="edit-actions hidden"><button data-action="addRow">＋ Row</button><button data-action="saveEdits" class="save-edit" disabled>Save changes</button><button data-action="revertEdits" disabled>Revert</button><button data-action="exitEdit">Exit edit</button></div><span id="resultSummary">No query executed</span></div><div class="result-wrap"><table id="result"><colgroup></colgroup><thead></thead><tbody></tbody></table><pre id="resultText" class="result-text hidden"></pre><div id="emptyResult" class="empty">Run the query to preview data.</div></div></section><div class="splitter right-splitter"></div>
<aside class="inspector"><div class="pane-head"><h2>Tools</h2><button data-action="toggleInspector" title="Hide tools">›</button></div><div class="side-tools"><button data-side="parameters">Parameters</button><button data-side="functions">Functions</button><button data-side="queryStats">Query statistics</button><button id="tableStats" data-side="tableStats" disabled>Table statistics</button></div><section id="toolPanel" class="tool-panel hidden"></section><div id="defaultInspector"><h2>Selection</h2><div id="selectionHelp" class="muted">Select a table or column.</div><div id="selectionInfo"></div><hr><h2>Joins</h2><div id="joinList"></div></div></aside></main>
<div id="joinModal" class="modal hidden"><div class="dialog"><h2>Create join</h2><div class="two"><label>Left table<select id="joinLeftTable"></select></label><label>Right table<select id="joinRightTable"></select></label></div><label>Join type<select id="joinType"><option value="INNER JOIN">Inner join</option><option value="LEFT JOIN">Left join</option><option value="RIGHT JOIN">Right join</option><option value="FULL OUTER JOIN">Full outer join</option></select></label><div id="joinClauses"></div><button data-action="addClause">＋ Add condition</button><div class="dialog-actions"><button class="apply" data-action="saveJoin">Save join</button><button data-action="closeJoin">Cancel</button></div></div></div>
<div id="filterModal" class="modal hidden"><div class="dialog filter-dialog"><div class="filter-head"><div><h2 id="filterTitle">Choose filter values</h2><p class="muted">Select distinct values or use advanced filter syntax.</p></div><button data-action="closeFilter">×</button></div><input id="filterSearch" placeholder="Search values"><label class="filter-select-all"><input id="filterSelectAll" type="checkbox"> Select all visible values</label><div id="filterValues" class="filter-values"></div><details><summary>Advanced filter syntax</summary><pre>= value       equality&#10;&lt;&gt; value      not equal&#10;&gt;, &gt;=, &lt;, &lt;=  comparisons&#10;in (A,B,C)    list&#10;1|2|3         list shorthand&#10;between a and b&#10;1-10          numeric range&#10;like ABC%     wildcard match&#10;123*          wildcard shorthand&#10;null / not null</pre></details><div class="dialog-actions"><button data-action="applyFilter" class="apply">Apply filter</button><button data-action="clearFilter">Clear</button><button data-action="closeFilter">Cancel</button></div></div></div>
<div id="contextMenu" class="context-menu hidden"></div><div id="toast" class="toast hidden"></div><script src="parameter-editor.js"></script><script src="query-workspace.js?v=20260920-6"></script><script src="local-table-tools.js?v=20260917-1"></script><script src="query-tabs.js?v=20260920-4"></script></body></html>
