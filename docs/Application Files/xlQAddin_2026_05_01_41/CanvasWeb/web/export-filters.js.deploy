(() => {
  function dateRange(box,from,to,apply,single=false){
    from.hidden=to.hidden=true;
    const row=document.createElement('div');row.className='date-range-display';box.append(row);
    const open=document.createElement('button');open.type='button';open.className='date-picker-selected';open.textContent=single?'Choose date':'Choose dates';box.append(open);
    function sync(){row.replaceChildren();row.hidden=!from.value&&!to.value;if(row.hidden)return;[from,to].slice(0,single?1:2).forEach((input,i)=>{if(i){const dash=document.createElement('span');dash.textContent='—';row.append(dash);}const button=document.createElement('button');button.type='button';button.className='date-picker-value';button.textContent=input.value||(i?'To':'From');button.setAttribute('aria-label',(i?'To ':'From ')+input.value);button.onclick=()=>open.click();row.append(button);});}
    sync();
    const iso=date=>`${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
    open.onclick=()=>{
      const dialog=document.createElement('dialog');dialog.className='range-calendar';
      dialog.innerHTML='<form method="dialog"><h3>Choose date range</h3><p data-summary>Select a start date, then an end date.</p><div class="range-calendar-navigation"><button type="button" data-prev aria-label="Previous month">‹</button><button type="button" data-next aria-label="Next month">›</button></div><div class="range-calendar-months"></div><div class="date-range-fields"><label>From<input type="date" data-from></label><label>To<input type="date" data-to></label></div><p data-error role="alert"></p><div class="range-calendar-actions"><button type="button" data-clear>Clear</button><button value="cancel">Cancel</button><button value="apply">Apply</button></div></form>';
      const a=dialog.querySelector('[data-from]'),b=dialog.querySelector('[data-to]');a.value=from.value;b.value=to.value;
      if(single){dialog.querySelector('h3').textContent='Choose date';a.parentElement.firstChild.textContent='Date';b.parentElement.hidden=true;}
      let month=new Date((a.value||iso(new Date()))+'T12:00:00');month.setDate(1);let choosingEnd=false;
      function draw(){
        const months=dialog.querySelector('.range-calendar-months');months.replaceChildren();
        dialog.querySelector('[data-summary]').textContent=single?(a.value||'Select a date.'):(a.value?(a.value+' — '+(b.value||'Select end date')):'Select a start date, then an end date.');
        for(let offset=0;offset<2;offset++){
          const date=new Date(month.getFullYear(),month.getMonth()+offset,1),panel=document.createElement('section');panel.className='range-calendar-month';
          const heading=document.createElement('h4');heading.textContent=date.toLocaleDateString(undefined,{month:'long',year:'numeric'});panel.append(heading);
          const grid=document.createElement('div');grid.className='range-calendar-grid';panel.append(grid);
          ['Mo','Tu','We','Th','Fr','Sa','Su'].forEach(text=>{const span=document.createElement('span');span.textContent=text;grid.append(span);});
          for(let i=0;i<(date.getDay()+6)%7;i++)grid.append(document.createElement('span'));
          const count=new Date(date.getFullYear(),date.getMonth()+1,0).getDate();
          for(let day=1;day<=count;day++){
            const value=iso(new Date(date.getFullYear(),date.getMonth(),day)),button=document.createElement('button');button.type='button';button.textContent=day;button.setAttribute('aria-label',value);button.setAttribute('aria-pressed',String(value===a.value||value===b.value));
            if(value===a.value||value===b.value)button.classList.add('endpoint');else if(a.value&&b.value&&value>a.value&&value<b.value)button.classList.add('in-range');
            if(value===iso(new Date())){button.classList.add('today');button.setAttribute('aria-current','date');}
            button.onclick=()=>{if(single){a.value=value;b.value='';}else if(!choosingEnd){a.value=value;b.value='';choosingEnd=true;}else{if(value<a.value){b.value=a.value;a.value=value;}else b.value=value;choosingEnd=false;}draw();};grid.append(button);
          }months.append(panel);
        }
      }
      dialog.querySelector('[data-prev]').onclick=()=>{month.setMonth(month.getMonth()-1);draw();};dialog.querySelector('[data-next]').onclick=()=>{month.setMonth(month.getMonth()+1);draw();};a.onchange=b.onchange=draw;
      dialog.querySelector('[data-clear]').onclick=()=>{a.value=b.value='';choosingEnd=false;draw();};
      dialog.querySelector('form').onsubmit=event=>{if(event.submitter.value==='apply'&&a.value&&b.value&&a.value>b.value){event.preventDefault();dialog.querySelector('[data-error]').textContent='From must be on or before To.';}};
      dialog.addEventListener('close',()=>{if(dialog.returnValue==='apply'){from.value=a.value;to.value=single?'':b.value;sync();apply();}dialog.remove();});document.body.append(dialog);draw();dialog.showModal();
    };
    return sync;
  }
  window.ExportFilters={install(doc,parent,changed){
    if(!document.querySelector('#range-calendar-style')){const style=document.createElement('style');style.id='range-calendar-style';style.textContent='.date-range-fields{display:flex;gap:12px;flex-wrap:wrap;margin:8px 0}.date-range-fields label{display:flex;flex:1;min-width:130px;flex-direction:column;gap:4px;font-size:12px}.date-range-fields input{box-sizing:border-box;width:100%;min-width:0;padding:8px;border:1px solid #cbd5e1;border-radius:6px}.range-calendar{width:min(620px,calc(100vw - 48px));max-height:85vh;overflow:auto;border:1px solid #cbd5e1;border-radius:12px;padding:20px;color:#34425e;background:white}.range-calendar::backdrop{background:#17203355}.range-calendar-navigation,.range-calendar-actions{display:flex;gap:8px;justify-content:flex-end}.range-calendar-months{display:grid;grid-template-columns:1fr 1fr;gap:20px}.range-calendar-month h4{text-align:center}.range-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center}.range-calendar-grid span{font-size:12px;padding:6px 0}.range-calendar button{border:1px solid #dbe1eb;border-radius:6px;background:white;color:#34425e;padding:8px;cursor:pointer}.range-calendar-grid button{border-color:transparent;padding:9px 0}.range-calendar button:hover{background:#e8edfb}.range-calendar .in-range{background:#e8edfb}.range-calendar .endpoint,.range-calendar button[value=apply]{background:var(--viewer-selected-bg,#4f6ee8);color:var(--viewer-selected-color,white)}@media(max-width:580px){.range-calendar-months{grid-template-columns:1fr}.range-calendar-month:nth-child(2){display:none}}';document.head.append(style);}
    const originals=doc.sources.map(s=>structuredClone(s.query.filters||[])),states=[];
    function apply(){doc.sources.forEach((source,i)=>{source.query.filters=structuredClone(originals[i]);states.filter(s=>s.source===source).forEach(s=>source.query.filters.push(...s.filters()));});changed();}
    doc.sources.forEach(source=>{
      const group=document.createElement("fieldset"),legend=document.createElement("legend");legend.textContent=source.name;group.append(legend);
      source.query.data.columns.forEach((column,index)=>{
        const config=(doc.viewerOptions?.filterColumns||[]).find(c=>c.sourceId===source.id&&c.column===column);
        if(doc.viewerOptions?.filterMode==="pick"&&!config)return;
        const type=config?.filterType||"basic",box=document.createElement("div");box.className="export-filter";box.textContent=column;group.append(box);
        const values=[...new Set(source.query.data.rows.map(r=>r[index]).filter(v=>v!=null).map(String))].sort();
        const state={source,filters:()=>[],reset:()=>{}};states.push(state);
        const filter=(operator,value)=>({column,operator,value,enabled:true});
        const input=()=>{const control=document.createElement("input");box.append(control);control.onchange=apply;return control;};
        if(type==="advanced"||type==="date"||type==="dateSingle"){
          let operator;
          if(type==="advanced"){operator=document.createElement("select");[["between","From / to"],["equals","Equals"],["notequals","Does not equal"],["contains","Contains"],["notcontains","Does not contain"],[">=","At least"],["<=","At most"]].forEach(([value,text])=>operator.add(new Option(text,value)));box.append(operator);}
          const from=input(),to=input();from.placeholder="From";to.placeholder="To";if(type!=="advanced")from.type=to.type="date";
          const sync=type!=="advanced"?dateRange(box,from,to,apply,type==="dateSingle"):()=>{};
          if(type==='advanced'){box.classList.add('advanced-filter');const fields=document.createElement('div');fields.className='advanced-filter-fields';[from,to].forEach((control,i)=>{const label=document.createElement('label');label.textContent=i?'To':'From / value';control.setAttribute('aria-label',i?'To':'From or value');label.append(control);fields.append(label);});box.append(fields);}
          if(operator)operator.onchange=()=>{to.hidden=operator.value!=="between";to.closest('label').hidden=to.hidden;apply();};
          state.filters=()=>{if(type==="dateSingle")return from.value?[filter(">=",from.value),filter("<=",from.value+"T23:59:59.999")]:[];if(type==="date")return [...(from.value?[filter(">=",from.value)]:[]),...(to.value?[filter("<=",to.value+"T23:59:59.999")]:[])];if(operator.value==="between")return [...(from.value?[filter(">=",from.value)]:[]),...(to.value?[filter("<=",to.value)]:[])];return from.value?[filter(operator.value,from.value)]:[];};state.reset=()=>{from.value=to.value="";sync();};
        }else if(type==='toggle'){
          const boolean=values.some(v=>/^(true|false)$/i.test(v)),on=boolean?(values.find(v=>/^true$/i.test(v))||'true'):'1',off=boolean?(values.find(v=>/^false$/i.test(v))||'false'):'0';let selected=null;
          const row=document.createElement('div');row.className='toggle-filter-row';const status=document.createElement('span'),toggle=document.createElement('button'),clear=document.createElement('button');toggle.type=clear.type='button';toggle.className='export-toggle';toggle.setAttribute('role','switch');toggle.setAttribute('aria-label',column);toggle.innerHTML='<span></span>';clear.textContent='All values';
          const draw=()=>{toggle.setAttribute('aria-checked',String(selected===on));toggle.classList.toggle('active',selected===on);status.textContent=selected===null?'All values':selected===on?'On ('+on+')':'Off ('+off+')';};
          toggle.onclick=()=>{selected=selected===on?off:on;draw();apply();};clear.onclick=()=>{selected=null;draw();apply();};row.append(status,toggle,clear);box.append(row);draw();state.filters=()=>selected===null?[]:[filter('equals',selected)];state.reset=()=>{selected=null;draw();};
        }else if(type==="buttons"){
          const selected=new Set(),buttons=[];
          const strip=document.createElement("div");strip.className="filter-buttons";box.append(strip);
          values.forEach(value=>{const button=document.createElement("button");button.type="button";button.textContent=value;button.onclick=()=>{selected.has(value)?selected.delete(value):selected.add(value);button.classList.toggle("active",selected.has(value));button.setAttribute("aria-pressed",String(selected.has(value)));apply();};button.setAttribute("aria-pressed","false");buttons.push(button);strip.append(button);});
          state.filters=()=>selected.size?[{column,mode:"Basic",basicValues:[...selected],enabled:true}]:[];state.reset=()=>{selected.clear();buttons.forEach(b=>{b.classList.remove("active");b.setAttribute("aria-pressed","false");});};
        }else{
          if(values.length>2000&&type==="basic"){const control=input();control.placeholder="Enter a value";state.filters=()=>control.value?[filter("equals",control.value)]:[];state.reset=()=>control.value="";}
          else {const select=document.createElement("select");box.append(select);select.onchange=apply;
            if(type==="multiple"){select.multiple=true;select.size=Math.min(6,Math.max(2,values.length));}
            else select.add(new Option("All (within saved filters)",""));
            const choices=type==="toggle"?(values.some(v=>/^(true|false)$/i.test(v))?["true","false"]:["1","0"]):values;
            choices.forEach(value=>select.add(new Option(value,value)));
            state.filters=()=>type==="multiple"?[...select.selectedOptions].length?[{column,mode:"Basic",basicValues:[...select.selectedOptions].map(o=>o.value),enabled:true}]:[]:select.value?[filter("equals",select.value)]:[];
            state.reset=()=>{[...select.options].forEach(o=>o.selected=false);if(!select.multiple)select.value="";};
            if(type==="multiple"){
              const actions=document.createElement("div");actions.className="filter-buttons";box.append(actions);
              const all=document.createElement("button"),clear=document.createElement("button");all.type=clear.type="button";all.textContent="All values";clear.textContent="Clear selection";
              all.onclick=()=>{[...select.options].forEach(o=>o.selected=true);apply();};
              clear.onclick=()=>{state.reset();apply();};actions.append(all,clear);
            }
          }
        }
      });if(group.querySelector(".export-filter"))parent.append(group);
    });
    const reset=document.createElement("button");reset.textContent="Reset filters";reset.onclick=()=>{states.forEach(s=>s.reset());apply();};parent.append(reset);
  }};
})();
