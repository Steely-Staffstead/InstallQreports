<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QReports measures</title><link rel="stylesheet" href="measure-workspace.css?v=2"><link rel="stylesheet" href="measure-workspace-menu.css?v=2"><script src="shared-settings.js?v=20260913-2"></script></head><body>
<header><div class="brand"><span>Q</span><div><strong>Measure workspace</strong><small>Create, validate and test MiniDAX measures and calculated columns</small></div></div><nav><button id="loadData">Load data</button><button id="newMeasure">＋ New</button><button id="showDaxFunctions">Functions</button><button id="validate" class="run">✓ Validate</button><button id="save" class="primary">Save</button><button id="delete">Delete</button><button id="apply" class="primary">Return measures</button><button id="close">Close</button></nav></header>
<main id="layout"><aside id="fieldsPane"><div class="pane-head"><h2>Fields</h2><button class="collapse" data-collapse="fields" title="Hide fields">‹</button></div><div class="pane-body"><p id="dataStatus">Data is not loaded. Measures remain editable.</p><input id="fieldSearch" placeholder="Search fields"><div id="fields"></div></div><button class="pane-tab" data-expand="fields">Fields</button></aside><div class="side-splitter" data-resize="fields" title="Resize fields pane"></div>
<section id="measuresPane" class="measures"><div class="pane-head"><h2>Measures</h2><button class="collapse" data-collapse="measures" title="Hide measures">‹</button></div><div class="pane-body"><input id="measureSearch" placeholder="Search measures"><div id="measureList"></div></div><button class="pane-tab" data-expand="measures">Measures</button></section><div class="side-splitter" data-resize="measures" title="Resize measures pane"></div>
<section class="workspace"><div class="editor-head"><label>Name<input id="name" placeholder="Measure or column name"></label><span id="status">Ready</span></div><label class="formula-label"><span>Expression</span><div class="dax-editor"><pre id="expressionHighlight" aria-hidden="true"></pre><textarea id="expression" spellcheck="false" autocomplete="off" placeholder="SUM(amount)"></textarea><div id="daxAutocomplete" class="dax-autocomplete hidden"></div></div></label><div id="validation" class="validation">Select or create a measure.</div><div class="matrix-builder"><div><h3>Rows</h3><div id="rows" class="dropzone" data-zone="rows"></div></div><div><h3>Columns <small>(maximum 1)</small></h3><div id="columns" class="dropzone" data-zone="columns"></div></div><div><h3>Values</h3><div id="values" class="dropzone" data-zone="values"></div></div><button id="testMatrix" class="run">Test matrix</button></div><div id="matrixSplitter" class="matrix-splitter" title="Resize matrix result"><span></span></div><div class="result-head"><span>MATRIX RESULT</span><span id="resultCount"></span></div><div class="result"><table><thead id="resultHead"></thead><tbody id="resultBody"></tbody></table></div></section><div id="daxFunctionsSplitter" class="dax-functions-splitter" title="Resize function reference"></div><aside id="daxFunctionsPane" class="dax-functions-pane"><div><h2>Function reference</h2><button id="closeDaxFunctions">×</button></div><input id="daxFunctionSearch" placeholder="Search functions"><div id="daxFunctionList"></div></aside></main>
<div id="columnMenu" class="menu hidden"></div><div id="fieldMenu" class="menu field-menu hidden"></div><div id="toast" class="toast hidden"></div><link rel="stylesheet" href="measure-workspace-editor.css?v=20260907-2"><script src="measure-workspace.js?v=4"></script><script src="measure-workspace-editor.js?v=20260907-2"></script></body></html>
