  }

  function render(options) {
    const data=options?.data||{columns:[],rows:[]},spec=options?.spec||{},settings=parseJson(options?.settingsJson),overall=typeName(first(ci(settings,"type"),ci(spec,"Kind","kind"))),context=chartContext(spec,settings),definitions=seriesDefinitions(spec,settings,first(context.y,options?.fallbackField),overall),suppliedPalette=Array.isArray(options?.paletteColors)?options.paletteColors.filter(color=>/^#[0-9a-f]{6}$/i.test(String(color))):[];context.interactive=!!options?.interactive;context.viewportAspect=Number(options?.viewportWidth)/Number(options?.viewportHeight)||800/440;palette=suppliedPalette.length?suppliedPalette:(palettes[Object.keys(palettes).find(name=>name.toLowerCase()===context.paletteName.toLowerCase())]||palettes.Default);
    if(context.showMultiples&&context.subgroup){
      const splitIndex=fieldIndex(data.columns,context.subgroup),values=splitIndex<0?[]:[...new Set(data.rows.map(row=>String(row[splitIndex]??"(blank)")))].slice(0,context.multipleMax);
      if(values.length){
        const autoCols=values.length<=2?values.length:values.length<=4?2:values.length<=9?3:4,cols=Math.max(1,Math.round(context.multipleColumns||(context.multipleRows?Math.ceil(values.length/context.multipleRows):autoCols))),childWidth=Math.max(180,(Number(options?.viewportWidth)||800)/cols),childHeight=Math.max(160,(Number(options?.viewportHeight)||440)/Math.ceil(values.length/cols));
        const align={left:"left",center:"center",right:"right"}[context.multipleHeaderAlignment.toLowerCase()]||"left",decoration=context.multipleHeaderUnderline?"underline":"none",weight=context.multipleHeaderBold?"700":"400",fontStyle=context.multipleHeaderItalic?"italic":"normal",headerStyle=`text-align:${align};font-size:${context.multipleHeaderSize}px;color:${esc(context.multipleHeaderColor)};font-weight:${weight};font-style:${fontStyle};text-decoration:${decoration}`;
        return `<div class="chart-web-surface chart-small-multiples" style="--multiple-columns:${cols};--multiple-gap:${context.multipleSpacing}px">${values.map(value=>{const childSpec=JSON.parse(JSON.stringify(spec));childSpec.Style||={};childSpec.Style.SubgroupBy="";childSpec.ChartOptions||={};childSpec.ChartOptions.ShowAsMultiples=false;childSpec.ChartOptions.ShowTitle=false;const childData={...data,rows:data.rows.filter(row=>String(row[splitIndex]??"(blank)")===value)};return `<section class="chart-small-multiple"><b style="${headerStyle}">${esc(value)}</b>${render({...options,data:childData,spec:childSpec,viewportWidth:childWidth,viewportHeight:childHeight})}</section>`;}).join("")}</div>`;
