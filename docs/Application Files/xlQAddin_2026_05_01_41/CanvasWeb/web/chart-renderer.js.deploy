    if(["treemap","gauge","pie","doughnut"].includes(overall)){const expression=/<text[^>]*data-chart-action="data-label"[^>]*transform="[^"]*"[^>]*>[\s\S]*?<\/text>/g,matches=output.match(expression)||[],every=spacingEvery(matches.length,context.labels.spacing,12);let ordinal=0;output=output.replace(expression,label=>ordinal++%every?"":label);}
