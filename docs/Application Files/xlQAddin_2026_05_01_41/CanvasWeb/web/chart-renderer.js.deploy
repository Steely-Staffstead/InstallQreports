    if(numericCategories&&(Number.isFinite(min)||Number.isFinite(max)))indexes=indexes.filter(index=>{const value=Number(aggregated.categories[index]);return (!Number.isFinite(min)||value>=min)&&(!Number.isFinite(max)||value<=max);});
