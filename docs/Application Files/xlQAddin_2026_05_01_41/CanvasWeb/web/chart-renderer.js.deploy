    if(!data.rows?.length)return shell(empty("Click Update to load query data."),context);
    if(!definitions.length)return shell(empty("Choose a value in the chart designer."),context);
    let output;
    if(["pie","doughnut"].includes(overall))output=radialSvg(data,definitions[0],options?.measures||[],context,overall==="doughnut");
