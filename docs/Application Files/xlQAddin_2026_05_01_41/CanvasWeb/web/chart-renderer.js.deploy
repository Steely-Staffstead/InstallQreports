    const orderChildren=children=>{const list=[...children.values()],order=String(context.categoryOrder).toLowerCase();if(order.includes("byyasc"))list.sort((a,b)=>a.value-b.value);else if(order.includes("byydesc"))list.sort((a,b)=>b.value-a.value);else if(order.includes("asc"))list.sort((a,b)=>a.name.localeCompare(b.name,undefined,{numeric:true}));else if(order.includes("desc"))list.sort((a,b)=>b.name.localeCompare(a.name,undefined,{numeric:true}));else list.sort((a,b)=>b.value-a.value);return list;};
