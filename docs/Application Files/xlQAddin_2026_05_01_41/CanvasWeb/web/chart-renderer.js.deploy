    const balancedSplit=items=>{if(items.length<2)return 1;const total=items.reduce((sum,item)=>sum+item.value,0),target=total/2;let running=0,best=1,distance=Infinity;for(let i=1;i<items.length;i++){running+=items[i-1].value;const next=Math.abs(target-running);if(next<distance){distance=next;best=i;}}return best;};
    const W=Math.max(180,Math.min(1100,440*(context.viewportAspect||800/440)));let svg=`<svg class="chart-web-svg" data-chart-shape="fixed" viewBox="0 0 ${W} 440">${titleSvg(context,W)}`;
