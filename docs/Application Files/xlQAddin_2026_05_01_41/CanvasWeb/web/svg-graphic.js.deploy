(() => {
  const templates = ["badge","card","circle","banner","progressBar","progressRing","statusPill","compactKpi","iconNumber","calendar","targetGauge","comparisonCard","rankingBadge","varianceIndicator","bulletChart","manual"];
  const defaults = () => ({template:"badge",text:"WEEK",subtext:"",textSize:18,subtextSize:14,valueSource:"manual",value:"31",valueName:"",valueSize:58,targetSource:"manual",target:"100",targetName:"",color:"#285d96",textColor:"#ffffff",backgroundColor:"#ffffff",thresholdSource:"manual",threshold:"0",thresholdName:"",belowColor:"#d64562",svgCode:'<svg viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg"><text x="200" y="110" text-anchor="middle">SVG</text></svg>'});
  const escape = value => String(value??"").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const hex = (value,fallback) => /^#[\da-f]{6}$/i.test(String(value)) ? value : fallback;
  const number = (value,fallback=0) => {const n=Number(typeof value==="string"?value.trim().replace(",","."):value);return Number.isFinite(n)?n:fallback;};
  const resolveText = (value,context) => String(value??"").replace(/\{\{\s*([^{}]+?)\s*\}\}/g,(_,token)=>{
    const match=/^(measure|field|parameter)\s*:\s*(.+)$/i.exec(token),kind=match?.[1].toLowerCase()||"parameter",name=(match?.[2]||token).trim();
    const resolved=kind==="parameter"?context.parameterValue?.(name):context.fieldValue?.(name);
    return resolved==null?"":kind==="parameter"?String(resolved):String(context.formatValue?.(resolved)??resolved);
  });
  function render(input,context={}) {
    const g={...defaults(),...(input||{})}, pick=(source,value,name)=>source==="parameter"?context.parameterValue?.(name):source==="field"?context.fieldValue?.(name):value;
    const value=pick(g.valueSource,g.value,g.valueName), target=pick(g.targetSource,g.target,g.targetName), threshold=pick(g.thresholdSource,g.threshold,g.thresholdName), n=number(value), goal=number(target,100), active=n<number(threshold,0)?hex(g.belowColor,"#d64562"):hex(g.color,"#285d96"), ink=hex(g.textColor,"#ffffff"), background=hex(g.backgroundColor,"#ffffff"), text=escape(resolveText(g.text,context)), subtext=escape(resolveText(g.subtext,context)), shown=escape(value), shownTarget=escape(target), ts=Math.max(8,Math.min(80,number(g.textSize,18))), vs=Math.max(8,Math.min(120,number(g.valueSize,58))), ss=Math.max(8,Math.min(72,number(g.subtextSize,14))), pct=Math.max(0,Math.min(100,n)), ratio=goal?Math.max(0,Math.min(1,n/goal)):0;
    if(g.template==="manual") return context.resolveManual?.(g.svgCode)||"";
    const label=(y=50)=>`<text x="200" y="${y}" text-anchor="middle" fill="${ink}" font-size="${ts}" font-weight="700">${text}</text>`;
    const val=(y=118)=>`<text x="200" y="${y}" text-anchor="middle" fill="${ink}" font-size="${vs}" font-weight="700">${shown}</text>`;
    const sub=(y=160)=>subtext?`<text x="200" y="${y}" text-anchor="middle" fill="${ink}" font-size="${ss}">${subtext}</text>`:"";
    let body="";
    switch(g.template){
      case "badge": body=`<rect x="35" y="8" width="330" height="184" rx="48" fill="${active}"/>${label(62)}${val(133)}${sub(164)}`;break;
      case "circle": body=`<circle cx="200" cy="100" r="98" fill="${active}"/>${label(61)}${val(125)}${sub(158)}`;break;
      case "banner": body=`<rect x="10" y="35" width="380" height="130" rx="18" fill="${active}"/>${label(79)}${val(134)}${sub(157)}`;break;
      case "progressBar": {const width=352*pct/100,fill=pct>0?`<rect x="24" y="98" width="${width}" height="28" rx="${Math.min(14,width/2)}" fill="${active}"/>`:"";body=`<rect x="16" y="20" width="368" height="160" rx="18" fill="${background}"/>${label(64)}<rect x="24" y="98" width="352" height="28" rx="14" fill="#dce5f0"/>${fill}<text x="200" y="159" text-anchor="middle" fill="${active}" font-size="${ss}" font-weight="700">${shown}%</text>`;break;}
      case "progressRing": body=`<circle cx="200" cy="100" r="75" fill="none" stroke="#dce5f0" stroke-width="20"/><circle cx="200" cy="100" r="75" fill="none" stroke="${active}" stroke-width="20" stroke-linecap="round" stroke-dasharray="${(2*Math.PI*75*pct/100).toFixed(2)} 471.24" transform="rotate(-90 200 100)"/>${val(110)}${label(160)}`;break;
      case "statusPill": body=`<rect x="40" y="55" width="320" height="90" rx="45" fill="${active}"/>${label(108)}${sub(132)}`;break;
      case "compactKpi": body=`<rect x="12" y="20" width="376" height="160" rx="20" fill="${background}" stroke="${active}" stroke-width="4"/><text x="32" y="62" fill="${active}" font-size="${ts}" font-weight="700">${text}</text><text x="32" y="132" fill="${active}" font-size="${vs}" font-weight="700">${shown}</text>${subtext?`<text x="32" y="163" fill="${active}" font-size="${ss}">${subtext}</text>`:""}`;break;
      case "iconNumber": body=`<circle cx="85" cy="100" r="45" fill="${active}"/><text x="85" y="115" text-anchor="middle" fill="${ink}" font-size="43">◆</text><text x="250" y="105" text-anchor="middle" fill="${active}" font-size="${vs}" font-weight="700">${shown}</text><text x="250" y="145" text-anchor="middle" fill="${active}" font-size="${ts}">${text}</text>`;break;
      case "calendar": body=`<rect x="100" y="12" width="200" height="176" rx="24" fill="${background}" stroke="${active}" stroke-width="5"/><path d="M100 66 H300" stroke="${active}" stroke-width="5"/><text x="200" y="48" text-anchor="middle" fill="${active}" font-size="${ts}" font-weight="700">${text}</text><text x="200" y="135" text-anchor="middle" fill="${active}" font-size="${vs}" font-weight="700">${shown}</text><text x="200" y="166" text-anchor="middle" fill="${active}" font-size="${ss}">${subtext}</text>`;break;
      case "targetGauge": body=`<path d="M60 153 A140 140 0 0 1 340 153" fill="none" stroke="#dce5f0" stroke-width="25"/><path d="M60 153 A140 140 0 0 1 340 153" fill="none" stroke="${active}" stroke-width="25" stroke-dasharray="${(440*ratio).toFixed(2)} 440"/>${val(127)}<text x="200" y="163" text-anchor="middle" fill="${active}" font-size="${ss}">Target ${shownTarget}</text>${label(40)}`;break;
      case "comparisonCard": body=`<rect x="12" y="15" width="376" height="170" rx="22" fill="${background}" stroke="${active}" stroke-width="3"/>${label(50)}<text x="115" y="126" text-anchor="middle" fill="${active}" font-size="${vs}" font-weight="700">${shown}</text><text x="280" y="126" text-anchor="middle" fill="${active}" font-size="${Math.max(20,vs*.7)}">${shownTarget}</text>${sub(163)}`;break;
      case "rankingBadge": body=`<path d="M200 12 L324 57 L300 165 L200 190 L100 165 L76 57 Z" fill="${active}"/>${label(58)}${val(127)}${sub(160)}`;break;
      case "varianceIndicator": {const delta=n-goal;body=`<rect x="14" y="20" width="372" height="160" rx="22" fill="${background}"/>${label(55)}<text x="200" y="123" text-anchor="middle" fill="${delta<0?hex(g.belowColor,"#d64562"):active}" font-size="${vs}" font-weight="700">${escape(delta>0?`+${delta}`:delta)}</text><text x="200" y="157" text-anchor="middle" fill="${active}" font-size="${ss}">${shown} / ${shownTarget}</text>`;break;}
      case "bulletChart": {const end=24+352*Math.max(0,Math.min(1,ratio)),marker=24+352*Math.max(0,Math.min(1,goal/Math.max(goal,n,1)));body=`${label(47)}<rect x="24" y="85" width="352" height="32" rx="5" fill="#dce5f0"/><rect x="24" y="85" width="${Math.max(0,end-24)}" height="32" rx="5" fill="${active}"/><path d="M${marker} 76 V126" stroke="#1f2937" stroke-width="4"/><text x="200" y="157" text-anchor="middle" fill="${active}" font-size="${ss}">${shown} / ${shownTarget}</text>`;break;}
      default: body=`<rect x="12" y="12" width="376" height="176" rx="20" fill="${active}"/>${label(58)}${val(125)}${sub(161)}`;
    }
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 200" role="img" aria-label="${text} ${shown}" preserveAspectRatio="xMidYMid meet">${body}</svg>`;
  }
  window.CanvasSvgGraphic={templates,defaults,render};
})();
