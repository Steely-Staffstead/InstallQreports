:root{font-family:"Segoe UI",Arial,sans-serif;color:#17213a;background:#eef2f8}*{box-sizing:border-box}body{margin:0;height:100vh;display:grid;grid-template-rows:84px 1fr;overflow:hidden}header{display:flex;align-items:center;gap:18px;padding:14px 24px;background:#243154;color:white}.brand{display:flex;align-items:center;gap:12px}.brand>span{display:grid;place-items:center;width:48px;height:48px;border-radius:13px;background:#6686ee;font-size:27px;font-weight:800}.brand strong{display:block;font-size:21px}.brand small{color:#cbd5e1}.tools{margin-left:auto;display:flex;gap:8px;align-items:center}.tools button,.tools input,.tools select{border:1px solid #617091;border-radius:8px;padding:8px 11px;background:#344263;color:white}.tools input{width:220px}.tools input::placeholder{color:#c7d0e5}.tools select option{color:#17213a;background:white}main{min-height:0;padding:16px 22px;display:grid;grid-template-rows:auto 1fr;gap:9px}#summary{font-size:12px;color:#64748b}#entries{overflow:auto;background:#111827;border-radius:10px;padding:10px 0;box-shadow:0 6px 22px rgba(15,23,42,.15)}.entry{display:grid;grid-template-columns:145px 82px 1fr;gap:10px;padding:7px 14px;border-bottom:1px solid #263247;color:#e5e7eb;font:13px/1.45 Consolas,"Courier New",monospace}.entry time{color:#94a3b8}.entry .level{font-weight:700}.entry.warning .level{color:#fbbf24}.entry.error .level{color:#f87171}.entry.info .level{color:#7dd3fc}.details{grid-column:3;white-space:pre-wrap;color:#aeb9ca}.empty{padding:50px;text-align:center;color:#94a3b8}@media(max-width:950px){header{align-items:flex-start;height:auto}.tools{flex-wrap:wrap}.tools input{width:150px}.entry{grid-template-columns:120px 70px 1fr}}
