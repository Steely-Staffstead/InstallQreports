(() => {
  const host=window.chrome?.webview;
  const defaults={zoom:1,records:1000,queryShowTabs:false,miniSqlMaxSourceRows:0,miniSqlMaxIntermediateRows:0,miniSqlMaxResultRows:0,miniSqlTimeoutSeconds:0,defaultChartTheme:'Default',defaultChartColors:[],defaultSavePath:'',themeRoles:{},defaultCanvasSizeMode:'fit',defaultCanvasPreset:'1280x720',defaultCanvasWidth:1280,defaultCanvasHeight:720};
  const roleDefaults={text:'#182230',accent:'#4f6ee8',surface:'#ffffff',headerBackground:'#eef3f9',headerText:'#344054',grid:'#dce3ec',positive:'#16844a',negative:'#c43d4b'};
  const paletteDefaults={Default:["#4f6ee8","#16a085","#e67e22","#8e5bd9","#d64562","#2e86c1","#7d8f29","#a66a3f"],Bright:["#3366cc","#dc3912","#ff9900","#109618","#990099","#0099c6","#dd4477","#66aa00"],Pastel:["#8db3e2","#f4b183","#a9d18e","#d5a6bd","#ffe699","#9dc3e6","#c9c9c9","#b4a7d6"],Muted:["#607d8b","#78909c","#8d6e63","#7e57c2","#5c6bc0","#26a69a","#9e9d24","#ef6c00"],Excel:["#4472c4","#ed7d31","#a5a5a5","#ffc000","#5b9bd5","#70ad47","#264478","#9e480e"],EarthTones:["#6b705c","#a5a58d","#b7b7a4","#cb997e","#ddbea9","#7f5539","#9c6644","#386641"],Berry:["#5b2a86","#8b3a9c","#b94e8f","#d8647a","#e9856f","#9c2c77","#692c70","#3d285d"],SeaGreen:["#006d77","#0a9396","#2a9d8f","#52b788","#74c69d","#95d5b2","#40916c","#1b4332"],Fire:["#7f0000","#b30000","#d7301f","#ef6548","#fc8d59","#fdbb84","#fdd49e","#ffeda0"],Grayscale:["#20242a","#414850","#626b75","#838e99","#a5afb9","#c4cbd2","#dce1e5","#eff1f3"]};
  let settings={...defaults};
  if(!host)try{settings={...defaults,...JSON.parse(localStorage.getItem('qreports-shared-settings')||'{}')};}catch{}
  globalThis.QReportsSettings={get:()=>settings,open};
  function apply(value){settings={...defaults,...value};const roles={...roleDefaults,...settings.themeRoles};document.documentElement.style.setProperty('--qreports-accent',roles.accent);document.documentElement.style.setProperty('--qreports-surface',roles.surface);document.documentElement.style.setProperty('--qreports-text',roles.text);document.documentElement.style.setProperty('--qreports-header',roles.headerBackground);document.documentElement.style.setProperty('--qreports-header-text',roles.headerText);document.documentElement.toggleAttribute('data-qreports-theme',Object.keys(settings.themeRoles||{}).length>0);window.dispatchEvent(new CustomEvent('qreports-settings-changed',{detail:settings}));}
  function installCanvasSettings(dialog){
    const group=document.createElement('details');group.className='settings-group';
    group.innerHTML='<summary>Canvas</summary><label>Default canvas size<select name="defaultCanvasSizeMode"><option value="fit">Fit window</option><option value="preset">Preset</option><option value="manual">Manual</option></select></label><label class="settings-canvas-preset">Preset size<select name="defaultCanvasPreset"></select></label><div class="settings-canvas-manual settings-colors"><label>Width (px)<input name="defaultCanvasWidth" type="number" min="320" max="16384" required></label><label>Height (px)<input name="defaultCanvasHeight" type="number" min="240" max="16384" required></label></div><small>Applies to new reports and newly added pages. Existing page sizes are unchanged.</small>';
    const presets=[...document.querySelectorAll('#canvasPreset option')].map(option=>option.value);
    if(!presets.length)presets.push('640x360','800x450','960x540','1280x720','1600x900','1920x1080','2560x1440','3840x2160');
    if(!presets.includes(settings.defaultCanvasPreset))presets.push(settings.defaultCanvasPreset);
    group.querySelector('[name=defaultCanvasPreset]').replaceChildren(...presets.map(size=>new Option(size.replace('x',' × '),size)));
    dialog.querySelectorAll('.settings-group')[1].before(group);
    group.querySelector('[name=defaultCanvasSizeMode]').addEventListener('change',()=>toggleCanvasSizeFields(dialog));
  }
  function toggleCanvasSizeFields(dialog){
    const mode=dialog.querySelector('[name=defaultCanvasSizeMode]').value;
    dialog.querySelector('.settings-canvas-preset').style.display=mode==='preset'?'block':'none';
    dialog.querySelector('.settings-canvas-manual').style.display=mode==='manual'?'grid':'none';
    for(const name of ['defaultCanvasWidth','defaultCanvasHeight'])dialog.querySelector(`[name=${name}]`).disabled=mode!=='manual';
  }
  function open(){
    document.querySelector('#sharedSettingsDialog')?.remove();const dialog=document.createElement('dialog');dialog.id='sharedSettingsDialog';
    dialog.innerHTML='<form method="dialog"><header><h2>Settings</h2><button value="cancel" aria-label="Close">×</button></header><details class="settings-group"><summary>Colors</summary><div class="settings-color-preview" aria-label="Color preview"><div class="settings-preview-card"><div class="settings-preview-heading">Report preview</div><div class="settings-preview-body"><strong class="settings-preview-accent">42,500</strong><p>Sample report text</p><span class="settings-preview-positive">Positive +12%</span> <span class="settings-preview-negative">Negative −8%</span></div></div></div><div class="settings-colors"></div><label>Default chart theme for new canvases<select name="defaultChartTheme"></select></label><div class="settings-chart-preview" aria-label="Chart palette preview"></div><button type="button" class="settings-restore-colors">Restore color defaults</button></details><details class="settings-group"><summary>General</summary><label>Zoom at startup<select name="zoom"><option value="0.75">75%</option><option value="0.9">90%</option><option value="1">100%</option><option value="1.1">110%</option><option value="1.25">125%</option><option value="1.5">150%</option><option value="2">200%</option></select></label><label>Default save folder<input name="defaultSavePath" type="text" placeholder="Choose your preferred folder path"></label></details><details class="settings-group"><summary>Query</summary><label>Records to return<input name="records" type="number" min="0" max="50000"></label><small>0 returns all records. Saved query limits take precedence.</small></details><details class="settings-group"><summary>MiniSQL limits</summary><small>Limits apply to local MiniSQL queries. 0 disables a limit; existing installations remain unlimited until you set one.</small><label>Maximum rows in each source<input name="miniSqlMaxSourceRows" type="number" min="0" max="10000000" required></label><label>Maximum intermediate rows<input name="miniSqlMaxIntermediateRows" type="number" min="0" max="10000000" required></label><label>Maximum result rows<input name="miniSqlMaxResultRows" type="number" min="0" max="10000000" required></label><label>Query timeout (seconds)<input name="miniSqlTimeoutSeconds" type="number" min="0" max="3600" required></label></details><p class="settings-error"></p><footer><button value="cancel">Cancel</button><button type="button" class="settings-save">Save settings</button></footer></form>';
    installCanvasSettings(dialog);
    [...dialog.querySelectorAll('.settings-group')].find(group=>group.querySelector('summary')?.textContent==='Query')?.querySelector('small')?.insertAdjacentHTML('beforebegin','<label class="settings-checkbox" style="display:flex;align-items:center;gap:8px"><input name="queryShowTabs" type="checkbox" style="width:auto"> Show tabs</label>');
    dialog.querySelector('[name=queryShowTabs]').checked=!!settings.queryShowTabs;
    const roles={...roleDefaults,...settings.themeRoles};Object.entries(roles).forEach(([name,color])=>{const label=document.createElement('label');label.textContent=name.replace(/([A-Z])/g,' $1');const input=document.createElement('input');input.type='color';input.dataset.role=name;input.value=color;label.append(input);dialog.querySelector('.settings-colors').append(label);});
    const paletteNames=['Default','Bright','Pastel','Muted','Excel','EarthTones','Berry','SeaGreen','Fire','Grayscale',...(window.canvasSettingsPalettes||[]).map(item=>item.name),settings.defaultChartTheme];dialog.querySelector('[name=defaultChartTheme]').replaceChildren(...[...new Set(paletteNames)].map(name=>new Option(name,name)));
    const zoomSelect=dialog.querySelector('[name=zoom]');if(![...zoomSelect.options].some(option=>Number(option.value)===settings.zoom))zoomSelect.add(new Option(`${Math.round(settings.zoom*100)}%`,settings.zoom));
    for(const key of ['zoom','records','miniSqlMaxSourceRows','miniSqlMaxIntermediateRows','miniSqlMaxResultRows','miniSqlTimeoutSeconds','defaultChartTheme','defaultSavePath','defaultCanvasSizeMode','defaultCanvasPreset','defaultCanvasWidth','defaultCanvasHeight'])dialog.querySelector(`[name=${key}]`).value=settings[key];
    let restoredColors=false;
    const chartColors=()=>{const name=dialog.querySelector('[name=defaultChartTheme]').value;return restoredColors&&name==='Default'?paletteDefaults.Default:(window.canvasSettingsPalettes||[]).find(item=>item.name===name)?.colors||(name===settings.defaultChartTheme&&settings.defaultChartColors?.length?settings.defaultChartColors:paletteDefaults[name]||paletteDefaults.Default);};
    function updatePreview(){
      const roles=Object.fromEntries([...dialog.querySelectorAll('[data-role]')].map(input=>[input.dataset.role,input.value]));
      const swatches=(colors,names)=>colors.map((color,index)=>{const cell=document.createElement('span');cell.className='settings-preview-swatch';const block=document.createElement('span');block.style.background=color;const caption=document.createElement('small');caption.textContent=names?.[index]?.replace(/([A-Z])/g,' $1')||color;cell.append(block,caption);return cell;});
      const card=dialog.querySelector('.settings-preview-card');card.style.background=roles.surface;card.style.color=roles.text;card.style.borderColor=roles.grid;
      const heading=dialog.querySelector('.settings-preview-heading');heading.style.background=roles.headerBackground;heading.style.color=roles.headerText;heading.style.borderColor=roles.grid;
      for(const name of ['accent','positive','negative'])dialog.querySelector('.settings-preview-'+name).style.color=roles[name];
      dialog.querySelector('.settings-chart-preview').replaceChildren(...swatches(chartColors()));
    }
    dialog.querySelector('.settings-colors').addEventListener('input',updatePreview);
    dialog.querySelector('[name=defaultChartTheme]').addEventListener('change',()=>{restoredColors=false;updatePreview();});
    dialog.querySelector('.settings-restore-colors').onclick=()=>{dialog.querySelectorAll('[data-role]').forEach(input=>input.value=roleDefaults[input.dataset.role]);dialog.querySelector('[name=defaultChartTheme]').value='Default';restoredColors=true;updatePreview();};
    updatePreview();
    dialog.querySelector('.settings-save').onclick=()=>{const form=dialog.querySelector('form');if(!form.reportValidity())return;const values=new FormData(form),next={...settings,zoom:Number(values.get('zoom')),records:Number(values.get('records')),queryShowTabs:form.elements.queryShowTabs.checked,miniSqlMaxSourceRows:Number(values.get('miniSqlMaxSourceRows')),miniSqlMaxIntermediateRows:Number(values.get('miniSqlMaxIntermediateRows')),miniSqlMaxResultRows:Number(values.get('miniSqlMaxResultRows')),miniSqlTimeoutSeconds:Number(values.get('miniSqlTimeoutSeconds')),defaultChartTheme:values.get('defaultChartTheme'),defaultSavePath:values.get('defaultSavePath').trim(),themeRoles:Object.fromEntries([...dialog.querySelectorAll('[data-role]')].map(input=>[input.dataset.role,input.value]))};next.defaultCanvasSizeMode=form.elements.defaultCanvasSizeMode.value;next.defaultCanvasPreset=form.elements.defaultCanvasPreset.value;next.defaultCanvasWidth=Number(form.elements.defaultCanvasWidth.value);next.defaultCanvasHeight=Number(form.elements.defaultCanvasHeight.value);next.defaultChartColors=[...chartColors()];if(host){host.postMessage({type:'saveSharedSettings',settings:next});dialog.querySelector('.settings-save').disabled=true;}else {localStorage.setItem('qreports-shared-settings',JSON.stringify(next));apply(next);dialog.close();}};
    toggleCanvasSizeFields(dialog);
    dialog.addEventListener('close',()=>dialog.remove());document.body.append(dialog);dialog.showModal();
  }
  host?.addEventListener('message',event=>{if(event.data.type==='sharedSettings'){apply(event.data.settings);document.querySelector('#sharedSettingsDialog')?.close();}if(['hostError','error'].includes(event.data.type)){const dialog=document.querySelector('#sharedSettingsDialog');if(dialog){dialog.querySelector('.settings-error').textContent=event.data.message;dialog.querySelector('.settings-save').disabled=false;}}});
  document.addEventListener('DOMContentLoaded',()=>{const style=document.createElement('style');style.textContent='html[data-qreports-theme] body{color:var(--qreports-text)}html[data-qreports-theme] body>header,html[data-qreports-theme] .toolbar{background:var(--qreports-header);color:var(--qreports-header-text)}html[data-qreports-theme] aside{background:var(--qreports-surface)}html[data-qreports-theme] button.primary{background:var(--qreports-accent)}#sharedSettingsDialog{width:min(620px,90vw);max-height:90vh;overflow:auto;border:1px solid #dce3ec;border-radius:14px;padding:20px;color:#182230;background:#f4f7fb}#sharedSettingsDialog::backdrop{background:#14253d66}#sharedSettingsDialog header,#sharedSettingsDialog footer{display:flex;justify-content:space-between;align-items:center;gap:12px;background:transparent;color:inherit;padding:0;height:auto}#sharedSettingsDialog h2{margin:0}#sharedSettingsDialog .settings-group{margin:18px 0;padding:14px;background:#eef3f9;border-radius:9px}#sharedSettingsDialog label{display:block;margin:10px 0;font-size:13px}#sharedSettingsDialog input,#sharedSettingsDialog select{display:block;width:100%;padding:8px;border:1px solid #cdd5df;border-radius:7px;background:white;color:#182230}#sharedSettingsDialog .settings-colors{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px}#sharedSettingsDialog input[type=color]{height:56px;padding:4px;cursor:pointer}#sharedSettingsDialog .settings-group>summary{font-weight:600;cursor:pointer;padding:2px 0}#sharedSettingsDialog .settings-group[open]>summary{margin-bottom:12px}#sharedSettingsDialog .settings-role-swatches,#sharedSettingsDialog .settings-chart-preview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:12px 0}#sharedSettingsDialog .settings-preview-swatch{display:flex;flex-direction:column;gap:4px;text-align:center;font-size:11px;overflow-wrap:anywhere}#sharedSettingsDialog .settings-preview-swatch>span{height:40px;border:1px solid #18223022;border-radius:5px}#sharedSettingsDialog .settings-preview-card{border:1px solid;border-radius:8px;overflow:hidden;margin:14px 0}#sharedSettingsDialog .settings-preview-heading{padding:10px 12px;border-bottom:1px solid;font-weight:600}#sharedSettingsDialog .settings-preview-body{padding:12px}#sharedSettingsDialog .settings-preview-accent{font-size:24px}#sharedSettingsDialog .settings-preview-body p{margin:8px 0}.settings-error{color:#b42318}.settings-save{background:var(--qreports-accent,#4f6ee8);color:white}';document.head.append(style);const button=document.createElement('button');button.type='button';button.dataset.sharedSettings='';button.textContent='⚙ Settings';button.onclick=open;(document.querySelector('.file-actions,.toolbar')||document.querySelector('header'))?.append(button);apply(settings);});
})();
