(()=>{
const editor=$('expression'),highlight=$('expressionHighlight'),box=$('daxAutocomplete');
const functions=[
['SUM','SUM(column)','Adds the values in a column.','SUM(SalesAmount)'],['AVERAGE','AVERAGE(column)','Returns the arithmetic mean.','AVERAGE(Margin)'],['COUNT','COUNT(column)','Counts non-empty values.','COUNT(OrderId)'],['DISTINCTCOUNT','DISTINCTCOUNT(column)','Counts unique non-empty values.','DISTINCTCOUNT(CustomerId)'],['MIN','MIN(column)','Returns the smallest value.','MIN(OrderDate)'],['MAX','MAX(column)','Returns the largest value.','MAX(OrderDate)'],['CALCULATE','CALCULATE(expression, filters…)','Evaluates an expression with modified filters.','CALCULATE(SUM(Sales), Region = "Europe")'],['FILTER','FILTER(table, condition)','Returns rows matching a condition.','FILTER(Sales, Amount > 0)'],['REMOVEFILTERS','REMOVEFILTERS(columns…)','Clears filters from columns.','REMOVEFILTERS(year)'],['IF','IF(condition, true, false)','Returns one of two values.','IF(Margin > 0, "Profit", "Loss")'],['SWITCH','SWITCH(expression, value, result…)','Matches several conditions or values.','SWITCH(TRUE(), Score > 90, "A", "Other")'],['DIVIDE','DIVIDE(numerator, denominator)','Divides safely when denominator is zero.','DIVIDE(Profit, Revenue)'],['FORMAT','FORMAT(value, format)','Formats a value as text.','FORMAT(Sales, "N0")'],['ROUND','ROUND(value, digits)','Rounds a number.','ROUND(Margin, 2)'],['RANK','RANK(value, order, ties)','Ranks the current value.','RANK(Sales, "DESC", "SKIP")'],['DATEOFFSET','DATEOFFSET(date, years, months, days, hours)','Offsets a date.','DATEOFFSET(OrderDate, 0, 1, 0, 0)'],['YEAR','YEAR(date)','Returns the year.','YEAR(OrderDate)'],['MONTH','MONTH(date)','Returns the month number.','MONTH(OrderDate)'],['LEFT','LEFT(text, count)','Returns characters from the left.','LEFT(Code, 3)'],['RIGHT','RIGHT(text, count)','Returns characters from the right.','RIGHT(Code, 2)'],['BLANK','BLANK()','Returns an empty value.','IF(Amount = 0, BLANK(), Amount)']];
const fnNames=new Set(functions.map(x=>x[0])),keywords=new Set(['VAR','RETURN','AND','OR','NOT','TRUE','FALSE','IN']);let items=[],active=0;
const escape=v=>String(v??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
function token(){return editor.value.slice(0,editor.selectionStart).match(/[A-Za-z_][A-Za-z0-9_]*$/)?.[0]||''}
function paint(){const source=editor.value,pattern=/("(?:""|[^"])*"|\b\d+(?:\.\d+)?\b|\b[A-Za-z_][A-Za-z0-9_]*\b)/g;let out='',last=0,m;const columns=new Set((data?.columns||[]).map(columnName));const vars=new Set([...source.matchAll(/\bVAR\s+([A-Za-z_][A-Za-z0-9_]*)/gi)].map(x=>x[1].toUpperCase()));while((m=pattern.exec(source))){out+=escape(source.slice(last,m.index));const value=m[0],upper=value.toUpperCase();let cls=value.startsWith('"')?'dax-string':/^\d/.test(value)?'dax-number':fnNames.has(upper)?'dax-function':keywords.has(upper)?'dax-keyword':vars.has(upper)?'dax-variable':columns.has(value)?'dax-column':'';out+=cls?`<span class="${cls}">${escape(value)}</span>`:escape(value);last=pattern.lastIndex}highlight.innerHTML=out+escape(source.slice(last))+'\n';highlight.scrollTop=editor.scrollTop;highlight.scrollLeft=editor.scrollLeft}
function candidates(prefix=''){const vars=[...editor.value.matchAll(/\bVAR\s+([A-Za-z_][A-Za-z0-9_]*)/gi)].map(x=>({text:x[1],kind:'variable'})),columns=(data?.columns||[]).map(columnName).map(text=>({text,kind:'column'})),metrics=(measures||[]).map(x=>({text:x.Name,kind:+x.Kind===1?'calculated column':'measure'})),fns=functions.map(x=>({text:x[0],insert:x[1].replace(/\w+\)?$/,'').replace(/\($/, '('),kind:'function'}));return [...vars,...columns,...metrics,...fns].filter((x,i,a)=>x.text.toLowerCase().includes(prefix.toLowerCase())&&a.findIndex(y=>y.text.toLowerCase()===x.text.toLowerCase())===i).slice(0,18)}
function positionAutocomplete(){const before=editor.value.slice(0,editor.selectionStart),lines=before.split('\n'),line=lines.at(-1).replace(/\t/g,'    '),style=getComputedStyle(editor),canvas=positionAutocomplete.canvas||(positionAutocomplete.canvas=document.createElement('canvas')),context=canvas.getContext('2d'),lineHeight=parseFloat(style.lineHeight)||22,paddingLeft=parseFloat(style.paddingLeft)||12,paddingTop=parseFloat(style.paddingTop)||12;context.font=style.font;let left=paddingLeft+context.measureText(line).width-editor.scrollLeft+8,top=paddingTop+lines.length*lineHeight-editor.scrollTop+3;left=Math.max(8,Math.min(editor.clientWidth-box.offsetWidth-8,left));top=Math.max(8,Math.min(editor.clientHeight-10,top));box.style.left=`${left}px`;box.style.top=`${top}px`}
function show(force=false){const prefix=token();if(!force&&prefix.length<1){box.classList.add('hidden');return}items=candidates(force?'':prefix);active=0;box.innerHTML=items.map((x,i)=>`<button class="${i?'':'active'}" data-dax-complete="${i}"><span>${escape(x.text)}</span><small>${x.kind}</small></button>`).join('');box.classList.toggle('hidden',!items.length);box.querySelectorAll('button').forEach(b=>b.onmousedown=e=>{e.preventDefault();accept(+b.dataset.daxComplete)});if(items.length)requestAnimationFrame(positionAutocomplete)}
function accept(index=active){const item=items[index];if(!item)return;const end=editor.selectionStart,start=end-token().length,text=item.kind==='function'?`${item.text}(`:item.text;editor.setRangeText(text,start,end,'end');box.classList.add('hidden');editor.focus();paint()}
function move(delta){active=(active+delta+items.length)%items.length;box.querySelectorAll('button').forEach((b,i)=>b.classList.toggle('active',i===active))}
function indentSelection(outdent=false){const text=editor.value,start=editor.selectionStart,end=editor.selectionEnd,lineStart=text.lastIndexOf('\n',Math.max(0,start-1))+1;if(start===end&&!outdent){editor.setRangeText('\t',start,end,'end');paint();box.classList.add('hidden');return}const block=text.slice(lineStart,end),lines=block.split('\n');let removedBeforeStart=0,totalRemoved=0;const changed=lines.map((line,index)=>{if(!outdent)return`\t${line}`;const match=line.match(/^(\t| {1,4})/),count=match?.[0].length||0;if(index===0)removedBeforeStart=count;totalRemoved+=count;return line.slice(count)}).join('\n');editor.setRangeText(changed,lineStart,end,'start');if(outdent){editor.selectionStart=Math.max(lineStart,start-removedBeforeStart);editor.selectionEnd=Math.max(editor.selectionStart,end-totalRemoved)}else{editor.selectionStart=start+1;editor.selectionEnd=end+lines.length}paint();box.classList.add('hidden')}
editor.addEventListener('input',()=>{paint();show()});editor.addEventListener('scroll',()=>{paint();if(!box.classList.contains('hidden'))positionAutocomplete()});editor.addEventListener('keydown',e=>{if(e.ctrlKey&&e.code==='Space'){e.preventDefault();show(true)}else if(!box.classList.contains('hidden')&&e.key==='ArrowDown'){e.preventDefault();move(1)}else if(!box.classList.contains('hidden')&&e.key==='ArrowUp'){e.preventDefault();move(-1)}else if(!box.classList.contains('hidden')&&(e.key==='Tab'||e.key==='Enter')&&!e.shiftKey){e.preventDefault();accept()}else if(e.key==='Tab'){e.preventDefault();indentSelection(e.shiftKey)}else if(e.key==='Escape')box.classList.add('hidden')});
const pane=$('daxFunctionsPane'),search=$('daxFunctionSearch');function renderHelp(){const q=search.value.toLowerCase();$('daxFunctionList').innerHTML=functions.filter(x=>x.join(' ').toLowerCase().includes(q)).map((x,i)=>`<div class="dax-function-card" data-help-function="${i}"><b>${x[0]}</b><code>${escape(x[1])}</code><p>${escape(x[2])}</p><small>Example: ${escape(x[3])}</small></div>`).join('');pane.querySelectorAll('[data-help-function]').forEach(card=>card.onclick=()=>{const item=functions[+card.dataset.helpFunction];const pos=editor.selectionStart;editor.setRangeText(item[0]+'(',pos,editor.selectionEnd,'end');editor.focus();paint()})}
$('showDaxFunctions').onclick=()=>{const open=$('layout').classList.toggle('functions-open');if(open)renderHelp()};$('closeDaxFunctions').onclick=()=>$('layout').classList.remove('functions-open');search.oninput=renderHelp;
const functionSplitter=$('daxFunctionsSplitter');functionSplitter.onpointerdown=event=>{event.preventDefault();const layout=$('layout'),startX=event.clientX,start=parseFloat(getComputedStyle(layout).getPropertyValue('--functions'))||380;functionSplitter.setPointerCapture(event.pointerId);functionSplitter.onpointermove=move=>layout.style.setProperty('--functions',`${Math.max(260,Math.min(650,start-(move.clientX-startX)))}px`);functionSplitter.onpointerup=()=>functionSplitter.onpointermove=null};
new MutationObserver(paint).observe($('measureList'),{childList:true,subtree:true});paint();
})();
