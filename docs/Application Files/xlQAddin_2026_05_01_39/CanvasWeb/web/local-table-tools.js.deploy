// Import tools use literal search text; filters never evaluate JavaScript expressions.
const LocalTableTools={
 matches(value,rule){const text=String(value??''),needle=String(rule.value??''),a=rule.caseSensitive?text:text.toLowerCase(),b=rule.caseSensitive?needle:needle.toLowerCase();if(rule.operator==='empty')return value==null||text==='';if(rule.operator==='notempty')return value!=null&&text!=='';if(rule.operator==='contains')return a.includes(b);if(rule.operator==='starts')return a.startsWith(b);if(rule.operator==='ends')return a.endsWith(b);if(rule.operator==='eq')return a===b;if(rule.operator==='ne')return a!==b;if(value==null||text==='')return false;const numeric=/Integer|Decimal|Number/i.test(rule.type||''),date=/Date/i.test(rule.type||''),left=numeric?Number(text.replace(',','.')):date?Date.parse(text):a,right=numeric?Number(needle.replace(',','.')):date?Date.parse(needle):b;if((numeric||date)&&(!Number.isFinite(left)||!Number.isFinite(right)))throw new Error('Enter a valid '+(date?'date':'number')+' for the filter.');return rule.operator==='gt'?left>right:rule.operator==='ge'?left>=right:rule.operator==='lt'?left<right:left<=right;},
 replace(value,search,replacement,caseSensitive){if(value==null||!search)return value;const escaped=search.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');return String(value).replace(new RegExp(escaped,caseSensitive?'g':'gi'),()=>replacement);}
};
let localModeState=null,localChosenMode='Manual';
const localModeNames={Manual:'Manual',DelimitedFile:'CSV / Text',ExcelFile:'Excel',HttpFile:'Web'};
const ensureLocalModeBase=ensureLocalDataDialog;
ensureLocalDataDialog=function(){ensureLocalModeBase();const modal=$('localDataModal');if(modal.querySelector('.local-mode-selector'))return;const tabs=document.createElement('div');tabs.className='local-mode-selector';tabs.setAttribute('role','group');tabs.setAttribute('aria-label','Import mode');Object.entries(localModeNames).forEach(([mode,name])=>{const button=document.createElement('button');button.type='button';button.textContent=name;button.dataset.importMode=mode;button.onclick=()=>{localChosenMode=mode;renderLocalModes();};tabs.append(button);});modal.querySelector('.filter-head').after(tabs);const bar=modal.querySelector('.local-actions');for(const kind of ['filter','replace']){const button=document.createElement('button');button.type='button';button.dataset.localTransform=kind;button.textContent=kind==='filter'?'Filter…':'Replace…';button.onclick=()=>localTransformDialog(kind);bar.append(button);}const gridButton=document.createElement('button');gridButton.type='button';gridButton.dataset.manualGrid='';gridButton.textContent='Save and edit in query grid';gridButton.onclick=async()=>{try{await saveLocalData();await openManualQueryGrid(localState.name);}catch(error){$('localError').textContent=error.message;}};modal.querySelector('.dialog-actions').prepend(gridButton);};
function renderLocalModes(){const modal=$('localDataModal');if(!modal)return;if(localModeState!==localState){localModeState=localState;localChosenMode=localState.sourceMode in localModeNames?localState.sourceMode:'Manual';}modal.querySelectorAll('[data-import-mode]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.importMode===localChosenMode)));const manual=localChosenMode==='Manual';$('localPaste').hidden=!manual;$('localHasHeaders').closest('label').hidden=!manual;for(const [action,mode] of [['parse','Manual'],['import','DelimitedFile'],['importExcel','ExcelFile']])modal.querySelector('[data-local-action='+action+']').hidden=localChosenMode!==mode;const web=modal.querySelector('[data-import-url]');if(web)web.hidden=localChosenMode!=='HttpFile';modal.querySelectorAll('[data-local-transform]').forEach(button=>button.hidden=manual);modal.querySelector('[data-manual-grid]').hidden=localState.sourceMode!=='Manual';}
const renderLocalModeGridBase=renderLocalGrid;
renderLocalGrid=function(...args){renderLocalModeGridBase(...args);renderLocalModes();};
const useManualPasteBase=useLocalPaste;
useLocalPaste=function(){if(!parseDelimitedText($('localPaste').value).length)return;localState.sourceMode='Manual';localState.sourcePath='';localState.sourceObjectKind='';localState.sourceObjectName='';localState.importSteps=[];localSteps=[];useManualPasteBase();renderLocalModes();};
function localTransformDialog(kind,viewOnly=false){
 const columns=viewOnly?resultView.data.columns.map((column,index)=>({name:resultColumnName(column),type:editState.localDefinition.Columns[index].DataType})):localState.columns;
 const modal=document.createElement('div');modal.className='modal';modal.innerHTML=`<div class="dialog local-transform-dialog"><div class="filter-head"><h2>${kind==='filter'?'Filter rows':'Replace values'}</h2><button data-transform-close>×</button></div><p class="muted">${viewOnly?'Filters only the displayed rows. Saving keeps every other row.':kind==='filter'?'Keep matching rows in the imported table.':'Replace matching text in the selected column.'}</p><label>Column<select data-transform-column>${columns.map((column,index)=>`<option value="${index}">${esc(column.name)}</option>`).join('')}</select></label>${kind==='filter'?'<label>Condition<select data-transform-operator><option value="eq">Equals</option><option value="ne">Does not equal</option><option value="gt">Greater than</option><option value="ge">Greater than or equal</option><option value="lt">Less than</option><option value="le">Less than or equal</option><option value="contains">Contains</option><option value="starts">Starts with</option><option value="ends">Ends with</option><option value="empty">Is empty</option><option value="notempty">Is not empty</option></select></label>':''}<label>${kind==='filter'?'Value':'Search for'}<input data-transform-value></label>${kind==='replace'?'<label>Replace with<input data-transform-replacement></label>':''}<label class="check"><input type="checkbox" data-transform-case> Match case</label><p data-transform-error class="pw-error"></p><div class="dialog-actions"><button data-transform-close>Cancel</button>${viewOnly?'<button data-transform-clear>Clear filter</button>':''}<button class="apply" data-transform-apply>Apply</button></div></div>`;document.body.append(modal);modal.querySelectorAll('[data-transform-close]').forEach(button=>button.onclick=()=>modal.remove());modal.querySelector('[data-transform-clear]')?.addEventListener('click',()=>{delete editState.viewFilter;renderResult(resultView.data,true,'Editable: local.'+editState.tableName);modal.remove();});modal.querySelector('[data-transform-apply]').onclick=()=>{try{const index=Number(modal.querySelector('[data-transform-column]').value),rule={column:index,sourceName:columns[index].sourceName||columns[index].name,type:columns[index].type,operator:modal.querySelector('[data-transform-operator]')?.value,value:modal.querySelector('[data-transform-value]').value,caseSensitive:modal.querySelector('[data-transform-case]').checked};
 if(viewOnly){resultView.data.rows.forEach(row=>LocalTableTools.matches(row[index],rule));editState.viewFilter=rule;renderResult(resultView.data,true,'Editable: local.'+editState.tableName);}
 else{const before={rows:structuredClone(localState.rows),indices:[...(localState.sourceRowIndices||[])],excluded:[...(localState.excludedSourceRows||[])]};if(kind==='filter'){const keep=localState.rows.map((row,index)=>({row,index})).filter(entry=>LocalTableTools.matches(entry.row[rule.column],rule));localState.rows=keep.map(entry=>entry.row);localState.sourceRowIndices=keep.map(entry=>before.indices[entry.index]);}else{if(!rule.value)throw new Error('Enter search text.');rule.replacement=modal.querySelector('[data-transform-replacement]').value;localState.rows=localState.rows.map(row=>row.map((value,column)=>column===index?LocalTableTools.replace(value,rule.value,rule.replacement,rule.caseSensitive):value));}addLocalStep((kind==='filter'?'Filter ':'Replace ')+columns[index].name,'',{kind,...rule,before});localState.importSteps=structuredClone(localSteps);renderLocalGrid();}modal.remove();}catch(error){modal.querySelector('[data-transform-error]').textContent=error.message;}};
}
const removeTransformStepBase=removeLocalStep;
removeLocalStep=function(index){const step=localSteps[index];if(!['filter','replace'].includes(step?.kind))return removeTransformStepBase(index);if(index!==localSteps.length-1)return toast('Remove later steps first to undo this transformation.');localState.rows=structuredClone(step.before.rows);localState.sourceRowIndices=[...step.before.indices];localState.excludedSourceRows=[...step.before.excluded];localSteps.splice(index,1);localState.importSteps=structuredClone(localSteps);renderLocalGrid();};
async function openManualQueryGrid(name,requestedQuery=''){try{if(hasEdits())throw new Error('Save or revert the current edits first.');const table=tables.find(table=>qualifiedName(table).toLowerCase()===name.toLowerCase()||table.name.toLowerCase()===name.toLowerCase());const filterQuery=requestedQuery||(table?'SELECT * FROM '+aliasedTable({...table,schema:''})+filterClause(table):'');const loaded=await call('localTableLoad',{name:table?.name||name,filterQuery,query:{parameters:query.parameters||[]}}),definition=loaded.definition;if(definition.SourceMode!=='Manual')throw new Error('Convert this source to Manual before editing in the query grid.');$('connection').value='local';query.connectionName='local';replaceSql(filterQuery||'SELECT * FROM '+sqlColumn(definition.Name));editState={paneFilterQuery:filterQuery,paneVisibleRows:loaded.visibleRows?new Set(loaded.visibleRows):null,localDefinition:definition,connectionName:'local',schemaName:'local',tableName:definition.Name,columns:definition.Columns.map(column=>({name:column.Name,dbType:column.DataType==='Boolean'?'bit':column.DataType==='Integer'?'bigint':column.DataType==='Decimal'?'decimal':column.DataType==='DateTime'?'datetime':'text',nullable:column.AllowNull,readOnly:false})),originalRows:structuredClone(loaded.data.rows),rowStates:loaded.data.rows.map(row=>definition.Columns.some((column,index)=>column.DataType==='Boolean'&&row[index]==null)?'update':'clean')};loaded.data.rows.forEach(row=>definition.Columns.forEach((column,index)=>{if(column.DataType==='Boolean'&&row[index]==null)row[index]=false;}));resultMode='grid';renderResult(loaded.data,false,'Editable: local.'+definition.Name);$('queryStatus').textContent='Editing manual table';const actions=$('editActions');if(!actions.querySelector('[data-manual-filter]')){const filter=document.createElement('button');filter.dataset.manualFilter='';filter.textContent='Filter…';filter.onclick=()=>localTransformDialog('filter',true);actions.append(filter);}}catch(error){showResultError(error,'Could not edit manual table');}}
async function saveManualQueryGrid(){if(!hasEdits())return;try{const definition=editState.localDefinition,data={...resultView.data,rows:resultView.data.rows.filter((_,index)=>editState.rowStates[index]!=='delete').map(row=>row.map((value,index)=>definition.Columns?.[index]?.DataType==='Boolean'&&value==null?false:value))};const saved=await call('localManualSave',{name:definition.Name,id:definition.Id,updatedUtc:definition.UpdatedUtc,data});if(editState.paneFilterQuery){const filtered=await call('localTableLoad',{name:definition.Name,filterQuery:editState.paneFilterQuery,query:{parameters:query.parameters||[]}});editState.paneVisibleRows=new Set(filtered.visibleRows);}editState.localDefinition=saved.definition;editState.originalRows=structuredClone(saved.data.rows);editState.rowStates=saved.data.rows.map(()=>'clean');query.data=saved.data;renderResult(saved.data,true,'Editable: local.'+definition.Name);toast('Manual table saved');await loadSchema();}catch(error){showResultError(error,'Could not save manual table');}}
const updateManualEditActionsBase=updateEditActions;
updateEditActions=function(){updateManualEditActionsBase();$('editActions').querySelector('[data-manual-filter]')?.classList.toggle('hidden',!editState?.localDefinition);};
const showLocalManualMenuBase=showLocalTableMenu;
showLocalTableMenu=function(event,table){showLocalManualMenuBase(event,table);const menu=$('contextMenu'),mode=String(table.sourceMode||table.type||'').toLowerCase(),button=document.createElement('button');button.textContent=mode==='manual'?'Edit in query grid':'Convert to manual table';button.onclick=async()=>{hideContextMenu();if(mode==='manual')return openManualQueryGrid(table.name);if(!confirm("Convert '"+table.name+"' to Manual? The cached data will stay, and its source query/import link will be removed."))return;try{await call('localTableConvertManual',{name:table.name});await loadSchema();toast(table.name+' is now a manual table');}catch(error){showResultError(error,'Could not convert table');}};menu.append(button);};

const exitManualGridBase=exitEditable;
exitEditable=function(render=true){if(editState?.localDefinition)query.data={...resultView.data,rows:structuredClone(editState.originalRows.filter(Boolean))};exitManualGridBase(render);};
