(() => {
  const clone = value => structuredClone(value || []);
  const get = (object, name, fallback = "") => object?.[name] ?? object?.[name[0].toLowerCase() + name.slice(1)] ?? fallback;
  const esc = value => { const node = document.createElement("div"); node.textContent = value ?? ""; return node.innerHTML; };
  const kinds = ["Text", "Manual list", "SQL list", "Date picker", "Number"];
  const defaults = () => ({ Name:"Parameter", DisplayName:"", Description:"", DefaultValue:"", CurrentValue:"", CurrentDisplayValue:"", CurrentValues:[], CurrentDisplayValues:[], IsCalculated:false, CalculationExpression:"", UserInput:true, DisplayOrder:-1, InputKind:0, TextMode:0, ManualListText:"", LookupConnectionName:"", LookupQueryText:"", ValueColumn:"codevalue", DisplayColumn:"description", UseTreeView:false, TreeLevelColumns:"", ListControlHeight:104, ExpandHeight:false, AllowBlank:false, MultiSelect:false, MultiValueSeparator:",", MultiValuePrefix:"'", MultiValueSuffix:"'", ValuePrefix:"", ValueSuffix:"", NoneValue:"1=1", NoneCaption:"(None)", NoneSelected:false, SheetScopes:[], DateFormat:"yyyy-MM-dd", NumericFormat:"0.##", NumericIncrement:1, NumericMinimum:0, NumericMaximum:100 });
  const normalize = (parameter, index) => { const result={...defaults(),...clone(parameter)}; Object.keys(defaults()).forEach(key=>result[key]=get(parameter,key,result[key])); result.DisplayOrder=Number(get(parameter,"DisplayOrder",index)); return result; };
  const close = overlay => overlay?.remove();
  const button = (label, cls = "") => `<button type="button" class="${cls}">${label}</button>`;
  const shell = (title, subtitle, bodyClass = "pw-body", dialogClass = "") => {
    const overlay = document.createElement("div"); overlay.className = "pw-overlay";
    overlay.innerHTML = `<section class="pw-dialog ${dialogClass}"><header class="pw-head"><div><h2>${esc(title)}</h2><p>${esc(subtitle)}</p></div><button type="button" class="pw-close" aria-label="Close">×</button></header><div class="${bodyClass}"></div><footer class="pw-foot"></footer></section>`;
    document.body.append(overlay); overlay.querySelector(".pw-close").onclick = () => close(overlay);
    overlay.addEventListener("mousedown", event => { if (event.target === overlay) close(overlay); });
    return overlay;
  };
  const parseManual = text => {
    const result = [];
    String(text || "").replace(/\r/g, "").split(/\n|,(?![^>]*>)/).forEach(line => {
      line.split(";").forEach(raw => { const leaf = raw.trim().split(">").pop().trim(); if (!leaf) return; const at = leaf.indexOf("="); result.push({ value:(at > 0 ? leaf.slice(0,at) : leaf).trim().replace(/^"|"$/g,""), display:(at > 0 ? leaf.slice(at+1) : leaf).trim().replace(/^"|"$/g,"") }); });
    }); return result;
  };
  const displayName = p => get(p,"DisplayName") || get(p,"Name") || "Parameter";
  function evaluateCalculated(items){const values=new Map(items.filter(p=>!p.IsCalculated).map(p=>[String(p.Name).toLowerCase(),String(p.CurrentValue||p.CurrentValues?.[0]||p.DefaultValue||"")]));for(let pass=0;pass<items.length;pass++){let changed=false;for(const p of items.filter(x=>x.IsCalculated&&String(x.CalculationExpression||"").trim())){let expression=String(p.CalculationExpression).replace(/{{\s*([a-z_]\w*)\s*}}/gi,(_,n)=>values.get(n.toLowerCase())??n).replace(/\b([a-z_]\w*)\b/gi,(word)=>/^(previousyear|previousperiod|addmonths)$/i.test(word)?word:(values.get(word.toLowerCase())??word));for(let guard=0;guard<16;guard++){const match=/\b(PREVIOUSYEAR|PREVIOUSPERIOD|ADDMONTHS)\s*\(([^()]*)\)/i.exec(expression);if(!match)break;const args=match[2].split(',').map(Number),period=args[0],year=Math.trunc(period/100),month=period%100;if(!Number.isInteger(period)||month<1||month>12)break;const offset=/previousyear/i.test(match[1])?-12:/previousperiod/i.test(match[1])?-1:args[1];const date=new Date(Date.UTC(year,month-1+offset,1)),replacement=String(date.getUTCFullYear()*100+date.getUTCMonth()+1);expression=expression.slice(0,match.index)+replacement+expression.slice(match.index+match[0].length);}if(!/^[\d+\-*/().\s]+$/.test(expression))continue;let value;try{value=Function(`"use strict";return (${expression})`)();}catch{continue;}if(!Number.isFinite(value))continue;const result=String(value);if(values.get(String(p.Name).toLowerCase())!==result)changed=true;values.set(String(p.Name).toLowerCase(),result);p.CurrentValue=p.CurrentDisplayValue=result;p.CurrentValues=p.CurrentDisplayValues=[result];}if(!changed)break;}return items;}

  function evaluateCalculated(items) {
    const values=new Map(items.filter(p=>!p.IsCalculated).map(p=>[String(p.Name).toLowerCase(),String(p.CurrentValue||p.CurrentValues?.[0]||p.DefaultValue||"")]));
    const functionName=/^(previousyear|previousperiod|addmonths|today|month|year|left|right)$/i;
    const trimArg=value=>String(value??"").trim().replace(/^("([\s\S]*)"|'([\s\S]*)')$/,(_,all,double,single)=>double??single??"");
    const dateParts=value=>{const text=trimArg(value),compact=/^(\d{4})(\d{2})(?:\d{2})?$/.exec(text);if(compact)return{year:+compact[1],month:+compact[2]};const date=new Date(text);return Number.isNaN(date.valueOf())?null:{year:date.getFullYear(),month:date.getMonth()+1};};
    for(let pass=0;pass<items.length;pass++){let changed=false;for(const p of items.filter(x=>x.IsCalculated&&String(x.CalculationExpression||"").trim())){let expression=String(p.CalculationExpression).replace(/{{\s*([a-z_]\w*)\s*}}/gi,(_,n)=>values.get(n.toLowerCase())??n).replace(/\b([a-z_]\w*)\b/gi,word=>functionName.test(word)?word:(values.get(word.toLowerCase())??word)),valid=true;
      for(let guard=0;guard<16;guard++){const match=/\b(PREVIOUSYEAR|PREVIOUSPERIOD|ADDMONTHS|TODAY|MONTH|YEAR|LEFT|RIGHT)\s*\(([^()]*)\)/i.exec(expression);if(!match)break;const name=match[1].toUpperCase(),args=match[2].split(',').map(trimArg);let replacement;
        if(name==='TODAY'){if(args.length!==1||args[0]!==""){valid=false;break;}const d=new Date();replacement=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
        else if(name==='LEFT'||name==='RIGHT'){const length=Number(args[1]);if(args.length!==2||!Number.isInteger(length)||length<0){valid=false;break;}replacement=name==='LEFT'?args[0].slice(0,length):args[0].slice(-length);}
        else if(name==='YEAR'||name==='MONTH'){const date=dateParts(args[0]);if(args.length!==1||!date||date.month<1||date.month>12){valid=false;break;}replacement=String(name==='YEAR'?date.year:date.month);}
        else{const period=Number(args[0]),year=Math.trunc(period/100),month=period%100;if(!Number.isInteger(period)||month<1||month>12){valid=false;break;}const offset=name==='PREVIOUSYEAR'?-12:name==='PREVIOUSPERIOD'?-1:Number(args[1]);if(!Number.isInteger(offset)){valid=false;break;}const date=new Date(Date.UTC(year,month-1+offset,1));replacement=String(date.getUTCFullYear()*100+date.getUTCMonth()+1);}
        expression=expression.slice(0,match.index)+replacement+expression.slice(match.index+match[0].length);}
      if(!valid)continue;let result;if(/^[\d+\-*/().\s]+$/.test(expression)){try{const value=Function(`"use strict";return (${expression})`)();if(!Number.isFinite(value))continue;result=String(value);}catch{continue;}}else result=trimArg(expression);if(!result)continue;const key=String(p.Name).toLowerCase();if(values.get(key)!==result)changed=true;values.set(key,result);p.CurrentValue=p.CurrentDisplayValue=result;p.CurrentValues=p.CurrentDisplayValues=[result];}if(!changed)break;}return items;
  }

  function calculationFailureHint(expression,items){
    const text=String(expression||'').trim();if(!text)return'Enter a calculation expression first.';
    if(/\/\s*0(?:\D|$)/.test(text))return'Division by zero is not allowed. Check the divisor parameter or enter a non-zero value.';
    if((text.match(/\(/g)||[]).length!==(text.match(/\)/g)||[]).length)return'Check the parentheses: every opening parenthesis needs a closing parenthesis.';
    const supported=new Set(['previousyear','previousperiod','addmonths','today','month','year','left','right']),known=new Set((items||[]).map(p=>String(p.Name||'').toLowerCase()));
    const cleaned=text.replace(/(['"])[\s\S]*?\1/g,'').replace(/{{\s*([a-z_]\w*)\s*}}/gi,'$1'),unknown=[...new Set((cleaned.match(/\b[a-z_]\w*\b/gi)||[]).map(x=>x.toLowerCase()).filter(x=>!known.has(x)&&!supported.has(x)))];
    if(unknown.length)return`Unknown parameter or function: ${unknown.join(', ')}. Check the spelling or create the missing parameter.`;
    if(/\b(previousyear|previousperiod|addmonths)\s*\(/i.test(text))return'Period functions require a YYYYMM value such as 202601. ADDMONTHS also needs a month offset.';
    if(/\b(month|year)\s*\(/i.test(text))return'MONTH and YEAR require a valid date or a YYYYMM/YYYMMDD value.';
    if(/\b(left|right)\s*\(/i.test(text))return'LEFT and RIGHT need a value and a non-negative length, for example LEFT(period, 4).';
    return'Check that every referenced parameter has a current value and that only supported functions and operators are used.';
  }

  function openManager(options = {}) {
    let items = clone(options.parameters).map(normalize), selected = Math.max(0, items.length ? 0 : -1), dragIndex = -1;
    const overlay = shell("Parameter manager", "Define reusable inputs for queries, cards, and report text.");
    const body = overlay.querySelector(".pw-body"), foot = overlay.querySelector(".pw-foot");
    body.innerHTML = `<aside class="pw-sidebar"><div class="pw-tools">${button("+ Add","pw-primary")}${button("Duplicate")}${button("Delete","pw-danger")}</div><div class="pw-list"></div></aside><section class="pw-properties"></section>`;
    foot.innerHTML = `<span class="pw-error"></span><span class="spacer"></span>${button("Cancel")}${button("Save parameters","pw-primary")}`;
    const [add, duplicate, remove] = body.querySelectorAll(".pw-tools button"), [cancel, save] = foot.querySelectorAll("button");
    cancel.onclick = () => { close(overlay); options.onCancel?.(); };
    overlay.querySelector(".pw-close").onclick = () => { close(overlay); options.onCancel?.(); };
    add.onclick = () => { const p = defaults(); p.Name = uniqueName(items,"Parameter"); items.push(p); selected = items.length - 1; render(); };
    duplicate.onclick = () => { if (selected < 0) return; const p = clone(items[selected]); p.Name = uniqueName(items,`${p.Name || "Parameter"}_copy`); p.DisplayName = p.DisplayName ? `${p.DisplayName} copy` : ""; items.splice(selected + 1,0,p); selected++; render(); };
    remove.onclick = () => { if (selected < 0) return; items.splice(selected,1); selected = Math.min(selected,items.length-1); render(); };
    save.onclick = () => { readForm(); items.forEach(p=>{if(p.IsCalculated)p.UserInput=false;}); evaluateCalculated(items); const error = validate(items); foot.querySelector(".pw-error").textContent = error; if (error) return; items.forEach((p,i) => p.DisplayOrder=i); options.onSave?.(clone(items)); close(overlay); };

    function uniqueName(list, base) { let name=base, n=2; while(list.some(p=>String(p.Name).toLowerCase()===name.toLowerCase())) name=`${base}${n++}`; return name; }
    function validate(list) { const names=new Set(); for (const p of list) { if (!String(p.Name||"").trim()) return "Every parameter needs a name."; const key=p.Name.trim().toLowerCase(); if(names.has(key)) return `Duplicate parameter name: ${p.Name}`; names.add(key); if(p.IsCalculated&&!String(p.CalculationExpression||"").trim())return `${p.Name}: enter a calculation expression.`;if(Number(p.NumericMinimum)>Number(p.NumericMaximum)) return `${p.Name}: minimum must not exceed maximum.`; if(Number(p.NumericIncrement)<=0) return `${p.Name}: increment must be greater than zero.`; } return ""; }
    function readForm() { if(selected<0) return; const form=body.querySelector(".pw-properties form"); if(!form?.elements) return; const p=items[selected]; [...form.elements].forEach(input => { const key=input.dataset.key; if(!key) return; if(input.type==="checkbox") p[key]=input.checked; else if(input.type==="number") p[key]=Number(input.value); else if(key==="InputKind"||key==="TextMode") p[key]=Number(input.value); else if(key==="SheetScopes") p[key]=input.value.split(/[,;\n]/).map(x=>x.trim()).filter(Boolean); else p[key]=input.value; }); }
    function renderList() { const list=body.querySelector(".pw-list"); list.innerHTML=items.map((p,i)=>`<div class="pw-item ${i===selected?"active":""}" draggable="true" data-index="${i}"><span class="pw-grip">☷</span><span><b>${esc(displayName(p))}</b><small>{{${esc(p.Name)}}} · ${p.IsCalculated?"Calculated":(kinds[Number(p.InputKind)]||"Text")}</small></span><span class="pw-user-dot ${p.UserInput&&!p.IsCalculated?"required":""}" title="${p.UserInput&&!p.IsCalculated?"User input required":"No user input"}"></span></div>`).join("") || `<div class="pw-empty">No parameters yet.</div>`;
      list.querySelectorAll(".pw-item").forEach(row => { row.onclick=()=>{readForm();selected=Number(row.dataset.index);render();}; row.ondragstart=()=>dragIndex=Number(row.dataset.index); row.ondragover=e=>e.preventDefault(); row.ondrop=e=>{e.preventDefault();const target=Number(row.dataset.index);if(dragIndex<0||target===dragIndex)return;readForm();const [moved]=items.splice(dragIndex,1);items.splice(target,0,moved);selected=target;dragIndex=-1;render();}; });
    }
    function renderProperties() { const area=body.querySelector(".pw-properties"); if(selected<0){area.innerHTML=`<div class="pw-empty">Add a parameter to begin.</div>`;return;} const p=items[selected], kind=Number(p.InputKind);
      area.innerHTML=`<form><section class="pw-section"><h3>General</h3><div class="pw-grid"><label>Name<input data-key="Name" value="${esc(p.Name)}"></label><label>Display name<input data-key="DisplayName" value="${esc(p.DisplayName)}" placeholder="Uses name when blank"></label><label>Type<select data-key="InputKind">${kinds.map((x,i)=>`<option value="${i}" ${kind===i?"selected":""}>${x}</option>`).join("")}</select></label><label class="wide">Description<textarea data-key="Description" rows="2">${esc(p.Description)}</textarea></label><label>Default value<input data-key="DefaultValue" value="${esc(p.DefaultValue)}"></label><label>Current value<input data-key="CurrentValue" value="${esc(p.CurrentValue)}" ${p.IsCalculated?"readonly":""}></label><label class="pw-check wide"><input type="checkbox" data-key="UserInput" ${p.UserInput&&!p.IsCalculated?"checked":""}> Ask the user for this parameter</label><label class="pw-check wide"><input type="checkbox" data-key="IsCalculated" ${p.IsCalculated?"checked":""}> Calculate this parameter in QReports</label><label class="pw-check"><input type="checkbox" data-key="AllowBlank" ${p.AllowBlank?"checked":""}> Allow a blank value</label></div></section>
      <details class="pw-section pw-collapsible"><summary>Input control and scope</summary><div class="pw-grid"><label>Text replacement<select data-key="TextMode"><option value="0" ${p.TextMode==0?"selected":""}>Raw text</option><option value="1" ${p.TextMode==1?"selected":""}>SQL string</option><option value="2" ${p.TextMode==2?"selected":""}>DAX string</option></select></label>${kind===3?`<label>Date format<input data-key="DateFormat" value="${esc(p.DateFormat)}"></label>`:""}${kind===4?`<label>Number format<input data-key="NumericFormat" value="${esc(p.NumericFormat)}"></label><label>Minimum<input type="number" data-key="NumericMinimum" value="${p.NumericMinimum}"></label><label>Maximum<input type="number" data-key="NumericMaximum" value="${p.NumericMaximum}"></label><label>Step<input type="number" data-key="NumericIncrement" value="${p.NumericIncrement}"></label>`:""}<label class="wide">Worksheet scopes<div class="pw-input-button"><input data-key="SheetScopes" value="${esc((p.SheetScopes||[]).join(", "))}" placeholder="Blank means every sheet"><button type="button" data-pick-scopes>Choose…</button></div></label></div></details>
      ${p.IsCalculated?`<details class="pw-section pw-collapsible" open><summary>Calculation</summary><div class="pw-grid"><label class="wide">Expression<input data-key="CalculationExpression" value="${esc(p.CalculationExpression)}" placeholder="PREVIOUSPERIOD(periodfrom)"></label><p class="pw-help wide">Examples: periodfrom - 100, PREVIOUSYEAR(periodfrom), PREVIOUSPERIOD(periodfrom), ADDMONTHS(periodfrom, -12). Calculated parameters do not depend on Excel formulas.</p></div></details>`:""}
      ${(kind===1||kind===2)?`<details class="pw-section pw-collapsible"><summary>${kind===1?"List values":"SQL lookup"}</summary><div class="pw-grid">${kind===1?`<label class="wide">Items <textarea data-key="ManualListText" rows="5" placeholder="NO=Norway, SE=Sweden">${esc(p.ManualListText)}</textarea></label>`:`<label>Connection<input data-key="LookupConnectionName" value="${esc(p.LookupConnectionName)}"></label><label>Value column<input data-key="ValueColumn" value="${esc(p.ValueColumn)}"></label><label>Display column<input data-key="DisplayColumn" value="${esc(p.DisplayColumn)}"></label><label>Tree-level columns<input data-key="TreeLevelColumns" value="${esc(p.TreeLevelColumns)}"></label><label class="wide">Lookup query<textarea data-key="LookupQueryText" rows="6">${esc(p.LookupQueryText)}</textarea></label><div class="wide"><button type="button" data-design-lookup>Design lookup query in Query Web</button></div><label class="pw-check"><input type="checkbox" data-key="UseTreeView" ${p.UseTreeView?"checked":""}> Hierarchical tree</label>`}<label class="pw-check"><input type="checkbox" data-key="MultiSelect" ${p.MultiSelect?"checked":""}> Allow multiple selections</label><label class="pw-check"><input type="checkbox" data-key="NoneSelected" ${p.NoneSelected?"checked":""}> Select None initially</label><label>None caption<input data-key="NoneCaption" value="${esc(p.NoneCaption)}"></label><label>None value<input data-key="NoneValue" value="${esc(p.NoneValue)}"></label></div></details>`:""}
      <details class="pw-section pw-collapsible"><summary>Formatting</summary><div class="pw-grid"><label>Value prefix<input data-key="ValuePrefix" value="${esc(p.ValuePrefix)}"></label><label>Value suffix<input data-key="ValueSuffix" value="${esc(p.ValueSuffix)}"></label><label>Multi-value separator<input data-key="MultiValueSeparator" value="${esc(p.MultiValueSeparator)}"></label><label>Each value prefix<input data-key="MultiValuePrefix" value="${esc(p.MultiValuePrefix)}"></label><label>Each value suffix<input data-key="MultiValueSuffix" value="${esc(p.MultiValueSuffix)}"></label></div></details></form>`;
      const calculationHelp=area.querySelector('.pw-help');if(calculationHelp){calculationHelp.textContent='Supported: +, -, *, /, TODAY(), MONTH(date), YEAR(date), LEFT(value, length), RIGHT(value, length), PREVIOUSYEAR(period), PREVIOUSPERIOD(period), and ADDMONTHS(period, months). Examples: LEFT(periodfrom, 4), periodfrom / 100, or YEAR(TODAY()) * 100 + MONTH(TODAY()). Calculated parameters do not depend on Excel formulas.';calculationHelp.insertAdjacentHTML('afterend','<div><button type="button" data-test-calculation>Test calculation</button></div><div class="pw-calculation-preview">Enter an expression and select Test calculation.</div>');const testButton=area.querySelector('[data-test-calculation]'),previewBox=area.querySelector('.pw-calculation-preview');testButton.onclick=()=>{readForm();const testItems=clone(items),target=testItems[selected];target.CurrentValue='';target.CurrentDisplayValue='';target.CurrentValues=[];target.CurrentDisplayValues=[];evaluateCalculated(testItems);const result=testItems[selected]?.CurrentValue;if(String(result||'').trim()){previewBox.textContent=`Result: ${result}`;previewBox.classList.remove('pw-calculation-error');}else{previewBox.textContent=`Could not calculate. ${calculationFailureHint(items[selected].CalculationExpression,items)}`;previewBox.classList.add('pw-calculation-error');}};}
      area.querySelector('[data-key="InputKind"]').onchange=()=>{readForm();render();};
      area.querySelector('[data-key="UserInput"]').onchange=event=>{readForm();if(event.target.checked)p.IsCalculated=false;render();};
      area.querySelector('[data-key="IsCalculated"]').onchange=event=>{readForm();if(event.target.checked)p.UserInput=false;evaluateCalculated(items);render();};
      area.querySelector('[data-pick-scopes]').onclick=()=>{readForm();const names=[...new Set([...(options.sheetNames||[]),...items.flatMap(item=>item.SheetScopes||[])].map(String).map(x=>x.trim()).filter(x=>x&&!/^_control$/i.test(x)))].sort((a,b)=>a.localeCompare(b)),selectedScopes=new Set(p.SheetScopes||[]),dialog=document.createElement('dialog');dialog.className='pw-scope-dialog';dialog.innerHTML=`<div class="pw-dialog"><div class="pw-head"><div><h2>Choose worksheet scopes</h2><p>Leave every worksheet unchecked to use this parameter on all worksheets.</p></div><button type="button" class="pw-close">×</button></div><div class="pw-scope-list">${names.length?names.map(name=>`<label><input type="checkbox" value="${esc(name)}" ${selectedScopes.has(name)?'checked':''}> ${esc(name)}</label>`).join(''):'<p class="pw-help">No worksheet names are available yet. You can still enter names directly in the scope field.</p>'}</div><div class="pw-foot"><button type="button" data-clear>All worksheets</button><span class="spacer"></span><button type="button" data-cancel>Cancel</button><button type="button" class="pw-primary" data-apply>Apply selection</button></div></div>`;document.body.append(dialog);const dismiss=()=>{dialog.close();dialog.remove()};dialog.querySelector('.pw-close').onclick=dialog.querySelector('[data-cancel]').onclick=dismiss;dialog.querySelector('[data-clear]').onclick=()=>{p.SheetScopes=[];dismiss();renderProperties()};dialog.querySelector('[data-apply]').onclick=()=>{p.SheetScopes=[...dialog.querySelectorAll('input:checked')].map(input=>input.value);dismiss();renderProperties()};dialog.showModal();};
      const designLookup=area.querySelector('[data-design-lookup]');if(designLookup)designLookup.onclick=async()=>{readForm();designLookup.disabled=true;try{const result=await options.onDesignLookup?.({connectionName:p.LookupConnectionName||"table",queryText:p.LookupQueryText||"",previewLimit:1000,measures:[],parameters:items,data:{columns:[],rows:[]}});if(result){p.LookupConnectionName=result.connectionName||p.LookupConnectionName;p.LookupQueryText=result.queryText??p.LookupQueryText;render();}}finally{designLookup.disabled=false;}};
    }
    function render(){renderList();renderProperties();} render();
  }

  async function openInput(options = {}) {
    let items=evaluateCalculated(clone(options.parameters).map(normalize)).filter(p=>p.UserInput&&!p.IsCalculated).sort((a,b)=>(a.DisplayOrder??999)-(b.DisplayOrder??999));
    const overlay=shell("Report parameters","Set values before updating the report.","pw-input-body","input"), body=overlay.querySelector(".pw-input-body"), foot=overlay.querySelector(".pw-foot");
    foot.innerHTML=`${button("Manage parameters")}<span class="pw-error"></span><span class="spacer"></span>${button("Cancel")}${button("Apply")}${button("Apply and update","pw-primary")}`;
    const buttons=foot.querySelectorAll("button"); buttons[0].onclick=()=>{close(overlay);openManager({parameters:options.parameters,sheetNames:options.sheetNames,onSave:options.onManage,onCancel:options.onManagerCancel,onDesignLookup:options.onDesignLookup});}; buttons[1].onclick=()=>{close(overlay);options.onCancel?.();}; overlay.querySelector(".pw-close").onclick=()=>{close(overlay);options.onCancel?.();}; buttons[2].onclick=()=>apply(false); buttons[3].onclick=()=>apply(true);
    if(!items.length) body.innerHTML=`<div class="pw-empty">There are no user-input parameters.<br>Open the manager to add or enable one.</div>`;
    else body.innerHTML=items.map((p,i)=>`<div class="pw-input-row" data-index="${i}"><label><span>${esc(displayName(p))}</span><div class="pw-control">Loading…</div></label>${p.Description?`<p class="pw-help">${esc(p.Description)}</p>`:""}</div>`).join("");
    await Promise.all(items.map((p,i)=>renderControl(p,body.querySelector(`[data-index="${i}"] .pw-control`),options)));
    function apply(refresh){ const original=clone(options.parameters); items.forEach(p=>{const target=original.find(x=>String(get(x,"Name")).toLowerCase()===String(p.Name).toLowerCase());if(target)Object.assign(target,p);}); const error=items.find(p=>!p.AllowBlank&&!p.NoneSelected&&!String(p.CurrentValue||"").trim()); foot.querySelector(".pw-error").textContent=error?`${displayName(error)} requires a value.`:""; if(error)return; options.onApply?.(original,refresh); close(overlay); }
  }
  async function renderControl(p,root,options){ const kind=Number(p.InputKind), current=String(p.CurrentValue??p.DefaultValue??""); if(kind===0){root.innerHTML=`<input value="${esc(current)}" ${p.AllowBlank?"":"required"}>`;root.firstChild.oninput=e=>p.CurrentValue=e.target.value;return;} if(kind===3){root.innerHTML=`<input type="date" value="${esc(current)}">`;root.firstChild.oninput=e=>p.CurrentValue=e.target.value;return;} if(kind===4){root.innerHTML=`<input type="number" value="${esc(current)}" min="${p.NumericMinimum}" max="${p.NumericMaximum}" step="${p.NumericIncrement}">`;root.firstChild.oninput=e=>p.CurrentValue=e.target.value;return;}
    let choices=kind===1?parseManual(p.ManualListText):[]; if(kind===2&&options.lookup){root.innerHTML=`<span class="pw-help">Loading lookup values…</span>`;try{choices=await options.lookup(p);}catch(error){root.innerHTML=`<span class="pw-error">${esc(error.message||error)}</span>`;return;}} if(!choices.length&&p.CurrentValues?.length) choices=p.CurrentValues.map((v,i)=>({value:v,display:p.CurrentDisplayValues?.[i]||v})); choices=choices.map(x=>({value:String(x.value??x.Value??""),display:String(x.display??x.Display??x.value??x.Value??"")}));
    const selected=new Set((p.CurrentValues?.length?p.CurrentValues:[current]).map(String)); if(p.MultiSelect){root.innerHTML=`<div class="pw-multi">${p.AllowBlank||p.NoneValue?`<label><input type="checkbox" data-none ${p.NoneSelected?"checked":""}> ${esc(p.NoneCaption||"(None)")}</label>`:""}${choices.map(x=>`<label><input type="checkbox" value="${esc(x.value)}" ${selected.has(x.value)?"checked":""}> ${esc(x.display)}</label>`).join("")}</div>`;root.onchange=()=>{const none=root.querySelector("[data-none]")?.checked;p.NoneSelected=!!none;const checked=[...root.querySelectorAll('input:not([data-none]):checked')];p.CurrentValues=checked.map(x=>x.value);p.CurrentDisplayValues=checked.map(x=>x.parentElement.textContent.trim());p.CurrentValue=p.NoneSelected?p.NoneValue:(p.CurrentValues[0]||"");p.CurrentDisplayValue=p.NoneSelected?p.NoneCaption:(p.CurrentDisplayValues[0]||"");};}
    else {root.innerHTML=`<select>${p.AllowBlank?`<option value=""></option>`:""}${p.NoneValue?`<option value="__none" ${p.NoneSelected?"selected":""}>${esc(p.NoneCaption||"(None)")}</option>`:""}${choices.map(x=>`<option value="${esc(x.value)}" ${!p.NoneSelected&&x.value===current?"selected":""}>${esc(x.display)}</option>`).join("")}</select>`;root.firstChild.onchange=e=>{const option=e.target.selectedOptions[0];p.NoneSelected=e.target.value==="__none";p.CurrentValue=p.NoneSelected?p.NoneValue:e.target.value;p.CurrentDisplayValue=p.NoneSelected?p.NoneCaption:option?.textContent||e.target.value;p.CurrentValues=p.NoneSelected?[]:[p.CurrentValue];p.CurrentDisplayValues=p.NoneSelected?[]:[p.CurrentDisplayValue];};}
  }
  async function renderControl(p,root,options){
    const kind=Number(p.InputKind),current=String(p.CurrentValue??p.DefaultValue??"");
    if(kind===0){root.innerHTML=`<input value="${esc(current)}" ${p.AllowBlank?"":"required"}>`;root.firstChild.oninput=e=>p.CurrentValue=e.target.value;return;}
    if(kind===3){root.innerHTML=`<input type="date" value="${esc(current)}">`;root.firstChild.oninput=e=>p.CurrentValue=e.target.value;return;}
    if(kind===4){root.innerHTML=`<input type="number" value="${esc(current)}" min="${p.NumericMinimum}" max="${p.NumericMaximum}" step="${p.NumericIncrement}">`;root.firstChild.oninput=e=>p.CurrentValue=e.target.value;return;}
    let choices=kind===1?parseManual(p.ManualListText):[];if(kind===2&&options.lookup){root.innerHTML='<span class="pw-help">Loading lookup values…</span>';try{choices=await options.lookup(p);}catch(error){root.innerHTML=`<span class="pw-error">${esc(error.message||error)}</span>`;return;}}
    if(!choices.length&&p.CurrentValues?.length)choices=p.CurrentValues.map((v,i)=>({value:v,display:p.CurrentDisplayValues?.[i]||v,hierarchyValues:[]}));choices=choices.map(x=>({value:String(x.value??x.Value??""),display:String(x.display??x.Display??x.value??x.Value??""),hierarchyValues:(x.hierarchyValues||x.HierarchyValues||[]).map(String)}));
    const selected=new Set((p.CurrentValues?.length?p.CurrentValues:[current]).map(String));
    const applySelection=(values,displays)=>{p.NoneSelected=false;p.CurrentValues=values;p.CurrentDisplayValues=displays;p.CurrentValue=values[0]||"";p.CurrentDisplayValue=displays[0]||p.CurrentValue;};
    if(p.UseTreeView){
      const tree={groups:new Map(),items:[]};for(const choice of choices){let node=tree;for(const level of choice.hierarchyValues){if(!node.groups.has(level))node.groups.set(level,{groups:new Map(),items:[]});node=node.groups.get(level);}node.items.push(choice);}
      const groupHtml=(node,depth=0)=>[...node.groups].map(([name,child])=>`<details open><summary>${p.MultiSelect?`<input type="checkbox" data-tree-group>`:""} ${esc(name)}</summary><div>${groupHtml(child,depth+1)}</div></details>`).join("")+node.items.map(item=>leafHtml(item)).join("");
      const leafHtml=item=>`<label><input type="${p.MultiSelect?'checkbox':'radio'}" name="tree-${esc(p.Name)}" value="${esc(item.value)}" data-display="${esc(item.display)}" ${selected.has(item.value)?'checked':''}> ${esc(item.display)}</label>`;
      const noneHtml=`<label class="pw-tree-none"><input type="${p.MultiSelect?'checkbox':'radio'}" name="tree-${esc(p.Name)}" data-tree-none ${p.NoneSelected?'checked':''}> ${esc(p.NoneCaption||'(None)')}</label>`;
      root.innerHTML=`<div class="pw-tree">${noneHtml}${groupHtml(tree)}</div>`;const treeRoot=root.firstChild;
      treeRoot.querySelectorAll('[data-tree-group]').forEach(box=>box.onchange=()=>{box.closest('details').querySelectorAll('input:not([data-tree-group])').forEach(leaf=>leaf.checked=box.checked);const none=treeRoot.querySelector('[data-tree-none]');if(none)none.checked=false;const checked=[...treeRoot.querySelectorAll('input:not([data-tree-group]):not([data-tree-none]):checked')];applySelection(checked.map(x=>x.value),checked.map(x=>x.dataset.display));});
      treeRoot.onchange=event=>{if(event.target.hasAttribute('data-tree-group'))return;if(event.target.hasAttribute('data-tree-none')){p.NoneSelected=event.target.checked;p.CurrentValue=p.NoneSelected?p.NoneValue:"";p.CurrentDisplayValue=p.NoneSelected?p.NoneCaption:"";p.CurrentValues=[];p.CurrentDisplayValues=[];if(p.NoneSelected)treeRoot.querySelectorAll('input:not([data-tree-none])').forEach(input=>input.checked=false);return;}const none=treeRoot.querySelector('[data-tree-none]');if(none)none.checked=false;const checked=[...treeRoot.querySelectorAll('input:not([data-tree-group]):not([data-tree-none]):checked')];applySelection(checked.map(x=>x.value),checked.map(x=>x.dataset.display));};return;
    }
    if(p.MultiSelect){root.innerHTML=`<div class="pw-multi">${choices.map(x=>`<label><input type="checkbox" value="${esc(x.value)}" data-display="${esc(x.display)}" ${selected.has(x.value)?"checked":""}> ${esc(x.display)}</label>`).join("")}</div>`;root.onchange=()=>{const checked=[...root.querySelectorAll('input:checked')];applySelection(checked.map(x=>x.value),checked.map(x=>x.dataset.display));};return;}
    root.innerHTML=`<select>${p.AllowBlank?'<option value=""></option>':""}${choices.map(x=>`<option value="${esc(x.value)}" ${x.value===current?"selected":""}>${esc(x.display)}</option>`).join("")}</select>`;root.firstChild.onchange=e=>applySelection([e.target.value],[e.target.selectedOptions[0]?.textContent||e.target.value]);
  }
  const treeStyle=document.createElement('style');treeStyle.textContent='.pw-tree{max-height:360px;overflow:auto;border:1px solid #d5ddeb;border-radius:8px;padding:10px 12px;background:white}.pw-tree details{position:relative;margin-left:12px}.pw-tree details>div{margin-left:11px;padding-left:12px;border-left:1px dotted #98a2b3}.pw-tree summary{cursor:pointer;font-weight:600;padding:4px 2px;color:#172b4d}.pw-tree summary::marker{color:#667085}.pw-tree label{display:flex!important;align-items:center;gap:7px;padding:4px 6px;margin-left:14px;color:#344563}.pw-tree .pw-tree-none{margin-left:2px}.pw-tree input{width:auto!important;flex:0 0 auto}.pw-collapsible{padding:0!important}.pw-collapsible>summary{cursor:pointer;padding:18px 22px;font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#515d78;list-style-position:inside}.pw-collapsible[open]>summary{border-bottom:1px solid #e2e8f0}.pw-collapsible>.pw-grid{padding:20px 22px}.pw-calculation-preview{margin-top:6px;padding:8px 10px;border-radius:7px;background:#edf7f0;color:#24613b;font-size:13px}.pw-calculation-preview.pw-calculation-error{background:#fff1f0;color:#9f2d24}.pw-user-dot{width:13px;height:13px;border:1.5px solid #172b4d;border-radius:50%;display:inline-block;box-sizing:border-box}.pw-user-dot.required{border-color:#d92d20;background:#d92d20}.pw-input-button{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px}.pw-input-button button{white-space:nowrap}.pw-scope-overlay{z-index:10002}.pw-scope-overlay .pw-dialog{width:min(620px,90vw)}.pw-scope-list{min-height:120px;max-height:420px;overflow:auto;padding:14px 22px;display:grid;gap:8px}.pw-scope-list label{display:flex;align-items:center;gap:9px}.pw-scope-list input{width:auto!important}';document.head.append(treeStyle);
  const scopeStyle=document.createElement('style');scopeStyle.textContent='.pw-scope-dialog{width:min(620px,90vw);max-width:none;padding:0;border:0;border-radius:12px;background:transparent;box-shadow:0 22px 60px rgba(15,23,42,.35)}.pw-scope-dialog::backdrop{background:rgba(15,23,42,.58)}.pw-scope-dialog .pw-dialog{width:100%;max-height:80vh;background:#fff;display:flex;flex-direction:column}.pw-scope-dialog .pw-scope-list{flex:1;min-height:180px}';document.head.append(scopeStyle);
  window.ParameterWeb={openManager,openInput,parseManual,evaluateCalculated};
})();
