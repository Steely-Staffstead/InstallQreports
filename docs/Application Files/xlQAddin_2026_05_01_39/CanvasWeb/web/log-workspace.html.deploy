<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QReports log</title><link rel="stylesheet" href="log-workspace.css"><script src="shared-settings.js?v=20260913-2"></script></head><body><header><div class="brand"><span>Q</span><div><strong>QReports log</strong><small>Application messages and diagnostics</small></div></div><div class="tools"><select id="level"><option value="Info">All levels</option><option value="Warning">Warnings and errors</option><option value="Error">Errors only</option></select><input id="search" placeholder="Search log"><button id="copy">Copy all</button><button id="save">Save file</button><button id="clear">Clear</button><button id="close">Close</button></div></header><main><div id="summary"></div><div id="entries"></div></main><script src="log-workspace.js"></script></body></html>
