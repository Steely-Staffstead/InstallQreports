(() => {
  const captions={background:'Background',borderColor:'Border','header.background':'Header background','header.color':'Header text',textColor:'Text',color:'Stroke',fill:'Fill','card.valueColor':'Card value','card.positiveColor':'Positive','card.negativeColor':'Negative','card.captionColor':'Caption','appearance.textColor':'Values','appearance.headerColor':'Column headings','appearance.rowHeaderColor':'Row headings','appearance.totalRowColor':'Totals','appearance.alternateColor':'Alternate rows','appearance.gridColor':'Grid','design.matrixSpec.subtotalStyle.textColor':'Subtotal text','design.matrixSpec.subtotalStyle.background':'Subtotal background','design.ganttSpec.barColor':'Gantt bars','design.ganttSpec.progressColor':'Gantt progress','svgGraphic.color':'SVG primary','svgGraphic.textColor':'SVG text','svgGraphic.backgroundColor':'SVG background','svgGraphic.belowColor':'SVG below value','pageLink.background':'Background','pageLink.accent':'Action accent','valueSelector.textColor':'Selector text','valueSelector.activeTextColor':'Selected text','valueSelector.backgroundColor':'Selector background','valueSelector.activeBackgroundColor':'Selected background'};
  globalThis.CanvasThemeControls={install({model,selected,selection,changed}){
    let rolePanel,bindingPanel;
    function lockCustomColors(){const required=model().settings.theme?.requireColors===true;document.querySelectorAll('input[type=color]').forEach(input=>{if(input.matches('[data-palette-color],[data-theme-role]'))return;if(required){if(!input.disabled){input.dataset.themeLocked='true';input.disabled=true;}}else if(input.dataset.themeLocked){input.disabled=false;delete input.dataset.themeLocked;}});}
    new MutationObserver(lockCustomColors).observe(document.body,{childList:true,subtree:true});
    function render(){
      const theme=model().settings.theme,roles=CanvasTheme.roles(theme);
      if(!rolePanel){rolePanel=document.createElement('details');rolePanel.innerHTML='<summary>Theme color roles</summary><label class="check"><input type="checkbox" data-require-theme> Require theme colors for canvas objects</label><p class="property-empty">Accent and on-accent follow the selected color theme. Text, surfaces, grid, positive and negative remain semantic colors until you change them here.</p><div></div>';document.querySelector('#canvasThemeProperties').append(rolePanel);rolePanel.addEventListener('change',event=>{if(event.target.matches('[data-require-theme]')){model().settings.theme.requireColors=event.target.checked;changed();return;}const role=event.target.dataset.themeRole;if(role)themeUpdate(role,event.target.value);});}
      rolePanel.querySelector('[data-require-theme]').checked=theme.requireColors===true;
      rolePanel.querySelector('div').replaceChildren(...Object.entries(roles).filter(([role])=>!/^color\d+$/.test(role)).map(([role,color])=>{const label=document.createElement('label');label.textContent=role.replace(/([A-Z])/g,' $1');const input=document.createElement('input');input.type='color';input.value=color;input.dataset.themeRole=role;label.append(input);return label;}));
      if(!bindingPanel){bindingPanel=document.createElement('details');bindingPanel.id='themeBindings';bindingPanel.innerHTML='<summary>Theme colors</summary><button type="button" data-inherit-all>Use canvas theme for all colors</button><p class="property-empty">For tables and matrices, these are base colors. Area colors in the designer take priority unless theme colors are required.</p><div></div>';document.querySelector('#tileProperties').append(bindingPanel);bindingPanel.addEventListener('click',event=>{if(!event.target.matches('[data-inherit-all]'))return;for(const tile of selection?.()||[selected()]){if(!tile)continue;tile.themeBindings=CanvasTheme.inherit(tile);if(['table','matrix'].includes(tile.kind)){tile.appearance||={};tile.appearance.colorOverrides={};}if(tile.kind==='matrix'&&tile.design?.matrixSpec?.subtotalStyle)tile.design.matrixSpec.subtotalStyle.colorOverrides={};}changed();});bindingPanel.addEventListener('change',event=>{const path=event.target.dataset.themePath||event.target.dataset.themeRoleChoice;if(!selected()||!path)return;for(const tile of selection?.()||[selected()]){if(!tile||!CanvasTheme.fields(tile).includes(path))continue;tile.themeBindings||={};if(event.target.dataset.themeRoleChoice){tile.themeBindings[path]=event.target.value;}else if(event.target.matches('[role=switch]')){if(event.target.checked)tile.themeBindings[path]||=CanvasTheme.paths[path];else{CanvasTheme.set(tile,path,CanvasTheme.get(CanvasTheme.resolve(tile,model().settings.theme),path));delete tile.themeBindings[path];}}else{delete tile.themeBindings[path];CanvasTheme.set(tile,path,event.target.value);}if(path.startsWith('appearance.')){tile.appearance||={};tile.appearance.colorOverrides||={};const key=path.split('.')[1];if(tile.themeBindings[path])delete tile.appearance.colorOverrides[key];else tile.appearance.colorOverrides[key]=true;}if(path.startsWith('design.matrixSpec.subtotalStyle.')){tile.design.matrixSpec.subtotalStyle.colorOverrides||={};const key=path.split('.').at(-1);if(tile.themeBindings[path])delete tile.design.matrixSpec.subtotalStyle.colorOverrides[key];else tile.design.matrixSpec.subtotalStyle.colorOverrides[key]=true;}}changed();});}
      const tile=selected();bindingPanel.hidden=!tile;lockCustomColors();if(!tile)return;
      bindingPanel.querySelector('[data-inherit-all]').disabled=theme.requireColors===true;
      bindingPanel.querySelector('.property-empty').hidden=!['table','matrix'].includes(tile.kind);
      bindingPanel.querySelector('div').replaceChildren(...CanvasTheme.fields(tile).map(path=>{
        const row=document.createElement('div');row.className='theme-color-row';
        const heading=document.createElement('div');heading.className='theme-color-heading';
        const name=document.createElement('label');name.textContent=captions[path];name.htmlFor='theme-color-'+path.replaceAll('.','-');
        const toggle=document.createElement('label');toggle.className='theme-color-toggle';
        const text=document.createElement('span');text.textContent='Use theme';
        const checkbox=document.createElement('input');checkbox.type='checkbox';checkbox.setAttribute('role','switch');checkbox.setAttribute('aria-label','Use canvas theme for '+captions[path].toLowerCase());checkbox.dataset.themePath=path;checkbox.checked=theme.requireColors===true||!!tile.themeBindings?.[path];checkbox.disabled=theme.requireColors===true;
        toggle.append(checkbox,text);heading.append(name,toggle);
        const rolePicker=document.createElement('select');rolePicker.dataset.themeRoleChoice=path;rolePicker.setAttribute('aria-label','Theme color for '+captions[path].toLowerCase());const chosen=tile.themeBindings?.[path]||CanvasTheme.paths[path];const choices=[...Object.keys(CanvasTheme.defaults),...(theme.colors||[]).map((_,index)=>`color${index+1}`)];if(chosen&&!choices.includes(chosen))choices.push(chosen);choices.forEach(role=>{const option=document.createElement('option');option.value=role;option.textContent=/^color\d+$/.test(role)?`Theme color ${role.slice(5)}`:role.replace(/([A-Z])/g,' $1');rolePicker.append(option);});rolePicker.value=chosen;rolePicker.disabled=!checkbox.checked;
        const input=document.createElement('input');input.type='color';input.id=name.htmlFor;input.dataset.themePath=path;input.value=CanvasTheme.get(CanvasTheme.resolve(tile,theme),path)||'#ffffff';input.disabled=checkbox.checked;input.title=checkbox.checked?'Canvas theme color':'Custom color';
        row.append(heading,rolePicker,input);return row;
      }));lockCustomColors();
    }
    function themeUpdate(role,color){model().settings.theme.roles||={};model().settings.theme.roles[role]=color;changed();}
    document.addEventListener('change',event=>{const input=event.target;if(input.type!=='color'||input.dataset.themePath||input.dataset.themeRole)return;const tile=selected();if(!tile)return;const ids={tileBackground:'background',tileTextColor:'textColor'},path=ids[input.id]||(input.dataset.card?'card.'+input.dataset.card:input.dataset.cardCaption?'card.'+input.dataset.cardCaption:input.dataset.header?'header.'+input.dataset.header:input.dataset.graphicStyle||input.dataset.graphic||(input.dataset.appearance?'appearance.'+input.dataset.appearance:null)||input.dataset.tileBorder);if(path&&tile.themeBindings)delete tile.themeBindings[path];},true);
    return {render};
  }};
})();
