body.secrets-only{display:block;background:#eef2f8}
body.secrets-only>header,body.secrets-only>main{display:none}
body.secrets-only .modal{position:fixed;inset:0;padding:0;background:#eef2f8;backdrop-filter:none}
body.secrets-only .modal-card{width:100vw;height:100vh;max-width:none;max-height:none;border-radius:0;box-shadow:none}
html[data-qreports-theme] .modal-head{background:var(--qreports-header);color:var(--qreports-header-text)}
html[data-qreports-theme] .modal-head h2{color:var(--qreports-header-text)}
html[data-qreports-theme] .modal-head p{color:var(--qreports-header-text);opacity:.85}
html[data-qreports-theme] .modal-head button{color:var(--qreports-header-text);border-color:currentColor}
html[data-qreports-theme] body>header .brand small{color:var(--qreports-header-text);opacity:.85}
.transfer-card{width:min(720px,95vw);height:auto;max-height:90vh}.transfer-body{padding:22px 24px;overflow:auto;display:grid;gap:18px}.choice-row,.import-summary{display:flex;align-items:center;justify-content:space-between;gap:12px}.choice-row .check{min-width:0}.link-button{padding:5px 8px;border:0;background:transparent;color:#3458c4}.definition-list{display:grid;gap:7px;margin-top:10px;max-height:300px;overflow:auto}.definition-option{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:10px;padding:10px 12px;background:white;border:1px solid #d6deea;border-radius:9px}.definition-option input{width:auto}.definition-option small{color:#738098}.empty-definitions{padding:18px;border:1px dashed #c6d0e0;border-radius:9px;color:#738098;text-align:center}.transfer-actions{justify-content:flex-end;border-top:1px solid #d7deea;padding-top:16px}.format-badge{white-space:nowrap;padding:5px 9px;border-radius:99px;background:#e8edf6;color:#5d6980;font-weight:650}.import-summary #importPath{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#738098}.context-menu{position:fixed;z-index:20;min-width:270px;padding:6px;background:white;border:1px solid #c7d0df;border-radius:10px;box-shadow:0 14px 36px rgba(0,0,0,.24)}.context-menu button{display:block;width:100%;border:0;border-radius:6px;text-align:left;background:transparent}.context-menu button:hover{background:#f2f5fa}
