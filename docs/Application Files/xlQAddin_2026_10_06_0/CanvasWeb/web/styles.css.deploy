:root{font-family:Inter,"Segoe UI",system-ui,sans-serif;color:#182230;background:#edf1f5}*{box-sizing:border-box}body{margin:0;height:100vh;overflow:hidden}button,input,textarea,select{font:inherit}button,.file-button{border:1px solid #cdd5df;border-radius:7px;background:#fff;color:#344054;padding:7px 11px;cursor:pointer}button:hover,.file-button:hover{background:#f3f6f9;border-color:#98a5b3}.hidden{display:none!important}.app-header{height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;color:#fff;background:linear-gradient(110deg,#15253d,#1d4070)}.brand{display:flex;gap:11px;align-items:center}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:#4f8ee8;font-size:20px;font-weight:800}.brand strong,.brand small{display:block}.brand small{color:#cbd9ed}.file-actions{display:flex;gap:7px}.file-actions button{background:#ffffff14;color:#fff;border-color:#ffffff38}.file-actions .primary{background:#4c8de8}.commandbar{height:72px;display:flex;align-items:stretch;padding:6px 14px;background:#fff;border-bottom:1px solid #d7dee7;box-shadow:0 2px 6px #1822300b;z-index:10;position:relative}.command-group{display:flex}.command{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-width:76px;border:0;background:transparent;padding:4px 10px}.command span{font-size:23px;line-height:25px;color:#275c9c}.command b{font-size:12px;font-weight:600}.command.accent span{color:#16844a}.command.danger span{color:#a83b32}.separator{width:1px;background:#e0e5eb;margin:8px}.command-spacer{flex:1}.badge{align-self:center;background:#edf3fb;color:#285a97;border-radius:12px;padding:5px 10px;font-size:12px}.add-menu{position:relative}.menu{position:absolute;top:62px;left:0;display:grid;grid-template-columns:1fr 1fr;width:245px;padding:8px;gap:5px;background:#fff;border:1px solid #d4dce5;border-radius:9px;box-shadow:0 10px 28px #10182830}.menu button{text-align:left;font-size:18px}.menu button span{font-size:13px;margin-left:7px}main{display:grid;grid-template-columns:205px minmax(520px,1fr)285px;height:calc(100vh - 130px)}.left-panel,.right-panel{background:#f9fafb;padding:16px;overflow:auto}.left-panel{border-right:1px solid #d9e0e7}.right-panel{border-left:1px solid #d9e0e7}.panel-title{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#667085;margin-bottom:16px}label{display:block;color:#475467;font-size:12px;margin-bottom:12px}input[type=text],input[type=number],select,textarea{width:100%;margin-top:5px;padding:8px;border:1px solid #cdd5df;border-radius:7px;background:#fff}.section-heading{display:flex;align-items:center;justify-content:space-between;margin:18px 0 8px;font-weight:650}.icon-button{padding:1px 8px;font-size:18px}.page-list{display:grid;gap:5px}.page-item{text-align:left;width:100%}.page-item.active{color:#174e9d;border-color:#8ab4ee;background:#eaf2fd;font-weight:650}.query-summary{margin-top:22px;padding:12px;background:#eef3f9;border-radius:8px;font-size:12px}.query-summary dl{display:grid;grid-template-columns:70px 1fr;gap:6px;margin:10px 0 0}.query-summary dt{color:#667085}.query-summary dd{margin:0;overflow:hidden;text-overflow:ellipsis}.workspace{min-width:0;display:grid;grid-template-rows:1fr 31px}.canvas{position:relative;overflow:auto;min-width:900px;min-height:620px;background-color:#e8edf2;background-image:linear-gradient(#d9d9d9 1px,transparent 1px),linear-gradient(90deg,#d9d9d9 1px,transparent 1px);background-size:20px 20px}.empty-state{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#738092;gap:7px}.empty-state b{font-size:20px;color:#465466}.empty-state button{margin-top:8px}.tile{position:absolute;display:flex;flex-direction:column;background:#fff;border:1px solid #cbd5e1;border-radius:5px;box-shadow:0 2px 8px #1822301c;overflow:hidden;min-width:100px;min-height:70px}.tile.selected{outline:2px solid #2878df;outline-offset:2px}.tile-header{height:34px;flex:none;display:flex;align-items:center;padding:0 10px;font-size:13px;font-weight:650;background:#f3f6fa;border-bottom:1px solid #dbe2e9;cursor:move;user-select:none}.tile-kind{margin-left:auto;color:#8090a2;font-size:10px;text-transform:uppercase}.tile-body{flex:1;min-height:0;padding:12px;overflow:auto}.tile-card .tile-body{display:grid;place-content:center;text-align:center}.card-value{font-size:30px;font-weight:700;color:#1d4f8f}.tile-text .tile-body{white-space:pre-wrap}.tile-picture .tile-body{padding:0;display:grid;place-items:center;background:#edf1f5}.tile-picture img{width:100%;height:100%;object-fit:contain}.picture-placeholder{color:#8190a0}.data-table{width:100%;border-collapse:collapse;font-size:12px}.data-table th,.data-table td{padding:6px 8px;border-bottom:1px solid #e1e6ec;text-align:left;white-space:nowrap}.data-table th{background:#f5f7fa;position:sticky;top:0}.matrix-label{font-weight:650;background:#f5f7fa}.simple-chart{height:calc(100% - 18px);display:flex;align-items:flex-end;gap:8px;padding:12px}.chart-bar{flex:1;min-width:12px;background:linear-gradient(#4f91e8,#2867bb);border-radius:3px 3px 0 0;position:relative}.chart-bar span{position:absolute;bottom:-18px;left:0;right:0;text-align:center;font-size:9px;overflow:hidden}.statusbar{display:flex;justify-content:space-between;align-items:center;padding:0 12px;font-size:12px;color:#667085;background:#fff;border-top:1px solid #d9e0e7}.property-empty{color:#7b8795;font-size:13px}.property-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 8px}.check{display:flex;gap:7px;align-items:center}.check input{margin:0}input[type=color]{width:100%;height:35px;border:1px solid #cdd5df;border-radius:6px}details{margin-top:22px;border-top:1px solid #dde3e9;padding-top:12px}summary{font-size:12px;font-weight:700;color:#526071;cursor:pointer}#jsonEditor{height:240px;font:11px/1.4 Consolas,monospace}.json-actions{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.file-button input{display:none}.error{color:#b42318;font-size:12px}.busy::after{content:"";position:fixed;inset:130px 0 0;background:#ffffff80;z-index:30}.busy::before{content:"Opening legacy editor…";position:fixed;z-index:31;left:50%;top:50%;transform:translate(-50%,-50%);padding:15px 22px;background:#182a43;color:#fff;border-radius:9px}@media(max-width:1050px){main{grid-template-columns:175px 1fr}.right-panel{display:none}}
.chart-web-surface{position:relative;width:100%;height:100%;min-height:180px}.chart-web-svg{display:block;width:100%;height:100%;font-family:Segoe UI,Arial,sans-serif}.chart-title{fill:#253653;font-size:20px;font-weight:700}.chart-grid{stroke:#dfe5ee}.chart-axis{stroke:#73809a;stroke-width:1.2}.chart-axis-label,.chart-legend{fill:#65718a;font-size:11px}.chart-value-label{fill:#42516b;font-size:10px;font-weight:600}.chart-total,.gauge-value{fill:#253653;font-size:18px;font-weight:700}.treemap-label{fill:#fff;font-size:12px;font-weight:700}.treemap-value{fill:#ffffffd9;font-size:10px}.chart-web-empty{height:100%;display:grid;place-content:center;gap:6px;text-align:center;color:#7a869e}.chart-web-warning{position:absolute;right:8px;bottom:6px;padding:5px 8px;border-radius:5px;background:#fff4ce;color:#725500;font-size:11px}
.chart-data-label{fill:#344054;font-weight:600;paint-order:stroke;stroke:#fff;stroke-width:2px;stroke-linejoin:round}.chart-group-label{fill:#526071;font-size:11px;font-weight:700}.treemap-group-label{fill:#fff;font-size:12px;font-weight:800;paint-order:stroke;stroke:#0005;stroke-width:2px}
.chart-title[data-chart-action]{cursor:move}.chart-legend-control{cursor:move}.chart-margin-controls line{stroke:transparent;stroke-width:14;pointer-events:stroke}.chart-margin-controls line[data-margin-handle="left"],.chart-margin-controls line[data-margin-handle="right"]{cursor:ew-resize}.chart-margin-controls line[data-margin-handle="top"],.chart-margin-controls line[data-margin-handle="bottom"]{cursor:ns-resize}.chart-margin-controls line:hover{stroke:#5d7fe3;stroke-opacity:.42;stroke-dasharray:5 4}
.chart-small-multiples{display:grid;grid-template-columns:repeat(var(--multiple-columns,2),minmax(0,1fr));grid-auto-rows:minmax(0,1fr);gap:8px;padding:8px;overflow:hidden}.chart-small-multiple{display:grid;grid-template-rows:auto minmax(0,1fr);min-width:0;min-height:0;border:1px solid #dfe5ee;border-radius:6px;overflow:hidden}.chart-small-multiple>b{padding:4px 7px;color:#34425e;font-size:11px}.chart-small-multiple>.chart-web-surface{min-height:0}
.chart-lollipop{stroke:#8492a8;stroke-width:1.5;stroke-dasharray:3 2;opacity:.75}
.chart-doughnut-resize{fill:#fff;stroke:#5d7fe3;stroke-width:3;cursor:ew-resize;opacity:.65}.chart-doughnut-resize:hover{opacity:1;stroke-width:4}
.chart-radial-group-label{fill:#526071;font-size:11px;font-weight:700;cursor:pointer}
.tile-line,.connector-object{background:transparent!important;border:0;box-shadow:none;overflow:visible}.tile-rectangle{box-shadow:none;overflow:visible}.tile-line .tile-header,.tile-rectangle .tile-header{display:none}.tile-line .tile-body,.tile-rectangle .tile-body{padding:0;overflow:visible;cursor:move}.graphic-svg{display:block;width:100%;height:100%;overflow:visible}.connector-object{pointer-events:none;min-width:0;min-height:0}.connector-object svg{width:100%;height:100%;overflow:visible}.connector-path{fill:none;pointer-events:stroke}.connector-hit{fill:none;stroke:transparent;stroke-width:14;pointer-events:stroke;cursor:pointer}.connector-endpoint{fill:#fff;stroke:#2878df;stroke-width:2;pointer-events:all;cursor:crosshair}.connector-object.selected .connector-path{filter:drop-shadow(0 0 2px #2878df)}
.tile-line.selected { outline:none; }
.tile-line,.tile-line .tile-body,.tile-line .graphic-svg { pointer-events:none; }
.tile-line .graphic-svg .line-hit { stroke:transparent; stroke-width:14; pointer-events:stroke; cursor:move; }
.tile-line.selected .graphic-svg line:not(.line-hit) { stroke:var(--qreports-accent,#2878df); filter:drop-shadow(0 0 3px var(--qreports-accent,#2878df)); }
.tile-line .resize-handle { display:none; }
.line-end-handle,.line-rotate-handle{display:none;position:absolute;z-index:22;width:14px;height:14px;transform:translate(-50%,-50%);border:2px solid var(--qreports-accent,#2878df);border-radius:50%;background:#fff;pointer-events:auto;touch-action:none}.tile-line.selected:not(.hide-handles)>.line-end-handle,.tile-line.selected:not(.hide-handles)>.line-rotate-handle,.tile-line.selected:not(.hide-handles)>.line-rotate-stem{display:block}.line-end-handle{cursor:crosshair}.line-rotate-handle{background:var(--qreports-accent,#2878df);box-shadow:0 0 0 3px #fff;cursor:grab}.line-rotate-handle:active{cursor:grabbing}.line-rotate-stem{display:none;position:absolute;z-index:20;height:1px;background:var(--qreports-accent,#2878df);transform-origin:0 50%;pointer-events:none}.tile-line.hide-handles>.line-end-handle,.tile-line.hide-handles>.line-rotate-handle,.tile-line.hide-handles>.line-rotate-stem,body.presentation-mode .line-end-handle,body.presentation-mode .line-rotate-handle,body.presentation-mode .line-rotate-stem{display:none!important}
.tile-graphicText:not(.boxed){background:transparent!important;border-color:transparent!important;box-shadow:none}.tile-graphicText .tile-header{display:none}.tile-graphicText .tile-body{padding:var(--tile-padding-y,6px) 8px;overflow:visible;cursor:move}.tile-graphicText.boxed .tile-body{overflow:hidden}.selection-marquee{position:absolute;z-index:2147483647;border:1px solid #3978d4;background:rgba(57,120,212,.12);pointer-events:none}
.tile-graphicText.boxed.has-shape{background:transparent!important;border-color:transparent!important;box-shadow:none}.tile-graphicText.boxed .text-box-shape{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.tile-graphicText.boxed.has-shape .tile-body{position:relative;z-index:1;align-self:center;flex:none;margin:auto;max-height:80%;width:76%;overflow:hidden}.tile-graphicText.boxed.shape-circle .tile-body{width:min(58%,var(--shape-inner-size));max-height:55%}.tile-graphicText.boxed.shape-diamond .tile-body{width:58%;max-height:55%}.tile-graphicText.boxed.shape-cylinder .tile-body{max-height:65%}
.connector-endpoint-halo{fill:rgba(40,120,223,.12);stroke:rgba(40,120,223,.35);stroke-width:1;pointer-events:none}.connection-port{position:absolute;z-index:20;width:9px;height:9px;border:1.5px solid #2878df;border-radius:50%;background:#fff;pointer-events:none;opacity:.75}.port-top{left:var(--port-offset);top:0;transform:translate(-50%,-50%)}.port-bottom{left:var(--port-offset);bottom:0;transform:translate(-50%,50%)}.port-left{left:0;top:var(--port-offset);transform:translate(-50%,-50%)}.port-right{right:0;top:var(--port-offset);transform:translate(50%,-50%)}
.connection-port.active{z-index:21;width:15px;height:15px;border:2px solid #fff;background:#30a46c;box-shadow:0 0 0 3px #30a46c99,0 0 0 8px #30a46c33;opacity:1}
.connector-object.selected{outline:none!important;outline-offset:0!important;box-shadow:none!important}
.connector-quick-tools{position:absolute;left:50%;top:-42px;transform:translateX(-50%);display:flex;align-items:center;gap:4px;padding:4px 6px;border:1px solid #8292aa;border-radius:10px;background:#18283c;color:#f8fafc;box-shadow:0 4px 12px #10182855;pointer-events:auto;white-space:nowrap;z-index:35;font:12px Segoe UI,Arial,sans-serif}.connector-quick-tools label{display:flex;align-items:center;gap:3px;margin:0;color:#f8fafc}.connector-quick-tools select,.connector-quick-tools button{width:auto;min-width:0;height:25px;padding:1px 5px;margin:0;border:1px solid #71839a;border-radius:5px;background:#25374e;color:#fff;font:inherit;cursor:pointer}.connector-quick-tools button{min-width:30px;font-size:16px;line-height:1}.connector-quick-tools button:hover{background:#385170;color:#fff}
.connector-quick-tools input[type=number]{width:48px;height:25px;padding:1px 3px;margin:0;border:1px solid #71839a;border-radius:5px;background:#25374e;color:#fff;font:inherit}.connector-quick-tools input[type=color]{width:31px;height:25px;padding:2px;margin:0;border:1px solid #71839a;border-radius:5px;background:#25374e;cursor:pointer}
.connector-quick-tools{top:-83px;flex-direction:column;align-items:stretch;gap:3px}.connector-quick-tabs,.connector-quick-panel{display:flex;align-items:center;justify-content:center;gap:4px}.connector-quick-tabs button{min-width:31px}.connector-quick-tabs button[aria-pressed=true]{background:#5174ad;border-color:#a3bbdf}.connector-quick-panel{padding-top:3px;border-top:1px solid #61738c}.connector-quick-panel label{font-size:11px}.tile-graphicText.boxed.shape-document .tile-body,.tile-graphicText.boxed.shape-callout .tile-body{max-height:62%;width:74%}.tile-graphicText.boxed.shape-inputOutput .tile-body,.tile-graphicText.boxed.shape-preparation .tile-body{width:65%}.tile-graphicText.boxed.shape-predefinedProcess .tile-body{width:68%}
.tile-text,.tile-graphicText,.tile-rectangle,.tile-card{min-height:30px;min-width:30px}
.tile-svgGraphic{min-height:30px;min-width:30px}
.matrix-subtotal-row td{font-weight:700;background:var(--matrix-total,#eef2f7);border-top:2px solid var(--tile-grid,#dfe5ec)}.matrix-blank-row td{height:12px;padding:0!important;background:transparent!important;border:0!important}.matrix-subtotal-options{border-top:1px solid #d8e0ec;padding-top:12px}.matrix-subtotal-options .check{margin-top:8px}
.tile-table .data-table,.tile-matrix .data-table{color:var(--visual-text,#182230);font-family:var(--visual-font,"Segoe UI");font-size:var(--visual-size,12px);font-weight:var(--visual-weight,400);font-style:var(--visual-style,normal);text-decoration:var(--visual-decoration,none)}.tile-table .data-table th,.tile-matrix .data-table th{background:var(--visual-header,#f5f7fa)}.tile-matrix .matrix-label{background:var(--visual-row-header,#f5f7fa)}.tile-matrix .matrix-detail-label,.tile-matrix .matrix-detail-row>td:first-child{font-weight:var(--visual-weight,400);font-style:var(--visual-style,normal);text-decoration:var(--visual-decoration,none);background:var(--visual-alt,#fff);color:var(--visual-text,#182230)}.tile-table .data-table td,.tile-matrix .data-table td{border-color:var(--visual-grid,#e1e6ec)}.tile-table .matrix-total-row td,.tile-matrix .matrix-total-row td{background:var(--visual-total-row,#eef2f7)}.matrix-toggle{position:relative;z-index:6;display:inline-grid;place-items:center;width:var(--matrix-control-size,24px);height:var(--matrix-control-size,24px);margin-right:4px;padding:0;border:1px solid var(--matrix-control-bg,#4f6ee8);border-radius:2px;background:var(--matrix-control-bg,#4f6ee8);color:var(--matrix-control-text,#fff);font:700 12px/1 monospace;vertical-align:middle;pointer-events:auto;cursor:pointer;touch-action:manipulation}
.tile-matrix .matrix-row-header{position:sticky;left:var(--matrix-row-left,0);z-index:2;min-width:140px;background:var(--visual-row-header,#f5f7fa)}.tile-matrix thead .matrix-row-header{z-index:4;background:var(--visual-header,#f5f7fa)}
.alignment-guide{position:absolute;z-index:2147483646;pointer-events:none;background:#e34872;box-shadow:0 0 0 1px rgba(255,255,255,.7)}.alignment-guide-v{top:0;bottom:0;width:1px}.alignment-guide-h{left:0;right:0;height:1px}
.source-list{display:grid;gap:5px;margin:6px 0}.source-item{display:grid;grid-template-columns:18px 1fr auto;align-items:center;gap:6px;width:100%;padding:7px 9px;text-align:left;background:#fff;border:1px solid #d5dce8;border-radius:7px;color:#263450}.source-item b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-item small{font-size:10px;color:#74819a}.source-item.active{border-color:#6381ee;background:#eef2ff;color:#2446b8}.source-actions{display:flex;gap:5px;margin:0 0 12px}.source-actions button{flex:1;padding:5px 7px;font-size:11px}
.tile-picture.hide-picture-scrollbars .tile-body{overflow:hidden}.tile-picture.hide-picture-scrollbars img{display:block;max-width:100%;max-height:100%}
.tile-table.hide-data-scrollbars .tile-body,.tile-matrix.hide-data-scrollbars .tile-body{scrollbar-width:none}.tile-table.hide-data-scrollbars .tile-body::-webkit-scrollbar,.tile-matrix.hide-data-scrollbars .tile-body::-webkit-scrollbar{width:0;height:0}
.update-menu-wrap .menu{width:230px}.update-menu-wrap .menu button{font-size:12px;line-height:1.25;padding:8px 9px}.update-menu-wrap .menu button span{font-size:12px;margin-left:0}.update-menu-wrap>.command small{font-size:9px;line-height:9px;color:#475467}
.filter-divider{border:0;border-top:1px solid #dde3e9;margin:20px 0}.filter-context{margin:-7px 0 10px;padding:7px 9px;border-radius:6px;background:#eef3f9;color:#526071;font-size:12px}.canvas-filter-row button[data-basic-filter]{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tile-filter-row{padding-top:0}.filter-row-heading{display:flex;align-items:center;justify-content:space-between;min-height:38px;margin:0 -1px 7px;padding:6px 0 6px 10px;border-bottom:1px solid #dde3e9;color:#344054}.filter-row-heading b{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.filter-row-heading .remove-filter{position:static;flex:none;margin-left:8px}
#headerSettings>summary,#textBodySettings>summary{margin-bottom:12px}.header-emphasis{display:flex;gap:12px;flex-wrap:wrap;margin:4px 0 10px}.header-emphasis label{margin:0}
#filtersPanel .canvas-filter-row select,#filtersPanel .canvas-filter-row input,#filtersPanel .canvas-filter-row button{font-size:11px;padding:6px 8px}#filtersPanel>[data-action="addFilter"],#filtersPanel>[data-action="applyFilters"],#filtersPanel>[data-action="addTileFilter"],#filtersPanel>[data-action="applyTileFilters"]{font-size:11px;padding:6px 9px}
#filtersPanel>[data-action="applyFilters"],#filtersPanel>[data-action="applyTileFilters"]{color:#fff}
.chart-small-multiples{gap:var(--multiple-gap,8px)}
.palette-colors{display:flex;flex-wrap:wrap;gap:7px;margin:8px 0 10px}.palette-color{position:relative;display:inline-block}.palette-color input{width:40px;height:34px;padding:2px}.palette-color button{position:absolute;right:-5px;top:-7px;width:17px;height:17px;padding:0;border-radius:50%;font-size:12px;line-height:14px}.palette-actions{display:flex;gap:6px;flex-wrap:wrap}.palette-actions button{font-size:11px;padding:6px 8px}#canvasThemeProperties{margin:8px 0 18px;padding:10px;border:1px solid #dce3ec;border-radius:8px;background:#f4f7fb}#canvasThemeProperties summary{margin-bottom:11px}
#themeBindings .theme-color-row{display:grid;grid-template-columns:minmax(0,1fr) 50px;align-items:center;gap:5px 10px;margin:8px 0;padding:7px 9px;border:1px solid var(--border,#46576b);border-radius:8px}
#themeBindings .theme-color-heading{display:contents}
#themeBindings .theme-color-heading>label{grid-column:1;margin:0;font-size:12px}
#themeBindings .theme-color-toggle{grid-column:1;grid-row:2;display:inline-flex;align-items:center;gap:6px;margin:0;cursor:pointer;font-size:11px}
#themeBindings .theme-color-toggle input{width:15px;height:15px;margin:0;accent-color:var(--accent,#4f6ee8)}
#themeBindings .theme-color-row>select{grid-column:1;grid-row:3;min-width:0;margin:0}
#themeBindings .theme-color-row>input[type=color]{grid-column:2;grid-row:1 / span 3;width:50px;height:38px;margin:0;padding:3px;border:1px solid var(--border,#46576b);border-radius:6px;background:var(--surface,#fff)}
#themeBindings .theme-color-row>input[type=color]:disabled{opacity:.85;cursor:default}
body.theme-colors-required .tile .rich-content :is(span,p,div,a,li),body.theme-colors-required .tile .inline-rich-editor :is(span,p,div,a,li){color:inherit!important}
.toolbar #sourcesMenu button{font-size:inherit}
.manual-source-badge{background:#e5f3ee!important;color:#247254!important;border:1px solid #c7e5d8}
.update-menu-wrap #updateMenu{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;width:320px;padding:6px}
.update-menu-wrap #updateMenu.hidden{display:none}
.update-menu-wrap #updateMenu button{margin:0;min-width:0;height:100%;align-items:flex-start}
@media print {
  body { background:white!important; height:auto!important; overflow:visible!important; }
  body * { visibility:hidden!important; }
  #canvas,#canvas * { visibility:visible!important; }
  .app-header,.toolbar,.left-panel,.right-panel,.pane-splitter,.status-bar { display:none!important; }
  main,.workspace,#canvasViewport { position:static!important; display:block!important; overflow:visible!important; height:auto!important; margin:0!important; padding:0!important; }
  #canvas { position:absolute!important; left:0!important; top:0!important; margin:0!important; transform:none!important; border:0!important; box-shadow:none!important; }
  #canvas .resize-handle,#canvas .corner-rounding-handle,#canvas .graphic-handle,#canvas .alignment-guide,#canvas .selection-box { display:none!important; }
  #canvas .selected { outline:none!important; }
}
.pdf-export-pages { display:none; }
@media print {
  body.pdf-export main { display:none!important; }
  body.pdf-export .pdf-export-pages,body.pdf-export .pdf-export-pages * { visibility:visible!important; }
  body.pdf-export .pdf-export-pages { display:block!important; margin:0; padding:0; }
  .pdf-export-page { position:relative; overflow:hidden; break-after:page; break-inside:avoid; }
  .pdf-export-page:last-child { break-after:auto; }
  .pdf-export-canvas .resize-handle,.pdf-export-canvas .corner-rounding-handle,.pdf-export-canvas .graphic-handle,.pdf-export-canvas .alignment-guide,.pdf-export-canvas .selection-box { display:none!important; }
}
.tile-text .tile-body:has(.rich-content>svg),.tile-graphicText .tile-body:has(.rich-content>svg){position:relative;padding:0;overflow:hidden;white-space:normal}.rich-content:has(>svg){position:absolute;inset:0;display:grid;place-items:center;width:auto;height:auto;margin:0;padding:0;line-height:0}.rich-content>svg{display:block;width:100%!important;height:100%!important;max-width:none;max-height:none;margin:0}
