oggle strong{font-size:12px}.svg-timeline-line-toggle small{font-size:10px;color:var(--qreports-muted,#687387)}.svg-timeline-length{display:grid!important;grid-template-columns:auto minmax(70px,1fr) 38px;align-items:center;gap:7px;margin:0!important;font-size:12px}.svg-timeline-length input{margin:0!important}.svg-timeline-length output{text-align:right;color:var(--qreports-muted,#687387);font-variant-numeric:tabular-nums}@media(max-width:420px){.svg-visual-choices-four{grid-template-columns:repeat(2,minmax(0,1fr))}}
.svg-visual-choices-four .svg-visual-choice span{grid-template-columns:1fr;justify-items:center;font-size:0;padding-inline:4px}.svg-visual-choices-four .svg-visual-choice span b{font-size:20px}.svg-callout-editor .svg-option-help{margin:-2px 0 0}
.manual-svg-text-field{display:grid;gap:5px;margin:7px 0;padding:7px;border:1px solid var(--qreports-grid,#d5dded);border-radius:8px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230)}
.manual-svg-text-field header{display:grid;grid-template-columns:minmax(0,1fr) auto 28px;align-items:center;gap:6px;min-width:0}
.manual-svg-text-field header b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}
.manual-svg-text-field header small{max-width:120px;overflow:hidden;color:var(--qreports-muted,#687387);font:11px Consolas,monospace;text-overflow:ellipsis;white-space:nowrap}
.manual-svg-text-field header button{width:28px;height:26px;margin:0;padding:2px;color:var(--qreports-text,#182230);background:transparent;border-color:var(--qreports-grid,#d5dded)}
.manual-svg-text-value{height:30px!important;padding:4px 7px!important}
.manual-svg-text-toolbar{display:grid;grid-template-columns:minmax(82px,1fr) 52px 68px 34px;gap:4px;align-items:center}
.manual-svg-text-toolbar :is(input,select){height:30px!important;min-width:0;margin:0!important;padding:3px 6px!important}
.manual-svg-text-toolbar .manual-svg-text-color{width:34px!important;padding:2px!important;cursor:pointer}
.manual-svg-link-row{display:grid;grid-template-columns:18px minmax(0,1fr) auto;align-items:center;gap:4px;min-width:0}.manual-svg-link-row span{color:var(--qreports-muted,#687387);font-size:11px}.manual-svg-link-row input{height:27px!important;min-width:0;margin:0!important;padding:3px 6px!important;font-size:11px!important}.manual-svg-link-row button{width:auto;min-width:27px;height:26px;margin:0;padding:2px 7px;color:var(--qreports-text,#182230);background:color-mix(in srgb,var(--qreports-surface,#fff) 92%,var(--qreports-accent,#4b8dcc) 8%);border-color:var(--qreports-grid,#d5dded)}
.manual-svg-paint-field{display:grid;gap:6px;margin:7px 0;padding:7px;border:1px solid var(--qreports-grid,#d5dded);border-radius:8px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230)}
.manual-svg-paint-field header{display:grid;grid-template-columns:minmax(0,1fr) auto 28px;align-items:center;gap:6px}.manual-svg-paint-field header small{max-width:120px;overflow:hidden;color:var(--qreports-muted,#687387);font:11px Consolas,monospace;text-overflow:ellipsis;white-space:nowrap}.manual-svg-paint-field header button{width:28px;height:26px;margin:0;padding:2px;color:var(--qreports-text,#182230);background:transparent;border-color:var(--qreports-grid,#d5dded)}
.manual-svg-paint-field label{display:grid!important;grid-template-columns:48px minmax(0,1fr);align-items:center;gap:5px;margin:0!important;font-size:12px}.manual-svg-paint-row{display:grid;grid-template-columns:minmax(80px,1fr) 34px;gap:4px}.manual-svg-paint-field label:last-child .manual-svg-paint-row{grid-template-columns:minmax(70px,1fr) 34px 52px}.manual-svg-paint-row input{height:30px!important;min-width:0;margin:0!important;padding:3px 5px!important}.manual-svg-paint-row input[type=color]{width:34px!important;padding:2px!important;cursor:pointer}
@media(max-width:420px){.manual-svg-text-toolbar{grid-template-columns:minmax(80px,1fr) 50px 64px 32px}.manual-svg-text-field header small{display:none}.manual-svg-text-field header{grid-template-columns:minmax(0,1fr) 28px}}
.chart-type-control output{display:block;width:100%;margin-top:5px;padding:8px;border:1px solid #cdd5df;border-radius:7px;background:#f3f6f9;color:#475467;text-transform:capitalize}
html[data-qreports-theme] .app-header .brand strong{color:var(--qreports-header-text)}
html[data-qreports-theme] .app-header .brand small{color:var(--qreports-header-text);opacity:.85}
html[data-qreports-theme] .app-header .file-actions button:not(.primary){color:var(--qreports-header-text);border-color:currentColor;background:transparent}
html[data-qreports-theme] .app-header .file-actions button:not(.primary):hover{background:#00000012}
html[data-qreports-theme] .app-header .file-actions button.primary{color:#fff}
.matrix-conditional-cell{display:grid;grid-template-columns:minmax(0,1fr);align-items:center;margin:-6px -8px;padding:6px 8px;min-height:100%}
.matrix-conditional-content{min-width:0;text-align:inherit}
.matrix-conditional-icon{display:inline-grid;place-items:center;width:1.7em;min-width:1.7em;font-size:1.4em;font-weight:800;line-height:1;vertical-align:middle}
.matrix-conditional-icon-empty{visibility:hidden}
.matrix-conditional-icon-right{grid-template-columns:minmax(0,1fr) 1.7em}
.matrix-conditional-icon-left{grid-template-columns:1.7em minmax(0,1fr)}
.matrix-conditional-icon-right .matrix-conditional-content{grid-column:1}
.matrix-conditional-icon-right .matrix-conditional-icon{grid-column:2}
.matrix-conditional-icon-left .matrix-conditional-icon{grid-column:1}
.matrix-conditional-icon-left .matrix-conditional-content{grid-column:2}
.matrix-conditional-unavailable{color:var(--qreports-muted,#667085);font-size:1em;border:1px dashed currentColor;border-radius:50%}
.matrix-conditional-badge-strength .cell-renderer-badge{background:var(--matrix-badge-strength,var(--cell-renderer-color))!important}
.cell-renderer-icon-right{flex-direction:row-reverse}
.align-menu-wrap{display:flex;align-items:stretch}
.align-menu-wrap>.command:disabled{opacity:.45;cursor:not-allowed}
.align-menu.menu{display:flex;flex-direction:column;gap:0;width:238px;padding:5px;z-index:30}
.align-menu button{display:flex;align-items:center;gap:12px;width:100%;padding:7px 10px;text-align:left;font-size:13px;white-space:nowrap}
.align-menu button span{display:inline-grid;place-items:center;width:20px;min-width:20px;margin:0;color:#3978c3;font-size:18px}
.align-menu button.align-divider{border-top:1px solid #d7dee7;margin-top:4px;padding-top:10px}
.align-menu button:disabled{opacity:.42;cursor:not-allowed}
.tile-pageLink{min-width:80px;min-height:36px}.tile-pageLink .tile-body{padding:0;overflow:visible}.svg-tile-link.page-link{display:flex;width:100%;height:100%;position:relative;color:#f7f9ff;text-decoration:none;background:var(--page-link-background,#19263e);border:2px solid var(--page-link-accent);border-radius:28px;box-shadow:0 8px 20px #07112424}.page-link:hover{filter:brightness(1.1)}.page-link[aria-disabled=true]{cursor:default;opacity:.7}.page-link-card,.page-link-detail{flex-direction:column;padding:20px 22px 16px 26px}.page-link-accent{position:absolute;top:24px;left:14px;width:6px;height:34px;border-radius:4px;background:var(--page-link-accent)}.page-link strong{font-size:clamp(16px,2vw,25px);line-height:1.15;padding-left:14px}.page-link-description{font-size:15px;line-height:1.45;color:#d2def4;margin:12px 0 8px}.page-link b{font-size:12px;color:var(--page-link-accent);margin-top:auto;align-self:flex-end}.page-link-detail{border-radius:18px}.page-link-pill{align-items:center;justify-content:center;border-radius:999px;padding:6px 18px;font-weight:700;font-size:15px;white-space:nowrap}
.page-link-card,.page-link-detail{align-items:stretch;justify-content:var(--page-link-v-align,top);text-align:var(--page-link-h-align,left)}.page-link-copy{display:flex;flex-direction:column;width:100%;min-height:0;gap:10px}.page-link-heading{font-size:24px;font-weight:700;line-height:1.15;padding-left:14px}.page-link-description{margin:0;color:#d2def4}.page-link-action{margin-top:auto;color:var(--page-link-accent);font-size:13px;font-weight:700}.page-link-action:has(p){align-self:stretch}.page-link-action p{text-align:inherit}.page-link-pill{justify-content:var(--page-link-h-align,center);align-items:var(--page-link-v-align,middle)}.page-link-pill-content{display:block;width:100%;text-align:var(--page-link-h-align,center);white-space:normal}.page-link .rich-content p,.page-link .rich-content div{margin:0}.page-link .rich-content br{display:block;content:""}
.page-link-editor-block{margin:10px 0 14px}.page-link-editor-block .field-label{display:block;margin-bottom:5px;color:#c9d8ef;font-weight:600}.page-link-rich-toolbar{display:flex;flex-wrap:wrap;gap:4px;padding:6px;background:#26364b;border:1px solid #425a76;border-radius:8px 8px 0 0}.page-link-rich-toolbar button,.page-link-rich-toolbar select,.page-link-rich-toolbar input{width:auto;min-width:30px;margin:0;padding:4px 6px;background:#192b42;color:#fff;border:1px solid #49607b;border-radius:5px}.page-link-rich-toolbar input[type=number]{width:50px}.page-link-rich-toolbar input[type=color]{width:38px;height:30px;padding:2px}.page-link-rich-editor{min-height:68px;max-height:190px;overflow:auto;padding:9px;background:#fff;color:#17253b;border:1px solid #62758d;border-radius:0 0 8px 8px;line-height:1.4}.page-link-rich-editor:focus{outline:2px solid #82b0ff}.page-link-rich-editor p{margin:0 0 .25em}.page-link-rich-editor p:last-child{margin-bottom:0}
.page-link-action{margin-top:0}.page-link-pill{justify-content:center;align-items:var(--page-link-v-align,center)}
.page-link-rich-editor{background:var(--qreports-surface,#19263e);color:var(--qreports-text,#f7f9ff);border-color:var(--qreports-grid,#62758d)}
.page-link-rich-toolbar{background:color-mix(in srgb,var(--qreports-header,#26364b) 75%,var(--qreports-surface,#fff));border-color:var(--qreports-grid,#425a76)}
.page-link-rich-toolbar button,.page-link-rich-toolbar select,.page-link-rich-toolbar input{background:var(--qreports-surface,#fff);color:var(--qreports-text,#17253b);border-color:var(--qreports-grid,#49607b)}
.page-link-rich-toolbar button:focus-visible,.page-link-rich-toolbar select:focus-visible,.page-link-rich-toolbar input:focus-visible{outline:2px solid var(--qreports-accent,#82b0ff)}
.page-link-theme-choice{display:grid;gap:4px;margin:5px 0 8px;color:var(--qreports-text,#17253b)}
.page-link-theme-text,.page-link-theme-text *{color:var(--page-link-theme-text)!important}
.canvas-ai-dialog{width:min(760px,92vw);max-height:88vh;overflow-y:auto;padding:0;border:1px solid var(--qreports-grid);border-radius:14px;background:var(--qreports-surface);color:var(--qreports-text);box-shadow:0 24px 70px color-mix(in srgb,var(--qreports-text) 42%,transparent)}.canvas-ai-dialog::backdrop{background:color-mix(in srgb,var(--qreports-text) 55%,transparent)}.canvas-ai-dialog form{display:grid;gap:16px;padding:24px}.canvas-ai-dialog h2{margin:0;font-size:25px;color:var(--qreports-text)}.canvas-ai-dialog p{margin:0;line-height:1.5;color:color-mix(in srgb,var(--qreports-text) 78%,var(--qreports-surface))}.canvas-ai-dialog label{display:grid;gap:7px;font-weight:700}.canvas-ai-dialog textarea{width:100%;min-height:125px;box-sizing:border-box;padding:12px;font:15px/1.5 'Segoe UI',sans-serif;resize:vertical;background:var(--qreports-surface);color:var(--qreports-text);border:1px solid var(--qreports-grid);border-radius:8px}.canvas-ai-dialog textarea:focus{outline:2px solid var(--qreports-accent);outline-offset:1px}.canvas-ai-dialog details{padding:11px 14px;border:1px solid var(--qreports-grid);border-radius:8px;background:color-mix(in srgb,var(--qreports-header) 34%,var(--qreports-surface))}.canvas-ai-dialog summary{cursor:pointer;font-weight:700;color:var(--qreports-text)}.canvas-ai-dialog details p{margin-top:9px}.canvas-ai-guide ol{margin:12px 0;padding-left:22px;color:var(--qreports-text);line-height:1.45}.canvas-ai-guide li+li{margin-top:8px}.canvas-ai-guide label{margin-top:14px}.canvas-ai-guide [data-ai-prompt]{min-height:125px;font-size:13px;resize:vertical}.canvas-ai-guide [data-ai="copyPrompt"]{margin-top:9px}.canvas-ai-actions{display:flex;flex-wrap:wrap;gap:8px}.canvas-ai-actions button{width:auto}.canvas-ai-status{min-height:22px;color:var(--qreports-accent)!important}
.canvas-ai-mode-selector{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;padding:5px;border:1px solid var(--qreports-grid);border-radius:11px;background:color-mix(in srgb,var(--qreports-header) 42%,var(--qreports-surface))}.canvas-ai-mode-selector button{min-width:0;padding:10px 8px;border-color:transparent;background:transparent;color:var(--qreports-text);font-weight:700}.canvas-ai-mode-selector button:hover{background:color-mix(in srgb,var(--qreports-accent) 12%,transparent)}.canvas-ai-mode-selector button[aria-pressed=true]{border-color:var(--qreports-accent);background:var(--qreports-accent);color:var(--qreports-on-accent,#fff);box-shadow:0 2px 8px color-mix(in srgb,var(--qreports-accent) 35%,transparent)}.canvas-ai-mode-help{margin-top:-8px!important;font-size:13px}.canvas-ai-mode-help[hidden],[data-ai-modes][hidden]{display:none!important}.canvas-ai-workflows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.canvas-ai-workflows-three{grid-template-columns:repeat(3,minmax(0,1fr))}.canvas-ai-workflows section{padding:10px;border:1px solid var(--qreports-grid);border-radius:8px;background:var(--qreports-surface)}.canvas-ai-workflows h3{margin:0;font-size:14px}.canvas-ai-workflows ol{font-size:13px}.canvas-ai-actions>div{display:flex;align-items:center;flex-wrap:wrap;gap:7px}.canvas-ai-actions strong{flex-basis:100%;font-size:12px;color:color-mix(in srgb,var(--qreports-text) 68%,var(--qreports-surface))}@media(max-width:720px){.canvas-ai-mode-selector,.canvas-ai-workflows-three{grid-template-columns:1fr}.canvas-ai-mode-selector{gap:3px}}
.canvas-ai-queue{padding:10px 12px;border:1px solid var(--qreports-grid);border-radius:9px;background:color-mix(in srgb,var(--qreports-header) 28%,var(--qreports-surface))}.canvas-ai-queue[hidden]{display:none}.canvas-ai-queue>header{display:flex;justify-content:space-between;gap:12px;margin-bottom:7px}.canvas-ai-queue>header span{font-size:12px;color:color-mix(in srgb,var(--qreports-text) 66%,var(--qreports-surface))}.canvas-ai-queue ol{display:grid;gap:5px;margin:0;padding:0;list-style:none}.canvas-ai-queue li{display:grid;grid-template-columns:58px minmax(0,1fr);align-items:center;gap:8px;min-width:0;padding:6px 8px;border-radius:6px;background:var(--qreports-surface);font-size:13px}.canvas-ai-queue li>span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.canvas-ai-queue-state{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--qreports-accent)}.canvas-ai-queue li.running{box-shadow:inset 3px 0 var(--qreports-accent)}.canvas-ai-queue li.error{box-shadow:inset 3px 0 var(--qreports-negative,#c64d55)}.canvas-ai-queue li.error .canvas-ai-queue-state{color:var(--qreports-negative,#c64d55)}
.compact-format-panel{margin:12px 0;padding:8px;border:1px solid #4d627d;border-radius:10px;background:#26354d}.compact-format-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:5px}.compact-format-toolbar button,.compact-format-toolbar select,.compact-format-toolbar input{margin:0;height:34px;min-width:0;padding:4px 7px;border:1px solid #4d6480;border-radius:6px;background:#192a42;color:#f8fbff}.compact-format-toolbar button{width:35px;font-size:17px}.compact-format-toolbar button[aria-pressed="true"]{background:#506fbd;border-color:#90aaff;color:#fff}.compact-format-toolbar [data-format-slot="fontFamily"]{flex:1 1 118px}.compact-format-toolbar [data-format-slot="fontFamily"] select{width:100%}.compact-format-toolbar [data-format-slot="fontSize"] input{width:54px}.compact-format-toolbar [data-format-slot="textColor"] input,.compact-format-toolbar [data-format-slot="background"] input{width:40px;padding:3px;cursor:pointer}.compact-format-toolbar [data-format-slot="textColor"]:before,.compact-format-toolbar [data-format-slot="background"]:before{display:block;font-size:10px;line-height:1;color:#d0ddf2}.compact-format-toolbar [data-format-slot="textColor"]:before{content:"Text"}.compact-format-toolbar [data-format-slot="background"]:before{content:"Fill"}.compact-format-hidden{display:none}.compact-format-preview{margin-top:8px;min-height:58px;padding:12px;border:1px solid #71819a;border-radius:6px;overflow:hidden;white-space:normal;line-height:1.35}
.compact-format-panel{background:color-mix(in srgb,var(--qreports-header,#26354d) 75%,var(--qreports-surface,#fff));border-color:var(--qreports-grid,#4d627d)}
.compact-format-toolbar button,.compact-format-toolbar select,.compact-format-toolbar input{background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);border-color:var(--qreports-grid,#4d6480)}
.compact-format-toolbar button[aria-pressed="true"]{background:var(--qreports-accent,#506fbd);border-color:var(--qreports-accent,#506fbd);color:var(--qreports-on-accent,#fff)}
.compact-format-toolbar [data-format-slot="textColor"]:before,.compact-format-toolbar [data-format-slot="background"]:before{color:var(--qreports-text,#182230)}
.compact-format-preview{border-color:var(--qreports-grid,#71819a)}
.header-theme-controls{padding:8px 2px;color:var(--qreports-text,#182230)}
.header-theme-roles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:6px}
.header-theme-roles select{width:100%;min-width:0}
.svg-template-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;max-height:310px;overflow:auto;margin:8px 0 14px}.svg-template-gallery button{display:grid;grid-template-columns:56px 1fr;align-items:center;gap:8px;min-width:0;padding:5px;text-align:left;font-size:12px}.svg-template-gallery button[aria-pressed=true]{border-color:var(--qreports-accent,#6b8ce8);background:color-mix(in srgb,var(--qreports-accent,#6b8ce8) 16%,var(--qreports-surface,#fff));box-shadow:0 0 0 1px var(--qreports-accent,#6b8ce8);color:var(--qreports-text,#182230)}.svg-template-gallery svg{width:54px;height:34px;overflow:hidden}.svg-template-gallery span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.commandbar{z-index:3000}.app-header{position:relative;z-index:3100}.tile-context-menu{z-index:3200}.connector-object.selected{z-index:2500!important}.connector-quick-tools{z-index:2600}
.layout-tile-dialog{width:min(560px,92vw);max-height:82vh;padding:0;border:1px solid var(--qreports-grid,#cdd5df);border-radius:14px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);box-shadow:0 24px 70px #0006}.layout-tile-dialog::backdrop{background:#08112099}.layout-tile-dialog form{display:grid;gap:14px;padding:20px}.layout-tile-dialog header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.layout-tile-dialog h3{margin:0 0 3px;font-size:22px}.layout-tile-dialog p{margin:0;color:var(--qreports-muted,#687387);font-size:13px}.layout-tile-dialog header>button{width:36px;height:36px;padding:0;font-size:21px}.layout-tile-dialog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;overflow:auto}.layout-tile-dialog-grid button{display:grid;grid-template-columns:30px minmax(0,1fr);align-items:center;gap:8px;min-height:54px;padding:8px 10px;text-align:left;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 5%,var(--qreports-surface,#fff));color:var(--qreports-text,#182230);border-color:var(--qreports-grid,#cdd5df)}.layout-tile-dialog-grid button:hover{border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 15%,var(--qreports-surface,#fff))}.layout-tile-dialog-grid b{display:grid;place-items:center;color:var(--qreports-accent,#4f6ee8);font-size:20px}.layout-tile-dialog-grid span{overflow:hidden;text-overflow:ellipsis}.layout-tile-dialog footer{display:flex;justify-content:flex-end;border-top:1px solid var(--qreports-grid,#cdd5df);padding-top:12px}@media(max-width:520px){.layout-tile-dialog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.component-menu.menu{display:block;width:290px;max-height:min(470px,calc(100vh - 150px));overflow:auto;padding:8px}.component-menu>button[data-component-save]{width:100%;font-size:13px;font-weight:700}.component-menu-heading{padding:10px 4px 5px;color:#637087;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.component-menu-row{display:flex;align-items:stretch;gap:4px;margin:3px 0}.component-menu-row button{font-size:13px}.component-menu-row [data-component-insert]{display:flex;align-items:center;gap:8px;flex:1;min-width:0}.component-menu-row [data-component-insert] span{font-size:18px;margin:0}.component-menu-row [data-component-remove]{width:32px;padding:4px;color:#a23b37}.component-menu-empty,.component-menu-note{font-size:11px;color:#69768a;margin:6px 4px}.svg-manual-thumb{display:grid;place-items:center;width:54px;height:34px;font:700 17px Consolas,monospace;background:#e7edf6;border-radius:5px}
.tile-context-menu{max-height:calc(100vh - 16px);overflow-y:auto}
.brand-mark{width:40px;height:40px;border-radius:10px;overflow:hidden;background:#15253d;box-shadow:0 2px 8px #07111f66}
.brand-mark img{display:block;width:100%;height:100%;object-fit:cover}
.brand strong{letter-spacing:.01em}
.canvas{background-image:linear-gradient(#d9d9d9 1px,transparent 1px),linear-gradient(90deg,#d9d9d9 1px,transparent 1px)}
