(()=>{
const editor=$('expression'),highlight=$('expressionHighlight'),box=$('daxAutocomplete');
const functions=[
['SUM','SUM(column [, filter])','Adds numeric values in the current context.','SUM(SalesAmount)'],['AVERAGE','AVERAGE(column [, filter])','Returns the arithmetic mean. AVG is an alias.','AVERAGE(Margin)'],['COUNT','COUNT(column [, filter])','Counts non-empty values, including text and dates.','COUNT(OrderId)'],['DISTINCTCOUNT','DISTINCTCOUNT(column)','Counts unique non-empty values.','DISTINCTCOUNT(CustomerId)'],['MIN','MIN(column [, filter])','Returns the earliest date, smallest number, or first text value.','MIN(OrderDate)'],['MAX','MAX(column [, filter])','Returns the latest date, largest number, or last text value.','MAX(OrderDate)'],['FIRST','FIRST(column [, filter])','Returns the first non-empty value in row order.','FIRST(Status)'],['LAST','LAST(column [, filter])','Returns the last non-empty value in row order.','LAST(Status)'],['SELECTEDVALUE','SELECTEDVALUE(column [, alternate])','Returns the single value in context, otherwise alternate or blank.','SELECTEDVALUE(Status, "Multiple")'],
['CALCULATE','CALCULATE(expression, filters…)','Evaluates an expression with modified simple column filters.','CALCULATE(SUM(Sales), Region = "Europe")'],['ALL','ALL([columns…])','Inside CALCULATE, clears all filters or the listed column filters.','CALCULATE(SUM(Sales), ALL(Region))'],['REMOVEFILTERS','REMOVEFILTERS(columns…)','Inside CALCULATE, clears filters from listed columns.','CALCULATE(SUM(Sales), REMOVEFILTERS(year))'],
['IF','IF(condition, trueValue [, falseValue])','Returns one of two values.','IF(Margin > 0, "Profit", "Loss")'],['SWITCH','SWITCH(expression, value, result… [, else])','Matches several conditions or values.','SWITCH(TRUE(), Score > 90, "A", "Other")'],['TRUE','TRUE()','Returns logical true.','IF(TRUE(), 1, 0)'],['FALSE','FALSE()','Returns logical false.','IF(FALSE(), 1, 0)'],['BLANK','BLANK()','Returns an empty value.','IF(Amount = 0, BLANK(), Amount)'],
['DIVIDE','DIVIDE(numerator, denominator)','Divides safely; zero returns blank.','DIVIDE(Profit, Revenue)'],['ROUND','ROUND(value, digits)','Rounds halves away from zero.','ROUND(Margin, 2)'],['ROUNDUP','ROUNDUP(value, digits)','Rounds away from zero.','ROUNDUP(Margin, 2)'],['ROUNDDOWN','ROUNDDOWN(value, digits)','Rounds towards zero.','ROUNDDOWN(Margin, 2)'],['NEGATE','NEGATE(value)','Reverses the sign. NEG and REVERSE_SIGN are aliases.','NEGATE(Amount)'],['RANK','RANK(value [, ASC|DESC] [, DENSE|SKIP])','Ranks aggregated matrix values.','RANK(Sales, DESC, SKIP)'],
['FORMAT','FORMAT(value, format)','Formats a number or date as text.','FORMAT(TODAY(), "yyyy-MM-dd")'],['CONCATENATE','CONCATENATE(value1, value2, …)','Joins values as text. The & operator is also supported.','CONCATENATE(Region, " - ", Status)'],['CONCATVALUES','CONCATVALUES(column [, separator, maxCount, distinct])','Joins values from filtered rows. Distinct defaults to true.','CONCATVALUES(Group, ", ", 10, TRUE())'],['CONTAINSSTRING','CONTAINSSTRING(text, findText)','Tests whether text contains another value, ignoring case.','CONTAINSSTRING(Description, "urgent")'],['UPPER','UPPER(text)','Converts text to uppercase.','UPPER(Region)'],['LOWER','LOWER(text)','Converts text to lowercase.','LOWER(Region)'],['LEFT','LEFT(text, count)','Returns characters from the left.','LEFT(Code, 3)'],['RIGHT','RIGHT(text, count)','Returns characters from the right.','RIGHT(Code, 2)'],['MID','MID(text, start, length)','Returns part of text; start is one-based.','MID(AccountCode, 2, 3)'],['CAST','CAST(value, type)','Converts to DATE, DATETIME, TEXT, INTEGER, NUMBER or BOOLEAN.','CAST(DateText, DATE)'],
['TODAY','TODAY()','Returns the current local date.','TODAY()'],['YEAR','YEAR(date)','Returns the four-digit year.','YEAR(TODAY())'],['MONTH','MONTH(date)','Returns the month number from 1 to 12.','MONTH(TODAY())'],['DAY','DAY(date)','Returns the day of month from 1 to 31.','DAY(TODAY())'],['WEEK','WEEK(date)','Returns the week number using Monday as the first day.','WEEK(TODAY())'],['DATEPART','DATEPART(part, date)','Returns year, quarter, month, day, dayofyear, week, weekday, hour, minute or second.','DATEPART(month, OrderDate)'],['DATEFROMPARTS','DATEFROMPARTS(year, month, day)','Creates a date from numeric parts.','DATEFROMPARTS(2026, 9, 15)'],['DATEOFFSET','DATEOFFSET(date, years, months, days, weeks)','Offsets a date.','DATEOFFSET(TODAY(), 0, 1, 0, 0)']];
window.MiniDaxFunctionCatalog=functions;
const fnNames=new Set(functions.map(x=>x[0])),keywords=new Set(['VAR','RETURN','AND','OR','NOT','TRUE','FALSE','IN']);let items=[],active=0;
const escape=v=>String(v??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
function token(){return editor.value.slice(0,editor.selectionStart).match(/[A-Za-z_][A-Za-z0-9_]*$/)?.[0]||''}
function paint(){const source=editor.value,pattern=/("(?:""|[^"])*"|\b\d+(?:\.\d+)?\b|\b[A-Za-z_][A-Za-z0-9_]*\b)/g;let out='',last=0,m;const columns=new Set((data?.columns||[]).map(columnName));const vars=new Set([...source.matchAll(/\bVAR\s+([A-Za-z_][A-Za-z0-9_]*)/gi)].map(x=>x[1].toUpperCase()));while((m=pattern.exec(source))){out+=escape(source.slice(last,m.index));const value=m[0],upper=value.toUpperCase();let cls=value.startsWith('"')?'dax-string':/^\d/.test(value)?'dax-number':fnNames.has(upper)?'dax-function':keywords.has(upper)?'dax-keyword':vars.has(upper)?'dax-variable':columns.has(value)?'dax-column':'';out+=cls?`<span class="${cls}">${escape(value)}</span>`:escape(value);last=pattern.lastIndex}highlight.innerHTML=out+escape(source.slice(last))+'\n';highlight.scrollTop=editor.scrollTop;highlight.scrollLeft=editor.scrollLeft}
function candidates(prefix='',limit=18){const vars=[...editor.value.matchAll(/\bVAR\s+([A-Za-z_][A-Za-z0-9_]*)/gi)].map(x=>({text:x[1],kind:'variable'})),columns=(data?.columns||[]).map(columnName).map(text=>({text,kind:'column'})),metrics=(measures||[]).map(x=>({text:x.Name,kind:+x.Kind===1?'calculated column':'measure'})),fns=functions.map(x=>({text:x[0],signature:x[1],description:x[2],kind:'function'}));return [...vars,...columns,...metrics,...fns].filter((x,i,a)=>x.text.toLowerCase().includes(prefix.toLowerCase())&&a.findIndex(y=>y.text.toLowerCase()===x.text.toLowerCase())===i).slice(0,limit)}
function positionAutocomplete(){const before=editor.value.slice(0,editor.selectionStart),lines=before.split('\n'),line=lines.at(-1).replace(/\t/g,'    '),style=getComputedStyle(editor),canvas=positionAutocomplete.canvas||(positionAutocomplete.canvas=document.createElement('canvas')),context=canvas.getContext('2d'),lineHeight=parseFloat(style.lineHeight)||22,paddingLeft=parseFloat(style.paddingLeft)||12,paddingTop=parseFloat(style.paddingTop)||12;context.font=style.font;let left=paddingLeft+context.measureText(line).width-editor.scrollLeft+8,top=paddingTop+lines.length*lineHeight-editor.scrollTop+3;left=Math.max(8,Math.min(editor.clientWidth-box.offsetWidth-8,left));top=Math.max(8,Math.min(editor.clientHeight-10,top));box.style.left=`${left}px`;box.style.top=`${top}px`}
function show(force=false){const prefix=token();if(!force&&prefix.length<1){box.classList.add('hidden');return}items=candidates(force?'':prefix,force?80:18);active=0;box.innerHTML=items.map((x,i)=>`<button class="${i?'':'active'}" data-dax-complete="${i}"><span><b>${escape(x.text)}</b>${x.signature?`<em>${escape(x.signature)}</em>`:''}</span><small>${x.kind}</small></button>`).join('');box.classList.toggle('hidden',!items.length);box.querySelectorAll('button').forEach(b=>b.onmousedown=e=>{e.preventDefault();accept(+b.dataset.daxComplete)});if(items.length)requestAnimationFrame(positionAutocomplete)}
function insertFunction(name,start=editor.selectionStart,end=editor.selectionEnd){const selection=editor.value.slice(start,end),text=`${name}(${selection})`;editor.setRangeText(text,start,end,'end');if(!selection)editor.setSelectionRange(start+name.length+1,start+name.length+1)}
function accept(index=active){const item=items[index];if(!item)return;const end=editor.selectionStart,start=item.kind==='function'?end-token().length:end-token().length;if(item.kind==='function')insertFunction(item.text,start,end);else editor.setRangeText(item.text,start,end,'end');box.classList.add('hidden');editor.focus();paint();editor.dispatchEvent(new Event('input',{bubbles:true}))}
function move(delta){active=(active+delta+items.length)%items.length;box.querySelectorAll('button').forEach((b,i)=>b.classList.toggle('active',i===active))}
function indentSelection(outdent=false){const text=editor.value,start=editor.selectionStart,end=editor.selectionEnd,lineStart=text.lastIndexOf('\n',Math.max(0,start-1))+1;if(start===end&&!outdent){editor.setRangeText('\t',start,end,'end');paint();box.classList.add('hidden');editor.dispatchEvent(new Event('input',{bubbles:true}));return}const block=text.slice(lineStart,end),lines=block.split('\n');let removedBeforeStart=0,totalRemoved=0;const changed=lines.map((line,index)=>{if(!outdent)return`\t${line}`;const match=line.match(/^(\t| {1,4})/),count=match?.[0].length||0;if(index===0)removedBeforeStart=count;totalRemoved+=count;return line.slice(count)}).join('\n');editor.setRangeText(changed,lineStart,end,'start');if(outdent){editor.selectionStart=Math.max(lineStart,start-removedBeforeStart);editor.selectionEnd=Math.max(editor.selectionStart,end-totalRemoved)}else{editor.selectionStart=start+1;editor.selectionEnd=end+lines.length}paint();box.classList.add('hidden');editor.dispatchEvent(new Event('input',{bubbles:true}))}
editor.addEventListener('input',()=>{paint();show();const validation=$('validation');validation.className='validation';validation.textContent='Formula changed. Validate or test to refresh the result.'});editor.addEventListener('scroll',()=>{paint();if(!box.classList.contains('hidden'))positionAutocomplete()});editor.addEventListener('keydown',e=>{if(e.ctrlKey&&e.code==='Space'){e.preventDefault();show(true)}else if(!box.classList.contains('hidden')&&e.key==='ArrowDown'){e.preventDefault();move(1)}else if(!box.classList.contains('hidden')&&e.key==='ArrowUp'){e.preventDefault();move(-1)}else if(!box.classList.contains('hidden')&&(e.key==='Tab'||e.key==='Enter')&&!e.shiftKey){e.preventDefault();accept()}else if(e.key==='Tab'){e.preventDefault();indentSelection(e.shiftKey)}else if(e.key==='Escape')box.classList.add('hidden')});
const formulaLabel=editor.closest('.formula-label'),formulaTitle=formulaLabel?.querySelector(':scope > span');if(formulaLabel&&formulaTitle){const heading=document.createElement('span'),helper=document.createElement('button');heading.className='formula-heading';helper.id='expressionFunctionHelper';helper.type='button';helper.className='expression-function-helper';helper.textContent='ƒx';helper.title='Insert a MiniDAX function (Ctrl+Space)';helper.setAttribute('aria-label','Insert a MiniDAX function');formulaTitle.replaceWith(heading);heading.append(formulaTitle,helper);helper.onclick=event=>{event.preventDefault();editor.focus();show(true)}}
const pane=$('daxFunctionsPane'),search=$('daxFunctionSearch');function renderHelp(){const q=search.value.toLowerCase(),filtered=functions.filter(x=>x.join(' ').toLowerCase().includes(q));$('daxFunctionList').innerHTML=filtered.map(x=>`<div class="dax-function-card" data-help-function="${functions.indexOf(x)}" tabindex="0" role="button" title="Insert ${escape(x[0])}"><b>${x[0]}</b><code>${escape(x[1])}</code><p>${escape(x[2])}</p><small>Example: ${escape(x[3])}</small></div>`).join('');pane.querySelectorAll('[data-help-function]').forEach(card=>{const insert=()=>{const item=functions[+card.dataset.helpFunction];insertFunction(item[0]);editor.focus();paint();editor.dispatchEvent(new Event('input',{bubbles:true}))};card.onclick=insert;card.onkeydown=event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();insert()}}})}
$('showDaxFunctions').onclick=()=>{const open=$('layout').classList.toggle('functions-open');if(open)renderHelp()};$('closeDaxFunctions').onclick=()=>$('layout').classList.remove('functions-open');search.oninput=renderHelp;
const functionSplitter=$('daxFunctionsSplitter');functionSplitter.onpointerdown=event=>{event.preventDefault();const layout=$('layout'),startX=event.clientX,start=parseFloat(getComputedStyle(layout).getPropertyValue('--functions'))||380;functionSplitter.setPointerCapture(event.pointerId);functionSplitter.onpointermove=move=>layout.style.setProperty('--functions',`${Math.max(260,Math.min(650,start-(move.clientX-startX)))}px`);functionSplitter.onpointerup=()=>functionSplitter.onpointermove=null};
new MutationObserver(paint).observe($('measureList'),{childList:true,subtree:true});paint();
})();
