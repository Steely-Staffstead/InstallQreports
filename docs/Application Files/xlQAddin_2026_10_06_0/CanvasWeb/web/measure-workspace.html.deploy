<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Measures</title><link rel="stylesheet" href="measure-workspace.css?v=20261005-audit-progress"><link rel="stylesheet" href="measure-workspace-menu.css?v=2"><link rel="stylesheet" href="workspace-theme-header.css?v=20260918-2"><script src="shared-settings.js?v=20261005-runes-header"></script></head><body>
<header><div class="brand"><span data-experience-icon="measures">Q</span><div><strong data-experience-label="measureEditor">Measures</strong><small>Create, validate and test MiniDAX measures and calculated columns</small></div></div><nav><button id="newMeasure">＋ New</button><button id="renameMeasure" type="button" title="Rename the selected measure and update dependent references">Rename</button><button id="showDaxFunctions">Functions</button><button id="validate" class="run">✓ Validate</button><button id="save" class="primary">Save</button><button id="delete">Delete</button><details class="toolbar-tools"><summary>Tools <span aria-hidden="true">▾</span></summary><div><button id="loadData" type="button">Load data</button><button id="duplicateMeasure" type="button" title="Duplicate the selected measure in its folder">Duplicate</button><button id="auditMeasures" type="button" title="Validate every measure and list broken references or formulas">Audit all</button></div></details><button id="apply" class="primary">Return measures</button><button id="close">Close</button></nav></header>
<main id="layout"><aside id="fieldsPane"><div class="pane-head"><h2>Fields</h2><button class="collapse" data-collapse="fields" title="Hide fields">‹</button></div><div class="pane-body"><p id="dataStatus">Data is not loaded. Measures remain editable.</p><input id="fieldSearch" placeholder="Search fields"><div id="fields"></div></div><button class="pane-tab" data-expand="fields">Fields</button></aside><div class="side-splitter" data-resize="fields" title="Resize fields pane"></div>
<section id="measuresPane" class="measures"><div class="pane-head"><h2 data-experience-label="measures">Measures</h2><button class="collapse" data-collapse="measures" title="Hide measures">‹</button></div><div class="pane-body"><div class="measure-list-tools"><input id="measureSearch" placeholder="Search measures or folders"><button id="newFolder" type="button" title="Create a folder for the selected measure">＋ Folder</button></div><div id="measureList"></div></div><button class="pane-tab" data-expand="measures" data-experience-label="measures">Measures</button></section><div class="side-splitter" data-resize="measures" title="Resize measures pane"></div>
<section class="workspace"><div class="editor-head"><label>Name<input id="name" placeholder="Measure or column name"></label><label>Folder<input id="folder" list="measureFolderSuggestions" placeholder="Unfiled · use / for subfolders"><datalist id="measureFolderSuggestions"></datalist></label><span id="status">Ready</span></div><label class="formula-label"><span>Expression</span><div class="dax-editor"><pre id="expressionHighlight" aria-hidden="true"></pre><textarea id="expression" spellcheck="false" autocomplete="off" placeholder="SUM(amount)"></textarea><div id="expressionResizeHandle" class="expression-resize-handle" title="Resize expression editor" aria-label="Resize expression editor"></div><div id="daxAutocomplete" class="dax-autocomplete hidden"></div></div></label><div id="validation" class="validation">Select or create a measure.</div><div class="matrix-builder"><div class="matrix-zone matrix-zone-rows"><h3>Rows</h3><div id="rows" class="dropzone" data-zone="rows" data-empty-label="Drag fields here"></div></div><div class="matrix-zone matrix-zone-columns"><h3>Columns <small>(maximum 1)</small></h3><div id="columns" class="dropzone" data-zone="columns" data-empty-label="Drag a field here"></div></div><div class="matrix-zone matrix-zone-values"><h3>Values</h3><div id="values" class="dropzone" data-zone="values" data-empty-label="Drag measures here"></div></div><div class="matrix-test-actions"><label><input id="testOnChanges" type="checkbox"> Test on changes</label><button id="testMatrix" class="run">Test matrix</button></div></div><div id="matrixSplitter" class="matrix-splitter" title="Resize matrix result"><span></span></div><div class="result-head"><span>MATRIX RESULT</span><span id="resultCount"></span></div><div class="result"><table><thead id="resultHead"></thead><tbody id="resultBody"></tbody></table></div></section><div id="daxFunctionsSplitter" class="dax-functions-splitter" title="Resize function reference"></div><aside id="daxFunctionsPane" class="dax-functions-pane"><div><h2>Function reference</h2><button id="closeDaxFunctions">×</button></div><input id="daxFunctionSearch" placeholder="Search functions"><div id="daxFunctionList"></div></aside></main>
<dialog id="folderDialog" class="measure-folder-dialog"><form method="dialog"><h2 id="folderDialogTitle">Measure folder</h2><p>Use / to create subfolders. Folders organize measures without changing their names or formulas.</p><label>Folder path<input id="folderDialogName" maxlength="120" placeholder="Profit and loss/Revenue"></label><div class="folder-dialog-actions"><button value="cancel">Cancel</button><button class="primary" value="apply">Save folder</button></div></form></dialog>
<dialog id="measureAuditDialog" class="measure-audit-dialog"><form method="dialog"><header><div><h2>Measure audit</h2><p id="measureAuditSummary"></p></div><button value="close" aria-label="Close">×</button></header><div id="measureAuditProgress" class="measure-audit-progress" role="status" aria-live="polite"><progress id="measureAuditProgressBar" max="1" value="0"></progress><span id="measureAuditProgressText">0 / 0 · 0%</span></div><div id="measureAuditResults"></div><footer><button value="close">Close</button></footer></form></dialog><div id="columnMenu" class="menu hidden"></div><div id="fieldMenu" class="menu field-menu hidden"></div><div id="toast" class="toast hidden"></div><link rel="stylesheet" href="measure-workspace-editor.css?v=20260930-resize"><link rel="stylesheet" href="measure-workspace-theme.css?v=20261005-audit-progress"><link rel="stylesheet" href="measure-workspace-live-test.css?v=20260927-1"><link rel="stylesheet" href="measure-workspace-zones.css?v=20260928-1"><link rel="stylesheet" href="measure-workspace-folders.css?v=20260927-1"><script src="measure-references.js?v=20261005-audit-rename"></script><script src="measure-workspace.js?v=20261007-text-format-1"></script><script src="measure-workspace-folders.js?v=20260927-duplicate-1"></script><script src="measure-workspace-editor.js?v=20261002-date-format"></script><script src="measure-workspace-live-test.js?v=20260928-reuse-data"></script><script src="measure-workspace-audit.js?v=20261005-progress"></script></body></html>
