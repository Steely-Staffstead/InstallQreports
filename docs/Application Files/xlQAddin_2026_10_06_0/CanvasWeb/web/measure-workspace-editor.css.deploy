.dax-editor{position:relative;min-height:0}
.formula-heading{display:flex;align-items:center;justify-content:space-between;gap:8px}
.expression-function-helper{min-width:34px;padding:2px 8px;border-radius:6px;font-weight:700;line-height:1.35}
.dax-editor pre,.dax-editor textarea{position:absolute;inset:0;margin:0;padding:12px;border-radius:8px;font:14px/1.55 Consolas,monospace;white-space:pre-wrap;overflow:auto}
.dax-editor pre{pointer-events:none;border:1px solid #cbd5e5;background:#fff;color:#1d2942}
.dax-editor textarea{z-index:1;resize:none;min-height:0;background:transparent;color:transparent;caret-color:#17213c;-webkit-text-fill-color:transparent}
.expression-resize-handle{position:absolute;z-index:3;right:2px;bottom:2px;width:20px;height:20px;cursor:ns-resize;border-right:3px solid #8a98b6;border-bottom:3px solid #8a98b6;border-radius:0 0 5px 0;opacity:.75}
.dax-editor textarea::selection{background:#b9caf0;color:#17213c;-webkit-text-fill-color:#17213c}
.dax-keyword{color:#315bc9;font-weight:700}.dax-function{color:#8a2aa8}.dax-variable{color:#087e70}.dax-column{color:#a04c12}.dax-string{color:#208040}.dax-number{color:#b14949}
.dax-autocomplete{position:absolute;z-index:20;left:12px;top:46px;width:min(430px,90%);max-height:240px;overflow:auto;background:white;border:1px solid #aab8d1;border-radius:8px;box-shadow:0 10px 28px #17213c33}
.dax-autocomplete button{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;border:0;border-radius:0;text-align:left;padding:7px 10px;background:#fff;color:#17213d}
.dax-autocomplete button span{min-width:0;display:grid;gap:2px}.dax-autocomplete button b{font-weight:700}.dax-autocomplete button em{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#68758d;font:11px Consolas,monospace;font-style:normal}
.dax-autocomplete button.active{background:#e7edff;color:#183b78}
.dax-autocomplete small{color:#75819a}
.dax-functions-pane{min-width:0;padding:16px;background:#f8faff;border-left:1px solid #cbd5e5;overflow:auto}
.dax-functions-pane>div:first-child{display:flex;justify-content:space-between;align-items:center}
.dax-functions-pane input{width:100%;padding:9px;border:1px solid #cbd5e5;border-radius:8px}
.dax-functions-splitter{display:none;background:#dce3ef;border-left:1px solid #c6d0df;border-right:1px solid #c6d0df;cursor:col-resize}
#layout.functions-open{--functions:380px;grid-template-columns:var(--fields) 6px var(--measures) 6px minmax(430px,1fr) 6px var(--functions)}
#layout:not(.functions-open) .dax-functions-pane{display:none}
#layout.functions-open .dax-functions-splitter{display:block}
.dax-function-card{padding:10px 2px;border-bottom:1px solid #dce3ef;cursor:pointer}.dax-function-card b,.dax-function-card code{display:block}.dax-function-card p{margin:5px 0;color:#53617b;font-size:13px}
