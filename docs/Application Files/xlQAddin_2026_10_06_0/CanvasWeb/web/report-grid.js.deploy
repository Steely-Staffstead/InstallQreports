    const maximumSpan=grid.columns.length-position.column,spanHtml=maximumSpan>1?`<label>Span columns<input data-grid-property="spanColumns" type="number" min="1" max="${maximumSpan}" value="${cellSpan(grid,position)}"><small>Covered cells keep their contents. Set 1 to show them again.</small></label>`:'';
    return `<div class="report-grid-sheet-editor"><h4>Cell content</h4><div class="report-grid-input-mode" role="group" aria-label="Cell content type"><button type="button" data-grid-input-mode="measure" aria-pressed="${mode==='measure'}">Measure</button><button type="button" data-grid-input-mode="formula" aria-pressed="${mode==='formula'}">Formula / text</button></div>${mode==='measure'?`<label>Source<select data-grid-property="source"><option value="" ${cell.sourceId?'':'selected'}>Inherit from row / column</option>${sources.map(source=>`<option value="${escape(source.id)}" ${cell.sourceId===source.id?'selected':''}>${escape(source.name)}</option>`).join('')}</select></label><label>Measure<select data-grid-property="measure"><option value="">Choose measure…</option>${measures.map(metric=>`<option value="${escape(metric.Name)}" ${cell.measure===metric.Name?'selected':''}>${escape(metric.Name)}</option>`).join('')}</select></label>`:`<label>Text / formula<input data-grid-property="formula" value="${escape(cellEntry(grid,position))}" placeholder="Text or =B2+C2"><small>Plain text needs no =. Start with = for a formula; click a cell for one address, or drag across cells for a range.</small></label>${formulaGuideHtml()}`}${spanHtml}${numberFormatHtml(cell.format,'data-grid-property="format"','data-grid-custom-format',context.format)}</div>`;
  }
  function selectedFormatCells(grid,tile){return activeCells().filter(position=>position.tileId===tile?.id&&validPosition(grid,position));}
  function multiFormatHtml(grid,tile,context){const positions=selectedFormatCells(grid,tile),first=positions[0],style=effectiveStyle(grid,first),cell=sheetCell(grid,first);return `<p class="report-grid-selected-label">${positions.length} cells selected</p><p class="property-empty">Formatting changes apply to every selected cell. Ctrl-click cells, rows, or columns to adjust the selection.</p>${numberFormatHtml(cell?.format,'data-grid-property="format"','data-grid-custom-format',context.format)}<h4>Cell formatting</h4>${themeEditorHtml(style,context)}${formatToolbarHtml(style,`${positions.length} cells`,context)}${borderEditorHtml(style,context)}`;}
  function renderProperties(container,tile,context) {
    propertyContext=context;
     let viewPanel=container.querySelector('#reportGridViewProperties');
    if(!viewPanel){
      viewPanel=document.createElement('details');viewPanel.id='reportGridViewProperties';viewPanel.open=true;
      viewPanel.innerHTML='<summary>Grid view</summary><div data-report-grid-view-properties></div>';
      viewPanel.addEventListener('change',event=>{const current=propertyContext.tile();if(!current?.reportGrid)return;const spacing=event.target.dataset.gridSpacing;if(spacing){current.reportGrid[spacing]=Math.max(0,Math.min(120,Number(event.target.value)||0));event.target.blur();propertyContext.change();return;}const key=event.target.dataset.gridViewOption;if(!key)return;setGridViewOption(current.reportGrid,key,event.target.checked);propertyContext.change();});
      viewPanel.addEventListener('click',event=>{if(!event.target.closest('[data-grid-upgrade-sheet]'))return;const current=propertyContext.tile();if(current?.reportGrid&&upgradeSheet(current.reportGrid))propertyContext.change();});
      container.prepend(viewPanel);
    }
     let controlsPanel=container.querySelector('#reportGridControls');
     if(!controlsPanel){
       controlsPanel=document.createElement('details');controlsPanel.id='reportGridControls';controlsPanel.open=true;
       controlsPanel.innerHTML='<summary>Grid controls</summary><div data-report-grid-controls></div>';
       controlsPanel.addEventListener('click',event=>{const current=propertyContext?.tile(),grid=current?.reportGrid,position=selectedCell;if(!grid||!validPosition(grid,position)||position.tileId!==current.id)return;const command=event.target.closest('[data-grid-command]')?.dataset.gridCommand;if(activeCells().length>1&&command!=='cut'&&command!=='paste')return;const auto=event.target.closest('[data-grid-auto]');if(auto){if(position.column<0&&auto.dataset.gridAuto==='column')delete grid.labelColumnWidth;else if(auto.dataset.gridAuto==='column')delete grid.columns[position.column].width;else if(position.row<0)delete grid.headerRowHeight;else delete grid.rows[position.row].height;propertyContext.change();return;}if(command&&gridCommand(grid,position,command)){if(['insert-row','insert-column','row-up','row-down','column-left','column-right'].includes(command))rememberGridAction({type:'command',command});if(command.startsWith('copy-')||command==='cut')renderProperties(controlsPanel.parentElement,current,propertyContext);else propertyContext.change();}});
       controlsPanel.addEventListener('change',event=>{const input=event.target,current=propertyContext?.tile(),grid=current?.reportGrid,position=selectedCell;if(!input.dataset.gridDimension||!grid||!validPosition(grid,position)||position.tileId!==current.id||activeCells().length>1)return;const number=Number(input.value),value=input.value.trim()&&Number.isFinite(number)?Math.max(5,Math.min(input.dataset.gridDimension==='row'?600:1200,number)):null;if(input.dataset.gridDimension==='column'){if(position.column<0)grid.labelColumnWidth=value;else grid.columns[position.column].width=value;}else if(position.row<0)grid.headerRowHeight=value;else grid.rows[position.row].height=value;propertyContext.change();});
       container.prepend(controlsPanel);
     }
     let panel=container.querySelector('#reportGridCellProperties');
    if (!panel) {
      panel=document.createElement('details'); panel.id='reportGridCellProperties';panel.open=true;
      panel.innerHTML='<summary>Report grid cell</summary><div data-report-grid-properties></div>';
      container.prepend(panel);
       panel.addEventListener('focusin',event=>{if(event.target.dataset.gridProperty==='formula'){const grid=propertyContext?.tile()?.reportGrid,position=selectedCell,cell=grid&&validPosition(grid,position)?sheetCell(grid,position):null;formulaEditSnapshot=cell?{input:event.target,position:{...position},cell:structuredClone(cell),cornerCaption:grid.cornerCaption,rowCaption:grid.rows[position.row]?.caption,columnCaption:grid.columns[position.column]?.caption}:null;highlightFormulaReferences(event.target.value);document.querySelector(`.tile-reportGrid[data-id="${CSS.escape(selectedCell?.tileId||'')}"]`)?.classList.add('report-grid-reference-picking');}});
       panel.addEventListener('focusout',event=>{if(event.target.dataset.gridProperty==='formula'){if(inlineFormulaEditor?.input===event.target)return;if(formulaEditSnapshot?.input===event.target)formulaEditSnapshot=null;restoreSelectedCellDraft();highlightFormulaReferences();document.querySelectorAll('.report-grid-reference-picking').forEach(node=>node.classList.remove('report-grid-reference-picking'));}});
       panel.addEventListener('keydown',event=>{if(event.target.dataset.gridProperty!=='formula')return;if(event.key==='Escape'){event.preventDefault();event.stopPropagation();const snapshot=formulaEditSnapshot,grid=propertyContext?.tile()?.reportGrid;if(snapshot&&grid&&validPosition(grid,snapshot.position)){const cell=sheetCell(grid,snapshot.position);Object.keys(cell).forEach(key=>delete cell[key]);Object.assign(cell,snapshot.cell);grid.cornerCaption=snapshot.cornerCaption;if(snapshot.position.row>=0)grid.rows[snapshot.position.row].caption=snapshot.rowCaption;if(snapshot.position.column>=0)grid.columns[snapshot.position.column].caption=snapshot.columnCaption;}canceledFormulaInputs.add(event.target);formulaEditSnapshot=null;restoreSelectedCellDraft();highlightFormulaReferences();focusSelectedCell(true);renderProperties(panel.parentElement,propertyContext.tile(),propertyContext);return;}if(!['Enter','Tab'].includes(event.key))return;event.preventDefault();event.stopPropagation();const tile=propertyContext?.tile(),grid=tile?.reportGrid,position=selectedCell?{...selectedCell}:null,advance=event.key==='Tab'&&grid&&position?nextCellPosition(grid,position,event.shiftKey?'ArrowLeft':'ArrowRight'):null;event.target.dispatchEvent(new Event('change',{bubbles:true}));requestAnimationFrame(()=>{if(advance){selectCells([advance]);const properties=document.querySelector('#reportGridCellProperties');if(properties&&propertyContext)renderProperties(properties.parentElement,propertyContext.tile(),propertyContext);}focusSelectedCell(true);});});
       panel.addEventListener('click',event=>{
         const multiTile=propertyContext?.tile(),multiGrid=multiTile?.reportGrid,multi=multiGrid&&selectedFormatCells(multiGrid,multiTile);
         if(multi?.length>1){const format=event.target.closest('[data-grid-format-toggle],[data-grid-format-align]'),preset=event.target.closest('[data-border-preset]');if(format){const key=format.dataset.gridFormatToggle,align=format.dataset.gridFormatAlign,checked=key?!effectiveStyle(multiGrid,multi[0])[key]:null;multi.forEach(position=>{const style=styleTarget(multiGrid,position);if(key)style[key]=checked;else style.align=align;});rememberGridAction({type:'style',key:key||'align',value:key?checked:align});propertyContext.change();}else if(preset){multi.forEach(position=>presetBorder(styleTarget(multiGrid,position),preset.dataset.borderPreset));rememberGridAction({type:'border-preset',preset:preset.dataset.borderPreset});propertyContext.change();}return;}
         const modeButton=event.target.closest('[data-grid-input-mode]');
        if(modeButton){const current=propertyContext.tile(),grid=current?.reportGrid;if(grid&&validPosition(grid,selectedCell)){sheetCell(grid,selectedCell).inputMode=modeButton.dataset.gridInputMode;propertyContext.change();}return;}
        if(event.target.closest('[data-grid-upgrade-sheet]')){const current=propertyContext.tile(),grid=current?.reportGrid;if(grid&&upgradeSheet(grid))propertyContext.change();return;}
        const auto=event.target.closest('[data-grid-auto]');
        if(auto){const current=propertyContext.tile(),grid=current?.reportGrid,position=selectedCell;if(!grid||!validPosition(grid,position))return;if(auto.dataset.gridAuto==='column'){if(position.column<0)delete grid.labelColumnWidth;else delete grid.columns[position.column].width;}else if(position.row<0)delete grid.headerRowHeight;else delete grid.rows[position.row].height;propertyContext.change();return;}
        const format=event.target.closest('[data-grid-format-toggle],[data-grid-format-align]');
        if(format){
