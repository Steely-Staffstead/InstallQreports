    const additions=event?.shiftKey&&selectedCell?.tileId===tile.id?rangeCells(grid,selectionAnchor?.tileId===tile.id?selectionAnchor:selectedCell,position):axisCells(grid,position,element.dataset.gridAxis);
    if(event?.ctrlKey||event?.metaKey){const keys=new Set(additions.map(positionKey)),existing=previous.filter(item=>!keys.has(positionKey(item)));const removed=existing.length<previous.length;selectCells(removed?(existing.length?existing:additions):[...previous,...additions],removed&&existing.length?existing.at(-1):position);selectionAxis=selectionAxis===element.dataset.gridAxis?selectionAxis:null;}
    else if(event?.shiftKey&&selectedCell?.tileId===tile.id)selectCells(additions,position);
