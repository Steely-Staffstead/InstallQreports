    if(drag.isColumn){const col=drag.node.querySelectorAll('.report-grid-view col')[drag.index+1+(drag.tile.reportGrid.showRowNumbers?1:0)];if(col)col.style.width=`${value}px`;}
    else{const target=drag.node.querySelectorAll('.report-grid-view tbody tr')[drag.index]||drag.node.querySelector('.report-grid-view thead tr:last-child');if(target)target.style.height=`${value}px`;}
    drag.current=value;event.preventDefault();
  },true);
