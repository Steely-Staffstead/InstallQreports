    const conditionalRange={minimum:Math.min(0,...numericValues),maximum:Math.max(0,...numericValues)};
    const editing=!window.QanvasReport&&!document.body.classList.contains('presentation-mode');
    const cellClass = (kind,row,column) => editing&&activeCells().some(position=>position.tileId===tile.id&&position.kind===kind&&position.row===row&&position.column===column) ? 'report-grid-cell-selected' : '';
    const conditionalComparison=(cell,row,column)=>{const rule=cell?.conditionalFormat||{};if(rule.compareMode!=='measure'||!rule.compareMeasure)return rule.threshold;const sourceId=cell.sourceId||columns[column]?.sourceId||rows[row]?.sourceId||tile.sourceId||'main';try{return context.evaluate(sourceId,rule.compareMeasure,tile,[rows[row]?.crossFilter,columns[column]?.crossFilter]);}catch{return NaN;}};
    const displayCell=(kind,row,column)=>{
