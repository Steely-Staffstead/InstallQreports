        else if (input.dataset.gridProperty==='spanColumns'&&value) {const count=Math.max(1,Math.min(grid.columns.length-position.column,Math.trunc(Number(input.value)||1)));if(count===1)delete value.spanColumns;else value.spanColumns=count;}
        else if (input.dataset.gridProperty==='name'&&value) {if(!setCellName(grid,value,input))return;}
        else if (input.dataset.gridProperty==='spanAllColumns'&&position.kind==='caption'&&grid.rows[position.row]?.kind==='heading') grid.rows[position.row].spanAllColumns=input.checked;
        else if (input.dataset.gridProperty==='spacerHeight'&&position.kind==='caption'&&grid.rows[position.row]?.kind==='spacer') grid.rows[position.row].height=Math.max(4,Math.min(240,Number(input.value)||18));
        else if (input.dataset.gridProperty==='caption'&&position.kind==='caption') {grid.rows[position.row].caption=input.value;if(grid.sheetMode)sheetCell(grid,position).text=input.value;}
        else if (input.dataset.gridProperty==='caption'&&position.kind==='header') {grid.columns[position.column].caption=input.value;if(grid.sheetMode)sheetCell(grid,position).text=input.value;}
        else if (input.dataset.gridProperty==='caption'&&position.kind==='corner') {grid.cornerCaption=input.value;if(grid.sheetMode)sheetCell(grid,position).text=input.value;}
        else return;
        rememberGridPropertyChange(input,grid,position);
        propertyContext.change();
      });
      panel.addEventListener('input',event=>{
        if(event.target.dataset.gridProperty==='formula'){const current=propertyContext.tile(),grid=current?.reportGrid;if(grid&&selectedCell?.tileId===current.id&&validPosition(grid,selectedCell)){setCellEntry(grid,selectedCell,event.target.value,false);if(!syncingInlineFormula)showSelectedCellDraft(event.target.value);}highlightFormulaReferences(event.target.value);return;}
        if(!event.target.hasAttribute('data-grid-custom-format'))return;
        const preview=panel.querySelector('[data-grid-format-preview]');
        if(preview)preview.textContent=`Preview: ${propertyContext.format?.(1234567.89,event.target.value)||''}`;
      });
    }
     viewPanel.classList.toggle('hidden',tile?.kind!=='reportGrid');
     controlsPanel.classList.toggle('hidden',tile?.kind!=='reportGrid');
     panel.classList.toggle('hidden',tile?.kind!=='reportGrid');
    if (tile?.kind!=='reportGrid') return;
    const grid=normalizeGrid(tile.reportGrid||defaults()),position=selectedCell;
    viewPanel.querySelector('[data-report-grid-view-properties]').innerHTML=gridViewOptionsHtml(grid);
     viewPanel.after(controlsPanel);
     controlsPanel.after(panel);
     if (!validPosition(grid,position)||position.tileId!==tile.id) {
       controlsPanel.querySelector('[data-report-grid-controls]').innerHTML='<p class="property-empty">Select a grid cell to use these controls.</p>';
       panel.querySelector('[data-report-grid-properties]').innerHTML=`<p class="property-empty">Click a label, heading, or value cell in the grid to format it here.</p>`;
       return;
     }
     const multi=selectedFormatCells(grid,tile);
    if(multi.length>1){controlsPanel.classList.remove('hidden');controlsPanel.querySelector('[data-report-grid-controls]').innerHTML=`<div class="report-grid-mini-toolbar" role="toolbar" aria-label="Selected grid actions"><div class="report-grid-tool-group" role="group" aria-label="Cut / paste"><span class="report-grid-tool-label">Cut / paste</span><div class="report-grid-tool-buttons"><button type="button" data-grid-command="cut" title="Cut selected ${selectionAxis||'cells'} (Ctrl+X)">✂ Cut</button><button type="button" data-grid-command="paste" title="Paste (Ctrl+V)" ${clipboard?'':'disabled'}>↧ Paste</button></div></div></div>`;panel.querySelector('summary').textContent='Selected cells';panel.querySelector('[data-report-grid-properties]').innerHTML=multiFormatHtml(grid,tile,context);return;}
     controlsPanel.classList.remove('hidden');panel.querySelector('summary').textContent='Report grid cell';
     const row=grid.rows[position.row],column=grid.columns[position.column],value=sheetCell(grid,position),style=effectiveStyle(grid,position),sources=context.sources();
    const address=grid.sheetMode?`${columnAddress(position.column+1)}${position.row+2}`:position.kind==='value'?`${columnAddress(position.column)}${position.row+1}`:'';
     const label=grid.sheetMode?'':position.kind==='corner'?'Corner heading':position.kind==='header'?`Column: ${column.caption}`:position.kind==='caption'?`Row label: ${row.caption}`:row.caption||'Untitled row';
    const sourceId=value?.sourceId||column?.sourceId||row?.sourceId||tile.sourceId||sources[0]?.id||'main',measures=context.measures(sourceId);
    const rendered=[...document.querySelectorAll(`.tile-reportGrid[data-id="${CSS.escape(tile.id)}"] [data-report-grid-cell]`)].find(cell=>cell.dataset.reportGridCell===position.kind&&Number(cell.dataset.gridRow??-1)===position.row&&Number(cell.dataset.gridColumn??-1)===position.column);
    const previewText=rendered?.textContent?.trim()||'Cell preview';
    const identityHtml=address?`<div class="report-grid-cell-identity"><strong>${escape(address)}</strong><input data-grid-property="name" value="${escape(value?.name||'')}" placeholder="Cell name" aria-label="Cell name"></div>`:'';
    const selected=(actual,expected)=>actual===expected?'selected':'';
    const spacerSelected=position.kind==='caption'&&row.kind==='spacer';
    const conditionalOpen=panel.querySelector('.report-grid-conditional')?.open??false;
    const formulaHelpOpen=panel.querySelector('.report-grid-formula-help')?.open??false;
     controlsPanel.querySelector('[data-report-grid-controls]').innerHTML=gridToolbarHtml(grid,position)+gridDimensionsHtml(grid,position);
     panel.querySelector('[data-report-grid-properties]').innerHTML=`${identityHtml}${label?`<p class="report-grid-selected-label">${escape(label)}</p>`:''}${['header','caption','corner'].includes(position.kind)&&!spacerSelected&&!grid.sheetMode?`<label>Text<input data-grid-property="caption" value="${escape(position.kind==='header'?column.caption:position.kind==='corner'?grid.cornerCaption||'':row.caption)}"></label>`:''}${position.kind==='caption'&&row.kind==='heading'?`<label class="check"><input type="checkbox" data-grid-property="spanAllColumns" ${row.spanAllColumns?'checked':''}> Span across all columns</label>`:''}${!grid.sheetMode&&value&&row?.kind==='heading'?`<label>Heading text<input data-grid-property="text" value="${escape(value.text||'')}"></label>`:''}${!grid.sheetMode&&value&&row?.kind==='measure'?sheetEditorHtml(grid,position,tile,context):''}${grid.sheetMode&&!spacerSelected?sheetEditorHtml(grid,position,tile,context):''}${position.kind==='header'?crossFilterHtml(column,column.sourceId||tile.sourceId||'main',context,'column'):position.kind==='caption'&&row.kind==='measure'?crossFilterHtml(row,row.sourceId||tile.sourceId||'main',context,'row'):''}${spacerSelected?'':`${conditionalFormatHtml(value,propertyContext,measures)}<h4>Cell formatting</h4>${themeEditorHtml(style,propertyContext)}${formatToolbarHtml(style,previewText,propertyContext)}${borderEditorHtml(style,propertyContext)}`}`;
    if(conditionalOpen)panel.querySelector('.report-grid-conditional')?.setAttribute('open','');
    if(formulaHelpOpen)panel.querySelector('.report-grid-formula-help')?.setAttribute('open','');
  }
  function gridCodeTableHtml(grid) {
    const codeCell=(position,tag='td')=>{
      const cell=sheetCell(grid,position),formula=String(cell?.formula||''),measure=String(cell?.measure||''),manual=String(cell?.text??'');
      const fallback=position.kind==='corner'?grid.cornerCaption||'':position.kind==='header'?grid.columns[position.column]?.caption||'':position.kind==='caption'?grid.rows[position.row]?.caption||'':'';
      const content=formula||measure||manual||fallback,kind=formula?'formula':measure?'measure':content?'text':'blank';
      const address=`${columnAddress(position.column+1)}${position.row+2}`;
      const owner=position.kind==='header'?grid.columns[position.column]:position.kind==='caption'?grid.rows[position.row]:null;
      const filter=crossFilterParts(owner?.crossFilter),filterValue=filter.advanced||filter.field&&`${filter.field}=${filter.value}`,filterText=filterValue?` · Filter: ${filterValue}`:'';
      const source=cell?.sourceId||owner?.sourceId||'';
      const title=`${address}${source?` · Source: ${source}`:''}${filterText}${content?` · ${content}`:''}`;
      return `<${tag} class="report-grid-code-cell report-grid-code-${kind}" title="${escape(title)}"><span>${escape(content)}</span>${filter.field?'<small class="report-grid-code-filter">⌄</small>':''}</${tag}>`;
    };
    const columns=grid.columns||[],rows=grid.rows||[];
    const letters=`<thead><tr class="report-grid-code-letters"><th class="report-grid-code-axis"></th>${Array.from({length:columns.length+1},(_,index)=>{const filter=index>0?crossFilterParts(columns[index-1]?.crossFilter):{field:'',value:'',advanced:''},value=filter.advanced||filter.field&&`${filter.field}=${filter.value}`;return `<th class="report-grid-code-axis" title="${value?escape(`Filter: ${value}`):''}">${columnAddress(index)}${value?' <small class="report-grid-code-filter">⌄</small>':''}</th>`;}).join('')}</tr></thead>`;
    const first=`<tr><th class="report-grid-code-axis">1</th>${codeCell({kind:'corner',row:-1,column:-1})}${columns.map((_,column)=>codeCell({kind:'header',row:-1,column})).join('')}</tr>`;
    const body=rows.map((item,row)=>{const filter=crossFilterParts(item.crossFilter),value=filter.advanced||filter.field&&`${filter.field}=${filter.value}`;return `<tr><th class="report-grid-code-axis" title="${value?escape(`Filter: ${value}`):''}">${row+2}${value?' <small class="report-grid-code-filter">⌄</small>':''}</th>${codeCell({kind:'caption',row,column:-1})}${columns.map((_,column)=>codeCell({kind:'value',row,column})).join('')}</tr>`;}).join('');
    return `<table class="report-grid-code-table">${letters}<tbody>${first}${body}</tbody></table>`;
  }
  function makeDialogMovable(dialog,handle) {
    let drag=null;handle.addEventListener('mousedown',event=>{if(event.button!==0||event.target.closest('button,input,select,textarea,a'))return;const rect=dialog.getBoundingClientRect();dialog.style.position='fixed';dialog.style.left=`${rect.left}px`;dialog.style.top=`${rect.top}px`;dialog.style.margin='0';drag={startX:event.clientX,startY:event.clientY,left:rect.left,top:rect.top,width:rect.width,height:rect.height};dialog.classList.add('panel-moving');event.preventDefault();});window.addEventListener('mousemove',event=>{if(!drag)return;dialog.style.left=`${Math.max(8,Math.min(drag.left+event.clientX-drag.startX,innerWidth-drag.width-8))}px`;dialog.style.top=`${Math.max(8,Math.min(drag.top+event.clientY-drag.startY,innerHeight-drag.height-8))}px`;});window.addEventListener('mouseup',()=>{if(!drag)return;drag=null;dialog.classList.remove('panel-moving');});
  }
  function openDesigner(tile) {
    document.querySelector('.report-grid-dialog')?.remove();
    const grid=normalizeGrid(structuredClone(tile.reportGrid||defaults()));
    const dialog=document.createElement('dialog');
    dialog.className='report-grid-dialog report-grid-code-dialog';
    dialog.innerHTML=`<div class="report-grid-dialog-head"><div><h2>View grid codes</h2><p>Read-only overview of cell text, formulas, measures, and row or column filters.</p></div><button type="button" data-close aria-label="Close">×</button></div><div class="report-grid-code-scroll">${gridCodeTableHtml(grid)}</div><div class="report-grid-code-footer">${grid.rows.length+1} rows · ${grid.columns.length+1} columns</div>`;
    document.body.append(dialog);
    dialog.addEventListener('click',event=>{if(event.target.closest('[data-close]'))dialog.close();});
    dialog.addEventListener('close',()=>dialog.remove());
    dialog.showModal();
    makeDialogMovable(dialog,dialog.querySelector('.report-grid-dialog-head'));
  }
  window.CanvasReportGrid = { defaults, render, openDesigner, handleCanvasClick, renderProperties, clearSelection };
})();
