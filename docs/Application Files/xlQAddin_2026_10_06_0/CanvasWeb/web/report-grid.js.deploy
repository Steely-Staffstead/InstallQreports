  function highlightFormulaReferences(formula='') {
    document.querySelectorAll('.report-grid-formula-reference').forEach(cell=>cell.classList.remove('report-grid-formula-reference'));
    if(!selectedCell||!String(formula).trimStart().startsWith('='))return;
    const grid=propertyContext?.tile()?.reportGrid;if(!grid)return;
    const refs=new Set(),names=new Set(),referenceFormula=String(formula).replace(/"(?:[^"]|"")*"/g,' ');
    for(const match of referenceFormula.matchAll(/\$?([A-Za-z]+)\$?([1-9]\d*)\s*:\s*\$?([A-Za-z]+)\$?([1-9]\d*)/g)){
      const number=letters=>[...letters.toUpperCase()].reduce((value,letter)=>value*26+letter.charCodeAt(0)-64,0);
      const top=Math.min(Number(match[2]),Number(match[4]))-(grid.sheetMode?2:1),bottom=Math.max(Number(match[2]),Number(match[4]))-(grid.sheetMode?2:1);
      const left=Math.min(number(match[1]),number(match[3]))-(grid.sheetMode?2:1),right=Math.max(number(match[1]),number(match[3]))-(grid.sheetMode?2:1);
