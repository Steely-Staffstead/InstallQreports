    return formula?(formula.startsWith('=')?formula:`=${formula}`):cellText(grid,position);
  }
  function topFormulaEntry(grid,position) {
    const cell=sheetCell(grid,position),measure=String(cell?.measure||'').trim();
    return measure&&cellMode(cell)==='measure'?`Measure:${measure}`:cellEntry(grid,position);
  }
  function normalizeGridFormula(input) {
    const source=String(input??'').trim();
    const literal=/^=\s*([+-]?(?:\d+(?:[.,]\d*)?|[.,]\d+))\s*(%)?\s*$/.exec(source);
    if(literal){const number=Number(literal[1].replace(',','.'));if(Number.isFinite(number)){if(literal[2]){const decimals=literal[1].split(/[.,]/)[1]?.length||0;return {formula:`=${Number((number/100).toPrecision(15))}`,format:`P${Math.min(2,decimals)}`};}return {formula:`=${number}`,format:null};}}
    let result='',depth=0,quoted=false;
    for(let index=0;index<source.length;){const char=source[index];if(char==='"'){if(quoted&&source[index+1]==='"'){result+='""';index+=2;continue;}quoted=!quoted;result+=char;index++;continue;}
      if(!quoted&&(char>='0'&&char<='9'||char==='.'&&/\d/.test(source[index+1]||''))&&!/[\w.$]/.test(source[index-1]||'')){
        const token=/^(?:\d+(?:[.,]\d*)?|\.\d+)(?:[eE][+-]?\d+)?/.exec(source.slice(index))?.[0];
        if(token){const numberText=depth===0?token:/^(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?/.exec(token)?.[0];if(numberText){const percent=source[index+numberText.length]==='%',number=Number(numberText.replace(',','.'));if(Number.isFinite(number)){result+=percent?String(Number((number/100).toPrecision(15))):String(number);index+=numberText.length+(percent?1:0);continue;}}}
      }
      if(!quoted){if(char==='(')depth++;else if(char===')')depth=Math.max(0,depth-1);}result+=char;index++;
