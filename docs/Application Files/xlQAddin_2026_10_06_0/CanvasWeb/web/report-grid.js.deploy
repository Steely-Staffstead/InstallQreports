    grid.rows.forEach(row=>{update(row.labelCell,-1);row.cells?.forEach((cell,start)=>update(cell,start));});
  }
  function visibleCellPosition(grid,position) {
    if(position.row>=0&&grid.rows[position.row]?.kind==='heading'&&grid.rows[position.row]?.spanAllColumns)return {...position,kind:'caption',column:-1};
    for(let column=-1;column<=position.column;){
      const kind=position.row<0?column<0?'corner':'header':column<0?'caption':'value';
      const anchor={...position,column,kind};
      if(position.column<column+cellSpan(grid,anchor))return anchor;
      column+=cellSpan(grid,anchor);
    }
    return position;
  }
  function cellText(grid,position) {
    const cell=sheetCell(grid,position);
    if(cell?.text!=null)return cell.text;
    if(position.kind==='corner')return grid.cornerCaption||'';
    if(position.kind==='header')return grid.columns[position.column]?.caption||'';
    if(position.kind==='caption')return grid.rows[position.row]?.caption||'';
