  }
  function borderEditorHtml(style,context) {
    const themed=resolvedStyle(style,context),lock=theme(context)?.requireColors||style.themeColors?.borderColor;
    return `<fieldset class="report-grid-border-editor"><legend>Borders</legend><div class="report-grid-border-presets"><button type="button" data-border-preset="all">All sides</button><button type="button" data-border-preset="none">Clear</button></div><div class="report-grid-border-head"><span>Side</span><span>Width</span><span>Line</span><span>Color</span></div>${sides.map(side=>{const border=borderSide(themed,side);return `<div class="report-grid-border-row"><label class="report-grid-border-toggle"><input type="checkbox" data-border-side="${side}" data-border-part="enabled" ${border.width&&border.style!=='none'?'checked':''}> ${sideName(side)}</label><input type="number" min="0" max="8" value="${border.width}" data-border-side="${side}" data-border-part="width" aria-label="${sideName(side)} border width"><select data-border-side="${side}" data-border-part="style" aria-label="${sideName(side)} border style">${['solid','double','dashed','dotted'].map(line=>`<option value="${line}" ${line===border.style?'selected':''}>${line}</option>`).join('')}</select><input type="color" value="${border.color}" data-border-side="${side}" data-border-part="color" aria-label="${sideName(side)} border color" ${lock?'disabled':''}></div>`}).join('')}</fieldset>`;
  }
  function formatToolbarHtml(style,previewText,context) {
    const selected=(actual,expected)=>actual===expected?'selected':'',pressed=value=>value?'true':'false';
    const display=resolvedStyle(style,context);
    const previewCss=styleCss(style,context).replace(/border-(?:top|right|bottom|left):[^;]*;/g,'');
    return `<div class="report-grid-format-card"><div class="report-grid-format-toolbar" role="toolbar" aria-label="Cell formatting"><button type="button" data-grid-format-toggle="bold" aria-pressed="${pressed(style.bold)}" title="Bold"><b>B</b></button><button type="button" data-grid-format-toggle="italic" aria-pressed="${pressed(style.italic)}" title="Italic"><i>I</i></button><button type="button" data-grid-format-toggle="underline" aria-pressed="${pressed(style.underline)}" title="Underline"><u>U</u></button><select data-grid-property-style="fontFamily" aria-label="Font">${['Segoe UI','Arial','Calibri','Georgia','Consolas'].map(font=>`<option ${selected(font,style.fontFamily||'Segoe UI')}>${font}</option>`).join('')}</select><input data-grid-property-style="fontSize" type="number" min="8" max="72" value="${style.fontSize||14}" aria-label="Font size"><input data-grid-property-style="color" type="color" value="${hex(display.color,'#182230')}" title="Text color" aria-label="Text color" ${display.themeColors?.color?'disabled':''}><input data-grid-property-style="background" type="color" value="${hex(display.background,'#ffffff')}" title="Cell background" aria-label="Cell background" ${display.themeColors?.background?'disabled':''}><button type="button" data-grid-format-align="left" aria-pressed="${pressed((style.align||'left')==='left')}" title="Align left">⇤</button><button type="button" data-grid-format-align="center" aria-pressed="${pressed(style.align==='center')}" title="Align center">↔</button><button type="button" data-grid-format-align="right" aria-pressed="${pressed(style.align==='right')}" title="Align right">⇥</button></div><div class="report-grid-format-preview" style="${previewCss}" aria-label="Cell formatting preview">${escape(previewText||'Cell preview')}</div></div>`;
  }
  function changeBorder(style,input) {
    const side=input.dataset.borderSide,part=input.dataset.borderPart;
    if (!sides.includes(side)) return false;
    const current=borderSide(style,side);
    if (part==='enabled') {style[sideKey(side,'width')]=input.checked?Math.max(current.width,current.style==='double'?3:1):0;if(input.checked&&current.style==='none') style[sideKey(side,'style')]='solid';}
    else if (part==='width') style[sideKey(side,'width')]=Math.max(0,Math.min(8,Number(input.value)||0));
    else if (part==='style') {style[sideKey(side,'style')]=input.value;style[sideKey(side,'width')]=Math.max(current.width,input.value==='double'?3:1);}
    else if (part==='color') style[sideKey(side,'color')]=hex(input.value,current.color);
