      }finally{visiting.delete(key);}
    };
    return at;
  }
  function setCellName(grid,cell,input) {
    const name=input.value.trim(),candidates=[grid.cornerCell,...(grid.columns||[]).map(column=>column.headerCell),...(grid.rows||[]).flatMap(row=>[row.labelCell,...(row.cells||[])])],used=candidates.some(other=>other&&other!==cell&&String(other.name||'').toLowerCase()===name.toLowerCase());
    input.setCustomValidity(name&&!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)||/^[A-Za-z]+[1-9]\d*$/.test(name)||used?'Use a unique name with letters, numbers or underscore; cell addresses are reserved.':'');
    if(!input.reportValidity())return false;
