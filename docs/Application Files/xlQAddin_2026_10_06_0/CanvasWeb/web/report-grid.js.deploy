      grid.columns.splice(column+1,0,{id:crypto.randomUUID(),caption:''});grid.rows.forEach(item=>{item.cells||=[];item.cells.splice(column+1,0,{})});position.kind='header';position.row=-1;position.column=column+1;return true;
    }
    if(command==='column-left'||command==='column-right'){
      const next=column+(command==='column-left'?-1:1);if(column<0||next<0||next>=grid.columns.length)return false;rebaseGridFormulas(grid,'column','move',column,next);[grid.columns[column],grid.columns[next]]=[grid.columns[next],grid.columns[column]];grid.rows.forEach(item=>{item.cells||=[];while(item.cells.length<grid.columns.length)item.cells.push({});[item.cells[column],item.cells[next]]=[item.cells[next],item.cells[column]]});position.column=next;return true;
    }
    if(command==='delete-column'){
      if(column<0||grid.columns.length<=1)return false;adjustColumnSpans(grid,'delete',column);rebaseGridFormulas(grid,'column','delete',column);grid.columns.splice(column,1);grid.rows.forEach(item=>item.cells?.splice(column,1));position.kind='header';position.row=-1;position.column=Math.min(column,grid.columns.length-1);return true;
    }
    if(command==='delete-row'){
      if(row<0||grid.rows.length<=1)return false;rebaseGridFormulas(grid,'row','delete',row);grid.rows.splice(row,1);position.kind='caption';position.row=Math.min(row,grid.rows.length-1);position.column=-1;return true;
    }
    return false;
  }
  function highlightSelection() {
    document.querySelectorAll('.tile-reportGrid .report-grid-cell-selected').forEach(cell=>cell.classList.remove('report-grid-cell-selected'));
    for(const position of activeCells())selectedCellElement(position)?.classList.add('report-grid-cell-selected');
  }
  function updatePainterClass() {
    document.querySelectorAll('.tile-reportGrid .report-grid-view').forEach(view=>view.classList.toggle('report-grid-painting',!!paintFormat));
