    const address=/^\$?([A-Za-z]+)\$?([1-9]\d*)$/;
    const coordinates=value=>{const match=address.exec(value);if(!match)throw new Error('#FORMULA!');let column=0;for(const letter of match[1].toUpperCase())column=column*26+letter.charCodeAt(0)-64;return {row:Number(match[2]),column};};
    const rangeValues=(start,end)=>{const first=coordinates(start),last=coordinates(end),top=Math.min(first.row,last.row),bottom=Math.max(first.row,last.row),left=Math.min(first.column,last.column),right=Math.max(first.column,last.column);if((bottom-top+1)*(right-left+1)>10000)throw new Error('#VALUE!');const values=[];for(let row=top;row<=bottom;row++)for(let column=left;column<=right;column++){let number=column,letters='';while(number>0){number--;letters=String.fromCharCode(65+number%26)+letters;number=Math.floor(number/26);}values.push(reference(`${letters}${row}`));}return values;};
