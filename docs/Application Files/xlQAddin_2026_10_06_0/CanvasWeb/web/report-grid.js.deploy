  const positionKey=position=>`${position.tileId}:${position.row}:${position.column}`;
  function activeCells(){return selectedCell?(selectedCells.some(position=>positionKey(position)===positionKey(selectedCell))?selectedCells:[selectedCell]):[];}
  function selectCells(positions,primary=positions.at(-1)){selectedCells=[...new Map(positions.map(position=>[positionKey(position),position])).values()];selectedCell=primary||selectedCells.at(-1)||null;highlightSelection();}
  function rangeCells(grid,from,to){const cells=[];for(let row=Math.max(-1,Math.min(from.row,to.row));row<=Math.min(grid.rows.length-1,Math.max(from.row,to.row));row++)for(let column=Math.max(-1,Math.min(from.column,to.column));column<=Math.min(grid.columns.length-1,Math.max(from.column,to.column));column++){const position={tileId:to.tileId,row,column,kind:row<0?column<0?'corner':'header':column<0?'caption':'value'};if(validPosition(grid,position))cells.push(position);}return cells;}
  function axisCells(grid,position,axis){if(axis==='column')return rangeCells(grid,{...position,row:-1},{...position,row:grid.rows.length-1});if(axis==='row')return rangeCells(grid,{...position,column:-1},{...position,column:grid.columns.length-1});return[position];}
  function cellSpan(grid,position) {
    const maximum=grid.columns.length-position.column;
    if(position.kind==='caption'&&grid.rows[position.row]?.kind==='heading'&&grid.rows[position.row]?.spanAllColumns)return maximum;
    const cell=position.kind==='corner'?grid.cornerCell:position.kind==='header'?grid.columns[position.column]?.headerCell:position.kind==='caption'?grid.rows[position.row]?.labelCell:grid.rows[position.row]?.cells?.[position.column];
    const count=Math.trunc(Number(cell?.spanColumns)||1);
    return Math.max(1,Math.min(maximum,count));
  }
  function adjustColumnSpans(grid,operation,index) {
    const update=(cell,start)=>{
      const count=Math.trunc(Number(cell?.spanColumns)||1);
      if(count<2||index<=start||index>=start+count)return;
      const next=count+(operation==='insert'?1:-1);
      if(next<2)delete cell.spanColumns;else cell.spanColumns=next;
    };
