    const node=handle.closest('.tile-reportGrid'),tile=window.canvasWeb?.viewerDocument()?.pages?.flatMap(page=>[...(page.tiles||[]),...(page.graphics||[])]).find(item=>item.id===node?.dataset.id);
    if(!tile?.reportGrid)return;
