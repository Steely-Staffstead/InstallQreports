    };
    const conditionalCss=(kind,row,column)=>{const cell=sheetCell(grid,{kind,row,column});if(!cell?.conditionalFormat?.enabled)return '';try{return conditionalStyleCss(cell,calculate(row,column),context,conditionalComparison(cell,row,column),conditionalRange);}catch{return '';}};
    const spannedCells=(rowIndex,renderCell)=>{let html='';for(let column=-1;column<columns.length;){const kind=rowIndex<0?column<0?'corner':'header':column<0?'caption':'value',span=cellSpan(grid,{kind,row:rowIndex,column});html+=renderCell(column,span);column+=span;}return html;};
    const headingCells=spannedCells(-1,(index,span)=>index<0?`<th data-report-grid-cell="corner" ${span>1?`colspan="${span}"`:''} class="${cellClass('corner',-1,-1)}" style="${styleCss(mergeStyles(header,grid.cornerStyle),context)}${conditionalCss('corner',-1,-1)}">${displayCell('corner',-1,-1)}</th>`:`<th data-report-grid-cell="header" data-grid-column="${index}" ${span>1?`colspan="${span}"`:''} ${editing&&hasCrossFilter(columns[index])?'data-crossfilter="true" title="Column crossfilter"':''} class="${cellClass('header',-1,index)}" style="${styleCss(mergeStyles(header,columns[index].style,columns[index].headerStyle),context)}${conditionalCss('header',-1,index)}">${displayCell('header',-1,index)}</th>`);
    const heading = `<thead>${grid.showColumnLetters?`<tr class="report-grid-address-heading">${grid.showRowNumbers?'<th class="report-grid-axis-corner"></th>':''}<th data-report-grid-cell="corner" data-grid-axis="column" data-grid-column="-1" class="report-grid-axis-column">${grid.sheetMode?"A":""}${editing?'<span class="report-grid-resize-handle column" data-grid-resize-column="-1"></span>':''}</th>${columns.map((column,index)=>`<th data-report-grid-cell="header" data-grid-axis="column" data-grid-column="${index}" class="report-grid-axis-column">${columnAddress(grid.sheetMode?index+1:index)}${editing?`<span class="report-grid-resize-handle column" data-grid-resize-column="${index}"></span>`:''}</th>`).join('')}</tr>`:''}<tr style="${grid.headerRowHeight?`height:${Math.max(18,Math.min(600,Number(grid.headerRowHeight)||32))}px`:''}">${grid.showRowNumbers?`<th data-report-grid-cell="corner" data-grid-axis="row" data-grid-row="-1" class="report-grid-row-number report-grid-axis-row">${grid.sheetMode?'1':''}${editing?'<span class="report-grid-resize-handle row" data-grid-resize-row="-1"></span>':''}</th>`:''}${headingCells}</tr></thead>`;
    const body = rows.map((row,rowIndex) => {
