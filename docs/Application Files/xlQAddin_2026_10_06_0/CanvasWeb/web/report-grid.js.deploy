  }
  let formulaPointerCell=null,formulaPointerDrag=null;
  function updateFormulaPointerRange(event) {
    const drag=formulaPointerDrag;
    if(!drag||event.pointerId!==drag.pointerId)return false;
    const cell=document.elementFromPoint(event.clientX,event.clientY)?.closest?.('.tile-reportGrid [data-report-grid-cell]:not([data-grid-axis])');
