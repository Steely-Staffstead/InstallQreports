  document.addEventListener('pointermove',event=>{const drag=selectionDrag;if(!drag||event.pointerId!==drag.pointerId||!(event.buttons&1))return;const cell=document.elementFromPoint(event.clientX,event.clientY)?.closest?.('.tile-reportGrid [data-report-grid-cell]');if(!cell||cell.closest('.tile-reportGrid')?.dataset.id!==drag.tile.id)return;const end=location(cell,drag.tile.id);if(!validPosition(drag.tile.reportGrid,end)||positionKey(end)===positionKey(drag.start)&&!drag.moved)return;drag.moved=true;const grid=drag.tile.reportGrid,from=drag.start;const positions=drag.axis==='column'?rangeCells(grid,{...from,row:-1},{...end,row:grid.rows.length-1}):drag.axis==='row'?rangeCells(grid,{...from,column:-1},{...end,column:grid.columns.length-1}):rangeCells(grid,from,end);selectCells(positions,end);selectionAxis=drag.axis||null;event.preventDefault();},true);
