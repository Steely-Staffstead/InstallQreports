  function handleCanvasClick(tile,element,event) {
    if(ignoreGridClick){ignoreGridClick=false;return false;}
    const position=location(element,tile.id),grid=tile.reportGrid;
    if (!validPosition(grid,position)) return false;
    if (paintFormat) {
