  function closeMeasurePicker(){measurePicker?.remove();measurePicker=null;}
  function measurePickerTree(measures,term,currentMeasure){
    const root={folders:new Map(),measures:[]},query=String(term||'').trim().toLocaleLowerCase();
    for(const metric of measures||[]){
      const name=String(metric.Name??metric.name??'').trim(),folder=String(metric.Folder??metric.folder??'').split('/').map(part=>part.trim()).filter(Boolean),path=folder.join('/');
      if(!name||query&&!name.toLocaleLowerCase().includes(query)&&!path.toLocaleLowerCase().includes(query))continue;
      let node=root;
      for(const part of folder){if(!node.folders.has(part))node.folders.set(part,{folders:new Map(),measures:[]});node=node.folders.get(part);}
      node.measures.push(metric);
    }
    const measureHtml=metric=>{const name=String(metric.Name??metric.name??''),format=String(metric.FormatString??metric.formatString??''),type=String(metric.DataType??metric.dataType??'');return `<button type="button" class="report-grid-measure-option" role="option" data-grid-measure-choice="${escape(name)}" aria-selected="${name===currentMeasure}"><strong>${escape(name)}</strong>${format||type?`<small>${escape([format,type].filter(Boolean).join(' · '))}</small>`:''}</button>`;};
    const sorted=node=>[...node.measures].sort((a,b)=>String(a.Name??a.name??'').localeCompare(String(b.Name??b.name??''),undefined,{sensitivity:'base'}));
    const count=node=>node.measures.length+[...node.folders.values()].reduce((total,child)=>total+count(child),0);
    const folders=(node,path='')=>[...node.folders].sort(([a],[b])=>a.localeCompare(b,undefined,{sensitivity:'base'})).map(([name,child])=>{const fullPath=path?`${path}/${name}`:name;return `<details class="report-grid-measure-folder" open><summary><span>${escape(name)}</span><small>${count(child)}</small></summary><div>${sorted(child).map(measureHtml).join('')}${folders(child,fullPath)}</div></details>`;}).join('');
    const unfiled=sorted(root).map(measureHtml).join(''),folderHtml=folders(root);
    if(!unfiled&&!folderHtml)return '<p class="report-grid-measure-empty">No matching measures.</p>';
    return `${unfiled?`<div class="report-grid-measure-section">Unfiled</div>${unfiled}`:''}${folderHtml}`;
  }
  function openMeasurePicker(anchor,tile,grid,position){
