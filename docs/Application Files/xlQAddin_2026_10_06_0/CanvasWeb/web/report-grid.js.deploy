  }
  function setCellEntry(grid,position,input,commit=true) {
    const cell=sheetCell(grid,position),text=String(input??'');
    const measure=/^\s*measure\s*:\s*(.+?)\s*$/i.exec(text);
    if(measure){cell.measure=measure[1];cell.formula='';cell.text='';cell.inputMode='measure';return;}
    if(text.trimStart().startsWith('=')){const normalized=commit?normalizeGridFormula(text):{formula:text.trim(),format:null};cell.formula=normalized.formula;cell.measure='';cell.text='';if(normalized.format)cell.format=normalized.format;}
    else {cell.formula='';cell.measure='';cell.text=text;if(position.kind==='corner')grid.cornerCaption=text;else if(position.kind==='header')grid.columns[position.column].caption=text;else if(position.kind==='caption')grid.rows[position.row].caption=text;}
    cell.inputMode='formula';
  }
  function effectiveStyle(grid,position) {
    const base=grid.style||{}, header=grid.headerStyle||{};
    if (position.kind === 'corner') return mergeStyles(base,header,grid.cornerStyle);
    const column=grid.columns[position.column];
    if (position.kind === 'header') return mergeStyles(base,header,column.style,column.headerStyle);
    const row=grid.rows[position.row], rowOverrides=mergeStyles(row.kind==='heading'?header:{},row.style);
    if (position.kind === 'caption') return mergeStyles(base,rowOverrides,row.captionStyle);
    const cell=valueCell(grid,position);
    return mergeStyles(base,column.style,rowOverrides,cell.style,{align:cell.style?.align??row.style?.align??column.style?.align??(row.kind==='heading'?'left':'right')});
  }
  function validPosition(grid,position) {
    if (!grid || !position) return false;
    if (position.kind==='corner') return true;
    if (position.kind==='header') return !!grid.columns?.[position.column];
    if (position.kind==='caption') return !!grid.rows?.[position.row];
    return position.kind==='value'&&!!grid.rows?.[position.row]&&!!grid.columns?.[position.column];
  }
  function gridToolbarHtml(grid,position) {
    const row=position.row,column=position.column,hasRow=row>=0,hasColumn=column>=0;
    const button=(command,icon,title,enabled=true)=>`<button type="button" data-grid-command="${command}" title="${title}" aria-label="${title}" ${enabled?'':'disabled'}>${icon}</button>`;
    const group=(name,buttons)=>`<div class="report-grid-tool-group" role="group" aria-label="${name}"><span class="report-grid-tool-label">${name}</span><div class="report-grid-tool-buttons">${buttons}</div></div>`;
    return `<div class="report-grid-mini-toolbar" role="toolbar" aria-label="Report grid actions">${group('Copy / paste',`${button('copy-all','▣','Copy all (Ctrl+C)',(grid.sheetMode||position.kind==='value'&&grid.rows[row]?.kind==='measure'))}${button('cut','✂','Cut selection (Ctrl+X)',grid.sheetMode)}${button('copy-format','▧','Copy formats')}${button('copy-formula','ƒx','Copy formula or measure',(grid.sheetMode||position.kind==='value'&&grid.rows[row]?.kind==='measure'))}${button('paste','↧','Paste (Ctrl+V)',!!clipboard&&(!clipboard.content||(grid.sheetMode||position.kind==='value'&&grid.rows[row]?.kind==='measure')))}`)}${group('Insert / delete',`${button('insert-row','＋↓','Insert row below',hasRow||grid.sheetMode&&row===-1)}${button('insert-column','＋→','Insert column right',hasColumn||grid.sheetMode&&column===-1)}${button('delete-row','R×','Delete row',hasRow&&grid.rows.length>1)}${button('delete-column','C×','Delete column',hasColumn&&grid.columns.length>1)}`)}${group('Move',`${button('row-up','↑','Move row up',row>0)}${button('row-down','↓','Move row down',hasRow&&row<grid.rows.length-1)}${button('column-left','←','Move column left',column>0)}${button('column-right','→','Move column right',hasColumn&&column<grid.columns.length-1)}`)}</div>`;
  }
  function gridContextMenuHtml(grid,position,axis='') {
    const button=(command,label,enabled=true)=>`<button type="button" data-command="${command}" role="menuitem" ${enabled?'':'disabled'}>${label}</button>`;
    const canContent=grid.sheetMode||position.kind==='value'&&grid.rows[position.row]?.kind==='measure';
    const columnActions=axis==='column'||axis!=='row'&&position.row===-1;
    const rowActions=axis==='row'||axis!=='column'&&position.column===-1;
    return `${canContent&&!axis?`${button('choose-measure','Add/change measure…')}<hr>`:''}${button('copy-all','Copy all',canContent)}${button('cut',axis==='row'?'Cut row(s)':axis==='column'?'Cut column(s)':'Cut cell(s)',grid.sheetMode)}${button('copy-format','Copy formats')}${button('copy-formula','Copy formula / measure',canContent)}<hr>${button('paste','Paste',!!clipboard&&(!clipboard.content||canContent))}${columnActions?`<hr>${button('insert-column','Insert column to right')}${button('column-left','Move column left',position.column>0)}${button('column-right','Move column right',position.column>=0&&position.column<grid.columns.length-1)}${button('delete-column','Delete column',position.column>=0&&grid.columns.length>1)}`:''}${rowActions?`<hr>${button('insert-row','Insert row below')}${button('row-up','Move row up',position.row>0)}${button('row-down','Move row down',position.row>=0&&position.row<grid.rows.length-1)}${button('delete-row','Delete row',position.row>=0&&grid.rows.length>1)}`:''}`;
  }
  function gridDimensionsHtml(grid,position) {
