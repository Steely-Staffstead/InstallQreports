    picker.addEventListener('click',event=>{if(event.target.closest('[data-grid-measure-close]')){closeMeasurePicker();focusSelectedCell(true);return;}const option=event.target.closest('[data-grid-measure-choice]');if(!option)return;cell.inputMode='measure';cell.measure=option.dataset.gridMeasureChoice;closeMeasurePicker();propertyContext.change();requestAnimationFrame(()=>focusSelectedCell(true));});
    picker.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();closeMeasurePicker();focusSelectedCell(true);return;}if(!['ArrowDown','ArrowUp','Enter'].includes(event.key))return;const options=[...picker.querySelectorAll('[data-grid-measure-choice]')],active=document.activeElement,index=options.indexOf(active);if(event.key==='Enter'&&index>=0){event.preventDefault();active.click();return;}if(!options.length||event.key==='Enter')return;event.preventDefault();options[event.key==='ArrowDown'?Math.min(options.length-1,index+1):Math.max(0,index<0?options.length-1:index-1)].focus();});
    search.focus();
  }
  document.addEventListener('dblclick',event=>{
    const element=event.target.closest?.('.tile-reportGrid [data-report-grid-cell]:not([data-grid-axis])');
    if(!element)return;
