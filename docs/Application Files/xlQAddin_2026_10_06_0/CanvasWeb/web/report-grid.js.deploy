  let lastRepeatGridAction=null;
  function rememberGridAction(action){lastRepeatGridAction={...structuredClone(action),tileId:propertyContext?.tile()?.id||selectedCell?.tileId};}
  function repeatGridAction(grid,position){const action=lastRepeatGridAction;if(!action||action.tileId!==position.tileId)return false;const targets=activeCells().filter(item=>item.tileId===position.tileId&&validPosition(grid,item));if(!targets.length)targets.push(position);
    if(action.type==='command')return gridCommand(grid,position,action.command);
    for(const target of targets){if(action.type==='style')styleTarget(grid,target)[action.key]=action.value;else if(action.type==='border-preset')presetBorder(styleTarget(grid,target),action.preset);else if(action.type==='border-side')changeBorder(styleTarget(grid,target),{dataset:{borderSide:action.side,borderPart:action.part},value:action.value,checked:action.checked});else if(action.type==='number-format'){const cell=sheetCell(grid,target);if(cell)cell.format=action.value;}else return false;}return true;
  }
  function rememberGridPropertyChange(input,grid,position){const key=input.dataset.gridPropertyStyle;if(key&&styleKeys.has(key))rememberGridAction({type:'style',key,value:styleTarget(grid,position)[key]});else if(input.dataset.gridProperty==='format'||input.hasAttribute('data-grid-custom-format'))rememberGridAction({type:'number-format',value:sheetCell(grid,position)?.format});else if(input.dataset.borderSide)rememberGridAction({type:'border-side',side:input.dataset.borderSide,part:input.dataset.borderPart,value:input.value,checked:input.checked});}
  function formulaAddress(grid,position) {
