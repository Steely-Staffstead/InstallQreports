  function finishInlineFormulaEdit(commit,advanceKey=null){const state=inlineFormulaEditor;if(!state)return;inlineFormulaEditor=null;const tile=propertyContext?.tile(),grid=tile?.reportGrid,position=selectedCell?{...selectedCell}:null,advance=advanceKey&&grid&&position?nextCellPosition(grid,position,advanceKey):null;if(commit)state.input.dispatchEvent(new Event('change',{bubbles:true}));else cancelFormulaEdit(state.input);if(advance){selectCells([advance]);if(tile&&propertyContext)renderProperties(document.querySelector('#reportGridCellProperties')?.parentElement,tile,propertyContext);}requestAnimationFrame(()=>focusSelectedCell(true));}
