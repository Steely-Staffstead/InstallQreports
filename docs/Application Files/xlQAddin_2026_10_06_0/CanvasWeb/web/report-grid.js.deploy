    const style=position?effectiveStyle(grid,position):{},input=node.querySelector('[data-grid-top-formula]'),address=node.querySelector('[data-grid-top-address]');
    node.querySelectorAll('[data-grid-top-command],[data-grid-top-style],[data-grid-top-align],[data-grid-top-color],[data-grid-top-font-size]').forEach(control=>control.disabled=!position);
    node.querySelectorAll('[data-grid-top-style]').forEach(button=>button.setAttribute('aria-pressed',String(!!style[button.dataset.gridTopStyle])));
    node.querySelectorAll('[data-grid-top-align]').forEach(button=>button.setAttribute('aria-pressed',String(style.align===button.dataset.gridTopAlign)));
    node.querySelectorAll('[data-grid-top-color]').forEach(control=>control.value=hex(style[control.dataset.gridTopColor],control.dataset.gridTopColor==='background'?'#ffffff':'#182230'));
    const fontSize=node.querySelector('[data-grid-top-font-size]');if(fontSize)fontSize.value=Math.max(6,Math.min(96,Number(style.fontSize)||14));
