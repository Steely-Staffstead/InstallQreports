    return `<fieldset class="report-grid-dimensions"><legend>Size</legend><div class="report-grid-dimension-row"><label>W <input data-grid-dimension="column" type="number" min="5" max="1200" value="${Number(width)>0?Math.round(width):''}" placeholder="Auto" aria-label="Column width in pixels"></label><button type="button" data-grid-auto="column" title="Automatic column width" aria-label="Automatic column width">↔</button></div>${position.row>=0||grid.sheetMode?`<div class="report-grid-dimension-row"><label>H <input data-grid-dimension="row" type="number" min="5" max="600" value="${Number(height)>0?Math.round(height):''}" placeholder="Auto" aria-label="Row height in pixels"></label><button type="button" data-grid-auto="row" title="Automatic row height" aria-label="Automatic row height">↕</button></div>`:''}</fieldset>`;
  }
  function gridCommand(grid,position,command) {
    let {row,column}=position;
    if(command==='cut')return cutGrid(grid,activeCells(),selectionAxis,position.tileId);
    if(command==='copy-all'||command==='copy-format'||command==='copy-formula')return copyGrid(grid,position,command.slice(5));
    if(command==='paste')return pasteGrid(grid,position);
    if(command==='insert-row'){
      rebaseGridFormulas(grid,'row','insert',row+1);
      grid.rows.splice(row+1,0,{id:crypto.randomUUID(),kind:'measure',caption:'',cells:grid.columns.map(()=>({}))});position.row=row+1;position.kind='caption';position.column=-1;return true;
    }
    if(command==='row-up'||command==='row-down'){
      const next=row+(command==='row-up'?-1:1);if(row<0||next<0||next>=grid.rows.length)return false;rebaseGridFormulas(grid,'row','move',row,next);[grid.rows[row],grid.rows[next]]=[grid.rows[next],grid.rows[row]];position.row=next;return true;
    }
