  function formulaGuideHtml() {
    return `<details class="report-grid-formula-help"><summary>Supported formulas</summary><p>Enter plain text directly, or start with <code>=</code> to calculate a formula. A simple entry such as <code>=40,5%</code> becomes <code>=0.405</code> with percent formatting; <code>=10,2</code> becomes <code>=10.2</code>. Function arguments still use commas. Use cell addresses such as <code>B2</code>, named cells, numbers, <code>+ − * /</code> and parentheses. <code>$B$2</code> keeps its row and column fixed when copying.</p><p>Comparisons: <code>= &lt;&gt; &lt; &lt;= &gt; &gt;=</code>. Text goes in double quotes. For example, <code>=IF(I12&lt;0,"GOOD","")</code> returns text or an empty cell. Use <code>&amp;</code> to join text, such as <code>="Year " &amp; B2</code>.</p><p>Functions: <code>IF(condition, true, false)</code>, <code>IFERROR(value, fallback)</code>, <code>ABS(number)</code>, <code>ROUND(number, digits)</code>, and <code>SUM</code>, <code>AVG</code> (or <code>AVERAGE</code>), <code>MIN</code>, <code>MAX</code>. <code>DIVIDE(numerator, denominator, fallback)</code> returns a blank cell for an empty or zero denominator unless you provide a fallback, for example <code>=DIVIDE(B2,C2,0)</code>. Use ranges such as <code>=SUM(B2:B10)</code> or <code>=AVG(B2:B10)</code>, including rectangular ranges. Blank and text cells in a range are ignored; an average with no numbers shows <code>#DIV/0!</code>. Only the chosen IF branch is calculated. IF calls can be nested, for example <code>=IF(A1&gt;0,"Positive",IF(A1&lt;0,"Negative","Zero"))</code>.</p><p>Results may show <code>#REF!</code>, <code>#DIV/0!</code>, <code>#CYCLE!</code>, <code>#VALUE!</code> or <code>#FORMULA!</code> when a reference or expression is invalid. Double-click a cell or press F2 to edit inside the grid. Click the formula to place the cursor, type a function name to see suggestions, or click another cell to insert its address. Drag across cells to insert a range. Press <code>F4</code> on a reference to cycle <code>A1 → $A$1 → A$1 → $A1 → A1</code>; with a selected cell, F4 repeats the latest formatting or insert action.</p></details>`;
  }
  function conditionalFormatHtml(cell,context,measures=[]) {
    const rule=cell?.conditionalFormat||{},operator=rule.operator||'<',color=rule.useThemeColor!==false,required=theme(context)?.requireColors===true,compareMode=rule.compareMode||'fixed';
    return `<details class="report-grid-conditional"><summary>Conditional formatting</summary><label class="check"><input type="checkbox" data-grid-conditional="enabled" ${rule.enabled?'checked':''}> Apply conditional formatting</label><div class="report-grid-conditional-condition"><label>Condition<select data-grid-conditional="operator">${[['<','Less than'],['<=','Less than or equal'],['>','Greater than'],['>=','Greater than or equal'],['=','Equal'],['<>','Not equal']].map(([value,label])=>`<option value="${escape(value)}" ${operator===value?'selected':''}>${label}</option>`).join('')}</select></label><label>Compare to<select data-grid-conditional="compareMode"><option value="fixed" ${compareMode==='fixed'?'selected':''}>Fixed value</option><option value="measure" ${compareMode==='measure'?'selected':''}>Measure</option></select></label></div>${compareMode==='measure'?`<label>Comparison measure<select data-grid-conditional="compareMeasure"><option value="">Choose measure…</option>${measures.map(measure=>{const name=measure.Name??measure.name??measure.OutputName??measure.outputName??'';return `<option value="${escape(name)}" ${name===rule.compareMeasure?'selected':''}>${escape(name)}</option>`;}).join('')}</select></label>`:`<label>Fixed value<input data-grid-conditional="threshold" type="number" step="any" value="${Number.isFinite(Number(rule.threshold))?Number(rule.threshold):0}"></label>`}<div class="two-cols"><label>Icon set<select data-grid-conditional="iconType">${['None','Arrows','Triangles','Circles','Status'].map(value=>`<option value="${value}" ${value===(rule.iconType||'None')?'selected':''}>${value}</option>`).join('')}</select></label><label>Icon position<select data-grid-conditional="iconPosition"><option value="left" ${rule.iconPosition!=='right'?'selected':''}>Left</option><option value="right" ${rule.iconPosition==='right'?'selected':''}>Right</option></select></label></div><label class="check"><input type="checkbox" data-grid-conditional="useThemeColor" ${color||required?'checked':''} ${required?'disabled':''}> Use theme negative color when condition matches</label><label>Text color<input data-grid-conditional="textColor" type="color" value="${hex(rule.textColor,'#c43d4b')}" ${color||required?'disabled':''}></label><label class="check"><input type="checkbox" data-grid-conditional="useBackground" ${rule.useBackground?'checked':''}> Also color background when condition matches</label><label>Background color<input data-grid-conditional="backgroundColor" type="color" value="${hex(rule.backgroundColor,'#fff0f0')}" ${color||required||!rule.useBackground?'disabled':''}></label><label class="check"><input type="checkbox" data-grid-conditional="strength" ${rule.strength?'checked':''}> Color background by value strength</label><div class="two-cols"><label>Low color<input data-grid-conditional="lowColor" type="color" value="${hex(rule.lowColor,'#f1f5ff')}"></label><label>High color<input data-grid-conditional="highColor" type="color" value="${hex(rule.highColor,'#536ee1')}"></label></div><div class="two-cols"><label>At / above icon color<input data-grid-conditional="goodColor" type="color" value="${hex(rule.goodColor,'#16844a')}"></label><label>Below icon color<input data-grid-conditional="badColor" type="color" value="${hex(rule.badColor,'#c43d4b')}"></label></div><small>Rules use the underlying number before display formatting. Measure comparisons use the selected cell's row and column filters.</small></details>`;
  }
  function updateConditionalFormat(cell,input) {
    const key=input.dataset.gridConditional;if(!cell||!['enabled','operator','threshold','compareMode','compareMeasure','iconType','iconPosition','useThemeColor','textColor','useBackground','backgroundColor','strength','lowColor','highColor','goodColor','badColor'].includes(key))return false;
    const rule=cell.conditionalFormat||={operator:'<',threshold:0,useThemeColor:true,textColor:'#c43d4b',backgroundColor:'#fff0f0'};
    rule[key]=input.type==='checkbox'?input.checked:key==='threshold'?Number(input.value)||0:input.value;
    return true;
  }
  function setSheetCell(grid,position,cell) {
    if(position.kind==='corner'){grid.cornerCell=cell;grid.cornerCaption=cell.text||'';}
    else if(position.kind==='header'){grid.columns[position.column].headerCell=cell;grid.columns[position.column].caption=cell.text||'';}
    else if(position.kind==='caption'){grid.rows[position.row].labelCell=cell;grid.rows[position.row].caption=cell.text||'';}
    else {grid.rows[position.row].cells||=[];grid.rows[position.row].cells[position.column]=cell;}
  }
  function rewriteMovedReferences(grid,mapping) {
    const rewrite=cell=>{if(cell?.formula)cell.formula=mapFormulaAddresses(cell.formula,(match,fixedColumn,letters,fixedRow,digits)=>{
      let column=0;for(const letter of letters.toUpperCase())column=column*26+letter.charCodeAt(0)-64;
      const target=mapping.get(`${Number(digits)}:${column}`);
      return target?`${fixedColumn?'$':''}${columnAddress(target.column-1)}${fixedRow?'$':''}${target.row}`:match;
    });};
    rewrite(grid.cornerCell);for(const column of grid.columns)rewrite(column.headerCell);
    for(const row of grid.rows){rewrite(row.labelCell);for(const cell of row.cells||[])rewrite(cell);}
  }
  function cutGrid(grid,positions,axis,tileId) {
    if(!grid.sheetMode||!positions.length||positions.some(position=>!validPosition(grid,position)))return false;
    const kind=axis==='row'?'row':axis==='column'?'column':'cells';
    const indices=kind==='row'?[...new Set(positions.map(position=>position.row))].filter(index=>index>=0).sort((a,b)=>a-b):kind==='column'?[...new Set(positions.map(position=>position.column))].filter(index=>index>=0).sort((a,b)=>a-b):[];
    if(kind!=='cells'&&!indices.length)return false;
    const origin={row:Math.min(...positions.map(position=>position.row)),column:Math.min(...positions.map(position=>position.column))};
    clipboard={mode:'cut',kind,tileId,grid,origin,indices,positions:positions.map(position=>({...position,cell:structuredClone(sheetCell(grid,position)||{})}))};
    paintFormat=null;updatePainterClass();return true;
  }
  function pasteCutGrid(grid,position) {
    const cut=clipboard;
    if(cut?.mode!=='cut'||cut.grid!==grid||cut.tileId!==position.tileId||!validPosition(grid,position))return false;
    if(cut.kind==='row'||cut.kind==='column'){
      const rowAxis=cut.kind==='row',axis=rowAxis?'row':'column',target=position[axis];
      if(selectionAxis!==axis||target<0||(rowAxis?position.column!==-1:position.row!==-1))return false;
      const count=rowAxis?grid.rows.length:grid.columns.length,from=cut.indices;
      if(from.some(index=>index>=count)||from.includes(target))return false;
      const order=Array.from({length:count},(_,index)=>index),remaining=order.filter(index=>!from.includes(index));
      const insertAt=remaining.filter(index=>index<target).length;
      remaining.splice(insertAt,0,...from);
      const mapping=new Map();
      order.forEach(oldIndex=>{const newIndex=remaining.indexOf(oldIndex);if(newIndex!==oldIndex){const oldCoordinate=oldIndex+2,newCoordinate=newIndex+2;for(let cross=1;cross<=(rowAxis?grid.columns.length+1:grid.rows.length+1);cross++)mapping.set(rowAxis?`${oldCoordinate}:${cross}`:`${cross}:${oldCoordinate}`,rowAxis?{row:newCoordinate,column:cross}:{row:cross,column:newCoordinate});}});
      if(rowAxis)grid.rows=remaining.map(index=>grid.rows[index]);
      else {grid.columns=remaining.map(index=>grid.columns[index]);for(const row of grid.rows){const cells=row.cells||[];row.cells=remaining.map(index=>cells[index]||{});}}
      rewriteMovedReferences(grid,mapping);
      const newIndices=from.map(index=>remaining.indexOf(index)),first=Math.min(...newIndices);
      selectCells(newIndices.flatMap(index=>axisCells(grid,{tileId:position.tileId,row:rowAxis?index:-1,column:rowAxis?-1:index,kind:rowAxis?'caption':'header'},axis)),{tileId:position.tileId,row:rowAxis?first:-1,column:rowAxis?-1:first,kind:rowAxis?'caption':'header'});
      selectionAxis=axis;
    }else{
      const rowDelta=position.row-cut.origin.row,columnDelta=position.column-cut.origin.column;
      const destinations=cut.positions.map(source=>({tileId:position.tileId,row:source.row+rowDelta,column:source.column+columnDelta}));
      for(const dest of destinations){dest.kind=dest.row<0?dest.column<0?'corner':'header':dest.column<0?'caption':'value';if(!validPosition(grid,dest))return false;}
      const mapping=new Map();
      cut.positions.forEach((source,index)=>mapping.set(`${source.row+2}:${source.column+2}`,{row:destinations[index].row+2,column:destinations[index].column+2}));
      for(const source of cut.positions)setSheetCell(grid,source,{});
      cut.positions.forEach((source,index)=>setSheetCell(grid,destinations[index],structuredClone(source.cell)));
      rewriteMovedReferences(grid,mapping);
      selectCells(destinations,destinations[0]);selectionAxis=null;
    }
    clipboard=null;updatePainterClass();return true;
  }
  function conditionalMatches(rule,number,comparison) {
    const operator=rule.operator||'<';return operator==='<'?number<comparison:operator==='<='?number<=comparison:operator==='>'?number>comparison:operator==='>='?number>=comparison:operator==='='?number===comparison:operator==='<>'?number!==comparison:false;
  }
  function conditionalStrengthColor(rule,number,range) {
    if(!rule.strength||!Number.isFinite(number)||!Number.isFinite(range?.minimum)||!Number.isFinite(range?.maximum))return '';
    const low=hex(rule.lowColor,'#f1f5ff'),high=hex(rule.highColor,'#536ee1'),amount=Math.max(0,Math.min(1,(number-range.minimum)/(range.maximum-range.minimum||1))),channel=index=>Math.round(parseInt(low.slice(index,index+2),16)*(1-amount)+parseInt(high.slice(index,index+2),16)*amount).toString(16).padStart(2,'0');return `#${channel(1)}${channel(3)}${channel(5)}`;
  }
  function conditionalStyleCss(cell,value,context,comparisonValue,range) {
    const rule=cell?.conditionalFormat;if(!rule?.enabled||value==null||value==='')return '';
    const number=Number(value),threshold=Number(rule.compareMode==='measure'?comparisonValue:rule.threshold??0);if(!Number.isFinite(number))return '';
    const strength=conditionalStrengthColor(rule,number,range),matches=Number.isFinite(threshold)&&conditionalMatches(rule,number,threshold);if(!matches&&!strength)return '';
    const themed=theme(context)?.requireColors===true||rule.useThemeColor!==false,negative=hex(roles(context).negative,'#c43d4b'),color=themed?negative:hex(rule.textColor,'#c43d4b');
    const background=strength||matches&&rule.useBackground?(strength||(themed?`color-mix(in srgb, ${negative} 15%, ${hex(roles(context).surface,'#ffffff')})`:hex(rule.backgroundColor,'#fff0f0'))):'';
    return `${matches?`color:${color}!important;`:''}${background?`background:${background}!important;`:''}`;
  }
  function conditionalIconHtml(cell,value,comparisonValue,content) {
    const rule=cell?.conditionalFormat||{},number=Number(value),comparison=Number(rule.compareMode==='measure'?comparisonValue:rule.threshold??0),type=rule.iconType||'None';if(!rule.enabled||type==='None'||!Number.isFinite(number))return content;if(!Number.isFinite(comparison))return rule.compareMode==='measure'?`<span class="matrix-conditional-cell"><span class="matrix-conditional-content">${content}</span><span class="matrix-conditional-icon matrix-conditional-unavailable" title="Comparison measure could not be evaluated" aria-label="Comparison measure unavailable">?</span></span>`:content;
    const good=number>=comparison,symbol={Arrows:['↓','↑'],Triangles:['▼','▲'],Circles:['●','●'],Status:['✕','✓']}[type]||['↓','↑'],icon=`<span class="matrix-conditional-icon" aria-label="${good?'At or above':'Below'} target" style="color:${good?hex(rule.goodColor,'#16844a'):hex(rule.badColor,'#c43d4b')}">${symbol[good?1:0]}</span>`,body=`<span class="matrix-conditional-content">${content}</span>`;return `<span class="matrix-conditional-cell ${rule.iconPosition==='right'?'matrix-conditional-icon-right':'matrix-conditional-icon-left'}">${rule.iconPosition==='right'?body+icon:icon+body}</span>`;
  }
  function calculateCells(grid,tile,context) {
    const cache=new Map(),visiting=new Set(),columns=grid.columns||[],rows=grid.rows||[];
    const position=(row,column)=>({kind:row<0?column<0?'corner':'header':column<0?'caption':'value',row,column});
    const named=name=>{for(let r=grid.sheetMode?-1:0;r<rows.length;r++)for(let c=grid.sheetMode?-1:0;c<columns.length;c++){const current=position(r,c);if(!validPosition(grid,current))continue;if(String(sheetCell(grid,current)?.name||'').toLowerCase()===name.toLowerCase())return[r,c];}return null;};
    const at=(row,column)=>{
      const key=`${row}:${column}`;if(cache.has(key))return cache.get(key);if(visiting.has(key))throw new Error('#CYCLE!');
      const current=position(row,column);if(!validPosition(grid,current)||!grid.sheetMode&&(row<0||column<0))throw new Error('#REF!');
      const cell=sheetCell(grid,current);visiting.add(key);
