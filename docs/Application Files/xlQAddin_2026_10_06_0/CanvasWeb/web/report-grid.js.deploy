  function closeContextMenu(){document.querySelector('.report-grid-context-menu')?.remove();}
  document.addEventListener('contextmenu',event=>{
    const cell=event.target.closest?.('.tile-reportGrid [data-report-grid-cell]');
    if(!cell||window.QanvasReport||document.body.classList.contains('presentation-mode'))return;
    const node=cell.closest('.tile-reportGrid'),tile=window.canvasWeb?.viewerDocument()?.pages?.flatMap(page=>[...(page.tiles||[]),...(page.graphics||[])]).find(item=>item.id===node.dataset.id);
