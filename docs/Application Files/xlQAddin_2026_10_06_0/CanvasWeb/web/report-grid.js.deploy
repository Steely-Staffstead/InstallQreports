  function beginInlineFormulaEdit(initial=null){const cell=selectedCellElement(),input=document.querySelector('#reportGridCellProperties [data-grid-property="formula"]');if(!cell||!input)return false;input.focus();if(initial!==null){input.value=initial;input.dispatchEvent(new Event('input',{bubbles:true}));}showSelectedCellDraft(input.value);cell.replaceChildren();const wrapper=document.createElement('div');wrapper.className='report-grid-inline-editor';wrapper.innerHTML='<div class="report-grid-inline-highlight" aria-hidden="true"></div><textarea class="report-grid-inline-input" aria-label="Edit cell formula or text" spellcheck="false" rows="1"></textarea><div class="report-grid-inline-hint" hidden></div>';cell.append(wrapper);const textarea=wrapper.querySelector('textarea'),mirror=wrapper.querySelector('.report-grid-inline-highlight'),hint=wrapper.querySelector('.report-grid-inline-hint');textarea.value=input.value;inlineFormulaEditor={cell,input,textarea,mirror,hint};textarea.addEventListener('input',()=>{input.value=textarea.value;syncingInlineFormula=true;input.dispatchEvent(new Event('input',{bubbles:true}));syncingInlineFormula=false;refreshInlineFormula();});textarea.addEventListener('click',refreshInlineFormula);textarea.addEventListener('keyup',refreshInlineFormula);textarea.addEventListener('blur',()=>{if(inlineFormulaEditor?.textarea===textarea)finishInlineFormulaEdit(true);});hint.addEventListener('pointerdown',event=>event.preventDefault());hint.addEventListener('click',event=>{const name=event.target.closest('[data-grid-suggest]')?.dataset.gridSuggest;if(!name)return;const prefix=inlineFormulaContext(textarea.value,textarea.selectionStart).prefix;if(!prefix)return;const start=textarea.selectionStart-prefix[1].length;textarea.setRangeText(`${name}(`,start,textarea.selectionStart,'end');textarea.dispatchEvent(new Event('input',{bubbles:true}));textarea.focus();});textarea.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();