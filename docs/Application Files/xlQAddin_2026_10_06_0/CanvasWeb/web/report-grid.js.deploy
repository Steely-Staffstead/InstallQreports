          const address=/^\$?([A-Za-z]+)\$?([1-9]\d*)$/.exec(name);
          if(address){let index=0;for(const letter of address[1].toUpperCase())index=index*26+letter.charCodeAt(0)-64;return at(Number(address[2])-(grid.sheetMode?2:1),index-(grid.sheetMode?2:1));}
          const found=named(name);if(!found)throw new Error('#REF!');return at(...found);
        });
        else if(cellMode(cell)==='measure'&&cell?.measure){const selectedSource=cell.sourceId||columns[column]?.sourceId||rows[row]?.sourceId||tile.sourceId||'main';value=context.evaluate(selectedSource,cell.measure,tile,[rows[row]?.crossFilter,columns[column]?.crossFilter]);}
        else value=cellText(grid,current);
