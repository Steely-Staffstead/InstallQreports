(() => {
  const escape = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
  const hex = (value, fallback) => /^#[0-9a-f]{6}$/i.test(String(value)) ? value : fallback;
  const defaults = () => ({
    sheetMode: true,
    showColumnLetters: true,
    showRowNumbers: true,
    paddingTop: 0,
    paddingBottom: 0,
    cornerCell: {},
    columns: Array.from({length:4},()=>({ id: crypto.randomUUID(), caption: '', headerCell: {} })),
    rows: Array.from({length:2},()=>({ id: crypto.randomUUID(), kind: 'measure', caption: '', cells: Array.from({length:4},()=>({})) })),
    style: { background: '#ffffff', color: '#182230', fontFamily: 'Segoe UI', fontSize: 14, align: 'left', borderColor: '#d9e0ea', borderWidth: 0, borderStyle: 'solid' },
    headerStyle: { background: '#e9edf5', color: '#182230', bold: true, borderWidth: 1 },
  });
  function normalizeGrid(grid) {
    for(const [index,column] of (grid?.columns||[]).entries())if(column?.kind==='spacer'){
      // Older files kept visual spacing as a special column. Keep its position,
      // width and cells, but let it behave like every other editable column.
      delete column.kind;
      column.caption ||= '';
      const blankBackground=grid.style?.background||'#ffffff';
      column.style={background:blankBackground,borderWidth:0,...column.style};
      column.headerStyle={background:blankBackground,borderWidth:0,...column.headerStyle};
      for(const row of grid.rows||[])if(row.cells?.[index])row.cells[index].style={background:blankBackground,borderWidth:0,...row.cells[index].style};
    }
    for(const row of grid?.rows||[])if(row?.kind==='spacer'){
      row.kind='measure';
      row.caption ||= '';
      row.height ||= 18;
    }
    return grid;
  }
  const sides = ['top','right','bottom','left'];
  const sideName = side => side[0].toUpperCase()+side.slice(1);
  const sideKey = (side,part) => `border${sideName(side)}${sideName(part)}`;
  const styleKeys = new Set(['background','color','fontFamily','fontSize','align','borderColor','borderWidth','borderStyle','bold','italic','underline',...sides.flatMap(side=>['Width','Style','Color'].map(part=>`border${sideName(side)}${part}`))]);
  const themeRoles = ['surface','text','headerBackground','headerText','grid','accent','positive','negative'];
  const mergeStyles = (...styles) => styles.reduce((merged,style)=>({ ...merged,...style,themeColors:{...merged.themeColors,...style?.themeColors} }),{});
  const theme = context => typeof context?.theme==='function'?context.theme():context?.theme;
  const roles = context => window.CanvasTheme?.roles?.(theme(context)) || {};
  function resolvedStyle(style,context) {
    const palette=roles(context),required=theme(context)?.requireColors===true,choice=style.themeColors||{};
    const resolved={...style,background:(required||choice.background)&&palette[choice.background||'surface']||style.background,color:(required||choice.color)&&palette[choice.color||'text']||style.color};
    if(required||choice.borderColor){const color=palette[choice.borderColor||'grid'];if(color){resolved.borderColor=color;sides.forEach(side=>resolved[sideKey(side,'color')]=color);}}
    return resolved;
  }
  function themeEditorHtml(style,context) {
    const required=theme(context)?.requireColors===true,using=required||!!style.themeColors?.background||!!style.themeColors?.color||!!style.themeColors?.borderColor;
    const choices=[...new Set([...themeRoles,...Object.keys(roles(context)).filter(key=>/^color\d+$/.test(key))])];
    const options=selected=>choices.map(role=>`<option value="${role}" ${role===selected?'selected':''}>${/^color\d+$/.test(role)?`Theme color ${role.slice(5)}`:role.replace(/([A-Z])/g,' $1')}</option>`).join('');
    return `<div class="report-grid-theme-controls"><label class="check"><input type="checkbox" data-grid-theme-toggle ${using?'checked':''} ${required?'disabled':''}> Use theme colors</label>${using?`<div class="report-grid-theme-roles"><label>Background<select data-grid-theme-role="background">${options(style.themeColors?.background||'surface')}</select></label><label>Text<select data-grid-theme-role="color">${options(style.themeColors?.color||'text')}</select></label><label>Borders<select data-grid-theme-role="borderColor">${options(style.themeColors?.borderColor||'grid')}</select></label></div>`:''}</div>`;
  }
  const numberFormats = ['Auto','N0','N1','N2','P0','P1','P2','Custom'];
  const columnAddress=index=>{let result='',number=index+1;while(number>0){number--;result=String.fromCharCode(65+number%26)+result;number=Math.floor(number/26);}return result;};
  const gridViewOptionsHtml=grid=>`<div class="report-grid-view-options">${grid.sheetMode?'':`<button type="button" data-grid-upgrade-sheet>Use Excel cell addresses</button><small>Moves existing formula references one row and column to include the header cells.</small>`}<label class="check"><input type="checkbox" data-grid-view-option="showGrid" ${grid.showGrid?'checked':''}> Gridlines</label><label class="check"><input type="checkbox" data-grid-view-option="showHeadings" ${grid.showColumnLetters&&grid.showRowNumbers?'checked':''}> Headings</label><label class="check"><input type="checkbox" data-grid-view-option="showTopFormatAndFormula" ${grid.showTopFormatControls&&grid.showFormulaBar?'checked':''}> Format and formula bar</label><label class="check"><input type="checkbox" data-grid-view-option="showTopGridControls" ${grid.showTopGridControls?'checked':''}> Grid controls</label><div class="report-grid-spacing"><label>Space above grid<input type="number" min="0" max="120" step="1" data-grid-spacing="paddingTop" value="${Math.max(0,Math.min(120,Number(grid.paddingTop)||0))}"></label><label>Space below grid<input type="number" min="0" max="120" step="1" data-grid-spacing="paddingBottom" value="${Math.max(0,Math.min(120,Number(grid.paddingBottom)||0))}"></label></div></div>`;
  function setGridViewOption(grid,key,checked){
    if(key==='showHeadings'){grid.showColumnLetters=checked;grid.showRowNumbers=checked;}
    else if(key==='showTopFormatAndFormula'){grid.showTopFormatControls=checked;grid.showFormulaBar=checked;}
    else grid[key]=checked;
  }
  function topToolbarHtml(grid,tile){
    if(!grid.showTopGridControls&&!grid.showTopFormatControls&&!grid.showFormulaBar)return'';
    const position=selectedCell?.tileId===tile.id&&validPosition(grid,selectedCell)?selectedCell:null,disabled=position?'':'disabled',style=position?effectiveStyle(grid,position):{},address=position?(grid.sheetMode?formulaAddress(grid,position):position.kind==='value'?`${columnAddress(position.column)}${position.row+1}`:''):'',entry=position?topFormulaEntry(grid,position):'';
    const button=(attribute,value,label,title,pressed='')=>`<button type="button" ${attribute}="${value}" title="${title}" aria-label="${title}" ${pressed} ${disabled}>${label}</button>`;
    const gridControls=grid.showTopGridControls?`<div class="report-grid-top-group" aria-label="Grid controls">${button('data-grid-top-command','insert-row','＋R','Insert row below')}${button('data-grid-top-command','insert-column','＋C','Insert column right')}${button('data-grid-top-command','delete-row','R×','Delete row')}${button('data-grid-top-command','delete-column','C×','Delete column')}</div>`:'';
    const formatControls=grid.showTopFormatControls?`<div class="report-grid-top-group" aria-label="Format controls">${button('data-grid-top-style','bold','B','Bold',`aria-pressed="${!!style.bold}"`)}${button('data-grid-top-style','italic','I','Italic',`aria-pressed="${!!style.italic}"`)}${button('data-grid-top-style','underline','U','Underline',`aria-pressed="${!!style.underline}"`)}<label class="report-grid-top-color" title="Text color"><span>A</span><input type="color" data-grid-top-color="color" aria-label="Text color" value="${hex(style.color,'#182230')}" ${disabled}></label><label class="report-grid-top-color" title="Background color"><span>▣</span><input type="color" data-grid-top-color="background" aria-label="Background color" value="${hex(style.background,'#ffffff')}" ${disabled}></label><label class="report-grid-top-font-size" title="Font size"><input type="number" data-grid-top-font-size min="6" max="96" step="1" aria-label="Font size" value="${Math.max(6,Math.min(96,Number(style.fontSize)||14))}" ${disabled}><span>px</span></label>${button('data-grid-top-align','left','⇤','Align left',`aria-pressed="${style.align==='left'}"`)}${button('data-grid-top-align','center','↔','Align center',`aria-pressed="${style.align==='center'}"`)}${button('data-grid-top-align','right','⇥','Align right',`aria-pressed="${style.align==='right'}"`)}</div>`:'';
    const formula=grid.showFormulaBar?`<label class="report-grid-top-formula"><span data-grid-top-address>${escape(address||'—')}</span><input data-grid-top-formula value="${escape(entry)}" placeholder="Select a cell" ${disabled}></label>`:'';
    return `<div class="report-grid-top-tools">${gridControls}${formatControls}${formula}</div>`;
  }
  const defaultCustomFormat = '#,##0.0';
  function numberFormatHtml(pattern,selectAttribute,inputAttribute,formatter) {
    const current=pattern||'Auto',preset=numberFormats.includes(current)?current:'Custom';
    const custom=preset==='Custom'?(current==='Custom'?defaultCustomFormat:current):defaultCustomFormat;
    return `<label>Number format<select ${selectAttribute}>${numberFormats.map(format=>`<option ${format===preset?'selected':''}>${format}</option>`).join('')}</select></label><label data-grid-custom-format-wrap class="${preset==='Custom'?'':'hidden'}">Custom format<input ${inputAttribute} value="${escape(custom)}" placeholder='#,# "BP"'><small data-grid-format-preview>Preview: ${escape(formatter?.(1234567.89,custom)||'')}</small></label>`;
  }
  let selectedCell = null;
  let selectedCells = [];
  let selectionAxis = null;
  let selectionAnchor = null;
  let selectionDrag = null;
  let ignoreGridClick = false;
  let paintFormat = null;
  let clipboard = null;
  let painterDrag = null;
  let resizeDrag = null;
  let measurePicker = null;
  function crossFilterParts(filter) {
    if (filter && typeof filter==='object') return {field:String(filter.field||''),value:String(filter.value??''),advanced:String(filter.expression||'')};
    const match=/^(?:filter\s*\()?\s*([^=()]+?)\s*=\s*(.*?)\s*\)?$/i.exec(String(filter||''));
    return match?{field:match[1].trim(),value:match[2].trim(),advanced:''}:{field:'',value:'',advanced:String(filter||'')};
  }
  const hasCrossFilter=owner=>{const filter=crossFilterParts(owner?.crossFilter);return !!(filter.field||filter.advanced);};
  const crossFilterLabel=owner=>{const {field,value,advanced}=crossFilterParts(owner?.crossFilter);return advanced?` ⌄ ${advanced}`:field?` ⌄ ${field}=${value}`:'';};
  function crossFilterHtml(owner,sourceId,context,attribute) {
    const sources=context.sources(),source=sources.find(item=>item.id===sourceId),fields=source?.query?.data?.columns||[],filter=crossFilterParts(owner.crossFilter);
    return `<fieldset class="report-grid-crossfilter"><legend>Measure crossfilter</legend><label>Source<select data-grid-context-source="${attribute}"><option value="">Inherit from tile</option>${sources.map(item=>`<option value="${escape(item.id)}" ${owner.sourceId===item.id?'selected':''}>${escape(item.name)}</option>`).join('')}</select></label><label>Field<select data-grid-context-field="${attribute}"><option value="">No simple crossfilter</option>${fields.map(field=>`<option value="${escape(field)}" ${String(field).toLowerCase()===filter.field.toLowerCase()?'selected':''}>${escape(field)}</option>`).join('')}${filter.field&&!fields.some(field=>String(field).toLowerCase()===filter.field.toLowerCase())?`<option selected value="${escape(filter.field)}">${escape(filter.field)} (not in source)</option>`:''}</select></label><label>Equals<input data-grid-context-value="${attribute}" value="${escape(filter.value)}" placeholder="6 or {{period}}"></label><label>Advanced filter<input data-grid-context-advanced="${attribute}" value="${escape(filter.advanced)}" placeholder="period=1|2|3, year=2025"></label><details class="report-grid-filter-reference"><summary>Filter syntax</summary><dl><dt>=</dt><dd>Equal: region=100</dd><dt>&gt; &gt;= &lt; &lt;= &lt;&gt;</dt><dd>Compare: amount&gt;1000</dd><dt>|</dt><dd>OR: region=1|2|3</dd><dt>-</dt><dd>Range: account=3000-3999</dd><dt>* or %</dt><dd>Wildcard: description=*salary*</dd><dt>NULL / NOT NULL</dt><dd>Empty or non-empty</dd><dt>,</dt><dd>AND: year=2025, period&lt;=12</dd></dl></details><small>Advanced text takes priority. Row and column filters combine. Use {{parameterName}} for a canvas parameter.</small></fieldset>`;
  }
  const cellMode=cell=>cell?.inputMode==='formula'||cell?.inputMode==='measure'?cell.inputMode:String(cell?.formula||'').trim()||cell?.text!=null&&!cell?.measure?'formula':'measure';
  const cellContents=cell=>({formula:cell.formula||'',measure:cell.measure||'',sourceId:cell.sourceId||'',text:cell.text||'',inputMode:cellMode(cell),spanColumns:cell.spanColumns||1});
  function cycleFormulaReference(value,start,end=start){
    const source=String(value||'');if(!source.trimStart().startsWith('='))return null;
    const visible=source.replace(/"(?:[^"]|"")*"/g,match=>' '.repeat(match.length));
    const matches=[...visible.matchAll(/(?<![A-Za-z0-9_])(\$?)([A-Za-z]+)(\$?)([1-9]\d*)(?![A-Za-z0-9_])/g)];
    const selected=matches.filter(match=>start===end?match.index<=start&&start<=match.index+match[0].length:match.index>=start&&match.index+match[0].length<=end);
    if(!selected.length)return null;
    const targets=start===end?[selected.at(-1)]:selected;
    let result=source,change=0;
    for(const match of [...targets].reverse()){
      const columnFixed=!!match[1],rowFixed=!!match[3],next=!columnFixed&&!rowFixed?`$${match[2]}$${match[4]}`:columnFixed&&rowFixed?`${match[2]}$${match[4]}`:rowFixed?`$${match[2]}${match[4]}`:`${match[2]}${match[4]}`;
      result=result.slice(0,match.index)+next+result.slice(match.index+match[0].length);change+=next.length-match[0].length;
    }
    return {value:result,start:targets[0].index,end:targets.at(-1).index+targets.at(-1)[0].length+change};
  }
  function mapFormulaAddresses(formula,mapper) {
    return String(formula||'').replace(/"(?:[^"]|"")*"|(?<![A-Za-z0-9_])(\$?)([A-Za-z]+)(\$?)([1-9]\d*)(?![A-Za-z0-9_])/g,(match,fixedColumn,letters,fixedRow,digits)=>letters?mapper(match,fixedColumn,letters,fixedRow,digits):match);
  }
  function shiftFormula(formula,from,to) {
    const rowOffset=to.row-from.row,columnOffset=to.column-from.column;
    return mapFormulaAddresses(formula,(match,fixedColumn,letters,fixedRow,digits)=>{
      let column=0;for(const letter of letters.toUpperCase())column=column*26+letter.charCodeAt(0)-64;
      column+=fixedColumn?0:columnOffset;const row=Number(digits)+(fixedRow?0:rowOffset);
      if(column<1||row<1)return '#REF!';
      let address='';while(column>0){column--;address=String.fromCharCode(65+column%26)+address;column=Math.floor(column/26);}
      return `${fixedColumn?'$':''}${address}${fixedRow?'$':''}${row}`;
    });
  }
  function rebaseGridFormulas(grid,axis,operation,index,otherIndex) {
    const offset=grid.sheetMode?2:1,changed=index+offset,other=otherIndex+offset;
    const moveCoordinate=coordinate=>{
      if(operation==='insert'&&coordinate>=changed)return coordinate+1;
      if(operation==='delete'){if(coordinate===changed)return null;return coordinate>changed?coordinate-1:coordinate;}
      if(operation==='move'){if(coordinate===changed)return other;if(coordinate===other)return changed;}
      return coordinate;
    };
    const rewrite=formula=>{
      const ranges=[];
      const masked=String(formula||'').replace(/"(?:[^"]|"")*"|(?<![A-Za-z0-9_])(\$?)([A-Za-z]+)(\$?)([1-9]\d*)\s*:\s*(\$?)([A-Za-z]+)(\$?)([1-9]\d*)(?![A-Za-z0-9_])/g,(match,firstColumnFixed,firstLetters,firstRowFixed,firstDigits,lastColumnFixed,lastLetters,lastRowFixed,lastDigits)=>{
        if(!firstLetters)return match;
        const firstColumn=[...firstLetters.toUpperCase()].reduce((value,letter)=>value*26+letter.charCodeAt(0)-64,0),lastColumn=[...lastLetters.toUpperCase()].reduce((value,letter)=>value*26+letter.charCodeAt(0)-64,0);
        const first=axis==='row'?Number(firstDigits):firstColumn,last=axis==='row'?Number(lastDigits):lastColumn,low=Math.min(first,last),high=Math.max(first,last);
        const candidates=operation==='delete'?[low,low+1,high-1,high]:operation==='move'?[low,high,changed,other]:[low,high];
        const survivors=candidates.filter((value,index,array)=>value!=null&&value>=low&&value<=high&&array.indexOf(value)===index).map(moveCoordinate).filter(value=>value!=null);
        const begin=survivors.length?Math.min(...survivors):null,finish=survivors.length?Math.max(...survivors):null;
        const start=first<=last?begin:finish,end=first<=last?finish:begin;
        const format=(columnFixed,letters,rowFixed,digits,coordinate)=>`${columnFixed||''}${axis==='column'?columnAddress(coordinate-1):letters}${rowFixed||''}${axis==='row'?coordinate:digits}`;
        ranges.push(start==null?'#REF!':`${format(firstColumnFixed,firstLetters,firstRowFixed,firstDigits,start)}:${format(lastColumnFixed,lastLetters,lastRowFixed,lastDigits,end)}`);
        return `\u0000${ranges.length-1}\u0000`;
      });
      const shifted=mapFormulaAddresses(masked,(match,fixedColumn,letters,fixedRow,digits)=>{
      let column=0;for(const letter of letters.toUpperCase())column=column*26+letter.charCodeAt(0)-64;
      let row=Number(digits),coordinate=moveCoordinate(axis==='row'?row:column);
      if(coordinate==null)return '#REF!';
      if(axis==='row')row=coordinate;else column=coordinate;
      return `${fixedColumn?'$':''}${columnAddress(column-1)}${fixedRow?'$':''}${row}`;
    });
      return shifted.replace(/\u0000(\d+)\u0000/g,(_,index)=>ranges[Number(index)]);
    };
    const update=cell=>{if(cell?.formula)cell.formula=rewrite(cell.formula);};
    update(grid.cornerCell);
    for(const column of grid.columns||[])update(column.headerCell);
    for(const row of grid.rows||[]){update(row.labelCell);for(const cell of row.cells||[])update(cell);}
  }
  function rebaseFormula(formula) {
    return mapFormulaAddresses(formula,(match,fixedColumn,letters,fixedRow,digits)=>{
      let column=0;for(const letter of letters.toUpperCase())column=column*26+letter.charCodeAt(0)-64;
