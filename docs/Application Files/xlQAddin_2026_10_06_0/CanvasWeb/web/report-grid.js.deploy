    const configured=isColumn?(index<0?tile.reportGrid.labelColumnWidth:tile.reportGrid.columns[index]?.width):(index<0?tile.reportGrid.headerRowHeight:tile.reportGrid.rows[index]?.height);
    const size=Number(configured)>0?Number(configured):isColumn?handle.parentElement.getBoundingClientRect().width:handle.closest('tr').getBoundingClientRect().height;
