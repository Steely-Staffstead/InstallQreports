    }
    for(const match of referenceFormula.matchAll(/\$?([A-Za-z]+)\$?([1-9]\d*)/g)){
      let column=0;for(const letter of match[1].toUpperCase())column=column*26+letter.charCodeAt(0)-64;
      const row=Number(match[2])-(grid.sheetMode?2:1);column-=grid.sheetMode?2:1;
      const kind=row<0?column<0?'corner':'header':column<0?'caption':'value';
