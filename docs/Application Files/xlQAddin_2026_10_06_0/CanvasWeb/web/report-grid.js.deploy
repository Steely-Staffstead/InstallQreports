            else {target.align=format.dataset.gridFormatAlign;rememberGridAction({type:'style',key:'align',value:target.align});}
            propertyContext.change();
          }
          return;
        }
        const preset=event.target.closest('[data-border-preset]');
        if (preset) {
          const current=propertyContext.tile(),grid=current?.reportGrid;
          if (grid&&validPosition(grid,selectedCell)&&selectedCell.tileId===current.id&&presetBorder(styleTarget(grid,selectedCell),preset.dataset.borderPreset)){rememberGridAction({type:'border-preset',preset:preset.dataset.borderPreset});propertyContext.change();}
          return;
        }
        const command=event.target.closest('[data-grid-command]')?.dataset.gridCommand;
        if(!command)return;
        const current=propertyContext.tile(),grid=current?.reportGrid;
        if(!grid||!validPosition(grid,selectedCell)||selectedCell.tileId!==current.id)return;
        if(gridCommand(grid,selectedCell,command)){
          if(command.startsWith('copy-'))renderProperties(container,current,propertyContext);
          else propertyContext.change();
        }
      });
       panel.addEventListener('change',event=>{
         const current=propertyContext.tile(),grid=current?.reportGrid,position=selectedCell,input=event.target;
         if(canceledFormulaInputs.has(input)){canceledFormulaInputs.delete(input);return;}
         const multi=grid&&selectedFormatCells(grid,current);
         if(multi?.length>1){const key=input.dataset.gridPropertyStyle;if(input.dataset.gridProperty==='format'){multi.forEach(position=>{const cell=sheetCell(grid,position);if(cell)cell.format=input.value==='Custom'?(panel.querySelector('[data-grid-custom-format]')?.value||defaultCustomFormat):input.value;});}else if(input.hasAttribute('data-grid-custom-format')){multi.forEach(position=>{const cell=sheetCell(grid,position);if(cell)cell.format=input.value||defaultCustomFormat;});}else if(input.hasAttribute('data-grid-theme-toggle')){multi.forEach(position=>styleTarget(grid,position).themeColors=input.checked?{background:'surface',color:'text',borderColor:'grid'}:{background:null,color:null,borderColor:null});}else if(input.dataset.gridThemeRole){multi.forEach(position=>{const style=styleTarget(grid,position);style.themeColors||={};style.themeColors[input.dataset.gridThemeRole]=input.value;});}else if(input.dataset.borderSide){multi.forEach(position=>changeBorder(styleTarget(grid,position),input));}else if(key&&styleKeys.has(key)){const value=input.type==='checkbox'?input.checked:input.type==='number'?+input.value:input.value;multi.forEach(position=>styleTarget(grid,position)[key]=value);}else return;rememberGridPropertyChange(input,grid,multi[0]);propertyContext.change();return;}
        if(grid&&input.dataset.gridViewOption){setGridViewOption(grid,input.dataset.gridViewOption,input.checked);propertyContext.change();return;}
        if (!grid||!validPosition(grid,position)||position.tileId!==current.id) return;
        if(input.dataset.gridDimension){const number=Number(input.value),value=input.value.trim()&&Number.isFinite(number)?Math.max(5,Math.min(input.dataset.gridDimension==='row'?600:1200,number)):null;if(input.dataset.gridDimension==='column'){if(position.column<0)grid.labelColumnWidth=value;else grid.columns[position.column].width=value;}else if(position.row<0)grid.headerRowHeight=value;else grid.rows[position.row].height=value;propertyContext.change();return;}
        if(input.hasAttribute('data-grid-theme-toggle')){styleTarget(grid,position).themeColors=input.checked?{background:'surface',color:'text',borderColor:'grid'}:{background:null,color:null,borderColor:null};propertyContext.change();return;}
        if(input.dataset.gridThemeRole){const style=styleTarget(grid,position);style.themeColors||={};style.themeColors[input.dataset.gridThemeRole]=input.value;propertyContext.change();return;}
        if (input.dataset.borderSide) {if(changeBorder(styleTarget(grid,position),input)){rememberGridPropertyChange(input,grid,position);propertyContext.change();}return;}
        const value=sheetCell(grid,position),key=input.dataset.gridPropertyStyle;
        if(input.dataset.gridConditional){if(updateConditionalFormat(value,input))propertyContext.change();return;}
        if(input.dataset.gridContextSource||input.dataset.gridContextField||input.dataset.gridContextValue||input.dataset.gridContextAdvanced){const owner=position.kind==='header'?grid.columns[position.column]:position.kind==='caption'?grid.rows[position.row]:null;if(!owner)return;if(input.dataset.gridContextSource)owner.sourceId=input.value;if(input.dataset.gridContextAdvanced)owner.crossFilter=input.value.trim()?{expression:input.value.trim()}:null;if(input.dataset.gridContextField){const previous=crossFilterParts(owner.crossFilter);owner.crossFilter=input.value?{field:input.value,value:previous.value}:null;}if(input.dataset.gridContextValue){const previous=crossFilterParts(owner.crossFilter);owner.crossFilter=previous.field?{field:previous.field,value:input.value}:null;}propertyContext.change();return;}
        if (key&&styleKeys.has(key)) styleTarget(grid,position)[key]=input.type==='checkbox'?input.checked:input.type==='number'?+input.value:input.value;
        else if (input.dataset.gridProperty==='source'&&value) {value.sourceId=input.value;const effective=input.value||grid.columns[position.column]?.sourceId||grid.rows[position.row]?.sourceId||current.sourceId||'main',names=new Set(propertyContext.measures(effective).map(metric=>metric.Name));if (!names.has(value.measure)) value.measure='';}
        else if (input.dataset.gridProperty==='measure'&&value) value.measure=input.value;
        else if (input.dataset.gridProperty==='format'&&value) value.format=input.value==='Custom'?(panel.querySelector('[data-grid-custom-format]')?.value||defaultCustomFormat):input.value;
        else if (input.hasAttribute('data-grid-custom-format')&&value) value.format=input.value||defaultCustomFormat;
        else if (input.dataset.gridProperty==='text'&&value) value.text=input.value;
