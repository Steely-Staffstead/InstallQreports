        try{const result=calculate(row,column),sourceId=cell.sourceId||columns[column]?.sourceId||rows[row]?.sourceId||tile.sourceId||'main';if(result==null||Number.isNaN(result))content='—';else if(cellMode(cell)==='formula'&&typeof result==='string')content=escape(result);else content=escape(context.format(result,cell.format||(cellMode(cell)==="measure"&&context.measureFormat?.(sourceId,cell.measure))||'Auto'));}
        catch(error){content=escape(error.message||'#FORMULA!');}
      }else content=text(cellText(grid,position));
