      const rowStyle = mergeStyles(base,rowOverrides);
      if (row.kind === 'heading' && row.spanAllColumns) return `<tr class="report-grid-heading">${grid.showRowNumbers?`<td data-report-grid-cell="caption" data-grid-row="${rowIndex}" data-grid-axis="row" class="report-grid-row-number report-grid-axis-row">${rowIndex+(grid.sheetMode?2:1)}${editing?`<span class="report-grid-resize-handle row" data-grid-resize-row="${rowIndex}"></span>`:''}</td>`:''}<td colspan="${columns.length+1}" data-report-grid-cell="caption" data-grid-row="${rowIndex}" class="report-grid-caption ${cellClass('caption',rowIndex,-1)}" style="${styleCss(mergeStyles(rowStyle,row.captionStyle),context)}${conditionalCss('caption',rowIndex,-1)}">${displayCell('caption',rowIndex,-1)}</td></tr>`;
      const cells = spannedCells(rowIndex,(index,span) => {
        if(index<0)return `<td data-report-grid-cell="caption" data-grid-row="${rowIndex}" ${span>1?`colspan="${span}"`:''} ${editing&&hasCrossFilter(row)?'data-crossfilter="true" title="Row crossfilter"':''} class="report-grid-caption ${cellClass('caption',rowIndex,-1)}" style="${styleCss(mergeStyles(rowStyle,row.captionStyle),context)}${conditionalCss('caption',rowIndex,-1)}">${displayCell('caption',rowIndex,-1)}</td>`;
        const column=columns[index];
        const cell = row.cells?.[index] || {}, style = mergeStyles(base,column.style,rowOverrides,cell.style,{align:cell.style?.align ?? row.style?.align ?? column.style?.align ?? (row.kind === 'heading' ? 'left' : 'right')});
        if(row.kind==='heading'&&!grid.sheetMode)return `<td data-report-grid-cell="value" data-grid-row="${rowIndex}" data-grid-column="${index}" ${span>1?`colspan="${span}"`:''} class="${cellClass('value',rowIndex,index)}" style="${styleCss(style,context)}${conditionalCss('value',rowIndex,index)}">${text(cell.text)}</td>`;
        return `<td data-report-grid-cell="value" data-grid-row="${rowIndex}" data-grid-column="${index}" ${span>1?`colspan="${span}"`:''} class="${cellClass('value',rowIndex,index)}" style="${styleCss(style,context)}${conditionalCss('value',rowIndex,index)}">${displayCell('value',rowIndex,index)}</td>`;
      });
      return `<tr class="report-grid-${escape(row.kind || 'measure')} ${Number(row.height)>0&&Number(row.height)<28?'report-grid-compact-row':''} ${Number(row.height)>0&&Number(row.height)<=12&&!cellText(grid,{kind:'caption',row:rowIndex,column:-1})&&!(row.cells||[]).some(cell=>cell?.text||cell?.formula||cell?.measure)?'report-grid-tiny-row':''}" style="${row.height?`height:${Math.max(5,Math.min(600,Number(row.height)||32))}px`:''}">${grid.showRowNumbers?`<td data-report-grid-cell="caption" data-grid-row="${rowIndex}" data-grid-axis="row" class="report-grid-row-number report-grid-axis-row">${rowIndex+(grid.sheetMode?2:1)}${editing?`<span class="report-grid-resize-handle row" data-grid-resize-row="${rowIndex}"></span>`:''}</td>`:''}${cells}</tr>`;
    }).join('');
    const labelWidth=Number(grid.labelColumnWidth),fixedWidth=(Number.isFinite(labelWidth)&&labelWidth>0?labelWidth:120)+columns.reduce((sum,column)=>sum+(Number(column.width)>0?Number(column.width):100),0)+(grid.showRowNumbers?36:0);
    return `<div class="report-grid-view ${editing&&paintFormat ? 'report-grid-painting' : ''} ${grid.showGrid?'report-grid-show-lines':''}">${editing?topToolbarHtml(grid,tile):''}<table style="width:${Math.max(0,fixedWidth)}px;table-layout:fixed"><colgroup>${grid.showRowNumbers?'<col style="width:36px">':''}<col style="${labelWidth>0?`width:${Math.max(5,Math.min(1200,labelWidth))}px`:'width:42%'}">${columns.map(column=>Number(column.width)>0?`<col style="width:${Math.max(5,Math.min(1200,Number(column.width)))}px">`:'<col>').join('')}</colgroup>${heading}<tbody>${body}</tbody></table></div>`;
  }
  function location(element,tileId) {
    return { tileId, kind:element.dataset.reportGridCell, row:Number(element.dataset.gridRow ?? -1), column:Number(element.dataset.gridColumn ?? -1) };
  }
  function styleTarget(grid,position) {
    if (position.kind === 'corner') return grid.cornerStyle ||= {};
    if (position.kind === 'header') return grid.columns[position.column].headerStyle ||= {};
    if (position.kind === 'caption') return grid.rows[position.row].captionStyle ||= {};
