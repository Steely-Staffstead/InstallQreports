     if(event.target.closest?.('.report-grid-dialog,.report-grid-context-menu,.report-grid-top-tools,#reportGridCellProperties,#reportGridControls'))return;
    if(!event.target.closest?.('.tile-reportGrid [data-report-grid-cell]')&&selectedCell)clearSelection();
  },true);
