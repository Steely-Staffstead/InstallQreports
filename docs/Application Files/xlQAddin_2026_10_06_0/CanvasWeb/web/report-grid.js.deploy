    if(clipboard.content&&!grid.sheetMode&&(position.kind!=='value'||grid.rows[position.row]?.kind!=='measure'))return false;
    if(clipboard.style){const destination=styleTarget(grid,position);for(const key of Object.keys(destination))delete destination[key];Object.assign(destination,structuredClone(clipboard.style));const cell=sheetCell(grid,position);if(cell){if(clipboard.format!==undefined)cell.format=clipboard.format;if(clipboard.conditionalFormat)cell.conditionalFormat=structuredClone(clipboard.conditionalFormat);else delete cell.conditionalFormat;}}
    if(clipboard.content){const content=structuredClone(clipboard.content);content.formula=shiftFormula(content.formula,clipboard.origin,position);Object.assign(sheetCell(grid,position),content);}
