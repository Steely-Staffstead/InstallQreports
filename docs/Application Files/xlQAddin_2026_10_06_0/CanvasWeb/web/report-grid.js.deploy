    const cell=event.target.closest?.('[data-report-grid-cell]:not([data-grid-axis])'),node=cell?.closest('.tile-reportGrid');if(!node)return;
    const tile=window.canvasWeb?.viewerDocument()?.pages?.flatMap(page=>[...(page.tiles||[]),...(page.graphics||[])]).find(item=>item.id===node.dataset.id);
