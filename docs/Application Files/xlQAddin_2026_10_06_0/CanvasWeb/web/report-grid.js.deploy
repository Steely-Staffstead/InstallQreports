    if (event.key==='Escape'&&paintFormat) {paintFormat=null;painterDrag=null;highlightPaintRange();updatePainterClass();const panel=document.querySelector('#reportGridCellProperties');if(panel&&propertyContext)renderProperties(panel.parentElement,propertyContext.tile(),propertyContext);event.stopPropagation();}
