      head.setPointerCapture(pointerId);picker.classList.add('report-grid-measure-picker-moving');event.preventDefault();
      const move=moveEvent=>{if(moveEvent.pointerId!==pointerId)return;const rect=picker.getBoundingClientRect(),nextLeft=Math.max(0,Math.min(moveEvent.clientX-offsetX,innerWidth-rect.width)),nextTop=Math.max(0,Math.min(moveEvent.clientY-offsetY,innerHeight-rect.height));picker.style.left=`${nextLeft}px`;picker.style.top=`${nextTop}px`;};
      const finish=finishEvent=>{if(finishEvent.pointerId!==pointerId)return;picker.classList.remove('report-grid-measure-picker-moving');head.removeEventListener('pointermove',move);head.removeEventListener('pointerup',finish);head.removeEventListener('pointercancel',finish);};
      head.addEventListener('pointermove',move);head.addEventListener('pointerup',finish);head.addEventListener('pointercancel',finish);
    });
