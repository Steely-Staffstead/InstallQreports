    event.preventDefault();event.stopImmediatePropagation();closeContextMenu();
    if(!activeCells().some(item=>positionKey(item)===positionKey(position))){selectCells(axisCells(tile.reportGrid,position,cell.dataset.gridAxis));selectionAnchor=position;selectionAxis=cell.dataset.gridAxis||null;}
