    const tokens=[],tokenPattern=/\s*("(?:[^"]|"")*"|(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?|\$?[A-Za-z]+\$?[1-9]\d*|[A-Za-z_][A-Za-z0-9_]*|>=|<=|<>|!=|==|[(),:+*/<>=&-])/gy;
