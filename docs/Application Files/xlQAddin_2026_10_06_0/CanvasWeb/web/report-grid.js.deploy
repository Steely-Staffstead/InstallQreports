  }
  document.addEventListener('click',event=>{
    const control=event.target.closest?.('.tile-reportGrid [data-grid-top-command],[data-grid-top-style],[data-grid-top-align]');if(!control)return;
    const node=control.closest('.tile-reportGrid'),tile=propertyContext?.tile(),grid=tile?.reportGrid,position=selectedCell;
    if(!grid||node?.dataset.id!==tile.id||position?.tileId!==tile.id||!validPosition(grid,position))return;
    event.preventDefault();event.stopPropagation();
    if(control.dataset.gridTopStyle){const style=styleTarget(grid,position),key=control.dataset.gridTopStyle;style[key]=!effectiveStyle(grid,position)[key];rememberGridAction({type:'style',key,value:style[key]});}
    else if(control.dataset.gridTopAlign){const style=styleTarget(grid,position);style.align=control.dataset.gridTopAlign;rememberGridAction({type:'style',key:'align',value:style.align});}
    else if(!gridCommand(grid,position,control.dataset.gridTopCommand))return;
    propertyContext.change();
  });
  document.addEventListener('change',event=>{
    const format=event.target.closest?.('.tile-reportGrid [data-grid-top-color],.tile-reportGrid [data-grid-top-font-size]');
    if(format){
      const node=format.closest('.tile-reportGrid'),tile=propertyContext?.tile(),grid=tile?.reportGrid,position=selectedCell;
      if(!grid||node?.dataset.id!==tile.id||position?.tileId!==tile.id||!validPosition(grid,position))return;
      event.preventDefault();event.stopImmediatePropagation();
