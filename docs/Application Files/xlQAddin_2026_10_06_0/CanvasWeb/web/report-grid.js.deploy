    highlightSelection();
    const panel=document.querySelector('#reportGridCellProperties');
    if(panel)renderProperties(panel.parentElement,tile,propertyContext);
  },true);
  function clearSelection(tileId) {
    if (!tileId||selectedCell?.tileId===tileId){selectedCell=null;selectedCells=[];selectionAnchor=null;selectionAxis=null;}
    paintFormat=null;painterDrag=null;highlightPaintRange();updatePainterClass();highlightSelection();
    const panel=document.querySelector('#reportGridCellProperties');
