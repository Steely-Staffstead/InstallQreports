  }
  function render(tile, context) {
    const grid = normalizeGrid(tile.reportGrid || defaults()), columns = Array.isArray(grid.columns) ? grid.columns : [], rows = Array.isArray(grid.rows) ? grid.rows : [];
    const text = value => escape(String(value??'').replace(/\{\{\s*([^}]+?)\s*\}\}/g,(token,name)=>context.parameterValue?String(context.parameterValue(name.trim())??''):token));
    const base = grid.style || {}, header = mergeStyles(base,grid.headerStyle),calculate=calculateCells(grid,tile,context),numericValues=[];
