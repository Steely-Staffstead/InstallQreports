  document.addEventListener('keydown',event=>{if(event.key!=='F4'||event.ctrlKey||event.altKey||event.metaKey||window.QanvasReport||document.body.classList.contains('presentation-mode'))return;const input=event.target===inlineFormulaEditor?.textarea?inlineFormulaEditor.textarea:event.target.matches?.('#reportGridCellProperties [data-grid-property="formula"]')?event.target:null;if(input){const cycled=cycleFormulaReference(input.value,input.selectionStart,input.selectionEnd);event.preventDefault();event.stopImmediatePropagation();if(!cycled)return;input.value=cycled.value;input.setSelectionRange(cycled.start,cycled.end);input.dispatchEvent(new Event('input',{bubbles:true}));return;}const active=event.target;if(!active.matches?.('.tile-reportGrid [data-report-grid-cell]:not([data-grid-axis])')||!selectedCell||active.closest('.tile-reportGrid')?.dataset.id!==selectedCell.tileId)return;const tile=propertyContext?.tile(),grid=tile?.reportGrid;if(!grid||tile.id!==selectedCell.tileId||!validPosition(grid,selectedCell)||!lastRepeatGridAction)return;event.preventDefault();event.stopImmediatePropagation();if(repeatGridAction(grid,selectedCell)){propertyContext.change();requestAnimationFrame(()=>focusSelectedCell(true));}},true);
  function sheetEditorHtml(grid,position,tile,context) {
