    const align = ['left','center','right'].includes(style.align) ? style.align : 'left';
    return `background:${hex(style.background,'#ffffff')};color:${hex(style.color,'#182230')};font-family:${font};font-size:${Math.max(8,Math.min(72,Number(style.fontSize)||14))}px;font-weight:${style.bold?'700':'400'};font-style:${style.italic?'italic':'normal'};text-decoration:${style.underline?'underline':'none'};text-align:${align};${sides.map(side=>{const border=borderSide(style,side);return `border-${side}:${border.width}px ${border.style} ${border.color};`}).join('')}`;
  }
  function formulaValue(expression,reference) {
