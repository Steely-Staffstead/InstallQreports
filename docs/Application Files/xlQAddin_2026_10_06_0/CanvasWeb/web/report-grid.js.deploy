  }
  function copyGrid(grid,position,mode) {
    if(!validPosition(grid,position))return false;
    if(mode!=='format'&&!grid.sheetMode&&(position.kind!=='value'||grid.rows[position.row]?.kind!=='measure'))return false;
    const cell=sheetCell(grid,position)||{};
    clipboard={mode,origin:{row:position.row,column:position.column},content:mode==='format'?null:mode==='formula'?{formula:cell.formula||'',measure:cell.measure||'',sourceId:cell.sourceId||'',inputMode:cellMode(cell)}:{...cellContents(cell),text:cellText(grid,position)},style:mode==='formula'?null:structuredClone(effectiveStyle(grid,position)),format:mode==='formula'?null:cell.format,conditionalFormat:mode==='formula'?undefined:structuredClone(cell.conditionalFormat||null)};
    paintFormat={mode};updatePainterClass();return true;
  }
  function pasteGrid(grid,position) {
    if(clipboard?.mode==='cut')return pasteCutGrid(grid,position);
