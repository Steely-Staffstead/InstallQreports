  document.addEventListener('keydown',event=>{if(event.key==='Escape'){closeContextMenu();closeMeasurePicker();}},true);
  document.addEventListener('keydown',event=>{
    const key=event.key.toLowerCase();
    if(!['c','v','x'].includes(key)||!(event.ctrlKey||event.metaKey)||event.altKey||event.shiftKey||!selectedCell||key==='c'&&activeCells().length>1||window.QanvasReport||document.body.classList.contains('presentation-mode')||document.querySelector('.report-grid-dialog[open]'))return;
    const active=event.target;
    if(!active?.matches?.('.tile-reportGrid [data-report-grid-cell]:not([data-grid-axis])')||active.closest('.tile-reportGrid')?.dataset.id!==selectedCell.tileId)return;
    const tile=propertyContext?.tile(),grid=tile?.reportGrid;
    if(!grid||tile.id!==selectedCell.tileId||!validPosition(grid,selectedCell))return;
    const changed=key==='c'?copyGrid(grid,selectedCell,'all'):key==='x'?cutGrid(grid,activeCells(),selectionAxis,tile.id):pasteGrid(grid,selectedCell);
    if(!changed)return;
    event.preventDefault();event.stopPropagation();
