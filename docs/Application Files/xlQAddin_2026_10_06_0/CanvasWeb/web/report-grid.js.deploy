    picker.innerHTML=`<div class="report-grid-measure-picker-head"><div><strong>Choose measure</strong><small>${escape(source?.name||sourceId)}</small></div><button type="button" data-grid-measure-close aria-label="Close measure picker">×</button></div><input type="search" data-grid-measure-search placeholder="Search measures or folders" aria-label="Search measures or folders"><div class="report-grid-measure-list" role="listbox"></div>`;
    document.body.append(picker);measurePicker=picker;
    const list=picker.querySelector('.report-grid-measure-list'),search=picker.querySelector('[data-grid-measure-search]'),renderList=()=>{list.innerHTML=measurePickerTree(measures,search.value,cell.measure||'');};renderList();
    const bounds=anchor.getBoundingClientRect(),width=Math.min(390,innerWidth-16),left=Math.max(8,Math.min(bounds.left,innerWidth-width-8));picker.style.width=`${width}px`;picker.style.left=`${left}px`;picker.style.top=`${Math.max(8,Math.min(bounds.bottom+5,innerHeight-picker.offsetHeight-8))}px`;
    const head=picker.querySelector('.report-grid-measure-picker-head');
    head.addEventListener('pointerdown',event=>{
      if(event.button!==0||event.target.closest('button'))return;
