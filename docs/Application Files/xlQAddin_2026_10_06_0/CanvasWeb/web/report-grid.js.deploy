    else {propertyContext.change();requestAnimationFrame(()=>focusSelectedCell(true));}
  },true);
  document.addEventListener('keydown',event=>{
    if(event.key!=='Delete'||event.ctrlKey||event.altKey||event.metaKey||!selectedCell||activeCells().length>1||paintFormat||window.QanvasReport||document.body.classList.contains('presentation-mode')||document.querySelector('.report-grid-dialog[open]'))return;
    const active=event.target;
    if(!active?.matches?.('.tile-reportGrid [data-report-grid-cell]:not([data-grid-axis])')||active.closest('.tile-reportGrid')?.dataset.id!==selectedCell.tileId)return;
    const tile=propertyContext?.tile(),grid=tile?.reportGrid;
    if(!grid||tile.id!==selectedCell.tileId||!validPosition(grid,selectedCell))return;
    const cell=sheetCell(grid,selectedCell);if(!cell)return;
    event.preventDefault();event.stopPropagation();
    cell.measure='';cell.sourceId='';setCellEntry(grid,selectedCell,'');
    propertyContext.change();requestAnimationFrame(()=>focusSelectedCell(true));
  },true);
  document.addEventListener('keydown',event=>{
    if(event.key.length!==1||event.ctrlKey||event.altKey||event.metaKey||event.isComposing||!selectedCell||activeCells().length>1||paintFormat||window.QanvasReport||document.body.classList.contains('presentation-mode')||document.querySelector('.report-grid-dialog[open]'))return;
    const active=event.target;
    if(!active?.matches?.('.tile-reportGrid [data-report-grid-cell]:not([data-grid-axis])')||active.closest('.tile-reportGrid')?.dataset.id!==selectedCell.tileId)return;
    const current=propertyContext?.tile(),grid=current?.reportGrid;
    if(!grid||selectedCell.tileId!==current.id||!validPosition(grid,selectedCell))return;
    const cell=sheetCell(grid,selectedCell);
    if(!cell||cell.measure)return;
    event.preventDefault();event.stopPropagation();
    if(cellMode(cell)!=='formula'){cell.inputMode='formula';propertyContext.change();}
    beginInlineFormulaEdit(event.key);
  },true);
  document.addEventListener('keydown',event=>{
    if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','F2'].includes(event.key)||event.ctrlKey||event.altKey||event.metaKey||!selectedCell||paintFormat||window.QanvasReport||document.body.classList.contains('presentation-mode')||document.querySelector('.report-grid-dialog[open]'))return;
    const active=event.target;
    if(!active?.matches?.('.tile-reportGrid [data-report-grid-cell]:not([data-grid-axis])')||active.closest('.tile-reportGrid')?.dataset.id!==selectedCell.tileId)return;
    const tile=propertyContext?.tile(),grid=tile?.reportGrid;
    if(!grid||tile.id!==selectedCell.tileId||!validPosition(grid,selectedCell))return;
    event.preventDefault();event.stopPropagation();
    if(event.key==='F2'){
      if(event.shiftKey||activeCells().length>1)return;
      const cell=sheetCell(grid,selectedCell);
      if(!cell)return;
