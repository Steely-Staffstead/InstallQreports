(() => {
  const ci=(object,...names)=>{for(const [key,value] of Object.entries(object||{}))if(names.some(name=>key.toLowerCase()===String(name).toLowerCase()))return value;};
  const metricName=metric=>String(ci(metric,"OutputName","Name")||"");
  const metricFormula=metric=>String(ci(metric,"CustomFormula","Formula","Expression")||"").trim();
  const fieldIndex=(columns,name)=>{const clean=String(name||"").trim().replace(/^'[^']+'\s*\[/,"").replace(/^\[/,"").replace(/\]$/,"").replace(/['`]/g,"");return columns.findIndex(column=>String(column).toLowerCase()===clean.toLowerCase());};
  const splitArgs=text=>{const result=[];let depth=0,quote="",start=0;for(let i=0;i<text.length;i++){const ch=text[i];if(quote){if(ch===quote&&text[i-1]!=="\\")quote="";continue;}if(ch==='"'||ch==="'"){quote=ch;continue;}if(ch==="(")depth++;else if(ch===")")depth--;else if(ch===","&&depth===0){result.push(text.slice(start,i).trim());start=i+1;}}result.push(text.slice(start).trim());return result.filter(Boolean);};
  const stripOuter=text=>{text=text.trim();while(text[0]==="("&&text.at(-1)===")"){let depth=0,whole=true;for(let i=0;i<text.length;i++){if(text[i]==="(")depth++;else if(text[i]===")")depth--;if(depth===0&&i<text.length-1){whole=false;break;}}if(!whole)break;text=text.slice(1,-1).trim();}return text;};
  function topOperator(text,operators){let depth=0,quote="";for(let i=text.length-1;i>=0;i--){const ch=text[i];if(quote){if(ch===quote&&text[i-1]!=="\\")quote="";continue;}if(ch==='"'||ch==="'"){quote=ch;continue;}if(ch===")")depth++;else if(ch==="(")depth--;else if(depth===0&&operators.includes(ch)){if((ch==="+"||ch==="-")&&(i===0||"(,+-*/".includes(text[i-1])))continue;return i;}}return-1;}
  const reduce=(values,kind)=>{values=values.map(Number).filter(Number.isFinite);if(!values.length)return 0;if(/count/i.test(kind))return values.length;if(/average|avg/i.test(kind))return values.reduce((a,b)=>a+b,0)/values.length;if(/min/i.test(kind))return Math.min(...values);if(/max/i.test(kind))return Math.max(...values);return values.reduce((a,b)=>a+b,0);};
  function compare(left,operator,right){const a=Number(left),b=Number(right),numeric=Number.isFinite(a)&&Number.isFinite(b),x=numeric?a:String(left??"").toLowerCase(),y=numeric?b:String(right??"").toLowerCase();if(operator==="=")return x===y;if(operator==="<>"||operator==="!=")return x!==y;if(operator===">")return x>y;if(operator==="<")return x<y;if(operator===">=")return x>=y;if(operator==="<=")return x<=y;return false;}
  function filtered(rows,filter,columns){const match=/^\s*(.+?)\s*(<>|!=|>=|<=|=|>|<)\s*(.*?)\s*$/.exec(filter);if(!match)return rows;const index=fieldIndex(columns,match[1]);if(index<0)return rows;let expected=match[3].trim();if((expected[0]==="'"&&expected.at(-1)==="'")||(expected[0]==='"'&&expected.at(-1)==='"'))expected=expected.slice(1,-1);return rows.filter(row=>compare(row[index],match[2],expected));}
  function create(data,measures){const columns=data?.columns||[],allRows=data?.rows||[],map=new Map((measures||[]).map(metric=>[metricName(metric).toLowerCase(),metric]));
    function expression(source,rows,visiting=new Set(),variables=new Map()){
      let text=stripOuter(String(source||"").replace(/\s*-{2,}\s*/g," - ").replace(/\r?\n/g," ").trim());if(!text)return NaN;
      if(/^VAR\b/i.test(text)){
        const local=new Map(variables),returnAt=text.search(/\bRETURN\b/i);if(returnAt<0)return NaN;
        const declarations=text.slice(0,returnAt),pattern=/\bVAR\s+([A-Z_][A-Z0-9_]*)\s*=\s*([\s\S]*?)(?=\bVAR\s+[A-Z_][A-Z0-9_]*\s*=|$)/gi;let match;
        while((match=pattern.exec(declarations)))local.set(match[1].toLowerCase(),expression(match[2],rows,visiting,local));
        return expression(text.slice(returnAt+6),rows,visiting,local);
      }
      if(text[0]==="-")return-expression(text.slice(1),rows,visiting,variables);
      if(text[0]==="+")return expression(text.slice(1),rows,visiting,variables);
      let at=topOperator(text,["+","-"]);if(at>=0){const a=expression(text.slice(0,at),rows,visiting,variables),b=expression(text.slice(at+1),rows,visiting,variables);return text[at]==="+"?a+b:a-b;}
      at=topOperator(text,["*","/"]);if(at>=0){const a=expression(text.slice(0,at),rows,visiting,variables),b=expression(text.slice(at+1),rows,visiting,variables);return text[at]==="*"?a*b:(b===0?NaN:a/b);}
      const fn=/^([A-Z][A-Z0-9_]*)\s*\(([\s\S]*)\)$/i.exec(text);if(fn){const name=fn[1].toUpperCase(),args=splitArgs(fn[2]);if(name==="CALCULATE"){let scoped=rows;for(const filter of args.slice(1))scoped=filtered(scoped,filter,columns);return expression(args[0],scoped,visiting,variables);}if(["SUM","AVERAGE","AVG","MIN","MAX","COUNT"].includes(name)){let scoped=rows;for(const filter of args.slice(1))scoped=filtered(scoped,filter,columns);const index=fieldIndex(columns,args[0]);return index<0?NaN:reduce(scoped.map(row=>row[index]),name);}if(name==="DIVIDE"){const a=expression(args[0],rows,visiting,variables),b=expression(args[1],rows,visiting,variables);return b===0?expression(args[2]||"0",rows,visiting,variables):a/b;}if(name==="NEG")return-expression(args[0],rows,visiting,variables);return NaN;}
      const number=Number(text);if(Number.isFinite(number))return number;const ref=text.replace(/^\[|\]$/g,"").trim();if(variables.has(ref.toLowerCase()))return variables.get(ref.toLowerCase());const metric=map.get(ref.toLowerCase());if(metric){if(visiting.has(ref.toLowerCase()))return NaN;const next=new Set(visiting);next.add(ref.toLowerCase());return expression(metricFormula(metric),rows,next,variables);}const index=fieldIndex(columns,ref);return index<0?NaN:reduce(rows.map(row=>row[index]),"SUM");
    }
    function evaluate(field,rows=allRows,aggregation="Sum"){const index=fieldIndex(columns,field);if(index>=0)return reduce(rows.map(row=>row[index]),aggregation);const metric=map.get(String(field||"").toLowerCase());return metric?expression(metricFormula(metric),rows,new Set([String(field).toLowerCase()])):NaN;}
    return{evaluate,canEvaluate:field=>fieldIndex(columns,field)>=0||map.has(String(field||"").toLowerCase()),allRows};
  }
  window.CanvasMeasureEvaluator={create};
})();
