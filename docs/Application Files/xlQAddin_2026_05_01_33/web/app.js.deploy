    const refreshPreview=()=>preview.innerHTML=renderMatrix({design:{matrixSpec:state}},query().data);
    function add(field,zone){if(zone==="rows"&&dimensions.includes(field)&&!state.rows.includes(field)){state.rows.push(field);selectedRow=field;}if(zone==="columns"&&dimensions.includes(field)&&!state.columns.includes(field))state.columns.push(field);if(zone==="values"&&!state.values.some(value=>value.field===field)){state.values.push({field,caption:field,aggregation:"Sum",format:"Auto",align:"Auto"});selectedValue=field;}draw();}
