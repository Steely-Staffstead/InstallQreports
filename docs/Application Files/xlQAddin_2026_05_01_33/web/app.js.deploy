      drag.t.x=Math.max(0,snapped.x);drag.t.y=Math.max(0,snapped.y);drag.t.width=Math.max(minWidth,snapped.width);drag.t.height=Math.max(minHeight,snapped.height);Object.assign(drag.node.style,{left:`${drag.t.x}px`,top:`${drag.t.y}px`,width:`${drag.t.width}px`,height:`${drag.t.height}px`});$("#selectionStatus").textContent = `${drag.t.title}: ${drag.t.width} × ${drag.t.height}`; return;
    }
    const maxX = Math.max(0, $("#canvas").scrollWidth - drag.t.width), maxY = Math.max(0, $("#canvas").scrollHeight - drag.t.height),proposedX=Math.max(0,Math.min(maxX,Math.round((drag.x+e.clientX-drag.startX)/10)*10)),proposedY=Math.max(0,Math.min(maxY,Math.round((drag.y+e.clientY-drag.startY)/10)*10)),snapped=snapToObjects(drag.t,proposedX,proposedY);drag.t.x=Math.max(0,Math.min(maxX,snapped.x));drag.t.y=Math.max(0,Math.min(maxY,snapped.y)); const dx=drag.t.x-drag.x,dy=drag.t.y-drag.y;(drag.members||[]).forEach(member=>{member.item.x=Math.max(0,member.x+dx);member.item.y=Math.max(0,member.y+dy);const memberNode=$("#canvas").querySelector(`.tile[data-id="${member.item.id}"]`);if(memberNode){memberNode.style.left=`${member.item.x}px`;memberNode.style.top=`${member.item.y}px`;}}); drag.node.style.left = `${drag.t.x}px`; drag.node.style.top = `${drag.t.y}px`; $("#selectionStatus").textContent = `${selectedIds.size>1?`${selectedIds.size} objects`:drag.t.title}: ${drag.t.x}, ${drag.t.y}`;
  });
