    function draw(){fields.innerHTML=allFields.map(field=>`<div class="matrix-field" draggable="true" data-field="${esc(field)}"><b>${measureNames.includes(field)?"ƒx ":""}${esc(field)}</b></div>`).join("");const selected=state.values.find(value=>value.field===selectedValue)||state.values[0],rowOption=state.rowOptions[selectedRow]||{};options.innerHTML=`${[["Rows",state.rows,"row"],["Columns",state.columns,"column"]].map(([label,list,type])=>`<section><h4>${label}</h4><div class="field-well" data-drop-zone="${type}s">${list.length?list.map((field,index)=>`<div class="designer-chip ${type==="row"&&field===selectedRow?"selected":""}" data-select-row="${type==="row"?esc(field):""}" data-reorder-index="${index}"><span class="designer-drag-handle" draggable="true" data-reorder-zone="${type}s" data-reorder-index="${index}">☷</span><span>${esc(state.rowCaptions[field]||field)}</span><button data-remove-${type}="${index}">×</button></div>`).join(""):"Drag dimension fields here"}</div></section>`).join("")}${state.rows.length?`<section class="matrix-subtotal-options"><h4>Row subtotals</h4><label>Selected row<select data-selected-row>${state.rows.map(field=>`<option value="${esc(field)}" ${field===selectedRow?"selected":""}>${esc(state.rowCaptions[field]||field)}</option>`).join("")}</select></label><label class="check"><input data-row-subtotal type="checkbox" ${rowOption.subtotal?"checked":""}> Subtotal this row</label><label>Subtotal pretext<input data-row-pretext value="${esc(rowOption.pretext||"SUM")}" placeholder="SUM"></label><label>Layout<select data-matrix-layout><option value="tabular" ${state.layout==="tabular"?"selected":""}>Tabular</option><option value="outline" ${state.layout==="outline"?"selected":""}>Outline</option></select></label><label class="check"><input data-repeat-labels type="checkbox" ${state.repeatLabels?"checked":""}> Repeat tabular labels</label><label class="check"><input data-blank-line type="checkbox" ${state.blankLineAfterGroup?"checked":""}> Insert blank line after each group</label></section>`:""}<section><h4>Values</h4><div class="field-well" data-drop-zone="values">${state.values.map((value,index)=>`<div class="matrix-value ${value.field===selectedValue?"selected":""}" data-select-value="${esc(value.field)}" data-reorder-index="${index}"><span class="designer-drag-handle" draggable="true" data-reorder-zone="values" data-reorder-index="${index}">☷</span><b>${esc(value.caption||value.field)}</b><select data-aggregation="${index}">${["Sum","Average","Count","Min","Max"].map(mode=>`<option ${mode===(value.aggregation||"Sum")?"selected":""}>${mode}</option>`).join("")}</select><button data-remove-value="${index}">×</button></div>`).join("")||"Drag fields or measures here"}</div></section>${selected?`<section><h4>Selected value</h4>${columnPropertiesHtml(selected,allFields)}</section>`:""}${sortDesignerHtml(state.sorts,[...state.rows,...state.values.map(value=>value.field)])}`;refreshPreview();bind(selected);bindSortDesigner(options,state.sorts,[...state.rows,...state.values.map(value=>value.field)],draw);bindDesignerDrag(overlay,add);bindDesignerReorder(overlay,(zone,from,to)=>{const list=zone==="values"?state.values:state[zone],moved=list.splice(from,1)[0];if(!moved)return;list.splice(Math.min(to,list.length),0,moved);draw();});}
