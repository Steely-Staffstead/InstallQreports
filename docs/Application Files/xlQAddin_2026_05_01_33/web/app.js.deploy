  function clearAlignmentGuides(){document.querySelectorAll(".alignment-guide").forEach(guide=>guide.remove());}
  function showAlignmentGuides(vertical,horizontal){clearAlignmentGuides();const canvas=$("#canvas");if(vertical!=null)canvas.insertAdjacentHTML("beforeend",`<div class="alignment-guide alignment-guide-v" style="left:${vertical}px"></div>`);if(horizontal!=null)canvas.insertAdjacentHTML("beforeend",`<div class="alignment-guide alignment-guide-h" style="top:${horizontal}px"></div>`);}
  function snapToObjects(t,x,y){const tolerance=6,others=allObjects(page()).filter(item=>item.kind!=="connector"&&!selectedIds.has(item.id)),movingX=[{value:x,offset:0},{value:x+t.width/2,offset:t.width/2},{value:x+t.width,offset:t.width}],movingY=[{value:y,offset:0},{value:y+t.height/2,offset:t.height/2},{value:y+t.height,offset:t.height}];let bestX=null,bestY=null;for(const other of others){const targetsX=[other.x,other.x+other.width/2,other.x+other.width],targetsY=[other.y,other.y+other.height/2,other.y+other.height];for(const moving of movingX)for(const target of targetsX){const delta=target-moving.value;if(Math.abs(delta)<=tolerance&&(!bestX||Math.abs(delta)<Math.abs(bestX.delta)))bestX={delta,guide:target};}for(const moving of movingY)for(const target of targetsY){const delta=target-moving.value;if(Math.abs(delta)<=tolerance&&(!bestY||Math.abs(delta)<Math.abs(bestY.delta)))bestY={delta,guide:target};}}const result={x:x+(bestX?.delta||0),y:y+(bestY?.delta||0),vertical:bestX?.guide,horizontal:bestY?.guide};showAlignmentGuides(result.vertical,result.horizontal);return result;}
  function snapResizeToObjects(t,x,y,width,height,edge){const tolerance=6,others=allObjects(page()).filter(item=>item.kind!=="connector"&&!selectedIds.has(item.id));let bestX=null,bestY=null;for(const other of others){const targetsX=[other.x,other.x+other.width/2,other.x+other.width],targetsY=[other.y,other.y+other.height/2,other.y+other.height];if(edge.includes("e"))for(const target of targetsX){const delta=target-(x+width);if(Math.abs(delta)<=tolerance&&(!bestX||Math.abs(delta)<Math.abs(bestX.delta)))bestX={delta,guide:target,side:"e"};}if(edge.includes("w"))for(const target of targetsX){const delta=target-x;if(Math.abs(delta)<=tolerance&&(!bestX||Math.abs(delta)<Math.abs(bestX.delta)))bestX={delta,guide:target,side:"w"};}if(edge.includes("s"))for(const target of targetsY){const delta=target-(y+height);if(Math.abs(delta)<=tolerance&&(!bestY||Math.abs(delta)<Math.abs(bestY.delta)))bestY={delta,guide:target,side:"s"};}if(edge.includes("n"))for(const target of targetsY){const delta=target-y;if(Math.abs(delta)<=tolerance&&(!bestY||Math.abs(delta)<Math.abs(bestY.delta)))bestY={delta,guide:target,side:"n"};}}if(bestX?.side==="e")width+=bestX.delta;else if(bestX?.side==="w"){x+=bestX.delta;width-=bestX.delta;}if(bestY?.side==="s")height+=bestY.delta;else if(bestY?.side==="n"){y+=bestY.delta;height-=bestY.delta;}showAlignmentGuides(bestX?.guide,bestY?.guide);return{x,y,width,height};}
  function bindTiles() { document.querySelectorAll(".tile").forEach(node => { node.querySelectorAll("[data-tile-sort]").forEach(header=>header.addEventListener("click",e=>{e.stopPropagation();const t=allObjects(page()).find(item=>item.id===node.dataset.id);if(t)cycleTileSort(t,header.dataset.tileSort,e.shiftKey);})); node.addEventListener("contextmenu",e=>{e.preventDefault();selectedId=node.dataset.id;if(!selectedIds.has(selectedId))selectedIds=new Set([selectedId]);syncSelection();renderProperties();renderGraphicProperties();showTileMenu(e.clientX,e.clientY);}); node.addEventListener("pointerdown", e => { const id=node.dataset.id,multi=e.ctrlKey||e.metaKey||e.shiftKey;if(multi){if(selectedIds.has(id)&&selectedIds.size>1)selectedIds.delete(id);else selectedIds.add(id);}else if(!selectedIds.has(id))selectedIds=new Set([id]);selectedId=selectedIds.has(id)?id:[...selectedIds].at(-1)||null; const t = selectedTile(); if (!t) return; syncSelection(); renderProperties();renderGraphicProperties(); const endpoint=e.target.closest("[data-connector-end]"),handle=e.target.closest(".resize-handle"),resizing=!!handle,graphic=graphicKinds.has(t.kind)&&t.kind!=="connector";if(endpoint){node.setPointerCapture(e.pointerId);drag={mode:"connector",end:endpoint.dataset.connectorEnd,node,t,baseLeft:+node.dataset.left,baseTop:+node.dataset.top,startX:e.clientX,startY:e.clientY,changed:false};e.preventDefault();return;} if(multi)return;if(t.kind==="connector"||(!resizing&&!e.target.closest(".tile-header")&&!graphic)) return; node.setPointerCapture(e.pointerId); const members=[...selectedIds].map(memberId=>allObjects(page()).find(item=>item.id===memberId)).filter(Boolean).map(item=>({item,x:item.x,y:item.y}));drag = { mode: resizing ? "resize" : "move", edge:handle?.dataset.resize||"se", node, t, members, startX: e.clientX, startY: e.clientY, x: t.x, y: t.y, width: t.width, height: t.height,changed:false }; e.preventDefault(); }); }); }
