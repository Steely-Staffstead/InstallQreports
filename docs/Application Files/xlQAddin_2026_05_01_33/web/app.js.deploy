    function draw(){fields.innerHTML=state.map(item=>`<div class="designer-field-row" draggable="true" data-field="${esc(item.field)}"><span>☷ ${esc(item.field)}</span></div>`).join("");const selected=state.find(item=>item.field===selectedField)||state[0],visible=state.filter(item=>item.visible);options.innerHTML=`<label>Selected column<select data-selected-column>${visible.map(item=>`<option value="${esc(item.field)}" ${item.field===selected?.field?"selected":""}>${esc(item.caption||item.field)}</option>`).join("")}</select></label>${columnPropertiesHtml(selected,columns)}<section><h4>Columns</h4><div class="field-well column-list" data-drop-zone="columns">${visible.map((item,index)=>`<div class="designer-chip ${item.field===selectedField?"selected":""}" data-select-field="${esc(item.field)}" data-reorder-index="${index}"><span class="designer-drag-handle" draggable="true" data-reorder-zone="columns" data-reorder-index="${index}">☷</span><span>${esc(item.caption||item.field)}</span><button data-remove-column="${esc(item.field)}">×</button></div>`).join("")||"Drag fields here"}</div></section>${sortDesignerHtml(sorts,columns)}`;refreshPreview();bind(selected);bindSortDesigner(options,sorts,columns,draw);bindDesignerDrag(overlay,field=>{const item=state.find(entry=>entry.field===field);if(item){item.visible=true;selectedField=field;draw();}});bindDesignerReorder(overlay,(zone,from,to)=>{const visible=state.filter(item=>item.visible),hidden=state.filter(item=>!item.visible),moved=visible.splice(from,1)[0];if(!moved)return;visible.splice(Math.min(to,visible.length),0,moved);state.splice(0,state.length,...visible,...hidden);draw();});}
    function bind(selected){options.onclick=event=>{const chip=event.target.closest("[data-select-field]");if(chip&&!event.target.closest("button")){selectedField=chip.dataset.selectField;draw();return;}if(event.target.dataset.moveUp)move(event.target.dataset.moveUp,-1);if(event.target.dataset.moveDown)move(event.target.dataset.moveDown,1);if(event.target.dataset.removeColumn){state.find(item=>item.field===event.target.dataset.removeColumn).visible=false;selectedField=state.find(item=>item.visible)?.field;draw();}};options.querySelector("[data-selected-column]")?.addEventListener("change",event=>{selectedField=event.target.value;draw();});options.querySelector("[data-column-caption]")?.addEventListener("input",event=>{selected.caption=event.target.value;refreshPreview();});bindColumnFormat(options,selected,refreshPreview);options.querySelector("[data-column-align]")?.addEventListener("change",event=>{selected.align=event.target.value;refreshPreview();});options.querySelectorAll("[data-bar]").forEach(input=>input.addEventListener("input",event=>{selected.bar||={};selected.bar[event.target.dataset.bar]=event.target.type==="number"?+event.target.value:event.target.value;refreshPreview();}));}
