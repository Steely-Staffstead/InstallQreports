  function renderProperties() { const t = selectedTile(); $("#noSelection").classList.toggle("hidden", !!t); $("#tileProperties").classList.toggle("hidden", !t); $("#designTileButton").classList.toggle("hidden", !t || !["table", "matrix", "chart"].includes(t.kind)); $("#webChartButton").classList.toggle("hidden", !t || t.kind !== "chart"); if (!t) { $("#selectionStatus").textContent = "No tile selected"; return; } const graphic=graphicKinds.has(t.kind),dataBound=t.kind==="card";["tileTitle","tileText","tileX","tileY","tileWidth","tileHeight","tileHeader","tileBackground"].forEach(id=>$("#"+id)?.closest("label")?.classList.toggle("hidden",graphic));$("#tileField")?.closest("label")?.classList.toggle("hidden",graphic||!dataBound);const settingsSummary=document.querySelector(".tile-settings summary");if(settingsSummary)settingsSummary.textContent=graphic?"Graphic settings":"Tile settings";$("#selectionStatus").textContent = selectedIds.size>1?`${selectedIds.size} objects selected`:`${t.title} selected`; const fields = [...query().data.columns, ...query().measures.map(m => m.Name ?? m.name ?? m.OutputName ?? m.outputName).filter(Boolean)]; $("#tileField").innerHTML = `<option value="">Select field or measure…</option>${[...new Set(fields)].map(f => `<option ${f === t.field ? "selected" : ""}>${esc(f)}</option>`).join("")}`; $("#tileTitle").value = t.title || ""; $("#tileText").value = t.text || ""; const rich = ["text","graphicText"].includes(t.kind); $("#plainTextLabel").classList.toggle("hidden", t.kind !== "picture"); $("#richTextGroup").classList.toggle("hidden", !rich); $("#textTileFont").classList.toggle("hidden", !rich||graphic); if (rich && document.activeElement !== $("#richTextEditor")) $("#richTextEditor").innerHTML = sanitizeHtml(t.html || ""); if (rich) { $("#tileFontFamily").value = t.fontFamily || "Segoe UI"; $("#tileFontSize").value = t.fontSize || 14; $("#tileTextColor").value = t.textColor || "#1f2937"; } $("#tileX").value = t.x; $("#tileY").value = t.y; $("#tileWidth").value = t.width; $("#tileHeight").value = t.height; $("#tileHeader").checked = t.showHeader; $("#tileBackground").value = t.background; }
  function setLayer(command){const ordered=allObjects(page()).sort((a,b)=>(a.layer??0)-(b.layer??0)),index=ordered.findIndex(t=>t.id===selectedId);if(index<0)return;const [item]=ordered.splice(index,1);if(command==="front")ordered.push(item);else if(command==="back")ordered.unshift(item);else if(command==="forward")ordered.splice(Math.min(index+1,ordered.length),0,item);else ordered.splice(Math.max(0,index-1),0,item);ordered.forEach((t,i)=>t.layer=i);markDirty();render();}
  function showTileMenu(x,y){document.querySelector(".tile-context-menu")?.remove();const t=selectedTile(),menu=document.createElement("div");menu.className="tile-context-menu";menu.style.left=`${Math.min(x,innerWidth-190)}px`;menu.style.top=`${Math.min(y,innerHeight-260)}px`;menu.innerHTML=`${["table","matrix","chart"].includes(t.kind)?'<button data-tile-command="design">Design</button>':""}<button data-tile-command="front">Bring to front</button><button data-tile-command="forward">Bring forward</button><button data-tile-command="backward">Send backward</button><button data-tile-command="back">Send to back</button><button data-tile-command="duplicate">Duplicate</button><button class="danger" data-tile-command="delete">Delete</button>`;document.body.append(menu);menu.addEventListener("click",event=>{const command=event.target.dataset.tileCommand;if(command==="design")openTileDesigner();if(["front","forward","backward","back"].includes(command))setLayer(command);if(command==="duplicate")duplicateTile();if(command==="delete")deleteTile();menu.remove();});}
  function renderTextPadding(){let control=$("#textPaddingControl"),rounding=$("#textRoundingControl");if(!control){control=document.createElement("div");control.id="textPaddingControl";control.innerHTML='<label>Vertical text padding<input data-text-style="paddingY" type="number" min="0" max="80" step="2"></label>';$("#textTileFont")?.append(control);control.addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="text")return;t.paddingY=Math.max(0,Math.min(80,+event.target.value||0));markDirty();render();});}if(!rounding){rounding=document.createElement("label");rounding.id="textRoundingControl";rounding.innerHTML='Corner rounding %<input type="number" min="0" max="50" step="1">';$("#tileBackground")?.closest("label")?.before(rounding);rounding.addEventListener("change",event=>{const t=selectedTile();if(!t||graphicKinds.has(t.kind))return;t.rounding=Math.max(0,Math.min(50,+event.target.value||0));markDirty();render();});}const t=selectedTile(),roundedTile=t&&!graphicKinds.has(t.kind);$("#textBodySettings")?.classList.toggle("hidden",!["text","graphicText"].includes(t?.kind));control.classList.toggle("hidden",t?.kind!=="text");rounding.classList.toggle("hidden",!roundedTile);if(t?.kind==="text")control.querySelector("input").value=t.paddingY??6;if(roundedTile)rounding.querySelector("input").value=t.rounding??0;if($("#designTileButton b"))$("#designTileButton b").textContent="Design";}
  function renderPictureProperties(){let control=$("#pictureProperties");if(!control){control=document.createElement("div");control.id="pictureProperties";control.innerHTML='<label class="check"><input data-picture-scrollbars type="checkbox"> Hide scrollbars</label>';$("#tileProperties")?.append(control);control.addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="picture")return;t.hideScrollbars=event.target.checked;markDirty();render();});}const t=selectedTile();control.classList.toggle("hidden",t?.kind!=="picture");if(t?.kind==="picture")control.querySelector("[data-picture-scrollbars]").checked=!!t.hideScrollbars;}
  function renderTileSourceControl(){const tile=selectedTile(),label=$("#tileSourceLabel"),select=$("#tileSource"),dataBound=["card","table","matrix","chart"].includes(tile?.kind);if(!label||!select)return;label.classList.toggle("hidden",!dataBound);if(!dataBound)return;select.innerHTML=model.sources.map(source=>`<option value="${esc(source.id)}" ${source.id===(tile.sourceId||"main")?"selected":""}>${esc(source.name)}${source.kind==="main"?" (Main)":""}</option>`).join("");}
  function renderPropertyPanels(){renderProperties();renderHeaderProperties();renderTileSourceControl();renderTextPadding();renderPictureProperties();renderGraphicProperties();renderVisualProperties();renderVisualTypography();renderSubtotalProperties();renderCardProperties();renderCardCaptionProperties();renderCardBorderControl();renderLayerProperties();}
  function renderGraphicProperties(){
    let panel=$("#graphicProperties");
    if(!panel){panel=document.createElement("div");panel.id="graphicProperties";panel.className="hidden";$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.graphic;if(!t||!key)return;t[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?+event.target.value||0:event.target.value;if(key==="fromId")t.fromAnchor=null;if(key==="toId")t.toAnchor=null;markDirty();render();});}
    const t=selectedTile(),graphic=graphicKinds.has(t?.kind);panel.classList.toggle("hidden",!graphic);if(!graphic)return;
    const geometry=`<h4>Graphic</h4><div class="property-grid"><label>Left<input data-graphic="x" type="number" value="${t.x}"></label><label>Top<input data-graphic="y" type="number" value="${t.y}"></label><label>Width<input data-graphic="width" type="number" min="20" value="${t.width}"></label><label>Height<input data-graphic="height" type="number" min="30" value="${t.height}"></label></div>`;
    if(t.kind==="graphicText"){panel.innerHTML=geometry;return;}
    const targets=allObjects(page()).filter(item=>item.id!==t.id&&!["connector","line"].includes(item.kind)),choices=value=>`<option value="">Free endpoint</option>${targets.map(item=>`<option value="${item.id}" ${item.id===value?'selected':''}>${esc(item.title||item.kind)}</option>`).join('')}`;
    const styles=[['solid','Solid'],['dotted','Dotted'],['tightDotted','Tight dotted'],['dashed','Dashed'],['longDashed','Long dashed']];
    panel.innerHTML=`${geometry}<div class="property-grid"><label>Line color<input data-graphic="color" type="color" value="${t.color||'#475467'}"></label>${t.kind==='rectangle'?`<label>Fill<input data-graphic="fill" type="color" value="${t.fill||'#ffffff'}" ${t.noFill?'disabled':''}></label>`:''}<label>Thickness<input data-graphic="thickness" type="number" min="1" max="20" value="${t.thickness||2}"></label><label>Line style<select data-graphic="lineStyle">${styles.map(([value,label])=>`<option value="${value}" ${value===(t.lineStyle||'solid')?'selected':''}>${label}</option>`).join('')}</select></label></div>${['line','rectangle'].includes(t.kind)?`<label>Line shading %<input data-graphic="shadePercent" type="range" min="0" max="100" step="5" value="${t.shadePercent||0}"><span>${t.shadePercent||0}%</span></label>`:''}${t.kind==='line'?`<label>Angle<input data-graphic="angle" type="number" min="-180" max="180" value="${t.angle||0}"></label>`:''}${t.kind==='rectangle'?`<label class="check"><input data-graphic="noFill" type="checkbox" ${t.noFill?'checked':''}> No fill (transparent)</label><label>Corner rounding %<input data-graphic="rounding" type="number" min="0" max="50" value="${t.rounding||0}"></label>`:''}${t.kind==='connector'?`<label>Start object<select data-graphic="fromId">${choices(t.fromId)}</select></label><label>End object<select data-graphic="toId">${choices(t.toId)}</select></label><div class="property-grid"><label>Start style<select data-graphic="startStyle">${['none','arrow','point','many'].map(v=>`<option ${v===t.startStyle?'selected':''}>${v}</option>`).join('')}</select></label><label>End style<select data-graphic="endStyle">${['none','arrow','point','many'].map(v=>`<option ${v===t.endStyle?'selected':''}>${v}</option>`).join('')}</select></label></div><label>Arrow / endpoint size %<input data-graphic="arrowSize" type="number" min="40" max="250" value="${t.arrowSize||100}"></label><label>Route<select data-graphic="route"><option value="orthogonal" ${t.route==='orthogonal'||!t.route?'selected':''}>Orthogonal</option><option value="orthogonalMiddle" ${t.route==='orthogonalMiddle'?'selected':''}>Orthogonal (middle)</option><option value="straight" ${t.route==='straight'?'selected':''}>Straight</option><option value="curved" ${t.route==='curved'?'selected':''}>Curved</option></select></label>`:''}`;
  }
  function renderHeaderProperties(){let panel=$("#headerSettings");if(!panel){panel=document.createElement("details");panel.id="headerSettings";panel.innerHTML='<summary>Header settings</summary><label class="check"><input data-header="showHeader" type="checkbox"> Show header</label><label>Background color<input data-header="background" type="color"></label><label>Alignment<select data-header="alignment"><option value="left">Left</option><option value="center">Middle</option><option value="right">Right</option></select></label><div class="property-grid"><label>Font<select data-header="fontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-header="fontSize" type="number" min="8" max="72"></label></div><label>Text color<input data-header="color" type="color"></label><div class="header-emphasis"><label class="check"><input data-header="bold" type="checkbox"> Bold</label><label class="check"><input data-header="italic" type="checkbox"> Italic</label><label class="check"><input data-header="underline" type="checkbox"> Underline</label></div>';const title=$("#tileTitle")?.closest("label");title?.after(panel);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.header;if(!t||!key)return;if(key==="showHeader")t.showHeader=event.target.checked;else{t.header||={};t.header[key]=event.target.type==="checkbox"?event.target.checked:key==="fontSize"?Math.max(8,+event.target.value||13):event.target.value;}markDirty();render();});}const t=selectedTile(),visible=t&&!graphicKinds.has(t.kind);panel.classList.toggle("hidden",!visible);$("#tileHeader")?.closest("label")?.classList.add("hidden");if(!visible)return;panel.querySelector('[data-header="showHeader"]').checked=t.showHeader!==false;panel.querySelector('[data-header="background"]').value=t.header?.background||"#f3f6fa";panel.querySelector('[data-header="alignment"]').value=t.header?.alignment||"left";panel.querySelector('[data-header="fontFamily"]').value=t.header?.fontFamily||"Segoe UI";panel.querySelector('[data-header="fontSize"]').value=t.header?.fontSize||13;panel.querySelector('[data-header="color"]').value=t.header?.color||"#182230";panel.querySelector('[data-header="bold"]').checked=t.header?.bold!==false;panel.querySelector('[data-header="italic"]').checked=!!t.header?.italic;panel.querySelector('[data-header="underline"]').checked=!!t.header?.underline;}
  function renderLayerProperties(){let panel=$("#layerProperties");if(!panel){panel=document.createElement("details");panel.id="layerProperties";panel.innerHTML="<summary>Layer information</summary>";panel.addEventListener("change",event=>{const t=selectedTile();if(!t||event.target.id!=="tileLayer")return;t.layer=Math.max(0,+event.target.value||0);markDirty();render();});}const t=selectedTile();panel.classList.toggle("hidden",!t);if(t){panel.innerHTML=`<summary>Layer information</summary><label>Object ID<input type="text" value="${esc(t.id)}" readonly></label><label>Order<input id="tileLayer" type="number" min="0" value="${t.layer??0}"></label>`;$("#tileProperties")?.append(panel);}}
  function renderVisualProperties(){let panel=$("#visualAppearance");if(!panel){panel=document.createElement("details");panel.id="visualAppearance";panel.className="visual-appearance";panel.innerHTML='<summary>Table / Matrix settings</summary><div class="property-grid"><label>Column header<input data-appearance="headerColor" type="color"></label><label class="matrix-only-style">Row header<input data-appearance="rowHeaderColor" type="color"></label><label class="matrix-only-style">Total row<input data-appearance="totalRowColor" type="color"></label><label>Alternate rows<input data-appearance="alternateColor" type="color"></label><label>Text color<input data-appearance="textColor" type="color"></label><label>Grid color<input data-appearance="gridColor" type="color"></label></div><label class="check"><input data-appearance="showGrid" type="checkbox"> Show cell grid</label><label class="check"><input data-appearance="showTotals" type="checkbox"> Show totals row</label>';$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const key=event.target.dataset.appearance,t=selectedTile();if(!key||!["table","matrix"].includes(t?.kind))return;t.appearance||={};t.appearance[key]=event.target.type==="checkbox"?event.target.checked:event.target.value;markDirty();render();});}const t=selectedTile(),visible=["table","matrix"].includes(t?.kind);panel.classList.toggle("hidden",!visible);panel.querySelectorAll(".matrix-only-style").forEach(element=>element.classList.toggle("hidden",t?.kind!=="matrix"));if(visible){t.appearance||={};panel.querySelectorAll("[data-appearance]").forEach(input=>{const key=input.dataset.appearance,value=t.appearance[key];if(input.type==="checkbox")input.checked=key==="showGrid"?value!==false:!!value;else input.value=value||(key==="headerColor"||key==="rowHeaderColor"?"#f5f7fa":key==="totalRowColor"?"#eef2f7":key==="alternateColor"?"#ffffff":key==="textColor"?"#182230":"#e1e6ec");});}}
  function renderVisualTypography(){const panel=$("#visualAppearance");if(!panel)return;let controls=$("#visualTypography");if(!controls){controls=document.createElement("div");controls.id="visualTypography";controls.innerHTML='<div class="property-grid"><label>Font<select data-visual-type="fontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-visual-type="fontSize" type="number" min="8" max="72"></label></div><div class="header-emphasis"><label class="check"><input data-visual-type="bold" type="checkbox"> Bold</label><label class="check"><input data-visual-type="italic" type="checkbox"> Italic</label><label class="check"><input data-visual-type="underline" type="checkbox"> Underline</label></div>';panel.querySelector("summary")?.after(controls);controls.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.visualType;if(!["table","matrix"].includes(t?.kind)||!key)return;t.appearance||={};t.appearance[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?Math.max(8,+event.target.value||12):event.target.value;markDirty();render();});}const t=selectedTile(),visible=["table","matrix"].includes(t?.kind);controls.classList.toggle("hidden",!visible);if(!visible)return;controls.querySelector('[data-visual-type="fontFamily"]').value=t.appearance?.fontFamily||"Segoe UI";controls.querySelector('[data-visual-type="fontSize"]').value=t.appearance?.fontSize||12;controls.querySelector('[data-visual-type="bold"]').checked=!!t.appearance?.bold;controls.querySelector('[data-visual-type="italic"]').checked=!!t.appearance?.italic;controls.querySelector('[data-visual-type="underline"]').checked=!!t.appearance?.underline;}
  function renderSubtotalProperties(){let panel=$("#subtotalFormatting");if(!panel){panel=document.createElement("details");panel.id="subtotalFormatting";panel.innerHTML='<summary>Subtotals</summary><label>Outline row header<input data-matrix-setting="outlineCaption" type="text" placeholder="Rows"></label><label>Subtotal position<select data-matrix-setting="subtotalPosition"><option value="top">Top (group header)</option><option value="bottom">Bottom (after values)</option></select></label><label class="check"><input data-matrix-setting="showExpandCollapse" type="checkbox"> Show +/- buttons in Outline</label><h4>Subtotal formatting</h4><div class="property-grid"><label>Font<select data-subtotal="fontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-subtotal="fontSize" type="number" min="8" max="72"></label></div><div class="property-grid"><label>Text color<input data-subtotal="textColor" type="color"></label><label>Background<input data-subtotal="background" type="color"></label></div><div class="header-emphasis"><label class="check"><input data-subtotal="bold" type="checkbox"> Bold</label><label class="check"><input data-subtotal="italic" type="checkbox"> Italic</label><label class="check"><input data-subtotal="underline" type="checkbox"> Underline</label></div>';$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="matrix")return;t.design||={};t.design.matrixSpec||={};const setting=event.target.dataset.matrixSetting,key=event.target.dataset.subtotal;if(setting)t.design.matrixSpec[setting]=event.target.type==="checkbox"?event.target.checked:event.target.value;else if(key){t.design.matrixSpec.subtotalStyle||={};t.design.matrixSpec.subtotalStyle[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?Math.max(8,+event.target.value||12):event.target.value;}else return;markDirty();render();});}const t=selectedTile(),visible=t?.kind==="matrix";panel.classList.toggle("hidden",!visible);if(!visible)return;const spec=t.design?.matrixSpec||{},style=spec.subtotalStyle||{};panel.querySelector('[data-matrix-setting="outlineCaption"]').value=spec.outlineCaption||"Rows";panel.querySelector('[data-matrix-setting="subtotalPosition"]').value=spec.subtotalPosition||"top";panel.querySelector('[data-matrix-setting="showExpandCollapse"]').checked=!!spec.showExpandCollapse;panel.querySelector('[data-subtotal="fontFamily"]').value=style.fontFamily||"Segoe UI";panel.querySelector('[data-subtotal="fontSize"]').value=style.fontSize||12;panel.querySelector('[data-subtotal="textColor"]').value=style.textColor||"#182230";panel.querySelector('[data-subtotal="background"]').value=style.background||"#eef2f7";panel.querySelector('[data-subtotal="bold"]').checked=style.bold!==false;panel.querySelector('[data-subtotal="italic"]').checked=!!style.italic;panel.querySelector('[data-subtotal="underline"]').checked=!!style.underline;}
  function renderCardProperties(){let panel=$("#cardProperties");if(!panel){panel=document.createElement("div");panel.id="cardProperties";panel.className="card-properties hidden";$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const key=event.target.dataset.card,t=selectedTile();if(!key||t?.kind!=="card")return;t.card||={};t.card[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?(event.target.value===""?null:+event.target.value):event.target.value;markDirty();render();});}const t=selectedTile();panel.classList.toggle("hidden",t?.kind!=="card");if(t?.kind!=="card")return;const card=t.card||={},fields=[...new Set([...query().data.columns,...query().measures.map(item=>item.Name??item.OutputName??item.name??item.outputName).filter(Boolean)])],formats=["Auto","N0","N1","N2","K0","K1","M0","M1","P0","P1","P2","#,##0,","#,##0.0,,"];panel.innerHTML=`<h4>Card formatting</h4><div class="property-grid"><label>Number format<select data-card="numberFormat">${formats.map(value=>`<option ${value===(card.numberFormat||"Auto")?"selected":""}>${value}</option>`).join("")}</select></label><label>Percent format<select data-card="percentFormat">${["P0","P1","P2"].map(value=>`<option ${value===(card.percentFormat||"P1")?"selected":""}>${value}</option>`).join("")}</select></label><label>Value font<select data-card="fontFamily">${["Segoe UI","Arial","Calibri","Georgia","Consolas"].map(value=>`<option ${value===(card.fontFamily||"Segoe UI")?"selected":""}>${value}</option>`).join("")}</select></label><label>Value size<input data-card="fontSize" type="number" min="8" max="120" value="${card.fontSize||30}"></label><label>Weight<select data-card="fontWeight">${[[400,"Normal"],[600,"Semibold"],[700,"Bold"],[800,"Extra bold"]].map(([value,label])=>`<option value="${value}" ${+card.fontWeight===value?"selected":""}>${label}</option>`).join("")}</select></label><label>Default color<input data-card="valueColor" type="color" value="${card.valueColor||"#1d4f8f"}"></label></div><h4>Target and variance</h4><label>Target field / measure<select data-card="targetField"><option value="">Manual target</option>${fields.map(value=>`<option ${value===card.targetField?"selected":""}>${esc(value)}</option>`).join("")}</select></label><label>Manual target<input data-card="targetValue" type="number" step="any" value="${card.targetValue??""}"></label><label class="check"><input data-card="showDifference" type="checkbox" ${card.showDifference?"checked":""}> Show difference</label><label class="check"><input data-card="showPercentDifference" type="checkbox" ${card.showPercentDifference?"checked":""}> Show percent difference</label><label class="check"><input data-card="higherIsBetter" type="checkbox" ${card.higherIsBetter!==false?"checked":""}> Higher is better</label><div class="property-grid"><label>Positive color<input data-card="positiveColor" type="color" value="${card.positiveColor||"#16844a"}"></label><label>Negative color<input data-card="negativeColor" type="color" value="${card.negativeColor||"#c43d4b"}"></label></div><h4>Text</h4><div class="property-grid"><label>Prefix<input data-card="prefix" type="text" value="${esc(card.prefix||"")}"></label><label>Suffix<input data-card="suffix" type="text" value="${esc(card.suffix||"")}"></label></div><label>Advanced template<textarea data-card="template" rows="3" placeholder="This is @value for today {{parameter1}}">${esc(card.template||"")}</textarea></label><small class="card-help">Tokens: @value, @target, @difference, @percentDifference and {{parameterName}}.</small>`;}
  function renderCardCaptionProperties(){let panel=$("#cardCaptionProperties");if(!panel){panel=document.createElement("details");panel.id="cardCaptionProperties";panel.innerHTML='<summary>Caption</summary><label class="check"><input data-card-caption="showCaption" type="checkbox"> Show caption</label><label>Caption template<textarea data-card-caption="captionTemplate" rows="3" placeholder="@field"></textarea></label><small class="card-help">Tokens: @field, @value and {{parameterName}}.</small><div class="property-grid"><label>Font<select data-card-caption="captionFontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-card-caption="captionFontSize" type="number" min="8" max="72"></label></div><label>Text color<input data-card-caption="captionColor" type="color"></label><div class="header-emphasis"><label class="check"><input data-card-caption="captionBold" type="checkbox"> Bold</label><label class="check"><input data-card-caption="captionItalic" type="checkbox"> Italic</label><label class="check"><input data-card-caption="captionUnderline" type="checkbox"> Underline</label></div><label class="check"><input data-card-caption="transparentBackground" type="checkbox"> Transparent tile background</label>';$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.cardCaption;if(t?.kind!=="card"||!key)return;t.card||={};t.card[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?Math.max(8,+event.target.value||12):event.target.value;markDirty();render();});}const t=selectedTile(),visible=t?.kind==="card";panel.classList.toggle("hidden",!visible);if(!visible)return;const card=t.card||{};panel.querySelector('[data-card-caption="showCaption"]').checked=card.showCaption!==false;panel.querySelector('[data-card-caption="captionTemplate"]').value=card.captionTemplate||"@field";panel.querySelector('[data-card-caption="captionFontFamily"]').value=card.captionFontFamily||"Segoe UI";panel.querySelector('[data-card-caption="captionFontSize"]').value=card.captionFontSize||12;panel.querySelector('[data-card-caption="captionColor"]').value=card.captionColor||"#475467";panel.querySelector('[data-card-caption="captionBold"]').checked=!!card.captionBold;panel.querySelector('[data-card-caption="captionItalic"]').checked=!!card.captionItalic;panel.querySelector('[data-card-caption="captionUnderline"]').checked=!!card.captionUnderline;panel.querySelector('[data-card-caption="transparentBackground"]').checked=!!card.transparentBackground;}
  function renderCardBorderControl(){const panel=$("#cardCaptionProperties");if(!panel)return;let label=$("#cardBorderControl");if(!label){label=document.createElement("label");label.id="cardBorderControl";label.className="check";label.innerHTML='<input type="checkbox"> Remove tile border and shadow';panel.append(label);label.querySelector("input").addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="card")return;t.card||={};t.card.noBorder=event.target.checked;markDirty();render();});}const t=selectedTile();label.classList.toggle("hidden",t?.kind!=="card");if(t?.kind==="card")label.querySelector("input").checked=!!t.card?.noBorder;}
  function duplicateTile(){const source=selectedTile();if(!source)return;const copy=structuredClone(source);copy.id=uid();copy.title=`${source.title} copy`;copy.x+=20;copy.y+=20;copy.layer=Math.max(-1,...allObjects(page()).map(t=>Number(t.layer)||0))+1;(graphicKinds.has(copy.kind)?page().graphics:page().tiles).push(copy);selectedId=copy.id;selectedIds=new Set([copy.id]);markDirty();render();}
  function deleteTile(){if(!selectedTile())return;page().tiles=page().tiles.filter(t=>t.id!==selectedId);page().graphics=page().graphics.filter(t=>t.id!==selectedId);selectedId=null;selectedIds.clear();markDirty();render();}
  function openTileDesigner(){const t=selectedTile();if(!t)return;if(t.kind==="chart"){if(host)post("designWebChart",{query:query(),tile:t});else $("#jsonError").textContent="ChartWeb requires the Windows desktop host.";return;}if(t.kind==="table")openTableDesigner(t);if(t.kind==="matrix")openMatrixDesigner(t);}
  function designerShell(kind,title){document.querySelector(".visual-designer-overlay")?.remove();const overlay=document.createElement("div");overlay.className="visual-designer-overlay";overlay.innerHTML=`<section class="visual-designer"><header><div><strong>${title}</strong><small>Web visual designer</small></div><button data-close-designer>×</button></header><div class="visual-designer-layout"><main class="designer-preview"><h3>Preview</h3><div data-designer-preview></div></main><div class="designer-splitter" data-splitter="preview" title="Drag to resize preview"></div><aside class="designer-options"><h3>Options</h3><div data-designer-options></div></aside><div class="designer-splitter" data-splitter="fields" title="Drag to resize fields"></div><aside class="designer-fields"><h3>Fields</h3><p>Choose and arrange query fields.</p><div data-designer-fields></div></aside></div><footer><button data-close-designer>Cancel</button><button class="primary" data-apply-designer>Apply design</button></footer></section>`;document.body.append(overlay);overlay.querySelectorAll("[data-close-designer]").forEach(button=>button.onclick=()=>overlay.remove());bindDesignerResize(overlay);return overlay;}
  function bindDesignerResize(overlay){const layout=overlay.querySelector(".visual-designer-layout");let resizeState=null;layout.querySelectorAll("[data-splitter]").forEach(splitter=>splitter.addEventListener("pointerdown",event=>{const box=layout.getBoundingClientRect(),fields=layout.querySelector(".designer-fields").getBoundingClientRect(),options=layout.querySelector(".designer-options").getBoundingClientRect();resizeState={kind:splitter.dataset.splitter,left:box.left,fields:fields.width,options:options.width};splitter.setPointerCapture(event.pointerId);event.preventDefault();}));layout.addEventListener("pointermove",event=>{if(!resizeState)return;let fields=resizeState.fields,options=resizeState.options;if(resizeState.kind==="fields")fields=Math.max(180,Math.min(event.clientX-resizeState.left,layout.clientWidth-560));else options=Math.max(220,Math.min(event.clientX-resizeState.left-fields-12,layout.clientWidth-fields-300));layout.style.gridTemplateColumns=`${fields}px 6px ${options}px 6px minmax(280px,1fr)`;});layout.addEventListener("pointerup",()=>resizeState=null);}
  function bindDesignerDrag(overlay,onDrop){overlay.querySelectorAll("[draggable][data-field]").forEach(item=>item.addEventListener("dragstart",event=>{event.dataTransfer.effectAllowed="copyMove";event.dataTransfer.setData("text/plain",item.dataset.field);item.classList.add("dragging");}));overlay.querySelectorAll("[draggable][data-field]").forEach(item=>item.addEventListener("dragend",()=>item.classList.remove("dragging")));overlay.querySelectorAll("[data-drop-zone]").forEach(zone=>{zone.addEventListener("dragover",event=>{event.preventDefault();zone.classList.add("drag-over");});zone.addEventListener("dragleave",()=>zone.classList.remove("drag-over"));zone.addEventListener("drop",event=>{if(event.dataTransfer.types.includes("application/x-designer-reorder"))return;event.preventDefault();zone.classList.remove("drag-over");onDrop(event.dataTransfer.getData("text/plain"),zone.dataset.dropZone);});});}
  function bindDesignerReorder(overlay,onReorder){overlay.querySelectorAll("[draggable][data-reorder-zone]").forEach(handle=>{handle.addEventListener("dragstart",event=>{event.stopPropagation();event.dataTransfer.effectAllowed="move";event.dataTransfer.setData("application/x-designer-reorder",JSON.stringify({zone:handle.dataset.reorderZone,index:+handle.dataset.reorderIndex}));handle.closest(".designer-chip,.matrix-value")?.classList.add("dragging");});handle.addEventListener("dragend",()=>handle.closest(".designer-chip,.matrix-value")?.classList.remove("dragging"));});overlay.querySelectorAll("[data-drop-zone]").forEach(zone=>zone.addEventListener("drop",event=>{const raw=event.dataTransfer.getData("application/x-designer-reorder");if(!raw)return;event.preventDefault();event.stopImmediatePropagation();zone.classList.remove("drag-over");const source=JSON.parse(raw),target=event.target.closest("[data-reorder-index]");if(source.zone!==zone.dataset.dropZone)return;onReorder(source.zone,source.index,target?+target.dataset.reorderIndex:Number.MAX_SAFE_INTEGER);}));}
  const formatChoices=["Auto","N0","N1","N2","P0","P1","P2","K0","K1","M0","M1","yyyy-MM-dd","MMM yyyy","Custom"];
  function visualCell(value,column,row,columns,maxAbs=1,rowKind="detail"){const formatted=esc(format(value,column.format||column.Format||"Auto")),bar=column.bar||column.Bar||{},numeric=Number(value),scope=bar.scope||"GroupsAndDetail",wrongScope=(scope==="Groups"&&rowKind!=="group")||(scope==="Detail"&&rowKind!=="detail"),comparisonIndex=columns.indexOf(bar.comparisonField),backgroundIndex=columns.indexOf(bar.backgroundField),comparison=comparisonIndex>=0?Number(row[comparisonIndex]):NaN,background=backgroundIndex>=0?Number(row[backgroundIndex]):NaN;if(!bar.type||bar.type==="None"||wrongScope||!Number.isFinite(numeric))return formatted;const width=Math.min(100,Math.abs(numeric)/(Math.abs(Number.isFinite(background)?background:maxAbs)||1)*100),color=numeric<0?(bar.negativeColor||"#d95c5c"):(bar.color||"#4f8bd6"),align=bar.alignment||"Left",position=align==="Right"?`right:0`:align==="Center"?`left:${50-width/2}%`:`left:0`;if(bar.type==="Bullet"){const target=Number.isFinite(comparison)?Math.min(100,Math.abs(comparison)/(Math.abs(Number.isFinite(background)?background:maxAbs)||1)*100):0;return `<span class="cell-visual bullet-cell"><i class="bullet-background" style="width:${Number.isFinite(background)?100:width}%;background:${bar.backgroundColor||"#d8e0eb"}"></i><i class="bullet-value" style="width:${width}%;background:${color}"></i><i class="bullet-target" style="left:${target}%;background:${bar.targetColor||"#111827"};width:${bar.targetThickness||3}px"></i><b>${formatted}</b></span>`;}return `<span class="cell-visual"><i style="${position};width:${width}%;background:${color}"></i><b>${formatted}</b></span>`;}
  function columnPropertiesHtml(selected,fields){if(!selected)return "";const current=selected.format||"Auto",preset=formatChoices.includes(current)?current:"Custom",custom=preset==="Custom"?current:"#,##0.0",bar=selected.bar||={type:"None",alignment:"Left",scope:"GroupsAndDetail",color:"#4f8bd6",negativeColor:"#d95c5c",comparisonField:"",backgroundField:"",backgroundColor:"#d8e0eb",targetColor:"#111827",targetThickness:3};return `<label>Caption<input data-column-caption value="${esc(selected.caption||selected.field)}"></label><label>Format<select data-column-format>${formatChoices.map(value=>`<option ${value===preset?"selected":""}>${value}</option>`).join("")}</select></label><label data-custom-format-wrap class="${preset==="Custom"?"":"hidden"}">Custom format<input data-column-custom-format value="${esc(custom)}"><small data-format-preview>Preview: ${esc(format(1234567.89,custom))}</small></label><label>Alignment<select data-column-align>${["Auto","Left","Center","Right"].map(value=>`<option ${value===(selected.align||"Auto")?"selected":""}>${value}</option>`).join("")}</select></label><details class="column-bars"><summary>Data bar / bullet graph</summary><label>Bar type<select data-bar="type">${[["None","None"],["DataBar","Data bar"],["Bullet","Bullet graph"]].map(([value,label])=>`<option value="${value}" ${value===bar.type?"selected":""}>${label}</option>`).join("")}</select></label><div class="two-cols"><label>Alignment<select data-bar="alignment">${["Left","Center","Right"].map(value=>`<option ${value===bar.alignment?"selected":""}>${value}</option>`).join("")}</select></label><label>Draw bars on<select data-bar="scope">${[["GroupsAndDetail","Groups and detail"],["Groups","Groups only"],["Detail","Detail only"]].map(([value,label])=>`<option value="${value}" ${value===bar.scope?"selected":""}>${label}</option>`).join("")}</select></label><label>Bar color<input data-bar="color" type="color" value="${bar.color}"></label><label>Negative color<input data-bar="negativeColor" type="color" value="${bar.negativeColor}"></label></div><label>Comparison measure<select data-bar="comparisonField"><option value="">None</option>${fields.map(value=>`<option ${value===bar.comparisonField?"selected":""}>${esc(value)}</option>`).join("")}</select></label><label>Background measure<select data-bar="backgroundField"><option value="">Automatic</option>${fields.map(value=>`<option ${value===bar.backgroundField?"selected":""}>${esc(value)}</option>`).join("")}</select></label><div class="two-cols"><label>Backcolor<input data-bar="backgroundColor" type="color" value="${bar.backgroundColor}"></label><label>Target color<input data-bar="targetColor" type="color" value="${bar.targetColor}"></label><label>Target thickness<input data-bar="targetThickness" type="number" min="1" max="12" value="${bar.targetThickness}"></label></div></details>`;}
  function bindColumnFormat(container,selected,refreshPreview){const select=container.querySelector("[data-column-format]"),wrap=container.querySelector("[data-custom-format-wrap]"),custom=container.querySelector("[data-column-custom-format]"),preview=container.querySelector("[data-format-preview]");if(!select)return;const apply=()=>{const isCustom=select.value==="Custom";wrap?.classList.toggle("hidden",!isCustom);selected.format=isCustom?(custom?.value||"#,##0.0"):select.value;if(preview)preview.textContent=`Preview: ${format(1234567.89,selected.format)}`;refreshPreview();};select.addEventListener("change",apply);custom?.addEventListener("input",apply);}
  function sortDesignerHtml(sorts,fields){return `<section class="sort-designer"><h4>Advanced ordering</h4><small>Columns are applied from top to bottom.</small>${sorts.map((sort,index)=>`<div class="sort-row"><span>${index+1}</span><select data-sort-field="${index}">${fields.map(field=>`<option ${field===sort.field?"selected":""}>${esc(field)}</option>`).join("")}</select><select data-sort-direction="${index}"><option value="asc" ${sort.direction!=="desc"?"selected":""}>Ascending</option><option value="desc" ${sort.direction==="desc"?"selected":""}>Descending</option></select><button data-sort-up="${index}" title="Higher priority">↑</button><button data-sort-down="${index}" title="Lower priority">↓</button><button data-sort-remove="${index}" title="Remove">×</button></div>`).join("")}<button data-sort-add>+ Add ordering</button></section>`;}
  function bindSortDesigner(container,sorts,fields,redraw){container.querySelector("[data-sort-add]")?.addEventListener("click",()=>{const field=fields.find(name=>!sorts.some(sort=>sort.field===name))||fields[0];if(field){sorts.push({field,direction:"asc"});redraw();}});container.querySelectorAll("[data-sort-field]").forEach(input=>input.onchange=()=>{sorts[+input.dataset.sortField].field=input.value;redraw();});container.querySelectorAll("[data-sort-direction]").forEach(input=>input.onchange=()=>{sorts[+input.dataset.sortDirection].direction=input.value;redraw();});container.querySelectorAll("[data-sort-remove]").forEach(button=>button.onclick=()=>{sorts.splice(+button.dataset.sortRemove,1);redraw();});container.querySelectorAll("[data-sort-up]").forEach(button=>button.onclick=()=>{const i=+button.dataset.sortUp;if(i>0)[sorts[i-1],sorts[i]]=[sorts[i],sorts[i-1]];redraw();});container.querySelectorAll("[data-sort-down]").forEach(button=>button.onclick=()=>{const i=+button.dataset.sortDown;if(i<sorts.length-1)[sorts[i+1],sorts[i]]=[sorts[i],sorts[i+1]];redraw();});}
