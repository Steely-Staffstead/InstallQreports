  }
  function addTile(kind) { const chartPage=kind==="chartPage";if(chartPage){kind="chart";page().canvas.mode="preset";page().canvas.preset="800x300";page().canvas.width=800;page().canvas.height=300;}const d = tileDefaults[kind];if(!d)return; const offset = chartPage?0:allObjects(page()).length * 20; const t = { id: uid(), kind, sourceId:activeSourceId||"main", ...d, x: chartPage?10:30 + offset, y: chartPage?10:30 + offset, width:chartPage?780:d.width, height:chartPage?280:d.height, showHeader:!["line","rectangle","connector","graphicText"].includes(kind), background: "#ffffff", layer:Math.max(-1,...allObjects(page()).map(item=>Number(item.layer)||0))+1 }; if(["text","graphicText"].includes(kind))t.paddingY=6;if(kind==="connector"){const targets=allObjects(page()).filter(item=>!["connector","line"].includes(item.kind));t.fromId=targets.at(-2)?.id||"";t.toId=targets.at(-1)?.id||"";t.x1=t.x;t.y1=t.y;t.x2=t.x+t.width;t.y2=t.y+t.height;} (graphicKinds.has(kind)?page().graphics:page().tiles).push(t); selectedId = t.id;selectedIds=new Set([t.id]); $("#addMenu").classList.add("hidden");$("#graphicsMenu").classList.add("hidden"); markDirty(); render(); }
  function returnToHost(){if(!hostMode)return;post(hostMode==="powerpoint"?"returnPowerPoint":"returnExcel",{document:model,qrcnDocument:webToQrcn()});}
  function applyBridgeResult(msg) { document.body.classList.remove("busy"); const r = msg.result,targetSource=sourceById(msg.requestId)||activeSource();if(msg.action==="edit-query"&&parameterQueryDesigner){const pending=parameterQueryDesigner;parameterQueryDesigner=null;r.ok?pending.resolve(r.query):pending.reject(new Error(r.error||"Query designer was cancelled"));return;} if (r.cancelled) { $("#saveStatus").textContent = "Editor cancelled";if(refreshingAllSources)refreshNextSource();return; } if (!r.ok) { $("#jsonError").textContent = `${targetSource?.name||"Datasource"}: ${r.error||"Update failed"}`;if(refreshingAllSources)refreshNextSource();return; } const returnedParameters=r.parameters||r.query?.parameters;if(returnedParameters)setDocumentParameters(returnedParameters); if (r.measures) targetSource.query.measures = r.measures; if (r.query) { const savedFilters=targetSource.query.filters||[];targetSource.query = { ...targetSource.query, ...r.query, parameters:model.parameters, totalRows: r.totalRows ?? r.query.data?.rows?.length ?? 0, measureValues: r.measureValues || targetSource.query.measureValues || {}, filters:savedFilters }; } model.pages.forEach(item=>item.query=sourceById("main").query); const designTarget=msg.tileId?model.pages.flatMap(item=>item.tiles).find(tile=>tile.id===msg.tileId):selectedTile();if(r.design&&designTarget)designTarget.design=r.design; markDirty(); render(); $("#saveStatus").textContent = msg.action === "refresh" ? `Updated ${targetSource.query.data.rows.length}${targetSource.query.totalRows > targetSource.query.data.rows.length ? ` of ${targetSource.query.totalRows}` : ""} rows from ${targetSource.name}` : "Editor changes applied"; if(msg.action==="refresh"&&refreshingAllSources){refreshNextSource();return;} if(autoReturnHost&&msg.action==="refresh")returnToHost(); }
  function renderRecentFiles(){const menu=$("#recentMenu"),withoutExtension=path=>path.replace(/\.canvasweb\.json$/i,""),displayName=path=>withoutExtension(path.split(/[\\/]/).pop());menu.innerHTML=recentFiles.length?recentFiles.map((path,index)=>`<button type="button" data-recent-index="${index}" title="${esc(path)}"><b>${esc(displayName(path))}</b><small>${esc(withoutExtension(path))}</small></button>`).join(""):`<div class="recent-empty">No recent reports</div>`;}
  function showSourceDialog({title,value="",message="",confirmText="Save",danger=false,onConfirm}){document.querySelector(".source-dialog")?.remove();const dialog=document.createElement("dialog");dialog.className="source-dialog filter-values-dialog";dialog.innerHTML=`<form method="dialog"><h2>${esc(title)}</h2>${message?`<p>${esc(message)}</p>`:`<label>Name<input data-source-name value="${esc(value)}" maxlength="80"></label>`}<div class="dialog-actions"><button value="cancel">Cancel</button><button value="apply" class="${danger?"danger":"primary"}">${esc(confirmText)}</button></div></form>`;document.body.append(dialog);dialog.addEventListener("close",()=>{if(dialog.returnValue==="apply"){const name=dialog.querySelector("[data-source-name]")?.value.trim()||"";if(message||name)onConfirm(name);}dialog.remove();});dialog.showModal();dialog.querySelector("[data-source-name]")?.focus();}
  function addGlobalSource(){showSourceDialog({title:"Add global datasource",value:`Global source ${model.sources.length}`,confirmText:"Add source",onConfirm:name=>{const source=blankSource(uid(),name,"global");source.query.parameters=model.parameters;model.sources.push(source);activeSourceId=source.id;selectedId=null;selectedIds.clear();markDirty();render();}});}
  function renameActiveSource(){const source=sourceById(activeSourceId);if(!source)return;showSourceDialog({title:"Rename datasource",value:source.name,onConfirm:name=>{source.name=name;markDirty();render();}});}
  function deleteActiveSource(){const source=sourceById(activeSourceId);if(!source||source.kind==="main"){$("#jsonError").textContent="The Main source cannot be deleted.";return;}showSourceDialog({title:"Delete datasource",message:`Tiles using '${source.name}' will switch to Main source.`,confirmText:"Delete",danger:true,onConfirm:()=>{model.pages.forEach(item=>allObjects(item).forEach(tile=>{if(tile.sourceId===source.id)tile.sourceId="main";}));model.sources=model.sources.filter(item=>item.id!==source.id);activeSourceId="main";markDirty();render();}});}
  function invokeBridge(type) { if (!host) { $("#jsonError").textContent = "The existing QueryTool and Measures editor are available in the Windows desktop host. The hosted web version will use future web-native editors."; return; } if(type==="refresh"&&autoReturnHost&&!refreshingAllSources)return refreshAllSources(true);const source=activeSource(),payloadQuery=structuredClone(source?.query||query());if(type==="refresh")payloadQuery.filters=[];post(type, { requestId:source?.id||"main", query:payloadQuery }); }
  function refreshAllSources(returnWhenDone=false){sourceRefreshQueue=model.sources.filter(source=>source.query?.queryText).map(source=>source.id);returnAfterSourceRefresh=returnWhenDone;refreshingAllSources=true;selectedId=null;selectedIds.clear();refreshNextSource();}
  function refreshNextSource(){if(!sourceRefreshQueue.length){refreshingAllSources=false;if(returnAfterSourceRefresh){returnAfterSourceRefresh=false;returnToHost();}return;}activeSourceId=sourceRefreshQueue.shift();invokeBridge("refresh");}
  function syncJson() { $("#jsonEditor").value = JSON.stringify(model, null, 2); }
  function load(doc, fileName = "") { model = normalize(doc); if (!model.pages.length) throw new Error("Document must contain a page"); pageIndex = 0; selectedId = null;selectedIds.clear(); dirty = false; $("#saveStatus").textContent = fileName ? `Opened ${fileName}` : "Ready"; $("#jsonError").textContent = ""; render(); }
  function download() { const a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([JSON.stringify(model, null, 2)], { type: "application/json" })); a.download = `${(model.name || "report").replace(/[^a-z0-9_-]+/gi, "-")}.canvasweb.json`; a.click(); URL.revokeObjectURL(a.href); }
  function showSidePanel(name) { $("#propertiesPanel").classList.toggle("hidden", name !== "properties"); $("#filtersPanel").classList.toggle("hidden", name !== "filters"); document.querySelectorAll("[data-panel]").forEach(b => b.classList.toggle("active", b.dataset.panel === name)); }
  let connectorMotionSignature="";
  function animateAttachedConnectors(){
    if(drag?.mode==="move"){
      const signature=`${drag.t.id}:${drag.t.x}:${drag.t.y}`;
      if(signature!==connectorMotionSignature){connectorMotionSignature=signature;refreshConnectors();}
    }else connectorMotionSignature="";
    requestAnimationFrame(animateAttachedConnectors);
  }
  requestAnimationFrame(animateAttachedConnectors);
  document.addEventListener("pointerdown",event=>{if(event.target.closest(".tile")||event.target.id==="canvas")setTimeout(renderPropertyPanels,0);});
  $("#canvas").addEventListener("pointerdown",event=>{
    if(event.button!==0||event.target!==$("#canvas"))return;
    const box=$("#canvas").getBoundingClientRect(),startX=event.clientX-box.left,startY=event.clientY-box.top,element=document.createElement("div"),add=event.ctrlKey||event.metaKey||event.shiftKey;
    element.className="selection-marquee";$("#canvas").append(element);marquee={startX,startY,x:startX,y:startY,element,add,original:new Set(selectedIds)};if(!add){selectedIds.clear();selectedId=null;syncSelection();renderProperties();renderGraphicProperties();renderLayerProperties();}event.preventDefault();
  });
  window.addEventListener("pointermove",event=>{
    if(!marquee)return;const box=$("#canvas").getBoundingClientRect();marquee.x=event.clientX-box.left;marquee.y=event.clientY-box.top;const left=Math.min(marquee.startX,marquee.x),top=Math.min(marquee.startY,marquee.y),right=Math.max(marquee.startX,marquee.x),bottom=Math.max(marquee.startY,marquee.y);Object.assign(marquee.element.style,{left:`${left}px`,top:`${top}px`,width:`${right-left}px`,height:`${bottom-top}px`});selectedIds=marquee.add?new Set(marquee.original):new Set();allObjects(page()).filter(t=>t.kind!=="connector"&&t.x<right&&t.x+t.width>left&&t.y<bottom&&t.y+t.height>top).forEach(t=>selectedIds.add(t.id));selectedId=[...selectedIds].at(-1)||null;syncSelection();$("#selectionStatus").textContent=selectedIds.size?`${selectedIds.size} objects selected`:"Selecting…";
  });
  window.addEventListener("pointerup",()=>{if(!marquee)return;marquee.element.remove();marquee=null;renderProperties();renderGraphicProperties();renderLayerProperties();});
  document.addEventListener("pointerdown",event=>{if(!event.target.closest(".tile-context-menu"))document.querySelector(".tile-context-menu")?.remove();if(event.target.closest(".tile"))setTimeout(()=>{renderVisualProperties();renderVisualTypography();renderSubtotalProperties();renderCardProperties();renderCardCaptionProperties();renderCardBorderControl();renderGraphicProperties();},0);else if(event.target.id==="canvas"&&!marquee){selectedId=null;selectedIds.clear();document.querySelectorAll(".tile.selected").forEach(tile=>tile.classList.remove("selected"));renderProperties();renderVisualProperties();renderVisualTypography();renderSubtotalProperties();renderCardProperties();renderCardCaptionProperties();renderCardBorderControl();renderGraphicProperties();}});
