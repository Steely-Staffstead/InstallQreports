  function tablePreview(state,sorts=[]){const selected=state.filter(item=>item.visible),columns=query().data.columns,indexes=selected.map(item=>columns.indexOf(item.field)),rows=sortedRows(query().data.rows,columns,sorts);const maxima=indexes.map(index=>Math.max(1,...rows.map(row=>Math.abs(Number(row[index]))||0)));return `<table class="data-table"><thead><tr>${selected.map(item=>`<th>${esc(item.caption)}</th>`).join("")}</tr></thead><tbody>${rows.slice(0,30).map(row=>`<tr>${indexes.map((index,i)=>`<td style="text-align:${selected[i].align.toLowerCase()==="auto"?"left":selected[i].align.toLowerCase()}">${visualCell(row[index],selected[i],row,columns,maxima[i])}</td>`).join("")}</tr>`).join("")}</tbody></table>`;}
  function openMatrixDesigner(t){
