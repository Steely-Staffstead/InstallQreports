`).join("")}</select>${editor}</div>`;}
  function renderFilters(){const sourceFilters=query().filters||[];$("#filterList").innerHTML=sourceFilters.map((f,i)=>filterEditorHtml(f,i,"source")).join("");const selected=selectedTile(),eligible=selected&&!graphicKinds.has(selected.kind),tiles=(page().tiles||[]).filter(tile=>!graphicKinds.has(tile.kind));if($("#tileFilterContext"))$("#tileFilterContext").textContent=eligible?`Add new filters to: ${selected.title||selected.kind}`:"Select a data tile to add a local filter.";if($("#tileFilterList"))$("#tileFilterList").innerHTML=tiles.flatMap(tile=>(tile.filters||[]).map((f,i)=>filterEditorHtml(f,i,"tile",tile))).join("")||'<p class="property-empty">No local tile filters.</p>';document.querySelectorAll('[data-action="addTileFilter"],[data-action="applyTileFilters"]').forEach(button=>button.disabled=!eligible);}
  function filterRows(data,filters){const columns=data?.columns||[];let rows=[...(data?.rows||[])],rank=[];for(const f of filters||[]){if(f.enabled===false||!f.column)continue;const index=columns.findIndex(name=>String(name).toLowerCase()===String(f.column).toLowerCase());if(index<0)continue;const mode=f.mode||"Advanced";if(mode==="TopRows"||mode==="BottomRows"){rank.push({index,mode,n:Math.max(1,+f.n||10)});continue;}if(mode==="Basic"){const selected=new Set((f.basicValues||[]).map(String));if(selected.size)rows=rows.filter(row=>selected.has(String(row[index])));continue;}const expected=f.value??"",op=f.operator||"equals";rows=rows.filter(row=>{const actual=row[index],a=Number(actual),b=Number(expected),numeric=Number.isFinite(a)&&Number.isFinite(b);if(op===">")return numeric?a>b:String(actual)>String(expected);if(op===">=")return numeric?a>=b:String(actual)>=String(expected);if(op==="<")return numeric?a<b:String(actual)<String(expected);if(op==="<=")return numeric?a<=b:String(actual)<=String(expected);if(op==="contains")return String(actual).toLowerCase().includes(String(expected).toLowerCase());if(op==="notcontains")return !String(actual).toLowerCase().includes(String(expected).toLowerCase());if(op==="notequals")return numeric?a!==b:String(actual)!==String(expected);return numeric?a===b:String(actual)===String(expected);});}for(const item of rank)rows.sort((a,b)=>(Number(a[item.index])||0)-(Number(b[item.index])||0));for(const item of rank)rows=(item.mode==="TopRows"?rows.reverse():rows).slice(0,item.n);return{...(data||{}),rows};}
  function displayQueryForTile(tile){const source=sourceForTile(tile)||sourceById("main"),base=source.query,sourceData=filterRows(base.data,base.filters),tileData=filterRows(sourceData,tile.filters);return{...base,data:tileData,totalRows:tileData.rows.length};}
  function editBasicFilter(index,scope="source",tileId=""){const tile=scope==="tile"?allObjects(page()).find(item=>item.id===tileId):null,owner=scope==="tile"?tile:query(),sourceQuery=scope==="tile"?sourceForTile(tile)?.query:query(),filter=owner?.filters?.[index],columnIndex=sourceQuery?.data?.columns?.indexOf(filter?.column);if(!filter||columnIndex<0){alert("Choose a column first.");return}const values=[...new Set(sourceQuery.data.rows.map(row=>row[columnIndex]).filter(value=>value!=null).map(String))].sort((a,b)=>a.localeCompare(b,undefined,{numeric:true})),selected=new Set(filter.basicValues||[]),dialog=document.createElement("dialog");dialog.className="filter-values-dialog";dialog.innerHTML=`<form method="dialog"><h2>${scope==="tile"?`${esc(tile.title)} · `:""}Filter: ${esc(filter.column)}</h2><input data-value-search placeholder="Search values"><label class="check"><input type="checkbox" data-select-all> Select all visible values</label><div class="filter-value-list">${values.map(value=>`<label data-value-row><input type="checkbox" value="${esc(value)}" ${selected.has(value)?"checked":""}> <span>${esc(value)}</span></label>`).join("")}</div><div class="dialog-actions"><button value="cancel">Cancel</button><button value="apply" class="primary">Apply values</button></div></form>`;document.body.append(dialog);const visible=()=>[...dialog.querySelectorAll("[data-value-row]")].filter(row=>!row.hidden);dialog.querySelector("[data-value-search]").oninput=e=>{const term=e.target.value.toLowerCase();dialog.querySelectorAll("[data-value-row]").forEach(row=>row.hidden=!row.textContent.toLowerCase().includes(term));};dialog.querySelector("[data-select-all]").onchange=e=>visible().forEach(row=>row.querySelector("input").checked=e.target.checked);dialog.addEventListener("close",()=>{if(dialog.returnValue==="apply"){filter.basicValues=[...dialog.querySelectorAll("[data-value-row] input:checked")].map(input=>input.value);markDirty();render()}dialog.remove()});dialog.showModal();}
  function tileHtml(t) {
    if(t.kind==="connector")return connectorHtml(t);
    const header = t.showHeader ? `<div class="tile-header" style="background:${t.header?.background||"#f3f6fa"};font-family:${esc(t.header?.fontFamily||"Segoe UI")};font-size:${Math.max(8,+t.header?.fontSize||13)}px;color:${t.header?.color||"#182230"};font-weight:${t.header?.bold===false?400:700};font-style:${t.header?.italic?"italic":"normal"};text-decoration:${t.header?.underline?"underline":"none"}"><span style="flex:1;text-align:${t.header?.alignment||"left"}">${esc(t.title)}</span>${model.settings.showTypeTags===false?'':`<span class="tile-kind">${esc(t.kind)}</span>`}</div>` : `<div class="tile-header" style="height:12px;border:0;background:transparent"><span></span></div>`;
    const textVars = ["text","graphicText"].includes(t.kind) ? `--tile-font:${t.fontFamily || "Segoe UI"};--tile-font-size:${t.fontSize || 14}px;--tile-text-color:${t.textColor || "#1f2937"};--tile-padding-y:${t.paddingY ?? 6}px;` : "";
    const visualVars = ["table","matrix"].includes(t.kind) ? `--visual-header:${t.appearance?.headerColor||"#f5f7fa"};--visual-row-header:${t.appearance?.rowHeaderColor||"#f5f7fa"};--visual-total-row:${t.appearance?.totalRowColor||"#eef2f7"};--visual-alt:${t.appearance?.alternateColor||"#ffffff"};--visual-text:${t.appearance?.textColor||"#182230"};--visual-grid:${t.appearance?.gridColor||"#e1e6ec"};--visual-font:${t.appearance?.fontFamily||"Segoe UI"};--visual-size:${Math.max(8,+t.appearance?.fontSize||12)}px;--visual-weight:${t.appearance?.bold?700:400};--visual-style:${t.appearance?.italic?"italic":"normal"};--visual-decoration:${t.appearance?.underline?"underline":"none"};` : "";
    const rounding=Math.max(0,Math.min(50,+t.rounding||0)),radius=!['line','connector','graphicText'].includes(t.kind)?Math.round(Math.min(t.width,t.height)*rounding/100):0,rectangle=t.kind==="rectangle"?"background:transparent;border-color:transparent;box-shadow:none;":"",graphicText=t.kind==="graphicText"?"background:transparent;border-color:transparent;box-shadow:none;":"";
    return `<article class="tile tile-${t.kind} ${selectedIds.has(t.id)||t.id === selectedId ? "selected" : ""} ${model.settings.showDesignHandles ? "" : "hide-handles"} ${t.appearance?.showGrid===false?"no-table-grid":""} ${t.kind==="picture"&&t.hideScrollbars?"hide-picture-scrollbars":""}" data-id="${t.id}" style="z-index:${t.layer??0};left:${t.x}px;top:${t.y}px;width:${t.width}px;height:${t.height}px;background:${t.kind==='card'&&t.card?.transparentBackground?'transparent':t.background};border-radius:${radius}px;${t.kind==='card'&&t.card?.noBorder?'border-color:transparent;box-shadow:none;':''}${rectangle}${graphicText}${textVars}${visualVars}">${header}<div class="tile-body">${tileBody(t)}</div>${["nw","ne","sw","se"].map(edge=>`<div class="resize-handle resize-${edge}" data-resize="${edge}" title="Resize"></div>`).join("")}${connectionPortsHtml(t)}</article>`;
  }
  function portPoint(tile,anchor){const side=anchor?.side||"",raw=Number(anchor?.offset),offset=Math.max(0,Math.min(1,Number.isFinite(raw)?raw:.5));if(side==="top")return{x:tile.x+tile.width*offset,y:tile.y};if(side==="bottom")return{x:tile.x+tile.width*offset,y:tile.y+tile.height};if(side==="left")return{x:tile.x,y:tile.y+tile.height*offset};if(side==="right")return{x:tile.x+tile.width,y:tile.y+tile.height*offset};return null;}
  function anchorPoint(tile,toward,anchor){const fixed=portPoint(tile,anchor);if(fixed)return fixed;const cx=tile.x+tile.width/2,cy=tile.y+tile.height/2,dx=toward.x-cx,dy=toward.y-cy;if(Math.abs(dx/tile.width)>Math.abs(dy/tile.height))return{x:dx<0?tile.x:tile.x+tile.width,y:cy};return{x:cx,y:dy<0?tile.y:tile.y+tile.height};}
  function nearestPort(tile,point){const ports=["top","right","bottom","left"].flatMap(side=>[0,.25,.5,.75,1].map(offset=>({side,offset,point:portPoint(tile,{side,offset})})));return ports.sort((a,b)=>Math.hypot(a.point.x-point.x,a.point.y-point.y)-Math.hypot(b.point.x-point.x,b.point.y-point.y))[0];}
