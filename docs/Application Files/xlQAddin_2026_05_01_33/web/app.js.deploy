      const localX=x-drag.baseLeft,localY=y-drag.baseTop,other=drag.node.querySelector(`[data-connector-end="${start?'end':'start'}"]`),ox=+other.getAttribute('cx'),oy=+other.getAttribute('cy'),ax=start?localX:ox,ay=start?localY:oy,bx=start?ox:localX,by=start?oy:localY,mid=(ax+bx)/2,curve=Math.max(40,Math.abs(bx-ax)*.45),path=drag.t.route==="straight"?`M ${ax} ${ay} L ${bx} ${by}`:drag.t.route==="curved"?`M ${ax} ${ay} C ${ax+(bx>=ax?curve:-curve)} ${ay}, ${bx-(bx>=ax?curve:-curve)} ${by}, ${bx} ${by}`:`M ${ax} ${ay} L ${mid} ${ay} L ${mid} ${by} L ${bx} ${by}`;
      drag.node.querySelectorAll('.connector-path,.connector-hit').forEach(p=>p.setAttribute('d',path));e.target.setAttribute('cx',localX);e.target.setAttribute('cy',localY);return;
