      allObjects(p).forEach((t,index) => { t.id ||= uid(); t.layer ??= index; t.x ??= 30; t.y ??= 30; t.width ??= 300; t.height ??= 180; t.showHeader ??= !["line","rectangle","connector","graphicText"].includes(t.kind); t.background ||= "#ffffff"; if (["line","rectangle","connector"].includes(t.kind)){t.color||="#475467";t.thickness??=2;t.lineStyle||="solid";} if(t.kind==="line")t.angle??=0;if(t.kind==="rectangle")t.noFill??=false; if (["table","matrix"].includes(t.kind)) t.appearance = { headerColor:"#f5f7fa", rowHeaderColor:"#f5f7fa", totalRowColor:"#eef2f7", alternateColor:"#ffffff", textColor:"#182230", gridColor:"#e1e6ec", fontFamily:"Segoe UI", fontSize:12, bold:false, italic:false, underline:false, showGrid:true, showTotals:false, ...(t.appearance||{}) }; if (t.kind === "card") t.card={numberFormat:"Auto",percentFormat:"P1",fontFamily:"Segoe UI",fontSize:30,fontWeight:700,valueColor:"#1d4f8f",positiveColor:"#16844a",negativeColor:"#c43d4b",higherIsBetter:true,showDifference:false,showPercentDifference:false,prefix:"",suffix:"",template:"",showCaption:true,captionTemplate:"@field",captionFontFamily:"Segoe UI",captionFontSize:12,captionColor:"#475467",captionBold:false,captionItalic:false,captionUnderline:false,transparentBackground:false,...(t.card||{})}; if (["text","graphicText"].includes(t.kind)) { if (!t.html) t.html = `<p>${esc(t.text || "Text")}</p>`; t.fontFamily ||= "Segoe UI"; t.fontSize ||= 14; t.textColor ||= "#1f2937"; t.paddingY ??= 6; t.rounding??=0; } });
    }); return doc;
  }
  function correctFixedChartText(){/* SVGs preserve aspect ratio; keep authored text rotations intact. */}
  function ensureSourceUi(){
    if(!$("#sourceList")){const pagesHeading=[...document.querySelectorAll(".left-panel .section-heading")].find(node=>node.textContent.includes("Pages"));pagesHeading?.insertAdjacentHTML("beforebegin",'<div class="section-heading"><span>Data sources</span><button class="icon-button" data-action="addSource" title="Add global source">+</button></div><div id="sourceList" class="source-list"></div><div class="source-actions"><button data-action="renameSource">Rename</button><button data-action="deleteSource">Delete</button></div>');}
    if(!$("#activeSourceName")){const heading=document.querySelector(".query-summary b");if(heading)heading.id="activeSourceName";}
    if(!$("#tileSource")){const field=$("#tileField")?.closest("label");field?.insertAdjacentHTML("beforebegin",'<label id="tileSourceLabel">Data source<select id="tileSource"></select></label>');$("#tileSource")?.addEventListener("change",event=>{const tile=selectedTile();if(!tile)return;tile.sourceId=event.target.value;if(tile.design)delete tile.design.data;activeSourceId=tile.sourceId;markDirty();render();});}
    const filterTab=document.querySelector('[data-panel="filters"]');if(filterTab)filterTab.textContent="Filters";
    const filtersPanel=$("#filtersPanel");if(filtersPanel&&!$("#tileFilterList")){filtersPanel.querySelector(".panel-title").textContent="Source query filters";const note=filtersPanel.querySelector(".property-empty");if(note)note.textContent="Source filters use the data already loaded for this source and affect every tile connected to it.";note?.insertAdjacentHTML("afterend",'<hr class="filter-divider"><div class="panel-title">Tile filters</div><div id="tileFilterContext" class="filter-context">Select a data tile to add a local filter.</div><div id="tileFilterList"></div><button data-action="addTileFilter">+ Add local filter</button><button class="primary" data-action="applyTileFilters">Apply filter</button><p class="property-empty">Tile filters use loaded source data and affect only the referenced tile.</p>');}
  }
  function render() {
    ensureSourceUi();
    applyPaneLayout();
    $("#reportName").value = model.name || "";
    $("#hostBadge").textContent = host ? "Desktop bridge active" : "Web mode";
    $("#pageList").innerHTML = model.pages.map((p, i) => `<button class="page-item ${i === pageIndex ? "active" : ""}" data-page="${i}">${esc(p.name)}</button>`).join("");
    const currentSource=activeSource();activeSourceId=currentSource?.id||"main";$("#sourceList").innerHTML=model.sources.map(source=>`<button class="source-item ${source.id===activeSourceId?"active":""}" data-source-id="${esc(source.id)}"><span>${source.kind==="main"?"◆":"◇"}</span><b>${esc(source.name)}</b><small>${source.kind==="main"?"Main":"Global"}</small></button>`).join("");
    $("#pageName").value = page().name; $("#activeSourceName").textContent=currentSource?.name||"Main source"; $("#queryConnection").textContent = query().connectionName || "Not set"; $("#measureCount").textContent = query().measures.length; $("#rowCount").textContent = `${query().data.rows.length}${query().totalRows > query().data.rows.length ? ` of ${query().totalRows}` : ""}`; $("#previewLimit").value = query().previewLimit;
    $("#canvasSizeMode").value = page().canvas.mode; $("#canvasPreset").value = page().canvas.preset; $("#canvasWidth").value = page().canvas.width; $("#canvasHeight").value = page().canvas.height; $("#canvasPresetLabel").classList.toggle("hidden", page().canvas.mode !== "preset"); $("#manualCanvasSize").classList.toggle("hidden", page().canvas.mode !== "manual");
    $("#pageBackground").value = page().background.color; $("#pageBackgroundImage").value = page().background.image; $("#pageBackgroundFit").value = page().background.fit;
    Object.assign($("#canvas").style, { backgroundColor: page().background.color, backgroundImage: page().background.image ? `url("${page().background.image.replace(/["\\]/g, "")}")` : "", backgroundSize: page().background.image ? page().background.fit : "20px 20px", backgroundRepeat: page().background.image ? "no-repeat" : "repeat", backgroundPosition: "center" });
    applyCanvasSize(); renderFilters();
    $("#canvas").querySelectorAll(".tile").forEach(n => n.remove()); const objects=allObjects(page());$("#emptyState").classList.toggle("hidden", objects.length > 0);
    [...objects].sort((a,b)=>(a.layer??0)-(b.layer??0)).forEach(t => {renderQueryContext=displayQueryForTile(t);$("#canvas").insertAdjacentHTML("beforeend", tileHtml(t));renderQueryContext=null;});
    objects.forEach(t=>{const node=$("#canvas").querySelector(`.tile[data-id="${t.id}"]`);if(node)node.style.zIndex=t.layer??0;});
    bindTiles(); renderPropertyPanels(); correctFixedChartText($("#canvas")); syncJson();
  }
  function applyPaneLayout(){const root=document.documentElement,main=document.querySelector("main"),settings=model.settings;root.style.setProperty("--left-pane-width",`${Math.max(150,Math.min(480,settings.leftPaneWidth||205))}px`);root.style.setProperty("--right-pane-width",`${Math.max(220,Math.min(620,settings.rightPaneWidth||285))}px`);if(!document.querySelector("#canvasPaneDockStyles")){const style=document.createElement("style");style.id="canvasPaneDockStyles";style.textContent=`main{grid-template-columns:var(--left-pane-width,205px) 6px minmax(520px,1fr) 6px var(--right-pane-width,285px)}.pane-splitter{cursor:col-resize;background:#e2e7ef}.pane-splitter:hover{background:#9fb1cc}.pane-dock{position:sticky;top:0;z-index:5;width:28px;height:34px;padding:0;border-radius:7px}.left-panel .pane-dock{float:right}.right-panel .pane-dock{float:left}.left-collapsed{grid-template-columns:30px 0 minmax(520px,1fr) 6px var(--right-pane-width,285px)}.right-collapsed{grid-template-columns:var(--left-pane-width,205px) 6px minmax(520px,1fr) 0 30px}.left-collapsed.right-collapsed{grid-template-columns:30px 0 minmax(520px,1fr) 0 30px}.left-collapsed .left-panel,.right-collapsed .right-panel{padding:6px 1px;overflow:hidden}.left-collapsed .left-panel>*:not(.pane-dock),.right-collapsed .right-panel>*:not(.pane-dock){display:none}.left-collapsed .left-panel .pane-dock,.right-collapsed .right-panel .pane-dock{float:none;margin:auto}`;document.head.append(style);const left=document.createElement("button"),right=document.createElement("button");left.className="pane-dock";right.className="pane-dock";left.dataset.action="toggleLeftPane";right.dataset.action="toggleRightPane";document.querySelector(".left-panel").prepend(left);document.querySelector(".right-panel").prepend(right)}document.querySelector(".left-panel .pane-dock").textContent=settings.leftPaneCollapsed?"›":"‹";document.querySelector(".right-panel .pane-dock").textContent=settings.rightPaneCollapsed?"‹":"›";main.classList.toggle("left-collapsed",!!settings.leftPaneCollapsed);main.classList.toggle("right-collapsed",!!settings.rightPaneCollapsed);}
  function applyCanvasSize() { const c = page().canvas, canvas = $("#canvas"); if (c.mode === "fit") { canvas.style.width = "100%"; canvas.style.height = "100%"; } else { let width = c.width, height = c.height; if (c.mode === "preset") [width, height] = c.preset.split("x").map(Number); canvas.style.width = `${Math.max(320, width)}px`; canvas.style.height = `${Math.max(240, height)}px`; } }
