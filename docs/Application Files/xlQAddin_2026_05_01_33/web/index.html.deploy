<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Report designer</title><link rel="stylesheet" href="styles.css"><link rel="stylesheet" href="designer.css?v=20260903-1"><link rel="stylesheet" href="parameter-editor.css"><link rel="stylesheet" href="canvas-filter.css?v=20260904-1"></head><body>
<header class="app-header"><div class="brand"><span class="brand-mark">Q</span><div><strong>Report designer</strong><small>QReports web canvas</small></div></div><div class="file-actions"><button id="returnHost" class="excel-return hidden" data-action="returnHost">↩ Return</button><button data-action="new">New</button><button data-action="open">Open file</button><div class="recent-menu-wrap"><button data-action="toggleRecent">Recent ▾</button><div id="recentMenu" class="recent-menu hidden"><div class="recent-empty">No recent reports</div></div></div><button class="primary" data-action="save">Save</button><button data-action="saveAs">Save as</button></div></header>
<nav class="commandbar"><div class="command-group"><button class="command" data-action="editQuery"><span>⌁</span><b>Edit query</b></button><button class="command" data-action="editMeasures"><span>ƒx</span><b>Measures</b></button><button class="command" data-action="editParameters"><span>◉</span><b>Parameters</b></button><button class="command accent" data-action="refresh"><span>↻</span><b>Update</b></button><button id="designTileButton" class="command hidden" data-action="designTile"><span>⚙</span><b>Legacy design</b></button><button id="webChartButton" class="command hidden" data-action="designWebChart"><span>◒</span><b>Web chart</b></button></div><div class="separator"></div><div class="add-menu"><button class="command" data-action="toggleAdd"><span>＋</span><b>Add tile</b></button><div id="addMenu" class="menu hidden"><button data-add-tile="card">▣ <span>Card</span></button><button data-add-tile="text">T <span>Text</span></button><button data-add-tile="picture">▧ <span>Picture</span></button><button data-add-tile="table">▦ <span>Table</span></button><button data-add-tile="matrix">⊞ <span>Matrix</span></button><button data-add-tile="chart">⌁ <span>Chart</span></button><button data-add-tile="chartPage">▰ <span>Chart page with header</span></button></div></div><div class="add-menu"><button class="command" data-action="toggleGraphics"><span>◇</span><b>Add graphic</b></button><div id="graphicsMenu" class="menu hidden"><button data-add-tile="connector">↝ <span>Connector</span></button><button data-add-tile="line">╱ <span>Line</span></button><button data-add-tile="rectangle">▭ <span>Rectangle</span></button></div></div><div class="separator"></div><button class="command" data-action="toggleHandles"><span>⌗</span><b>Handles</b></button><button class="command" data-action="toggleTypeTags"><span>TAG</span><b>Header tags</b></button><button class="command" data-action="showFilters"><span>⏷</span><b>Filters</b></button><button class="command danger" data-action="deleteTile"><span>⌫</span><b>Delete</b></button><div class="command-spacer"></div><span id="hostBadge" class="badge">Web mode</span></nav>
<main><aside class="left-panel"><div class="panel-title">Report structure</div><label>Report name<input id="reportName" type="text"></label><div class="section-heading"><span>Pages</span><button class="icon-button" data-action="addPage">+</button></div><div id="pageList" class="page-list"></div><label>Current page name<input id="pageName" type="text"></label><div class="query-summary"><b>Page query</b><dl><dt>Connection</dt><dd id="queryConnection">Not set</dd><dt>Measures</dt><dd id="measureCount">0</dd><dt>Rows</dt><dd id="rowCount">0</dd></dl><label>Preview rows<input id="previewLimit" type="number" min="0" max="50000" step="500"></label><small>0 returns all rows; large previews use more memory.</small></div><div class="page-style"><b>Canvas size</b><label>Mode<select id="canvasSizeMode"><option value="fit">Fit window</option><option value="preset">Preset</option><option value="manual">Manual</option></select></label><label id="canvasPresetLabel">Preset<select id="canvasPreset"><option value="640x360">640 × 360</option><option value="800x450">800 × 450</option><option value="960x540">960 × 540</option><option value="800x300">800 × 300 — chart with header</option><option value="960x360">960 × 360 — chart with header</option><option value="1280x720">1280 × 720</option><option value="1600x900">1600 × 900</option><option value="1920x1080">1920 × 1080</option><option value="1123x794">A4 landscape</option></select></label><div id="manualCanvasSize" class="property-grid"><label>Width<input id="canvasWidth" type="number" min="320"></label><label>Height<input id="canvasHeight" type="number" min="240"></label></div></div><div class="page-style"><b>Page background</b><label>Color<input id="pageBackground" type="color"></label><label>Image URL<input id="pageBackgroundImage" type="text" placeholder="https://…"></label><label>Image fit<select id="pageBackgroundFit"><option value="cover">Cover</option><option value="contain">Contain</option><option value="auto">Original</option></select></label></div></aside>
<div class="pane-splitter left-splitter" data-pane-resize="left" title="Drag to resize report structure"></div><section class="workspace"><div id="canvasViewport" class="canvas-viewport"><div id="canvas" class="canvas"><div id="emptyState" class="empty-state"><b>Build your report</b><span>Add a tile, then drag it anywhere on the canvas.</span><button data-action="toggleAdd">Add first tile</button></div></div></div><div class="statusbar"><span id="selectionStatus">No tile selected</span><span id="saveStatus">Ready</span></div></section><div class="pane-splitter right-splitter" data-pane-resize="right" title="Drag to resize properties"></div>
<aside class="right-panel"><div class="panel-tabs"><button class="active" data-panel="properties">Properties</button><button data-panel="filters">Page filters</button></div><div id="propertiesPanel"><div id="noSelection" class="property-empty">Select a tile to edit its properties.</div><div id="tileProperties" class="properties hidden"><label>Title<input id="tileTitle" type="text"></label><label>Data field<select id="tileField"></select></label><label id="plainTextLabel">Text / image URL<textarea id="tileText" rows="4"></textarea></label><div id="richTextGroup" class="hidden"><span class="field-label">Formatted text (HTML)</span><div class="rich-toolbar"><button type="button" data-rich="bold"><b>B</b></button><button type="button" data-rich="italic"><i>I</i></button><button type="button" data-rich="underline"><u>U</u></button><button type="button" data-rich="insertUnorderedList">• List</button><button type="button" data-rich="indent">→</button><button type="button" data-rich="outdent">←</button><select id="richFont"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select><select id="richSize"><option value="2">Small</option><option value="3" selected>Normal</option><option value="5">Large</option><option value="7">Title</option></select><input id="richColor" type="color" value="#1f2937"></div><div id="richTextEditor" class="rich-editor" contenteditable="true"></div></div><div id="textTileFont" class="hidden"><div class="property-grid"><label>Tile font<select id="tileFontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Base size<input id="tileFontSize" type="number" min="8" max="72"></label></div><label>Base text color<input id="tileTextColor" type="color"></label></div><div class="property-grid"><label>Left<input id="tileX" type="number"></label><label>Top<input id="tileY" type="number"></label><label>Width<input id="tileWidth" type="number"></label><label>Height<input id="tileHeight" type="number"></label></div><label class="check"><input id="tileHeader" type="checkbox"> Show header</label><label>Background<input id="tileBackground" type="color"></label></div><details><summary>Document JSON</summary><textarea id="jsonEditor" spellcheck="false"></textarea><div class="json-actions"><button data-action="applyJson">Apply</button><button data-action="download">Download</button><label class="file-button">Upload<input id="upload" type="file" accept=".json"></label></div><p id="jsonError" class="error"></p></details></div><div id="filtersPanel" class="hidden"><div class="panel-title">Page query filters</div><div id="filterList"></div><button data-action="addFilter">+ Add filter</button><button class="primary" data-action="applyFilters">Apply filters</button><p class="property-empty">Filters apply to the page query and therefore all visuals.</p></div></aside></main><script src="measure-evaluator.js"></script><script src="chart-renderer.js"></script><script src="parameter-editor.js"></script><script src="app.js?v=20260903-5"></script></body></html>
