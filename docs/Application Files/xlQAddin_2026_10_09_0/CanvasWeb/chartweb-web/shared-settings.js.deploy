(() => {
  const host=window.chrome?.webview;
  const defaults={zoom:1,records:1000,queryShowTabs:false,miniSqlMaxSourceRows:0,miniSqlMaxIntermediateRows:0,miniSqlMaxResultRows:0,miniSqlTimeoutSeconds:0,defaultChartTheme:'Default',defaultChartColors:[],colorPreset:'Custom',themeIconMode:'auto',defaultSavePath:'',openMostRecentFileOnStartup:false,themeRoles:{},defaultCanvasSizeMode:'fit',defaultCanvasPreset:'1280x720',defaultCanvasWidth:1280,defaultCanvasHeight:720,showHiddenPagesWhileEditing:false,confirmDeleteTiles:true,compressPastedImages:true,pastedImageResolution:'1',pastedImageFormat:'image/webp',pastedImageQuality:70,linkedImageCompression:'balanced',aiCliProvider:'chatgpt',copilotFeatureAuditEnabled:true,experienceMode:'standard'};
  const standardExperience={version:1,defaultMode:'standard',modes:[{id:'standard',name:'Standard',description:'Use the familiar Qanvas names and standard interface icons.',terms:{},icons:{},concepts:[]}]};
  let experienceCatalog=standardExperience,experienceLoading=null,experienceObserver=null,applyingExperience=false;
  const experienceMode=()=>experienceCatalog.modes.find(mode=>mode.id===settings.experienceMode)||experienceCatalog.modes.find(mode=>mode.id===experienceCatalog.defaultMode)||experienceCatalog.modes[0];
  async function loadExperienceModes(){
    if(experienceLoading)return experienceLoading;
    experienceLoading=fetch('experience-modes.json',{cache:'no-store'}).then(response=>response.ok?response.json():Promise.reject(Error(`HTTP ${response.status}`))).then(value=>{if(!Array.isArray(value?.modes)||!value.modes.some(mode=>mode?.id==='standard'))throw Error('Invalid experience-mode configuration');experienceCatalog=value;return value;}).catch(()=>standardExperience);
    return experienceLoading;
  }
  function applyExperienceNode(node,mode){
    if(!(node instanceof Element))return;
    const label=node.dataset.experienceLabel;if(label){node.dataset.experienceOriginalLabel??=node.textContent;node.textContent=mode.terms?.[label]||node.dataset.experienceOriginalLabel;}
    const title=node.dataset.experienceTitle;if(title){node.dataset.experienceOriginalTitle??=node.title;node.title=mode.terms?.[title]||node.dataset.experienceOriginalTitle;}
    const icon=node.dataset.experienceIcon;if(icon){node.dataset.experienceOriginalIcon??=node.innerHTML;const source=mode.icons?.[icon];if(source){const image=document.createElement('img');image.src=source;image.alt='';image.loading='lazy';node.replaceChildren(image);node.classList.add('experience-mode-icon');}else{node.innerHTML=node.dataset.experienceOriginalIcon;node.classList.remove('experience-mode-icon');}}
  }
  function applyExperienceMode(){
    if(!document.documentElement)return;const mode=experienceMode();document.documentElement.dataset.experienceMode=mode.id;applyingExperience=true;
    document.querySelectorAll('[data-experience-label],[data-experience-title],[data-experience-icon]').forEach(node=>applyExperienceNode(node,mode));applyingExperience=false;
    window.dispatchEvent(new CustomEvent('qvitr-experience-changed',{detail:mode}));
  }
  function observeExperience(){
    if(experienceObserver||!document.body)return;experienceObserver=new MutationObserver(records=>{if(applyingExperience)return;const mode=experienceMode();applyingExperience=true;for(const record of records)for(const node of record.addedNodes)if(node instanceof Element){applyExperienceNode(node,mode);node.querySelectorAll?.('[data-experience-label],[data-experience-title],[data-experience-icon]').forEach(child=>applyExperienceNode(child,mode));}applyingExperience=false;});experienceObserver.observe(document.body,{childList:true,subtree:true});
  }
  const roleDefaults={text:'#182230',accent:'#4f6ee8',surface:'#ffffff',headerBackground:'#eef3f9',headerText:'#344054',grid:'#dce3ec',positive:'#16844a',negative:'#c43d4b'};
  const colorPresets={
    Light:{roles:roleDefaults,chartTheme:'Default'},
    Dark:{roles:{text:'#e8edf7',accent:'#8ca7ff',surface:'#182234',headerBackground:'#101827',headerText:'#f3f6fd',grid:'#3b4b62',positive:'#5bdd9a',negative:'#ff7d89'},chartTheme:'Bright'},
    Midnight:{roles:{text:'#e9f2ff',accent:'#69b8ff',surface:'#142a3b',headerBackground:'#0c1a29',headerText:'#f5f9ff',grid:'#365367',positive:'#63d9b0',negative:'#ff8b91'},chartTheme:'NightOcean'},
    ArcticBlue:{roles:{text:'#dcebff',accent:'#40c8f4',surface:'#0f1d36',headerBackground:'#081428',headerText:'#f3f9ff',grid:'#29496a',positive:'#5ed9c1',negative:'#ff7894'},chartTheme:'ArcticBlue'},
    Graphite:{roles:{text:'#eceff3',accent:'#e0ae69',surface:'#292b30',headerBackground:'#1d1f23',headerText:'#f6f7fa',grid:'#50545d',positive:'#89d48d',negative:'#f18e83'},chartTheme:'NightAmber'},
    VioletNight:{roles:{text:'#dce3f2',accent:'#9cdecc',surface:'#172033',headerBackground:'#111827',headerText:'#e9edf7',grid:'#35435c',positive:'#79dcb3',negative:'#f08da3'},chartTheme:'NightViolet'},
    Windows:{roles:{text:'#202b3c',accent:'#0067c0',surface:'#f8fbff',headerBackground:'#e8f1fb',headerText:'#193453',grid:'#cbdceb',positive:'#107c41',negative:'#c42b1c'},chartTheme:'Excel'},
    Ocean:{roles:{text:'#143441',accent:'#007f86',surface:'#f1fbfc',headerBackground:'#d9f1f2',headerText:'#0c5056',grid:'#b9dfe1',positive:'#12805c',negative:'#bd4b55'},chartTheme:'SeaGreen'},
    Forest:{roles:{text:'#273629',accent:'#46744c',surface:'#f7faf5',headerBackground:'#e5eee3',headerText:'#2b4d31',grid:'#cbdac7',positive:'#237344',negative:'#ae4d42'},chartTheme:'EarthTones'},
    Plum:{roles:{text:'#352944',accent:'#7b4baa',surface:'#fbf8ff',headerBackground:'#eee5f7',headerText:'#4d3466',grid:'#dccce9',positive:'#328169',negative:'#bd4969'},chartTheme:'Berry'},
    Sandstone:{roles:{text:'#423226',accent:'#a45b31',surface:'#fffaf4',headerBackground:'#f5e7d7',headerText:'#54331e',grid:'#e7d4bf',positive:'#427547',negative:'#a53d3d'},chartTheme:'EarthTones'},
    Alpine:{roles:{text:'#18332f',accent:'#087f70',surface:'#f3fbf8',headerBackground:'#ddf0e9',headerText:'#174a3d',grid:'#bedbd0',positive:'#13805c',negative:'#b54850'},chartTheme:'SeaGreen'},
    Slate:{roles:{text:'#202d3e',accent:'#456da5',surface:'#f7f9fc',headerBackground:'#e4eaf2',headerText:'#263d59',grid:'#cbd5e2',positive:'#28734f',negative:'#b84d50'},chartTheme:'Muted'},
    Coral:{roles:{text:'#432b31',accent:'#b85465',surface:'#fff9f8',headerBackground:'#fae8e8',headerText:'#663139',grid:'#ebcccf',positive:'#35795c',negative:'#b63d50'},chartTheme:'Pastel'},
    Indigo:{roles:{text:'#292d4d',accent:'#575ab5',surface:'#f8f8ff',headerBackground:'#e8e9f8',headerText:'#34366e',grid:'#d1d3eb',positive:'#2e8069',negative:'#b94b6d'},chartTheme:'Bright'},
    Citrus:{roles:{text:'#333727',accent:'#728d27',surface:'#fcfdf5',headerBackground:'#edf3d5',headerText:'#3b5022',grid:'#d8e3b7',positive:'#397b42',negative:'#ae4a3b'},chartTheme:'EarthTones'}
  };
  const paletteDefaults={Default:["#4f6ee8","#16a085","#e67e22","#8e5bd9","#d64562","#2e86c1","#7d8f29","#a66a3f"],Bright:["#3366cc","#dc3912","#ff9900","#109618","#990099","#0099c6","#dd4477","#66aa00"],Pastel:["#8db3e2","#f4b183","#a9d18e","#d5a6bd","#ffe699","#9dc3e6","#c9c9c9","#b4a7d6"],Muted:["#607d8b","#78909c","#8d6e63","#7e57c2","#5c6bc0","#26a69a","#9e9d24","#ef6c00"],Excel:["#4472c4","#ed7d31","#a5a5a5","#ffc000","#5b9bd5","#70ad47","#264478","#9e480e"],EarthTones:["#6b705c","#a5a58d","#b7b7a4","#cb997e","#ddbea9","#7f5539","#9c6644","#386641"],Berry:["#5b2a86","#8b3a9c","#b94e8f","#d8647a","#e9856f","#9c2c77","#692c70","#3d285d"],SeaGreen:["#006d77","#0a9396","#2a9d8f","#52b788","#74c69d","#95d5b2","#40916c","#1b4332"],Fire:["#7f0000","#b30000","#d7301f","#ef6548","#fc8d59","#fdbb84","#fdd49e","#ffeda0"],Grayscale:["#20242a","#414850","#626b75","#838e99","#a5afb9","#c4cbd2","#dce1e5","#eff1f3"],NightOcean:["#69b8ff","#60ddc8","#f7c978","#b69cff","#f18e9b","#83c7d8","#b6db78","#edaa7a"],ArcticBlue:["#40c8f4","#2478e5","#7357ff","#8fd8ff","#a8b7ff","#4f7ddd","#64e0d2","#c5e9ff"],NightAmber:["#e0ae69","#84c9b1","#a8b8e9","#df91a6","#bdd47d","#92c7dd","#c7a1db","#e6ba9b"],NightViolet:["#9cdecc","#b4a6ed","#82add8","#d8bb8c","#e49eaf","#9cc5b0","#b5bdda","#d4a8c7"]};
  let settings={...defaults};
  if(!host)try{settings={...defaults,...JSON.parse(localStorage.getItem('qreports-shared-settings')||'{}')};}catch{}
  globalThis.QReportsSettings={get:()=>settings,open,presets:colorPresets,experience:()=>experienceMode(),experiences:()=>experienceCatalog.modes,applyExperience:node=>applyExperienceNode(node,experienceMode()),presetLabels:{Light:'Light mode',Dark:'Dark mode',Midnight:'Midnight ocean',ArcticBlue:'Arctic blue',Graphite:'Warm graphite',VioletNight:'Violet night',Windows:'Windows mode',Ocean:'Ocean mist',Forest:'Forest',Plum:'Plum twilight',Sandstone:'Warm sandstone',Alpine:'Alpine green',Slate:'Soft slate',Coral:'Coral blush',Indigo:'Indigo dusk',Citrus:'Citrus leaf'}};
  function apply(value){settings={...defaults,...value};const roles={...roleDefaults,...settings.themeRoles};for(const [name,cssName] of Object.entries({accent:'accent',surface:'surface',text:'text',headerBackground:'header',headerText:'header-text',grid:'grid',positive:'positive',negative:'negative'}))document.documentElement.style.setProperty(`--qreports-${cssName}`,roles[name]);const luminance=hex=>{const channels=[1,3,5].map(index=>parseInt(hex.slice(index,index+2),16)/255).map(channel=>channel<=.04045?channel/12.92:((channel+.055)/1.055)**2.4);return .2126*channels[0]+.7152*channels[1]+.0722*channels[2];};for(const name of ['accent','positive','negative'])document.documentElement.style.setProperty(`--qreports-on-${name}`,luminance(roles[name])>.18?'#17213a':'#ffffff');const darkSurface=luminance(roles.surface)<.215,hasTheme=Object.keys(settings.themeRoles||{}).length>0;document.documentElement.style.setProperty('--qreports-color-scheme',darkSurface?'dark':'light');document.documentElement.toggleAttribute('data-qreports-theme',hasTheme&&!darkSurface);document.documentElement.toggleAttribute('data-qreports-query-theme',hasTheme);document.documentElement.toggleAttribute('data-qreports-app-theme',hasTheme);applyExperienceMode();window.dispatchEvent(new CustomEvent('qreports-settings-changed',{detail:settings}));}
  function installCanvasSettings(dialog){
    const group=document.createElement('details');group.className='settings-group';
    group.innerHTML='<summary data-experience-label="canvas">Canvas</summary><label class="settings-checkbox"><input name="showHiddenPagesWhileEditing" type="checkbox"> Show hidden pages while editing</label><small>Hidden pages remain excluded from presentations and exports.</small><label class="settings-checkbox"><input name="confirmDeleteTiles" type="checkbox"> Confirm before deleting tiles</label><small>When enabled, Delete asks before removing selected tiles or graphics.</small><details class="settings-subgroup"><summary data-experience-label="canvasSize">Default canvas size</summary><label>Size mode<select name="defaultCanvasSizeMode"><option value="fit">Fit window</option><option value="preset">Preset</option><option value="manual">Manual</option></select></label><label class="settings-canvas-preset">Preset size<select name="defaultCanvasPreset"></select></label><div class="settings-canvas-manual settings-colors"><label>Width (px)<input name="defaultCanvasWidth" type="number" min="320" max="16384" required></label><label>Height (px)<input name="defaultCanvasHeight" type="number" min="240" max="16384" required></label></div><small>Applies to new reports and newly added pages. Existing page sizes are unchanged.</small></details><details class="settings-subgroup"><summary>Image compression</summary><label>Default linked-image quality<select name="linkedImageCompression"><option value="original">Original (PNG)</option><option value="high">High (2400 px, 90%)</option><option value="balanced">Balanced (1600 px, 82%)</option><option value="small">Small (1100 px, 70%)</option></select></label><small>Used for new linked images in Excel and PowerPoint. Each image can override this during import or update.</small><label class="settings-checkbox"><input name="compressPastedImages" type="checkbox"> Compress pasted screenshots by default</label><small>You will be asked on each paste. Compression is used only when it makes the image smaller.</small><div class="settings-colors"><label>Resolution<select name="pastedImageResolution"><option value="1">Display size</option><option value="2">2× display size</option><option value="original">Original pixels</option></select></label><label>Format<select name="pastedImageFormat"><option value="image/webp">WebP</option><option value="image/jpeg">JPEG</option><option value="image/png">PNG</option></select></label></div><label>Quality (%)<input name="pastedImageQuality" type="number" min="35" max="95" required></label></details>';
    group.querySelector('summary').insertAdjacentHTML('afterend','<label class="settings-checkbox"><input name="openMostRecentFileOnStartup" type="checkbox"> Open most recent file on startup</label><small>When disabled, opening Qanvas directly starts with a new blank canvas. Opening a specific file still opens that file.</small><details class="settings-subgroup settings-ai-tool"><summary data-experience-label="aiTool">AI tool</summary><label>CLI provider<select name="aiCliProvider"><option value="chatgpt">ChatGPT / Codex CLI</option><option value="copilot">GitHub Copilot CLI</option></select></label><div class="settings-ai-prerequisite" data-ai-provider-help="copilot"><b>GitHub Copilot CLI prerequisite</b><ol><li>Install in Windows Terminal: <code>winget install GitHub.Copilot</code></li><li>Open a new terminal and run: <code>copilot login</code></li><li>Complete GitHub sign-in, then restart Qanvas.</li></ol><small>The Visual Studio Copilot extension and Windows Copilot app do not install this CLI. A Copilot plan is required and organization policy must allow CLI access.</small><label class="settings-checkbox"><input name="copilotFeatureAuditEnabled" type="checkbox"> Run automatic feature audit and repair turns</label><small>When disabled, Qanvas still validates the canvas once after Copilot finishes, but skips the slower feature audit and automatic repair turns.</small></div><div class="settings-ai-prerequisite" data-ai-provider-help="chatgpt"><b>ChatGPT / Codex CLI prerequisite</b><small>Install and sign in to the Codex desktop/CLI environment before using Qanvas CLI chat.</small></div><div class="settings-ai-data-notice"><b>Data and generated output</b><p>When you use an AI workflow, requests, screenshots, relevant workspace files, and canvas content may be sent to the selected AI provider. Do not include information you are not permitted to share. You are responsible for reviewing generated changes and for determining whether generated output requires attribution or a third-party license.</p></div></details>');
    group.querySelectorAll('.settings-subgroup').forEach(section=>{Object.assign(section.style,{margin:'14px 0 0',padding:'12px 14px',border:'1px solid var(--qreports-grid)',borderRadius:'8px',background:'color-mix(in srgb,var(--qreports-surface) 92%,var(--qreports-header))'});Object.assign(section.querySelector('summary').style,{cursor:'pointer',fontWeight:'650'});});
    group.querySelectorAll('.settings-ai-prerequisite,.settings-ai-data-notice').forEach(section=>Object.assign(section.style,{margin:'12px 0 0',padding:'10px 12px',border:'1px solid var(--qreports-grid)',borderRadius:'7px',background:'var(--qreports-surface)'}));group.querySelector('.settings-ai-data-notice').style.borderLeft='4px solid var(--qreports-accent)';
    const presets=[...document.querySelectorAll('#canvasPreset option')].map(option=>option.value);
    if(!presets.length)presets.push('640x360','960x540','1280x720','1600x900','1920x1080','2560x1440','3840x2160','960x720','1123x794','794x1123','1240x1754','2480x3508');
    if(!presets.includes(settings.defaultCanvasPreset))presets.push(settings.defaultCanvasPreset);
    group.querySelector('[name=defaultCanvasPreset]').replaceChildren(...presets.map(size=>new Option(size.replace('x',' × '),size)));
    group.querySelectorAll('.settings-checkbox input').forEach(input=>Object.assign(input.style,{display:'inline-block',width:'auto',marginRight:'8px'}));
    dialog.querySelectorAll('.settings-group')[1].before(group);
    group.querySelector('[name=defaultCanvasSizeMode]').addEventListener('change',()=>toggleCanvasSizeFields(dialog));
  }
  function toggleCanvasSizeFields(dialog){
    const mode=dialog.querySelector('[name=defaultCanvasSizeMode]').value;
    dialog.querySelector('.settings-canvas-preset').style.display=mode==='preset'?'block':'none';
    dialog.querySelector('.settings-canvas-manual').style.display=mode==='manual'?'grid':'none';
    for(const name of ['defaultCanvasWidth','defaultCanvasHeight'])dialog.querySelector(`[name=${name}]`).disabled=mode!=='manual';
  }
  function installExperienceSettings(dialog){
    const group=document.createElement('details');group.className='settings-group settings-experience';group.innerHTML='<summary>Experience</summary><label>Interface mode<select name="experienceMode"></select></label><small data-experience-description></small><div class="settings-experience-concepts" aria-live="polite"></div><small>Experimental modes change interface terms and selected icons only. Reports, formulas and saved file formats are unchanged.</small>';
    const select=group.querySelector('[name=experienceMode]'),description=group.querySelector('[data-experience-description]'),concepts=group.querySelector('.settings-experience-concepts');
    select.replaceChildren(...experienceCatalog.modes.map(mode=>new Option(mode.name,mode.id)));select.value=experienceCatalog.modes.some(mode=>mode.id===settings.experienceMode)?settings.experienceMode:experienceCatalog.defaultMode;
    const render=()=>{const mode=experienceCatalog.modes.find(item=>item.id===select.value)||experienceCatalog.modes[0];description.textContent=mode.description||'';concepts.replaceChildren(...(mode.concepts||[]).map(concept=>{const card=document.createElement('article');if(concept.icon){const image=document.createElement('img');image.src=concept.icon;image.alt='';image.loading='lazy';card.append(image);}else{const letter=document.createElement('span');letter.textContent=concept.letter||'';card.append(letter);}const copy=document.createElement('div'),name=document.createElement('b'),tagline=document.createElement('small');name.textContent=`${concept.letter?concept.letter+' — ':''}${concept.name||''}`;tagline.textContent=concept.tagline||'';copy.append(name,tagline);card.append(copy);return card;}));concepts.hidden=!concepts.children.length;};
    select.addEventListener('change',render);render();
    const general=[...dialog.querySelectorAll('.settings-group')].find(section=>section.querySelector(':scope>summary')?.textContent==='General');general?.after(group);
  }
  async function open(){
    await loadExperienceModes();
    document.querySelector('#sharedSettingsDialog')?.remove();const dialog=document.createElement('dialog');dialog.id='sharedSettingsDialog';
    dialog.innerHTML='<form method="dialog"><header><h2>Settings</h2><button value="cancel" aria-label="Close">×</button></header><details class="settings-group"><summary>Colors</summary><div class="settings-color-preview" aria-label="Color preview"><div class="settings-preview-card"><div class="settings-preview-heading">Report preview</div><div class="settings-preview-body"><strong class="settings-preview-accent">42,500</strong><p>Sample report text</p><span class="settings-preview-positive">Positive +12%</span> <span class="settings-preview-negative">Negative −8%</span></div></div></div><div class="settings-colors"></div><label>Default chart theme for new canvases<select name="defaultChartTheme"></select></label><div class="settings-chart-preview" aria-label="Chart palette preview"></div><button type="button" class="settings-restore-colors">Restore color defaults</button></details><details class="settings-group"><summary>General</summary><label>Current zoom<select name="zoom"><option value="0.75">75%</option><option value="0.9">90%</option><option value="1">100%</option><option value="1.1">110%</option><option value="1.25">125%</option><option value="1.5">150%</option><option value="2">200%</option></select></label><small class="settings-zoom-help">Applied when settings are saved and used again at startup.</small><label>Default save folder<input name="defaultSavePath" type="text" placeholder="Choose your preferred folder path"></label></details><details class="settings-group"><summary>Query</summary><label>Default records to return<input name="records" type="number" min="0" max="50000"></label><small>Used for new queries. 0 returns all records. Right-click a query tab to set its own row count.</small></details><details class="settings-group"><summary>MiniSQL limits</summary><small>Limits apply to local MiniSQL queries. 0 disables a limit; existing installations remain unlimited until you set one.</small><label>Maximum rows in each source<input name="miniSqlMaxSourceRows" type="number" min="0" max="10000000" required></label><label>Maximum intermediate rows<input name="miniSqlMaxIntermediateRows" type="number" min="0" max="10000000" required></label><label>Maximum result rows<input name="miniSqlMaxResultRows" type="number" min="0" max="10000000" required></label><label>Query timeout (seconds)<input name="miniSqlTimeoutSeconds" type="number" min="0" max="3600" required></label></details><p class="settings-error"></p><footer><button value="cancel">Cancel</button><button type="button" class="settings-save">Save settings</button></footer></form>';
    dialog.querySelector('.settings-group summary').textContent='Colors and theme';
    installCanvasSettings(dialog);
    installExperienceSettings(dialog);
    window.CanvasPaletteDesigner?.install(dialog);
    const presetLabel=document.createElement('label');presetLabel.textContent='Color combination';
    const presetSelect=document.createElement('select');presetSelect.name='colorPreset';
    presetSelect.replaceChildren(new Option('Custom','Custom'),...Object.keys(colorPresets).map(name=>new Option(({Light:'Light mode',Dark:'Dark mode',Midnight:'Midnight ocean',ArcticBlue:'Arctic blue',Graphite:'Warm graphite',VioletNight:'Violet night',Windows:'Windows mode',Ocean:'Ocean mist',Forest:'Forest',Plum:'Plum twilight',Sandstone:'Warm sandstone',Alpine:'Alpine green',Slate:'Soft slate',Coral:'Coral blush',Indigo:'Indigo dusk',Citrus:'Citrus leaf'})[name],name)));
    presetLabel.append(presetSelect);dialog.querySelector('.settings-color-preview').before(presetLabel);
    const presetHelp=document.createElement('small');presetHelp.textContent='Sets the color roles and chart palette for new reports. Existing reports keep their own colors.';presetLabel.after(presetHelp);
    const iconLabel=document.createElement('label');iconLabel.textContent='Qvitr icon colors';const iconMode=document.createElement('select');iconMode.name='themeIconMode';iconMode.append(new Option('Match the selected color theme','auto'),new Option('Always use the standard Qvitr icon','default'));iconMode.value=settings.themeIconMode||'auto';iconLabel.append(iconMode);presetHelp.after(iconLabel);
    const iconPreview=document.createElement('div');iconPreview.className='settings-brand-preview';Object.assign(iconPreview.style,{display:'flex',alignItems:'center',gap:'12px',margin:'8px 0 16px'});const iconPreviewImage=document.createElement('img');Object.assign(iconPreviewImage.style,{width:'52px',height:'52px',borderRadius:'13px',objectFit:'cover'});iconPreviewImage.alt='Qvitr icon preview';const iconPreviewText=document.createElement('small');iconPreviewText.textContent='The icon follows the selected theme. Only the matching small image is loaded.';iconPreview.append(iconPreviewImage,iconPreviewText);iconLabel.after(iconPreview);
    dialog.querySelector('.settings-save').style.background='var(--qreports-accent)';
    [...dialog.querySelectorAll('.settings-group')].find(group=>group.querySelector('summary')?.textContent==='Query')?.querySelector('small')?.insertAdjacentHTML('beforebegin','<label class="settings-checkbox" style="display:flex;align-items:center;gap:8px"><input name="queryShowTabs" type="checkbox" style="width:auto"> Show tabs</label>');
    dialog.querySelector('[name=queryShowTabs]').checked=!!settings.queryShowTabs;
    const roles={...roleDefaults,...settings.themeRoles};Object.entries(roles).forEach(([name,color])=>{const label=document.createElement('label');label.textContent=name.replace(/([A-Z])/g,' $1');const input=document.createElement('input');input.type='color';input.dataset.role=name;input.value=color;label.append(input);dialog.querySelector('.settings-colors').append(label);});
    const paletteNames=['Default','Bright','Pastel','Muted','Excel','EarthTones','Berry','SeaGreen','Fire','Grayscale','ArcticBlue',...(window.canvasSettingsPalettes||[]).map(item=>item.name),settings.defaultChartTheme];dialog.querySelector('[name=defaultChartTheme]').replaceChildren(...[...new Set(paletteNames)].map(name=>new Option(name,name)));
    const zoomSelect=dialog.querySelector('[name=zoom]');if(![...zoomSelect.options].some(option=>Number(option.value)===settings.zoom))zoomSelect.add(new Option(`${Math.round(settings.zoom*100)}%`,settings.zoom));
    for(const key of ['zoom','records','miniSqlMaxSourceRows','miniSqlMaxIntermediateRows','miniSqlMaxResultRows','miniSqlTimeoutSeconds','defaultChartTheme','defaultSavePath','defaultCanvasSizeMode','defaultCanvasPreset','defaultCanvasWidth','defaultCanvasHeight','pastedImageResolution','pastedImageFormat','pastedImageQuality','linkedImageCompression','aiCliProvider','experienceMode'])dialog.querySelector(`[name=${key}]`).value=settings[key];
    const updateAiProviderHelp=()=>dialog.querySelectorAll('[data-ai-provider-help]').forEach(section=>section.hidden=section.dataset.aiProviderHelp!==dialog.querySelector('[name=aiCliProvider]').value);dialog.querySelector('[name=aiCliProvider]').addEventListener('change',updateAiProviderHelp);updateAiProviderHelp();
    dialog.querySelector('[name=compressPastedImages]').checked=settings.compressPastedImages!==false;
    dialog.querySelector('[name=openMostRecentFileOnStartup]').checked=settings.openMostRecentFileOnStartup===true;
    dialog.querySelector('[name=copilotFeatureAuditEnabled]').checked=settings.copilotFeatureAuditEnabled!==false;
    dialog.querySelector('[name=showHiddenPagesWhileEditing]').checked=settings.showHiddenPagesWhileEditing===true;
    dialog.querySelector('[name=confirmDeleteTiles]').checked=settings.confirmDeleteTiles!==false;
    let restoredColors=false;
    let presetPalette=null;
    const chartColors=()=>{const name=dialog.querySelector('[name=defaultChartTheme]').value;return presetPalette||(restoredColors&&name==='Default'?paletteDefaults.Default:(window.canvasSettingsPalettes||[]).find(item=>item.name===name)?.colors||(name===settings.defaultChartTheme&&settings.defaultChartColors?.length?settings.defaultChartColors:paletteDefaults[name]||paletteDefaults.Default));};
    const activeRoles=()=>Object.fromEntries([...dialog.querySelectorAll('[data-role]')].map(input=>[input.dataset.role,input.value]));
    const findPreset=()=>Object.entries(colorPresets).find(([,preset])=>preset.chartTheme===dialog.querySelector('[name=defaultChartTheme]').value&&Object.entries(preset.roles).every(([role,color])=>activeRoles()[role]?.toLowerCase()===color.toLowerCase()))?.[0]||'Custom';
    const detectedPreset=findPreset();
    presetSelect.value=settings.colorPreset&&settings.colorPreset!=='Custom'&&colorPresets[settings.colorPreset]?settings.colorPreset:detectedPreset;
    function updatePreview(){
      const roles=Object.fromEntries([...dialog.querySelectorAll('[data-role]')].map(input=>[input.dataset.role,input.value]));
      for(const [name,cssName] of Object.entries({accent:'accent',surface:'surface',text:'text',headerBackground:'header',headerText:'header-text',grid:'grid',positive:'positive',negative:'negative'}))dialog.style.setProperty(`--qreports-${cssName}`,roles[name]);
      const surface=parseInt(roles.surface.slice(1,3),16)*.2126+parseInt(roles.surface.slice(3,5),16)*.7152+parseInt(roles.surface.slice(5,7),16)*.0722;
      dialog.style.setProperty('--qreports-color-scheme',surface<128?'dark':'light');
      const swatches=(colors,names)=>colors.map((color,index)=>{const cell=document.createElement('span');cell.className='settings-preview-swatch';const block=document.createElement('span');block.style.background=color;const caption=document.createElement('small');caption.textContent=names?.[index]?.replace(/([A-Z])/g,' $1')||color;cell.append(block,caption);return cell;});
      const card=dialog.querySelector('.settings-preview-card');card.style.background=roles.surface;card.style.color=roles.text;card.style.borderColor=roles.grid;
      const heading=dialog.querySelector('.settings-preview-heading');heading.style.background=roles.headerBackground;heading.style.color=roles.headerText;heading.style.borderColor=roles.grid;
      for(const name of ['accent','positive','negative'])dialog.querySelector('.settings-preview-'+name).style.color=roles[name];
      dialog.querySelector('.settings-chart-preview').replaceChildren(...swatches(chartColors()));
      iconPreviewImage.src=window.QvitrBrand?.resolve({themeIconMode:iconMode.value,colorPreset:presetSelect.value,themeRoles:roles})||'assets/qv-canvas.png';
    }
    presetSelect.addEventListener('change',()=>{const preset=colorPresets[presetSelect.value];if(!preset)return;dialog.querySelectorAll('[data-role]').forEach(input=>input.value=preset.roles[input.dataset.role]);dialog.querySelector('[name=defaultChartTheme]').value=preset.chartTheme;presetPalette=paletteDefaults[preset.chartTheme];restoredColors=false;updatePreview();});
    dialog.querySelector('.settings-colors').addEventListener('input',()=>{presetSelect.value='Custom';updatePreview();});
    dialog.querySelector('[name=defaultChartTheme]').addEventListener('change',()=>{restoredColors=false;presetPalette=null;presetSelect.value='Custom';updatePreview();});
    iconMode.addEventListener('change',updatePreview);
    dialog.querySelector('.settings-restore-colors').onclick=()=>{dialog.querySelectorAll('[data-role]').forEach(input=>input.value=roleDefaults[input.dataset.role]);dialog.querySelector('[name=defaultChartTheme]').value='Default';presetSelect.value='Light';presetPalette=paletteDefaults.Default;restoredColors=true;updatePreview();};
    updatePreview();
    dialog.querySelector('.settings-save').onclick=()=>{const form=dialog.querySelector('form');if(!form.reportValidity())return;const values=new FormData(form),next={...settings,zoom:Number(values.get('zoom')),records:Number(values.get('records')),queryShowTabs:form.elements.queryShowTabs.checked,miniSqlMaxSourceRows:Number(values.get('miniSqlMaxSourceRows')),miniSqlMaxIntermediateRows:Number(values.get('miniSqlMaxIntermediateRows')),miniSqlMaxResultRows:Number(values.get('miniSqlMaxResultRows')),miniSqlTimeoutSeconds:Number(values.get('miniSqlTimeoutSeconds')),defaultChartTheme:values.get('defaultChartTheme'),colorPreset:presetSelect.value,themeIconMode:iconMode.value,experienceMode:values.get('experienceMode')||'standard',defaultSavePath:values.get('defaultSavePath').trim(),themeRoles:Object.fromEntries([...dialog.querySelectorAll('[data-role]')].map(input=>[input.dataset.role,input.value]))};next.defaultCanvasSizeMode=form.elements.defaultCanvasSizeMode.value;next.defaultCanvasPreset=form.elements.defaultCanvasPreset.value;next.defaultCanvasWidth=Number(form.elements.defaultCanvasWidth.value);next.defaultCanvasHeight=Number(form.elements.defaultCanvasHeight.value);next.showHiddenPagesWhileEditing=form.elements.showHiddenPagesWhileEditing.checked;next.confirmDeleteTiles=form.elements.confirmDeleteTiles.checked;next.compressPastedImages=form.elements.compressPastedImages.checked;next.pastedImageResolution=form.elements.pastedImageResolution.value;next.pastedImageFormat=form.elements.pastedImageFormat.value;next.pastedImageQuality=Number(values.get('pastedImageQuality'));next.linkedImageCompression=values.get('linkedImageCompression');next.copilotFeatureAuditEnabled=form.elements.copilotFeatureAuditEnabled.checked;next.defaultChartColors=[...chartColors()];if(host){host.postMessage({type:'saveSharedSettings',settings:next});dialog.querySelector('.settings-save').disabled=true;}else {localStorage.setItem('qreports-shared-settings',JSON.stringify(next));apply(next);d