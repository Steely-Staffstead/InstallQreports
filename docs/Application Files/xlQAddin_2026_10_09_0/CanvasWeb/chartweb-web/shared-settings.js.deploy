    dialog.querySelector('.settings-save').addEventListener('click',()=>{settings.openMostRecentFileOnStartup=dialog.querySelector('[name=openMostRecentFileOnStartup]').checked;settings.aiCliProvider=dialog.querySelector('[name=aiCliProvider]').value;},{capture:true});
    toggleCanvasSizeFields(dialog);
    dialog.addEventListener('close',()=>{const standalone=document.body.hasAttribute('data-settings-host');dialog.remove();if(standalone&&host)host.postMessage({type:'closeWindow'});});document.body.append(dialog);dialog.showModal();
  }
  host?.addEventListener('message',event=>{if(event.data.type==='sharedSettings'){apply(event.data.settings);if(event.data.saved)document.querySelector('#sharedSettingsDialog')?.close();}if(['hostError','error'].includes(event.data.type)){const dialog=document.querySelector('#sharedSettingsDialog');if(dialog){dialog.querySelector('.settings-error').textContent=event.data.message;dialog.querySelector('.settings-save').disabled=false;}}});
  document.addEventListener('DOMContentLoaded',()=>{loadExperienceModes().then(()=>{applyExperienceMode();observeExperience();});});
  document.addEventListener('DOMContentLoaded',()=>{const style=document.createElement('style');style.textContent='html[data-qreports-theme] body{color:var(--qreports-text)}html[data-qreports-theme] body>header,html[data-qreports-theme] .toolbar{background:var(--qreports-header);color:var(--qreports-header-text)}html[data-qreports-theme] aside{background:var(--qreports-surface)}html[data-qreports-theme] button.primary{background:var(--qreports-accent)}body[data-settings-host]{box-sizing:border-box;margin:0;min-height:100vh;background:var(--qreports-surface);color:var(--qreports-text);font:15px/1.4 "Segoe UI",sans-serif}#sharedSettingsDialog{box-sizing:border-box;width:min(744px,92vw);min-width:min(480px,92vw);max-width:96vw;max-height:92vh;resize:both;overflow:auto;border:1px solid var(--qreports-grid);border-radius:14px;padding:24px;color:var(--qreports-text);background:var(--qreports-surface);color-scheme:var(--qreports-color-scheme,light);font:15px/1.4 "Segoe UI",sans-serif}body[data-settings-host] #sharedSettingsDialog{inset:0;width:100%;height:100%;min-width:0;max-width:none;max-height:none;margin:0;border:0;border-radius:0;resize:none;padding:clamp(20px,3vw,42px)}#sharedSettingsDialog::backdrop{background:color-mix(in srgb,var(--qreports-header) 48%,transparent)}body[data-settings-host] #sharedSettingsDialog::backdrop{background:var(--qreports-surface)}#sharedSettingsDialog header,#sharedSettingsDialog footer{display:flex;justify-content:space-between;align-items:center;gap:12px;background:transparent;color:inherit;padding:0;height:auto}#sharedSettingsDialog h2{margin:0;font-size:26px;line-height:1.2;color:var(--qreports-text)}#sharedSettingsDialog button{box-sizing:border-box;min-height:36px;padding:8px 16px;border:1px solid var(--qreports-grid);border-radius:7px;background:var(--qreports-surface);color:var(--qreports-text);font:inherit;line-height:1.2;cursor:pointer}#sharedSettingsDialog button:hover{border-color:var(--qreports-accent);background:color-mix(in srgb,var(--qreports-accent) 10%,var(--qreports-surface))}#sharedSettingsDialog button:focus-visible{outline:2px solid var(--qreports-accent);outline-offset:2px}#sharedSettingsDialog button:disabled{cursor:wait;opacity:.65}#sharedSettingsDialog .settings-group{margin:20px 0;padding:16px 18px;background:color-mix(in srgb,var(--qreports-surface) 84%,var(--qreports-header));border:1px solid var(--qreports-grid);border-radius:10px;color:var(--qreports-text)}#sharedSettingsDialog .settings-group>summary{font-size:15px;font-weight:700;cursor:pointer;padding:2px 0;color:var(--qreports-text)}#sharedSettingsDialog .settings-group[open]>summary{margin-bottom:14px}#sharedSettingsDialog label{display:block;margin:10px 0;font-size:14px;color:var(--qreports-text)}#sharedSettingsDialog small{display:block;font-size:12px;line-height:1.45;color:color-mix(in srgb,var(--qreports-text) 76%,var(--qreports-surface))}#sharedSettingsDialog input,#sharedSettingsDialog select{box-sizing:border-box;display:block;width:100%;padding:9px 10px;border:1px solid var(--qreports-grid);border-radius:7px;background:var(--qreports-surface);color:var(--qreports-text);font:inherit}#sharedSettingsDialog .settings-colors{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px 10px}#sharedSettingsDialog .settings-colors label{min-width:0;margin:4px 0;font-size:12px}#sharedSettingsDialog input[type=color]{height:38px;padding:3px;cursor:pointer}#sharedSettingsDialog .settings-role-swatches,#sharedSettingsDialog .settings-chart-preview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:12px 0}#sharedSettingsDialog .settings-preview-swatch{display:flex;flex-direction:column;gap:4px;text-align:center;font-size:11px;overflow-wrap:anywhere}#sharedSettingsDialog .settings-preview-swatch>span{height:40px;border:1px solid var(--qreports-grid);border-radius:5px}#sharedSettingsDialog .settings-preview-card{border:1px solid var(--qreports-grid);border-radius:8px;overflow:hidden;margin:1