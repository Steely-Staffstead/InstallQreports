})();

// Shared replacements for browser message boxes. Calls resolve only after dismissal.
(() => {
  let queue=Promise.resolve();
  function show(kind,message,initialValue='',options={}) {
    const run=()=>new Promise(resolve=>{
      if(!document.getElementById('qreportsMessageStyles')){
        const style=document.createElement('style');style.id='qreportsMessageStyles';
        style.textContent=`
          #qreportsMessageDialog { box-sizing:border-box; width:min(520px,92vw); max-height:85vh; overflow:auto; padding:24px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:12px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); color-scheme:var(--qreports-color-scheme,light); box-shadow:0 16px 60px #0006; font:14px/1.5 'Segoe UI',sans-serif; }
          #qreportsMessageDialog::backdrop { background:#0007; }
          #qreportsMessageDialog h2 { margin:0 0 12px; color:inherit; font-size:22px; }
          #qreportsMessageDialog p { margin:0 0 20px; color:inherit; white-space:pre-wrap; overflow-wrap:anywhere; }
          #qreportsMessageDialog input { box-sizing:border-box; width:100%; margin:0 0 20px; padding:9px 10px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); border:1px solid var(--qreports-grid,#cdd5df); border-radius:6px; font:inherit; }
          #qreportsMessageDialog .message-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px; }
          #qreportsMessageDialog button { padding:8px 18px; border:1px solid var(--qreports-grid,#cdd5df); border-radius:7px; background:var(--qreports-surface,#fff); color:var(--qreports-text,#182230); font:inherit; cursor:pointer; }
          #qreportsMessageDialog button[data-accept] { background:var(--qreports-accent,#4f6ee8); color:var(--qreports-on-accent,#fff); border-color:var(--qreports-accent,#4f6ee8); }
          #qreportsMessageDialog :is(button,input):focus-visible { outline:2px solid var(--qreports-accent,#4f6ee8); outline-offset:2px; }
        `;document.head.append(style);
      }
      const previousFocus=document.activeElement,dialog=document.createElement('dialog');
      dialog.id='qreportsMessageDialog';dialog.setAttribute('aria-labelledby','qreportsMessageTitle');dialog.setAttribute('aria-describedby','qreportsMessageText');
      const form=document.createElement('form'),title=document.createElement('h2'),text=document.createElement('p'),actions=document.createElement('div');
      title.id='qreportsMessageTitle';title.textContent=options.title||(kind==='confirm'?'Confirm action':kind==='prompt'?'Enter value':'Message');
      text.id='qreportsMessageText';text.textContent=String(message??'');actions.className='message-actions';
      form.append(title,text);
      let input=null;
      if(kind==='prompt'){input=document.createElement('input');input.type='text';input.value=String(initialValue??'');input.setAttribute('aria-labelledby',text.id);form.append(input);}
      const cancel=document.createElement('button');cancel.type='button';cancel.textContent=options.cancelText||'Cancel';cancel.onclick=()=>dialog.close('cancel');
      if(kind!=='alert')actions.append(cancel);
      const accept=document.createElement('button');accept.type='submit';accept.dataset.accept='';accept.textContent=options.acceptText||(kind==='prompt'?'Save':'OK');actions.append(accept);
      form.append(actions);dialog.append(form);
      dialog.addEventListener('keydown',event=>event.stopPropagation());
      form.onsubmit=event=>{event.preventDefault();dialog.close('accept');};
      dialog.addEventListener('cancel',event=>{event.preventDefault();dialog.close('cancel');});
      dialog.addEventListener('close',()=>{const accepted=dialog.returnValue==='accept',result=kind==='prompt'?(accepted?input.value:null):kind==='confirm'?accepted:undefined;dialog.remove();if(previousFocus?.isConnected)previousFocus.focus();resolve(result);},{once:true});
      document.body.append(dialog);dialog.showModal();
      (input||(kind==='confirm'?cancel:accept)).focus();input?.select();
    });
    const result=queue.then(run);queue=result.catch(()=>{});return result;
  }
  // A modal choice must not trigger editor shortcuts behind the dialog.
  window.addEventListener('keydown',event=>{
    if(!document.getElementById('qreportsMessageDialog')?.open)return;
    if(event.key==='F5'||((event.ctrlKey||event.metaKey)&&['s','o'].includes(event.key.toLowerCase()))){event.preventDefault();event.stopImmediatePropagation();}
  },true);
  window.QReportsDialogs={
    confirm:(message,options)=>show('confirm',message,'',options),
    prompt:(message,value,options)=>show('prompt',message,value,options),
    alert:(message,options)=>show('alert',message,'',options)
  };

  const qvitrIconFiles={
    default:'assets/qv-canvas.png',
    frost:'assets/qv-canvas-frost.png',
    midnight:'assets/qv-canvas-midnight.png',
    forest:'assets/qv-canvas-forest.png',
    ocean:'assets/qv-canvas-ocean.png',
    plum:'assets/qv-canvas-plum.png',
    fire:'assets/qv-canvas-fire.png'
  };
  const qvitrPresetIcons={Light:'default',Dark:'default',Midnight:'midnight',ArcticBlue:'frost',Graphite:'forest',VioletNight:'midnight',Windows:'default',Ocean:'ocean',Forest:'forest',Plum:'plum',Sandstone:'forest',Alpine:'ocean',Slate:'default',Coral:'plum',Indigo:'midnight',Citrus:'forest'};
  function qvitrIconFamilyFromAccent(value){
    const hex=String(value||'').match(/^#([0-9a-f]{6})$/i)?.[1];if(!hex)return'default';
    const [r,g,b]=[0,2,4].map(index=>parseInt(hex.slice(index,index+2),16)/255),max=Math.max(r,g,b),min=Math.min(r,g,b),delta=max-min,saturation=max?delta/max:0;
    if(saturation<.18)return max>.78?'frost':'default';
    let hue=0;if(delta){hue=max===r?60*((g-b)/delta%6):max===g?60*((b-r)/delta+2):60*((r-g)/delta+4);if(hue<0)hue+=360;}
    if(hue<35||hue>=345)return'fire';if(hue<75)return'forest';if(hue<175)return'ocean';if(hue<225)return'ocean';if(hue<285)return'midnight';return'plum';
  }
  function resolveQvitrIcon(value=window.QReportsSettings?.get?.()||{}){
    if(value.themeIconMode==='default')return qvitrIconFiles.default;
    const family=qvitrPresetIcons[value.colorPreset]||qvitrIconFamilyFromAccent(value.themeRoles?.accent);
    return qvitrIconFiles[family]||qvitrIconFiles.default;
  }
  function applyQvitrIcon(value){
    const source=resolveQvitrIcon(value);
    document.documentElement.style.setProperty('--qvitr-icon-url',`url("${source}")`);
    document.querySelectorAll('.qv-brand-icon').forEach(icon=>{if(icon.getAttribute('src')!==source)icon.src=source;});
    let favicon=document.querySelector('link[rel~="icon"]');if(!favicon){favicon=document.createElement('link');favicon.rel='icon';document.head.append(favicon);}favicon.type=source.endsWith('.jpg')?'image/jpeg':'image/png';favicon.href=source;
  }
  window.QvitrBrand={resolve:resolveQvitrIcon,apply:applyQvitrIcon,files:{...qvitrIconFiles}};
  window.addEventListener('qreports-settings-changed',event=>applyQvitrIcon(event.detail));

  function applyQvitrBranding(){
    if(typeof document.querySelector!=='function')return;
    const page=globalThis.location?.pathname?.split('/').pop().toLowerCase()||'index.html';
    const brands={
      'index.html':{title:'Qanvas by Qvitr',primary:'Qanvas',secondary:'by Qvitr'},
      'query-workspace.html':{title:'Query Workspace',primary:'Query Workspace'},
      'measure-workspace.html':{title:'Measures',primary:'Measures'},
      'api-workspace.html':{title:'API Workspace',primary:'API Workspace'},
      'powerpoint-import.html':{title:'Get from Qanvas',primary:'Get from Qanvas'},
      'log-workspace.html':{title:'QReports log'},
      'connections.html':{title:'QReports sources'}
    };
    const brand=brands[page];
    if(!brand)return;
    document.title=brand.title;
    const heading=document.querySelector('.brand strong,.workspace-header h1');
    if(heading&&brand.primary)heading.textContent=brand.primary;
    const secondary=document.querySelector('.brand small');
    if(secondary&&brand.secondary)secondary.textContent=brand.secondary;
    const oldMark=document.querySelector('.brand > span,.workspace-header > .brand-mark');
    if(oldMark){const source=resolveQvitrIcon(window.QReportsSettings?.get?.()),icon=document.createElement('img');icon.className='qv-brand-icon';icon.src=source;icon.alt='';if(oldMark.dataset.experienceIcon){oldMark.dataset.experienceOriginalIcon=`<img class="qv-brand-icon" src="${source}" alt="">`;oldMark.replaceChildren(icon);window.QReportsSettings?.applyExperience?.(oldMark);}else oldMark.replaceWith(icon);}
    if(!document.querySelector('link[data-qv-brand]')){const style=document.createElement('link');style.rel='stylesheet';style.href='qv-brand.css?v=20261005-runes-header';style.dataset.qvBrand='';document.head.append(style);}
    applyQvitrIcon(window.QReportsSettings?.get?.());
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',applyQvitrBranding,{once:true});else applyQvitrBranding();
})();
