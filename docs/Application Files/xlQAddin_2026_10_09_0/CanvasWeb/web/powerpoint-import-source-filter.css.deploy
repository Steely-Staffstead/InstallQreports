.pane-heading {
  align-items: flex-start;
}

.source-heading-copy {
  min-width: 0;
}

.source-view-toggle {
  display: flex;
  gap: 4px;
  margin-top: 10px;
  padding: 3px;
  border: 1px solid var(--qreports-grid, #cbd5e2);
  border-radius: 8px;
  background: color-mix(in srgb, var(--qreports-header, #e8eef7) 62%, var(--qreports-surface, #fff));
}

.source-view-toggle button {
  flex: 1;
  padding: 5px 8px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  font-size: 12px;
  white-space: nowrap;
}

.source-view-toggle button[aria-selected="true"] {
  background: var(--qreports-accent, #4f6ee8);
  color: var(--qreports-on-accent, #fff);
}

.source-empty {
  padding: 18px 12px;
  text-align: center;
  color: color-mix(in srgb, var(--qreports-text, #182230) 68%, var(--qreports-surface, #fff));
}

button:disabled {
  opacity: 1;
  cursor: not-allowed;
  background: color-mix(in srgb, var(--qreports-header, #e8eef7) 72%, var(--qreports-surface, #fff));
  color: color-mix(in srgb, var(--qreports-text, #182230) 72%, var(--qreports-surface, #fff));
  border-color: color-mix(in srgb, var(--qreports-grid, #cbd5e2) 82%, var(--qreports-surface, #fff));
}

button.primary:disabled {
  background: color-mix(in srgb, var(--qreports-accent, #4f6ee8) 34%, var(--qreports-surface, #fff));
  color: var(--qreports-text, #182230);
  border-color: color-mix(in srgb, var(--qreports-accent, #4f6ee8) 58%, var(--qreports-grid, #cbd5e2));
}
