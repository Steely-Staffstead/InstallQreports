(()=>{
const host=window.chrome?.webview,$=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
let session={sources:[]},selection=null,filters=[],sourceView='current',embedPreference=true;
const selectedImports=new Map();
const sourceByRef=ref=>session.sources.find(source=>source.reference===ref),pages=source=>(source?.document?.pages||[]).filter(page=>page.hidden!==true&&page.Hidden!==true),tiles=page=>[...(page?.tiles||[]),...(page?.graphics||[])],sourceRows=(source,id)=>source?.document?.sources?.find(item=>(item.id||'main')===(id||'main'))?.query?.data||{};
const standardVisualKinds=new Set(['chart','table','matrix','reportgrid','report-grid','report_grid','picture','image','tile','card']);
const visibleTiles=(page,includeText)=>tiles(page).map((tile,index)=>({tile,index})).filter(item=>includeText||standardVisualKinds.has(String(item.tile.kind||'').toLowerCase()));
const itemKey=item=>`${item.source}|${item.page?.id||''}|${item.kind==='tile'?(item.tile?.id||''):''}`;
function tileType(kind){const value=String(kind||'tile').replace(/([a-z0-9])([A-Z])/g,'$1 $2').replace(/[-_]+/g,' ').trim();return value.toUpperCase()||'TILE'}
function cloneFilters(items){return(items||[]).map(item=>({...item}))}
// Canvas page/tile filters are part of the authored report. They are applied by
// the renderer, but must never become editable Office-link filters. New Office
// filters start empty and are appended as an additional, restrictive layer.
function selectionFilters(){return[]}
function serializedFilters(items){return(items||[]).filter(item=>item.field).map(item=>({scope:item.scope.toLowerCase(),sourceId:item.sourceId||'main',mode:'Advanced',column:item.field,operator:item.operator||'equals',value:item.value||'',enabled:true}))}
function defaultCompression(){return window.QReportsSettings?.get?.()?.linkedImageCompression||'balanced'}
function selectedPayload(next,itemFilters,compression){return{source:next.source,pageId:next.page.id,pageName:next.page.name||'',tileId:next.tile?.id||'',tileName:next.tile?.title||'',tileType:next.kind==='tile'?tileType(next.tile?.kind):'PAGE',filters:serializedFilters(itemFilters),compression:compression||next.compression||defaultCompression()}}
function saveActiveFilters(){if(!selection)return;selection.compression=$('imageCompression').value;const queued=selectedImports.get(itemKey(selection));if(queued){queued.filters=cloneFilters(filters);queued.compression=selection.compression;queued.pendingDetails=false}}
function updateImageEstimate(preview){const profile=$('imageCompression').value,match=String(preview||'').match(/^data:[^;]+;base64,(.*)$/),bytes=match?Math.floor(match[1].length*0.75):0,ratio={original:1,high:.6,balanced:.38,small:.24}[profile]||.38;$('imageEstimate').textContent=bytes?`Approx. ${formatBytes(Math.max(4096,Math.round(bytes*ratio)))}`:'Size calculated on import'}
function formatBytes(bytes){return bytes<1048576?`${Math.max(1,Math.round(bytes/1024))} KB`:`${(bytes/1048576).toFixed(1)} MB`}
function updateImportButton(){const count=selectedImports.size,button=$('import');button.disabled=count===0&&!selection;button.textContent=count?`Import ${count} item${count===1?'':'s'}`:'Import selection'}
function setPreviewState(message,loading=false){const empty=$('previewEmpty');$('previewMessage').textContent=message;empty.classList.toggle('loading',loading);empty.setAttribute('aria-busy',String(loading))}
function sourceChoices(){const source=sourceByRef(selection?.source);let choices=(source?.document?.sources||[]).map(item=>({id:item.id||'main',name:item.name||item.id||'main'}));if(!choices.some(item=>item.id==='main'))choices.unshift({id:'main',name:'Main source'});if(selection?.kind==='tile'){const id=selection.tile.sourceId||'main';choices=choices.filter(item=>item.id===id);if(!choices.length)choices=[{id,name:id}]}return choices}
function fields(id){return[...new Set((sourceRows(sourceByRef(selection?.source),id).columns||[]).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b)))}
function normalizeFilter(item,scope){return{scope,sourceId:item.sourceId||'main',field:item.column||'',operator:item.operator||'equals',value:item.value??(item.basicValues?.length===1?item.basicValues[0]:'')}}
function selectNode(next){
  saveActiveFilters();selection=next;next.itemKey=itemKey(next);
  document.querySelectorAll('.tree-item').forEach(node=>node.classList.toggle('active',node.dataset.itemKey===next.itemKey));
  const source=sourceByRef(next.source),page=next.page,previewKey=next.kind==='tile'?`tile:${next.tile.id}`:`page:${page.id}`,preview=source?.previews?.[previewKey]||source?.previews?.[page.id];
  const needsPageDetails=next.kind==='page'&&(!Array.isArray(page.tiles)||!Array.isArray(page.graphics));
  $('selectionTitle').textContent=(next.kind==='tile'?'Tile: ':'Page: ')+(next.kind==='tile'?(next.tile.title||next.tile.kind):page.name);
  $('selectionType').textContent=next.kind==='tile'?tileType(next.tile.kind):'PAGE';$('selectionPath').textContent=source?.name||next.source;
  $('preview').style.display=preview?'block':'none';$('preview').src=preview||'';$('previewEmpty').style.display=preview?'none':'block';setPreviewState(preview?'':'Loading preview…',!preview);
  if(!preview||needsPageDetails)requestPreview(source,page,next.kind==='tile'?next.tile:null);
  const queued=selectedImports.get(next.itemKey);filters=cloneFilters(queued?.filters||selectionFilters(next));$('imageCompression').disabled=false;$('imageCompression').value=queued?.compression||next.compression||defaultCompression();updateImageEstimate(preview);
  $('embed').disabled=!!source?.embedded;$('embed').checked=source?.embedded?true:embedPreference;renderFilters();updateImportButton();$('status').textContent=preview?'Ready to import':'Loading preview…';
}
function toggleImport(next){saveActiveFilters();const key=itemKey(next);if(selectedImports.has(key))selectedImports.delete(key);else selectedImports.set(key,{selection:next,filters:selection&&itemKey(selection)===key?cloneFilters(filters):selectionFilters(next),compression:selection&&itemKey(selection)===key?$('imageCompression').value:(next.compression||defaultCompression()),pendingDetails:next.kind==='page'&&(!Array.isArray(next.page?.tiles)||!Array.isArray(next.page?.graphics))});renderTree();selectNode(next);updateImportButton()}
function visibleSourceEntries(){return session.sources.map((source,index)=>({source,index})).filter(({source})=>(source.scope==='recent'?'recent':'current')===sourceView)}
function clearSelection(){saveActiveFilters();selection=null;filters=[];$('preview').style.display='none';$('preview').src='';$('previewEmpty').style.display='block';setPreviewState('Select a page or tile from the navigation.');$('selectionTitle').textContent='Choose a page or tile';$('selectionType').textContent='';$('selectionPath').textContent='Select an item on the left to see its preview.';$('imageCompression').disabled=true;$('imageEstimate').textContent='';updateImportButton();renderFilters()}
function setSourceView(view){sourceView=view==='recent'?'recent':'current';$('currentSources').setAttribute('aria-selected',String(sourceView==='current'));$('recentSources').setAttribute('aria-selected',String(sourceView==='recent'));if(selection&&((sourceByRef(selection.source)?.scope==='recent')!==(sourceView==='recent')))clearSelection();renderTree();const count=visibleSourceEntries().length;$('status').textContent=count?`${count} Qanvas file${count===1?'':'s'} ready`:sourceView==='recent'?'No recent Qanvas files were found':'No linked or embedded Qanvas files were found'}
function selectionToggle(next){const checked=selectedImports.has(itemKey(next));return`<span class="queue-box" data-select-toggle role="checkbox" aria-checked="${checked}" title="${checked?'Remove from import':'Add to import'}">${checked?'✓':''}</span>`}
function renderTree(){
  const includeText=$('includeText').checked,entries=visibleSourceEntries();
  $('sourceTree').innerHTML=entries.length?entries.map(({source,index:sourceIndex})=>`<section class="source-node ${source.expanded?'':'collapsed'}" data-source-index="${sourceIndex}"><button class="source-root" data-source-root="${sourceIndex}"><span class="chevron">▾</span><span>${esc(source.name)}</span><small>${source.embedded?(session.host==='excel'?'in workbook':'in presentation'):'local file'}</small></button><div class="source-children">${pages(source).map((page,pageIndex)=>{
    const preview=source.previews?.[`page:${page.id}`]||source.previews?.[page.id]||'',expanded=!!source.expandedPages?.[page.id],pageSelection={source:source.reference,page,kind:'page',tile:null},pageItemKey=itemKey(pageSelection),pageQueued=selectedImports.has(pageItemKey);
    const pageButton=`<button class="tree-item page ${pageQueued?'queued':''}" data-item-key="${esc(pageItemKey)}" data-source="${sourceIndex}" data-page="${pageIndex}"><span class="chevron">${expanded?'▾':'▸'}</span>${selectionToggle(pageSelection)}<span class="page-name">${esc(page.name||'Page')}</span>${preview?`<img src="${preview}" alt="">`:''}</button>`;
    const tileButtons=visibleTiles(page,includeText).map(({tile,index})=>{const tileSelection={source:source.reference,page,kind:'tile',tile},key=itemKey(tileSelection),queued=selectedImports.has(key);return`<button class="tree-item tile ${queued?'queued':''}" data-item-key="${esc(key)}" data-source="${sourceIndex}" data-page="${pageIndex}" data-tile="${index}">${selectionToggle(tileSelection)}<span class="tile-copy"><span class="tile-name">${esc(tile.title||tile.kind||'Tile')}</span><small class="tile-type">${esc(tileType(tile.kind))}</small></span></button>`}).join('');
    const loading=expanded&&(!Array.isArray(page.tiles)||!Array.isArray(page.graphics))?'<div class="source-loading page-details-loading">Loading page details…</div>':'';
    return`<div class="page-node ${expanded?'':'collapsed'}">${pageButton}<div class="page-children">${loading}${tileButtons}</div></div>`}).join('')}</div></section>`).join(''):`<div class="source-empty">${sourceView==='recent'?'No recent Qanvas files.':'No linked or embedded Qanvas files.'}</div>`;
  document.querySelectorAll('[data-source-root]').forEach(button=>{button.onclick=()=>{const source=session.sources[+button.dataset.sourceRoot];if(!source.loaded){requestSource(source);return}source.expanded=!source.expanded;renderTree()};button.oncontextmenu=event=>showSourceMenu(event,+button.dataset.sourceRoot)});
  document.querySelectorAll('.tree-item.page').forEach(button=>button.onclick=event=>{const source=session.sources[+button.dataset.source],page=pages(source)[+button.dataset.page],next={source:source.reference,page,kind:'page',tile:null};if(event.target.closest('[data-select-toggle]')){event.stopPropagation();toggleImport(next);return}source.expandedPages||={};source.expandedPages[page.id]=!source.expandedPages[page.id];renderTree();selectNode(next)});
  document.querySelectorAll('.tree-item.tile').forEach(button=>button.onclick=event=>{const source=session.sources[+button.dataset.source],page=pages(source)[+button.dataset.page],tile=tiles(page)[+button.dataset.tile],next={source:source.reference,page,kind:'tile',tile};if(event.target.closest('[data-select-toggle]')){event.stopPropagation();toggleImport(next);return}selectNode(next)});
  if(selection)document.querySelectorAll('.tree-item').forEach(node=>node.classList.toggle('active',node.dataset.itemKey===itemKey(selection)));
}
function renderFilters(){
  const sources=sourceChoices();$('filterRows').innerHTML=filters.map((filter,index)=>{const availableFields=fields(filter.sourceId);if(filter.field&&!availableFields.includes(filter.field))availableFields.unshift(filter.field);return`<div class="filter-row" data-filter="${index}"><select data-part="scope"><option>Page</option><option>Tile</option></select><select data-part="sourceId">${sources.map(item=>`<option value="${esc(item.id)}">${esc(item.id)}</option>`).join('')}</select><select data-part="field"><option value=""></option>${availableFields.map(field=>`<option>${esc(field)}</option>`).join('')}</select><select data-part="operator">${['equals','notequals','contains','notcontains','>','>=','<','<='].map(op=>`<option>${esc(op)}</option>`).join('')}</select><div style="display:grid;grid-template-columns:1fr 34px;gap:4px"><input data-part="value" value="${esc(filter.value)}"><button type="button" data-lookup title="Look up values">⋯</button></div><button type="button" class="remove-filter" data-remove title="Remove filter">×</button></div>`}).join('');
  document.querySelectorAll('[data-filter]').forEach(row=>{const index=+row.dataset.filter,filter=filters[index];for(const part of ['scope','sourceId','field','operator'])row.querySelector(`[data-part=${part}]`).value=filter[part];row.querySelectorAll('[data-part]').forEach(control=>control.onchange=()=>{filter[control.dataset.part]=control.value;if(control.dataset.part==='sourceId'){filter.field='';renderFilters()}saveActiveFilters()});row.querySelector('[data-part=value]').oninput=event=>{filter.value=event.target.value;saveActiveFilters()};row.querySelector('[data-remove]').onclick=()=>{filters.splice(index,1);saveActiveFilters();renderFilters()};row.querySelector('[data-lookup]').onclick=event=>showValueLookup(event,index)})
}
function showValueLookup(event,index){const filter=filters[index],data=sourceRows(sourceByRef(selection?.source),filter.sourceId),columns=data.columns||[],columnIndex=columns.findIndex(name=>String(name).toLowerCase()===String(filter.field).toLowerCase()),limit=Math.max(10,+$('lookupLimit').value||100),values=columnIndex<0?[]:[...new Set((data.rows||[]).map(row=>Array.isArray(row)?row[columnIndex]:null).filter(value=>value!==null&&value!==undefined&&String(value).trim()))].sort((a,b)=>String(a).localeCompare(String(b))).slice(0,limit),menu=$('lookupMenu');menu.innerHTML=values.length?values.map(value=>`<button type="button" data-value="${esc(value)}">${esc(value)}</button>`).join(''):'<div class="lookup-empty">No cached values available</div>';positionMenu(menu,event.currentTarget);menu.querySelectorAll('[data-value]').forEach(button=>button.onclick=()=>{filter.value=button.dataset.value;menu.hidden=true;saveActiveFilters();renderFilters()})}
function positionMenu(menu,target){const rect=target.getBoundingClientRect();menu.hidden=false;menu.style.left=Math.min(rect.left,innerWidth-menu.offsetWidth-12)+'px';menu.style.top=Math.min(rect.bottom+4,innerHeight-menu.offsetHeight-12)+'px'}
function showSourceMenu(event,index){event.preventDefault();const source=session.sources[index],menu=$('sourceMenu');menu.innerHTML='<button data-show>Show details</button><button data-hide>Hide details</button><button data-refresh>Refresh this CanvasWeb file</button>'+(source.localPath?'<hr><button data-explore>Show in File Explorer</button>':'');menu.hidden=false;menu.style.left=Math.min(event.clientX,innerWidth-260)+'px';menu.style.top=Math.min(event.clientY,innerHeight-190)+'px';menu.querySelector('[data-show]').onclick=()=>{source.expanded=true;if(!source.loaded)requestSource(source);else renderTree();menu.hidden=true};menu.querySelector('[data-hide]').onclick=()=>{source.expanded=false;renderTree();menu.hidden=true};menu.querySelector('[data-refresh]').onclick=()=>{requestSource(source,true);menu.hidden=true};menu.querySelector('[data-explore]')?.addEventListener('click',()=>{host?.postMessage({type:'powerPointImportExplore',path:source.localPath});menu.hidden=true})}
$('currentSources').onclick=()=>setSourceView('current');$('recentSources').onclick=()=>setSourceView('recent');$('includeText').onchange=()=>{if(!$('includeText').checked&&selection?.kind==='tile'&&!standardVisualKinds.has(String(selection.tile?.kind||'').toLowerCase()))clearSelection();renderTree()};$('embed').onchange=()=>embedPreference=$('embed').checked;$('imageCompression').onchange=()=>{if(selection){selection.compression=$('imageCompression').value;saveActiveFilters();const source=sourceByRef(selection.source),key=selection.kind==='tile'?`tile:${selection.tile.id}`:`page:${selection.page.id}`;updateImageEstimate(source?.previews?.[key]||source?.previews?.[selection.page.id])}};$('addFilter').onclick=()=>{if(!selection)return;const first=sourceChoices()[0]?.id||'main';filters.push({scope:selection.kind==='tile'?'Tile':'Page',sourceId:first,field:'',operator:'equals',value:''});saveActiveFilters();renderFilters()};$('cancel').onclick=()=>host?.postMessage({type:'powerPointImportCancel'});
$('import').onclick=()=>{if(!selection&&selectedImports.size===0)return;saveActiveFilters();const items=selectedImports.size?[...selectedImports.values()].map(entry=>selectedPayload(entry.selection,entry.filters,entry.compression)):[selectedPayload(selection,filters,$('imageCompression').value)],first=items[0];host?.postMessage({type:'powerPointImportComplete',result:{ok:true,...first,selections:items,embed:embedPreference,includeText:$('includeText').checked}})};
document.addEventListener('click',event=>{if(!event.target.closest('.lookup-menu,[data-lookup]'))$('lookupMenu').hidden=true;if(!event.target.closest('.source-menu,[data-source-root]'))$('sourceMenu').hidden=true});host?.addEventListener('message',event=>{if(event.data.type!=='powerPointImportLoad')return;session=event.data.session||{sources:[]};sourceView='current';setSourceView('current')});addEventListener('DOMContentLoaded',()=>host?.postMessage({type:'ready'}));
function requestSource(source,force=false){
  if(!source||source.loading||source.loaded&&!force)return;source.loading=true;source.expanded=true;
  if(force){source.loaded=false;delete source.document;delete source.previews;source.expandedPages={};source.previewLoading={};source.allPagePreviewsLoaded=false}
  const index=session.sources.indexOf(source),node=document.querySelector(`[data-source-index="${index}"]`);node?.classList.remove('collapsed');const children=node?.querySelector('.source-children');if(children)children.innerHTML='<div class="source-loading">Loading page names…</div>';$('status').textContent=`Loading ${source.name}…`;host?.postMessage({type:'powerPointImportLoadSource',reference:source.reference})
}
function requestPreview(source,page,tile){
  if(!source||!page)return;const key=tile?`tile:${tile.id}`:`page:${page.id}`,needsPageDetails=!tile&&(!Array.isArray(page.tiles)||!Array.isArray(page.graphics));source.previewLoading||={};if((source.previews?.[key]&&!needsPageDetails)||source.previewLoading[key])return;source.previewLoading[key]=true;host?.postMessage({type:'powerPointImportLoadSource',reference:source.reference,pageId:page.id,tileId:tile?.id||'',allPages:!tile&&!source.allPagePreviewsLoaded,includeText:$('includeText').checked})
}
host?.addEventListener('message',event=>{
  if(event.data.type==='powerPointImportLoad'){
    if(session.host==='excel'){$('hostInstruction').textContent='Choose pages or tiles, review them, adjust filters, and insert them into the current worksheet.';$('embedCaption').textContent='Embed definition in this workbook';$('currentSourceCaption').textContent='Workbook & linked'}else $('hostInstruction').textContent='Choose pages or tiles, review them, adjust filters, and import them into the current slide.';
    requestAnimationFrame(()=>document.querySelectorAll('.source-node').forEach(node=>node.classList.add('collapsed')));return
  }
  if(event.data.type!=='powerPointImportSourceLoaded')return;
  const source=sourceByRef(event.data.reference);if(!source)return;source.loading=false;const response=event.data.response,previewKey=event.data.pageId?(event.data.tileId?`tile:${event.data.tileId}`:`page:${event.data.pageId}`):'';if(previewKey&&source.previewLoading)delete source.previewLoading[previewKey];
  if(!event.data.ok||!response?.ok){source.error=response?.error||event.data.error||'Could not load this CanvasWeb file.';renderTree();$('status').textContent=source.error;if(previewKey&&selection?.source===source.reference){const selectedKey=selection.kind==='tile'?`tile:${selection.tile.id}`:`page:${selection.page.id}`;if(selectedKey===previewKey)setPreviewState(`Preview unavailable: ${source.error}`)}return}
  const returned=response.source||{};
  if(event.data.pageId){source.previews={...(source.previews||{}),...(returned.previews||{})};if(event.data.allPages)source.allPagePreviewsLoaded=true;if(returned.page){const documentIndex=(source.document.pages||[]).findIndex(page=>page.id===returned.page.id);if(documentIndex>=0)source.document.pages[documentIndex]=returned.page;if(selection?.source===source.reference&&selection.page?.id===returned.page.id)selection.page=returned.page;for(const entry of selectedImports.values())if(entry.selection.source===source.reference&&entry.selection.page?.id===returned.page.id){entry.selection.page=returned.page;if(entry.pendingDetails){entry.filters=selectionFilters(entry.selection);entry.pendingDetails=false;if(selection&&itemKey(selection)===itemKey(entry.selection))filters=cloneFilters(entry.filters)}}}renderTree();if(selection?.source===source.reference)selectNode(selection);return}
  Object.assign(source,returned,{loaded:true,loading:false,expanded:true});source.previews||={};source.expandedPages||={};renderTree();$('status').textContent=`${source.name}: ${pages(source).length} page${pages(source).length===1?'':'s'} ready`
});
function makeSplitter(splitter,onMove){splitter?.addEventListener('pointerdown',event=>{splitter.setPointerCapture(event.pointerId);splitter.classList.add('dragging')});splitter?.addEventListener('pointermove',event=>{if(splitter.hasPointerCapture(event.pointerId))onMove(event)});const finish=event=>{if(splitter?.hasPointerCapture(event.pointerId))splitter.releasePointerCapture(event.pointerId);splitter?.classList.remove('dragging')};splitter?.addEventListener('pointerup',finish);splitter?.addEventListener('pointercancel',finish)}
const content=document.querySelector('.content-pane');makeSplitter($('filterSplitter'),event=>{const bounds=content.getBoundingClientRect(),height=Math.max(170,Math.min(bounds.height-254,bounds.bottom-event.clientY));content.style.setProperty('--filter-height',`${height}px`)});const main=document.querySelector('main');makeSplitter($('sourceSplitter'),event=>{const bounds=main.getBoundingClientRect(),width=Math.max(270,Math.min(620,event.clientX-bounds.left));main.style.setProperty('--source-width',`${width}px`)});
})();
