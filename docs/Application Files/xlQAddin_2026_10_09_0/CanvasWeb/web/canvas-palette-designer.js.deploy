(() => {
  const host=window.chrome?.webview;
  const key='qanvas-personal-palettes';
  const valid=value=>/^#[0-9a-f]{6}$/i.test(value||'');
  const normalize=items=>(Array.isArray(items)?items:[]).map(item=>({name:String(item.name||'').trim(),colors:(item.colors||[]).map(value=>String(value).length===9?'#'+String(value).slice(3):value)})).filter(item=>item.name&&item.colors.length===8&&item.colors.every(valid));
  let active=null;
  function local(){try{return normalize(JSON.parse(localStorage.getItem(key)||'[]'));}catch{return [];}}
  function notify(items){window.dispatchEvent(new CustomEvent('canvas-personal-palettes',{detail:items}));const select=active?.dialog.querySelector('[name=defaultChartTheme]');if(select)for(const item of items)if(![...select.options].some(option=>option.value===item.name))select.add(new Option(item.name,item.name));}
  function install(dialog){
    const panel=document.createElement('details');panel.className='settings-palette-designer';
    panel.innerHTML='<summary>Personal palettes</summary><small>Edit eight colors, save them to your personal QReports settings, or apply them to this canvas. Applied canvas colors are saved in the report for everyone who opens it.</small><label>Palette<select data-personal-palette><option value="">New palette</option></select></label><label>Palette name<input data-palette-name type="text" maxlength="100" placeholder="My palette"></label><div class="settings-palette-slots"></div><div class="settings-palette-actions"><button type="button" data-palette-current>Use current canvas colors</button><button type="button" data-palette-save>Save to personal palettes</button><button type="button" data-palette-apply>Apply to canvas</button><button type="button" data-palette-delete>Delete personal palette</button><button type="button" data-palette-refresh>Refresh list</button></div><small data-palette-status role="status"></small>';
    dialog.querySelector('.settings-chart-preview').after(panel);
    active={dialog,panel,items:[]};
    const select=panel.querySelector('[data-personal-palette]'),name=panel.querySelector('[data-palette-name]'),status=panel.querySelector('[data-palette-status]'),slots=panel.querySelector('.settings-palette-slots');
    const current=()=>window.canvasCurrentPalette?.()||{name:'My palette',colors:window.QReportsSettings?.get()?.defaultChartColors||[]};
    const showColors=colors=>{slots.replaceChildren(...Array.from({length:8},(_,index)=>{const label=document.createElement('label');label.textContent=`Color ${index+1}`;const input=document.createElement('input');input.type='color';input.value=valid(colors?.[index])?colors[index]:'#4f6ee8';input.dataset.paletteSlot=String(index);label.append(input);return label;}));};
    const colors=()=>[...slots.querySelectorAll('[data-palette-slot]')].map(input=>input.value);
    const setItems=(items,message='')=>{active.items=normalize(items);const chosen=select.value;select.replaceChildren(new Option('New palette',''),...active.items.map(item=>new Option(item.name,item.name)));if(active.items.some(item=>item.name===chosen))select.value=chosen;status.textContent=message;notify(active.items);};
    const refresh=()=>{if(host){status.textContent='Loading personal palettes…';host.postMessage({type:'settingsPalettesList'});}else setItems(local());};
    const selected=()=>active.items.find(item=>item.name===select.value);
    select.onchange=()=>{const item=selected();name.value=item?.name.replace(/^(User|Company):\s*/,'')||'';showColors(item?.colors||current().colors);panel.querySelector('[data-palette-delete]').disabled=!item?.name.startsWith('User: ');};
    panel.querySelector('[data-palette-current]').onclick=()=>{const palette=current();showColors(palette.colors);name.value=palette.name==='Custom canvas palette'?'':palette.name.replace(/^(User|Company):\s*/,'');status.textContent='Current canvas colors loaded. Give them a name, then save or apply.';};
    panel.querySelector('[data-palette-save]').onclick=()=>{const paletteName=name.value.trim(),paletteColors=colors();if(!paletteName){status.textContent='Enter a palette name.';name.focus();return;}if(paletteColors.length!==8){status.textContent='Personal palettes need eight colors.';return;}if(host){status.textContent='Saving personal palette…';host.postMessage({type:'settingsPaletteSave',name:paletteName,colors:paletteColors});}else{const items=local().filter(item=>item.name!==`User: ${paletteName}`);items.push({name:`User: ${paletteName}`,colors:paletteColors});localStorage.setItem(key,JSON.stringify(items));setItems(items,'Saved to personal palettes on this browser.');select.value=`User: ${paletteName}`;select.onchange();}};
    panel.querySelector('[data-palette-apply]').onclick=()=>{if(!window.canvasApplyPalette){status.textContent='Open a canvas to apply this palette.';return;}window.canvasApplyPalette({name:name.value.trim()||'Custom canvas palette',colors:colors()});status.textContent='Applied to this canvas. Save the canvas file to share these colors.';};
    panel.querySelector('[data-palette-delete]').onclick=()=>{const item=selected();if(!item?.name.startsWith('User: '))return;const bare=item.name.slice(6);if(!window.confirm(`Delete personal palette “${bare}”?`))return;if(host){status.textContent='Deleting personal palette…';host.postMessage({type:'settingsPaletteDelete',name:bare});}else{const items=local().filter(other=>other.name!==item.name);localStorage.setItem(key,JSON.stringify(items));setItems(items,'Personal palette deleted.');select.value='';select.onchange();}};
    panel.querySelector('[data-palette-refresh]').onclick=refresh;
    dialog.addEventListener('close',()=>{if(active?.dialog===dialog)active=null;});
    showColors(current().colors);refresh();
  }
  host?.addEventListener('message',event=>{const message=event.data;if(!active)return;const {panel}=active,status=panel.querySelector('[data-palette-status]');if(message.type==='hostError'&&status.textContent.includes('palette')){status.textContent=message.message||'Could not update personal palettes.';return;}if(message.type!=='bridgeResult'||!String(message.action||'').startsWith('settings-palettes-'))return;const result=message.result||{};if(!result.ok){status.textContent=result.error||'Could not update personal palettes.';return;}const items=normalize(result.palettes);active.items=items;const select=panel.querySelector('[data-personal-palette]'),name=panel.querySelector('[data-palette-name]'),desired=message.action==='settings-palettes-save'?`User: ${name.value.trim()}`:message.action==='settings-palettes-delete'?'':select.value;select.replaceChildren(new Option('New palette',''),...items.map(item=>new Option(item.name,item.name)));select.value=items.some(item=>item.name===desired)?desired:'';if(message.action!=='settings-palettes-list')select.onchange();status.textContent=message.action==='settings-palettes-save'?'Saved to your personal palettes.':message.action==='settings-palettes-delete'?'Personal palette deleted.':'';notify(items);});
  globalThis.CanvasPaletteDesigner={install};
})();
