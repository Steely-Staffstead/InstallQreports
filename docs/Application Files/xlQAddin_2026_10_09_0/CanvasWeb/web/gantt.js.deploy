    const dependencies=audit.edges.map(edge=>{const predecessor=visibleIdMap.get(edge.parentId),item=allItems.find(candidate=>candidate.sourceIndex===edge.child.sourceIndex);if(!predecessor||!item||!rowPosition.has(predecessor)||!rowPosition.has(item))return"";const x1=x(predecessor.end)+Math.max(dayWidth,8),y1=headerHeight+rowPosition.get(predecessor)*rowHeight+rowHeight/2,x2=x(item.start),y2=headerHeight+rowPosition.get(item)*rowHeight+rowHeight/2,mid=Math.max(x1+12,(x1+x2)/2),selected=selectedDependency?.key===edge.key,connected=highlightConnected&&selectedRow>=0&&(predecessor.sourceIndex===selectedRow||item.sourceIndex===selectedRow),emphasized=selected||connected,color=edge.invalid?palette.negative:connected?palette.accent:dependencyColor,path=`M${x1} ${y1} H${mid} V${y2} H${Math.max(0,x2-3)}`,attributes=`data-gantt-dependency="${esc(edge.key)}" data-gantt-parent-row="${predecessor.sourceIndex}" data-gantt-child-row="${item.sourceIndex}"`;return `<g class="gantt-dependency${edge.invalid?' invalid':''}${selected?' selected':''}${connected?' selection-related':''}" ${attributes}><path class="gantt-dependency-hit" d="${path}"/><path class="gantt-dependency-line" d="${path}" fill="none" stroke="${color}" stroke-width="${emphasized?Math.max(3,dependencyWidth+1):dependencyWidth}" stroke-dasharray="${dependencyDash}" opacity="${emphasized?1:.78}" marker-end="url(#gantt-arrow-${esc(tile.id)})"><title>${esc(`${predecessor.task} → ${item.task}${edge.reason?` · ${edge.reason}`:""}`)}</title></path></g>`;}).join("");
