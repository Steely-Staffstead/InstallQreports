  function renderPropertyPanels(){renderProperties();renderHeaderProperties();renderHeaderThemeControls();renderTileSourceControl();renderTextPadding();renderPictureProperties();renderGraphicProperties();renderValueSelectorProperties();renderVisualProperties();renderVisualTypography();renderSubtotalProperties();augmentSubtotalProperties();finalizeMatrixSubtotalQuick();renderCardProperties();renderCardCaptionProperties();renderCardBorderControl();renderBorderProperties();renderChartProperties();renderExtendedChartQuickGroup();extendAxisQuickControls();extendMultipleQuickControls();extendHeatmapQuickControls();const groupColor=$("[data-chart-option='GroupLabelColor']"),groupOptions=selectedTile()?.design?.chartSpec?.ChartOptions||{};if(groupColor&&groupOptions.GroupLabelColor==null)groupColor.value=CanvasTheme.roles(model.settings.theme).text;ensureChartPropertiesApply();renderLayerProperties();renderGeneralSettings();window.CanvasReportGrid.renderProperties($("#tileProperties"),selectedTile(),{tile:selectedTile,theme:()=>model.settings.theme,sources:()=>model.sources,measures:id=>(sourceById(id)?.query?.measures||[]).map(normalizeMeasure),format,change:()=>{markDirty();render();}});}
  const cardSectionState=new Map();
  function renderCardFieldOptions(tile){
    const select=$("#tileField");if(!select)return;
    select.innerHTML='<option value="">Select field or measure…</option>'+model.sources.map(source=>{
      const names=[...new Set([...(source.query?.measures||[]).map(item=>item.Name??item.name??item.OutputName??item.outputName).filter(Boolean),...(source.query?.data?.columns||[])])];
      return `<optgroup label="${esc(source.name)}">${names.map(name=>`<option value="${esc(name)}" data-source-id="${esc(source.id)}" ${source.id===(tile.sourceId||"main")&&name===tile.field?"selected":""}>${esc(name)}</option>`).join("")}</optgroup>`;
    }).join("");
  }
  function renderChartTitleControls(){
    if(activeChartPropertyGroup!=="Title settings"||selectedTile()?.kind!=="chart")return;
    const panel=$("#chartPropertyControls"),opts=selectedTile().design?.chartSpec?.ChartOptions||{};if(!panel)return;
    const placements=[["Automatic","Automatic (existing alignment)"],["TopLeft","Top left"],["TopCenter","Top center"],["TopRight","Top right"],["MiddleLeft","Middle left"],["Center","Center"],["MiddleRight","Middle right"],["BottomLeft","Bottom left"],["BottomCenter","Bottom center"],["BottomRight","Bottom right"],["VerticalLeft","Vertical left"],["VerticalRight","Vertical right"]];
    const position=opts.TitlePosition||"Automatic",angle=opts.TitleAngle??(position==="VerticalLeft"?-90:position==="VerticalRight"?90:0);
    panel.insertAdjacentHTML("beforeend",`<label>Placement<select data-chart-option="TitlePosition">${placements.map(([value,label])=>`<option value="${value}" ${position===value?"selected":""}>${label}</option>`).join("")}</select></label><div class="property-grid"><label>Angle (°)<input type="number" min="-180" max="180" data-chart-option="TitleAngle" value="${angle}"></label><label>Horizontal offset<input type="number" min="-1100" max="1100" data-chart-option="TitleOffsetX" value="${opts.TitleOffsetX??0}"></label><label>Vertical offset<input type="number" min="-440" max="440" data-chart-option="TitleOffsetY" value="${opts.TitleOffsetY??0}"></label></div><small>Drag the title in the chart editor for precise placement.</small>`);
  }
  function renderGeneralSettings(){
    const properties=$("#tileProperties");if(!properties)return;
    if(selectedTile()?.kind==="chart"&&activeChartPropertyGroup==="Title settings"&&!$("#quickChartTitle")){const label=document.createElement("label");label.id="quickChartTitle";label.innerHTML='<span>Title</span><input type="text" data-chart-option="TitleText">';label.querySelector("input").value=selectedTile().design?.chartSpec?.ChartOptions?.TitleText??selectedTile().design?.chartSpec?.Name??"Chart";$("#chartPropertyControls")?.querySelector('[data-chart-option="ShowTitle"]')?.closest("label")?.after(label);}
    let general=$("#tileGeneralSettings");
    if(!general){general=document.createElement("details");general.id="tileGeneralSettings";general.innerHTML="<summary>General settings</summary>";properties.append(general);}
    $("#headerSettings")?.after(general);
    $("#headerSettings")?.querySelector("summary")?.after($("#tileHeader").closest("label"));
    $("#tileHeight").min=selectedTile()?.kind==="picture"?30:0;
    let imagePicker=$("#localImagePicker");
    if(!imagePicker){
      imagePicker=document.createElement("div");imagePicker.id="localImagePicker";
      imagePicker.innerHTML='<label class="file-button">Choose image…<input type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/bmp"></label><p>Find an image and paste its direct image URL above.</p><p>Free Sources:</p><ul><li><a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a></li><li><a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer">Pexels</a></li><li><a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a></li></ul><small data-image-name></small>';
      $("#pictureProperties")?.querySelector("summary")?.after(imagePicker);
      imagePicker.querySelector("input").addEventListener("change",async event=>{
        const tile=selectedTile(),file=event.target.files[0];if(tile?.kind!=="picture"||!file)return;
        if(file.size>20*1024*1024){$("#jsonError").textContent="Choose an image smaller than 20 MB.";return;}
        try{const value=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(reader.error);reader.readAsDataURL(file);});tile.text=value;tile.imageFileName=file.name;markDirty();render();}catch(error){$("#jsonError").textContent=error.message;}
      });
    }
    imagePicker.querySelector("[data-image-name]").textContent=selectedTile()?.imageFileName?`Embedded image: ${selectedTile().imageFileName}`:"Local images are included in the canvas file.";
    const position=$("#tileX")?.closest(".property-grid");
    [$("#tileSourceLabel"),$("#tileField")?.closest("label"),position,$("#textRoundingControl"),$("#tileBackground")?.closest("label"),properties.querySelector('[data-picture="transparentBackground"]')?.closest("label")].filter(Boolean).forEach(control=>general.append(control));
    general.classList.toggle("hidden",!selectedTile()||graphicKinds.has(selectedTile().kind));
    const body=$("#textBodySettings");if(body)general.after(body);
    const imageSettings=$("#pictureProperties");if(imageSettings){general.after(imageSettings);imageSettings.append($("#plainTextLabel"));}
    const panel=$("#cardProperties");if(!panel)return;
    // The card renderer rebuilds its controls; retain each section's expansion state.
