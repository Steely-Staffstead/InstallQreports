false?`<label>Text theme<select data-gantt-appearance-scope="label" data-gantt-appearance-property="textRole">${roleOptions(label.textRole||"text")}</select></label>`:`<label>Text color<input type="color" data-gantt-appearance-scope="label" data-gantt-appearance-property="textColor" value="${esc(label.textColor||'#182230')}"></label>`}<div class="property-grid"><label>Font size<input type="number" min="8" max="24" data-gantt-appearance-scope="label" data-gantt-appearance-property="fontSize" value="${label.fontSize||11}"></label><label class="check"><input type="checkbox" data-gantt-appearance-scope="label" data-gantt-appearance-property="bold" ${label.bold!==false?"checked":""}> Bold</label><label class="check"><input type="checkbox" data-gantt-appearance-scope="label" data-gantt-appearance-property="italic" ${label.italic?"checked":""}> Italic</label></div></section>`);
