       destinationControl.insertAdjacentHTML("beforebegin",`<label>Action type<select data-page-link="actionType">${option("page","Open page",link.actionType||"page")}${option("refresh","Update all sources + underlying queries",link.actionType||"page")}${option("parameters","Change parameters",link.actionType||"page")}</select></label>`);
       destinationControl.classList.toggle("hidden",(link.actionType||"page")!=="page");
