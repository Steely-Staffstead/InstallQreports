  function openPrimaryTileEditor(tile=selectedTile()){
    if(!tile||selectedIds.size>1)return false;
    if(["text","graphicText"].includes(tile.kind)){focusFormattedText(tile);return true;}
    if(["table","matrix","chart","reportGrid","gantt"].includes(tile.kind)){openTileDesigner();return true;}
    model.settings.rightPaneCollapsed=false;applyPaneLayout();showSidePanel("properties");renderPropertyPanels();
    document.querySelector(".tile-settings")?.setAttribute("open","");
    let panel=null,focus=null;
    if(tile.kind==="picture"){
      panel=$("#pictureProperties");focus=panel?.querySelector('[data-picture="imageSizing"]');
    }else if(tile.kind==="card"){
      focus=$("#tileField");panel=focus?.closest("label");
    }else if(tile.kind==="svgGraphic"){
      panel=$("#svgGraphicProperties")?.querySelector('details[data-group="content"],details[data-group="svgText"],details[data-group="svg"]');
      focus=panel?.querySelector('input:not([type="hidden"]),select,textarea,button');
    }else if(tile.kind==="valueSelector"){
      panel=$("#valueSelectorProperties");focus=panel?.querySelector("select,input,button");
    }else if(graphicKinds.has(tile.kind)){
      panel=$("#graphicProperties")?.querySelector("details:not(.hidden)")||$("#graphicProperties");
      focus=panel?.querySelector('input:not([type="hidden"]),select,textarea,[contenteditable="true"],button');
    }else{
      panel=$("#tileProperties");focus=panel?.querySelector('input:not([type="hidden"]),select,textarea,button');
    }
    if(panel?.tagName==="DETAILS")panel.open=true;
    requestAnimationFrame(()=>{const target=focus||panel;target?.scrollIntoView?.({block:"nearest"});if(focus&&!focus.disabled)focus.focus({preventScroll:true});});
    return !!(panel||focus);
  }
