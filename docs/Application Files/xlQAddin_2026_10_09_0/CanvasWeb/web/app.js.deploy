      allObjects(p).forEach(t=>{t.borderThickness??=1;t.borderColor||="#cbd5e1";t.rounding??=0;if(t.kind==="card"&&t.card?.noBorder)t.noBorder=true;if(t.kind==="gantt"){t.design||={};t.design.ganttSpec=window.CanvasGantt.autoConfigure(t.design.ganttSpec,doc.sources.find(source=>source.id===(t.sourceId||"main"))?.query?.data?.columns||[]);}});
    });
    doc.pages.forEach(p=>{p.background.useTheme ??= String(p.background.color).toLowerCase()==="#e8edf2"&&!p.background.image;if(p.background.useTheme)p.background.themeRole||="surface";});
