  function renderGraphicProperties(){
    renderSvgGraphicProperties();
    let panel=$("#graphicProperties");
    if(!panel){panel=document.createElement("div");panel.id="graphicProperties";panel.className="hidden";$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.graphic;if(!t||!key)return;const individual=new Set(["title","x","y","width","height","fromId","toId"]),targets=individual.has(key)?[t]:matchingSelectedObjects();for(const item of targets){if(["useThemeColor","useThemeBackground","useThemeText"].includes(key)){const field=key==="useThemeColor"?"color":key==="useThemeText"?"textColor":"background";item.themeBindings||={};if(event.target.checked)item.themeBindings[field]=CanvasTheme.paths[field];else{item[field]=CanvasTheme.resolve(item,model.settings.theme)[field]||item[field];delete item.themeBindings[field];}}else if(key==="textThemeRole"||key==="backgroundThemeRole"){item.themeBindings||={};item.themeBindings[key==="textThemeRole"?"textColor":"background"]=event.target.value;}else item[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?+event.target.value||0:event.target.value;if(key==="title")delete item.duplicateBaseName;if(key==="boxShape"&&item.boxed){if(item.boxShape==="circle")item.height=Math.max(item.height,item.width);if(item.boxShape==="diamond")item.height=Math.max(item.height,Math.round(item.width*.6));}if(key==="height")item.height=Math.max(30,item.height);if(key==="fromId")item.fromAnchor=null;if(key==="toId")item.toAnchor=null;}markDirty();render();});}
     const t=selectedTile(),graphic=graphicKinds.has(t?.kind);panel.classList.toggle("hidden",!graphic);if(!graphic)return;
     if(t.kind==="pageLink"){
       const link=t.pageLink||{},option=(value,label,current)=>`<option value="${value}" ${value===current?"selected":""}>${label}</option>`;
       const linkThemeRole=key=>{const explicit=link.themeTextRoles?.[key];return model.settings.theme?.requireColors?(explicit&&explicit!=="custom"?explicit:key==="actionHtml"?"accent":"headerText"):explicit==="custom"?"":explicit||(link.backgroundRole?(key==="actionHtml"?"accent":"headerText"):"");};
       const themeChoice=key=>{const required=model.settings.theme?.requireColors===true,current=linkThemeRole(key),roles=CanvasTheme.roles(model.settings.theme),names=["text","headerText","surface","accent","onAccent","positive","negative",...Object.keys(roles).filter(name=>/^color\d+$/.test(name))];return `<label class="page-link-theme-choice">Theme text color<select data-page-theme-role="${key}"><option value="" ${current?"":"selected"} ${required?"disabled":""}>Custom text colors</option>${[...new Set(names)].map(name=>`<option value="${name}" ${name===current?"selected":""}>${/^color\d+$/.test(name)?`Theme color ${name.slice(5)}`:name.replace(/([A-Z])/g," $1")}</option>`).join("")}</select></label>`;};
       const editor=(key,label,fallback)=>`<div class="page-link-editor-block ${key==="pillHtml"?"page-link-pill-field":"page-link-card-field"}"><span class="field-label">${label}</span><div class="page-link-rich-toolbar"><button type="button" data-page-format="bold" title="Bold"><b>B</b></button><button type="button" data-page-format="italic" title="Italic"><i>I</i></button><button type="button" data-page-format="underline" title="Underline"><u>U</u></button><select data-page-font title="Font"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option></select><input type="number" data-page-size min="8" max="72" value="${key==="headingHtml"?24:key==="actionHtml"?13:15}" title="Font size"><input type="color" data-page-color value="#f7f9ff" title="Text color" ${linkThemeRole(key)?"disabled":""}><button type="button" data-page-format="justifyLeft" title="Align left">⇤</button><button type="button" data-page-format="justifyCenter" title="Align center">↔</button><button type="button" data-page-format="justifyRight" title="Align right">⇥</button></div>${themeChoice(key)}<div class="page-link-rich-editor rich-content ${linkThemeRole(key)?"page-link-theme-text":""}" style="--page-link-theme-text:${CanvasTheme.roles(model.settings.theme)[linkThemeRole(key)]||"inherit"}" contenteditable="true" data-page-rich="${key}" role="textbox" aria-label="${label}" aria-multiline="true">${sanitizeHtml(link[key]||fallback)}</div></div>`;
       panel.innerHTML=`<details open><summary>Page navigation</summary><label>Object name<input data-graphic="title" value="${esc(t.title||"")}"></label><label>Style<select data-page-link="style">${option("card","Stage card",link.style)}${option("detail","Detail card",link.style)}${option("pill","Navigation pill",link.style)}</select></label><div class="page-link-card-field">${editor("headingHtml","Heading",`<p>${esc(link.heading||"Explore this page")}</p>`)}</div><div class="page-link-card-field">${editor("descriptionHtml","Description",`<p>${esc(link.line1||"")}${link.line2?`<br>${esc(link.line2)}`:""}</p>`)}</div><div class="page-link-card-field">${editor("actionHtml","Action",`<p>${esc(link.caption||"OPEN ↗")}</p>`)}</div>${editor("pillHtml","Pill text",`<p>${esc(link.heading||"Open page")}</p>`)}<div class="property-grid"><label>Horizontal alignment<select data-page-link="horizontalAlign">${["left","center","right"].map(value=>option(value,value[0].toUpperCase()+value.slice(1),link.horizontalAlign||"left")).join("")}</select></label><label>Vertical alignment<select data-page-link="verticalAlign">${["top","middle","bottom"].map(value=>option(value,value[0].toUpperCase()+value.slice(1),link.verticalAlign||"top")).join("")}</select></label></div><label>Destination<select data-page-link="target">${option("page","Choose page",link.target)}${option("home","First page",link.target)}${option("previous","Previous page",link.target)}${option("next","Next page",link.target)}</select></label><label class="page-link-page-choice">Page<select data-page-link="pageId">${model.pages.map(item=>option(esc(item.id),esc(item.name),link.pageId)).join("")}</select></label><label class="check"><input type="checkbox" data-page-link="useTheme" ${link.useTheme!==false?"checked":""}> Use canvas accent</label><label>Accent color<input type="color" data-page-link="accent" value="${/^#[0-9a-f]{6}$/i.test(link.accent||"")?link.accent:"#6b8ce8"}" ${link.useTheme!==false?"disabled":""}></label></details><details><summary>Position and size</summary><div class="property-grid"><label>Left<input data-graphic="x" type="number" value="${t.x}"></label><label>Top<input data-graphic="y" type="number" value="${t.y}"></label><label>Width<input data-graphic="width" type="number" value="${t.width}"></label><label>Height<input data-graphic="height" type="number" value="${t.height}"></label></div></details>`;
       panel.querySelector("summary").textContent="Action";
