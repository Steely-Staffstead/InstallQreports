  function correctFixedChartText(){/* SVGs preserve aspect ratio; keep authored text rotations intact. */}
  function ensureSourceUi(){
    if(!$("#sourceList")){$("#pageList")?.insertAdjacentHTML("afterend",'<div class="section-heading"><span data-experience-label="connections">Data sources</span><button class="icon-button" data-action="addSource" title="Add global source">+</button></div><div id="sourceList" class="source-list"></div><div class="source-actions"><button data-action="renameSource">Rename</button><button data-action="deleteSource">Delete</button><button data-action="resetMainSource" title="Remove the Main source connection, loaded data, measures and filters">Reset main</button></div>');}
    if(!$("#activeSourceName")){const heading=document.querySelector(".query-summary b");if(heading)heading.id="activeSourceName";}
    if(!$("#tileSource")){const field=$("#tileField")?.closest("label");field?.insertAdjacentHTML("beforebegin",'<label id="tileSourceLabel">Data source<select id="tileSource"></select></label>');$("#tileSource")?.addEventListener("change",event=>{const tile=selectedTile();if(!tile)return;tile.sourceId=event.target.value;if(tile.design)delete tile.design.data;activeSourceId=tile.sourceId;markDirty();render();});}
    const filterTab=document.querySelector('[data-panel="filters"]');if(filterTab)filterTab.textContent="Filters";
    const filtersPanel=$("#filtersPanel");if(filtersPanel&&!$("#tileFilterList")){filtersPanel.querySelector(".panel-title").textContent="Source query filters";const note=filtersPanel.querySelector(".property-empty");if(note)note.textContent="Source filters use the data already loaded for this source and affect every tile connected to it.";note?.insertAdjacentHTML("afterend",'<hr class="filter-divider"><div class="panel-title">Tile filters</div><div id="tileFilterContext" class="filter-context">Select a data tile to add a local filter.</div><div id="tileFilterList"></div><button data-action="addTileFilter">+ Add local filter</button><button class="primary" data-action="applyTileFilters">Apply filter</button><p class="property-empty">Tile filters use loaded source data and affect only the referenced tile.</p>');}
    organizeFilterPanel();
  }
  function organizeFilterPanel(){
    const panel=$("#filtersPanel");if(!panel||panel.querySelector(".filter-level"))return;
    const definitions=[
      {scope:"source",title:"Source query filters",list:"filterList",action:"addFilter",help:"Source filters affect every tile connected to this data source."},
      {scope:"page",title:"Page filters",list:"pageFilterList",action:"addPageFilter",help:"Page filters affect tiles on this page that use the chosen source."},
      {scope:"tile",title:"Tile filters",list:"tileFilterList",action:"addTileFilter",help:"Tile filters stay with the tile, including when it moves to another page."}
    ];
    for(const item of definitions){
      const list=$("#"+item.list),button=panel.querySelector(`[data-action="${item.action}"]`);if(!list||!button)continue;
      const section=document.createElement("details");section.className="filter-level filter-level-"+item.scope;section.dataset.filterLevel=item.scope;section.open=item.scope==="source";
      const summary=document.createElement("summary");summary.textContent=item.title;const help=document.createElement("span");help.className="filter-level-help";help.textContent="ⓘ";help.title=item.help;help.setAttribute("aria-label",item.help);help.addEventListener("click",event=>event.stopPropagation());summary.append(help);section.append(summary);
      const context=item.scope==="tile"?$("#tileFilterContext"):null;if(context)section.append(context);
      section.append(list,button);panel.append(section);
    }
    panel.querySelectorAll('[data-action="applyFilters"],[data-action="applyTileFilters"],.filter-divider,.panel-title,.property-empty').forEach(node=>node.remove());
  }
  function updateFilterGroupCounts(){
    const counts={source:(query().filters||[]).length,page:(page().filters||[]).length,tile:(page().tiles||[]).reduce((total,tile)=>total+(tile.filters||[]).length,0)};
    const titles={source:"Source query filters",page:"Page filters",tile:"Tile filters"};
    for(const [scope,count] of Object.entries(counts)){
      const summary=$("#filtersPanel")?.querySelector(`.filter-level-${scope} > summary`);
      if(summary?.firstChild)summary.firstChild.textContent=`${titles[scope]} (${count})`;
    }
  }
  function renderCanvasTheme(){window.canvasSettingsPalettes=[...Object.entries(builtInPalettes).map(([name,colors])=>({name,colors})),...(model.settings.palettes||[]),...localPalettes,{name:model.settings.theme.name,colors:model.settings.theme.colors}];const select=$("#canvasPalette"),colors=$("#canvasPaletteColors");if(!select||!colors)return;const theme=model.settings.theme||={name:"Default",colors:[...builtInPalettes.Default]},names=[...new Set([...Object.keys(builtInPalettes),...(model.settings.palettes||[]).map(item=>item.name),...localPalettes.map(item=>item.name)])];if(!names.includes(theme.name))names.unshift(theme.name);select.innerHTML=names.map(name=>`<option ${name===theme.name?"selected":""}>${esc(name)}</option>`).join("");colors.innerHTML=theme.colors.map((color,index)=>`<span class="palette-color"><input type="color" value="${color}" data-palette-color="${index}" title="Color ${index+1}"><button type="button" data-remove-palette-color="${index}" title="Remove">×</button></span>`).join("");}
  function renderCanvasObjects(){
    const canvas=$("#canvas");
    canvas.querySelectorAll(".tile").forEach(n=>n.remove());
    const objects=allObjects(page());
    $("#emptyState").classList.toggle("hidden",objects.length>0);
    [...objects].sort((a,b)=>(a.layer??0)-(b.layer??0)).forEach(t=>{renderQueryContext=displayQueryForTile(t);canvas.insertAdjacentHTML("beforeend",tileHtml(t));renderQueryContext=null;});
    objects.forEach(t=>{const node=canvas.querySelector(`.tile[data-id="${t.id}"]`);if(node)node.style.zIndex=t.layer??0;});
    renderedConnectorSelectionId=selectedTile()?.kind==="connector"?selectedId:null;
    bindTiles();
    correctFixedChartText(canvas);
  }
  function render() {
    if(!presentationState)document.body.classList.remove("presentation-fit-screen");
    syncPublishedGanttSources(model);
    if(!showHiddenPagesWhileEditing()&&page()?.hidden){const first=visiblePageEntries()[0];if(first)pageIndex=first.index;}
    document.body.classList.toggle('theme-colors-required',model.settings.theme?.requireColors===true);
    ensureSourceUi();
    applyPaneLayout();
    $("#reportName").value = model.name || "";
    $("#hostBadge").textContent = host ? "Desktop bridge active" : "Web mode";
    const pageList=$("#pageList"),listedPages=model.pages.map((item,index)=>({item,index})).filter(entry=>showHiddenPagesWhileEditing()||entry.item.hidden!==true);
    pageList.innerHTML=listedPages.map(({item,index})=>`<button class="page-item ${index===pageIndex?"active":""} ${item.hidden?"hidden-page":""}" data-page="${index}" title="Double-click to rename page">${item.hidden?'<span class="page-hidden-mark" aria-label="Hidden page">◌</span> ':""}${esc(item.name)}</button>`).join("");
    const currentSource=activeSource();activeSourceId=currentSource?.id||"main";$("#sourceList").innerHTML=model.sources.map(source=>`<button class="source-item ${source.id===activeSourceId?"active":""}" data-source-id="${esc(source.id)}"><span>${source.kind==="main"?"◆":source.kind==="gantt"?"▰":"◇"}</span><b>${esc(source.name)}</b><small>${source.kind==="main"?"Main":source.kind==="gantt"?"Embedded Gantt":"Global"}</small></button>`).join("");const resetMainButton=document.querySelector('[data-action="resetMainSource"]');if(resetMainButton)resetMainButton.disabled=currentSource?.kind!=="main";
    $("#activeSourceName").textContent=currentSource?.name||"Main source"; $("#queryConnection").textContent = query().connectionName || "Not set"; $("#measureCount").textContent = query().measures.length; $("#rowCount").textContent = `${query().data.rows.length}${query().totalRows > query().data.rows.length ? ` of ${query().totalRows}` : ""}`; $("#previewLimit").value = query().previewLimit;
    applyCanvasSizeControls();
    $("#pageBackgroundUseTheme").checked = !!page().background.useTheme||!!model.settings.theme?.requireColors; $("#pageBackgroundUseTheme").disabled=!!model.settings.theme?.requireColors;$("#pageBackground").disabled = !!page().background.useTheme||!!model.settings.theme?.requireColors;const pageRole=$("#pageBackgroundThemeRole"),slots=(model.settings.theme?.colors||[]).map((_,index)=>`<option value="color${index+1}">Theme color ${index+1}</option>`);pageRole.innerHTML=`<option value="surface">Surface</option>${slots.join("")}`;pageRole.value=page().background.themeRole||"surface";pageRole.closest("label").classList.toggle("hidden",!page().background.useTheme&&!model.settings.theme?.requireColors);
    $("#pageBackground").value = pageBackgroundColor(page()); $("#pageBackgroundImage").value = page().background.image; $("#pageBackgroundFit").value = page().background.fit;
    Object.assign($("#canvas").style, { backgroundColor: pageBackgroundColor(page()), backgroundImage: page().background.image ? `url("${page().background.image.replace(/["\\]/g, "")}")` : "", backgroundSize: page().background.image ? page().background.fit : "20px 20px", backgroundRepeat: page().background.image ? "no-repeat" : "repeat", backgroundPosition: "center" });
    renderFilters();
    renderCanvasObjects();
    updateAlignMenu();renderComponentMenu(); renderPropertyPanels();renderCanvasTheme(); syncJson();
  }
  function renamePageInline(index){const button=$("#pageList")?.querySelector(`[data-page="${index}"]`),item=model.pages[index];if(!button||!item)return;const input=document.createElement("input");input.className="page-name-editor";input.value=item.name||`Page ${index+1}`;button.replaceWith(input);input.focus();input.select();let finished=false;const finish=save=>{if(finished)return;finished=true;const name=input.value.trim();if(save&&name&&name!==item.name){item.name=name;markDirty();}render();};input.addEventListener("keydown",event=>{if(event.key==="Enter")finish(true);if(event.key==="Escape")finish(false);});input.addEventListener("blur",()=>finish(true),{once:true});}
  function movePage(index,target){if(index<0||index>=model.pages.length)return;const destination=target==="top"?0:target==="up"?Math.max(0,index-1):target==="down"?Math.min(model.pages.length-1,index+1):model.pages.length-1;if(destination===index)return;const[item]=model.pages.splice(index,1);model.pages.splice(destination,0,item);pageIndex=destination;selectedId=null;selectedIds.clear();markDirty();render();}
  function duplicatePage(index){
    const source=model.pages[index];if(!source)return;
    const {query:sharedQuery,...pageSettings}=source,copy=structuredClone(pageSettings),ids=new Map();
    copy.id=uid();copy.query=sharedQuery;
    const base=`${source.name||`Page ${index+1}`} copy`;let name=base,suffix=2;
    while(model.pages.some(item=>item.name===name))name=`${base} ${suffix++}`;
    copy.name=name;
    for(const item of allObjects(copy)){const originalId=item.id;item.id=uid();ids.set(originalId,item.id);}
    for(const item of allObjects(copy)){
      if(item.kind==="connector"){if(ids.has(item.fromId))item.fromId=ids.get(item.fromId);if(ids.has(item.toId))item.toId=ids.get(item.toId);}
      if(item.kind==="valueSelector"&&Array.isArray(item.valueSelector?.targetIds))item.valueSelector.targetIds=item.valueSelector.targetIds.map(id=>ids.get(id)||id);
      if(item.kind==="pageLink"&&item.pageLink?.pageId===source.id)item.pageLink.pageId=copy.id;
    }
    model.pages.splice(index+1,0,copy);pageIndex=index+1;selectedId=null;selectedIds.clear();markDirty();render();
  }
  function themedConfirm(title,message,confirmLabel="Delete"){return new Promise(resolve=>{const dialog=document.createElement("dialog");dialog.className="qanvas-confirm-dialog";dialog.innerHTML=`<form method="dialog"><h3>${esc(title)}</h3><p>${esc(message)}</p><div><button value="cancel">Cancel</button><button value="confirm" class="danger">${esc(confirmLabel)}</button></div></form>`;dialog.addEventListener("close",()=>{const accepted=dialog.returnValue==="confirm";dialog.remove();resolve(accepted);},{once:true});document.body.append(dialog);dialog.showModal();});}
  async function deletePage(index){if(model.pages.length<=1){$("#saveStatus").textContent="A report must contain at least one page";return;}const name=model.pages[index]?.name||`Page ${index+1}`;if(!await themedConfirm("Delete page",`Delete “${name}” and all of its tiles?`))return;const previousPageIndex=pageIndex;model.pages.splice(index,1);if(index<previousPageIndex)pageIndex=previousPageIndex-1;else if(index===previousPageIndex)pageIndex=Math.min(index,model.pages.length-1);else pageIndex=previousPageIndex;selectedId=null;selectedIds.clear();markDirty();render();}
  const pageLayouts={blank:{label:"Blank",slots:[]},title:{label:"Title only",slots:[[60,80,1160,190]]},content:{label:"Title and content",tileSlots:[1],slots:[[60,45,1160,115],[60,190,1160,470]]},two:{label:"Two columns",tileSlots:[1,2],slots:[[60,45,1160,115],[60,190,560,470],[660,190,560,470]]},three:{label:"Three columns",tileSlots:[1,2,3],slots:[[60,45,1160,115],[60,190,360,470],[460,190,360,470],[860,190,360,470]]},comparison:{label:"Comparison",tileSlots:[3,4],slots:[[60,45,1160,115],[60,185,560,65],[660,185,560,65],[60,265,560,395],[660,265,560,395]]},leftChart1:{label:"Content + 1 tile",tileCount:1,slots:[[50,45,660,630],[740,45,490,630]]},leftChart2:{label:"Content + 2 tiles",tileCount:2,slots:[[50,45,660,630],[740,45,490,307],[740,368,490,307]]},leftChart3:{label:"Content + 3 tiles",tileCount:3,slots:[[50,45,660,630],[740,45,490,200],[740,260,490,200],[740,475,490,200]]}};
  function applyPageLayout(index,kind){
    const target=model.pages[index],layout=pageLayouts[kind];if(!target||!layout)return;
    target.tiles=target.tiles.filter(item=>item.kind!=="layoutPlaceholder");
    const objects=allObjects(target).filter(item=>item.kind!=="connector"),fresh=objects.length===0;
    target.graphics||=[];
    const roles=CanvasTheme.roles(model.settings.theme),placeholder=heading=>{const item={id:uid(),kind:"graphicText",title:heading?"Title":"Content",html:`<p>${heading?"Click to add title":"Click to add text"}</p>`,showHeader:false,boxed:true,background:roles.surface,borderColor:roles.grid,textColor:roles.text,fontFamily:"Segoe UI",fontSize:heading?32:20,paddingY:6,x:0,y:0,width:100,height:100};item.themeBindings=CanvasTheme.inherit(item);target.graphics.push(item);return item;},tilePlaceholder=()=>{const item={id:uid(),kind:"layoutPlaceholder",title:"Add tile",showHeader:false,background:roles.surface,borderColor:roles.grid,x:0,y:0,width:100,height:100,layer:allObjects(target).length};item.themeBindings=CanvasTheme.inherit(item);target.tiles.push(item);return item;};
    if(layout.slots.length){
      let ordered;
      if(layout.tileCount){const left=objects.find(item=>!["line","rectangle"].includes(item.kind))||placeholder(false);ordered=[left,...objects.filter(item=>item!==left).slice(0,layout.tileCount)];while(ordered.length<layout.slots.length)ordered.push(tilePlaceholder());}
      else{const title=objects.find(item=>["text","graphicText"].includes(item.kind))||placeholder(true);ordered=[title,...objects.filter(item=>item!==title)];while(ordered.length<layout.slots.length){const slot=ordered.length;ordered.push(fresh&&layout.tileSlots?.includes(slot)?tilePlaceholder():placeholder(false));}}
      ordered.slice(0,layout.slots.length).forEach((item,slot)=>{const [x,y,width,height]=layout.slots[slot];Object.assign(item,{x,y,width,height});});
    }
    target.canvas={...target.canvas,mode:"preset",preset:"1280x720",width:1280,height:720};pageIndex=index;selectedId=null;selectedIds.clear();markDirty();render();
    const firstEmpty=fresh?target.tiles.find(item=>item.kind==="layoutPlaceholder"):null;if(firstEmpty&&typeof requestAnimationFrame==="function")requestAnimationFrame(()=>showLayoutTileDialog(firstEmpty));
  }
  function showPageMenu(event,index){event.preventDefault();event.stopPropagation();document.querySelector(".tile-context-menu")?.remove();const pageItem=model.pages[index],menu=document.createElement("div");menu.className="tile-context-menu page-context-menu";menu.innerHTML=`<div class="page-layout-title">Page layout</div><div class="page-layout-gallery">${Object.entries(pageLayouts).map(([key,item])=>`<button type="button" data-page-layout="${key}" title="${item.label}"><span class="page-layout-thumb">${item.slots.map(([x,y,width,height])=>`<i style="left:${x/12.8}%;top:${y/7.2}%;width:${width/12.8}%;height:${height/7.2}%"></i>`).join("")}</span><small>${item.label}</small></button>`).join("")}</div><hr><button data-page-command="visibility">${pageItem?.hidden?"Show page":"Hide page"}</button><button data-page-command="rename">Edit name</button><button data-page-command="duplicate">Duplicate</button><button data-page-command="top">Move to top</button><button data-page-command="up">Move up</button><button data-page-command="down">Move down</button><button data-page-command="bottom">Move to bottom</button><button class="danger" data-page-command="delete">Delete</button>`;document.body.append(menu);menu.style.left=`${Math.max(8,Math.min(event.clientX,innerWidth-menu.offsetWidth-8))}px`;menu.style.top=`${Math.max(8,Math.min(event.clientY,innerHeight-menu.offsetHeight-8))}px`;menu.addEventListener("click",click=>{const layout=click.target.closest("[data-page-layout]")?.dataset.pageLayout;if(layout){menu.remove();applyPageLayout(index,layout);return;}const command=click.target.closest("[data-page-command]")?.dataset.pageCommand;if(!command)return;menu.remove();if(command==="visibility"){if(!pageItem.hidden&&visiblePageEntries().length<=1){$("#saveStatus").textContent="A report must keep at least one visible page";return;}pageItem.hidden=!pageItem.hidden;if(pageItem.hidden&&!showHiddenPagesWhileEditing()){const next=visiblePageEntries()[0];if(next)pageIndex=next.index;}markDirty();render();}else if(command==="rename")renamePageInline(index);else if(command==="duplicate")duplicatePage(index);else if(command==="delete")deletePage(index);else movePage(index,command);});}
  function applyPaneLayout(){const root=document.documentElement,main=document.querySelector("main"),settings=model.settings;root.style.setProperty("--left-pane-width",`${Math.max(150,Math.min(480,settings.leftPaneWidth||205))}px`);root.style.setProperty("--right-pane-width",`${Math.max(220,Math.min(620,settings.rightPaneWidth||285))}px`);if(!document.querySelector("#canvasPaneDockStyles")){const style=document.createElement("style");style.id="canvasPaneDockStyles";style.textContent=`main{grid-template-columns:var(--left-pane-width,205px) 6px minmax(520px,1fr) 6px var(--right-pane-width,285px)}.pane-splitter{cursor:col-resize;background:#e2e7ef}.pane-splitter:hover{background:#9fb1cc}.pane-dock{position:sticky;top:0;z-index:5;width:28px;height:34px;padding:0;border-radius:7px}.left-panel .pane-dock{float:right}.right-panel .pane-dock{float:left}.left-collapsed{grid-template-columns:30px 0 minmax(520px,1fr) 6px var(--right-pane-width,285px)}.right-collapsed{grid-template-columns:var(--left-pane-width,205px) 6px minmax(520px,1fr) 0 30px}.left-collapsed.right-collapsed{grid-template-columns:30px 0 minmax(520px,1fr) 0 30px}.left-collapsed .left-panel,.right-collapsed .right-panel{padding:6px 1px;overflow:hidden}.left-collapsed .left-panel>*:not(.pane-dock),.right-collapsed .right-panel>*:not(.pane-dock){display:none}.left-collapsed .left-panel .pane-dock,.right-collapsed .right-panel .pane-dock{float:none;margin:auto}`;document.head.append(style);const left=document.createElement("button"),right=document.createElement("button");left.className="pane-dock";right.className="pane-dock";left.dataset.action="toggleLeftPane";right.dataset.action="toggleRightPane";document.querySelector(".left-panel").prepend(left);document.querySelector(".right-panel").prepend(right)}document.querySelector(".left-panel .pane-dock").textContent=settings.leftPaneCollapsed?"›":"‹";document.querySelector(".right-panel .pane-dock").textContent=settings.rightPaneCollapsed?"‹":"›";main.classList.toggle("left-collapsed",!!settings.leftPaneCollapsed);main.classList.toggle("right-collapsed",!!settings.rightPaneCollapsed);}
  const maxCanvasDimension=16384;
  function applyCanvasSize() { const c = page().canvas, canvas = $("#canvas");let width,height;if (c.mode === "fit") { const viewport=canvas.closest(".canvas-viewport"),objects=allObjects(page());width=Math.max(viewport.clientWidth,...objects.map(t=>(+t.x||0)+(+t.width||0)+20));height=Math.max(viewport.clientHeight,...objects.map(t=>(+t.y||0)+(+t.height||0)+20)); } else { width=+c.width;height=+c.height;if (c.mode === "preset") [width, height] = String(c.preset||"1280x720").split("x").map(Number); }width=Math.max(320,Math.min(maxCanvasDimension,Number.isFinite(width)?width:1280));height=Math.max(240,Math.min(maxCanvasDimension,Number.isFinite(height)?height:720));const nextWidth=`${Math.round(width)}px`,nextHeight=`${Math.round(height)}px`;if(canvas.style.width!==nextWidth)canvas.style.width=nextWidth;if(canvas.style.height!==nextHeight)canvas.style.height=nextHeight; }
  function applyCanvasSizeControls(){const c=page().canvas,preset=$("#canvasPreset"),saved=String(c.preset||"1280x720");preset.querySelector('option[data-legacy-size]')?.remove();if(![...preset.options].some(option=>option.value===saved)){const [width,height]=saved.split('x');const option=new Option(`${width} × ${height} — Legacy size`,saved);option.dataset.legacySize='';preset.append(option);}$("#canvasSizeMode").value=c.mode;preset.value=saved;$("#canvasWidth").value=c.width;$("#canvasHeight").value=c.height;$("#canvasPresetLabel").classList.toggle("hidden",c.mode!=="preset");$("#manualCanvasSize").classList.toggle("hidden",c.mode!=="manual");applyCanvasSize();}
  function refreshTileBody(t,node){const body=node?.querySelector(".tile-body");if(!body)return;renderQueryContext=displayQueryForTile(t);body.innerHTML=tileBody(t);renderQueryContext=null;correctFixedChartText(node);}
  function filterEditorHtml(f,i,scope,tile=null){
    const ownerQuery=scope==="tile"?sourceForTile(tile)?.query:scope==="page"?sourceById(f.sourceId||"main")?.query:query(),fields=ownerQuery?.data?.columns||[],mode=f.mode||"Advanced",selectedValues=f.basicValues||[],selectedLabel=selectedValues.length?selectedValues.join(", "):"Choose values…",tileAttrs=tile?` data-tile-id="${esc(tile.id)}"`:"",heading=tile?`<div class="filter-row-heading" data-select-filter-tile="${esc(tile.id)}"><b>${esc(tile.title||tile.kind)}</b><button type="button" class="remove-filter" data-remove-filter="${i}" title="Delete filter">×</button></div>`:`<button type="button" class="remove-filter" data-remove-filter="${i}" title="Delete filter">×</button>`;
    const columnIndex=fields.findIndex(name=>String(name).toLowerCase()===String(f.column||"").toLowerCase()),rawValues=columnIndex<0?[]:(ownerQuery?.data?.rows||[]).map(row=>row[columnIndex]).filter(value=>value!==null&&value!==undefined&&value!==""),values=[...new Set(rawValues.map(String))].sort((a,b)=>compareValues(a,b)),numbers=rawValues.map(Number).filter(Number.isFinite),minimum=numbers.length?Math.min(...numbers):0,maximum=numbers.length?Math.max(...numbers):100,step=Number.isInteger(minimum)&&Number.isInteger(maximum)?1:Math.max((maximum-minimum)/100,.01),low=f.value===""||f.value==null?minimum:Number(f.value),high=f.value2===""||f.value2==null?maximum:Number(f.value2);
    const modes=[["Basic","Basic"],["Advanced","Advanced"],["Multiple","Multiple values"],["SearchMultiple","Searchable multi-select"],["Date","Date"],["DateRange","Date range"],["RelativeDate","Relative date"],["Buttons","Buttons (multiple)"],["Toggle","Toggle"],["Range","Numeric range (one handle)"],["RangeBetween","Numeric range (two handles)"],["Dropdown","Dropdown (single)"],["TopRows","Top N"],["BottomRows","Bottom N"]];
    let editor="";
    if(mode==="Basic")editor=`<button type="button" data-basic-filter="${i}" data-filter-scope="${scope}" title="${esc(selectedLabel)}">${esc(selectedLabel)}</button>`;
    else if(mode==="Multiple")editor=`<select multiple size="${Math.min(6,Math.max(2,values.length))}" data-filter-multiple aria-label="Select multiple values">${values.map(value=>`<option value="${esc(value)}" ${selectedValues.map(String).includes(value)?"selected":""}>${esc(value)}</option>`).join("")}</select><div class="canvas-filter-buttons"><button type="button" data-filter-select-all>All values</button><button type="button" data-filter-clear>Clear selection</button></div>`;
    else if(mode==="Dropdown")editor=`<select data-filter-key="value" aria-label="Choose one value"><option value="">All</option>${values.map(value=>`<option value="${esc(value)}" ${String(f.value??"")===value?"selected":""}>${esc(value)}</option>`).join("")}</select>`;
    else if(mode==="SearchMultiple")editor=`<div class="canvas-search-multiple"><input type="search" data-filter-search placeholder="Search values…"><div class="canvas-filter-checklist">${values.map(value=>`<label data-filter-search-value="${esc(value.toLowerCase())}"><input type="checkbox" data-filter-choice="${esc(value)}" ${selectedValues.map(String).includes(value)?"checked":""}> ${esc(value)}</label>`).join("")}</div><small>${selectedValues.length} selected</small></div>`;
    else if(mode==="Buttons")editor=`<div class="canvas-filter-buttons">${values.slice(0,100).map(value=>`<button type="button" data-filter-choice="${esc(value)}" class="${selectedValues.map(String).includes(value)?"active":""}" aria-pressed="${selectedValues.map(String).includes(value)}">${esc(value)}</button>`).join("")}</div>${values.length>100?'<small>Showing the first 100 values.</small>':""}`;
    else if(mode==="Date")editor=`<label>Date<input data-filter-key="value" type="date" value="${esc(f.value||"")}"></label><input type="hidden" data-calendar-to><label class="check"><input data-filter-key="showWeekNumbers" type="checkbox" ${f.showWeekNumbers?"checked":""}> Show week numbers</label>`;
    else if(mode==="DateRange")editor=`<div class="canvas-filter-pair"><label>From<input data-filter-key="value" type="date" value="${esc(f.value||"")}"></label><label>To<input data-filter-key="value2" type="date" value="${esc(f.value2||"")}"></label></div><label class="check"><input data-filter-key="showWeekNumbers" type="checkbox" ${f.showWeekNumbers?"checked":""}> Show week numbers</label>`;
    else if(mode==="RelativeDate")editor=`<select data-filter-key="value"><option value="">All dates</option>${[["today","Today"],["yesterday","Yesterday"],["thisWeek","This week"],["last7","Last 7 days"],["last30","Last 30 days"],["thisMonth","This month"],["thisYear","This year"],["fullDays","Previous full days"],["fullMonths","This month + prior months"],["fullYears","This year + prior years"],["rollingDays","Rolling days through today"],["rollingMonths","Rolling months through today"],["rollingYears","Rolling years through today"]].map(([value,label])=>`<option value="${value}" ${f.value===value?"selected":""}>${label}</option>`).join("")}</select>${/^(full|rolling)(Days|Months|Years)$/.test(f.value||"")?`<label>Number of ${esc(f.value.replace(/^(full|rolling)/,"").toLowerCase())}<input data-filter-key="n" type="number" min="1" max="1000" value="${Math.max(1,+f.n||1)}"></label>`:""}`;
    else if(mode==="Toggle"){const boolean=values.some(value=>/^(true|false)$/i.test(value)),on=boolean?(values.find(value=>/^true$/i.test(value))||"true"):(values.includes("1")?"1":values[0]||"1"),off=boolean?(values.find(value=>/^false$/i.test(value))||"false"):(values.includes("0")?"0":values[1]||"0"),active=f.value!==""&&f.value!=null;editor=`<div class="canvas-toggle-row"><button type="button" class="canvas-toggle ${active&&String(f.value)===String(on)?"active":""}" data-filter-toggle data-on="${esc(on)}" data-off="${esc(off)}" role="switch" aria-checked="${active&&String(f.value)===String(on)}"><span></span></button><span>${active?String(f.value)===String(on)?`On (${esc(on)})`:`Off (${esc(off)})`:"All values"}</span><button type="button" data-filter-clear>All values</button></div>`;}
