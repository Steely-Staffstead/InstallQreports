     }
    const generalOpen=panel.querySelector('[data-graphic-general]')?.open||false,shapeOpen=panel.querySelector('[data-graphic-shape]')?.open||false;
    const geometry=`${t.kind==="graphicText"&&t.boxed?`<label>Object name<input data-graphic="title" type="text" value="${esc(t.title||"")}"></label>`:""}${matchingSelectedObjects().length>1?`<p class="property-empty">Style changes apply to ${matchingSelectedObjects().length} selected ${t.kind==="graphicText"?"text boxes":t.kind+"s"}.</p>`:""}<details data-graphic-general ${generalOpen?'open':''}><summary>General settings</summary><div class="property-grid"><label>Left<input data-graphic="x" type="number" value="${t.x}"></label><label>Top<input data-graphic="y" type="number" value="${t.y}"></label><label>Width<input data-graphic="width" type="number" min="20" value="${t.width}"></label><label>Height<input data-graphic="height" type="number" min="30" value="${t.height}"></label></div></details>`;
    queueMicrotask(()=>{const general=panel.querySelector('[data-graphic-general]');if(!general||['graphicText','svgGraphic','valueSelector'].includes(t.kind)||panel.querySelector('[data-graphic-shape]'))return;const nodes=[...panel.childNodes].filter(n=>n!==general),shape=document.createElement('details');shape.dataset.graphicShape='';shape.open=shapeOpen;const summary=document.createElement('summary');summary.textContent=t.kind[0].toUpperCase()+t.kind.slice(1)+' settings';shape.append(summary,...nodes);panel.append(shape);});
    if(t.kind==="graphicText"||t.kind==="svgGraphic"||t.kind==="valueSelector"){
      const roleNames=Object.keys(CanvasTheme.roles(model.settings.theme)),roleOptions=selected=>roleNames.map(role=>`<option value="${esc(role)}" ${role===selected?"selected":""}>${/^color\d+$/.test(role)?`Palette ${role.slice(5)}`:esc(role.replace(/([A-Z])/g," $1"))}</option>`).join(""),required=model.settings.theme?.requireColors===true,resolved=CanvasTheme.resolve(t,model.settings.theme),textRole=t.themeBindings?.textColor||"text",backgroundRole=t.themeBindings?.background||"surface",textUsesTheme=required||!!t.themeBindings?.textColor,backgroundUsesTheme=required||!!t.themeBindings?.background;
