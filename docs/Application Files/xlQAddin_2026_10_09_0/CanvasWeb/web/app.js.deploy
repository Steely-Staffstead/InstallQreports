  function openTileDesigner(){const t=selectedTile();if(!t)return;if(t.kind==="gantt"){openGanttDesigner(t);return;}if(t.kind==="reportGrid"){window.CanvasReportGrid.openDesigner(t,{theme:()=>model.settings.theme,sources:()=>model.sources,measures:id=>(sourceById(id)?.query?.measures||[]).map(normalizeMeasure),format,apply:()=>{window.CanvasReportGrid.clearSelection(t.id);markDirty();render();}});return;}if(t.kind==="chart"){document.body.dataset.busyLabel="Opening chart editor…";const source=sourceForTile(t)||sourceById("main"),globalFilters=(source?.query?.filters||[]).filter(filter=>filter.enabled!==false).length,localFilters=(t.filters||[]).filter(filter=>filter.enabled!==false).length;if(host)post("designWebChart",{query:displayQueryForTile(t),tile:t,canvasTheme:model.settings.theme,canvasPalettes:model.settings.palettes,filterSummary:{globalFilters,localFilters}});else $("#jsonError").textContent="ChartWeb requires the Windows desktop host.";return;}if(t.kind==="table")openTableDesigner(t);if(t.kind==="matrix")openMatrixDesigner(t);}
  function bindMovablePanel(panel,handle){let drag=null;const down=event=>{if(event.button!==0||event.target.closest('button,input,select,textarea,a'))return;const rect=panel.getBoundingClientRect();panel.style.position='fixed';panel.style.left=`${rect.left}px`;panel.style.top=`${rect.top}px`;panel.style.right='auto';panel.style.bottom='auto';panel.style.margin='0';drag={startX:event.clientX,startY:event.clientY,left:rect.left,top:rect.top,width:rect.width,height:rect.height};panel.classList.add('panel-moving');event.preventDefault();},move=event=>{if(!drag)return;panel.style.left=`${Math.max(8,Math.min(drag.left+event.clientX-drag.startX,innerWidth-drag.width-8))}px`;panel.style.top=`${Math.max(8,Math.min(drag.top+event.clientY-drag.startY,innerHeight-drag.height-8))}px`;},up=()=>{if(!drag)return;drag=null;panel.classList.remove('panel-moving');};handle.addEventListener('mousedown',down);window.addEventListener('mousemove',move);window.addEventListener('mouseup',up);return()=>{drag=null;handle.removeEventListener('mousedown',down);window.removeEventListener('mousemove',move);window.removeEventListener('mouseup',up);};}
  function designerShell(kind,title){document.querySelector(".visual-designer-overlay")?.remove();const overlay=document.createElement("div");overlay.className="visual-designer-overlay";overlay.innerHTML=`<section class="visual-designer"><header><div><strong>${title}</strong><small>Web visual designer</small></div><button data-close-designer>×</button></header><div class="visual-designer-layout"><main class="designer-preview"><h3>Preview</h3><div data-designer-preview></div></main><div class="designer-splitter" data-splitter="preview" title="Drag to resize preview"></div><aside class="designer-options"><h3>Options</h3><div data-designer-options></div></aside><div class="designer-splitter" data-splitter="fields" title="Drag to resize fields"></div><aside class="designer-fields"><h3>Fields</h3><p>Choose and arrange query fields.</p><div data-designer-fields></div></aside></div><footer><button data-close-designer>Cancel</button><button class="primary" data-apply-designer>Apply design</button></footer></section>`;document.body.append(overlay);const panel=overlay.querySelector('.visual-designer');overlay.querySelectorAll("[data-close-designer]").forEach(button=>button.onclick=()=>overlay.remove());bindMovablePanel(panel,panel.querySelector(':scope>header'));bindDesignerResize(overlay);return overlay;}
  function bindDesignerResize(overlay){const layout=overlay.querySelector(".visual-designer-layout");let resizeState=null;layout.querySelectorAll("[data-splitter]").forEach(splitter=>splitter.addEventListener("pointerdown",event=>{const box=layout.getBoundingClientRect(),fields=layout.querySelector(".designer-fields").getBoundingClientRect(),options=layout.querySelector(".designer-options").getBoundingClientRect();resizeState={kind:splitter.dataset.splitter,left:box.left,fields:fields.width,options:options.width};splitter.setPointerCapture(event.pointerId);event.preventDefault();}));layout.addEventListener("pointermove",event=>{if(!resizeState)return;const collapsed=layout.classList.contains("fields-collapsed");let fields=collapsed?34:resizeState.fields,options=resizeState.options;if(resizeState.kind==="fields"&&!collapsed)fields=Math.max(180,Math.min(event.clientX-resizeState.left,layout.clientWidth-560));else if(resizeState.kind==="preview")options=Math.max(220,Math.min(event.clientX-resizeState.left-fields-(collapsed?6:12),layout.clientWidth-fields-300));layout.style.gridTemplateColumns=`${fields}px ${collapsed?0:6}px ${options}px 6px minmax(280px,1fr)`;});layout.addEventListener("pointerup",()=>resizeState=null);}
  function addDesignerFieldsCollapse(overlay,label="Fields & measures"){const layout=overlay.querySelector(".visual-designer-layout"),pane=overlay.querySelector(".designer-fields");if(!layout||!pane||pane.querySelector(".designer-fields-collapse"))return;const button=document.createElement("button");button.type="button";button.className="designer-fields-collapse";button.setAttribute("aria-expanded","true");button.title=`Collapse ${label.toLowerCase()}`;button.innerHTML=`<span aria-hidden="true">‹</span><b>${esc(label)}</b>`;pane.prepend(button);button.addEventListener("click",()=>{const collapsed=layout.classList.toggle("fields-collapsed");if(collapsed){layout.dataset.expandedGrid=layout.style.gridTemplateColumns||"";const optionWidth=Math.max(220,layout.querySelector(".designer-options").getBoundingClientRect().width);layout.style.gridTemplateColumns=`34px 0 ${optionWidth}px 6px minmax(280px,1fr)`;}else{layout.style.gridTemplateColumns=layout.dataset.expandedGrid||"";delete layout.dataset.expandedGrid;}button.setAttribute("aria-expanded",String(!collapsed));button.title=collapsed?`Expand ${label.toLowerCase()}`:`Collapse ${label.toLowerCase()}`;button.querySelector("span").textContent=collapsed?"›":"‹";});}
  function bindDesignerDrag(overlay,onDrop){overlay.querySelectorAll("[draggable][data-field]").forEach(item=>{if(item.dataset.designerDragBound)return;item.dataset.designerDragBound="1";item.addEventListener("dragstart",event=>{event.dataTransfer.effectAllowed="copyMove";event.dataTransfer.setData("text/plain",item.dataset.field);item.classList.add("dragging");});item.addEventListener("dragend",()=>item.classList.remove("dragging"));});overlay.querySelectorAll("[data-drop-zone]").forEach(zone=>{if(zone.dataset.designerDropBound)return;zone.dataset.designerDropBound="1";zone.addEventListener("dragover",event=>{event.preventDefault();zone.classList.add("drag-over");});zone.addEventListener("dragleave",()=>zone.classList.remove("drag-over"));zone.addEventListener("drop",event=>{if(event.dataTransfer.types.includes("application/x-designer-reorder"))return;event.preventDefault();zone.classList.remove("drag-over");onDrop(event.dataTransfer.getData("text/plain"),zone.dataset.dropZone);});});}
  function bindDesignerReorder(overlay,onReorder){overlay.querySelectorAll("[draggable][data-reorder-zone]").forEach(handle=>{handle.addEventListener("dragstart",event=>{event.stopPropagation();event.dataTransfer.effectAllowed="move";event.dataTransfer.setData("application/x-designer-reorder",JSON.stringify({zone:handle.dataset.reorderZone,index:+handle.dataset.reorderIndex}));handle.closest(".designer-chip,.matrix-value")?.classList.add("dragging");});handle.addEventListener("dragend",()=>handle.closest(".designer-chip,.matrix-value")?.classList.remove("dragging"));});overlay.querySelectorAll("[data-drop-zone]").forEach(zone=>zone.addEventListener("drop",event=>{const raw=event.dataTransfer.getData("application/x-designer-reorder");if(!raw)return;event.preventDefault();event.stopImmediatePropagation();zone.classList.remove("drag-over");const source=JSON.parse(raw),target=event.target.closest("[data-reorder-index]"),targetZone=zone.dataset.dropZone,targetIndex=target?+target.dataset.reorderIndex:Number.MAX_SAFE_INTEGER;if(source.zone!==targetZone&&overlay._crossZoneReorder)overlay._crossZoneReorder(source.zone,source.index,targetZone,targetIndex);else if(source.zone===targetZone)onReorder(source.zone,source.index,targetIndex);}));}
  const formatChoices=["Auto","N0","N1","N2","P0","P1","P2","K0","K1","M0","M1","yyyy-MM-dd","MMM yyyy","Custom"];
  const matrixValueMissing=value=>value==null||value===""||(typeof value==="number"&&!Number.isFinite(value))||/^nan$/i.test(String(value).trim());
  const matrixValueText=(value,column)=>esc(matrixValueMissing(value)?(column.missingText??""):format(value,column.format||column.Format||"Auto"));
  function matrixVisualCell(value,column,row,columns,maxAbs=1,rowKind="detail"){
    if(matrixValueMissing(value))return esc(column.missingText??"");
    return matrixConditionalCell(value,column,row,columns,maxAbs,visualCell(value,column,row,columns,maxAbs,rowKind));
  }
  function matrixConditionalCell(value,column,row,fields,range,content){
    const rule=column.conditional||{},color=value=>/^#[0-9a-f]{6}$/i.test(value||'')?value:null,styles=[],numeric=value!==null&&value!==undefined&&value!==''?Number(value):NaN;
    if(color(rule.textColor))styles.push(`color:${rule.textColor}`);
    if(rule.negativeText&&Number.isFinite(numeric)&&numeric<0)styles.push(`color:${CanvasTheme.roles(model.settings.theme).negative}`);
    if(color(rule.backgroundColor))styles.push(`background-color:${rule.backgroundColor}`);
    if(rule.bold)styles.push('font-weight:700');if(rule.italic)styles.push('font-style:italic');if(rule.underline)styles.push('text-decoration:underline');
    let strengthColor='';
    if((rule.strength||rule.badgeStrength)&&Number.isFinite(numeric)&&Number.isFinite(range.minimum)&&Number.isFinite(range.maximum)){
      const low=color(rule.lowColor)||'#f1f5ff',high=color(rule.highColor)||'#536ee1',amount=Math.max(0,Math.min(1,(numeric-range.minimum)/(range.maximum-range.minimum||1))),channel=index=>Math.round(parseInt(low.slice(index,index+2),16)*(1-amount)+parseInt(high.slice(index,index+2),16)*amount).toString(16).padStart(2,'0');strengthColor=`#${channel(1)}${channel(3)}${channel(5)}`;
      if(rule.strength)styles.push(`background-color:${strengthColor}`);
      if(rule.badgeStrength)styles.push(`--matrix-badge-strength:${strengthColor}`);
    }
    let icon='';
    if(rule.iconType&&rule.iconType!=='None'&&Number.isFinite(numeric)){
      const source=rule.compareMode==='measure'?row[fields.indexOf(rule.compareField)]:rule.threshold,comparison=source===null||source===undefined||source===''?NaN:Number(source),symbol={Arrows:['↓','↑'],Triangles:['▼','▲'],Circles:['●','●'],Status:['✕','✓']}[rule.iconType]||['↓','↑'];
      if(Number.isFinite(comparison)){const good=numeric>=comparison;icon=`<span class="matrix-conditional-icon" aria-label="${good?'At or above':'Below'} target" style="color:${good?(color(rule.goodColor)||'#16844a'):(color(rule.badColor)||'#c43d4b')}">${symbol[good?1:0]}</span>`;}
    }
    const hasIconSlot=rule.iconType&&rule.iconType!=='None'&&Number.isFinite(numeric);
    if(!styles.length&&!hasIconSlot)return content;
    const iconRight=rule.iconPosition==="right",iconSlot=icon||'<span class="matrix-conditional-icon matrix-conditional-icon-empty" aria-hidden="true"></span>',classes=['matrix-conditional-cell',hasIconSlot?(iconRight?'matrix-conditional-icon-right':'matrix-conditional-icon-left'):'',rule.badgeStrength?'matrix-conditional-badge-strength':''].filter(Boolean).join(' '),body=`<span class="matrix-conditional-content">${content}</span>`;
    return `<span class="${classes}" style="${styles.join(';')}">${hasIconSlot?(iconRight?body+iconSlot:iconSlot+body):body}</span>`;
  }
  function matrixConditionalPropertiesHtml(selected,fields){if(!selected)return '';const rule=selected.conditional||{},isBadge=(selected.renderer?.type||selected.Renderer?.type)==='Badge';return `<details class="matrix-conditional-options"><summary>Conditional formatting</summary><small>Applies to this value column in tables and matrices. Strength colors use the visible value range.</small><label class="check"><input data-conditional="negativeText" type="checkbox" ${rule.negativeText?'checked':''}> Color negative values with the theme negative color</label><div class="two-cols"><label>Text color<input data-conditional="textColor" type="color" value="${rule.textColor||'#182230'}"></label><label>Background color<input data-conditional="backgroundColor" type="color" value="${rule.backgroundColor||'#ffffff'}"></label></div><div class="two-cols"><label class="check"><input data-conditional="bold" type="checkbox" ${rule.bold?'checked':''}> Bold</label><label class="check"><input data-conditional="italic" type="checkbox" ${rule.italic?'checked':''}> Italic</label><label class="check"><input data-conditional="underline" type="checkbox" ${rule.underline?'checked':''}> Underline</label></div><label class="check"><input data-conditional="strength" type="checkbox" ${rule.strength?'checked':''}> Color background by value strength</label>${isBadge?`<label class="check"><input data-conditional="badgeStrength" type="checkbox" ${rule.badgeStrength?'checked':''}> Color badge by value strength</label>`:''}<div class="two-cols"><label>Low color<input data-conditional="lowColor" type="color" value="${rule.lowColor||'#f1f5ff'}"></label><label>High color<input data-conditional="highColor" type="color" value="${rule.highColor||'#536ee1'}"></label></div><div class="two-cols"><label>Icon set<select data-conditional="iconType">${['None','Arrows','Triangles','Circles','Status'].map(value=>`<option value="${value}" ${value===(rule.iconType||'None')?'selected':''}>${value}</option>`).join('')}</select></label><label>Icon position<select data-conditional="iconPosition"><option value="left" ${rule.iconPosition!=='right'?'selected':''}>Left</option><option value="right" ${rule.iconPosition==='right'?'selected':''}>Right</option></select></label></div><label>Compare to<select data-conditional="compareMode"><option value="fixed" ${rule.compareMode!=='measure'?'selected':''}>Fixed value</option><option value="measure" ${rule.compareMode==='measure'?'selected':''}>Measure / value column</option></select></label><label>Fixed threshold<input data-conditional="threshold" type="number" step="any" value="${Number(rule.threshold)||0}"></label><label>Comparison measure<select data-conditional="compareField"><option value="">Select measure</option>${fields.map(field=>`<option value="${esc(field)}" ${field===rule.compareField?'selected':''}>${esc(field)}</option>`).join('')}</select></label><div class="two-cols"><label>At / above icon color<input data-conditional="goodColor" type="color" value="${rule.goodColor||'#16844a'}"></label><label>Below icon color<input data-conditional="badColor" type="color" value="${rule.badColor||'#c43d4b'}"></label></div></details>`;}
  function bindMatrixConditionalProperties(options,selected,refresh){options.querySelectorAll('[data-conditional]').forEach(input=>input.addEventListener('change',()=>{selected.conditional||={};selected.conditional[input.dataset.conditional]=input.type==='checkbox'?input.checked:input.value;refresh();}));}
  function dataBarColors(bar){return bar.useThemeColors===true?{color:canvasPaletteColor(0),negativeColor:CanvasTheme.roles(model.settings.theme).negative,backgroundColor:blendCanvasColor(canvasPaletteColor(0),.16),targetColor:canvasPaletteColor(1)}:{color:bar.color||'#4f8bd6',negativeColor:bar.negativeColor||'#d95c5c',backgroundColor:bar.backgroundColor||'#d8e0eb',targetColor:bar.targetColor||'#111827'};}
  function cellRendererColor(renderer,numeric){const roles=CanvasTheme.roles(model.settings.theme),mode=renderer.colorMode||"theme";if(mode==="status")return Number.isFinite(numeric)&&numeric<0?roles.negative:roles.positive;if(mode==="custom"&&/^#[0-9a-f]{6}$/i.test(renderer.color||""))return renderer.color;return roles[renderer.themeRole||"accent"]||roles.accent;}
  function visualCell(value,column,row,columns,maxAbs=1,rowKind="detail"){const formatted=esc(format(value,column.format||column.Format||"Auto")),renderer=column.renderer||column.Renderer||{},rendererType=renderer.type||"Number",numeric=Number(value),rendererColor=cellRendererColor(renderer,numeric);if(rendererType==="Badge"){const shape=["pill","rounded","square","circle"].includes(renderer.shape)?renderer.shape:"pill";return `<span class="cell-renderer-badge cell-renderer-${shape}" style="--cell-renderer-color:${rendererColor}">${formatted}</span>`;}if(rendererType==="Icon"){const icon={Circle:"●",Check:"✓",Warning:"▲",Up:"↑",Down:"↓",Diamond:"◆"}[renderer.icon]||"●",valueText=renderer.showValue===false?"":`<b>${formatted}</b>`,iconText=`<i>${icon}</i>`;return `<span class="cell-renderer-icon ${renderer.iconPosition==="right"?"cell-renderer-icon-right":""}" style="--cell-renderer-color:${rendererColor}" aria-label="${formatted}">${renderer.iconPosition==="right"?valueText+iconText:iconText+valueText}</span>`;}const bar={...(column.bar||column.Bar||{})};if(rendererType==="DataBar"&&(!bar.type||bar.type==="None"))bar.type="DataBar";const scope=bar.scope||"GroupsAndDetail",wrongScope=(scope==="Groups"&&rowKind!=="group")||(scope==="Detail"&&rowKind!=="detail"),comparisonIndex=columns.indexOf(bar.comparisonField),backgroundIndex=columns.indexOf(bar.backgroundField),comparison=comparisonIndex>=0?Number(row[comparisonIndex]):NaN,background=backgroundIndex>=0?Number(row[backgroundIndex]):NaN;if(!bar.type||bar.type==="None"||wrongScope||!Number.isFinite(numeric))return formatted;const colors=dataBarColors(bar),range=typeof maxAbs==="object"&&maxAbs?maxAbs:{minimum:-Math.abs(Number(maxAbs)||1),maximum:Math.abs(Number(maxAbs)||1)},minimum=Math.min(0,Number(range.minimum)||0),maximum=Math.max(0,Number(range.maximum)||0),span=Math.max(1e-12,maximum-minimum),zero=Math.max(0,Math.min(100,-minimum/span*100)),automaticWidth=Math.min(100,Math.abs(numeric)/span*100),width=Number.isFinite(background)?Math.min(100,Math.abs(numeric)/(Math.abs(background)||1)*100):automaticWidth,color=numeric<0?colors.negativeColor:colors.color,align=bar.alignment||"Left",position=Number.isFinite(background)?(align==="Right"?`right:0`:align==="Center"?`left:${50-width/2}%`:`left:0`):numeric<0?`left:${Math.max(0,zero-width)}%`:`left:${zero}%`;if(bar.type==="Bullet"){const scale=Math.max(Math.abs(minimum),Math.abs(maximum),1),target=Number.isFinite(comparison)?Math.min(100,Math.abs(comparison)/scale*100):0;return `<span class="cell-visual bullet-cell"><i class="bullet-background" style="width:${Number.isFinite(background)?100:width}%;background:${colors.backgroundColor}"></i><i class="bullet-value" style="width:${width}%;background:${color}"></i><i class="bullet-target" style="left:${target}%;background:${colors.targetColor};width:${bar.targetThickness||3}px"></i><b>${formatted}</b></span>`;}const axis=!Number.isFinite(background)&&minimum<0&&maximum>0?`<em class="data-bar-zero" style="left:${zero}%"></em>`:"";return `<span class="cell-visual">${axis}<i style="${position};width:${width}%;background:${color}"></i><b>${formatted}</b></span>`;}
  function cellRendererPropertiesHtml(selected){if(!selected)return"";const renderer=selected.renderer||={},type=renderer.type||"Number",roleOptions=["accent","positive","negative","color1","color2","color3","color4"].map(role=>`<option value="${role}" ${renderer.themeRole===role?"selected":""}>${esc(role)}</option>`).join("");return `<details class="cell-renderer-options" open><summary>Cell display</summary><label>Renderer<select data-cell-renderer="type">${["Number","Badge","Icon","DataBar"].map(value=>`<option ${type===value?"selected":""}>${value}</option>`).join("")}</select></label>${type==="Badge"?`<label>Badge shape<select data-cell-renderer="shape">${[["pill","Pill"],["rounded","Rounded"],["square","Square"],["circle","Circle"]].map(([value,label])=>`<option value="${value}" ${renderer.shape===value?"selected":""}>${label}</option>`).join("")}</select></label>`:""}${type==="Icon"?`<label>Icon<select data-cell-renderer="icon">${["Circle","Check","Warning","Up","Down","Diamond"].map(value=>`<option ${renderer.icon===value?"selected":""}>${value}</option>`).join("")}</select></label><label>Icon position<select data-cell-renderer="iconPosition"><option value="left" ${renderer.iconPosition!=="right"?"selected":""}>Left</option><option value="right" ${renderer.iconPosition==="right"?"selected":""}>Right</option></select></label><label class="check"><input type="checkbox" data-cell-renderer="showValue" ${renderer.showValue!==false?"checked":""}> Show value</label>`:""}${["Badge","Icon"].includes(type)?`<label>Color source<select data-cell-renderer="colorMode"><option value="theme" ${renderer.colorMode!=="custom"&&renderer.colorMode!=="status"?"selected":""}>Theme role</option><option value="status" ${renderer.colorMode==="status"?"selected":""}>Positive / negative</option><option value="custom" ${renderer.colorMode==="custom"?"selected":""}>Custom</option></select></label>${renderer.colorMode==="custom"?`<label>Color<input type="color" data-cell-renderer="color" value="${renderer.color||"#4f6ee8"}"></label>`:`<label>Theme role<select data-cell-renderer="themeRole">${roleOptions}</select></label>`}`:""}${type==="DataBar"?'<p class="property-empty">Configure colors and comparison in Data bar / bullet graph below.</p>':""}</details>`;}
  function bindCellRenderer(container,selected,refresh,redraw=refresh){container.querySelectorAll("[data-cell-renderer]").forEach(input=>input.addEventListener("change",()=>{selected.renderer||={};selected.renderer[input.dataset.cellRenderer]=input.type==="checkbox"?input.checked:input.value;if(input.dataset.cellRenderer==="type")redraw();else refresh();}));}
  function dataBarPropertiesHtml(selected,fields){if(!selected)return "";const bar=selected.bar||={type:"None",alignment:"Left",scope:"GroupsAndDetail",color:"#4f8bd6",negativeColor:"#d95c5c",useThemeColors:true,comparisonField:"",backgroundField:"",backgroundColor:"#d8e0eb",targetColor:"#111827",targetThickness:3};const colors=dataBarColors(bar),theme=bar.useThemeColors===true,disabled=theme?"disabled":"";return `<details class="column-bars"><summary>Data bar / bullet graph</summary><label class="check"><input data-bar="useThemeColors" type="checkbox" ${theme?"checked":""}> Use canvas theme colors</label><label>Bar type<select data-bar="type">${[["None","None"],["DataBar","Data bar"],["Bullet","Bullet graph"]].map(([value,label])=>`<option value="${value}" ${value===bar.type?"selected":""}>${label}</option>`).join("")}</select></label><div class="two-cols"><label>Alignment<select data-bar="alignment">${["Left","Center","Right"].map(value=>`<option ${value===bar.alignment?"selected":""}>${value}</option>`).join("")}</select></label><label>Draw bars on<select data-bar="scope">${[["GroupsAndDetail","Groups and detail"],["Groups","Groups only"],["Detail","Detail only"]].map(([value,label])=>`<option value="${value}" ${value===bar.scope?"selected":""}>${label}</option>`).join("")}</select></label><label>Bar color<input data-bar="color" type="color" value="${colors.color}" ${disabled}></label><label>Negative color<input data-bar="negativeColor" type="color" value="${colors.negativeColor}" ${disabled}></label></div><label>Comparison measure<select data-bar="comparisonField"><option value="">None</option>${fields.map(value=>`<option ${value===bar.comparisonField?"selected":""}>${esc(value)}</option>`).join("")}</select></label><label>Background measure<select data-bar="backgroundField"><option value="">Automatic</option>${fields.map(value=>`<option ${value===bar.backgroundField?"selected":""}>${esc(value)}</option>`).join("")}</select></label><div class="two-cols"><label>Backcolor<input data-bar="backgroundColor" type="color" value="${colors.backgroundColor}" ${disabled}></label><label>Target color<input data-bar="targetColor" type="color" value="${colors.targetColor}" ${disabled}></label><label>Target thickness<input data-bar="targetThickness" type="number" min="1" max="12" value="${bar.targetThickness}"></label></div></details>`;}
  function columnPropertiesHtml(selected,fields,includeBars=true,includeMissing=false,groupBasics=false){if(!selected)return "";const current=selected.format||"Auto",preset=formatChoices.includes(current)?current:"Custom",custom=preset==="Custom"?current:"#,##0.0",basic=`<label>Caption<input data-column-caption value="${esc(selected.caption||selected.field)}"></label><label>Format<select data-column-format>${formatChoices.map(value=>`<option ${value===preset?"selected":""}>${value}</option>`).join("")}</select></label><label data-custom-format-wrap class="${preset==="Custom"?"":"hidden"}">Custom format<input data-column-custom-format value="${esc(custom)}"><small data-format-preview>Preview: ${esc(format(1234567.89,custom))}</small></label><label>Alignment<select data-column-align>${["Auto","Left","Center","Right"].map(value=>`<option ${value===(selected.align||"Auto")?"selected":""}>${value}</option>`).join("")}</select></label>${includeMissing?`<label>Missing / NaN text<input data-column-missing-text value="${esc(selected.missingText??"")}" placeholder="Blank"></label>`:""}`;return `${groupBasics?`<section class="matrix-value-basics"><h4>Value and number format</h4>${basic}</section>`:basic}${cellRendererPropertiesHtml(selected)}${includeBars?dataBarPropertiesHtml(selected,fields):""}`;}
  function bindColumnFormat(container,selected,refreshPreview){const select=container.querySelector("[data-column-format]"),wrap=container.querySelector("[data-custom-format-wrap]"),custom=container.querySelector("[data-column-custom-format]"),preview=container.querySelector("[data-format-preview]");if(!select)return;const apply=()=>{const isCustom=select.value==="Custom";wrap?.classList.toggle("hidden",!isCustom);selected.format=isCustom?(custom?.value||"#,##0.0"):select.value;if(preview)preview.textContent=`Preview: ${format(1234567.89,selected.format)}`;refreshPreview();};select.addEventListener("change",apply);custom?.addEventListener("input",apply);}
  function sortDesignerHtml(sorts,fields){return `<section class="sort-designer"><h4>Advanced ordering</h4><small>Columns are applied from top to bottom.</small>${sorts.map((sort,index)=>`<div class="sort-row"><span>${index+1}</span><select data-sort-field="${index}">${fields.map(field=>`<option ${field===sort.field?"selected":""}>${esc(field)}</option>`).join("")}</select><select data-sort-direction="${index}"><option value="asc" ${sort.direction!=="desc"?"selected":""}>Ascending</option><option value="desc" ${sort.direction==="desc"?"selected":""}>Descending</option></select><button data-sort-up="${index}" title="Higher priority">↑</button><button data-sort-down="${index}" title="Lower priority">↓</button><button data-sort-remove="${index}" title="Remove">×</button></div>`).join("")}<button data-sort-add>+ Add ordering</button></section>`;}
  function bindSortDesigner(container,sorts,fields,redraw){container.querySelector("[data-sort-add]")?.addEventListener("click",()=>{const field=fields.find(name=>!sorts.some(sort=>sort.field===name))||fields[0];if(field){sorts.push({field,direction:"asc"});redraw();}});container.querySelectorAll("[data-sort-field]").forEach(input=>input.onchange=()=>{sorts[+input.dataset.sortField].field=input.value;redraw();});container.querySelectorAll("[data-sort-direction]").forEach(input=>input.onchange=()=>{sorts[+input.dataset.sortDirection].direction=input.value;redraw();});container.querySelectorAll("[data-sort-remove]").forEach(button=>button.onclick=()=>{sorts.splice(+button.dataset.sortRemove,1);redraw();});container.querySelectorAll("[data-sort-up]").forEach(button=>button.onclick=()=>{const i=+button.dataset.sortUp;if(i>0)[sorts[i-1],sorts[i]]=[sorts[i],sorts[i-1]];redraw();});container.querySelectorAll("[data-sort-down]").forEach(button=>button.onclick=()=>{const i=+button.dataset.sortDown;if(i<sorts.length-1)[sorts[i+1],sorts[i]]=[sorts[i],sorts[i+1]];redraw();});}
