    const focusGanttDesignerArea=key=>{
      let target=key==="timeline"?[...options.querySelectorAll("details")].find(section=>section.querySelector(":scope > summary")?.textContent==="Timeline"):options.querySelector(`[data-gantt-format-target="${key}"],${key==="dependency"?'[data-gantt-dependency-format]':key==="label"?'[data-gantt-label-format]':'[data-gantt-format-target="missing"]'}`);
      if(!target)return;
