  function rankFilters(...sets){return sets.flatMap(filters=>filters||[]).filter(f=>f?.enabled!==false&&f?.column&&(f.mode==="TopRows"||f.mode==="BottomRows"));}
  function rankRows(rows,columns,filters){let result=[...rows];for(const f of filters||[]){const index=columns.findIndex(name=>String(name).toLowerCase()===String(f.column).toLowerCase());if(index<0)continue;const values=[...new Map(result.map(row=>row[index]).filter(value=>value!=null&&String(value).trim()!=="").map(value=>[String(value),value])).values()];values.sort((a,b)=>compareValues(a,b)*(f.mode==="TopRows"?-1:1));const selected=new Set(values.slice(0,Math.max(1,Math.floor(+f.n||10))).map(String));result=result.filter(row=>selected.has(String(row[index])));}return result;}
