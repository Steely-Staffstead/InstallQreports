    options.addEventListener("change",event=>{const storage=event.target.closest("[data-gantt-storage]");if(storage){draft.dataStorage=storage.value;if(storage.value==="embedded")ensureEmbeddedData();else draft.publishAsSource=false;drawOptions();return;}const source=event.target.closest("[data-gantt-source]");if(source){sourceId=source.value;sourceData=displayQueryForTile({...tile,sourceId}).data||{columns:[],rows:[]};Object.assign(draft,window.CanvasGantt.autoConfigure({...draft,task:"",id:"",group:"",owner:"",start:"",end:"",progress:"",status:"",milestone:"",dependsOn:""},sourceData.columns||[]));drawOptions();return;}const appearanceInput=event.target.closest("[data-gantt-appearance-scope]");if(appearanceInput){const scope=appearanceInput.dataset.ganttAppearanceScope,property=appearanceInput.dataset.ganttAppearanceProperty;formatOpen=appearanceInput.closest("details")?.open===true;draft.appearance||={};draft.appearance[scope]||={};draft.appearance[scope][property]=appearanceInput.type==="checkbox"?appearanceInput.checked:appearanceInput.type==="number"?+appearanceInput.value:appearanceInput.value;refresh();return;}const listMode=event.target.closest("[data-gantt-list-mode]");if(listMode){const key=listMode.dataset.ganttListMode;registryOpen[key]=listMode.closest("details")?.open===true;draft[`${key}ListMode`]=listMode.checked;refresh();return;}const optionInput=event.target.closest("[data-gantt-option-property]");if(optionInput){const row=optionInput.closest("[data-gantt-option-row]"),key=row.dataset.ganttOptionRow,list=draft[`${key}Options`],item=list?.[+row.dataset.index];registryOpen[key]=row.closest("details")?.open===true;if(item)item[optionInput.dataset.ganttOptionProperty]=optionInput.type==="checkbox"?optionInput.checked:optionInput.type==="number"?+optionInput.value:optionInput.value;refresh();return;}const progressDisplay=event.target.closest("[data-gantt-progress-display]");if(progressDisplay){draft.progressDisplay=progressDisplay.value;refresh();ret