  function powerPointTextParagraphs(content){
    if(!content)return [];
    const blocks=[...content.querySelectorAll('p,div,li,h1,h2,h3,h4,h5,h6')]
      .filter(element=>element.tagName!=='DIV'||!element.querySelector('p,li,h1,h2,h3,h4,h5,h6'));
    const paragraphs=[];
    for(const block of blocks.length?blocks:[content]){
      const runs=[];
      const walk=node=>{
        if(node.nodeType===Node.TEXT_NODE){
          if(!node.nodeValue)return;
          const style=getComputedStyle(node.parentElement||block);
          runs.push({text:node.nodeValue,fontFamily:style.fontFamily.split(',')[0].replaceAll('"','').trim(),fontSize:parseFloat(style.fontSize)||14,color:style.color,bold:Number(style.fontWeight)>=600||style.fontWeight==='bold',italic:style.fontStyle==='italic',underline:style.textDecorationLine.includes('underline')});
          return;
        }
        if(node.nodeType!==Node.ELEMENT_NODE)return;
        if(node.tagName==='BR'){runs.push({text:'\n'});return;}
        if(block.tagName==='LI'&&/^(UL|OL)$/.test(node.tagName))return;
        node.childNodes.forEach(walk);
      };
      block.childNodes.forEach(walk);
      const style=getComputedStyle(block);
      if(block.tagName==='LI'){
        const parent=block.parentElement,marker=parent?.tagName==='OL'?`${[...parent.children].indexOf(block)+1}. `:'• ';
        runs.unshift({text:marker,fontFamily:style.fontFamily.split(',')[0].replaceAll('"','').trim(),fontSize:parseFloat(style.fontSize)||14,color:style.color});
      }
      paragraphs.push({alignment:style.textAlign,runs});
    }
    return paragraphs;
  }
