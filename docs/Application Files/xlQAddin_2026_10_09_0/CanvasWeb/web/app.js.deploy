d==="picture"?'<button data-tile-command="compress">Compress picture…</button>':""}<button class="danger" data-tile-command="delete">Delete</button>`;document.body.append(menu);if(t.kind==="picture")menu.prepend(menu.querySelector('[data-tile-command="compress"]'));menu.style.left=`${Math.max(8,Math.min(x,innerWidth-menu.offsetWidth-8))}px`;menu.style.top=`${Math.max(8,Math.min(y,innerHeight-menu.offsetHeight-8))}px`;menu.addEventListener("click",event=>{const movePage=event.target.closest("[data-move-page]");if(movePage){moveSelectionToPage(+movePage.dataset.movePage);menu.remove();return;}const command=event.target.closest("[data-tile-command]")?.dataset.tileCommand;if(!command)return;menu.remove();if(command==="edit")focusFormattedText(t);if(command==="compress")openPictureCompression();if(command==="design")openTileDesigner();if(["front","forward","backward","back"].includes(command))setLayer(command);if(command==="duplicate")duplicateTile();if(command==="saveComponent")saveSelectedComponent();if(command==="duplicateConnected")duplicateTile(true);if(command==="duplicateChild")duplicateConnectorAsChild(childConnectors[Math.floor(Math.random()*childConnectors.length)]?.id);if(command==="reverse")reverseConnector(t);if(command==="delete")deleteTile();});}
  function renderTextPadding(){
    let control=$("#textPaddingControl"),alignment=$("#textVerticalAlignControl"),rounding=$("#textRoundingControl");
    if(!control){control=document.createElement("div");control.id="textPaddingControl";control.innerHTML='<label>Vertical text padding<input data-text-style="paddingY" type="number" min="0" max="80" step="2"></label>';$("#textTileFont")?.append(control);control.addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="text")return;t.paddingY=Math.max(0,Math.min(80,+event.target.value||0));markDirty();render();});}
    if(!alignment){alignment=document.createElement("label");alignment.id="textVerticalAlignControl";alignment.innerHTML='Whole text vertical alignment<select><option value="top">Top</option><option value="middle">Middle</option><option value="bottom">Bottom</option></select>';$("#richTextGroup")?.append(alignment);alignment.querySelector("select").addEventListener("change",event=>{const t=selectedTile();if(!["text","graphicText"].includes(t?.kind))return;t.verticalAlign=event.target.value;markDirty();render();});}
    if(!rounding){rounding=document.createElement("label");rounding.id="textRoundingControl";rounding.innerHTML='Corner rounding %<input type="number" min="0" max="50" step="1">';$("#tileBackground")?.closest("label")?.before(rounding);rounding.addEventListener("change",event=>{const t=selectedTile();if(!t||graphicKinds.has(t.kind))return;t.rounding=Math.max(0,Math.min(50,+event.target.value||0));markDirty();render();});}
    const t=selectedTile(),rich=["text","graphicText"].includes(t?.kind),roundedTile=t&&!graphicKinds.has(t.kind);
    $("#textBodySettings")?.classList.toggle("hidden",!rich);control.classList.toggle("hidden",t?.kind!=="text");alignment.classList.toggle("hidden",!rich);rounding.classList.toggle("hidden",!roundedTile);
    if(t?.kind==="text")control.querySelector("input").value=t.paddingY??6;if(rich)alignment.querySelector("select").value=["top","middle","bottom"].includes(t.verticalAlign)?t.verticalAlign:"top";if(roundedTile)rounding.querySelector("input").value=t.rounding??0;if($("#designTileButton b"))$("#designTileButton b").textContent=t?.kind==="reportGrid"?"View grid codes":"Design";
  }
  function renderPictureProperties(){let control=$("#pictureProperties");if(!control){control=document.createElement("details");control.id="pictureProperties";control.innerHTML='<summary>Image settings</summary><label>Image sizing<select data-picture="imageSizing"><option value="fit">Fit to window (whole image)</option><option value="width">Fill width</option><option value="height">Fill height</option></select></label><label class="check"><input data-picture="hideScrollbars" type="checkbox"> Hide scrollbars</label><label class="check"><input data-picture="transparentBackground" type="checkbox"> Transparent background</label><button type="button" data-compress-picture>Compress image…</button><small class="picture-compress-hint">Reduce the pixels stored in this canvas file.</small>';$("#tileProperties")?.append(control);$("#tileProperties")?.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.picture;if(t?.kind!=="picture"||!key)return;t[key]=event.target.type==="checkbox"?event.target.checked:event.target.value;markDirty();render();});control.querySelector('[data-compress-picture]').addEventListener('click',openPictureCompression);}const t=selectedTile();control.classList.toggle("hidden",t?.kind!=="picture");control.querySelector('[data-compress-picture]').disabled=!t?.text?.startsWith('data:image/');const transparent=$("#tileProperties")?.querySelector('[data-picture="transparentBackground"]');transparent?.closest("label")?.classList.toggle("hidden",t?.kind!=="picture");if(t?.kind==="picture")$("#tileProperties").querySelectorAll('[data-picture]').forEach(input=>{if(input.type==="checkbox")input.checked=!!t[input.dataset.picture];else input.value=t[input.dataset.picture]||"width";});}
  function openPictureCompression(){
    const tile=selectedTile();
    if(tile?.kind!=="picture"||!tile.text?.startsWith("data:image/"))return;
    let dialog=$("#pictureCompressDialog");
    if(!dialog){
      dialog=document.createElement("dialog");dialog.id="pictureCompressDialog";dialog.className="picture-compress-dialog";
      dialog.innerHTML='<form method="dialog"><h2>Compress picture</h2><p class="picture-compress-intro">The picture changes only when you click Apply. Keep the original elsewhere if you may need full resolution later.</p><div class="picture-compress-controls"><label>Resolution<select data-compress-resolution><option value="1">Display size (smallest)</option><option value="2">2× display size (sharper)</option><option value="original">Original pixels</option></select></label><label>Format<select data-compress-format><option value="image/webp">WebP (smallest)</option><option value="image/jpeg">JPEG (photo)</option><option value="image/png">PNG (lossless)</option></select></label><label>Quality <output data-compress-quality-value>70%</output><input data-compress-quality type="range" min="35" max="95" value="70"></label></div><div class="picture-compress-previews"><figure><div class="picture-crop-surface"><img data-compress-original alt="Original image preview"><div data-crop-selection hidden></div></div><figcaption data-compress-original-label></figcaption></figure><figure><img data-compress-preview alt="Compressed image preview"><figcaption data-compress-preview-label></figcaption></figure></div><div class="picture-crop-controls"><span>Drag on the original to keep an area.</span><button type="button" data-crop-reset>Reset crop</button></div><p data-compress-estimate role="status"></p><p data-compress-error class="error" role="alert"></p><div class="picture-compress-actions"><button value="cancel">Cancel</button><button type="button" data-compress-apply class="primary" disabled>Apply compressed image</button></div></form>';
      document.body.append(dialog);
    }
    const sourceText=tile.text,sourceId=tile.id,originalBytes=Math.floor((sourceText.split(',')[1]||'').length*3/4);
    const originalImage=dialog.querySelector('[data-compress-original]'),previewImage=dialog.querySelector('[data-compress-preview]'),estimate=dialog.querySelector('[data-compress-estimate]'),error=dialog.querySelector('[data-compress-error]'),apply=dialog.querySelector('[data-compress-apply]');
    const resolution=dialog.querySelector('[data-compress-resolution]'),format=dialog.querySelector('[data-compress-format]'),quality=dialog.querySelector('[data-compress-quality]');
    const defaults=window.QReportsSettings?.get()||{};
    resolution.value=defaults.pastedImageResolution||'1';format.value=defaults.pastedImageFormat||'image/webp';quality.value=String(defaults.pastedImageQuality||70);
    originalImage.src=sourceText;previewImage.removeAttribute('src');error.textContent='';apply.disabled=true;
    const readable=bytes=>bytes<1024?`${bytes} B`:`${(bytes/1024).toFixed(bytes<10240?1:0)} KB`;
    dialog.querySelector('[data-compress-original-label]').textContent=`Original · ${readable(originalBytes)}`;
    const cropSurface=dialog.querySelector('.picture-crop-surface'),cropSelection=dialog.querySelector('[data-crop-selection]'),resetCrop=dialog.querySelector('[data-crop-reset]');
    let candidate='',candidateSize=null,generation=0,crop=null,dragStart=null;
    const cropGeometry=()=>{const box=originalImage.getBoundingClientRect(),scale=Math.min(box.width/originalImage.naturalWidth,box.height/originalImage.naturalHeight),width=originalImage.naturalWidth*scale,height=originalImage.naturalHeight*scale;return {left:(box.width-width)/2,top:(box.height-height)/2,width,height};};
    const cropPoint=event=>{const rect=originalImage.getBoundingClientRect(),geometry=cropGeometry();return{x:Math.max(0,Math.min(1,(event.clientX-rect.left-geometry.left)/geometry.width)),y:Math.max(0,Math.min(1,(event.clientY-rect.top-geometry.top)/geometry.height))};};
    const showCrop=()=>{cropSelection.hidden=!crop;resetCrop.disabled=!crop;if(!crop||!originalImage.naturalWidth)return;const box=cropGeometry();Object.assign(cropSelection.style,{left:`${box.left+crop.x*box.width}px`,top:`${box.top+crop.y*box.height}px`,width:`${crop.width*box.width}px`,height:`${crop.height*box.height}px`});};
    const refresh=async()=>{
      const current=++generation;candidate='';candidateSize=null;apply.disabled=true;error.textContent='';
      dialog.querySelector('[data-compress-quality-value]').textContent=`${quality.value}%`;
      estimate.textContent='Preparing preview…';
      try{
        if(!originalImage.complete||!originalImage.naturalWidth)await originalImage.decode();
        if(current!==generation||!dialog.open)return;
        showCrop();
        const naturalWidth=originalImage.naturalWidth,naturalHeight=originalImage.naturalHeight;
        const compressed=await compressImageData(originalImage,tile.width,tile.height,{resolution:resolution.value,format:format.value,quality:quality.value,crop});
        if(current!==generation||!dialog.open)return;
        candidate=compressed.dataUrl;candidateSize=compressed;previewImage.src=compressed.dataUrl;
        const saved=originalBytes-compressed.bytes,percent=Math.max(0,Math.round(100*saved/originalBytes));
        dialog.querySelector('[data-compress-original-label]').textContent=`Original · ${naturalWidth} × ${naturalHeight} · ${readable(originalBytes)}`;
        dialog.querySelector('[data-compress-preview-label]').textContent=`${crop?'Cropped + compressed':'Compressed'} · ${compressed.width} × ${compressed.height} · ${readable(compressed.bytes)}`;
        estimate.textContent=`Picture size: ${readable(originalBytes)} → ${readable(compressed.bytes)}. Reduction: ${saved>0?`${percent}% (${readable(saved)})`:'none with these settings'}.`;
        apply.disabled=saved<=0;
      }catch(reason){if(current===generation){error.textContent=reason.message||String(reason);estimate.textContent='';}}
    };
    const changed=()=>{void refresh();};
    resolution.addEventListener('change',changed);format.addEventListener('change',changed);quality.addEventListener('input',changed);
    const startCrop=event=>{if(!originalImage.naturalWidth)return;event.preventDefault();dragStart=cropPoint(event);crop=null;cropSurface.setPointerCapture(event.pointerId);showCrop();};
    const moveCrop=event=>{if(!dragStart)return;const point=cropPoint(event),x=Math.min(point.x,dragStart.x),y=Math.min(point.y,dragStart.y);crop={x,y,width:Math.abs(point.x-dragStart.x),height:Math.abs(point.y-dragStart.y)};showCrop();};
    const endCrop=event=>{if(!dragStart)return;moveCrop(event);dragStart=null;if(crop.width<.02||crop.height<.02)crop=null;showCrop();void refresh();};
    cropSurface.addEventListener('pointerdown',startCrop);cropSurface.addEventListener('pointermove',moveCrop);cropSurface.addEventListener('pointerup',endCrop);cropSurface.addEventListener('pointercancel',endCrop);
    resetCrop.onclick=()=>{crop=null;showCrop();void refresh();};showCrop();
    window.addEventListener('resize',showCrop);
    apply.onclick=()=>{const active=selectedTile();if(!candidate||active?.id!==sourceId||active.text!==sourceText)return;active.text=candidate;active.imageFileName=`${tile.imageFileName||'Picture'} (${crop?'cropped, ':''}compressed)`;if(crop&&candidateSize)active.height=Math.max(30,Math.round(active.width*candidateSize.height/candidateSize.width));markDirty();dialog.close();render();};
    dialog.addEventListener('close',()=>{generation++;resolution.removeEventListener('change',changed);format.removeEventListener('change',changed);quality.removeEventListener('input',changed);cropSurface.removeEventListener('pointerdown',startCrop);cropSurface.removeEventListener('pointermove',moveCrop);cropSurface.removeEventListener('pointerup',endCrop);cropSurface.removeEventListener('pointercancel',endCrop);window.removeEventListener('resize',showCrop);dialog.remove();},{once:true});
    dialog.showModal();void refresh();
  }
  function renderBorderProperties(){let panel=$("#tileBorderProperties");if(!panel){panel=document.createElement("details");panel.id="tileBorderProperties";panel.open=false;panel.innerHTML='<summary>Tile border</summary><label class="check" data-border-theme-row><input data-tile-border="useTheme" type="checkbox"> Use canvas theme color</label><label class="check"><input data-tile-border="visible" type="checkbox"> Show border</label><div class="property-grid"><label>Thickness<input data-tile-border="borderThickness" type="number" min="1" max="20" step="1"></label><label>Color<input data-tile-border="borderColor" type="color"></label></div><label>Corner rounding %<input data-tile-border="rounding" type="number" min="0" max="50" step="1"></label>';$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.tileBorder;if(!t||!key)return;for(const item of matchingSelectedObjects()){if(key==="useTheme"){item.themeBindings||={};if(event.target.checked)item.themeBindings.borderColor="grid";else{item.borderColor=CanvasTheme.resolve(item,model.settings.theme).borderColor||item.borderColor||"#cbd5e1";delete item.themeBindings.borderColor;}}else if(key==="visible")item.noBorder=!event.target.checked;else if(key==="borderThickness")item.borderThickness=Math.max(1,Math.min(20,+event.target.value||1));else if(key==="rounding")item.rounding=Math.max(0,Math.min(50,+event.target.value||0));else item[key]=event.target.value;if(item.card)item.card.noBorder=item.noBorder;}markDirty();render();});}const t=selectedTile(),visible=t&&!['line','connector','rectangle'].includes(t.kind)&&(t.kind!=="graphicText"||t.boxed);panel.classList.toggle("hidden",!visible);$("#textRoundingControl")?.classList.add("hidden");$("#cardBorderControl")?.classList.add("hidden");if(!visible)return;panel.querySelector('[data-border-theme-row]').classList.toggle('hidden',t.kind!=="graphicText");panel.querySelector('[data-tile-border="useTheme"]').checked=!!t.themeBindings?.borderColor;panel.querySelector('[data-tile-border="visible"]').checked=!t.noBorder;panel.querySelector('[data-tile-border="borderThickness"]').value=t.borderThickness??1;panel.querySelector('[data-tile-border="borderThickness"]').disabled=!!t.noBorder;panel.querySelector('[data-tile-border="borderColor"]').value=CanvasTheme.resolve(t,model.settings.theme).borderColor||"#cbd5e1";panel.querySelector('[data-tile-border="borderColor"]').disabled=!!t.noBorder||!!t.themeBindings?.borderColor;panel.querySelector('[data-tile-border="rounding"]').value=t.rounding??0;panel.querySelector('[data-tile-border="rounding"]').disabled=t.kind==="graphicText"&&t.boxed&&!!t.boxShape&&t.boxShape!=="rectangle";}
