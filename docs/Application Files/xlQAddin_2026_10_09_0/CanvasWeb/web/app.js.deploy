  function setupAiAssistant(){
    const dialog=document.createElement("dialog");dialog.className="canvas-ai-dialog canvas-ai-panel";dialog.innerHTML=`<form method="dialog">
      <header><div class="canvas-ai-heading"><span class="canvas-ai-mode-mark" data-experience-icon="aiAssistant"></span><h2 data-experience-label="aiAssistant">Qanvas AI</h2></div><button value="close" title="Close AI panel">×</button></header>
      <nav class="canvas-ai-mode-selector" aria-label="AI workflow"><button type="button" data-ai-mode="cli">CLI</button><button type="button" data-ai-mode="external">External workspace</button><button type="button" data-ai-mode="manual">Manual upload</button></nav>
      <details class="canvas-ai-information"><summary>Information</summary><div class="canvas-ai-information-body">
        <p class="canvas-ai-mode-help" data-ai-mode-help="cli">Qanvas starts the provider selected under Settings → Canvas → AI tool, processes queued requests, and applies the edited canvas.</p><p class="canvas-ai-mode-help" data-ai-mode-help="external">Requests are synchronized through the shared workspace. ChatGPT Work or another active local agent must monitor the folder.</p><p class="canvas-ai-mode-help" data-ai-mode-help="manual">Create a support pack, upload it to an AI chat, then save the returned canvas in the workspace and reload it.</p>
        <aside class="canvas-ai-data-notice"><b>Before sending</b><p>Requests, screenshots, relevant workspace files, and canvas content may be sent to your selected AI provider, including OpenAI/ChatGPT or GitHub Copilot. Do not send information you are not permitted to share. Review generated changes before use; you are responsible for determining whether generated output requires attribution or a third-party license.</p></aside>
        <div class="canvas-ai-workspace-info"><b>Workspace</b><code data-ai-workspace title="No workspace connected">No workspace connected</code></div>
        <ol class="canvas-ai-mode-steps" data-ai-modes="cli"><li>Create or reconnect a CLI workspace.</li><li>Send requests below; later messages can wait in the queue.</li><li>Keep automatic apply enabled or reload manually.</li></ol>
        <ol class="canvas-ai-mode-steps" data-ai-modes="external"><li>Create or reconnect an external workspace.</li><li>Paste the initialization prompt into an active ChatGPT Work or local-agent task.</li><li>Queue requests below while that task monitors the folder.</li></ol>
        <div class="canvas-ai-mode-help" data-ai-modes="external"><b>Stop monitoring</b><p>Either ask the active AI task: <q>Stop monitoring <span data-ai-workspace-name>this workspace</span></q>, or disable/delete <code data-ai-automation-name>the workspace monitoring automation</code> in Codex / ChatGPT Work. The Stop button below only stops a Qanvas-started CLI turn.</p></div>
        <ol class="canvas-ai-mode-steps" data-ai-modes="manual"><li>Export the support pack.</li><li>Upload its files and screenshots to your chosen AI chat.</li><li>Save the returned canvas here and reload it.</li></ol>
        <label class="canvas-ai-prompt-block" data-ai-modes="cli external manual"><span data-ai-prompt-label>Suggested initialization prompt</span><textarea data-ai-prompt rows="5" readonly></textarea></label><button type="button" data-ai="copyPrompt">Copy prompt</button>
        <details class="canvas-ai-files"><summary>Workspace files</summary><p><b data-ai-file-name>report.canvasweb.json</b> — current canvas<br><b>AI_QUEUE.jsonl</b> — ordered request queue<br><b>REQUEST.md</b> — request currently being processed<br><b>CHAT.jsonl</b> — conversation history<br><b>RESPONSE.md</b> — final response<br><b>AI_SESSION.json</b> — resumable Codex session<br><b>AI_WORKFLOW.md</b> — collaboration contract<br><b>CANVAS_FORMAT.md</b> and <b>SKILL.md</b> — authoring guidance</p></details>
      </div></details>
      <div class="canvas-ai-compose"><label>Your message<textarea data-ai-question rows="3" placeholder="Describe the change… Paste screenshots or files with Ctrl+V."></textarea></label><div class="canvas-ai-attachments" data-ai-attachments hidden aria-label="Workspace attachments"></div><div><label class="check"><input type="checkbox" data-ai-auto-reload checked> Apply completed changes automatically</label><button type="button" data-ai="attachFiles" title="Copy/paste files here or choose files from disk">📎 Files…</button><input type="file" data-ai-file-input accept=".png,.jpg,.jpeg,.webp,.gif,.svg,.pdf,.txt,.md,.json,.jsonl,.csv,.tsv,.xml,.yaml,.yml,.sql,.xlsx,.xls,.docx,.pptx,.html,.css,.js,.cjs,.ts,.cs,.vb,.ps1" multiple hidden><button type="button" data-ai="send" class="primary">Send ↵</button><button type="button" data-ai="stop" disabled>Stop</button></div></div>
      <div class="canvas-ai-chat" data-ai-chat title="Drag the lower-right edge to resize the conversation"><p class="canvas-ai-empty">Create or reconnect a workspace to start collaborating.</p></div>
      <p class="canvas-ai-status" role="status"></p>
      <section class="canvas-ai-queue" data-ai-queue hidden><header><b>Request queue</b><span data-ai-queue-count></span></header><ol data-ai-queue-list></ol></section>
      <section class="canvas-ai-activity" data-ai-activity hidden aria-live="polite"><header><b>Live activity</b><span>Public progress from the selected CLI</span></header><ol></ol></section>
      <div class="canvas-ai-actions"><div><strong>Start or connect</strong><button type="button" data-ai="skill" data-ai-modes="cli" class="primary" title="Create a copy of this canvas with support files and the complete Qanvas authoring skill">New CLI workspace…</button><button type="button" data-ai="pack" data-ai-modes="external manual" title="Create a portable folder for ChatGPT Work or manual upload">Export support pack…</button><button type="button" data-ai="choose" data-ai-modes="cli external manual" title="Reconnect an existing Qanvas AI workspace">Reconnect workspace…</button></div><div><strong>Current workspace</strong><button type="button" data-ai="newConversation" data-ai-modes="cli" disabled title="Clear AI history and session while keeping the workspace and canvas">New conversation</button><button type="button" data-ai="reload" data-ai-modes="cli external manual" title="Load the canvas copy currently saved in the connected workspace">Reload canvas from workspace</button><button type="button" data-ai="folder" data-ai-modes="cli external manual" disabled>Open workspace folder</button></div></div>
    </form>`;document.body.append(dialog);bindMovablePanel(dialog,dialog.querySelector(':scope>form>header'));
    const status=dialog.querySelector(".canvas-ai-status"),composer=dialog.querySelector("[data-ai-question]"),attachmentTray=dialog.querySelector("[data-ai-attachments]"),fileInput=dialog.querySelector("[data-ai-file-input]"),chat=dialog.querySelector("[data-ai-chat]"),queuePanel=dialog.querySelector("[data-ai-queue]"),queueList=dialog.querySelector("[data-ai-queue-list]"),activityPanel=dialog.querySelector("[data-ai-activity]"),information=dialog.querySelector(".canvas-ai-information"),workspaceLabel=dialog.querySelector("[data-ai-workspace]"),sendButton=dialog.querySelector('[data-ai="send"]'),stopButton=dialog.querySelector('[data-ai="stop"]');
    let workingFolder="",workingFileName=`${String(model.name||"Canvas").replace(/[^a-z0-9_-]/gi,"-").replace(/^-+|-+$/g,"").slice(0,48).toLowerCase()||"canvas"}.canvasweb.json`,available=false,running=false,lastAppliedTurn="",pendingAttachments=[],cliProvider="codex",queuedItems=new Map(),aiMode=(()=>{try{return localStorage.getItem("qanvas-ai-mode")||"cli";}catch{return "cli";}})();
    let chatFollow=true,activityFollow=true,updatingScroll=false;
    const isNearBottom=node=>node.scrollHeight-node.scrollTop-node.clientHeight<48;
    chat.addEventListener("scroll",()=>{if(!updatingScroll)chatFollow=isNearBottom(chat);},{passive:true});
    activityPanel.addEventListener("scroll",()=>{if(!updatingScroll)activityFollow=isNearBottom(activityPanel);},{passive:true});
    const queueEditor=document.createElement("dialog");queueEditor.className="canvas-ai-queue-editor";queueEditor.innerHTML='<form method="dialog"><header><div><h3>Edit queued request</h3><p>This request has not started. You can change its text before the AI claims it.</p></div><button value="cancel" title="Close">×</button></header><label>Request<textarea data-queue-edit-text rows="7"></textarea></label><section data-queue-edit-attachments hidden><b>Attached workspace files</b><div></div></section><p data-queue-edit-error role="alert"></p><footer><button value="cancel">Cancel</button><button type="button" class="primary" data-queue-edit-save>Save changes</button></footer></form>';document.body.append(queueEditor);
    const attachmentIsImage=name=>/\.(png|jpe?g|webp|gif)$/i.test(String(name||""));
    const fileBadge=name=>{const badge=document.createElement("span");badge.className="canvas-ai-file-icon";badge.textContent=(String(name||"").split(".").pop()||"FILE").slice(0,5).toUpperCase();return badge;};
    const openQueueEditor=item=>{if(!item||item.state!=="queued")return;queueEditor.dataset.turnId=item.turnId;queueEditor.querySelector('[data-queue-edit-text]').value=item.text||"";queueEditor.querySelector('[data-queue-edit-error]').textContent="";const section=queueEditor.querySelector('[data-queue-edit-attachments]'),tray=section.querySelector('div');tray.replaceChildren();section.hidden=!(item.attachments||[]).length;for(const path of item.attachments||[]){const figure=document.createElement('figure'),name=String(path).split(/[\\/]/).pop(),preview=attachmentIsImage(name)?document.createElement('img'):fileBadge(name),caption=document.createElement('figcaption');figure.dataset.path=path;if(preview.tagName==='IMG')preview.alt='Queued image preview';caption.textContent=name;figure.append(preview,caption);tray.append(figure);if(preview.tagName==='IMG')post('getAiQueueAttachmentPreview',{turnId:item.turnId,path});}queueEditor.showModal();queueEditor.querySelector('[data-queue-edit-text]').focus();};
    queueEditor.querySelector('[data-queue-edit-save]').addEventListener('click',()=>{const text=queueEditor.querySelector('[data-queue-edit-text]').value.trim();if(!text){queueEditor.querySelector('[data-queue-edit-error]').textContent='Enter a request before saving.';return;}post('updateAiQueueItem',{turnId:queueEditor.dataset.turnId,text});queueEditor.close();status.textContent='Saving queued request…';});
    const updatePrompt=()=>{const folder=workingFolder||"the Qanvas AI workspace folder I opened or attached",workspaceName=(workingFolder.split(/[\\/]/).filter(Boolean).at(-1)||"this workspace"),workspaceSlug=workspaceName.toLowerCase().replace(/-ai-workspace$/,"-qanvas").replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"")||"workspace";dialog.querySelectorAll("[data-ai-file-name]").forEach(node=>node.textContent=workingFileName);dialog.querySelectorAll("[data-ai-workspace-name]").forEach(node=>node.textContent=workspaceName);dialog.querySelectorAll("[data-ai-automation-name]").forEach(node=>node.textContent=`monitor-${workspaceSlug}-queue`);dialog.querySelector('[data-ai-prompt]').value=aiMode==="cli"?`Work in ${folder}. Read REQUEST.md, AI_WORKFLOW.md, CHAT.jsonl, CANVAS_FORMAT.md, and SKILL.md if present. Inspect ${workingFileName}, make the current requested change directly in that file, preserve unrelated content, run the supplied validator, and finish with a concise result. Qanvas processes AI_QUEUE.jsonl sequentially. Do not edit RESPONSE.md; Qanvas or the CLI owns that output file.`:aiMode==="external"?`Use the local folder ${folder}. Read EXTERNAL_AI_WORKFLOW.md and monitor AI_QUEUE.jsonl while this task remains active. Drain every queued external request in creation order. For each request, inspect its attached workspace files, edit ${workingFileName}, validate it, update the queue, RESPONSE.md and AI_STATUS.json, and append your response to CHAT.jsonl as described by the workflow.`:`Use the attached support-pack files. Read REQUEST.md, CANVAS_FORMAT.md, and SKILL.md if present. Inspect ${workingFileName} and the attached workspace files, make the requested change, validate the result, and return the complete updated ${workingFileName} for download.`;};
    const applyMode=mode=>{aiMode=["cli","external","manual"].includes(mode)?mode:"cli";try{localStorage.setItem("qanvas-ai-mode",aiMode);}catch{}dialog.dataset.aiMode=aiMode;dialog.querySelectorAll("[data-ai-mode]").forEach(button=>button.setAttribute("aria-pressed",String(button.dataset.aiMode===aiMode)));dialog.querySelectorAll("[data-ai-mode-help]").forEach(node=>node.hidden=node.dataset.aiModeHelp!==aiMode);dialog.querySelectorAll("[data-ai-modes]").forEach(node=>node.hidden=!node.dataset.aiModes.split(/\s+/).includes(aiMode));dialog.querySelector("[data-ai-prompt-label]").textContent=aiMode==="external"?"Suggested initialization prompt for ChatGPT Work / external agent":aiMode==="manual"?"Prompt to include with the uploaded support pack":"CLI workspace prompt";sendButton.textContent=aiMode==="cli"?(running?"Add to queue ↵":"Send ↵"):aiMode==="external"?"Queue request ↵":"Update request ↵";composer.placeholder=aiMode==="cli"?"Describe the next change… You can send while AI is working.":aiMode==="external"?"Queue the next request while the external agent is working…":"";const packButton=dialog.querySelector('[data-ai="pack"]');if(packButton)packButton.textContent=aiMode==="external"?"New external workspace…":"Export support pack…";if(aiMode==="manual")information.open=true;updatePrompt();};
    const updateSendState=()=>{sendButton.disabled=!available||pendingAttachments.some(item=>item.saving);sendButton.textContent=aiMode==="cli"?(running?"Add to queue ↵":"Send ↵"):aiMode==="external"?"Queue request ↵":"Update request ↵";};
    const setAvailability=value=>{available=value;dialog.querySelector('[data-ai="folder"]')?.toggleAttribute("disabled",!value);dialog.querySelector('[data-ai="newConversation"]')?.toggleAttribute("disabled",!value||running);updateSendState();};
    const renderAttachments=()=>{attachmentTray.replaceChildren();attachmentTray.hidden=!pendingAttachments.length;for(const item of pendingAttachments){const figure=document.createElement("figure");figure.dataset.attachmentId=item.id;const preview=item.image?document.createElement("img"):fileBadge(item.name);if(item.image){preview.src=item.preview;preview.alt="Attached image preview";}const caption=document.createElement("figcaption");caption.textContent=item.error?item.error:item.saving?"Saving file…":item.name;const remove=document.createElement("button");remove.type="button";remove.dataset.ai="removeAttachment";remove.dataset.attachmentId=item.id;remove.title="Remove file from this message";remove.setAttribute("aria-label","Remove file");remove.textContent="×";figure.append(preview,caption,remove);attachmentTray.append(figure);}updateSendState();};
    const appendBubble=(role,text,live=false,source="")=>{const article=document.createElement("article");const external=role!=="user"&&(source==="external"||aiMode==="external");article.className=`canvas-ai-message ${role} ${external?'external':''} ${live?'live':''}`;article.title="Right-click to copy message";const heading=document.createElement("b");heading.textContent=role==="user"?"You":external?"Qanvas Ext AI":cliProvider==="copilot"?"Qanvas Copilot":"Qanvas AI";const body=document.createElement("pre");body.textContent=String(text||"").replace(/^# AI response\s*/i,"").trim();article.append(heading,body);chat.append(article);};
    const renderQueue=items=>{queueList.replaceChildren();const active=(items||[]).filter(item=>["queued","running","error"].includes(item.state));queuedItems=new Map(active.map(item=>[item.turnId,item]));queuePanel.hidden=!active.length;dialog.querySelector("[data-ai-queue-count]").textContent=active.length?`${active.filter(item=>item.state==="queued").length} waiting`:"";for(const [index,item] of active.entries()){const row=document.createElement("li"),state=document.createElement("span"),text=document.createElement("span");row.className=`${item.state}`;row.dataset.turnId=item.turnId||"";row.dataset.queueState=item.state||"";state.className="canvas-ai-queue-state";state.textContent=item.state==="running"?"Working":item.state==="error"?"Failed":`#${active.slice(0,index+1).filter(entry=>entry.state==="queued").length}`;text.className="canvas-ai-queue-text";text.textContent=item.text;row.title=item.state==="running"?(item.error||"This request is currently being processed"):(item.error||item.state==="queued"?"Open to preview screenshots or edit this waiting request":"Right-click to remove this request");row.append(state,text);if(item.state==="queued"){const edit=document.createElement('button');edit.type='button';edit.className='canvas-ai-queue-edit';edit.textContent='Edit';edit.title='Preview screenshots and edit this request';edit.addEventListener('click',event=>{event.stopPropagation();openQueueEditor(item);});row.append(edit);row.addEventListener('dblclick',()=>openQueueEditor(item));}queueList.append(row);}};
