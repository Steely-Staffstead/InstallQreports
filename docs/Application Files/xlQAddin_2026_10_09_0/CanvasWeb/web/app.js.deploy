        const editing=[...options.querySelectorAll("details")].find(section=>section.querySelector("summary")?.textContent==="Editing"),keys=[["task","Task"],["owner","Owner"],["status","Status"],["progress","Progress"],["plannedHours","Planned hours"],["registeredHours","Hours used"],["group","Project / group"],["id","Task ID"],["start","Start"],["end","End"]].filter(([key])=>draft[key]),selected=new Set(Array.isArray(draft.barLabelFields)?draft.barLabelFields:["task"]),section=document.createElement("details");
        section.open=true;section.dataset.ganttBarLabels="";section.innerHTML=`<summary>Text after Gantt bars</summary><p class="property-empty">Task is shown by default. Select additional values to place after each bar.</p><div class="gantt-bar-label-options">${keys.map(([key,label])=>`<label class="check"><input type="checkbox" data-gantt-bar-label="${key}" ${selected.has(key)?"checked":""}> ${label}</label>`).join("")}</div>`;
