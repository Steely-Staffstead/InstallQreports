  function editBasicFilter(index,scope="source",tileId=""){const tile=scope==="tile"?allObjects(page()).find(item=>item.id===tileId):null,owner=scope==="tile"?tile:scope==="page"?page():query(),sourceQuery=scope==="tile"?sourceForTile(tile)?.query:scope==="page"?sourceById(owner.filters?.[index]?.sourceId||"main")?.query:query(),filter=owner?.filters?.[index],columnIndex=sourceQuery?.data?.columns?.indexOf(filter?.column);if(!filter||columnIndex<0){window.QReportsDialogs.alert("Choose a column first.");return}const values=[...new Set(sourceQuery.data.rows.map(row=>row[columnIndex]).filter(value=>value!=null).map(String))].sort((a,b)=>a.localeCompare(b,undefined,{numeric:true})),selected=new Set(filter.basicValues||[]),dialog=document.createElement("dialog");dialog.className="filter-values-dialog";dialog.innerHTML=`<form method="dialog"><h2>${scope==="tile"?`${esc(tile.title)} · `:""}Filter: ${esc(filter.column)}</h2><input data-value-search placeholder="Search values"><label class="check"><input type="checkbox" data-select-all> Select all visible values</label><div class="filter-value-list">${values.map(value=>`<label data-value-row><input type="checkbox" value="${esc(value)}" ${selected.has(value)?"checked":""}> <span>${esc(value)}</span></label>`).join("")}</div><div class="dialog-actions"><button value="cancel">Cancel</button><button value="apply" class="primary">Apply values</button></div></form>`;document.body.append(dialog);const visible=()=>[...dialog.querySelectorAll("[data-value-row]")].filter(row=>!row.hidden);dialog.querySelector("[data-value-search]").oninput=e=>{const term=e.target.value.toLowerCase();dialog.querySelectorAll("[data-value-row]").forEach(row=>row.hidden=!row.textContent.toLowerCase().includes(term));};dialog.querySelector("[data-select-all]").onchange=e=>visible().forEach(row=>row.querySelector("input").checked=e.target.checked);dialog.addEventListener("close",()=>{if(dialog.returnValue==="apply"){filter.basicValues=[...dialog.querySelect