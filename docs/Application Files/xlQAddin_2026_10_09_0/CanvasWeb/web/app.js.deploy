      return '<section class="matrix-active-filters"><h4>Filters applied to preview</h4>'+(sourceFilters.length||tileFilters.length?'<ul>'+sourceFilters.map(filter=>describe(filter,'Source')).join('')+tileFilters.map(filter=>describe(filter,'Matrix')).join('')+'</ul>':'<p>No active source or matrix filters.</p>')+'</section>';
    }
    function matrixValueGroupsHtml(){
      const invalidType=state.valueGroups!=null&&!Array.isArray(state.valueGroups),groups=Array.isArray(state.valueGroups)?state.valueGroups:[],count=state.values.length;
      const invalidEntries=groups.some(group=>!group||typeof group!=="object"||Array.isArray(group));
      const total=groups.reduce((sum,group)=>sum+(Number(group?.span)||0),0);
      let offset=0;
      const entries=groups.map((entry,index)=>{
        const group=entry&&typeof entry==="object"&&!Array.isArray(entry)?entry:{};
        const span=Math.max(1,Math.floor(Number(group.span)||1)),names=state.values.slice(offset,offset+span).map(value=>value.caption||value.field);
        offset+=span;
        return `<div class="matrix-value-group-row"><label>Heading<input data-value-group-caption="${index}" value="${esc(group.caption||"")}" placeholder="Group heading"></label><label>Columns<input data-value-group-span="${index}" type="number" min="1" max="${count}" value="${esc(group.span??1)}"></label><button type="button" data-remove-value-group="${index}" title="Remove group and give its columns to the next group">×</button><small>${esc(names.join(" · ")||"No value columns")}</small></div>`;
      }).join("");
      const canAdd=!invalidType&&!invalidEntries&&count>0&&(!groups.length||groups.some(group=>Number(group.span)>1));
      const invalidSpan=groups.some(group=>!Number.isInteger(+group?.span)||+group?.span<1);
      const warning=invalidType||invalidEntries?'<p class="matrix-value-group-warning">valueGroups needs an array of group objects. Repair it in Advanced matrix JSON.</p>':groups.length&&(total!==count||invalidSpan)?`<p class="matrix-value-group-warning">Groups cover ${total} of ${count} value columns. Use positive whole-number spans and adjust them before applying.</p>`:"";
      const message=valueGroupsMessage?`<p class="matrix-value-group-message" role="status">${esc(valueGroupsMessage)}</p>`:"";
      return `<details class="matrix-value-group-editor" ${valueGroupsOpen?'open':''}><summary>Grouped value headers${groups.length?` (${groups.length})`:''}</summary><p>Give consecutive value columns a shared heading. Shown in Outline layout when Columns is empty; JSON settings remain saved in other layouts.</p>${entries}<div class="matrix-value-group-actions"><button type="button" data-add-value-group ${canAdd?'':'disabled'}>${groups.length?'+ Add group':'+ Create group'}</button>${groups.length?'<button type="button" data-reset-value-groups>Reset to one group</button>':''}</div>${message}${warning}</details>`;
    }
    function matrixSettingsHtml(){
      const controlStyle=state.groupControlStyle||{},themeControls=controlStyle.useThemeColors!==false,roles=CanvasTheme.roles(model.settings.theme),accent=canvasPaletteColor(0),controlBackgroundRole=controlStyle.backgroundThemeRole||"accent",controlTextRole=controlStyle.textThemeRole||"onAccent",controlBackground=themeControls?(roles[controlBackgroundRole]||accent):controlStyle.background||accent,controlText=themeControls?(roles[controlTextRole]||readableCanvasColor(controlBackground)):controlStyle.textColor||readableCanvasColor(controlBackground),controlRoleNames=[...Object.keys(CanvasTheme.defaults),...(model.settings.theme?.colors||[]).map((_,index)=>`color${index+1}`)],controlRoleOptions=selected=>controlRoleNames.map(role=>`<option value="${esc(role)}" ${selected===role?"selected":""}>${/^color\d+$/.test(role)?`Palette ${role.slice(5)}`:esc(role.replace(/([A-Z])/g," $1"))}</option>`).join("");
