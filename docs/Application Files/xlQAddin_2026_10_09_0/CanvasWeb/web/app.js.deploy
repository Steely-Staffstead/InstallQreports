      const name=heading.textContent,section=document.createElement("details"),summary=document.createElement("summary");
      summary.textContent=name;section.append(summary);section.open=cardSectionState.get(name)||false;
      heading.before(section);
      while(heading.nextSibling&&heading.nextSibling.nodeName!=="H4")section.append(heading.nextSibling);
      heading.remove();section.addEventListener("toggle",()=>{if(section.isConnected)cardSectionState.set(name,section.open);});
    });
    if(selectedTile()?.kind==="card"){
      const sections=[...panel.querySelectorAll(":scope > details")],data=sections.find(section=>["Target and variance","Data fields"].includes(section.querySelector("summary")?.textContent)),formatting=sections.find(section=>section.querySelector("summary")?.textContent==="Card formatting");
      if(data){data.querySelector("summary").textContent="Data fields";const field=$("#tileField")?.closest("label");if(field){field.firstChild.textContent="Data field / measure";data.querySelector("summary").after(field);renderCardFieldOptions(selectedTile());}if(formatting)formatting.before(data);}
      const layer=$("#layerProperties");if(layer)layer.before(general);
    }
  }
