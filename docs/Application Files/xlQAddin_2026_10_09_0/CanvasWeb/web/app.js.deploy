    applyMode(aiMode);setAvailability(false);
    document.querySelector('[data-action="exportAiAssistant"]')?.addEventListener("click",()=>{if(!host){$("#saveStatus").textContent="AI collaboration requires the desktop application.";return;}updatePrompt();if(!dialog.open){if(aiMode!=="manual")composer.value="";dialog.show();}post("initializeAiAssistant");if(aiMode!=="manual")composer.focus();});
    const addAttachmentFiles=files=>{if(!files.length)return;if(!available){status.textContent="Create or reconnect an AI workspace before attaching files.";return;}for(const file of files.slice(0,8-pendingAttachments.length)){if(file.size>16*1024*1024){status.textContent=`${file.name||"A file"} is larger than 16 MB.`;continue;}const id=crypto.randomUUID(),reader=new FileReader(),image=file.type.startsWith("image/"),item={id,name:file.name||"attachment",path:"",preview:"",image,saving:true,error:""};pendingAttachments.push(item);reader.onload=()=>{item.preview=String(reader.result||"");renderAttachments();post("addAiAttachment",{requestId:id,name:item.name,dataUrl:item.preview});status.textContent="Saving attached file in the workspace…";};reader.onerror=()=>{item.saving=false;item.error="Could not read file";renderAttachments();};reader.readAsDataURL(file);}renderAttachments();};
