  function renderCardPropertiesInner(){let panel=$("#cardProperties");if(!panel){panel=document.createElement("div");panel.id="cardProperties";panel.className="card-properties hidden";$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const key=event.target.dataset.card,t=selectedTile();if(!key||t?.kind!=="card")return;t.card||={};t.card[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?(event.target.value===""?null:+event.target.value):event.target.value;markDirty();render();});}const t=selectedTile();panel.classList.toggle("hidden",t?.kind!=="card");if(t?.kind!=="card")return;const card=t.card||={},fields=[...new Set([...query().data.columns,...query().measures.map(item=>item.Name??item.OutputName??item.name??item.outputName).filter(Boolean)])],formats=["Auto","N0","N1","N2","K0","K1","M0","M1","P0","P1","P2","#,##0,","#,##0.0,,"];panel.innerHTML=`<h4>Card formatting</h4><div class="property-grid"><label>Number format<select data-card="numberFormat">${formats.map(value=>`<option ${value===(card.numberFormat||"Auto")?"selected":""}>${value}</option>`).join("")}</select></label><label>Percent format<select data-card="percentFormat">${["P0","P1","P2"].map(value=>`<option ${value===(card.percentFormat||"P1")?"selected":""}>${value}</option>`).join("")}</select></label><label>Value font<select data-card="fontFamily">${["Segoe UI","Arial","Calibri","Georgia","Consolas"].map(value=>`<option ${value===(card.fontFamily||"Segoe UI")?"selected":""}>${value}</option>`).join("")}</select></label><label>Value size<input data-card="fontSize" type="number" min="8" max="120" value="${card.fontSize||30}"></label><label>Weight<select data-card="fontWeight">${[[400,"Normal"],[600,"Semibold"],[700,"Bold"],[800,"Extra bold"]].map(([value,label])=>`<option value="${value}" ${+card.fontWeight===value?"selected":""}>${label}</option>`).join("")}</select></label><label>Default color<input data-card="valueColor" type="color" value