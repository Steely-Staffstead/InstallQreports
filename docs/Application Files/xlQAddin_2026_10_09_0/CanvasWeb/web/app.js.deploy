    const renderConversation=message=>{cliProvider=message.provider==="copilot"?"copilot":"codex";const providerName=cliProvider==="copilot"?"GitHub Copilot":"Codex",firstRender=chat.dataset.rendered!=="true",previousTop=chat.scrollTop,externalWaiting=message.state==="external_waiting",externalRunning=(message.queue||[]).some(item=>item.source==="external"&&item.state==="running"),queuePending=(message.queue||[]).some(item=>item.state==="queued"||item.state==="running"),response=String(message.response||"").trim(),messages=message.messages||[],lastAssistant=[...messages].reverse().find(item=>item.role!=="user"),responseAlreadySaved=response&&String(lastAssistant?.text||"").trim()===response;chat.replaceChildren();for(const item of messages)appendBubble(item.role,item.text,false,item.source);if(response&&!responseAlreadySaved)appendBubble("assistant",response,!!(message.running||externalWaiting||queuePending),externalWaiting?"external":"");if(!chat.children.length){const empty=document.createElement("p");empty.className="canvas-ai-empty";empty.textContent="Write a request above. Paste files with Ctrl+V or choose Files…; Enter sends and Shift+Enter adds a new line.";chat.append(empty);}renderQueue(message.queue);chat.dataset.rendered="true";updatingScroll=true;chat.scrollTop=firstRender||chatFollow?chat.scrollHeight:Math.min(previousTop,Math.max(0,chat.scrollHeight-chat.clientHeight));updatingScroll=false;running=!!message.running;renderActivity(message.activity);updateSendState();stopButton.disabled=!running;dialog.querySelector('[data-ai="newConversation"]')?.toggleAttribute("disabled",!available||running);status.textContent=externalRunning?"External AI is working · live checkpoints appear below.":externalWaiting?"Requests queued · waiting for the active external workspace agent…":running?(message.progress?.trim().split(/\r?\n/).filter(Boolean).at(-1)||(cliProvider==="copilot"?"Starting a new GitHub Copilot turn…":message.continuing?"Continuing the Codex conversatio