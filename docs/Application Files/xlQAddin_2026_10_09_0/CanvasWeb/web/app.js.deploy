  function renderCardCaptionProperties(){let panel=$("#cardCaptionProperties");if(!panel){panel=document.createElement("details");panel.id="cardCaptionProperties";panel.innerHTML='<summary>Caption</summary><label class="check"><input data-card-caption="showCaption" type="checkbox"> Show caption</label><label>Caption template<textarea data-card-caption="captionTemplate" rows="3" placeholder="@field"></textarea></label><small class="card-help">Tokens: @field, @value and {{parameterName}}.</small><div class="property-grid"><label>Font<select data-card-caption="captionFontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-card-caption="captionFontSize" type="number" min="8" max="72"></label></div><label>Text color<input data-card-caption="captionColor" type="color"></label><div class="header-emphasis"><label class="check"><input data-card-caption="captionBold" type="checkbox"> Bold</label><label class="check"><input data-card-caption="captionItalic" type="checkbox"> Italic</label><label class="check"><input data-card-caption="captionUnderline" type="checkbox"> Underline</label></div><label class="check"><input data-card-caption="transparentBackground" type="checkbox"> Transparent tile background</label>';$("#tileProperties")?.append(panel);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.cardCaption;if(t?.kind!=="card"||!key)return;t.card||={};t.card[key]=event.target.type==="checkbox"?event.target.checked:event.target.type==="number"?Math.max(8,+event.target.value||12):event.target.value;markDirty();render();});}const t=selectedTile(),visible=t?.kind==="card";panel.classList.toggle("hidden",!visible);if(!visible)return;const card=t.card||{};panel.querySelector('[data-card-caption="showCaption"]').checked=card.showCaption!==false;panel.querySelector('[data-card-caption="captionTemplate"]').value=card.captionTemplate||"@field";panel.querySelector('[data-card-caption="captionFontFamily"]').value=card.captionFontFamily||"Segoe UI";panel.querySelector('[data-card-caption="captionFontSize"]').value=card.captionFontSize||12;panel.querySelector('[data-card-caption="captionColor"]').value=card.captionColor||"#475467";panel.querySelector('[data-card-caption="captionBold"]').checked=!!card.captionBold;panel.querySelector('[data-card-caption="captionItalic"]').checked=!!card.captionItalic;panel.querySelector('[data-card-caption="captionUnderline"]').checked=!!card.captionUnderline;panel.querySelector('[data-card-caption="transparentBackground"]').checked=!!card.transparentBackground;}
  function renderCardBorderControl(){const panel=$("#cardCaptionProperties");if(!panel)return;let label=$("#cardBorderControl");if(!label){label=document.createElement("label");label.id="cardBorderControl";label.className="check";label.innerHTML='<input type="checkbox"> Remove tile border and shadow';panel.append(label);label.querySelector("input").addEventListener("change",event=>{const t=selectedTile();if(t?.kind!=="card")return;t.card||={};t.card.noBorder=event.target.checked;markDirty();render();});}const t=selectedTile();label.classList.toggle("hidden",t?.kind!=="card");if(t?.kind==="card")label.querySelector("input").checked=!!t.card?.noBorder;}
  function duplicateName(source){
    const title=String(source?.title||source?.kind||"Object").trim();
    const base=String(source?.duplicateBaseName||(/^Text box \d+$/i.test(title)?"Text box":title.replace(/(?:\s+copy)+$/i,""))).trim()||"Object";
    const used=new Set(model.pages.flatMap(p=>allObjects(p).map(item=>String(item.title||"").toLowerCase())));
    let number=1;while(used.has(`${base} ${number}`.toLowerCase()))number++;
    return {base,title:`${base} ${number}`};
  }
  function matchingSelectedObjects(){const t=selectedTile();if(!t)return[];const matches=allObjects(page()).filter(item=>selectedIds.has(item.id)&&item.kind===t.kind&&(t.kind!=="graphicText"||!!item.boxed===!!t.boxed));return matches.length?matches:[t];}
  function reverseConnector(t){if(t?.kind!=="connector")return;[t.fromId,t.toId]=[t.toId,t.fromId];[t.fromAnchor,t.toAnchor]=[t.toAnchor,t.fromAnchor];[t.x1,t.x2]=[t.x2,t.x1];[t.y1,t.y2]=[t.y2,t.y1];markDirty();render();}
  function duplicateTile(withConnectors=false){const source=selectedTile();if(!source)return;const copy=structuredClone(source),name=duplicateName(source);copy.id=uid();copy.title=name.title;copy.duplicateBaseName=name.base;copy.x+=20;copy.y+=20;copy.layer=Math.max(-1,...allObjects(page()).map(t=>Number(t.layer)||0))+1;(graphicKinds.has(copy.kind)?page().graphics:page().tiles).push(copy);if(withConnectors){for(const connector of [...(page().graphics||[])].filter(item=>item.kind==="connector"&&(item.fromId===source.id||item.toId===source.id))){const linked=structuredClone(connector);linked.id=uid();linked.layer=Math.max(-1,...allObjects(page()).map(item=>Number(item.layer)||0))+1;if(linked.fromId===source.id)linked.fromId=copy.id;if(linked.toId===source.id)linked.toId=copy.id;page().graphics.push(linked);}}selectedId=copy.id;selectedIds=new Set([copy.id]);markDirty();render();}
  function duplicateConnectorAsChild(connectorId){
    const source=selectedTile(),connector=(page().graphics||[]).find(item=>item.kind==="connector"&&item.id===connectorId&&(item.fromId===source?.id||item.toId===source?.id));
    if(!source||!connector)return;
    const neighborId=connector.fromId===source.id?connector.toId:connector.fromId,neighbor=allObjects(page()).find(item=>item.id===neighborId);
    if(!neighbor)return;
    const copy=structuredClone(source);
    const name=duplicateName(source);copy.id=uid();copy.title=name.title;copy.duplicateBaseName=name.base;
    copy.x=Math.max(0,Math.round(2*(source.x+source.width/2)-(neighbor.x+neighbor.width/2)-source.width/2));
    copy.y=Math.max(0,Math.round(2*(source.y+source.height/2)-(neighbor.y+neighbor.height/2)-source.height/2));
    copy.layer=Math.max(-1,...allObjects(page()).map(item=>Number(item.layer)||0))+1;
    (graphicKinds.has(copy.kind)?page().graphics:page().tiles).push(copy);
    const linked=structuredClone(connector);linked.id=uid();linked.layer=copy.layer+1;
    linked.fromId=copy.id;linked.toId=source.id;
    linked.fromAnchor=null;linked.toAnchor=null;
    page().graphics.push(linked);selectedId=copy.id;selectedIds=new Set([copy.id]);markDirty();render();
  }
  async function deleteTile(){
    const removing=selectedIds.size?new Set(selectedIds):new Set(selectedId?[selectedId]:[]);
    if(!removing.size)return;
    const published=[...removing].map(id=>model.pages.flatMap(item=>item.tiles||[]).find(tile=>tile.id===id)).filter(tile=>tile?.kind==="gantt"&&tile.design?.ganttSpec?.publishAsSource).map(tile=>ganttSourceId(tile)),consumers=model.pages.flatMap(item=>allObjects(item)).filter(tile=>published.includes(tile.sourceId));
    const dependencyWarning=consumers.length?` ${consumers.length} visual${consumers.length===1?"":"s"} using the published Gantt datasource will switch to Main source.`:"";
    if(window.QReportsSettings?.get()?.confirmDeleteTiles!==false&&!await themedConfirm(removing.size===1?"Delete tile":"Delete tiles",`Delete ${removing.size===1?"this tile":`${removing.size} tiles`}?${dependencyWarning}`))return;
    page().tiles=(page().tiles||[]).filter(tile=>!removing.has(tile.id));
    page().graphics=(page().graphics||[]).filter(item=>!removing.has(item.id)&&!(item.kind==="connector"&&(removing.has(item.fromId)||removing.has(item.toId))));
    syncPublishedGanttSources(model);selectedId=null;selectedIds.clear();markDirty();render();
  }
  function openGanttDesigner(tile){
    const overlay=designerShell("gantt","Gantt designer"),draft={...window.CanvasGantt.defaults(),...structuredClone(tile.design?.ganttSpec||{})},options=overlay.querySelector("[data-designer-options]"),fieldsPanel=overlay.querySelector("[data-designer-fields]"),preview=overlay.querySelector("[data-designer-preview]");
    let sourceId=tile.sourceId||activeSourceId||"main",sourceData=displayQueryForTile({...tile,sourceId}).data||{columns:[],rows:[]};
    let embeddedData=tile.design?.ganttData?structuredClone(tile.design.ganttData):null;
    const standaloneData=()=>{const start=window.CanvasGantt.iso(new Date()),end=window.CanvasGantt.iso(window.CanvasGantt.addDays(window.CanvasGantt.dateValue(new Date()),6));return{columns:["Task ID","Task","Project / Group","Start","End","Progress","Milestone","Depends on","Owner","Status","Description"],types:[],rows:[["1","New task","",start,end,0,false,"","","",""]]};};
    const ensureEmbeddedData=()=>{if(!embeddedData)embeddedData=sourceData.columns?.length?structuredClone(sourceData):standaloneData();embeddedData.columns||=[];embeddedData.rows||=[];for(const [name,initial] of [["Project / Group",""],["Milestone",false],["Description",""]])if(!embeddedData.columns.some(column=>String(column).toLowerCase()===name.toLowerCase())){embeddedData.columns.push(name);embeddedData.rows.forEach(row=>row.push(initial));}Object.assign(draft,window.CanvasGantt.autoConfigure(draft,embeddedData.columns));return embeddedData;};
    const activeData=()=>draft.dataStorage==="embedded"?ensureEmbeddedData():sourceData;
    const registryOpen={group:false,status:false};let formatOpen=false;
    const fieldChoices=(columns,value,optional=false)=>`<option value="">${optional?'None':'Choose field…'}</option>${columns.map(name=>`<option value="${esc(name)}" ${name===value?'selected':''}>${esc(name)}</option>`).join("")}`;
