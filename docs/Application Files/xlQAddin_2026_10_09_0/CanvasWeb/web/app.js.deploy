    const contextMenu=document.createElement("div");contextMenu.className="canvas-ai-context-menu";contextMenu.hidden=true;document.body.append(contextMenu);const hideContextMenu=()=>{contextMenu.hidden=true;contextMenu.replaceChildren();};const showContextMenu=(event,label,action)=>{event.preventDefault();contextMenu.replaceChildren();const button=document.createElement("button");button.type="button";button.textContent=label;button.onclick=()=>{hideContextMenu();action();};contextMenu.append(button);contextMenu.hidden=false;const width=190,height=42;contextMenu.style.left=`${Math.min(event.clientX,innerWidth-width-8)}px`;contextMenu.style.top=`${Math.min(event.clientY,innerHeight-height-8)}px`;button.focus();};
    chat.addEventListener("contextmenu",event=>{const bubble=event.target.closest(".canvas-ai-message");if(!bubble)return;showContextMenu(event,"Copy message",async()=>{const text=bubble.querySelector("pre")?.textContent||"";try{await navigator.clipboard.writeText(text);}catch{const range=document.createRange();range.selectNodeContents(bubble.querySelector("pre"));const selection=getSelection();selection.removeAllRanges();selection.addRange(range);document.execCommand("copy");selection.removeAllRanges();}status.textContent="Message copied.";});});
    queueList.addEventListener("contextmenu",event=>{const row=event.target.closest("li[data-turn-id]");if(!row)return;if(row.dataset.queueState==="running"){event.preventDefault();status.textContent="Stop the active AI turn before removing it.";return;}showContextMenu(event,"Remove from queue",()=>{post("deleteAiQueueItem",{turnId:row.dataset.turnId});status.textContent="Removing request from the queue…";});});
    document.addEventListener("pointerdown",event=>{if(!contextMenu.hidden&&!contextMenu.contains(event.target))hideContextMenu();});window.addEventListener("blur",hideContextMenu);window.addEventListener("resize",hideContextMenu);
    dialog.addEventListener("click",async event=>{const modeButton=event.target.closest("button[data-ai-mode]");if(modeButton){applyMode(modeButton.dataset.aiMode);setAvailability(available);return;}const target=event.target.closest("[data-ai]"),action=target?.dataset.ai;if(!action)return;if(action==="send")send();else if(action==="attachFiles")fileInput.click();else if(action==="stop")post("stopAiTurn");else if(action==="removeAttachment"){pendingAttachments=pendingAttachments.filter(item=>item.id!==target.dataset.attachmentId);renderAttachments();}else if(action==="newConversation"){if(await window.QReportsDialogs.confirm("Start a new AI conversation? This clears the chat history but keeps the current canvas."))post("resetAiConversation");}else if(action==="copyPrompt"){const field=dialog.querySelector('[data-ai-prompt]');try{await navigator.clipboard.writeText(field.value);}catch{field.select();document.execCommand('copy');}status.textContent="Prompt copied.";}else if(action==="pack"||action==="skill"){status.textContent="Choose the parent folder for a new AI workspace…";post("exportAiPack",{document:fileDocument(),question:aiMode==="manual"?"":composer.value,includeSkill:action==="skill"||aiMode==="external",workflowMode:action==="skill"?"cli":aiMode});}else if(action==="choose")post("chooseAiWorkingFile");else if(action==="reload"){if(dirty&&!await window.QReportsDialogs.confirm("Reload the AI working file and discard unsaved changes in the current canvas?"))return;post("reloadAiWorkingFile");}else if(action==="folder")post("openAiWorkingFolder");});
    setInterval(()=>{if(dialog.open&&host)post("getAiConversationState");},900);
    host?.addEventListener("message",event=>{const message=event.data;if(message.type==="aiPackExported"||message.type==="aiWorkingFileState"){available=!!message.file;workingFolder=available?message.folder:"";workingFileName=available?String(message.file).split(/[\\/]/).pop():workingFileName;updatePrompt();setAvailability(available);workspaceLabel.textContent=available?workingFolder:"No workspace connected";workspaceLabel.title=available?workingFolder:"No workspace connected";if(aiMode==="manual"&&message.type==="aiWorkingFileState"&&message.question&&!composer.value)composer.value=message.question;status.textContent=message.type==="aiPackExported"?(message.mode==="external"?"External workspace created. Attach it to ChatGPT Work and keep that task active while it monitors requests.":message.mode==="manual"?"Support pack created. Upload its files to your chosen AI chat.":"CLI workspace created. Write a request and choose Send."):(available?"Workspace connected. Ready.":"Create or reconnect an AI workspace.");if(available)post("getAiConversationState");}else if(message.type==="aiConversationState"){available=!!message.available;if(message.folder){workingFolder=message.folder;workingFileName=String(message.file||workingFileName).split(/[\\/]/).pop();workspaceLabel.textContent=workingFolder;workspaceLabel.title=workingFolder;updatePrompt();}setAvailability(available);renderConversation(message);}else if(message.type==="aiAttachmentAdded"){const attachment=pendingAttachments.find(item=>item.id===message.requestId);if(attachment){attachment.path=message.path;attachment.name=message.name;attachment.saving=false;renderAttachments();status.textContent="File attached. Add your explanation and choose Send.";}}else if(message.type==="aiAttachmentFailed"){const attachment=pendingAttachments.find(item=>item.id===message.requestId);if(attachment){attachment.saving=false;attachment.error=message.message||"Could not save file";renderAttachments();}status.textContent=message.message||"Could not save file.";}else if(message.type==="aiQueueAttachmentPreview"){if(queueEditor.open&&queueEditor.dataset.turnId===message.turnId){const figure=[...queueEditor.querySelectorAll('figure')].find(node=>node.dataset.path===message.path),image=figure?.querySelector('img');if(image&&message.dataUrl)image.src=message.dataUrl;}}else if(message.type==="aiQueueItemUpdated"){status.textContent="Queued request updated.";post("getAiConversationState");}else if(message.type==="aiQueueItemDeleted"){status.textContent="Request removed from the queue.";post("getAiConversationState");}else if(message.type==="aiRequestUpdated")status.textContent=message.external?"Request published. Keep the external Work task active and monitoring this folder.":`REQUEST.md updated in ${message.folder}. Upload the support pack when ready.`;else if(message.type==="aiPackFailed")status.textContent=message.message||"AI operation failed.";});
  }
  setupAiAssistant();
  const sourceLabel=document.querySelector(".query-summary dt");if(sourceLabel)sourceLabel.textContent="Source";
  const themeControls=CanvasThemeControls.install({model:()=>model,selected:selectedTile,selection:matchingSelectedObjects,changed:()=>{markDirty();render();}});window.addEventListener("qreports-settings-changed",()=>{if(!dirty&&!originalQrcn&&model.name==="Untitled report"&&!allObjects(page()).length){model=newDocument();model=normalize(model);resetHistory();}render();});setupUpdateMenu();setupAlignMenu();setupCanvasComponents();render();resetHistory();post("ready");
})();
