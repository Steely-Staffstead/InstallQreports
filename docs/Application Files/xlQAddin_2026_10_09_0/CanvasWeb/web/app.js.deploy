      panel.innerHTML=geometry+appearance+shape;return;
    }
    const targets=allObjects(page()).filter(item=>item.id!==t.id&&!["connector","line"].includes(item.kind)),choices=value=>`<option value="">Free endpoint</option>${targets.map(item=>`<option value="${item.id}" ${item.id===value?'selected':''}>${esc(item.title||item.kind)}</option>`).join('')}`;
    const styles=[['solid','Solid'],['dotted','Dotted'],['tightDotted','Tight dotted'],['dashed','Dashed'],['longDashed','Long dashed']];
    panel.innerHTML=`${geometry}<div class="property-grid"><label>Line color<input data-graphic="color" type="color" value="${CanvasTheme.resolve(t,model.settings.theme).color||'#475467'}" ${t.themeBindings?.color?"disabled":""}></label>${t.kind==='connector'?`<label class="check"><input data-graphic="useThemeColor" type="checkbox" ${t.themeBindings?.color?"checked":""}> Use canvas theme stroke</label>`:""}${t.kind==='rectangle'?`<label>Fill<input data-graphic="fill" type="color" value="${t.fill||'#ffffff'}" ${t.noFill?'disabled':''}></label>`:''}<label>Thickness<input data-graphic="thickness" type="number" min="1" max="20" value="${t.thickness||2}"></label><label>Line style<select data-graphic="lineStyle">${styles.map(([value,label])=>`<option value="${value}" ${value===(t.lineStyle||'solid')?'selected':''}>${label}</option>`).join('')}</select></label></div>${['line','rectangle'].includes(t.kind)?`<label>Line shading %<input data-graphic="shadePercent" type="range" min="0" max="100" step="5" value="${t.shadePercent||0}"><span>${t.shadePercent||0}%</span></label>`:''}${t.kind==='line'?`<label>Angle<input data-graphic="angle" type="number" min="-180" max="180" value="${t.angle||0}"></label>`:''}${t.kind==='rectangle'?`<label class="check"><input data-graphic="noFill" type="checkbox" ${t.noFill?'checked':''}> No fill (transparent)</label><label>Corner rounding %<input data-graphic="rounding" type="number" min="0" max="50" value="${t.rounding||0}"></label>`:''}${t.kind==='connector'?`<label>Start object<select data-graphic="fromId">${choices(t.fromId)}</select></label><label>End object<select data-graphic="toId">${choices(t.toId)}</select></label><div class="property-grid"><label>Start style<select data-graphic="startStyle">${['none','arrow','point','many'].map(v=>`<option ${v===t.startStyle?'selected':''}>${v}</option>`).join('')}</select></label><label>End style<select data-graphic="endStyle">${['none','arrow','point','many'].map(v=>`<option ${v===t.endStyle?'select