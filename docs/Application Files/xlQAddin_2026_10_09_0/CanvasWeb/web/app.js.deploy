  async function compressImageData(image,width,height,options){
    const crop=options.crop||{x:0,y:0,width:1,height:1};
    const sourceX=Math.round(crop.x*image.naturalWidth),sourceY=Math.round(crop.y*image.naturalHeight);
    const sourceWidth=Math.max(1,Math.min(image.naturalWidth-sourceX,Math.round(crop.width*image.naturalWidth)));
    const sourceHeight=Math.max(1,Math.min(image.naturalHeight-sourceY,Math.round(crop.height*image.naturalHeight)));
    const multiplier=options.resolution==='original'?Infinity:Number(options.resolution);
    const scale=Math.min(1,Math.min(Math.max(1,width)*multiplier/sourceWidth,Math.max(1,height)*multiplier/sourceHeight));
    const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(sourceWidth*scale));canvas.height=Math.max(1,Math.round(sourceHeight*scale));
    const context=canvas.getContext('2d');if(!context)throw Error('Image compression is unavailable.');
    if(options.format==='image/jpeg'){context.fillStyle='#fff';context.fillRect(0,0,canvas.width,canvas.height);}
    context.drawImage(image,sourceX,sourceY,sourceWidth,sourceHeight,0,0,canvas.width,canvas.height);
    const blob=await new Promise(resolve=>canvas.toBlob(resolve,options.format,Number(options.quality)/100));
    if(!blob)throw Error('The image could not be encoded.');
    const dataUrl=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(reader.error);reader.readAsDataURL(blob);});
    if(!dataUrl.startsWith(`data:${options.format};`))throw Error('This image format is not supported by the browser.');
    return {dataUrl,bytes:blob.size,width:canvas.width,height:canvas.height};
  }
  function askPasteImageCompression(){
    return new Promise(resolve=>{
      const dialog=document.createElement('dialog');dialog.className='picture-paste-dialog';
      dialog.innerHTML='<form method="dialog"><h2>Paste picture</h2><p>Compress this screenshot before adding it to the canvas?</p><div class="picture-compress-actions"><button value="original">No, keep original</button><button value="details">Go to Compress picture…</button><button value="compress" class="primary">Yes, compress</button></div></form>';
      document.body.append(dialog);
      dialog.addEventListener('close',()=>{const choice=dialog.returnValue||'cancel';dialog.remove();resolve(choice);},{once:true});
      dialog.showModal();dialog.querySelector(`[value="${window.QReportsSettings?.get()?.compressPastedImages===false?'original':'compress'}"]`)?.focus();
    });
  }
  async function pasteCanvasImage(file){
    if(file.size>20*1024*1024)throw new Error("Clipboard image is larger than 20 MB.");
    const dataUrl=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(reader.error);reader.readAsDataURL(file);});
    const image=new Image();image.src=dataUrl;await image.decode();
    const scale=Math.min(1,640/image.naturalWidth,480/image.naturalHeight);
    const choice=await askPasteImageCompression();if(choice==='cancel')return;
    const width=Math.max(30,Math.round(image.naturalWidth*scale)),height=Math.max(30,Math.round(image.naturalHeight*scale));
    let pastedText=dataUrl,compressionError='';
    if(choice==='compress'){
      const settings=window.QReportsSettings?.get()||{};
      try{
        const compressed=await compressImageData(image,width,height,{resolution:settings.pastedImageResolution||'1',format:settings.pastedImageFormat||'image/webp',quality:settings.pastedImageQuality||70});
        if(compressed.bytes<file.size)pastedText=compressed.dataUrl;
      }catch(error){compressionError=error.message;}
    }
    addTile("picture");
    const tile=selectedTile();
    tile.text=pastedText;
    tile.imageFileName=pastedText===dataUrl?"Pasted image":"Pasted image (compressed)";
    tile.imageSizing="fit";
    tile.showHeader=false;
    tile.hideScrollbars=true;
    tile.width=width;
    tile.height=height;
    markDirty();render();
    if(compressionError)$("#jsonError").textContent=`Image pasted without compression: ${compressionError}`;
    $("#saveStatus").textContent=tile.text===dataUrl?"Image pasted into canvas":"Compressed image pasted into canvas";
    if(choice==='details')openPictureCompression();
  }
  function returnToHost(){if(!hostMode)return;post(hostMode==="powerpoint"?"returnPowerPoint":"returnExcel",{document:model,qrcnDocument:webToQrcn()});}
  function preparePowerPointImport(message){
    if(Array.isArray(message.batchRequests)&&message.batchRequests.length)return;
    if(message.hostType!=="powerpoint"||!message.pageId)return;
    const index=model.pages.findIndex(item=>item.id===message.pageId);
    if(index<0){post("hostSelectionError",{message:"The selected page no longer exists."});return;}
    pageIndex=index;
    const targetPage=model.pages[index],filters=Array.isArray(message.importFilters)?message.importFilters:[];
    if(message.tileId){
      const tile=[...(targetPage.tiles||[]),...(targetPage.graphics||[])].find(item=>item.id===message.tileId);
      if(!tile){post("hostSelectionError",{message:"The selected tile no longer exists."});return;}
      const pageFilters=filters.filter(item=>item.scope==="page").map(item=>({...item,scope:undefined}));
      const tileFilters=filters.filter(item=>item.scope!=="page").map(item=>({...item,scope:undefined}));
      targetPage.filters=[...(targetPage.filters||[]),...pageFilters];
      tile.filters=[...(tile.filters||[]),...tileFilters];
      targetPage.tiles=[tile];targetPage.graphics=[];
      targetPage.canvas={mode:"manual",width:Math.max(1,Math.ceil(tile.width||300)),height:Math.max(1,Math.ceil(tile.height||180)),preset:targetPage.canvas?.preset||"1280x720"};
      tile.x=0;tile.y=0;
      targetPage.background={...targetPage.background,color:"#ffffff",image:""};
    }else targetPage.filters=[...(targetPage.filters||[]),...filters.map(item=>({...item,scope:undefined}))];
    model.pages=[targetPage];pageIndex=0;selectedId=null;selectedIds.clear();render();
  }
  function applyBridgeResult(msg) { if(msg.action==="local-sources-refresh"){document.body.classList.remove("busy");if(!msg.result.ok){refreshingAllSources=false;sourceRefreshQueue=[];returnAfterSourceRefresh=false;$("#jsonError").textContent=msg.result.error||"Underlying source update failed";return;}$("#saveStatus").textContent=`Updated ${msg.result.updated.length} underlying queries`;refreshNextSource();return;} document.body.classList.remove("busy"); const r = msg.result,targetSource=sourceById(msg.requestId)||activeSource();if(msg.action==="canvas-palettes"){if(r.ok){localPalettes=QReportsPalette.catalog(r.palettes);const merged=new Map((model.settings.palettes||[]).map(item=>[item.name,item]));localPalettes.forEach(item=>merged.set(item.name,item));model.settings.palettes=[...merged.values()];markDirty();renderCanvasTheme();renderChartProperties();renderExtendedChartQuickGroup();}else $("#jsonError").textContent=r.error||"Could not load personal palettes";return;}if(msg.action==="edit-query"&&parameterQueryDesigner){const pending=parameterQueryDesigner;parameterQueryDesigner=null;r.ok?pending.resolve(r.query):pending.reject(new Error(r.error||"Query designer was cancelled"));return;} if (r.cancelled) { $("#saveStatus").textContent = "Editor cancelled";if(refreshingAllSources){refreshingAllSources=false;sourceRefreshQueue=[];returnAfterSourceRefresh=false;}return; } if (!r.ok) { $("#jsonError").textContent = `${targetSource?.name||"Datasource"}: ${r.error||"Update failed"}`;if(refreshingAllSources){refreshingAllSources=false;sourceRefreshQueue=[];returnAfterSourceRefresh=false;}return; } const returnedParameters=r.parameters||r.query?.parameters;if(returnedParameters)setDocumentParameters(returnedParameters);let measureRenameSummary=null;if(r.measures){measureRenameSummary=window.CanvasMeasureReferences?.renameDocument(model,targetSource.id,r.renames||[]);targetSource.query.measures=r.measures;} if (r.query) { const savedFilters=targetSource.query.filters||[];targetSource.query = { ...targetSource.query, ...r.query, parameters:model.parameters, totalRows: r.totalRows ?? r.query.data?.rows?.length ?? 0, measureValues: r.measureValues || targetSource.query.measureValues || {}, filters:savedFilters }; } model.pages.forEach(item=>item.query=sourceById("main").query); const designTarget=msg.tileId?model.pages.flatMap(item=>item.tiles).find(tile=>tile.id===msg.tileId):selectedTile();if(r.design&&designTarget)designTarget.design=r.design; markDirty(); render(); $("#saveStatus").textContent = msg.action === "refresh" ? `Updated ${targetSource.query.data.rows.length}${targetSource.query.totalRows > targetSource.query.data.rows.length ? ` of ${targetSource.query.totalRows}` : ""} rows from ${targetSource.name}` : measureRenameSummary?.renamed?`Renamed ${measureRenameSummary.renamed} measure${measureRenameSummary.renamed===1?"":"s"} and updated ${measureRenameSummary.updatedObjects} report object${measureRenameSummary.updatedObjects===1?"":"s"}`:"Editor changes applied"; if(msg.action==="refresh"&&refreshingAllSources){refreshNextSource();return;} if(msg.action!=="refresh"&&r.query&&targetSource.query?.queryText&&targetSource.query?.measures?.length&&targetSource.query.totalRows>targetSource.query.data.rows.length&&host&&!refreshingAllSources){sourceRefreshQueue=[targetSource.id];refreshingAllSources=true;$("#saveStatus").textContent="Loading complete data for measures…";setTimeout(refreshNextSource,0);return;} if(autoReturnHost&&msg.action==="refresh")returnToHost(); }
  function renderRecentFiles(){const menu=$("#recentMenu"),withoutExtension=path=>path.replace(/\.canvasweb\.json$/i,""),displayName=path=>withoutExtension(path.split(/[\\/]/).pop());menu.innerHTML=recentFiles.length?recentFiles.map((path,index)=>`<button type="button" data-recent-index="${index}" title="${esc(path)}"><b>${esc(displayName(path))}</b><small>${esc(withoutExtension(path))}</small></button>`).join(""):`<div class="recent-empty">No recent reports</div>`;}
  function showSourceDialog({title,value="",message="",confirmText="Save",danger=false,onConfirm}){document.querySelector(".source-dialog")?.remove();const dialog=document.createElement("dialog");dialog.className="source-dialog filter-values-dialog";dialog.innerHTML=`<form method="dialog"><h2>${esc(title)}</h2>${message?`<p>${esc(message)}</p>`:`<label>Name<input data-source-name value="${esc(value)}" maxlength="80"></label>`}<div class="dialog-actions"><button value="cancel">Cancel</button><button value="apply" class="${danger?"danger":"primary"}">${esc(confirmText)}</button></div></form>`;document.body.append(dialog);dialog.addEventListener("close",()=>{if(dialog.returnValue==="apply"){const name=dialog.querySelector("[data-source-name]")?.value.trim()||"";if(message||name)onConfirm(name);}dialog.remove();});dialog.showModal();dialog.querySelector("[data-source-name]")?.focus();}
  function addGlobalSource(){showSourceDialog({title:"Add global datasource",value:`Global source ${model.sources.length}`,confirmText:"Add source",onConfirm:name=>{const source=blankSource(uid(),name,"global");source.query.parameters=model.parameters;model.sources.push(source);activeSourceId=source.id;selectedId=null;selectedIds.clear();markDirty();render();}});}
  function renameActiveSource(){const source=sourceById(activeSourceId);if(!source)return;showSourceDialog({title:"Rename datasource",value:source.name,onConfirm:name=>{if(source.kind==="gantt"){const tile=model.pages.flatMap(item=>item.tiles||[]).find(item=>item.id===source.tileId);if(tile?.design?.ganttSpec)tile.design.ganttSpec.publishedSourceName=name;}source.name=name;markDirty();render();}});}
  function deleteActiveSource(){const source=sourceById(activeSourceId);if(!source||source.kind==="main"){$("#jsonError").textContent="The Main source cannot be deleted.";return;}showSourceDialog({title:source.kind==="gantt"?"Stop exposing Gantt datasource":"Delete datasource",message:`Tiles using '${source.name}' will switch to Main source.`,confirmText:source.kind==="gantt"?"Stop exposing":"Delete",danger:true,onConfirm:()=>{model.pages.forEach(item=>allObjects(item).forEach(tile=>{if(tile.sourceId===source.id)tile.sourceId="main";}));if(source.kind==="gantt"){const tile=model.pages.flatMap(item=>item.tiles||[]).find(item=>item.id===source.tileId);if(tile?.design?.ganttSpec)tile.design.ganttSpec.publishAsSource=false;}model.sources=model.sources.filter(item=>item.id!==source.id);activeSourceId="main";markDirty();render();}});}
  async function resetMainSource(){
    const source=model.sources.find(item=>item.id==="main");if(!source)return;
    const affectedTiles=model.pages.flatMap(item=>allObjects(item)).filter(tile=>(tile.sourceId||"main")==="main"),pageFilterCount=model.pages.reduce((total,item)=>total+(item.filters||[]).filter(filter=>(filter.sourceId||"main")==="main").length,0),tileFilterCount=affectedTiles.reduce((total,tile)=>total+(tile.filters||[]).length,0),measureCount=source.query?.measures?.length||0,rowCount=source.query?.data?.rows?.length||0;
    const details=[rowCount?`${rowCount} loaded row${rowCount===1?"":"s"}`:"loaded data",measureCount?`${measureCount} measure${measureCount===1?"":"s"}`:"measures",pageFilterCount+tileFilterCount?`${pageFilterCount+tileFilterCount} related filter${pageFilterCount+tileFilterCount===1?"":"s"}`:"related filters"].join(", ");
    if(!await themedConfirm("Reset Main source",`Remove the connection, query, ${details} and cached previews from Main source? Canvas objects and other data sources will be kept.`,"Reset source"))return;
    const previewLimit=source.query?.previewLimit??window.QReportsSettings?.get().records??1000,replacement=blankQuery();replacement.previewLimit=previewLimit;replacement.parameters=model.parameters;replacement.measureValues={};source.query=replacement;
    for(const item of model.pages){item.query=replacement;item.filters=(item.filters||[]).filter(filter=>(filter.sourceId||"main")!=="main");for(const tile of allObjects(item)){if((tile.sourceId||"main")!=="main")continue;tile.filters=[];if(tile.design)delete tile.design.data;}}
    activeSourceId="main";markDirty();render();$("#saveStatus").textContent="Main source reset";
  }
  function invokeBridge(type,includeUnderlying=false) {const source=activeSource();if(source?.kind==="gantt"&&type!=="editMeasures"){$("#jsonError").textContent="Embedded Gantt sources are maintained from their Gantt tile. Edit tasks in the Gantt instead of refreshing or editing a query.";return;} if (!host) { $("#jsonError").textContent = "The existing QueryTool and Measures editor are available in the Windows desktop host. The hosted web version will use future web-native editors."; return; }document.body.dataset.busyLabel=type==="refresh"?"Updating…":"Opening editor…"; if(type==="refresh"&&autoReturnHost&&!refreshingAllSources)return refreshAllSources(true,includeUnderlying||window.includeUnderlyingHostRefresh===true);const payloadQuery=structuredClone(source?.query||query());if(type==="refresh")payloadQuery.filters=[];post(type, { requestId:source?.id||"main", query:payloadQuery,includeUnderlying,includeAllData:type==="refresh" }); }
  function refreshAllSources(returnWhenDone=false,includeUnderlying=false){sourceRefreshQueue=model.sources.filter(source=>source.query?.queryText).map(source=>source.id);returnAfterSourceRefresh=returnWhenDone;refreshingAllSources=true;selectedId=null;selectedIds.clear();if(includeUnderlying){post("localSourcesRefresh",{queries:model.sources.filter(source=>source.query?.queryText).map(source=>({...source.query,parameters:model.parameters||[]})),query:{parameters:model.parameters||[]},includeUnderlying:true});}else refreshNextSource();}
  function refreshNextSource(){if(!sourceRefreshQueue.length){refreshingAllSources=false;pendingExportRefresh?.resolve();pendingExportRefresh=null;if(returnAfterSourceRefresh){returnAfterSourceRefresh=false;returnToHost();}return;}activeSourceId=sourceRefreshQueue.shift();invokeBridge("refresh");}
  let pendingExportRefresh=null;
  async function ensureCompleteDataForExport(){
    const waitForRefresh=()=>new Promise((resolve,reject)=>{pendingExportRefresh={resolve,reject};});
    if(refreshingAllSources)await waitForRefresh();
    const incomplete=model.sources.filter(source=>Number(source.query?.totalRows)>Number(source.query?.data?.rows?.length||0));
    if(!incomplete.length)return;
    const unavailable=incomplete.filter(source=>!source.query?.queryText);
    if(unavailable.length)throw new Error(`Export needs all rows from ${unavailable.map(source=>source.name).join(', ')}. Refresh or replace this source first.`);
    sourceRefreshQueue=incomplete.map(source=>source.id);
    refreshingAllSources=true;
    $("#saveStatus").textContent=`Loading complete data for webpage export…`;
    const completed=waitForRefresh();
    refreshNextSource();
    await completed;
    const stillIncomplete=model.sources.filter(source=>Number(source.query?.totalRows)>Number(source.query?.data?.rows?.length||0));
    if(stillIncomplete.length)throw new Error(`Export needs all rows from ${stillIncomplete.map(source=>source.name).join(', ')}. The data refresh returned only a preview.`);
  }
  function setupUpdateMenu(){const button=document.querySelector('[data-action="refresh"]');if(!button||$("#updateMenu"))return;button.dataset.action="toggleUpdate";button.insertAdjacentHTML("beforeend","<small>▾</small>");const wrap=document.createElement("div");wrap.className="add-menu update-menu-wrap";button.before(wrap);wrap.append(button);wrap.insertAdjacentHTML("beforeend",'<div id="updateMenu" class="menu hidden"><button data-action="refreshSelected"><span>↻</span> Update selected source</button><button data-action="refreshAll"><span>↻</span> Update all sources</button><button data-action="refreshSelectedUnderlying"><span>↻</span> Update selected + underlying queries</button><button data-action="refreshAllUnderlying"><span>↻</span> Update all + underlying queries</button></div>');}
  const alignOptions=[
    ["left","⇤","Align left"],["center","↔","Align center"],["right","⇥","Align right"],
    ["top","↥","Align top"],["middle","↕","Align middle"],["bottom","↧","Align bottom"],
    ["distribute-horizontal","☷","Distribute horizontally"],["distribute-vertical","☰","Distribute vertically"]
  ];
  function alignableSelection(){return allObjects(page()).filter(item=>selectedIds.has(item.id)&&item.kind!=="connector");}
  function updateAlignMenu(){
    const button=$("#alignButton"),menu=$("#alignMenu");if(!button||!menu)return;
    const count=alignableSelection().length;button.disabled=count<2;button.title=count<2?"Select at least two tiles or graphics to align":"Align selected objects";
    if(count<2)menu.classList.add("hidden");
    menu.querySelectorAll("[data-align]").forEach(item=>item.disabled=count<(item.dataset.align.startsWith("distribute")?3:2));
    button.setAttribute("aria-expanded",String(!menu.classList.contains("hidden")));
  }
  function alignSelection(command){
    const items=alignableSelection();if(items.length<(command.startsWith("distribute")?3:2))return;
    const bounds=items.map(item=>({item,x:Number(item.x)||0,y:Number(item.y)||0,w:Math.max(0,Number(item.width)||0),h:Math.max(0,Number(item.height)||0)}));
    const left=Math.min(...bounds.map(box=>box.x)),right=Math.max(...bounds.map(box=>box.x+box.w));
    const top=Math.min(...bounds.map(box=>box.y)),bottom=Math.max(...bounds.map(box=>box.y+box.h));
    if(command.startsWith("distribute")){
      const horizontal=command==="distribute-horizontal",axis=horizontal?"x":"y",size=horizontal?"w":"h";
      const sorted=[...bounds].sort((a,b)=>(a[axis]+a[size]/2)-(b[axis]+b[size]/2));
      const first=sorted[0][axis]+sorted[0][size]/2,last=sorted.at(-1)[axis]+sorted.at(-1)[size]/2;
      sorted.slice(1,-1).forEach((box,index)=>box.item[axis]=Math.round(first+(last-first)*(index+1)/(sorted.length-1)-box[size]/2));
    }else bounds.forEach(box=>{
      if(command==="left")box.item.x=left;
      else if(command==="center")box.item.x=Math.round((left+right-box.w)/2);
      else if(command==="right")box.item.x=right-box.w;
      else if(command==="top")box.item.y=top;
      else if(command==="middle")box.item.y=Math.round((top+bottom-box.h)/2);
      else if(command==="bottom")box.item.y=bottom-box.h;
    });
    markDirty();render();
  }
  function setupAlignMenu(){
    const handles=document.querySelector('[data-action="toggleHandles"]');if(!handles||$("#alignButton"))return;
    const wrap=document.createElement("div");wrap.className="add-menu align-menu-wrap";
    wrap.innerHTML=`<button id="alignButton" type="button" class="command" aria-haspopup="menu" aria-controls="alignMenu" aria-expanded="false"><span>☷</span><b>Align</b></button><div id="alignMenu" class="menu align-menu hidden" role="menu" aria-label="Align selected objects">${alignOptions.map(([key,icon,label],index)=>`<button type="button" role="menuitem" data-align="${key}" ${index===3||index===6?'class="align-divider"':''}><span aria-hidden="true">${icon}</span>${label}</button>`).join("")}</div>`;
    handles.after(wrap);
    wrap.querySelector("#alignButton").addEventListener("click",event=>{const menu=$("#alignMenu");menu.classList.toggle("hidden");updateAlignMenu();event.stopPropagation();});
    wrap.querySelector("#alignMenu").addEventListener("click",event=>{const option=event.target.closest("[data-align]");if(!option||option.disabled)return;alignSelection(option.dataset.align);$("#alignMenu").classList.add("hidden");updateAlignMenu();event.stopPropagation();});
    document.addEventListener("pointerdown",event=>{if(!event.target.closest(".align-menu-wrap")){$("#alignMenu").classList.add("hidden");updateAlignMenu();}});
    document.addEventListener("keydown",event=>{if(event.key==="Escape"){$("#alignMenu").classList.add("hidden");updateAlignMenu();}});
    updateAlignMenu();
  }
  const componentStorageKey="qanvas-personal-components-v1";
  function personalComponents(){try{const entries=JSON.parse(localStorage.getItem(componentStorageKey)||"[]");return Array.isArray(entries)?entries.filter(entry=>entry?.id&&Array.isArray(entry.objects)):[];}catch{return[];}}
  function availableComponents(){return [...new Map([...personalComponents(),...(model.components||[])].map(entry=>[entry.id,entry])).values()];}
  function selectedComponentObjects(){const members=allObjects(page()).filter(item=>selectedIds.has(item.id)&&item.kind!=="connector"),ids=new Set(members.map(item=>item.id));return [...members,...(page().graphics||[]).filter(item=>item.kind==="connector"&&ids.has(item.fromId)&&ids.has(item.toId))];}
  function renderComponentMenu(){const menu=$("#componentMenu"),button=$("#componentButton");if(!menu||!button)return;const entries=availableComponents();menu.innerHTML=`<button type="button" data-component-save ${selectedComponentObjects().some(item=>item.kind!=="connector")?"":"disabled"}>＋ Save selected as component…</button><div class="component-menu-heading">Personal components</div>${entries.length?entries.map(entry=>`<div class="component-menu-row"><button type="button" data-component-insert="${esc(entry.id)}" title="Insert ${esc(entry.name)}"><span>${entry.objects.length>1?"▣":entry.objects[0]?.kind==="svgGraphic"?"◇":"▢"}</span>${esc(entry.name)}</button><button type="button" data-component-remove="${esc(entry.id)}" title="Remove saved component">×</button></div>`).join(""):'<p class="component-menu-empty">Save a selected tile, graphic, or group to reuse it on another page or canvas.</p>'}<p class="component-menu-note">Inserted copies can be edited independently.</p>`;}
  function saveSelectedComponent(){
    const selected=selectedComponentObjects(),members=selected.filter(item=>item.kind!=="connector");if(!members.length)return;
    showSourceDialog({title:"Save reusable component",value:members.length===1?members[0].title||members[0].kind:`${members.length} objects`,confirmText:"Save component",onConfirm:name=>{
      const left=Math.min(...members.map(item=>Number(item.x)||0)),top=Math.min(...members.map(item=>Number(item.y)||0));
      const objects=selected.map(item=>{const copy=structuredClone(item);copy.x=(Number(copy.x)||0)-left;copy.y=(Number(copy.y)||0)-top;if(copy.design?.data)delete copy.design.data;delete copy.legacy;return copy;});
      const entry={id:uid(),name,objects};model.components||=[];model.components.push(entry);
      try{localStorage.setItem(componentStorageKey,JSON.stringify([...personalComponents(),entry]));}catch{$("#saveStatus").textContent="Component saved in this canvas; personal storage is full or unavailable.";}
      markDirty();renderComponentMenu();
    }});
  }
  function insertComponent(id){
    const entry=availableComponents().find(item=>item.id===id);if(!entry)return;
    const idMap=new Map(entry.objects.map(item=>[item.id,uid()])),offset=allObjects(page()).length*12,baseX=40+offset,baseY=40+offset;
    const added=[];for(const source of entry.objects){const copy=structuredClone(source);copy.id=idMap.get(source.id);copy.x=baseX+(Number(source.x)||0);copy.y=baseY+(Number(source.y)||0);copy.layer=Math.max(-1,...allObjects(page()).map(item=>Number(item.layer)||0))+1;if(copy.sourceId&&!model.sources?.some(item=>item.id===copy.sourceId))copy.sourceId=activeSourceId||"main";if(copy.kind==="connector"){copy.fromId=idMap.get(source.fromId)||"";copy.toId=idMap.get(source.toId)||"";copy.fromAnchor=null;copy.toAnchor=null;}else copy.title=duplicateName(source).title;(graphicKinds.has(copy.kind)?page().graphics:page().tiles).push(copy);added.push(copy);}
    selectedIds=new Set(added.filter(item=>item.kind!=="connector").map(item=>item.id));selectedId=[...selectedIds].at(-1)||added.at(-1)?.id||null;$("#componentMenu").classList.add("hidden");markDirty();render();
  }
  function setupCanvasComponents(){
    if(!$("#graphicsMenu").querySelector('[data-add-tile="pageLink"]'))$("#graphicsMenu").insertAdjacentHTML("afterbegin",'<button data-add-tile="pageLink">↗ <span>Action</span></button>');
    let pageLinkSelection=null;
    const savePageLinkSelection=editor=>{
      const selection=window.getSelection();if(!selection?.rangeCount)return;
      const range=selection.getRangeAt(0);if(!editor.contains(range.commonAncestorContainer))return;
      const before=range.cloneRange();before.selectNodeContents(editor);before.setEnd(range.startContainer,range.startOffset);
      pageLinkSelection={editor,start:before.toString().length,end:before.toString().length+range.toString().length};
    };
    const pageLinkTextRange=(editor,start,end)=>{
