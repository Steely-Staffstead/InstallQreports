  function matrixVisualVars(t){return `--visual-header:${t.appearance?.headerColor||"#f5f7fa"};--visual-row-header:${t.appearance?.rowHeaderColor||"#f5f7fa"};--visual-total-row:${t.appearance?.totalRowColor||"#eef2f7"};--visual-alt:${t.appearance?.alternateColor||"#ffffff"};--visual-text:${t.appearance?.textColor||"#182230"};--visual-grid:${t.appearance?.gridColor||"#e1e6ec"};--visual-font:${t.appearance?.fontFamily||"Segoe UI"};--visual-size:${Math.max(8,+t.appearance?.fontSize||12)}px;--visual-weight:${t.appearance?.bold?700:400};--visual-style:${t.appearance?.italic?"italic":"normal"};--visual-decoration:${t.appearance?.underline?"underline":"none"};`;}
  function textBoxShapeHtml(t){
    const shape=t.boxShape||"rectangle";
    if(!t.boxed||shape==="rectangle")return"";
    const w=Math.max(30,+t.width||320),h=Math.max(30,+t.height||100),inset=Math.max(1,(+t.borderThickness||1)/2),cx=w/2,cy=h/2,rx=cx-inset,ry=cy-inset;
    const geometry=shape==="circle"?`<circle cx="${cx}" cy="${cy}" r="${Math.min(rx,ry)}"/>`:shape==="oval"?`<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${ry}"/>`:shape==="diamond"?`<polygon points="${cx},${inset} ${w-inset},${cy} ${cx},${h-inset} ${inset},${cy}"/>`:shape==="cylinder"?`<path d="M ${inset} ${h*.14} C ${inset} ${-h*.04} ${w-inset} ${-h*.04} ${w-inset} ${h*.14} L ${w-inset} ${h*.86} C ${w-inset} ${h*1.04} ${inset} ${h*1.04} ${inset} ${h*.86} Z"/><path d="M ${inset} ${h*.14} C ${inset} ${h*.32} ${w-inset} ${h*.32} ${w-inset} ${h*.14}" fill="none"/>`:shape==="tablet"?`<rect x="${inset}" y="${inset}" width="${w-2*inset}" height="${h-2*inset}" rx="${Math.min(ry,w*.18)}"/>`:shape==="document"?`<path d="M ${inset} ${inset} H ${w-inset} V ${h*.84} Q ${w*.75} ${h*.72} ${cx} ${h*.84} Q ${w*.25} ${h*.96} ${inset} ${h*.84} Z"/>`:shape==="inputOutput"?`<polygon points="${w*.16},${inset} ${w-inset},${inset} ${w*.84},${h-inset} ${inset},${h-inset}"/>`:shape==="predefinedProcess"?`<rect x="${inset}" y="${inset}" width="${w-2*inset}" height="${h-2*inset}"/><path d="M ${w*.1} ${inset} V ${h-inset} M ${w*.9} ${inset} V ${h-inset}" fill="none"/>`:shape==="preparation"?`<polygon points="${w*.17},${inset} ${w*.83},${inset} ${w-inset},${cy} ${w*.83},${h-inset} ${w*.17},${h-inset} ${inset},${cy}"/>`:shape==="callout"?`<path d="M ${w*.12} ${inset} H ${w-inset} V ${h*.76} H ${w*.3} L ${w*.16} ${h-inset} V ${h*.76} H ${inset} V ${h*.14} Q ${inset} ${inset} ${w*.12} ${inset} Z"/>`:"";
    if(!geometry)return"";
    return `<svg class="text-box-shape" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" aria-hidden="true"><g fill="${t.background||"#ffffff"}" stroke="${t.noBorder?"none":t.borderColor||"#cbd5e1"}" stroke-width="${Math.max(1,+t.borderThickness||1)}" vector-effect="non-scaling-stroke">${geometry}</g></svg>`;
  }
  function supportsCornerRounding(t){return !["line","connector","svgGraphic","pageLink","layoutPlaceholder","valueSelector"].includes(t.kind)&&(t.kind!=="graphicText"||t.boxed&&(!t.boxShape||t.boxShape==="rectangle"));}
  function cornerHandleLeft(t,radius){return Math.max(15,Math.min((+t.width||30)-15,18+radius));}
  function updateCornerGeometry(node,t){const rounding=Math.max(0,Math.min(50,+t.rounding||0)),radius=Math.round(Math.min(+t.width||1,+t.height||1)*rounding/100);node.style.borderRadius=`${radius}px`;const handle=node.querySelector("[data-corner-rounding]");if(handle){handle.style.left=`${cornerHandleLeft(t,radius)}px`;handle.setAttribute("aria-valuenow",String(rounding));}if(t.kind==="rectangle"){const rectangle=node.querySelector(".graphic-svg rect");rectangle?.setAttribute("rx",String(radius));rectangle?.setAttribute("ry",String(radius));}}
