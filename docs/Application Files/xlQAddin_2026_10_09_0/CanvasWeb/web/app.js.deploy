      if(header){const field=header.dataset.tileSort;if(groups.includes(field)){selectedGroup=field;groupFormatOpen=true;draw();requestAnimationFrame(()=>options.querySelector('.table-group-format')?.scrollIntoView({block:'start'}));return;}if(!state.some(item=>item.field===field&&item.visible))return;selectedField=field;columnFormatOpen=true;const section=options.querySelector('.table-column-format');if(section)section.open=true;draw();requestAnimationFrame(()=>options.querySelector('.table-column-format')?.scrollIntoView({block:'start'}));return;}
      const area=row?.dataset.tablePreviewArea;if(!areas.some(([key])=>key===area))return;selectedTableArea=area;tableFormatOpen=true;const section=options.querySelector('.table-visual-styling');if(section)section.open=true;draw();requestAnimationFrame(()=>options.querySelector('.table-visual-styling')?.scrollIntoView({block:'start'}));
    },true);
