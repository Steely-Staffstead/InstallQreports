    const enhanceGanttOptions=()=>{
      const schedule=[...options.querySelectorAll("details")].find(section=>section.querySelector("summary")?.textContent==="Schedule fields");
      if(schedule&&!schedule.querySelector('[data-gantt-setting="description"]'))schedule.insertAdjacentHTML("beforeend",`<label>Description<select data-gantt-setting="description">${fieldChoices(activeData().columns||[],draft.description,true)}</select></label>`);
      for(const[key,label]of [["plannedHours","Planned hours"],["registeredHours","Hours used"]])if(schedule&&!schedule.querySelector(`[data-gantt-setting="${key}"]`))schedule.insertAdjacentHTML("beforeend",`<label>${label}<select data-gantt-setting="${key}">${fieldChoices(activeData().columns||[],draft[key],true)}</select></label>`);
