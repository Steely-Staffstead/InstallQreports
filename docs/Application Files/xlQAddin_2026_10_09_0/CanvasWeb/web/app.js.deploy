    overlay.addEventListener('pointerdown',event=>{if(formatMenu&&!event.target.closest('.matrix-format-menu'))closeFormatMenu();});
    overlay.addEventListener('keydown',event=>{if(event.key==='Escape')closeFormatMenu();});
