  function enhanceStyleToolbar(root,attribute,previewText,{selectors={},alignValue="left",before}={}){
    const find=key=>root.querySelector(selectors[key]||`[data-${attribute}="${key}"]`),existing=root.querySelector(":scope > .compact-format-panel, :scope > details > .compact-format-panel, :scope > section > .compact-format-panel");
    if(existing){const alignment=find("alignment");if(alignment)alignment.value=alignValue;existing.querySelector(".compact-format-preview").textContent=previewText;existing._refresh?.();return existing;}
    const controls=Object.fromEntries(["fontFamily","fontSize","textColor","background","bold","italic","underline","alignment"].map(key=>[key,find(key)]));
    if(!controls.fontFamily||!controls.fontSize||!controls.textColor||!controls.background)return null;
    if(!controls.alignment){const select=document.createElement("select");select.dataset[attribute.replace(/-([a-z])/g,(_,letter)=>letter.toUpperCase())]="alignment";select.innerHTML='<option value="left">Left</option><option value="center">Center</option><option value="right">Right</option>';root.append(select);controls.alignment=select;}
    controls.alignment.value=alignValue;
    const toolbar=document.createElement("div");toolbar.className="compact-format-panel";toolbar.innerHTML='<div class="compact-format-toolbar"><button type="button" data-format-toggle="bold" title="Bold" aria-label="Bold"><b>B</b></button><button type="button" data-format-toggle="italic" title="Italic" aria-label="Italic"><i>I</i></button><button type="button" data-format-toggle="underline" title="Underline" aria-label="Underline"><u>U</u></button><span data-format-slot="fontFamily"></span><span data-format-slot="fontSize"></span><span data-format-slot="textColor"></span><span data-format-slot="background"></span><button type="button" data-format-align="left" title="Align left" aria-label="Align left">⇤</button><button type="button" data-format-align="center" title="Align center" aria-label="Align center">↔</button><button type="button" data-format-align="right" title="Align right" aria-label="Align right">⇥</button></div><div class="compact-format-preview"></div><div class="compact-format-hidden"></div>';
    for(const [key,input] of Object.entries(controls)){if(!input)continue;const oldLabel=input.closest("label"),slot=toolbar.querySelector(`[data-format-slot="${key}"]`)||toolbar.querySelector(".compact-format-hidden");slot.append(input);if(oldLabel&&!oldLabel.contains(toolbar)&&!oldLabel.querySelector("input,select,textarea"))oldLabel.remove();input.setAttribute("aria-label",{fontFamily:"Font",fontSize:"Text size",textColor:"Text color",background:"Background color",alignment:"Alignment"}[key]||key);input.title=input.getAttribute("aria-label");if(["bold","italic","underline","alignment"].includes(key))input.tabIndex=-1;}
    (before||root.firstElementChild)?.after(toolbar);if(!toolbar.isConnected)root.prepend(toolbar);
    const preview=toolbar.querySelector(".compact-format-preview");preview.textContent=previewText;
    const update=()=>{preview.style.fontFamily=controls.fontFamily.value;preview.style.fontSize=`${Math.max(8,+controls.fontSize.value||12)}px`;preview.style.color=controls.textColor.value;preview.style.backgroundColor=controls.background.value;preview.style.fontWeight=controls.bold?.checked?"700":"400";preview.style.fontStyle=controls.italic?.checked?"italic":"normal";preview.style.textDecoration=controls.underline?.checked?"underline":"none";preview.style.textAlign=controls.alignment.value;toolbar.querySelectorAll("[data-format-toggle]").forEach(button=>button.setAttribute("aria-pressed",String(!!controls[button.dataset.formatToggle]?.checked)));toolbar.querySelectorAll("[data-format-align]").forEach(button=>button.setAttribute("aria-pressed",String(button.dataset.formatAlign===controls.alignment.value)));};
    toolbar._refresh=update;toolbar.addEventListener("input",update);toolbar.addEventListener("change",update);toolbar.addEventListener("click",event=>{const toggle=event.target.closest("[data-format-toggle]"),align=event.target.closest("[data-format-align]");if(toggle&&controls[toggle.dataset.formatToggle]){const input=controls[toggle.dataset.formatToggle];input.checked=!input.checked;input.dispatchEvent(new Event("change",{bubbles:true}));}else if(align){controls.alignment.value=align.dataset.formatAlign;controls.alignment.dispatchEvent(new Event("change",{bubbles:true}));}update();});update();return toolbar;
  }
  function renderHeaderProperties(){let panel=$("#headerSettings");if(!panel){panel=document.createElement("details");panel.id="headerSettings";panel.innerHTML='<summary>Header settings</summary><label class="check"><input data-header="showHeader" type="checkbox"> Show header</label><label>Background color<input data-header="background" type="color"></label><label>Alignment<select data-header="alignment"><option value="left">Left</option><option value="center">Middle</option><option value="right">Right</option></select></label><div class="property-grid"><label>Font<select data-header="fontFamily"><option>Segoe UI</option><option>Arial</option><option>Calibri</option><option>Georgia</option><option>Consolas</option></select></label><label>Size<input data-header="fontSize" type="number" min="8" max="72"></label></div><label>Text color<input data-header="color" type="color"></label><div class="header-emphasis"><label class="check"><input data-header="bold" type="checkbox"> Bold</label><label class="check"><input data-header="italic" type="checkbox"> Italic</label><label class="check"><input data-header="underline" type="checkbox"> Underline</label></div>';const title=$("#tileTitle")?.closest("label");title?.after(panel);panel.addEventListener("change",event=>{const t=selectedTile(),key=event.target.dataset.header;if(!t||!key)return;if(key==="showHeader")t.showHeader=event.target.checked;else{t.header||={};if((key==="background"||key==="color")&&!model.settings.theme?.requireColors)delete t.themeBindings?.[`header.${key}`];t.header[key]=event.target.type==="checkbox"?event.target.checked:key==="fontSize"?Math.max(8,+event.target.value||13):event.target.value;}markDirty();render();});}const t=selectedTile(),visible=t&&!graphicKinds.has(t.kind);panel.classList.toggle("hidden",!visible);$("#tileHeader")?.closest("label")?.classList.add("hidden");if(!visible)return;const themed=CanvasTheme.resolve(t,model.settings.theme);panel.querySelector('[data-header="showHeader"]').checked=t.showHeader!==false;panel.querySelector('[data-header="background"]').value=themed.header?.background||"#f3f6fa";panel.querySelector('[data-header="alignment"]').value=t.header?.alignment||"left";panel.querySelector('[data-header="fontFamily"]').value=t.header?.fontFamily||"Segoe UI";panel.querySelector('[data-header="fontSize"]').value=t.header?.fontSize||13;panel.querySelector('[data-header="color"]').value=themed.header?.color||"#182230";panel.querySelector('[data-header="bold"]').checked=t.header?.bold!==false;panel.querySelector('[data-header="italic"]').checked=!!t.header?.italic;panel.querySelector('[data-header="underline"]').checked=!!t.header?.underline;enhanceStyleToolbar(panel,"header",t.title||"Header",{selectors:{textColor:'[data-header="color"]'},alignValue:t.header?.alignment||"left",before:panel.querySelector('summary')});}
  function renderLayerProperties(){let panel=$("#layerProperties");if(!panel){panel=document.createElement("details");panel.id="layerProperties";panel.innerHTML="<summary>Layer information</summary>";panel.addEventListener("change",event=>{const t=selectedTile();if(!t||event.target.id!=="tileLayer")return;t.layer=Math.max(0,+event.target.value||0);markDirty();render();});}const t=selectedTile();panel.classList.toggle("hidden",!t);if(t){panel.innerHTML=`<summary>Layer information</summary><label>Object ID<input type="text" value="${esc(t.id)}" readonly></label><label>Order<input id="tileLayer" type="number" min="0" value="${t.layer??0}"></label>`;$("#tileProperties")?.append(panel);}}
  function renderVisualProperties(){let panel=$("#visualAppearance");if(!panel){panel=document.createElement("details");panel.id="visualAppearance";panel.className="visual-appearance";panel.innerHTML='<summary>Table / Matrix settings</summary><p class="property-empty">Base font, grid and colors. The designer can override each area.</p><button type="button" data-appearance-palette>Use canvas palette for base colors</button><div class="property-grid"><label>Column header<input data-appearance="headerColor" type="color"></label><label class="matrix-only-style">Row header<input data-appearance="rowHeaderColor" type="color"></label><label class="matrix-only-style">Total row<input data-appearance="totalRowColor" type="color"></label><label>Alternate rows<input data-appearance="alternateColor" type="color"></label><label>Text color<input data-appearance="textColor" type="color"></label><label>Grid color<input data-appearance="gridColor" type="color"></label></div><label class="check"><input data-appearance="showGrid" type="checkbox"> Show cell grid</label><label class="check"><input data-appearance="showTotals" type="checkbox"> Show totals row</label><label class="check"><input data-appearance="hideScrollbars" type="checkbox"> Hide scrollbars</label>';$("#tileProperties")?.append(panel);panel.addEventListener("click",event=>{if(!event.target.matches("[data-appearance-palette]"))return;const tile=selectedTile();if(!["table","matrix"].includes(tile?.kind))return;tile.appearance.colorOverrides={};markDirty();render();});panel.addEventListener("change",event=>{const key=event.target.dataset.appearance,t=selectedTile();if(!key||!["table","matrix"].includes(t?.kind))return;t.appearance||={};t.appearance[key]=event.target.type==="checkbox"?event.target.checked:event.target.value;if(event.target.type==="color"){t.appearance.colorOverrides||={};t.appearance.colorOverrides[key]=true;if(t.themeBindings)delete t.themeBindings[`appearance.${key}`];}markDirty();render();});}if(!panel.qu