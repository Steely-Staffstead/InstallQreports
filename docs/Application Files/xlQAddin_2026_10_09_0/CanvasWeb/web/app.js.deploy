    menu.addEventListener("wheel",wheel=>{const input=wheel.target.closest?.('input[type="number"]');if(!input||!menu.contains(input)||input.disabled)return;wheel.preventDefault();wheel.deltaY<0?input.stepUp():input.stepDown();input.dispatchEvent(new Event("change",{bubbles:true}));},{passive:false});
