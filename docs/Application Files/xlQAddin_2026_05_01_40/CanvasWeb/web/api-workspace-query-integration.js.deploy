chrome.webview.addEventListener('message',event=>{
  const message=event.data;
  if(message.type==='apiWorkspaceContext')$('returnExcel').textContent=message.returnTarget==='query'?'Return to Query Tool':'Return to Excel';
});
let loopConnectionNames=[];
function syncLoopConnection(){
  if(($('pagingEnabled').checked||$('loopEnabled').checked)&&!$('loopConnection').value.trim())$('loopConnection').value=loopConnectionNames[0]||$('connection').value;
}
$('pagingEnabled').addEventListener('change',syncLoopConnection);
$('loopEnabled').addEventListener('change',syncLoopConnection);
$('connection').addEventListener('change',syncLoopConnection);
$('designLoopQuery').addEventListener('click',async()=>{
  try{
    const result=await post('apiDesignLoopQuery',{query:{connectionName:$('loopConnection').value||$('connection').value,queryText:$('loopQuery').value,previewLimit:1000,measures:[],parameters:[],data:{columns:[],rows:[]}}});
    if(result.query){$('loopConnection').value=result.query.connectionName||$('loopConnection').value;$('loopQuery').value=result.query.queryText||'';}
  }catch(error){if(!/cancel/i.test(error.message))toast(error.message);}
});
const loopList=document.createElement('datalist');loopList.id='loopConnections';document.body.append(loopList);$('loopConnection').setAttribute('list',loopList.id);
post('queryConnections').then(result=>{
  loopConnectionNames=(result.connections||[]).filter(item=>String(item.kind||'').toLowerCase()!=='api').map(item=>item.name);
  loopList.innerHTML=loopConnectionNames.map(name=>`<option value="${esc(name)}"></option>`).join('');syncLoopConnection();
}).catch(()=>{});
let pendingQueryApiSpec=null,queryApiSpecBase=null,apiBootstrapLoaded=false;
const loadQueryApiBase=load;
load=async function(){await loadQueryApiBase();apiBootstrapLoaded=true;applyQueryApiSpec();};
function applyQueryApiSpec(){
 if(!apiBootstrapLoaded||!pendingQueryApiSpec)return;const s=pendingQueryApiSpec;pendingQueryApiSpec=null;queryApiSpecBase=structuredClone(s);
 const rows=value=>Array.isArray(value)?value:Object.entries(value||{}).map(([Key,Value])=>({Enabled:true,Key,Value:String(Value??'')}));
 const saved=endpoints.find(e=>e.ConnectionName===s.Connection&&e.Name===s.Name)||{};
 selectEndpoint({...saved,ConnectionName:s.Connection||saved.ConnectionName||$('connection').value,Name:s.Name||saved.Name||'Request',Method:s.Method||saved.Method||'GET',RelativePath:s.Path??saved.RelativePath??'',Headers:rows(s.Headers??saved.Headers),Query:rows(s.Query??saved.Query),FormFields:rows(s.FormFields??saved.FormFields),BodyText:s.Body??saved.BodyText??'',ContentType:s.ContentType??saved.ContentType,BodyMode:s.BodyMode??saved.BodyMode,RawFormat:s.RawFormat??saved.RawFormat,GraphQLQuery:s.GraphQLQuery??saved.GraphQLQuery,GraphQLVariables:typeof s.GraphQLVariables==='object'?JSON.stringify(s.GraphQLVariables):s.GraphQLVariables??saved.GraphQLVariables,Flatten:s.Flatten??saved.Flatten,ColumnAliases:s.ColumnAliases??saved.ColumnAliases,ExcludedColumns:s.ExcludedColumns??saved.ExcludedColumns,PostFilterText:s.PostFilterText??saved.PostFilterText,Pagination:s.Pagination??saved.Pagination,LoopSpec:s.LoopSpec??saved.LoopSpec});
}
chrome.webview.addEventListener('message',event=>{if(event.data.type==='apiWorkspaceContext'&&event.data.spec){pendingQueryApiSpec=event.data.spec;applyQueryApiSpec();}});
const queryApiReturnSpecBase=spec;
spec=()=>({...queryApiSpecBase,...queryApiReturnSpecBase()});
