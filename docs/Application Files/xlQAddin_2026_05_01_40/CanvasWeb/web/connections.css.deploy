:root{font-family:"Segoe UI",Arial,sans-serif;color:#18233b;background:#eef2f8;font-size:15px}*{box-sizing:border-box}body{margin:0;height:100vh;display:grid;grid-template-rows:auto 1fr;overflow:hidden}button,input,select,textarea{font:inherit}button{border:1px solid #c7d0df;background:#fff;color:#243154;border-radius:9px;padding:9px 14px;cursor:pointer}button:hover{background:#f2f5fa}.primary{background:#5274df;color:#fff;border-color:#5274df}.danger{color:#a83d3d;border-color:#e4bebe}header{height:92px;background:#243154;color:#fff;display:flex;align-items:center;padding:18px 28px;gap:28px}.brand{display:flex;align-items:center;gap:13px;min-width:245px}.brand>span{display:grid;place-items:center;width:48px;height:48px;background:#6385ed;border-radius:13px;font-size:27px;font-weight:800}.brand strong{display:block;font-size:21px}.brand small{display:block;color:#d5ddf3;margin-top:2px}nav{display:flex;gap:8px;flex-wrap:wrap;margin-left:auto}nav button{background:#334265;color:white;border-color:#596886}nav .primary{background:#6385ed}main{display:grid;grid-template-columns:minmax(300px,26vw) 1fr;min-height:0}aside{background:#f8fafc;border-right:1px solid #d7deea;overflow:auto;padding:24px}.aside-head h2,.editor h1{margin:0}.aside-head p,.editor-head p,.modal-head p{color:#6d7890;margin:5px 0 16px}.aside-head input{width:100%;padding:10px;border:1px solid #cbd4e2;border-radius:8px}.connection-list{display:grid;gap:8px;margin-top:15px}.connection-item{background:white;border:1px solid #d6deea;border-radius:11px;padding:13px;cursor:pointer}.connection-item.active{border-color:#6385ed;background:#eef3ff;box-shadow:0 0 0 1px #6385ed}.connection-item strong{display:block}.connection-item small{display:flex;justify-content:space-between;color:#778299;margin-top:6px}.editor{overflow:auto;padding:28px 34px}.editor-head{display:flex;justify-content:space-between;align-items:start}.status{padding:7px 12px;border-radius:99px;background:#e8edf6;color:#5d6980}.status.busy{background:#fff1cd;color:#785a00}.status.ok{background:#dff4e6;color:#256238}.summary-grid,.form-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:15px}.form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.wide{grid-column:1/-1}label{display:grid;gap:6px;color:#56647e}input,select,textarea{width:100%;border:1px solid #c6d0e0;border-radius:8px;padding:10px 11px;background:white;color:#18233b}textarea{resize:vertical;font-family:Consolas,monospace;line-height:1.45}.tabs{display:flex;margin-top:26px;border-bottom:1px solid #ccd5e3}.tabs button{border:0;border-radius:0;background:transparent;padding:12px 18px}.tabs button.active{color:#3458c4;border-bottom:3px solid #5274df;font-weight:650}.panel{background:white;border:1px solid #d6deea;border-top:0;padding:24px;border-radius:0 0 12px 12px}.help{color:#738098}.check{display:flex;align-items:center;gap:9px}.check input{width:auto}.input-button{display:flex;gap:8px}.input-button input{flex:1}.panel-actions,.form-actions{display:flex;gap:10px;margin-top:20px}.danger-zone{margin-top:22px;padding-top:18px;border-top:1px solid #d7deea}.hidden{display:none!important}.modal{position:fixed;inset:0;background:rgba(16,25,46,.55);backdrop-filter:blur(3px);display:grid;place-items:center;padding:24px}.modal-card{width:min(1050px,95vw);height:min(720px,92vh);background:#f8fafc;border-radius:17px;box-shadow:0 30px 90px rgba(0,0,0,.35);display:grid;grid-template-rows:auto 1fr;overflow:hidden}.modal-head{display:flex;justify-content:space-between;align-items:start;padding:20px 24px;background:#243154;color:white}.modal-head h2{margin:0}.modal-head p{color:#cbd5e1;margin-bottom:0}.modal-head button{background:transparent;color:white;font-size:22px;border-color:#607092}.secret-layout{display:grid;grid-template-columns:1fr 1fr;min-height:0}.secret-layout>div,.secret-editor{padding:22px;overflow:auto}.secret-layout>div{border-right:1px solid #d7deea}.secret-list{display:grid;gap:8px;margin-top:14px}.secret-item{padding:12px;background:white;border:1px solid #d6deea;border-radius:9px;cursor:pointer}.secret-item.active{border-color:#6385ed;background:#eef3ff}.secret-item small{display:block;color:#738098;margin-top:4px}.secret-editor{display:grid;align-content:start;gap:14px}.secret-editor h3{margin:0}.toast{position:fixed;right:26px;bottom:24px;max-width:460px;padding:13px 17px;background:#17213a;color:white;border-radius:10px;box-shadow:0 10px 35px rgba(0,0,0,.25)}@media(max-width:850px){header{height:auto;align-items:start}.brand{min-width:180px}main{grid-template-columns:1fr}aside{max-height:240px}.summary-grid,.form-grid{grid-template-columns:1fr}.secret-layout{grid-template-columns:1fr}.secret-layout>div{max-height:260px;border-right:0;border-bottom:1px solid #d7deea}}
