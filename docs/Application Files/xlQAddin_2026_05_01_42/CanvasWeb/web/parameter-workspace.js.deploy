let parameters=[],sheetNames=[],lookupSequence=0,lookups=new Map(),workspaceLoaded=false,readyTimer=null,lookupDesigner=null;
function post(type,payload={}){chrome.webview.postMessage({type,...payload})}
function designLookup(query){return new Promise((resolve,reject)=>{lookupDesigner={resolve,reject};post('parameterDesignLookup',{query})})}
function openManager(direct=false){ParameterWeb.openManager({parameters,sheetNames,onSave:items=>{parameters=items;openInput()},onCancel:()=>direct?post('parameterCancel'):openInput(),onDesignLookup:designLookup})}
function openInput(){ParameterWeb.openInput({parameters,sheetNames,lookup:parameter=>new Promise((resolve,reject)=>{const requestId=`lookup-${++lookupSequence}`;lookups.set(requestId,{resolve,reject});post('parameterLookup',{requestId,query:{parameters},parameter})}),onDesignLookup:designLookup,onManage:items=>{parameters=items;openInput()},onManagerCancel:()=>openInput(),onApply:(items,refresh)=>{parameters=items;post('parameterApply',{parameters,refresh})},onCancel:()=>post('parameterCancel')})}
chrome.webview.addEventListener('message',event=>{if(event.data?.type==='loadParameterWorkspace')sheetNames=event.data.sheetNames||[]});
chrome.webview.addEventListener('message',event=>{const message=event.data;if(message.type==='loadParameterWorkspace'){if(workspaceLoaded)return;workspaceLoaded=true;clearInterval(readyTimer);document.getElementById('parameterLoading')?.remove();parameters=message.parameters||[];message.initialView==='manager'?openManager(true):openInput()}else if(message.type==='bridgeResult'&&message.action==='parameter-lookup'){const pending=lookups.get(message.requestId);if(!pending)return;lookups.delete(message.requestId);if(!message.result?.ok)return pending.reject(new Error(message.result?.error||'Lookup failed'));pending.resolve(lookupChoices(message.result))}else if(message.type==='bridgeResult'&&message.action==='edit-query'&&lookupDesigner){const pending=lookupDesigner;lookupDesigner=null;message.result?.ok?pending.resolve(message.result.query):pending.reject(new Error(message.result?.error||'Query designer was cancelled'))}else if(message.type==='hostError')alert(message.message)});
function lookupChoices(result){if(Array.isArray(result.choices))return result.choices;const data=result.data||{},columns=data.columns||[],rows=data.rows||[],index=name=>Math.max(0,columns.findIndex(x=>String(x).toLowerCase()===String(name||'').toLowerCase())),vi=index(result.valueColumn),di=index(result.displayColumn),hi=(result.hierarchyColumns||[]).map(index);return rows.map(row=>({value:row[vi],display:row[di],hierarchyValues:hi.map(i=>row[i]).filter(value=>value!==null&&value!==undefined&&String(value)!=='')}));}
window.addEventListener('DOMContentLoaded',()=>{post('ready');readyTimer=setInterval(()=>{if(workspaceLoaded)clearInterval(readyTimer);else post('ready')},500)});
