/* Sources and secrets chrome follows the shared application theme. */
html[data-qreports-app-theme] {
  --sources-panel: color-mix(in srgb, var(--qreports-surface) 88%, var(--qreports-header));
  --sources-raised: color-mix(in srgb, var(--qreports-surface) 94%, var(--qreports-header-text));
  --sources-subtle: color-mix(in srgb, var(--qreports-surface) 78%, var(--qreports-header));
  --sources-accent-soft: color-mix(in srgb, var(--qreports-accent) 14%, var(--qreports-surface));
  --sources-muted: color-mix(in srgb, var(--qreports-text) 70%, var(--qreports-surface));
}
html[data-qreports-app-theme] body,
html[data-qreports-app-theme] main,
html[data-qreports-app-theme] .editor,
html[data-qreports-app-theme] .secret-editor { background: var(--qreports-surface);color:var(--qreports-text); }
html[data-qreports-app-theme] aside,
html[data-qreports-app-theme] .secret-layout > div { background: var(--sources-panel);border-color:var(--qreports-grid); }
html[data-qreports-app-theme] body > header nav button:not(.primary) {
  background: transparent;
  color: var(--qreports-header-text);
  border-color: var(--qreports-grid);
}
html[data-qreports-app-theme] body > header nav button:not(.primary):not(:disabled):hover {
  background: color-mix(in srgb, var(--qreports-header-text) 12%, var(--qreports-header));
}
html[data-qreports-app-theme] body > header nav .primary,
html[data-qreports-app-theme] .primary {
  background: var(--qreports-accent);
  color: var(--qreports-on-accent);
  border-color: var(--qreports-accent);
}
html[data-qreports-app-theme] .primary:not(:disabled):hover {
  background: color-mix(in srgb, var(--qreports-accent) 82%, var(--qreports-header-text));
}
html[data-qreports-app-theme] button:not(.primary):not(.danger) {
  background: var(--sources-raised);
  color: var(--qreports-text);
  border-color: var(--qreports-grid);
}
html[data-qreports-app-theme] button:not(.primary):not(.danger):not(:disabled):hover {
  background: var(--sources-accent-soft);
  border-color: var(--qreports-accent);
}
html[data-qreports-app-theme] button:focus-visible {
  outline: 2px solid var(--qreports-accent);
  outline-offset: 2px;
}
html[data-qreports-app-theme] :is(input, select, textarea) {
  background: var(--qreports-surface);
  color: var(--qreports-text);
  border-color: var(--qreports-grid);
}
html[data-qreports-app-theme] input[type="checkbox"] { accent-color: var(--qreports-accent); }
html[data-qreports-app-theme] :is(.aside-head p, .editor-head p, .modal-head p, .help, .connection-item small, .secret-item small) { color: var(--sources-muted); }
html[data-qreports-app-theme] label { color: var(--qreports-text); }
html[data-qreports-app-theme] .connection-item,
html[data-qreports-app-theme] .secret-item,
html[data-qreports-app-theme] .panel,
html[data-qreports-app-theme] .modal-card {
  background: var(--sources-raised);
  color: var(--qreports-text);
  border-color: var(--qreports-grid);
}
html[data-qreports-app-theme] :is(.connection-item, .secret-item).active {
  background: var(--sources-accent-soft);
  border-color: var(--qreports-accent);
  box-shadow: 0 0 0 1px var(--qreports-accent);
}
html[data-qreports-app-theme] .tabs { border-color: var(--qreports-grid); }
html[data-qreports-app-theme] .tabs button { background:transparent;color:var(--qreports-text); }
html[data-qreports-app-theme] .tabs button.active { color:var(--qreports-accent);border-color:var(--qreports-accent); }
html[data-qreports-app-theme] .status { background:var(--sources-subtle);color:var(--qreports-text); }
html[data-qreports-app-theme] .status.busy { background:color-mix(in srgb,var(--qreports-accent) 14%,var(--qreports-surface));color:var(--qreports-accent); }
html[data-qreports-app-theme] .status.ok { background:color-mix(in srgb,var(--qreports-positive) 14%,var(--qreports-surface));color:var(--qreports-positive); }
html[data-qreports-app-theme] .danger-zone { border-color:var(--qreports-grid); }
html[data-qreports-app-theme] .danger { color:var(--qreports-negative);border-color:var(--qreports-negative);background:transparent; }
html[data-qreports-app-theme] .danger:not(:disabled):hover { background:color-mix(in srgb,var(--qreports-negative) 12%,var(--qreports-surface)); }
html[data-qreports-app-theme] .modal { background:color-mix(in srgb,var(--qreports-header) 58%,transparent); }
html[data-qreports-app-theme] .modal-head { background:var(--qreports-header);color:var(--qreports-header-text); }
html[data-qreports-app-theme] .modal-head button:not(.primary):not(.danger) { background:transparent;color:var(--qreports-header-text); }
html[data-qreports-app-theme] .toast { background:var(--qreports-header);color:var(--qreports-header-text); }
html[data-qreports-app-theme] body.secrets-only,
html[data-qreports-app-theme] body.secrets-only .modal { background:var(--qreports-surface); }

/* A denser source list keeps more saved sources visible without shrinking type. */
.connection-list { gap:5px;margin-top:10px; }
.connection-item { padding:8px 10px;border-radius:8px; }
.connection-item small { margin-top:3px;font-size:12px; }
