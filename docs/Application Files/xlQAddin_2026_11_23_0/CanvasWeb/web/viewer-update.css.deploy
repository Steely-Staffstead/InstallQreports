.viewer-update-dialog {
  --viewer-update-header: var(--qreports-header, #11151b);
  --viewer-update-header-text: var(--qreports-header-text, #eef2f7);
  --viewer-update-text: var(--qreports-text, #eef2f7);
  --viewer-update-on-accent: var(--qreports-on-accent, #10221b);
  box-sizing: border-box;
  width: min(780px, calc(100vw - 32px));
  max-height: min(760px, calc(100vh - 32px));
  margin: auto;
  padding: 0;
  overflow: hidden;
  border: 1px solid var(--qreports-grid, #46536b);
  border-radius: 20px;
  background: var(--qreports-surface, #171b22);
  color: var(--viewer-update-text);
  color-scheme: var(--qreports-color-scheme, dark);
  box-shadow: 0 34px 100px #000a;
}

.viewer-update-dialog::backdrop {
  background: color-mix(in srgb, #071019 76%, transparent);
  backdrop-filter: blur(5px);
}

.viewer-update-shell {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  max-height: inherit;
  background: var(--qreports-surface, #171b22);
  color: var(--viewer-update-text);
}

.viewer-update-shell header {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  padding: 26px 30px 22px;
  border-bottom: 1px solid var(--qreports-grid, #46536b);
  background: linear-gradient(135deg, var(--viewer-update-header), color-mix(in srgb, var(--qreports-accent, #72c7a5) 12%, var(--viewer-update-header)));
  color: var(--viewer-update-header-text);
}

.viewer-update-shell header p {
  margin: 0 0 6px;
  color: color-mix(in srgb, var(--viewer-update-header-text) 78%, var(--qreports-accent, #72c7a5));
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .11em;
  text-transform: uppercase;
}

.viewer-update-shell h2 {
  margin: 0 0 6px;
  color: var(--viewer-update-header-text);
  font-size: 27px;
}

.viewer-update-shell header span {
  color: color-mix(in srgb, var(--viewer-update-header-text) 78%, transparent);
}

.viewer-update-shell button {
  border: 1px solid var(--qreports-grid, #46536b);
  border-radius: 8px;
  background: var(--qreports-surface, #171b22);
  color: var(--viewer-update-text);
}

.viewer-update-shell header button {
  flex: none;
  width: 40px;
  height: 40px;
  padding: 0;
  border-color: color-mix(in srgb, var(--viewer-update-header-text) 30%, transparent);
  background: color-mix(in srgb, var(--viewer-update-header-text) 10%, var(--viewer-update-header));
  color: var(--viewer-update-header-text);
  font-size: 22px;
}

.viewer-update-shell header button:hover {
  border-color: color-mix(in srgb, var(--viewer-update-header-text) 52%, var(--qreports-accent, #72c7a5));
  background: color-mix(in srgb, var(--viewer-update-header-text) 18%, var(--viewer-update-header));
}

.viewer-update-shell > section {
  padding: 24px 30px;
  overflow: auto;
  background: var(--qreports-surface, #171b22);
  color: var(--viewer-update-text);
}

.viewer-update-versions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.viewer-update-versions article {
  padding: 15px;
  border: 1px solid var(--qreports-grid, #46536b);
  border-radius: 12px;
  background: color-mix(in srgb, var(--qreports-surface, #171b22) 94%, var(--viewer-update-header));
}

.viewer-update-versions span,
.viewer-update-versions strong {
  display: block;
}

.viewer-update-versions span {
  margin-bottom: 6px;
  color: color-mix(in srgb, var(--viewer-update-text) 68%, transparent);
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
}

.viewer-update-versions strong {
  color: var(--viewer-update-text);
  font-size: 17px;
}

.viewer-update-progress,
.viewer-update-notes,
.viewer-update-error {
  margin-top: 16px;
  padding: 16px;
  border: 1px solid var(--qreports-grid, #46536b);
  border-radius: 12px;
  background: color-mix(in srgb, var(--qreports-surface, #171b22) 96%, var(--viewer-update-header));
  color: var(--viewer-update-text);
}

.viewer-update-progress > div {
  display: flex;
  justify-content: space-between;
  margin-bottom: 9px;
  color: var(--viewer-update-text);
}

.viewer-update-progress progress {
  width: 100%;
  height: 12px;
  overflow: hidden;
  border: 1px solid var(--qreports-grid, #46536b);
  border-radius: 999px;
  background: color-mix(in srgb, var(--qreports-grid, #46536b) 28%, var(--qreports-surface, #171b22));
  accent-color: var(--qreports-accent, #72c7a5);
}

.viewer-update-progress progress::-webkit-progress-bar {
  background: color-mix(in srgb, var(--qreports-grid, #46536b) 28%, var(--qreports-surface, #171b22));
}

.viewer-update-progress progress::-webkit-progress-value {
  background: var(--qreports-accent, #72c7a5);
}

.viewer-update-notes h3 {
  margin: 0 0 7px;
  color: var(--viewer-update-text);
}

.viewer-update-notes p {
  margin: 0;
  white-space: pre-wrap;
  line-height: 1.5;
  color: color-mix(in srgb, var(--viewer-update-text) 76%, transparent);
}

.viewer-update-error {
  border-color: color-mix(in srgb, var(--qreports-negative, #ff8790) 60%, transparent);
  color: var(--qreports-negative, #ff8790);
}

.viewer-update-shell footer {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 9px;
  align-items: center;
  padding: 16px 30px;
  border-top: 1px solid var(--qreports-grid, #46536b);
  background: color-mix(in srgb, var(--viewer-update-header) 18%, var(--qreports-surface, #171b22));
  color: var(--viewer-update-text);
}

.viewer-update-shell footer:not(:has(button:not([hidden]))) {
  display: none;
}

.viewer-update-shell footer button:not(.primary) {
  border-color: var(--qreports-grid, #46536b);
  background: var(--qreports-surface, #171b22);
  color: var(--viewer-update-text);
}

.viewer-update-shell footer button:not(.primary):hover {
  border-color: var(--qreports-accent, #72c7a5);
  background: color-mix(in srgb, var(--qreports-accent, #72c7a5) 12%, var(--qreports-surface, #171b22));
}

.viewer-update-shell footer .primary {
  border-color: var(--qreports-accent, #72c7a5);
  background: var(--qreports-accent, #72c7a5);
  color: var(--viewer-update-on-accent);
}

.viewer-update-shell button:focus-visible {
  outline: 3px solid color-mix(in srgb, var(--qreports-accent, #72c7a5) 78%, white);
  outline-offset: 2px;
}

@media (max-width: 650px) {
  .viewer-update-versions { grid-template-columns: 1fr; }
  .viewer-update-shell footer { align-items: stretch; flex-direction: column; }
  .viewer-update-shell footer:not([hidden]) { display: flex; }
  .viewer-update-shell footer:not(:has(button:not([hidden]))) { display: none; }
  .viewer-update-shell footer span { display: none; }
}
