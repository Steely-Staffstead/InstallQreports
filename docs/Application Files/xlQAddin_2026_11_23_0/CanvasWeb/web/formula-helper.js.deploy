const $ = id => document.getElementById(id);
const commands = {
  report: [['dtable','Dynamic table','Structured Excel table output.'],['table','Table','Standard report table.'],['ptable','Pivot table','Pivot-style output using grouped fields.'],['summary','Summary','Compact KPI and measure output.'],['subtotal','Subtotal','Grouped detail rows with headers, footers and Excel outline.']],
  companion: [['column','Column / measure','Defines a field, measure, aggregation, label or unit.'],['crossfilter','Crossfilter','Applies one filter expression to an output column.'],['parameter','Parameter row','Adds parameter/value pairs in report code.']],
  control: [['set','Parameter setting','Writes a parameter definition to the control sheet.'],['setreport','Report template setup','Connects a template sheet and report sheet.'],['setpassword','Sheet password','Stores sheet protection configuration.']]
};
const optionDefs = {
  dtableName:{symbol:'T',title:'Structured table name',desc:'Name used to create and later update the Excel table',placeholder:'Example: tbl_Sheet1',hint:'Must be unique in the workbook. A safe name is suggested from the active sheet.'},
  fields:{symbol:'▦',title:'Columns & measures',desc:'Choose fields and measures returned by the report',placeholder:'Add a field or measure',hint:'Click an item in the field library or type a name and press Enter.'},
  group:{symbol:'◫',title:'Group',desc:'Group rows into sections, totals or pivot axes',placeholder:'Add a grouping field',hint:'Fields are used in the displayed order.'},
  filter:{symbol:'◇',title:'Filter',desc:'Limit the rows included in the result',placeholder:'Example: year={{currentyear}}',hint:'Supports =, <>, >, >=, <, <=, ranges, |, wildcards, NULL and NOT NULL.'},
  sort:{symbol:'↕',title:'Sort',desc:'Control the order of returned rows',placeholder:'Example: country ASC',hint:'Use ASC or DESC after the field.'},
  options:{symbol:'⚙',title:'Options',desc:'Output flags and positioning options',placeholder:'Example: LeftColumn=3',hint:'Use only options supported by the selected command.'},
  toprows:{symbol:'#',title:'Top rows',desc:'Return only the first matching rows',placeholder:'Example: 100',hint:'Must be an integer greater than zero.'},
  agg:{symbol:'Σ',title:'Aggregation',desc:'Aggregate a field or measure',placeholder:'SUM, AVG, MIN, MAX, FIRST or LAST',hint:'Valid aggregations: SUM, AVG, MIN, MAX, FIRST and LAST.'},
  unit:{symbol:'÷',title:'Unit',desc:'Scale a numeric result',placeholder:'Example: 1000',hint:'The value must be a non-zero number.'},
  label:{symbol:'T',title:'Label',desc:'Set the displayed caption',placeholder:'Example: Gross profit',hint:'Emits label(...).'},
  subtotalLayout:{symbol:'≡',title:'Subtotal rows & outline',desc:'Generate header/footer template rows and outline',placeholder:'headers, outline or outlinec',hint:'Add headers, outline (expanded), or outlinec (collapsed).'},
  pairs:{symbol:'⇄',title:'Parameter pairs',desc:'Parameter/value pairs written in sequence',placeholder:'parameter;value',hint:'Add one parameter and value pair per chip.'},
  value:{symbol:'=',title:'Value',desc:'Value written by the control command',placeholder:'Enter a value',hint:'May contain an Excel formula or a {{parameter}} token.'}
};
const allowed = {table:['fields','group','filter','sort','options','toprows'],dtable:['dtableName','fields','group','filter','sort','options','toprows'],ptable:['fields','group','filter','sort'],summary:['fields','filter','options'],subtotal:['fields','group','filter','sort','options','subtotalLayout'],column:['fields','filter','agg','unit','label','options'],crossfilter:['filter'],parameter:['pairs'],set:['value'],setreport:['pairs'],setpassword:['value']};
const language = [
  ...Object.values(commands).flat().map(([name,,description])=>({name,kind:'command',description,example:name})),
  {name:'sql / q / query',kind:'source token',description:'Starts line-based SQL or API request text.',example:'sql | SELECT ...'},
  {name:'conn / connspec',kind:'source token',description:'Selects a connection or complete connection specification.',example:'conn;admdw'},
  {name:'model / powerquery / file',kind:'source token',description:'Supported source-definition tokens.',example:'file;path(...)'},
  {name:'load',kind:'output token',description:'Loads a defined output using parsed output options.',example:'load;filter(...)'},
  {name:'chart / graph',kind:'output token',description:'Chart output tokens supported by the execution engine.',example:'chart;filter(...)'},
  {name:'tablea',kind:'output token',description:'Alternate table token supported by the table engine.',example:'tablea;group(...)'},
  {name:'filter(...)',kind:'function',description:'Filters rows. Comma-separated conditions are ANDed.',example:'filter(country=NO,year>=2024)'},
  {name:'group(...)',kind:'function',description:'Defines grouping keys in order.',example:'group(region,country)'},
  {name:'sort(...)',kind:'function',description:'Defines ascending or descending sort keys.',example:'sort(year DESC,country ASC)'},
  {name:'toprows(...)',kind:'function',description:'Limits output to a positive number of rows.',example:'toprows(100)'},
  {name:'options(...)',kind:'function',description:'Supplies output options such as LeftColumn.',example:'options(LeftColumn=3)'},
  {name:'agg(...)',kind:'column function',description:'Aggregation: SUM, AVG, MIN, MAX, FIRST or LAST.',example:'agg(SUM)'},
  {name:'label(...)',kind:'column function',description:'Sets a display label.',example:'label(Gross profit)'},
  {name:'unit(...)',kind:'column function',description:'Scales numeric values by a non-zero number.',example:'unit(1000)'},
  {name:'crossfilter',kind:'directive',description:'Companion row that filters an output column.',example:'crossfilter | period=202501'},
  {name:'nocrossfilter',kind:'directive',description:'Prevents a column from receiving crossfilter.',example:'column;Revenue;nocrossfilter'},
  {name:'noheader',kind:'directive',description:'Suppresses generated headers where supported.',example:'summary;noheader'},
  {name:'offset(...)',kind:'directive',description:'Moves summary output relative to its code row.',example:'offset(1)'},
  {name:'outline / outlinec',kind:'subtotal directive',description:'Creates expanded or collapsed Excel outline on footer rows.',example:'+ | footer1;outlinec'},
  {name:'header / footer / footer1…',kind:'subtotal row',description:'Template rows used by subtotal output.',example:'+ | footer | label(SUM)'},
  {name:'{{parameter}}',kind:'placeholder',description:'Replaces a workbook parameter at execution time.',example:'filter(year={{currentyear}})'},
  {name:'= <> > >= < <=',kind:'filter operator',description:'Comparison operators accepted by filter.',example:'amount>=1000'},
  {name:'| range * % NULL NOT NULL',kind:'filter operator',description:'OR, range, wildcard and null filter syntax.',example:'region=1|2; account=3000-3999'}
];
let mode='report',items=[],activeSection='fields',activeDragPayload=null,formulaContext={};
const tokens=Object.fromEntries(Object.keys(optionDefs).map(key=>[key,[]]));
const demo=[['field','Continent'],['field','country'],['field','GDP_GROWTH_PCT'],['field','population'],['field','year'],['measure','growth_pct'],['measure','population_growth'],['measure','population_sum'],['parameter','continent'],['parameter','currentyear'],['parameter','country']];
const esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
function selectedCommand(){return $('type').value||commands[mode][0][0]}
function setMode(next,preferred){mode=next;document.querySelectorAll('.choice').forEach(button=>button.classList.toggle('active',button.dataset.mode===mode));$('type').innerHTML=commands[mode].map(([value,label])=>`<option value="${value}">${label}</option>`).join('');if(preferred&&commands[mode].some(item=>item[0]===preferred))$('type').value=preferred;updateCommand()}
function updateCommand(){const command=selectedCommand(),item=Object.values(commands).flat().find(entry=>entry[0]===command);if(command==='dtable'&&!tokens.dtableName.length)tokens.dtableName=[suggestTableName()];$('typeTitle').textContent=item?.[1]||command;$('typeHelp').textContent=item?.[2]||'';renderOptions();renderPreview()}
function suggestTableName(){const safe=String(formulaContext.activeSheetName||'Sheet').replace(/[^A-Za-z0-9_]/g,'_').replace(/^([^A-Za-z_])/,'_$1'),base=`tbl_${safe||'Sheet'}`,used=new Set((formulaContext.existingTableNames||[]).map(name=>String(name).toLowerCase()));if(!used.has(base.toLowerCase()))return base;for(let index=1;index<10000;index++){const candidate=`${base}_${index}`;if(!used.has(candidate.toLowerCase()))return candidate}return `${base}_${Date.now()}`}
function normalizeSession(session){const result=[];const add=(kind,name)=>{name=String(name??'').trim();if(name&&!result.some(item=>item.kind===kind&&item.name.toLowerCase()===name.toLowerCase()))result.push({kind,name})};const walk=value=>{if(!value)return;if(Array.isArray(value)){value.forEach(walk);return}if(typeof value!=='object')return;const columns=value.columns||value.Columns||value.schema?.columns||value.Schema?.Columns;if(Array.isArray(columns))columns.forEach(column=>add('field',typeof column==='string'?column:column.name||column.Name||column.columnName));Object.entries(value).forEach(([key,child])=>{if(!['rows','Rows'].includes(key))walk(child)})};const projectionProvided=Array.isArray(session.projectedFields),projected=projectionProvided?session.projectedFields.filter(name=>String(name??'').trim()):[];if(projectionProvided)projected.forEach(name=>add('field',name));else walk(session.tableData);(session.measures||[]).forEach(metric=>add('measure',metric?.OutputName||metric?.outputName||metric?.Name||metric?.name));(session.measureNames||[]).forEach(name=>add('measure',name));(session.parameters||[]).forEach(parameter=>add('parameter',parameter?.Name||parameter?.name||parameter?.Parameter||parameter?.parameter));return result.length?result:projectionProvided?[]:demo.map(([kind,name])=>({kind,name}))}
function renderOptions(){
  const keys=allowed[selectedCommand()]||[];
  $('options').innerHTML=keys.map(key=>{
    const option=optionDefs[key],textOnly=['filter','sort'].includes(key),singleLine=key==='dtableName',value=tokens[key][0]||'';
    const editor=key==='subtotalLayout'
      ? subtotalLayoutEditor()
      : singleLine
        ? `<input class="single-expression" data-single-entry placeholder="${option.placeholder}" value="${esc(value)}">`
      : textOnly
        ? `<textarea class="text-expression" data-text-entry data-dropzone="${key}" placeholder="${option.placeholder}">${esc(value)}</textarea>`
        : `<div class="token-input" data-dropzone="${key}">${tokens[key].map((token,index)=>`<span class="token" draggable="${['fields','group'].includes(key)}" data-token-index="${index}">${esc(token)}<button data-remove="${index}" aria-label="Remove ${esc(token)}">×</button></span>`).join('')}<input data-entry placeholder="${option.placeholder}"></div>`;
    return `<section class="option-card ${tokens[key].length?'open':''}" data-option="${key}"><button class="option-toggle" data-dropzone="${key}" aria-expanded="${tokens[key].length?'true':'false'}"><span class="option-symbol">${option.symbol}</span><span><b>${option.title}</b><small>${option.desc}</small></span><span class="option-count">${tokens[key].length?(textOnly?'Set':tokens[key].length+' added'):'Optional'}</span><span class="chevron">⌄</span></button><div class="option-body">${editor}<p class="option-hint">${option.hint}</p></div></section>`
  }).join('');
  document.querySelectorAll('.option-card').forEach(card=>{
    const key=card.dataset.option;
    card.querySelector('.option-toggle').onclick=()=>{card.classList.toggle('open');card.querySelector('.option-toggle').setAttribute('aria-expanded',String(card.classList.contains('open')));if(card.classList.contains('open')){activeSection=key;card.querySelector('input,textarea')?.focus()}};
    const entry=card.querySelector('[data-entry]');if(entry)entry.onkeydown=event=>{if(event.key==='Enter'&&event.target.value.trim()){event.preventDefault();tokens[key].push(event.target.value.trim());renderOptions();renderPreview()}};
    const textEntry=card.querySelector('[data-text-entry]');if(textEntry)textEntry.oninput=event=>{tokens[key]=event.target.value?[event.target.value]:[];renderPreview()};
    const singleEntry=card.querySelector('[data-single-entry]');if(singleEntry)singleEntry.oninput=event=>{tokens[key]=event.target.value.trim()?[event.target.value.trim()]:[];renderPreview()};
    card.querySelectorAll('[data-subtotal-setting]').forEach(control=>control.onchange=()=>updateSubtotalLayout(card));
    card.querySelectorAll('[data-remove]').forEach(button=>button.onclick=event=>{event.stopPropagation();tokens[key].splice(+button.dataset.remove,1);renderOptions();renderPreview()});
    card.querySelectorAll('.token[draggable="true"]').forEach(token=>{token.ondragstart=event=>setDragData(event,{source:'section',section:key,index:+token.dataset.tokenIndex,name:tokens[key][+token.dataset.tokenIndex]});token.ondragend=endDrag});
  });
  wireDropZones();
}
function subtotalLayoutEditor(){
  const headers=tokens.subtotalLayout.includes('headers'),outline=tokens.subtotalLayout.some(value=>['outline','outlinec'].includes(value)),collapsed=tokens.subtotalLayout.includes('outlinec');
  return `<div class="subtotal-settings">
    <label class="setting-choice"><input type="checkbox" data-subtotal-setting="headers" ${headers?'checked':''}><span><b>Show a header for each group level</b><small>Adds descriptive header rows above grouped details.</small></span></label>
    <label class="setting-choice"><input type="checkbox" data-subtotal-setting="outline" ${outline?'checked':''}><span><b>Add Excel outline controls</b><small>Lets the user expand and collapse grouped detail rows in Excel.</small></span></label>
    <label class="setting-choice nested ${outline?'':'disabled'}"><input type="checkbox" data-subtotal-setting="collapsed" ${collapsed?'checked':''} ${outline?'':'disabled'}><span><b>Start with groups collapsed</b><small>Shows subtotal rows first; users can expand the details.</small></span></label>
    <div class="subtotal-result"><b>Generated structure</b><span>${headers?'Group headers, ':''}${outline?(collapsed?'collapsed Excel outline':'expanded Excel outline'):'subtotal footer rows without outline'}</span></div>
  </div>`;
}
function updateSubtotalLayout(card){
  const headers=card.querySelector('[data-subtotal-setting="headers"]').checked,outline=card.querySelector('[data-subtotal-setting="outline"]').checked,collapsed=card.querySelector('[data-subtotal-setting="collapsed"]').checked;
  tokens.subtotalLayout=[];if(headers)tokens.subtotalLayout.push('headers');if(outline)tokens.subtotalLayout.push(collapsed?'outlinec':'outline');renderOptions();renderPreview();
}
function setDragData(event,payload){activeDragPayload=payload;event.dataTransfer.effectAllowed=payload.source==='section'?'move':'copy';event.dataTransfer.setData('application/x-xlquery-item',JSON.stringify(payload));event.dataTransfer.setData('text/plain',payload.name)}
function endDrag(){activeDragPayload=null;document.querySelectorAll('.drag-over,.drag-before').forEach(item=>item.classList.remove('drag-over','drag-before'))}
function readDragData(event){if(activeDragPayload)return activeDragPayload;try{return JSON.parse(event.dataTransfer.getData('application/x-xlquery-item'))}catch{return {source:'library',name:event.dataTransfer.getData('text/plain')}}}
function wireDropZones(){document.querySelectorAll('[data-dropzone]').forEach(zone=>{zone.ondragover=event=>{event.preventDefault();event.stopPropagation();zone.classList.add('drag-over');document.querySelectorAll('.drag-before').forEach(item=>item.classList.remove('drag-before'));const targetToken=event.target.closest?.('[data-token-index]');if(targetToken)targetToken.classList.add('drag-before');const payload=activeDragPayload;event.dataTransfer.dropEffect=payload?.source==='section'&&['fields','group'].includes(zone.dataset.dropzone)?'move':'copy'};zone.ondragleave=event=>{if(!zone.contains(event.relatedTarget))zone.classList.remove('drag-over')};zone.ondrop=event=>{event.preventDefault();event.stopPropagation();zone.classList.remove('drag-over');document.querySelectorAll('.drag-before').forEach(item=>item.classList.remove('drag-before'));const payload=readDragData(event),target=zone.dataset.dropzone;if(!payload?.name)return;if(['filter','sort'].includes(target)){const card=zone.closest('.option-card'),textarea=card?.querySelector('[data-text-entry]');if(!textarea)return;const value=payload.name,start=textarea.selectionStart??textarea.value.length,end=textarea.selectionEnd??start;textarea.value=textarea.value.slice(0,start)+value+textarea.value.slice(end);textarea.focus();textarea.setSelectionRange(start+value.length,start+value.length);tokens[target]=textarea.value?[textarea.value]:[];card.classList.add('open');renderPreview();endDrag();return}if(!['fields','group'].includes(target))return;let insertAt=tokens[target].length;const targetToken=event.target.closest?.('[data-token-index]');if(targetToken)insertAt=+targetToken.dataset.tokenIndex;if(payload.source==='section'&&['fields','group'].includes(payload.section)){const oldIndex=payload.index;if(payload.section===target){tokens[target].splice(oldIndex,1);if(oldIndex<insertAt)insertAt--}else tokens[payload.section].splice(oldIndex,1)}if(!tokens[target].includes(payload.name)||payload.source==='section')tokens[target].splice(Math.max(0,insertAt),0,payload.name);activeSection=target;endDrag();renderOptions();renderPreview()}})}
function renderItems(){const query=$('search').value.toLowerCase(),kind=document.querySelector('.library-tabs .active')?.dataset.kind||'all';const filtered=items.filter(item=>(kind==='all'||item.kind===kind)&&item.name.toLowerCase().includes(query));const labels={field:'Fields',measure:'Measures',parameter:'Parameters'},icons={field:'ABC',measure:'ƒx',parameter:'{{ }}'};$('items').innerHTML=['field','measure','parameter'].map(type=>{const group=filtered.filter(item=>item.kind===type);return group.length?`<section class="item-group"><h3>${labels[type]} · ${group.length}</h3>${group.map(item=>`<button class="field-item" draggable="true" data-name="${esc(item.name)}" data-kind="${type}"><span class="field-icon">${icons[type]}</span><span>${esc(item.name)}</span><small>⠿</small></button>`).join('')}</section>`:''}).join('')||'<p class="option-hint">No matching items.</p>';document.querySelectorAll('.field-item').forEach(button=>{button.onclick=()=>addItem(button.dataset.name,button.dataset.kind);button.ondragstart=event=>setDragData(event,{source:'library',name:button.dataset.kind==='parameter'?`{{${button.dataset.name}}}`:button.dataset.name,kind:button.dataset.kind});button.ondragend=endDrag})}
function addItem(name,kind){const visible=allowed[selectedCommand()]||[];let section=visible.includes(activeSection)?activeSection:(visible.includes('fields')?'fields':visible[0]);if(!section)return;const value=kind==='parameter'?`{{${name}}}`:name;if(!tokens[section].includes(value))tokens[section].push(value);renderOptions();renderPreview();toast(`${name} added to ${optionDefs[section].title}`)}
function mainCode(){const command=selectedCommand(),parts=[command];for(const key of allowed[command]||[]){if(!tokens[key].length||['dtableName','fields','subtotalLayout','pairs','value'].includes(key))continue;parts.push(`${key}(${tokens[key].join(', ')})`)}if(command==='column'&&tokens.fields.length)parts.splice(1,0,tokens.fields[0]);if(command==='crossfilter')return tokens.filter[0]||'';if(['parameter','setreport'].includes(command)&&tokens.pairs.length)parts.push(...tokens.pairs);if(['set','setpassword'].includes(command)&&tokens.value.length)parts.push(...tokens.value);return parts.join(';')}
function subtotalRows(){if(selectedCommand()!=='subtotal')return null;const groups=tokens.group.length?tokens.group:['groupfield'],metrics=tokens.fields.filter(field=>!groups.includes(field)),rows=[[mainCode(),'',groups.at(-1),...metrics]];if(tokens.subtotalLayout.some(value=>value.toLowerCase()==='headers'))groups.slice(0,-1).forEach((group,index)=>rows.push(['+',`header${index+1}`,group,...metrics]));const outline=tokens.subtotalLayout.find(value=>['outline','outlinec'].includes(value.toLowerCase()))||'';for(let index=groups.length-1;index>=1;index--)rows.push(['+',`footer${index}${outline?';'+outline:''}`,groups[index-1],...metrics]);rows.push(['+','footer','label(SUM)',...metrics]);return rows}
function outputRows(){const subtotal=subtotalRows();if(subtotal)return subtotal;const command=selectedCommand();if(['table','dtable','ptable','summary'].includes(command)&&(tokens.fields.length||tokens.group.length)){const columns=[...tokens.group,...tokens.fields.filter(field=>!tokens.group.includes(field))];return [[mainCode(),command==='dtable'?(tokens.dtableName[0]||suggestTableName()):'',...columns]]}return null}
function renderPreview(){const command=selectedCommand(),code=mainCode(),rows=outputRows(),count=(allowed[command]||[]).filter(key=>tokens[key].length).length;$('preview').textContent=rows?rows.map(row=>row.join(' | ')).join('\n'):code;$('summary').textContent=`${$('type').selectedOptions[0]?.text||command} · ${count} active sections`;$('activeList').innerHTML=(allowed[command]||[]).filter(key=>tokens[key].length).map(key=>`<span class="active-pill">${optionDefs[key].title} · ${tokens[key].length}</span>`).join('')||'<span class="option-hint">No optional settings yet</span>';$('explain').textContent=command==='subtotal'?`Creates ${rows.length} subtotal template rows with ${tokens.group.length||1} grouping level(s).`:`Creates a legal ${command} command using only options supported by that command.`}
function renderReference(){const query=$('referenceSearch').value.toLowerCase();$('referenceList').innerHTML=language.filter(item=>`${item.name} ${item.kind} ${item.description} ${item.example}`.toLowerCase().includes(query)).map(item=>`<article class="reference-card"><header><code>${esc(item.name)}</code><span class="reference-kind">${esc(item.kind)}</span></header><p>${esc(item.description)}</p><small>${esc(item.example)}</small></article>`).join('')}
function toast(text){$('toast').textContent=text;$('toast').classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('toast').classList.remove('show'),1800)}
function insert(){const payload={type:'formulaHelperApply',command:selectedCommand(),code:mainCode(),rows:outputRows()};if(window.chrome?.webview)chrome.webview.postMessage(payload);else toast('Preview mode: '+payload.code)}
function splitCode(raw){const result=[];let depth=0,start=0;for(let index=0;index<=raw.length;index++){const char=raw[index];if(char==='(')depth++;else if(char===')')depth=Math.max(0,depth-1);if((char===';'&&depth===0)||index===raw.length){const part=raw.slice(start,index).trim();if(part)result.push(part);start=index+1}}return result}
function isExcelErrorValue(value){return /^-2146826\d{3}$/.test(String(value??'').trim())}
function loadActiveCell(cell){const columnA=String(cell?.columnA||'').trim(),active=String(cell?.activeValue||'').trim(),row=Array.isArray(cell?.rowValues)?cell.rowValues.map(value=>String(value??'').trim()):[],formulas=Array.isArray(cell?.rowFormulas)?cell.rowFormulas.map(value=>String(value??'').trim()):[],hasFormulas=Array.isArray(cell?.rowHasFormulas)?cell.rowHasFormulas:[],raw=/^crossfilter$/i.test(columnA)?`crossfilter;${cell.column===1?(row[1]||''):active}`:active;if(cell?.activeHasFormula||/^[=+]/.test(String(cell?.activeFormula||'').trimStart())){toast('The active cell contains an Excel formula, not QRep code');return}if(!raw){toast('The active cell is empty');return}const parts=splitCode(raw),command=parts.shift()?.toLowerCase(),targetMode=Object.entries(commands).find(([,list])=>list.some(item=>item[0]===command))?.[0];if(!targetMode){toast('No supported QRep code found in the active cell');return}Object.keys(tokens).forEach(key=>tokens[key]=[]);setMode(targetMode,command);for(const part of parts){const match=part.match(/^([a-z][a-z0-9]*)\((.*)\)$/i);if(match&&tokens[match[1]])tokens[match[1]]=['filter','sort'].includes(match[1])?[match[2]]:match[2].split(',').map(value=>value.trim()).filter(Boolean);else if(command==='crossfilter'&&part)tokens.filter=[part]}if(command==='dtable'&&row[1])tokens.dtableName=[row[1]];if(['table','dtable','ptable','summary','subtotal'].includes(command))tokens.fields=row.slice(2).filter((value,index)=>value&&!hasFormulas[index+2]&&!/^[=+]/.test(formulas[index+2]||'')&&!isExcelErrorValue(value));renderOptions();renderPreview();toast('Loaded code from the active Excel cell')}
document.querySelectorAll('.choice').forEach(button=>button.onclick=()=>setMode(button.dataset.mode));document.querySelectorAll('.library-tabs button').forEach(button=>button.onclick=()=>{document.querySelectorAll('.library-tabs button').forEach(item=>item.classList.toggle('active',item===button));renderItems()});
document.addEventListener('DOMContentLoaded',()=>requestAnimationFrame(()=>{const settings=document.querySelector('[data-shared-settings]');if(settings){settings.textContent='⚙';settings.title='Settings';settings.setAttribute('aria-label','Settings');settings.classList.add('shared-settings-icon')}}));
$('search').oninput=renderItems;$('type').onchange=updateCommand;$('copy').onclick=async()=>{await navigator.clipboard.writeText($('preview').textContent);toast('Code copied')};$('insert').onclick=$('insertBottom').onclick=insert;$('close').onclick=()=>window.chrome?.webview?.postMessage({type:'closeWindow'});$('reload').onclick=()=>{renderItems();toast('Field library refreshed')};$('loadCell').onclick=()=>window.chrome?.webview?chrome.webview.postMessage({type:'formulaHelperLoadActiveCell'}):toast('Active-cell loading requires Excel');$('fieldPaneToggle').onclick=()=>{const collapsed=document.body.classList.toggle('library-collapsed');$('fieldPaneToggle').setAttribute('aria-pressed',String(collapsed));$('fieldPaneToggle').textContent=collapsed?'☰ Show fields':'☰ Fields'};$('previewPaneToggle').onclick=()=>{const collapsed=document.body.classList.toggle('preview-collapsed');$('previewPaneToggle').setAttribute('aria-pressed',String(collapsed));$('previewPaneToggle').textContent=collapsed?'▤ Show preview':'▤ Preview'};$('languageReference').onclick=()=>{$('referenceDialog').showModal();$('referenceSearch').focus()};$('closeReference').onclick=()=>$('referenceDialog').close();$('referenceSearch').oninput=renderReference;
if(window.chrome?.webview){chrome.webview.addEventListener('message',event=>{if(event.data?.type==='loadFormulaHelper'){formulaContext=event.data.session||{};items=normalizeSession(formulaContext);if(selectedCommand()==='dtable')tokens.dtableName=[suggestTableName()];renderOptions();renderPreview();renderItems()}else if(event.data?.type==='formulaHelperActiveCell')loadActiveCell(event.data.cell);else if(event.data?.type==='formulaHelperSubmitted')toast('Sent to Excel — choose another cell to continue')});addEventListener('DOMContentLoaded',()=>chrome.webview.postMessage({type:'ready'}))}
items=demo.map(([kind,name])=>({kind,name}));setMode('report','dtable');renderItems();renderReference();
