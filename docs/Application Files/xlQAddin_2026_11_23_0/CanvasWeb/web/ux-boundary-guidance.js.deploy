(()=>{
  const setText=(node,value)=>{if(node&&node.textContent!==value)node.textContent=value;};
  const snapshotText=()=>{
    const mode=document.getElementById("savedDataMode")?.value||"preview",limit=Number(document.getElementById("previewLimit")?.value)||0,rows=document.getElementById("rowCount")?.textContent?.trim()||"0";
    if(mode==="none")return{title:"Recipients receive the report without source rows",detail:"The layout and source definition are saved, but Viewer recipients cannot see data until an allowed refresh succeeds.",refresh:"Creator can update the source; Viewer refresh depends on an available recipient connection and permission."};
    if(mode==="all")return{title:`Recipients receive all ${rows} currently loaded rows`,detail:"The saved snapshot opens without the author's connection. Preview rows controls the design session, not the saved row count.",refresh:"A later update can replace the snapshot when the recipient has a usable connection and refresh permission."};
    return{title:`Recipients receive the current preview${limit?` (up to ${limit.toLocaleString()} rows)`:" (all loaded preview rows)"}`,detail:"Only the rows loaded into the design preview are stored in the Qanvas file.",refresh:"The snapshot opens offline. Getting additional or newer rows requires an allowed source update."};
  };
  function updateSnapshotContract(){const output=document.querySelector(".source-inspector-output-content");if(!output)return;let card=output.querySelector("[data-snapshot-contract]");if(!card){card=document.createElement("section");card.className="snapshot-recipient-contract";card.dataset.snapshotContract="";card.innerHTML='<span>Recipient data contract</span><b></b><p></p><small></small>';output.append(card);}const value=snapshotText();setText(card.querySelector("b"),value.title);setText(card.querySelector("p"),value.detail);setText(card.querySelector("small"),value.refresh);}
  const publishComparison=`<section class="publish-output-comparison" aria-label="Publishing format comparison"><header><h4>Compare recipient capabilities</h4><p>Choose by interaction, refresh, portability and security—not only by file type.</p></header><div class="publish-comparison-grid"><b>Target</b><b>Interaction</b><b>Refresh</b><b>Portability</b><b>Security boundary</b><strong>Viewer file</strong><span>Filters, parameters, navigation and approved App actions</span><span>Only with recipient connection and permission</span><span>One portable .qanvas file with saved snapshots</span><span>Viewer sandbox; credentials excluded</span><strong>Web page</strong><span>Browser interactions configured by the export profile</span><span>Saved data; public APIs only when explicitly configured</span><span>Single file or deployable folder</span><span>Browser sandbox and declared public endpoints</span><strong>PDF</strong><span>Static pages</span><span>None</span><span>Best for printing and archival</span><span>No runtime code or credentials</span><strong>PowerPoint</strong><span>Static slide images; publication text remains editable</span><span>Re-export, or update linked Canvas objects through the add-in</span><span>Editable presentation deck</span><span>No embedded author credentials</span></div></section>`;
  function decoratePublish(){const targets=document.querySelector(".publish-targets");if(targets&&!document.querySelector(".publish-output-comparison"))targets.insertAdjacentHTML("beforebegin",publishComparison);}
  function clarifyThemes(){const summary=document.querySelector("#canvasThemeProperties>summary");if(summary&&summary.textContent.trim()==="Canvas theme")summary.textContent="Canvas theme · report content";const group=document.getElementById("canvasThemeProperties");if(group&&!group.querySelector("[data-theme-boundary]")){const note=document.createElement("p");note.className="property-empty theme-boundary-note";note.dataset.themeBoundary="";note.textContent="Canvas theme travels with the report and colors pages, visuals and exported content. Application theme colors Qvitr menus, workspaces and dialogs for this user only.";summary.after(note);}}
  const observer=new MutationObserver(()=>{updateSnapshotContract();decoratePublish();clarifyThemes();});
  addEventListener("DOMContentLoaded",()=>{observer.observe(document.body,{childList:true,subtree:true});updateSnapshotContract();clarifyThemes();document.addEventListener("input",event=>{if(event.target.matches("#previewLimit,#savedDataMode"))updateSnapshotContract();});document.addEventListener("change",event=>{if(event.target.matches("#previewLimit,#savedDataMode"))updateSnapshotContract();});});
})();
