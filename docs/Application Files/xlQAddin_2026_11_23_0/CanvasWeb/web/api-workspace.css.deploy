:root{font-family:"Segoe UI",Arial,sans-serif;color:#17213c;background:#eaf0f8}*{box-sizing:border-box}body{margin:0;height:100vh;overflow:hidden}button,input,select,textarea{font:inherit}button{border:1px solid #c8d2e3;border-radius:9px;background:#fff;color:#263451;padding:8px 12px;cursor:pointer}button:hover{border-color:#738cef}.primary{background:#6686ee;color:#fff}.run{background:#398d55;color:#fff}header{height:82px;background:#28345d;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:13px 22px}.brand{display:flex;align-items:center;gap:13px}.brand>span{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:#6686ee;font-size:29px;font-weight:800}.brand strong{display:block;font-size:22px}.brand small{color:#d8e0fa}nav{display:flex;gap:8px}nav button{background:#33416f;color:#fff;border-color:#59678f}nav .primary{background:#6686ee}nav .run{background:#398d55}main{height:calc(100vh - 82px);display:grid;grid-template-columns:260px minmax(540px,1fr) 280px;overflow:hidden}aside{background:#f8faff;padding:16px;border-right:1px solid #d6deeb;overflow:auto}#inspector{border-right:0;border-left:1px solid #d6deeb}.pane-title{display:flex;justify-content:space-between;align-items:start}.pane-title h2,#inspector h2{margin:0 0 3px}.pane-title p{margin:0;color:#6f7b96}.pane-title+input{width:100%;margin:14px 0}.workspace{min-width:0;display:grid;grid-template-rows:auto auto minmax(220px,44%) auto minmax(180px,1fr);background:#fff}.request-line{display:grid;grid-template-columns:100px 180px 1fr auto;gap:8px;padding:12px;border-bottom:1px solid #d9e0ec}.request-line>*{min-width:0}.request-line input,.request-line select,label input,label select,label textarea,#search{width:100%;border:1px solid #cbd5e5;border-radius:8px;padding:9px;background:white}.request-line #status{align-self:center;color:#66738e}.tabs{display:flex;gap:2px;padding:0 12px;border-bottom:1px solid #d9e0ec}.tabs button{border:0;border-radius:0;background:transparent;padding:11px 14px}.tabs button.active{color:#4f69d8;border-bottom:3px solid #6686ee}.request-panels{overflow:auto;padding:14px}.panel{display:none}.panel.active{display:block}.split{display:grid;grid-template-columns:1fr 1fr;gap:20px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(180px,1fr));gap:12px}.form-grid label,.form-row label,#inspector label{display:grid;gap:5px;color:#59657f;font-size:13px}.wide{grid-column:1/-1}.check{display:flex!important;align-items:center;gap:8px}.check input{width:auto}.form-row{display:grid;grid-template-columns:180px 180px 1fr;gap:12px;margin-bottom:12px}.code{font-family:Consolas,monospace;resize:vertical}.request-panels textarea.code{min-height:170px}.hidden{display:none!important}.kv{display:grid;gap:6px;margin:8px 0}.kv-row{display:grid;grid-template-columns:28px minmax(90px,.7fr) minmax(120px,1fr) 32px;gap:5px}.kv-row input{min-width:0;border:1px solid #cbd5e5;border-radius:6px;padding:7px}.kv-row input[type=checkbox]{width:auto}h3{margin:2px 0 8px}details{margin-top:16px;border:1px solid #d7dfec;border-radius:10px;padding:12px}details summary{font-weight:700;cursor:pointer;margin-bottom:12px}.input-button{display:flex}.input-button input{border-radius:8px 0 0 8px}.input-button button{border-radius:0 8px 8px 0}.response-head{display:flex;justify-content:space-between;align-items:center;background:#5e6678;color:#fff}.response-head .tabs{border:0}.response-head button{color:white}.response-head button.active{color:#fff;border-color:#9fb0ff}.response{overflow:auto;position:relative}.response-panel{display:none;margin:0}.response-panel.active{display:block}table{border-collapse:collapse;width:max-content;min-width:100%;font-size:13px}th,td{padding:7px 10px;border-bottom:1px solid #e0e6ef;white-space:nowrap;text-align:left}th{position:sticky;top:0;background:#edf1f8}pre{padding:14px;white-space:pre-wrap;font-family:Consolas,monospace}.library-connection{margin-bottom:8px;border:1px solid #d8e0ec;border-radius:10px;background:white}.library-connection>button{width:100%;text-align:left;border:0;font-weight:700}.library-endpoint{display:block;width:calc(100% - 16px);margin:0 8px 6px;padding:6px 9px;text-align:left;border:0;background:#f3f6fc}.library-endpoint.active{background:#e4eaff;color:#304fc6}#inspector label{margin-bottom:11px}#inspector textarea{min-height:95px}.danger{border-top:1px solid #d9e0ec;margin-top:20px;padding-top:15px;display:grid;gap:8px}.danger button{color:#a33b31;border-color:#e4b7b1}.modal{position:fixed;inset:0;background:#17213c88;display:grid;place-items:center}.modal-card{width:min(650px,85vw);max-height:80vh;overflow:auto;background:#fff;border-radius:16px;padding:18px}.modal-head{display:flex;justify-content:space-between}.path-option{display:block;width:100%;text-align:left;margin:5px 0}#toast{position:fixed;right:20px;bottom:20px;background:#17213c;color:white;border-radius:9px;padding:10px 14px;display:none}@media(max-width:1200px){main{grid-template-columns:220px 1fr}#inspector{position:fixed;right:0;top:82px;bottom:0;width:280px;box-shadow:-8px 0 25px #17213c22}.workspace{margin-right:280px}}
.workspace-breadcrumb{display:flex!important;align-items:center;gap:6px;min-width:0;max-width:min(44vw,620px);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.workspace-breadcrumb span,.workspace-breadcrumb b{overflow:hidden;text-overflow:ellipsis}.workspace-breadcrumb i{font-style:normal;opacity:.58}.workspace-breadcrumb b{font-weight:650;color:inherit}.workspace-breadcrumb em{font-style:normal;padding:2px 7px;border:1px solid currentColor;border-radius:999px;opacity:.78;font-size:11px}
.api-info-box{margin:0 0 16px;padding:14px 16px;border:1px solid #b8c5ea;border-left:4px solid #6172f3;border-radius:10px;background:#f5f7ff;color:#344054}.api-info-box strong,.api-info-box summary{color:#253253;font-weight:700}.api-info-box summary{cursor:pointer}.api-info-box p{margin:7px 0;line-height:1.45}.api-info-box pre{max-height:260px;overflow:auto;padding:12px;border-radius:8px;background:#1f2942;color:#f5f7ff;font-size:12px;white-space:pre-wrap}.token-json-help{grid-column:1/-1}
nav{align-items:center}.workspace-apply-status{display:inline-flex;align-items:center;min-height:30px;padding:5px 9px;border:1px solid #60709a;border-radius:999px;color:#d9e2fb;background:#202b4e;font-size:11px;font-weight:700;white-space:nowrap}.workspace-apply-status::before{content:"";width:7px;height:7px;margin-right:6px;border-radius:50%;background:#8fd5b0}.workspace-apply-status.dirty{border-color:#d9a552;color:#fff1cd;background:#4a3a28}.workspace-apply-status.dirty::before{background:#f0bd5d}
.table-projections{border:1px solid #d7dfec;border-radius:12px;padding:14px;background:#f8faff}.table-projections-head{display:flex;align-items:start;justify-content:space-between;gap:16px}.table-projections-head h3{margin:0}.table-projections-head p{margin:4px 0 12px;color:#6f7b96}.primary-projection-summary{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:11px;padding:12px;border:1px solid #aebee8;border-left:4px solid #6686ee;border-radius:10px;background:#fff}.primary-projection-summary div,.projection-card-head>div{display:grid;min-width:0;gap:2px}.primary-projection-summary small,.projection-card-head small{color:#6f7b96;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.projection-role{align-self:start;width:max-content;padding:3px 7px;border-radius:999px;background:#e8edff;color:#3f59c5;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.projection-list-head{display:flex;align-items:center;justify-content:space-between;margin:14px 0 7px}.projection-list-head button{padding:6px 9px}.projection-empty{padding:14px;border:1px dashed #cbd5e5;border-radius:9px;color:#6f7b96}.projection-card{border:1px solid #d7dfec;border-radius:10px;background:#fff;padding:12px;margin-top:8px}.projection-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.projection-card-head strong{font-size:14px}.projection-card-head .projection-role{margin-bottom:2px;background:#edf0f5;color:#59657f}.projection-advanced{margin:9px 0 0;padding:0;border:0}.projection-advanced summary{margin:0;color:#59657f;font-size:12px}.projection-advanced[open] summary{margin-bottom:10px}.projection-fields{display:grid;grid-template-columns:repeat(2,minmax(160px,1fr));gap:9px}.projection-fields label{display:grid;gap:4px;color:#59657f;font-size:12px}.projection-fields input,.projection-fields textarea{width:100%;border:1px solid #cbd5e5;border-radius:7px;padding:7px}.projection-fields textarea{min-height:52px;resize:vertical}.projection-help{grid-column:1/-1;color:#6f7b96;font-size:12px;margin:0}.projection-remove{color:#9d3c34;border-color:#e4b7b1}.projection-workbench-card{width:min(920px,92vw);height:min(780px,88vh);display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;overflow:hidden}.projection-workbench-card .modal-head p{margin:4px 0 0;color:#6f7b96}.projection-workbench-intro{display:grid;gap:3px;margin:14px 0 10px;padding:12px 14px;border-radius:10px;background:#edf3ff;color:#334266}.projection-workbench-intro span{font-size:13px}.projection-candidate-list{display:grid;align-content:start;gap:8px;overflow:auto;padding:2px 5px 2px 1px}.projection-candidate{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:13px 14px;border:1px solid #d7dfec;border-radius:11px;background:#fff}.projection-candidate.is-primary{border-color:#8ea4e7;background:#f7f9ff}.projection-candidate-main{min-width:0}.projection-candidate-title{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.projection-candidate code{display:block;margin-top:4px;color:#4c5c78}.projection-candidate p{margin:5px 0 2px;color:#59657f;font-size:13px}.projection-candidate small{display:block;max-width:610px;color:#7a8499;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.projection-candidate-actions{display:flex;flex:0 0 auto;gap:7px}.projection-candidate-actions button{white-space:nowrap}.projection-candidate-actions button:disabled{cursor:default;opacity:.62}.projection-badge{padding:3px 7px;border-radius:999px;font-size:10px;font-weight:800;text-transform:uppercase}.projection-badge.recommended{background:#e8f5eb;color:#26713c}.projection-badge.primary-table{background:#e8edff;color:#3f59c5}.projection-badge.added{background:#fff2d7;color:#855f16}.projection-workbench-card .modal-actions{display:flex;justify-content:flex-end;margin-top:12px}@media(max-width:760px){.table-projections-head,.projection-candidate{align-items:stretch;flex-direction:column}.projection-candidate-actions{justify-content:flex-end}.projection-fields{grid-template-columns:1fr}}
.projection-candidate{align-items:flex-start}.projection-candidate-main{flex:1}.projection-column-picker{margin-top:8px;padding-top:7px;border-top:1px solid #d7dfec}.projection-column-picker summary{cursor:pointer;color:#4c5c78;font-size:12px;font-weight:700}.projection-column-tools{display:flex;gap:6px;margin:8px 0}.projection-column-tools button{padding:4px 8px;font-size:11px}.projection-column-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:5px;max-height:180px;overflow:auto;padding:2px}.projection-column-list label{display:flex;align-items:center;gap:6px;min-width:0;font-size:12px}.projection-column-list input{width:auto;flex:0 0 auto}.projection-column-list span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.projection-column-error{min-height:16px;color:#a43f35!important;white-space:normal!important}
