main { transition: grid-template-columns .2s; }
.library { transition: opacity .15s, transform .2s; }
.library-sticky { position: sticky; top: -24px; z-index: 5; margin: -24px -20px 16px; padding: 24px 20px 1px; background: var(--panel); border-bottom: 1px solid var(--line); box-shadow: 0 8px 14px color-mix(in srgb,var(--text) 4%,transparent); }
.library-sticky .library-tabs { margin-bottom: 14px; }
body.library-collapsed main { grid-template-columns: 0 minmax(530px, 1fr) 360px; }
body.library-collapsed .library { opacity: 0; transform: translateX(-20px); pointer-events: none; padding-inline: 0; border: 0; overflow: hidden; }
body.preview-collapsed main { grid-template-columns: 300px minmax(530px, 1fr) 0; }
body.preview-collapsed .preview-pane { opacity: 0; transform: translateX(20px); pointer-events: none; padding-inline: 0; border: 0; overflow: hidden; }
body.library-collapsed.preview-collapsed main { grid-template-columns: 0 minmax(530px, 1fr) 0; }
.preview-pane { transition: opacity .15s, transform .2s; }
dialog { width: min(920px, calc(100vw - 60px)); max-height: calc(100vh - 70px); border: 1px solid var(--line); border-radius: 18px; background: var(--surface); color: var(--text); padding: 24px; box-shadow: 0 28px 80px color-mix(in srgb,var(--text) 28%,transparent); }
dialog::backdrop { background: color-mix(in srgb,var(--header) 46%,transparent); backdrop-filter: blur(3px); }
.dialog-head { display: flex; align-items: flex-start; justify-content: space-between; }
.reference-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; overflow: auto; max-height: 58vh; }
.reference-card { border: 1px solid var(--line); border-radius: 12px; background: var(--panel); padding: 14px; }
.reference-card header { display: flex; gap: 8px; align-items: center; }
.reference-card code { font-weight: 800; color: var(--accent-strong); font-size: 14px; }
.reference-kind { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; background: var(--soft); border-radius: 999px; padding: 4px 7px; color: var(--muted); }
.reference-card p { margin-top: 7px; color: var(--muted); font-size: 12px; line-height: 1.45; }
.reference-card small { display: block; margin-top: 8px; font: 11px/1.4 Consolas,monospace; color: var(--text); }
.field-item[draggable="true"], .token[draggable="true"] { cursor: grab; }
.field-item[draggable="true"]:active, .token[draggable="true"]:active { cursor: grabbing; }
.token-input.drag-over, .text-expression.drag-over, .option-toggle.drag-over { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--surface)); box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 35%, transparent); }
.token.drag-before { box-shadow: -3px 0 0 var(--accent); }
.text-expression { width: 100%; min-height: 78px; resize: vertical; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--text); padding: 11px 12px; font: 13px/1.5 Consolas,monospace; }
.text-expression:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); outline-offset: 1px; border-color: var(--accent); }
.single-expression { width: 100%; height: 44px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--text); padding: 0 12px; }
.single-expression:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); outline-offset: 1px; border-color: var(--accent); }
.subtotal-settings { display: grid; gap: 8px; }
.setting-choice { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; padding: 11px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); cursor: pointer; }
.setting-choice input { width: 17px; height: 17px; margin-top: 2px; accent-color: var(--accent-strong); }
.setting-choice b,.setting-choice small { display: block; }
.setting-choice small { margin-top: 3px; color: var(--muted); line-height: 1.35; }
.setting-choice.nested { margin-left: 24px; }
.setting-choice.disabled { opacity: .55; cursor: default; }
.subtotal-result { display: flex; gap: 8px; margin-top: 3px; padding: 10px 12px; border-radius: 9px; background: var(--soft); font-size: 12px; }
.subtotal-result span { color: var(--muted); }
