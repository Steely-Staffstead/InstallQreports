.qanvas-template-dialog{width:min(1180px,calc(100vw - 32px));max-width:none;max-height:calc(100vh - 32px);padding:0;overflow:hidden;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:16px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);box-shadow:0 28px 90px #10182860}
.qanvas-template-dialog::backdrop{background:#10182899;backdrop-filter:blur(3px)}
.qanvas-template-shell{display:grid;max-height:calc(100vh - 34px);grid-template-rows:auto minmax(0,1fr) auto}
.qanvas-template-shell>header{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:22px 26px;border-bottom:1px solid var(--qreports-grid,#cbd5e1);background:var(--qreports-header,#eef3f9);color:var(--qreports-header-text,var(--qreports-text,#182230))}
.qanvas-template-shell header p,.qanvas-template-shell header h2,.qanvas-template-shell header span{margin:0}.qanvas-template-shell header p{color:var(--qreports-accent,#4f6ee8);font-size:11px;font-weight:850;letter-spacing:.14em}.qanvas-template-shell header h2{margin-top:4px;font-size:28px}.qanvas-template-shell header span{display:block;margin-top:5px;opacity:.72}
.qanvas-template-shell header button{width:42px;height:42px;padding:0;font-size:24px}.qanvas-template-start{display:grid;grid-template-columns:220px minmax(0,1fr);gap:18px;overflow:auto;padding:22px 26px}
.qanvas-template-blank{align-self:start;display:grid;gap:8px;min-height:190px;padding:24px;border:1px dashed var(--qreports-grid,#cbd5e1);border-radius:14px;background:color-mix(in srgb,var(--qreports-surface,#fff) 92%,var(--qreports-header,#eef3f9));color:var(--qreports-text,#182230);text-align:left}.qanvas-template-blank:hover{border-color:var(--qreports-accent,#4f6ee8)}.qanvas-template-blank>span{font-size:34px;color:var(--qreports-accent,#4f6ee8)}.qanvas-template-blank b{font-size:18px}.qanvas-template-blank small{line-height:1.45;opacity:.68}
.qanvas-template-library{min-width:0}.qanvas-template-tools{display:grid;grid-template-columns:minmax(220px,1fr) 190px auto;gap:10px;align-items:end}.qanvas-template-tools label{display:grid;gap:5px;font-size:12px;font-weight:700}.qanvas-template-tools input,.qanvas-template-tools select,.qanvas-template-tools button{min-height:42px}.qanvas-template-status{min-height:22px;margin:12px 0;color:color-mix(in srgb,var(--qreports-text,#182230) 68%,transparent);font-size:13px}.qanvas-template-status.warning{color:var(--qreports-negative,#b42318)}
.qanvas-template-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:13px}.qanvas-template-card{display:grid;grid-template-rows:132px minmax(125px,1fr) auto;overflow:hidden;border:1px solid var(--qreports-grid,#cbd5e1);border-radius:13px;background:var(--qreports-surface,#fff);box-shadow:0 7px 20px #10182810}.qanvas-template-card.featured{border-color:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 60%,var(--qreports-grid,#cbd5e1))}.qanvas-template-preview{display:flex;align-items:flex-end;padding:9px;background:linear-gradient(135deg,color-mix(in srgb,var(--qreports-accent,#4f6ee8) 16%,var(--qreports-header,#eef3f9)),var(--qreports-surface,#fff));background-position:center;background-size:cover}.qanvas-template-preview span{padding:4px 7px;border-radius:999px;background:#182230d9;color:#fff;font-size:10px;font-weight:800}.qanvas-template-card>div:nth-child(2){padding:13px 14px}.qanvas-template-card h3,.qanvas-template-card p{margin:0}.qanvas-template-card h3{font-size:16px}.qanvas-template-card p{margin-top:7px;min-height:48px;line-height:1.45;opacity:.75}.qanvas-template-card small{display:block;margin-top:9px;opacity:.58}.qanvas-template-card>button{margin:0 14px 14px;justify-self:start}.qanvas-template-empty{display:grid;gap:6px;place-items:center;min-height:220px;border:1px dashed var(--qreports-grid,#cbd5e1);border-radius:13px;opacity:.68}
.qanvas-template-shell>footer{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:13px 26px;border-top:1px solid var(--qreports-grid,#cbd5e1);background:color-mix(in srgb,var(--qreports-surface,#fff) 94%,var(--qreports-header,#eef3f9));font-size:12px}.qanvas-template-shell>footer span{opacity:.68}
@media(max-width:760px){.qanvas-template-start{grid-template-columns:1fr}.qanvas-template-blank{min-height:120px}.qanvas-template-tools{grid-template-columns:1fr}.qanvas-template-shell>footer{align-items:flex-start;flex-direction:column}}
