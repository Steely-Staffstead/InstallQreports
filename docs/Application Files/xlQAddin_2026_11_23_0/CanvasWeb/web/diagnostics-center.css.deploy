.diagnostics-launch{position:relative;display:inline-flex!important;align-items:center;gap:6px}.diagnostics-launch small{display:grid;place-items:center;min-width:18px;height:18px;padding:0 4px;border-radius:999px;background:var(--qreports-surface-soft,#eef2f7);color:var(--qreports-muted,#667085);font-size:10px}.diagnostics-launch.has-problems small{background:color-mix(in srgb,var(--qreports-warning,#d18a20) 18%,var(--qreports-surface,#fff));color:var(--qreports-warning,#9a6100)}
.diagnostics-dialog{width:min(1120px,94vw);height:min(830px,91vh);max-width:none;max-height:none;padding:0;border:1px solid var(--qreports-grid,#465568);border-radius:18px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);box-shadow:0 28px 80px #0007;overflow:hidden}.diagnostics-dialog::backdrop{background:#07101cb3;backdrop-filter:blur(3px)}.diagnostics-shell{display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;height:100%}.diagnostics-shell>header{display:flex;align-items:center;justify-content:space-between;padding:22px 26px 18px;border-bottom:1px solid var(--qreports-grid,#d7deea);background:var(--qreports-panel,#f7f9fc)}.diagnostics-shell>header p{margin:0 0 4px;color:var(--qreports-accent,#4f6ee8);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.diagnostics-shell>header h2{margin:0;font-size:25px}.diagnostics-shell>header span{display:block;margin-top:5px;color:var(--qreports-muted,#667085);font-size:13px}.diagnostics-shell>header button{width:42px;height:42px;padding:0;font-size:22px}.diagnostics-shell>nav{display:flex;gap:4px;padding:10px 18px;border-bottom:1px solid var(--qreports-grid,#d7deea);background:var(--qreports-panel,#f7f9fc)}.diagnostics-shell>nav button{display:flex;align-items:center;gap:8px;border-color:transparent;background:transparent}.diagnostics-shell>nav button.active{border-color:var(--qreports-grid,#d7deea);background:var(--qreports-surface,#fff);color:var(--qreports-accent,#4f6ee8)}.diagnostics-shell>nav small{display:grid;place-items:center;min-width:19px;height:19px;padding:0 5px;border-radius:999px;background:var(--qreports-surface-soft,#e9eef6);font-size:10px}.diagnostics-shell>main{min-height:0;margin:0;padding:20px 24px;overflow:auto;background:var(--qreports-background,#eef2f7)}.diagnostics-shell>footer{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 20px;border-top:1px solid var(--qreports-grid,#d7deea);background:var(--qreports-panel,#f7f9fc)}.diagnostics-shell>footer>span{color:var(--qreports-muted,#667085);font-size:11px}.diagnostics-shell>footer>div{display:flex;gap:8px}
.diagnostics-overview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:18px}.diagnostics-overview>div{display:flex;align-items:baseline;gap:10px;padding:16px 18px;border:1px solid var(--qreports-grid,#d7deea);border-radius:13px;background:var(--qreports-surface,#fff)}.diagnostics-overview b{font-size:28px}.diagnostics-overview span{color:var(--qreports-muted,#667085);font-size:12px}.diagnostics-overview .blocker b{color:var(--qreports-negative,#c84f5b)}.diagnostics-overview .warning b{color:var(--qreports-warning,#d18a20)}.diagnostics-overview .pass b{color:var(--qreports-positive,#248b65)}
.diagnostics-source-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.diagnostics-source{display:grid;gap:13px;padding:17px;border:1px solid var(--qreports-grid,#d7deea);border-left:5px solid var(--qreports-positive,#248b65);border-radius:14px;background:var(--qreports-surface,#fff)}.diagnostics-source.warning{border-left-color:var(--qreports-warning,#d18a20)}.diagnostics-source.blocker{border-left-color:var(--qreports-negative,#c84f5b)}.diagnostics-source>header{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:11px}.diagnostics-source h3,.diagnostics-issue h3,.diagnostics-event h3{margin:0;font-size:15px}.diagnostics-source header p,.diagnostics-issue p,.diagnostics-event p{margin:3px 0 0;color:var(--qreports-muted,#667085);font-size:12px}.diagnostics-tone{padding:5px 8px;border-radius:999px;background:color-mix(in srgb,var(--qreports-positive,#248b65) 14%,var(--qreports-surface,#fff));color:var(--qreports-positive,#248b65);font-size:10px;font-weight:800;text-transform:uppercase}.diagnostics-source.warning .diagnostics-tone{background:color-mix(in srgb,var(--qreports-warning,#d18a20) 14%,var(--qreports-surface,#fff));color:var(--qreports-warning,#9a6100)}.diagnostics-source.blocker .diagnostics-tone{background:color-mix(in srgb,var(--qreports-negative,#c84f5b) 14%,var(--qreports-surface,#fff));color:var(--qreports-negative,#c84f5b)}.diagnostics-source dl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0}.diagnostics-source dl div{min-width:0;padding:9px;border-radius:9px;background:var(--qreports-panel,#f5f7fa)}.diagnostics-source dl .wide{grid-column:span 4}.diagnostics-source dt{color:var(--qreports-muted,#667085);font-size:10px;text-transform:uppercase}.diagnostics-source dd{margin:4px 0 0;overflow:hidden;text-overflow:ellipsis;font-size:12px;font-weight:700;white-space:nowrap}.diagnostics-source ul{display:grid;gap:4px;margin:0;padding:0;list-style:none}.diagnostics-source li{padding:7px 9px;border-radius:8px;background:color-mix(in srgb,var(--qreports-warning,#d18a20) 10%,transparent);font-size:11px}.diagnostics-source li.blocker{background:color-mix(in srgb,var(--qreports-negative,#c84f5b) 10%,transparent)}.diagnostics-ok{margin:0;color:var(--qreports-positive,#248b65);font-size:11px}.diagnostics-source>footer{display:flex;flex-wrap:wrap;gap:7px;padding:0;border:0;background:transparent}.diagnostics-source>footer button{font-size:11px}
.diagnostics-section-heading{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:14px}.diagnostics-section-heading h3{margin:0 0 4px}.diagnostics-section-heading p{margin:0;color:var(--qreports-muted,#667085);font-size:12px}.diagnostics-issue-list,.diagnostics-event-list{display:grid;gap:9px}.diagnostics-issue,.diagnostics-event{display:grid;grid-template-columns:32px minmax(0,1fr);gap:11px;padding:13px 15px;border:1px solid var(--qreports-grid,#d7deea);border-radius:11px;background:var(--qreports-surface,#fff)}.diagnostics-issue>span,.diagnostics-event>span{display:grid;place-items:center;width:29px;height:29px;border-radius:50%;background:color-mix(in srgb,var(--qreports-warning,#d18a20) 15%,transparent);color:var(--qreports-warning,#9a6100);font-weight:900}.diagnostics-issue.blocker>span,.diagnostics-event.error>span{background:color-mix(in srgb,var(--qreports-negative,#c84f5b) 15%,transparent);color:var(--qreports-negative,#c84f5b)}.diagnostics-event.success>span{background:color-mix(in srgb,var(--qreports-positive,#248b65) 15%,transparent);color:var(--qreports-positive,#248b65)}.diagnostics-issue small,.diagnostics-event small{display:block;margin-top:5px;color:var(--qreports-muted,#667085);font-size:10px}.diagnostics-empty{padding:24px;border:1px dashed var(--qreports-grid,#d7deea);border-radius:12px;background:var(--qreports-surface,#fff);color:var(--qreports-muted,#667085);text-align:center}.diagnostics-empty.success{color:var(--qreports-positive,#248b65)}
@media(max-width:850px){.diagnostics-source-list{grid-template-columns:1fr}.diagnostics-source dl{grid-template-columns:repeat(2,minmax(0,1fr))}.diagnostics-source dl .wide{grid-column:span 2}.diagnostics-shell>footer{align-items:flex-start;flex-direction:column}.diagnostics-overview{grid-template-columns:1fr}}

/* Isolate the dialog from the application-level main grid. */
.diagnostics-shell>main{display:block;grid-template-columns:none;min-width:0;width:auto;height:auto}
.diagnostics-source-list{grid-template-columns:repeat(2,minmax(360px,1fr))}
.diagnostics-source{min-width:0}
@media(max-width:850px){.diagnostics-source-list{grid-template-columns:minmax(0,1fr)}}
.diagnostics-stage-trail{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:5px}.diagnostics-stage-trail>div{position:relative;min-width:0;padding:8px 6px 7px;border:1px solid var(--qreports-grid,#d7deea);border-radius:9px;background:var(--qreports-panel,#f5f7fa);text-align:center}.diagnostics-stage-trail>div::after{content:"";position:absolute;left:100%;top:15px;width:6px;height:1px;background:var(--qreports-grid,#d7deea)}.diagnostics-stage-trail>div:last-child::after{display:none}.diagnostics-stage-trail span{display:block;width:8px;height:8px;margin:0 auto 5px;border-radius:50%;background:var(--qreports-muted,#8893a4)}.diagnostics-stage-trail .pass span{background:var(--qreports-positive,#248b65);box-shadow:0 0 0 3px color-mix(in srgb,var(--qreports-positive,#248b65) 14%,transparent)}.diagnostics-stage-trail .warning span{background:var(--qreports-warning,#d18a20);box-shadow:0 0 0 3px color-mix(in srgb,var(--qreports-warning,#d18a20) 14%,transparent)}.diagnostics-stage-trail .error span{background:var(--qreports-negative,#c84f5b);box-shadow:0 0 0 3px color-mix(in srgb,var(--qreports-negative,#c84f5b) 14%,transparent)}.diagnostics-stage-trail b,.diagnostics-stage-trail small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.diagnostics-stage-trail b{font-size:9px}.diagnostics-stage-trail small{margin-top:3px;color:var(--qreports-muted,#667085);font-size:8px}
@media(max-width:620px){.diagnostics-stage-trail{grid-template-columns:repeat(3,minmax(0,1fr))}.diagnostics-stage-trail>div:nth-child(3)::after{display:none}}

/* A resizable, focused source view keeps diagnostic values readable. */
.diagnostics-dialog{min-width:min(720px,calc(100vw - 24px));min-height:min(520px,calc(100vh - 24px));max-width:calc(100vw - 24px);max-height:calc(100vh - 24px);resize:both}
.diagnostics-source-list{grid-template-columns:minmax(0,1fr)}
.diagnostics-source-picker{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin:-2px 0 14px;padding:12px 14px;border:1px solid var(--qreports-grid,#d7deea);border-radius:12px;background:var(--qreports-surface,#fff)}
.diagnostics-source-picker label{display:grid;grid-template-columns:minmax(110px,auto) minmax(260px,480px);align-items:center;gap:10px;min-width:min(100%,640px)}
.diagnostics-source-picker label>span{font-size:12px;font-weight:750}
.diagnostics-source-picker select{box-sizing:border-box;width:100%;min-width:0;padding:9px 34px 9px 11px;border:1px solid var(--qreports-grid,#d7deea);border-radius:9px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);font:inherit}
.diagnostics-source-picker>small{color:var(--qreports-muted,#667085);font-size:11px;white-space:nowrap}
@media(max-width:850px){.diagnostics-source-picker{align-items:stretch;flex-direction:column}.diagnostics-source-picker label{grid-template-columns:1fr}.diagnostics-source-picker>small{white-space:normal}}

/* Detailed runtime trace for the selected source refresh. */
.diagnostics-stage-trail .running span{background:var(--qreports-accent,#4f6ee8);box-shadow:0 0 0 3px color-mix(in srgb,var(--qreports-accent,#4f6ee8) 16%,transparent);animation:diagnostics-pulse 1.1s ease-in-out infinite alternate}
@keyframes diagnostics-pulse{to{transform:scale(1.35)}}
.diagnostics-refresh-trace{border:1px solid var(--qreports-grid,#d7deea);border-radius:11px;background:var(--qreports-panel,#f5f7fa)}
.diagnostics-refresh-trace>summary{padding:10px 12px;color:var(--qreports-text,#182230);font-size:11px;font-weight:800;cursor:pointer}
.diagnostics-refresh-trace ol{display:grid;gap:0;margin:0;padding:0 12px 10px;list-style:none}
.diagnostics-refresh-trace li{display:grid;grid-template-columns:12px minmax(0,1fr) auto;align-items:start;gap:9px;padding:8px 0;border-top:1px solid color-mix(in srgb,var(--qreports-grid,#d7deea) 70%,transparent)}
.diagnostics-refresh-trace li>span{width:9px;height:9px;margin-top:3px;border:2px solid var(--qreports-muted,#8893a4);border-radius:50%;background:var(--qreports-surface,#fff)}
.diagnostics-refresh-trace li.pass>span{border-color:var(--qreports-positive,#248b65);background:var(--qreports-positive,#248b65)}
.diagnostics-refresh-trace li.running>span{border-color:var(--qreports-accent,#4f6ee8);background:var(--qreports-accent,#4f6ee8)}
.diagnostics-refresh-trace li.warning>span{border-color:var(--qreports-warning,#d18a20);background:var(--qreports-warning,#d18a20)}
.diagnostics-refresh-trace li.error>span{border-color:var(--qreports-negative,#c84f5b);background:var(--qreports-negative,#c84f5b)}
.diagnostics-refresh-trace li b{display:block;font-size:11px}
.diagnostics-refresh-trace li p{margin:2px 0 0;color:var(--qreports-muted,#667085);font-size:10px;line-height:1.35}
.diagnostics-refresh-trace li>small{color:var(--qreports-muted,#667085);font-size:9px;white-space:nowrap}
@media(max-width:620px){.diagnostics-refresh-trace li{grid-template-columns:12px minmax(0,1fr)}.diagnostics-refresh-trace li>small{grid-column:2;white-space:normal}}

/* Compact default keeps the complete health summary and selected source within a normal screen. */
.diagnostics-dialog{width:min(1000px,calc(100vw - 32px));height:min(700px,calc(100vh - 32px));min-width:min(680px,calc(100vw - 24px));min-height:min(480px,calc(100vh - 24px))}
.diagnostics-shell>header{padding:13px 18px 11px}.diagnostics-shell>header p{margin-bottom:2px}.diagnostics-shell>header h2{font-size:20px}.diagnostics-shell>header span{display:inline;margin:0 0 0 10px;font-size:11px}.diagnostics-shell>header>div{display:flex;align-items:baseline;flex-wrap:wrap}.diagnostics-shell>header button{width:36px;height:36px}
.diagnostics-shell>nav{padding:6px 12px}.diagnostics-shell>main{padding:12px 16px}.diagnostics-shell>footer{padding:9px 16px}
.diagnostics-source-toolbar{display:grid;grid-template-columns:auto minmax(260px,1fr) auto auto;align-items:center;gap:12px;margin-bottom:10px;padding:8px 10px;border:1px solid var(--qreports-grid,#d7deea);border-radius:11px;background:var(--qreports-surface,#fff)}
.diagnostics-source-toolbar .diagnostics-overview{display:flex;gap:4px;margin:0}.diagnostics-source-toolbar .diagnostics-overview>div{gap:5px;padding:5px 8px;border:0;border-radius:8px;background:var(--qreports-panel,#f5f7fa)}.diagnostics-source-toolbar .diagnostics-overview b{font-size:17px}.diagnostics-source-toolbar .diagnostics-overview span{font-size:10px}
.diagnostics-source-toolbar>label{display:grid;grid-template-columns:auto minmax(180px,1fr);align-items:center;gap:8px}.diagnostics-source-toolbar label>span{font-size:11px;font-weight:750}.diagnostics-source-toolbar select{box-sizing:border-box;width:100%;min-width:0;padding:7px 30px 7px 9px;border:1px solid var(--qreports-grid,#d7deea);border-radius:8px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230);font:inherit}.diagnostics-source-toolbar>small{color:var(--qreports-muted,#667085);font-size:10px;white-space:nowrap}
.diagnostics-source{gap:9px;padding:12px}.diagnostics-source>header{gap:8px}.diagnostics-stage-trail>div{padding:6px 5px 5px}.diagnostics-source-details{border:1px solid var(--qreports-grid,#d7deea);border-radius:9px;background:var(--qreports-panel,#f5f7fa)}.diagnostics-source-details>summary{padding:8px 10px;font-size:11px;font-weight:800;cursor:pointer}.diagnostics-source-details>div{display:grid;gap:8px;padding:0 10px 10px}.diagnostics-source-details .diagnostics-refresh-trace{background:var(--qreports-surface,#fff)}

/* The dialog chrome belongs to the application, not to the report canvas. */
.diagnostics-shell>header,.diagnostics-shell>footer{background:var(--qreports-header,#15253d);color:var(--qreports-header-text,#fff)}
.diagnostics-shell>header h2{color:inherit}.diagnostics-shell>header span,.diagnostics-shell>footer>span{color:color-mix(in srgb,var(--qreports-header-text,#fff) 78%,transparent)}
.diagnostics-shell>header button,.diagnostics-shell>footer button{border-color:color-mix(in srgb,var(--qreports-header-text,#fff) 32%,transparent);background:color-mix(in srgb,var(--qreports-header-text,#fff) 10%,transparent);color:var(--qreports-header-text,#fff)}
.diagnostics-shell>header button:hover,.diagnostics-shell>footer button:hover{border-color:color-mix(in srgb,var(--qreports-header-text,#fff) 54%,transparent);background:color-mix(in srgb,var(--qreports-header-text,#fff) 18%,transparent)}
@media(max-width:850px){.diagnostics-source-toolbar{grid-template-columns:1fr}.diagnostics-source-toolbar>label{grid-template-columns:1fr}.diagnostics-source-toolbar>small{white-space:normal}.diagnostics-shell>header span{display:block;width:100%;margin:2px 0 0}}

/* Keep every diagnostics control on the application theme. The report theme must not
   leak into the chrome or fall back to the browser's light button/navigation colors. */
.diagnostics-dialog button{border:1px solid var(--qreports-grid,#465568);background:var(--qreports-surface,#171b22);color:var(--qreports-text,#eef2f7)}
.diagnostics-dialog button:hover:not(:disabled){border-color:var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 12%,var(--qreports-surface,#171b22))}
.diagnostics-dialog button.primary{border-color:var(--qreports-accent,#4f6ee8);background:var(--qreports-accent,#4f6ee8);color:var(--qreports-on-accent,#fff)}
.diagnostics-dialog button:disabled{opacity:.55}
.diagnostics-shell>nav{border-color:var(--qreports-grid,#465568);background:var(--qreports-header,#15253d);color:var(--qreports-header-text,#fff)}
.diagnostics-shell>nav button{border-color:transparent;background:transparent;color:color-mix(in srgb,var(--qreports-header-text,#fff) 76%,transparent)}
.diagnostics-shell>nav button:hover:not(:disabled){border-color:color-mix(in srgb,var(--qreports-header-text,#fff) 28%,transparent);background:color-mix(in srgb,var(--qreports-header-text,#fff) 10%,transparent);color:var(--qreports-header-text,#fff)}
.diagnostics-shell>nav button.active{border-color:var(--qreports-accent,#4f6ee8);background:var(--qreports-accent,#4f6ee8);color:var(--qreports-on-accent,#fff)}
.diagnostics-shell>nav small{background:color-mix(in srgb,var(--qreports-header-text,#fff) 14%,transparent);color:inherit}
.diagnostics-shell>nav button.active small{background:color-mix(in srgb,var(--qreports-on-accent,#fff) 18%,transparent)}
.diagnostics-repair{display:flex;align-items:flex-end;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid var(--qreports-grid,#d7deea)}
.diagnostics-repair label{display:grid;gap:4px;min-width:min(320px,100%);font-size:10px;font-weight:750}
.diagnostics-repair select{box-sizing:border-box;width:100%;padding:7px 28px 7px 8px;border:1px solid var(--qreports-grid,#d7deea);border-radius:7px;background:var(--qreports-surface,#fff);color:var(--qreports-text,#182230)}
.diagnostics-repair button{white-space:nowrap}
@media(max-width:700px){.diagnostics-repair{align-items:stretch;flex-direction:column}}

/* Health is application chrome. Derive secondary surfaces from the active application
   roles so legacy light panel/background fallbacks cannot leak into dark themes. */
.diagnostics-dialog{background:var(--qreports-surface);color:var(--qreports-text);color-scheme:var(--qreports-color-scheme,dark)}
.diagnostics-shell>main{background:color-mix(in srgb,var(--qreports-surface) 92%,var(--qreports-header))}
.diagnostics-source-toolbar,.diagnostics-source,.diagnostics-issue,.diagnostics-event,.diagnostics-empty{background:var(--qreports-surface);color:var(--qreports-text)}
.diagnostics-source-toolbar .diagnostics-overview>div,.diagnostics-stage-trail>div,.diagnostics-source dl div,.diagnostics-source-details,.diagnostics-refresh-trace{background:color-mix(in srgb,var(--qreports-surface) 88%,var(--qreports-header));color:var(--qreports-text)}
.diagnostics-source-details .diagnostics-refresh-trace{background:color-mix(in srgb,var(--qreports-surface) 96%,var(--qreports-header))}
.diagnostics-source-details>summary,.diagnostics-stage-trail b,.diagnostics-source h3,.diagnostics-issue h3,.diagnostics-event h3{color:var(--qreports-text)}
.diagnostics-stage-trail small,.diagnostics-source dt,.diagnostics-source dd,.diagnostics-source header p,.diagnostics-issue p,.diagnostics-event p,.diagnostics-overview span{color:var(--qreports-muted)}
