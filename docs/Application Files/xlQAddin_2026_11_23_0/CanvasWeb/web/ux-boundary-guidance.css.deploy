.snapshot-recipient-contract{display:grid;gap:4px;margin-top:4px;padding:10px;border:1px solid var(--qreports-grid,#d7deea);border-radius:9px;background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 7%,var(--qreports-surface,#fff));color:var(--qreports-text,#182230)}.snapshot-recipient-contract>span{color:var(--qreports-accent,#4f6ee8);font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.snapshot-recipient-contract>b{font-size:11px}.snapshot-recipient-contract>p,.snapshot-recipient-contract>small{margin:0;color:var(--qreports-muted,#667085);font-size:9px;line-height:1.4}.snapshot-recipient-contract>small{padding-top:4px;border-top:1px solid color-mix(in srgb,var(--qreports-grid,#d7deea) 65%,transparent)}
.theme-boundary-note{margin:0 0 10px!important;padding:8px 9px;border-left:3px solid var(--qreports-accent,#4f6ee8);background:color-mix(in srgb,var(--qreports-accent,#4f6ee8) 6%,transparent);line-height:1.4}
.publish-output-comparison{margin:0 0 14px;border:1px solid var(--qreports-grid,#46536b);border-radius:12px;overflow:hidden;background:var(--qreports-surface,#171b22)}.publish-output-comparison>header{padding:11px 13px;border-bottom:1px solid var(--qreports-grid,#46536b)}.publish-output-comparison h4,.publish-output-comparison p{margin:0}.publish-output-comparison p{margin-top:3px;color:var(--qreports-muted,#aab4c3);font-size:10px}.publish-comparison-grid{display:grid;grid-template-columns:minmax(100px,.65fr) repeat(4,minmax(130px,1fr));overflow:auto}.publish-comparison-grid>*{min-width:0;padding:8px 10px;border-right:1px solid var(--qreports-grid,#46536b);border-bottom:1px solid var(--qreports-grid,#46536b);font-size:9px;line-height:1.35}.publish-comparison-grid>b{background:var(--qreports-panel,#222936);font-size:9px;text-transform:uppercase}.publish-comparison-grid>strong{color:var(--qreports-accent,#8aa4ff);font-size:10px}.publish-comparison-grid>span{color:var(--qreports-muted,#c0c7d2)}
