(() => {
  const runtime={name:"Qvitr Viewer",version:"2026.11",documentVersion:2};
  if(!document.querySelector('link[href*="viewer-launch-guard.css"]')){const link=document.createElement("link"),script=document.currentScript?.src||"";link.rel="stylesheet";link.href=`${script.includes("/app/")?"app/":""}viewer-launch-guard.css?v=20261110-support-handoff-6`;document.head.append(link);}
  const esc=value=>String(value??"").replace(/[&<>"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char]));
  const parts=value=>String(value||"0").split(".").map(item=>Number.parseInt(item,10)||0);
  const newer=(required,current)=>{const left=parts(required),right=parts(current);for(let index=0;index<Math.max(left.length,right.length);index++){if((left[index]||0)!==(right[index]||0))return(left[index]||0)>(right[index]||0);}return false;};
  const recoverySession=new Map(),recoveryKey=item=>String(item?.sourceId||item?.name||"");
  const safeDetail=value=>String(value||"").replace(/\bBearer\s+[A-Za-z0-9._~+\/-]+=*/gi,"Bearer [redacted]").replace(/\b(password|pwd|token|secret|api[-_ ]?key|authorization)\s*[:=]\s*([^\s;,]+)/gi,"$1=[redacted]");
  function recordRecovery(item,status,detail=""){const key=recoveryKey(item);if(!key)return[];const state=recoverySession.get(key)||{attempts:0,events:[]},now=Date.now(),last=state.events.at(-1);if(status==="running"&&last?.status==="running"&&now-new Date(last.time).getTime()<1500)return state.events;if(status==="running")state.attempts+=1;if(!state.attempts)state.attempts=1;state.events.push({attempt:state.attempts,status,detail:safeDetail(detail),time:new Date(now).toISOString()});if(state.events.length>20)state.events.splice(0,state.events.length-20);recoverySession.set(key,state);return state.events;}
  const historyMarkup=item=>{const key=recoveryKey(item),state=recoverySession.get(key),events=state?.events||[];return `<details class="viewer-recovery-history"><summary>${events.length?`${state.attempts} attempt${state.attempts===1?"":"s"} · ${events.length} event${events.length===1?"":"s"}`:"No retry history yet"}</summary><ol>${events.map(event=>`<li data-state="${esc(event.status)}"><time>${esc(new Date(event.time).toLocaleTimeString([],{hour:"2-digit",minute:"2-digit",second:"2-digit"}))}</time><span>Attempt ${event.attempt}: ${esc(event.detail||event.status)}</span></li>`).join("")}</ol>${events.length?`<button type="button" data-recovery-copy="${esc(key)}">Copy support details</button>`:""}</details>`;};
  const supportText=key=>{const state=recoverySession.get(String(key||""));if(!state)return"";return [`Qvitr recipient recovery`, `Source: ${key}`, `Attempts: ${state.attempts}`,...state.events.map(event=>`${event.time} | attempt ${event.attempt} | ${event.status} | ${event.detail||""}`)].join("\n");};
  async function copySupportText(key){const text=supportText(key);if(!text)return false;try{await navigator.clipboard.writeText(text);return true;}catch{const field=document.createElement("textarea");field.value=text;field.setAttribute("readonly","");field.style.position="fixed";field.style.opacity="0";document.body.append(field);field.select();const copied=document.execCommand("copy");field.remove();return copied;}}
  function renderRecoveryHistory(row,item){const existing=row.querySelector(".viewer-recovery-history"),holder=document.createElement("div");holder.innerHTML=historyMarkup(item);existing?.replaceWith(holder.firstElementChild);}
  document.addEventListener("click",async event=>{const button=event.target.closest?.("[data-recovery-copy]");if(!button)return;const copied=await copySupportText(button.dataset.recoveryCopy);button.textContent=copied?"Copied":"Copy failed";const status=button.closest(".viewer-source-progress")?.querySelector("header small");if(status)status.textContent=copied?"Secret-free retry details copied for support.":"Retry details could not be copied.";});
  function evaluate(document,installed=runtime){
    const compatibility=document?.publication?.viewerCompatibility||{},manifest=compatibility.manifest||null,required=compatibility.requiredViewerVersion||manifest?.contract?.version||"",documentVersion=Number(document?.version||0),dependencies=manifest?.dependencies||[],unavailable=dependencies.filter(item=>item.status==="unavailable"),signIn=dependencies.filter(item=>item.status==="sign-in"),snapshots=dependencies.filter(item=>item.kind==="source"&&item.snapshotAvailable!==false&&item.offlineAvailable!==false),sourceDependencies=dependencies.filter(item=>item.kind==="source"),snapshotAvailable=!sourceDependencies.length||snapshots.length===sourceDependencies.length,base={requiredViewerVersion:required,installedViewerVersion:installed.version,installedDocumentVersion:installed.documentVersion,documentVersion,unavailable,signIn,manifest,snapshotAvailable};
    if(documentVersion>installed.documentVersion)return{...base,status:"upgrade",reason:"document-newer",canOpenSnapshot:false,recommendedAction:`Install ${runtime.name} ${required||"with document format "+documentVersion} or later, then reopen the report.`};
    if(required&&newer(required,installed.version))return{...base,status:"upgrade",reason:"viewer-older",canOpenSnapshot:false,recommendedAction:`Update ${runtime.name} from ${installed.version} to ${required} or later.`};
    if(unavailable.length)return{...base,status:"incompatible",reason:"dependency-unavailable",canOpenSnapshot:snapshotAvailable,recommendedAction:"Open supported content and follow the publisher repair guidance for unavailable items."};
    if(signIn.length)return{...base,status:"sign-in",reason:"authentication-required",canOpenSnapshot:snapshotAvailable,recommendedAction:snapshotAvailable?"Open the saved snapshot now; sign in only when you choose to update data.":"Sign in to the required sources before loading data."};
    return{...base,status:manifest?"ready":"legacy",reason:manifest?"compatible":"legacy-document",canOpenSnapshot:true,recommendedAction:manifest?"Open the report.":"Open the legacy report and republish it to record a current compatibility contract."};
  }
  const recoveryAdvice=(item,status)=>status==="success"?"No further action is needed.":status==="sign-in"?"Sign in with an account that can access this source, then retry.":status==="unavailable"?item.kind==="html"?"Ask the publisher for an embedded or Viewer-safe version of this content.":item.kind==="app"?"Ask the publisher to include the missing App definition.":"Ask the publisher to save portable data or configure recipient access.":"Check access and connectivity, then retry this source.";
  function startRecovery(dependencies=[],options={}){document.querySelector(".viewer-source-progress")?.remove();const updating=options.mode==="updating",panel=document.createElement("aside");panel.className="viewer-source-progress viewer-recovery-workspace";panel.setAttribute("role","region");panel.setAttribute("aria-labelledby","viewerRecoveryTitle");panel.innerHTML=`<header><div><b id="viewerRecoveryTitle">Recipient recovery</b><small aria-live="polite">${updating?"Updating protected data. Authentication is requested only when needed.":"Review each item and use the recommended next action."}</small></div><button type="button" aria-label="Hide recipient recovery">×</button></header><div>${dependencies.map((item,index)=>{const state=updating?"pending":item.status||"unavailable",canRetry=state==="sign-in";return `<article data-recovery-index="${index}" data-source-id="${esc(item.sourceId||"")}" data-source-name="${esc(item.name)}" data-state="${esc(state)}"><span>${state==="unavailable"?"×":state==="sign-in"?"!":"○"}</span><div><b>${esc(item.name)}</b><small>${esc(item.detail||recoveryAdvice(item,state))}</small><p>${esc(recoveryAdvice(item,state))}</p>${canRetry?'<button type="button" data-recovery-retry>Sign in and retry</button>':""}${historyMarkup(item)}</div></article>`;}).join("")}</div>`;document.body.append(panel);panel.querySelector("header button").onclick=()=>panel.remove();panel.addEventListener("click",event=>{const button=event.target.closest("[data-recovery-retry]");if(!button)return;const row=button.closest("article"),item=dependencies[Number(row.dataset.recoveryIndex)];button.disabled=true;button.textContent="Starting…";row.dataset.state="running";recordRecovery(item,"running","Retry started");renderRecoveryHistory(row,item);window.dispatchEvent(new CustomEvent("qvitr:viewer-update-protected",{detail:{dependencies:[item],origin:"recipient-recovery"}}));});return panel;}
  function startProgress(dependencies=[]){dependencies.forEach(item=>recordRecovery(item,"pending","Waiting to update"));return startRecovery(dependencies,{mode:"updating"});}
  function updateProgress(sourceId,status,detail=""){const panel=document.querySelector(".viewer-source-progress");if(!panel)return;const safe=globalThis.CSS?.escape?CSS.escape(String(sourceId||"")):String(sourceId||"").replace(/["\\]/g,"\\$&"),row=panel.querySelector(`[data-source-id="${safe}"]`)||[...panel.querySelectorAll("article")].find(item=>item.dataset.sourceName===sourceId);if(!row)return;const message=detail||({running:"Updating…","sign-in":"Waiting for sign-in","success":"Updated","error":"Update failed",cancelled:"Update cancelled"}[status]||status),item={sourceId:row.dataset.sourceId,name:row.dataset.sourceName};row.dataset.state=status;row.querySelector(":scope>span").textContent=status==="success"?"✓":status==="error"?"×":status==="sign-in"?"!":"↻";row.querySelector("small").textContent=message;row.querySelector("p").textContent=recoveryAdvice(item,status);recordRecovery(item,status,message);renderRecoveryHistory(row,item);let button=row.querySelector("[data-recovery-retry]");if(["error","sign-in","cancelled"].includes(status)){if(!button){button=document.createElement("button");button.type="button";button.dataset.recoveryRetry="";row.querySelector("div").insertBefore(button,row.querySelector(".viewer-recovery-history"));}button.disabled=false;button.textContent=status==="sign-in"?"Sign in and retry":"Retry source";}else button?.remove();if(!panel.querySelector('article[data-state="pending"],article[data-state="running"],article[data-state="sign-in"]'))panel.querySelector("header small").textContent="Updates finished. Review any item that still needs attention.";}
  function isolateUnsupported(document,dependencies=[]){const unavailable=dependencies.filter(item=>item.status==="unavailable"&&["app","html"].includes(item.kind));for(const page of document.pages||[])for(const tile of [...(page.tiles||[]),...(page.graphics||[])]){const fallbackName=tile.title||({app:"App",html:"HTML document"}[tile.kind]),match=unavailable.find(item=>item.objectId&&item.objectId===tile.id)||unavailable.find(item=>!item.objectId&&item.kind===tile.kind&&item.name===fallbackName);if(match)tile.viewerCompatibility={unavailable:true,kind:match.kind,reason:match.detail||"This content is unavailable in the installed Viewer.",isolatedUtc:new Date().toISOString()};}return document;}
  function request(document,{fileName="",onContinue}={}){
    const result=evaluate(document);if(["ready","legacy"].includes(result.status))return true;
    document.querySelector?.(".viewer-launch-guard")?.remove?.();
    const upgrade=result.status==="upgrade",blocked=result.status==="incompatible",items=upgrade?[{name:`Requires ${runtime.name} ${result.requiredViewerVersion} or later`,detail:`This installation is ${result.installedViewerVersion}. ${result.recommendedAction}`}]:result.unavailable;
    const dialog=globalThis.document.createElement("dialog");dialog.className="viewer-launch-guard";dialog.setAttribute("aria-labelledby","viewerLaunchTitle");dialog.innerHTML=`<div class="viewer-launch-shell"><header><p>${esc(runtime.name)} compatibility</p><h2 id="viewerLaunchTitle">${upgrade?"A newer Viewer is required":blocked?"Some report content is unavailable":"Sign-in may be required"}</h2><span>${esc(fileName||document.name||"Qanvas report")}</span></header><section><p>${upgrade?"Update Qvitr Viewer before opening this report.":blocked?"Review the unsupported dependencies before opening the supported parts of this report.":"The saved report can open now. Updating protected data may ask the recipient to sign in."}</p><div class="viewer-launch-items">${(items.length?items:result.signIn).map(item=>`<article><span>${upgrade||blocked?"×":"!"}</span><div><b>${esc(item.name)}</b><small>${esc(item.detail||"Recipient authentication is required to update this dependency.")}</small></div></article>`).join("")}</div></section><footer><button type="button" data-viewer-launch-cancel>Cancel</button>${upgrade?'<button type="button" class="primary" data-viewer-launch-update>Check for updates</button>':`<button type="button" class="primary" data-viewer-launch-continue>${blocked?"Open supported content":"Open saved report"}</button>${result.status==="sign-in"?'<button type="button" data-viewer-launch-refresh>Open and update data</button>':""}`}</footer></div>`;
    globalThis.document.body.append(dialog);const continueOpen=refresh=>{dialog.close();dialog.remove();onContinue?.({isolate:blocked,dependencies:result.unavailable});if(refresh){startProgress(result.signIn);setTimeout(()=>window.dispatchEvent(new CustomEvent("qvitr:viewer-update-protected",{detail:{dependencies:result.signIn}})),0);}else if(blocked&&[...result.unavailable,...result.signIn].length)startRecovery([...result.unavailable,...result.signIn]);};dialog.querySelector("[data-viewer-launch-cancel]").onclick=()=>{dialog.close();dialog.remove();};dialog.querySelector("[data-viewer-launch-continue]")?.addEventListener("click",()=>continueOpen(false));dialog.querySelector("[data-viewer-launch-refresh]")?.addEventListener("click",()=>continueOpen(true));dialog.querySelector("[data-viewer-launch-update]")?.addEventListener("click",()=>{window.QvitrUpdateUi?.requireVersion?.(result.requiredViewerVersion);globalThis.document.querySelector('[data-action="checkForUpdates"]')?.click();});dialog.showModal();return false;
  }
  window.QvitrViewerLaunchGuard={runtime,evaluate,evaluateAgainst:(document,installed)=>evaluate(document,{...runtime,...installed}),request,startRecovery,startProgress,updateProgress,recoveryHistory:item=>structuredClone(recoverySession.get(recoveryKey(item))||{attempts:0,events:[]}),supportText,isolateUnsupported};
})();
