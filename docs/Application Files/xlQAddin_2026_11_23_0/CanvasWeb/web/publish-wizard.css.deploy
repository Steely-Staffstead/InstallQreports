#exportMenu .publish-action{margin-top:4px;box-shadow:inset 0 1px color-mix(in srgb,var(--qreports-grid,#46536b) 75%,transparent);font-weight:700}
.publish-dialog{width:min(1040px,calc(100vw - 36px));height:min(760px,calc(100vh - 36px));padding:0;border:1px solid var(--qreports-grid,#46536b);border-radius:18px;background:var(--qreports-surface,#171b22);color:var(--qreports-text,#eef2f7);box-shadow:0 30px 90px #0008;overflow:hidden}
.publish-dialog::backdrop{background:#071019b8;backdrop-filter:blur(3px)}
.publish-shell{height:100%;display:grid;grid-template-rows:auto 1fr auto}
.publish-heading{display:flex;align-items:center;justify-content:space-between;padding:22px 26px;border-bottom:1px solid var(--qreports-grid,#46536b);background:var(--qreports-header-background,#11151b);color:var(--qreports-header-text,#f5f7fa)}
.publish-heading h2{margin:0;font-size:25px}.publish-heading p{margin:4px 0 0;color:color-mix(in srgb,currentColor 70%,transparent)}.publish-heading button{font-size:24px;padding:5px 13px}
.publish-main{min-height:0;display:grid;grid-template-columns:230px 1fr}.publish-steps{padding:24px 16px;border-right:1px solid var(--qreports-grid,#46536b);background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#000)}
.publish-steps button{width:100%;display:grid;grid-template-columns:30px 1fr;gap:8px;align-items:center;text-align:left;margin:0 0 8px;padding:12px;border-color:transparent;background:transparent;color:inherit}.publish-steps button.active{background:color-mix(in srgb,var(--qreports-accent,#72c7a5) 18%,transparent);border-color:var(--qreports-accent,#72c7a5)}.publish-step-number{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:color-mix(in srgb,var(--qreports-grid,#46536b) 65%,transparent);font-weight:800}.publish-steps button.active .publish-step-number{background:var(--qreports-accent,#72c7a5);color:var(--qreports-on-accent,#10221b)}
.publish-content{min-width:0;overflow:auto;padding:26px 30px}.publish-panel{display:none}.publish-panel.active{display:block}.publish-panel h3{font-size:22px;margin:0 0 6px}.publish-lead{margin:0 0 22px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 70%,transparent)}
.publish-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}.publish-summary>div{padding:16px;border:1px solid var(--qreports-grid,#46536b);border-radius:12px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 88%,#fff)}.publish-summary strong{display:block;font-size:25px}.publish-summary small{color:color-mix(in srgb,var(--qreports-text,#eef2f7) 65%,transparent)}
.publish-checks{display:grid;gap:9px}.publish-check{display:grid;grid-template-columns:30px minmax(0,1fr) auto;gap:10px;align-items:center;padding:13px;border:1px solid var(--qreports-grid,#46536b);border-radius:11px}.publish-check b,.publish-check small{display:block}.publish-check small{margin-top:3px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 66%,transparent)}.publish-check>button{white-space:nowrap}.publish-check-icon{font-size:19px}.publish-check.pass .publish-check-icon{color:#72d6a0}.publish-check.warning .publish-check-icon{color:#efc66a}.publish-check.blocker .publish-check-icon{color:#ff8790}
.publish-fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.publish-fields label{font-size:13px;color:inherit}.publish-fields input,.publish-fields textarea{background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff);color:inherit;border-color:var(--qreports-grid,#46536b)}.publish-fields .wide{grid-column:1/-1}.publish-hint{padding:14px;border-left:4px solid var(--qreports-accent,#72c7a5);border-radius:7px;background:color-mix(in srgb,var(--qreports-accent,#72c7a5) 10%,transparent)}
.publication-reconciliation{margin:0 0 16px;border:1px solid var(--qreports-grid,#46536b);border-radius:13px;overflow:hidden;background:color-mix(in srgb,var(--qreports-surface,#171b22) 93%,#fff)}.reconciliation-head{display:grid;grid-template-columns:minmax(220px,1.6fr) repeat(3,minmax(86px,.5fr));gap:1px;background:var(--qreports-grid,#46536b)}.reconciliation-head>div{padding:12px 14px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 89%,#fff)}.reconciliation-head strong,.reconciliation-head small,.reconciliation-head b,.reconciliation-head span{display:block}.reconciliation-head strong{font-size:14px}.reconciliation-head small,.reconciliation-head span{margin-top:3px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 66%,transparent);font-size:10px}.reconciliation-head b{font-size:19px}.reconciliation-head[data-state=complete]>div:first-child{box-shadow:inset 4px 0 var(--qreports-positive,#72d6a0)}.reconciliation-head[data-state=partial]>div:first-child{box-shadow:inset 4px 0 #efc66a}.reconciliation-head[data-state=unrecorded]>div:first-child{box-shadow:inset 4px 0 var(--qreports-negative,#ff8790)}.reconciliation-sources{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:10px}.reconciliation-sources article{min-width:0;padding:10px 11px;border:1px solid color-mix(in srgb,var(--qreports-grid,#46536b) 75%,transparent);border-radius:9px}.reconciliation-sources article>div{display:flex;justify-content:space-between;gap:10px}.reconciliation-sources strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.reconciliation-sources span{font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.reconciliation-sources article[data-state=complete] span{color:var(--qreports-positive,#72d6a0)}.reconciliation-sources article[data-state=partial] span,.reconciliation-sources article[data-state=unrecorded] span{color:#efc66a}.reconciliation-sources article[data-state=no-snapshot] span{color:var(--qreports-negative,#ff8790)}.reconciliation-sources small,.reconciliation-sources time{display:block;margin-top:3px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 64%,transparent);font-size:9px}.reconciliation-range{margin:0;padding:0 12px 11px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 64%,transparent);font-size:10px}.reconciliation-empty{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 15px}.reconciliation-empty strong{font-size:13px}.reconciliation-empty span{color:color-mix(in srgb,var(--qreports-text,#eef2f7) 66%,transparent);font-size:11px;text-align:right}
.finance-reconciliation{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:12px 14px;border-bottom:1px solid var(--qreports-grid,#46536b)}.finance-reconciliation>div>span,.finance-reconciliation strong,.finance-reconciliation small{display:block}.finance-reconciliation>div>span{margin-bottom:2px;color:var(--qreports-accent,#72c7a5);font-size:9px;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.finance-reconciliation strong{font-size:14px}.finance-reconciliation small,.finance-reconciliation time{margin-top:3px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 66%,transparent);font-size:10px}.finance-reconciliation time{flex:none;margin:0;text-align:right}.finance-reconciliation[data-state=blocked] strong{color:var(--qreports-negative,#ff8790)}.finance-reconciliation[data-state=review] strong{color:#efc66a}.finance-reconciliation[data-state=passed] strong{color:var(--qreports-positive,#72d6a0)}.reconciliation-breaches{display:flex;flex-wrap:wrap;gap:6px;padding:9px 10px;border-top:1px solid var(--qreports-grid,#46536b)}.reconciliation-breaches span{padding:4px 7px;border-radius:999px;background:color-mix(in srgb,#efc66a 14%,transparent);font-size:10px}.reconciliation-source-menu{margin:0;padding:0;border-top:1px solid var(--qreports-grid,#46536b)}.reconciliation-source-menu>summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 12px;color:inherit;list-style-position:inside}.reconciliation-source-menu>summary small{color:color-mix(in srgb,var(--qreports-text,#eef2f7) 64%,transparent);font-weight:400}.reconciliation-source-menu:not([open])>summary{border-bottom:0}@media(max-width:760px){.finance-reconciliation{align-items:flex-start;flex-direction:column}.finance-reconciliation time{text-align:left}}
.reconciliation-policy{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:0 0 12px;padding:12px;border:1px solid var(--qreports-grid,#46536b);border-radius:12px}.reconciliation-policy legend{padding:0 6px;font-weight:800}.reconciliation-policy label{font-size:11px}.reconciliation-policy input,.reconciliation-policy select{margin-top:4px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff);color:inherit;border-color:var(--qreports-grid,#46536b)}.reconciliation-policy .reconciliation-require{grid-column:1/-1;display:flex;align-items:center;gap:8px}.reconciliation-policy .reconciliation-require input{width:auto;margin:0}.reconciliation-approval{margin:0 0 14px}.reconciliation-approval-state{display:grid;grid-template-columns:minmax(200px,1fr) minmax(190px,.7fr) auto;gap:12px;align-items:end;padding:12px;border:1px solid var(--qreports-grid,#46536b);border-radius:12px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 94%,#fff)}.reconciliation-approval-state>div strong,.reconciliation-approval-state>div small{display:block}.reconciliation-approval-state>div small{margin-top:3px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 66%,transparent);font-size:10px}.reconciliation-approval-state label{font-size:11px}.reconciliation-approval-state input{margin-top:4px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff);color:inherit;border-color:var(--qreports-grid,#46536b)}.reconciliation-approval-state[data-state=signed]{box-shadow:inset 4px 0 var(--qreports-positive,#72d6a0)}.reconciliation-approval-state[data-state=required],.reconciliation-approval-state[data-state=stale]{box-shadow:inset 4px 0 #efc66a}
.viewer-test-card,.publish-target{padding:18px;border:1px solid var(--qreports-grid,#46536b);border-radius:13px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff)}.viewer-test-card{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center}.viewer-test-card h4,.publish-target h4{margin:0 0 5px;font-size:17px}.viewer-test-card p,.publish-target p{margin:0;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 68%,transparent)}
.viewer-dependency-manifest{margin-top:14px;border:1px solid var(--qreports-grid,#46536b);border-radius:13px;overflow:hidden}.viewer-manifest-summary{display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding:13px 15px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 86%,#fff)}.viewer-manifest-summary strong{margin-right:auto}.viewer-manifest-summary span{font-size:11px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 68%,transparent)}.viewer-manifest-summary span b{color:var(--qreports-text,#eef2f7);font-size:14px}.viewer-manifest-list{max-height:300px;overflow:auto}.viewer-manifest-list article{display:grid;grid-template-columns:22px minmax(0,1fr) auto auto;gap:9px;align-items:center;padding:11px 14px;border-top:1px solid color-mix(in srgb,var(--qreports-grid,#46536b) 70%,transparent)}.viewer-manifest-list article>span{font-weight:900}.viewer-manifest-list article[data-state=embedded]>span{color:#72d6a0}.viewer-manifest-list article[data-state=sign-in]>span{color:#efc66a}.viewer-manifest-list article[data-state=unavailable]>span{color:#ff8790}.viewer-manifest-list details{min-width:0}.viewer-manifest-list summary{cursor:pointer;list-style-position:outside}.viewer-manifest-list summary::marker{color:color-mix(in srgb,var(--qreports-text,#eef2f7) 50%,transparent)}.viewer-manifest-list b,.viewer-manifest-list small{display:block}.viewer-manifest-list details p{margin:7px 0 4px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 72%,transparent);font-size:11px;line-height:1.4}.viewer-manifest-list small{margin-top:2px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 66%,transparent)}.viewer-manifest-list em{font-size:10px;font-style:normal;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.viewer-manifest-list>article>button{white-space:nowrap}
.publish-targets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.publish-target{display:flex;flex-direction:column;gap:14px}.publish-target button{margin-top:auto}.publish-target select{background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff);color:inherit;border-color:var(--qreports-grid,#46536b)}
.publication-export-layout{display:grid;grid-template-columns:minmax(220px,1fr) minmax(240px,1fr);align-items:center;gap:8px 16px;margin:0 0 14px;padding:14px 16px;border:1px solid var(--qreports-grid,#46536b);border-radius:12px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff);font-weight:700}.publication-export-layout select{background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff);color:inherit;border-color:var(--qreports-grid,#46536b)}.publication-export-layout small{grid-column:1/-1;font-weight:400;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 66%,transparent)}
.publish-footer{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-top:1px solid var(--qreports-grid,#46536b);background:var(--qreports-header-background,#11151b)}.publish-footer>div{display:flex;gap:9px}.publish-footer .primary,.publish-target .primary,.viewer-test-card .primary{background:var(--qreports-accent,#72c7a5);color:var(--qreports-on-accent,#10221b);border-color:var(--qreports-accent,#72c7a5)}
.publication-info{font-size:11px;opacity:.82}.publication-info b{font-weight:700}.viewer-publication{margin-top:4px;font-size:11px;opacity:.78}
.viewer-report-info{white-space:nowrap}.viewer-home-dialog{box-sizing:border-box;width:min(920px,calc(100vw - 32px));height:min(760px,calc(100vh - 32px));max-height:min(760px,calc(100vh - 32px));margin:auto;padding:0;overflow:hidden;border:1px solid var(--qreports-grid,#46536b);border-radius:18px;background:var(--qreports-surface,#171b22);color:var(--qreports-text,#eef2f7);box-shadow:0 30px 90px #0008}.viewer-home-dialog::backdrop{background:#071019b8;backdrop-filter:blur(4px)}.viewer-home-shell{display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;height:100%;max-height:inherit}.viewer-home-shell>header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:24px 26px 18px;border-bottom:1px solid var(--qreports-grid,#46536b);background:var(--qreports-header-background,#11151b);color:var(--qreports-header-text,#f5f7fa)}.viewer-home-shell header p{margin:0 0 5px;color:var(--qreports-accent,#72c7a5);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.viewer-home-shell header h2{margin:0 0 4px;font-size:26px}.viewer-home-shell header span{color:color-mix(in srgb,currentColor 70%,transparent);font-size:12px}.viewer-home-shell header button{width:40px;height:40px;padding:0;font-size:23px}.viewer-home-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:20px 26px 0}.viewer-home-summary article{min-width:0;padding:15px;border:1px solid var(--qreports-grid,#46536b);border-radius:12px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 90%,#fff)}.viewer-home-summary span,.viewer-home-summary strong,.viewer-home-summary small{display:block}.viewer-home-summary span{margin-bottom:6px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 65%,transparent);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.07em}.viewer-home-summary strong{overflow:hidden;font-size:15px;text-overflow:ellipsis;white-space:nowrap}.viewer-home-summary strong[data-state=passed]{color:var(--qreports-positive,#72d6a0)}.viewer-home-summary strong[data-state=warnings]{color:#efc66a}.viewer-home-summary strong[data-state=blocked]{color:var(--qreports-negative,#ff8790)}.viewer-home-summary small{margin-top:4px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 62%,transparent);font-size:10px}.viewer-home-body{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(250px,.65fr);align-items:start;gap:18px;min-height:0;padding:20px 26px;overflow:auto}.viewer-home-body>div,.viewer-home-body>aside{padding:17px;border:1px solid var(--qreports-grid,#46536b);border-radius:12px;background:color-mix(in srgb,var(--qreports-surface,#171b22) 94%,#fff)}.viewer-home-body h3{margin:0 0 7px;font-size:14px}.viewer-home-body h3:not(:first-child){margin-top:18px}.viewer-home-body p{margin:0;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 72%,transparent);font-size:12px;line-height:1.5}.viewer-home-body dl{display:grid;gap:7px;margin:0}.viewer-home-body dl>div{display:flex;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px solid color-mix(in srgb,var(--qreports-grid,#46536b) 70%,transparent)}.viewer-home-body dl>div:last-child{border-bottom:0}.viewer-home-body dt{color:color-mix(in srgb,var(--qreports-text,#eef2f7) 68%,transparent);font-size:11px}.viewer-home-body dd{margin:0;font-weight:800}.viewer-home-shell>footer{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 26px;border-top:1px solid var(--qreports-grid,#46536b);background:var(--qreports-header-background,#11151b);color:color-mix(in srgb,var(--qreports-header-text,#f5f7fa) 70%,transparent);font-size:11px}.viewer-home-shell>footer .primary{background:var(--qreports-accent,#72c7a5);color:var(--qreports-on-accent,#10221b);border-color:var(--qreports-accent,#72c7a5)}
@media(max-width:760px){.publish-main{grid-template-columns:1fr}.publish-steps{display:flex;overflow:auto;border-right:0;border-bottom:1px solid var(--qreports-grid,#46536b);padding:10px}.publish-steps button{min-width:150px;margin:0 6px 0 0}.publish-fields,.publish-targets,.publication-export-layout,.reconciliation-sources,.reconciliation-policy,.reconciliation-approval-state{grid-template-columns:1fr}.publish-fields .wide{grid-column:auto}.publish-summary{grid-template-columns:1fr 1fr 1fr}.reconciliation-head{grid-template-columns:1fr 1fr}.reconciliation-head>div:first-child{grid-column:1/-1}.reconciliation-empty{align-items:flex-start;flex-direction:column}.reconciliation-empty span{text-align:left}}
@media(max-width:760px){.publish-check{grid-template-columns:30px minmax(0,1fr)}.publish-check>button{grid-column:2;justify-self:start}}
.viewer-home-shell>footer>div,.viewer-home-file-actions{display:flex;flex-wrap:wrap;gap:9px}.viewer-home-file-actions:empty{display:none}
.publication-protection{margin:0;padding:12px;border:1px solid var(--qreports-grid,#46536b);border-radius:10px}.publication-protection label{display:flex;align-items:center;gap:8px;font-weight:700}.publication-protection label input{width:auto;margin:0}.publication-protection>textarea{display:block;width:100%;min-height:96px;margin-top:9px;resize:vertical}.publication-protection small{display:block;margin-top:7px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 66%,transparent)}
.viewer-home-actions{display:flex;flex-wrap:wrap;gap:8px;margin:9px 0 0}.viewer-source-guidance{display:grid;gap:8px;margin:0;padding:0;list-style:none}.viewer-source-guidance li{padding:9px 10px;border:1px solid color-mix(in srgb,var(--qreports-grid,#46536b) 70%,transparent);border-radius:8px}.viewer-source-guidance b,.viewer-source-guidance span{display:block}.viewer-source-guidance span{margin-top:3px;color:color-mix(in srgb,var(--qreports-text,#eef2f7) 68%,transparent);font-size:11px}
@media(max-width:760px){.viewer-home-summary,.viewer-home-body{grid-template-columns:1fr}.viewer-home-shell>footer{align-items:flex-start;flex-direction:column}}
