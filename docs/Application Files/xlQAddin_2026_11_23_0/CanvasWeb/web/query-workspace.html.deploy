<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Query Workspace</title><link rel="stylesheet" href="query-workspace.css?v=20261115-context-menus-1"><link rel="stylesheet" href="parameter-editor.css?v=20261005-resizable-manager"><link rel="stylesheet" href="query-workspace-theme.css?v=20261115-context-menus-1"><link rel="stylesheet" href="parameter-editor-theme.css?v=20260921-2"><link rel="stylesheet" href="theme-scrollbars.css?v=20261005-1"><script src="shared-settings.js?v=20261013-page-navigation-tabs-2"></script><script src="workspace-completion.js?v=20261114-1"></script></head><body data-hide-shared-settings>
<header><div class="brand"><span data-experience-icon="query">Q</span><div><strong data-experience-label="queryWorkspace">Query Workspace</strong><small id="queryWorkspaceBreadcrumb" class="workspace-breadcrumb" aria-label="Current editing context"><span>Standalone query</span><i aria-hidden="true">›</i><b>Query Workspace</b><em>Returns to Excel</em></small></div></div><div class="toolbar"><span id="queryApplyStatus" class="workspace-apply-status" aria-live="polite">No unapplied changes</span><button class="run" data-action="run">▶ Run</button><div class="toolbar-dropdown"><button data-action="toggleOpenMenu" aria-expanded="false">Open ▾</button><div id="openMenu" class="toolbar-dropdown-menu document-menu hidden"><button data-action="openSqlFile">SQL file…</button><button data-action="openWorkspace">Query workspace…</button><div class="menu-separator"></div><div class="menu-heading">Recent</div><div id="recentQueryFiles" class="recent-query-files"><span class="menu-empty">No recent files</span></div></div></div><button id="quickSaveSql" data-action="quickSaveSql" disabled title="Save the current SQL file or query workspace. Save never applies or refreshes data.">Save</button><div class="toolbar-dropdown"><button data-action="toggleSaveMenu" aria-expanded="false" title="Save another reusable copy. This does not apply or refresh data.">Save as ▾</button><div id="saveMenu" class="toolbar-dropdown-menu document-menu hidden"><button data-action="saveSqlFile">SQL file…</button><button data-action="saveWorkspace">Query workspace…</button><div class="menu-separator"></div><button data-action="saveSourceView">As source view</button><button data-action="saveCombinedSource">As combined source</button></div></div><input id="previewLimit" type="hidden" value="1000"><button class="apply" data-action="apply" title="Apply the Main query to the calling workspace. Data is not refreshed.">Apply</button><button data-action="cancel" title="Discard unapplied changes and return to the calling workspace.">Cancel</button></div></header>
<main class="inspector-hidden"><aside class="sources"><div class="pane-head"><h2>Data sources</h2><div><button data-action="toggleSources" title="Hide data sources">‹</button><button data-action="refreshSchema" title="Refresh source schema">↻</button></div></div><div class="source-toggles"><label class="api-toggle"><input id="showStoredProcedures" type="checkbox"> Include stored procedures</label></div><label>Browse source<select id="connection"></select></label><input id="schemaSearch" placeholder="Search tables, procedures and fields"><div id="schema" class="schema"></div></aside><div class="splitter left-splitter" title="Resize or show data sources"></div>
<section class="work"><div class="query-tabbar"><div id="queryTabs" class="query-tabs" role="tablist" aria-label="Query tabs"></div><span id="workspaceFileLabel" class="workspace-file-label" title="Save the workspace to name it">Unsaved workspace</span><div class="query-tab-actions"><button type="button" data-workspace-action="new" title="New query tab">＋</button><button type="button" id="setMainTab" data-workspace-action="main" title="Use the active query as the output returned to Qanvas or Excel">Use as output</button></div></div><div class="query-head"><div class="query-head-primary"><span>QUERY</span><div class="query-mode-switch" role="group" aria-label="Query editing mode"><button type="button" data-action="queryDesigner" data-query-mode="designer" aria-pressed="false">Designer</button><button type="button" data-action="querySql" data-query-mode="sql" aria-pressed="true">Manual SQL</button></div><button type="button" class="format-sql-button" data-action="format" title="Align SQL clauses and line breaks">Format SQL</button></div><label class="single-query-connection">Run on <select id="queryRunConnection" aria-label="Query execution connection"></select></label><span id="queryStatus">Ready</span></div><div class="editor-shell"><pre id="queryHighlight" aria-hidden="true"></pre><textarea id="queryText" spellcheck="false" autocomplete="off" placeholder="SELECT * FROM table_name"></textarea></div><div id="autocomplete" class="autocomplete hidden"></div>
<div id="joinPanel" class="join-panel hidden"><div class="join-head"><div><b>Visual join designer</b><small>Drag and resize tables here from Data sources. Use the ⋯ button on a column for aliases, filters, totals and ordering; right-click remains available. Right-click join lines to edit them. SQL stays synchronized automatically.</small></div><div class="join-head-actions"><button data-action="previewJoin">Preview</button><button data-action="toggleJoinCount" aria-pressed="false" title="Add or remove COUNT(*) AS antall and group the selected values">Count rows</button><button data-action="clearJoinDesigner" title="Remove all tables and start over">Clear designer</button></div></div><div id="joinCanvas" class="join-canvas" data-table-drop-target="designer"></div><div id="joinResize" class="join-resize" title="Resize join designer"></div></div>
<div class="result-head" title="Drag to resize the query and result panes"><div class="result-tabs"><button class="active" data-result-view="grid">Grid</button><button data-result-view="json">JSON</button><button data-result-view="sql">Parsed</button><button data-result-view="messages">Messages</button></div><div id="editActions" class="edit-actions hidden"><button data-action="addRow">＋ Row</button><button data-action="saveEdits" class="save-edit" disabled>Save changes</button><button data-action="revertEdits" disabled>Revert</button><button data-action="exitEdit">Exit edit</button></div><div class="result-head-actions"><button data-action="editQuery" title="Edit rows returned from a direct single-table query and save them in one transaction">Edit table data</button><button id="resultTypes" data-action="resultTypes" disabled title="Inspect detected types or override how columns are stored">Types</button><span id="resultSummary">No query executed</span></div></div><div class="result-wrap"><table id="result"><colgroup></colgroup><thead></thead><tbody></tbody></table><pre id="resultText" class="result-text hidden"></pre><div id="emptyResult" class="empty">Run the query to preview data.</div></div></section><div class="splitter right-splitter"></div>
<aside class="inspector"><div class="pane-head"><h2>Tools</h2><button data-action="toggleInspector" title="Hide tools">›</button></div><div class="side-tools"><button data-side="parameters" data-experience-label="parameters">Parameters</button><button data-side="functions">Functions</button><button data-side="validation">Validation</button><button data-side="lineage">SQL lineage</button><button data-side="queryStats">Query statistics</button><button id="tableStats" data-side="tableStats" disabled>Table statistics</button></div><section id="toolPanel" class="tool-panel hidden"></section></aside></main>
<div id="joinModal" class="modal join-modal hidden"><div class="dialog join-dialog"><h2 title="Drag to move the window">Create join <small>Drag to move</small></h2><div class="two"><label>Left table<select id="joinLeftTable"></select></label><label>Right table<select id="joinRightTable"></select></label></div><label>Join type<select id="joinType"><option value="INNER JOIN">Inner join</option><option value="LEFT JOIN">Left join</option><option value="RIGHT JOIN">Right join</option><option value="FULL OUTER JOIN">Full outer join</option></select></label><div id="joinClauses"></div><button data-action="addClause">＋ Add condition</button><div class="dialog-actions"><button class="apply" data-action="saveJoin">Save join</button><button data-action="closeJoin">Cancel</button></div></div></div>
<div id="filterModal" class="modal hidden"><div class="dialog filter-dialog"><div class="filter-head"><div><h2 id="filterTitle">Choose filter values</h2><p class="muted">Select distinct values or enter one advanced expression.</p></div><button data-action="closeFilter">×</button></div><input id="filterSearch" placeholder="Search values"><label class="filter-select-all"><input id="filterSelectAll" type="checkbox"> Select all visible values</label><div id="filterValues" class="filter-values"></div><details id="advancedFilterDetails"><summary>Advanced filter</summary><label class="advanced-filter-editor"><span>Expression</span><input id="filterAdvanced" spellcheck="false" placeholder="Example: between 2019 and 2023"></label><small class="muted">Entering an expression replaces the checked value selection.</small><pre>= value       equality&#10;&lt;&gt; value      not equal&#10;&gt;, &gt;=, &lt;, &lt;=  comparisons&#10;in (A,B,C)    list&#10;1|2|3         list shorthand&#10;between a and b&#10;1-10          numeric range&#10;like ABC%     wildcard match&#10;123*          wildcard shorthand&#10;null / not null</pre></details><div class="dialog-actions"><button data-action="applyFilter" class="apply">Apply filter</button><button data-action="clearFilter">Clear</button><button data-action="closeFilter">Cancel</button></div></div></div>
<div id="contextMenu" class="context-menu hidden"></div><div id="toast" class="toast hidden"></div><script src="parameter-editor.js?v=20261118-none-selection-1"></script><script src="export-filters.js?v=20261016-filter-visuals-2"></script><script src="designer-ai-workbench.js?v=20261103-2"></script><script src="query-workspace.js?v=20261115-context-menus-1"></script><script src="local-table-tools.js?v=20260922-dialogs-1"></script><script src="query-tabs.js?v=20261115-source-catalog-1"></script></body></html>
