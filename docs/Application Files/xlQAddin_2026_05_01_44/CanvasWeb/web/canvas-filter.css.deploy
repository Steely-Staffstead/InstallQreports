.canvas-filter-row { grid-template-columns: 32px 1fr 1fr; gap: 7px; padding: 8px 0; border-bottom: 1px solid #e1e6ef; }
.canvas-filter-row > input, .canvas-filter-row > button:not(.remove-filter), .canvas-filter-row > select:nth-of-type(n+3) { grid-column: 2 / -1; }
.filter-values-dialog { width: min(520px, 86vw); max-height: 78vh; border: 0; border-radius: 15px; padding: 20px; box-shadow: 0 20px 70px #17213c55; color: #17213c; }
.filter-values-dialog::backdrop { background: #17213c77; }
.filter-values-dialog h2 { margin: 0 0 14px; }
.filter-values-dialog [data-value-search] { width: 100%; padding: 9px; border: 1px solid #cbd5e5; border-radius: 8px; }
.filter-value-list { max-height: 350px; overflow: auto; margin: 10px 0; border: 1px solid #dbe2ed; border-radius: 8px; padding: 7px; }
.filter-value-list label { display: block; padding: 4px 6px; }
.filter-value-list [hidden] { display: none !important; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; }
.canvas-filter-buttons,.canvas-toggle-row { grid-column: 1 / -1; display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
.canvas-filter-buttons button { width:auto; min-width:38px; padding:7px 10px; }
.canvas-filter-buttons button.active { background:var(--theme-accent,#4f6ee8); color:var(--theme-accent-text,#fff); border-color:var(--theme-accent,#4f6ee8); }
.canvas-search-multiple { grid-column:1 / -1; display:grid; gap:6px; }
.canvas-search-multiple>input { width:100%; margin:0; padding:8px; border:1px solid var(--theme-control-border,#cbd5e1); border-radius:7px; background:var(--theme-control-bg,#fff); color:inherit; }
.canvas-filter-checklist { display:grid; gap:3px; max-height:180px; overflow:auto; padding:5px; border:1px solid var(--theme-control-border,#cbd5e1); border-radius:7px; background:var(--theme-control-bg,#fff); }
.canvas-filter-checklist label { display:flex; align-items:center; gap:7px; margin:0; padding:4px; }
.canvas-filter-pair { grid-column:1 / -1; display:grid; grid-template-columns:1fr 1fr; gap:7px; }
.canvas-filter-pair label { min-width:0; }
.canvas-filter-row .date-range-display { grid-column:1 / -1; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
.canvas-filter-row .date-picker-selected,.canvas-filter-row .date-picker-value { grid-column:1 / -1; width:max-content; max-width:100%; background:var(--theme-control-bg,var(--qreports-surface,#fff)); color:var(--theme-text,var(--qreports-text,#34425e)); border-color:var(--theme-control-border,var(--qreports-grid,#cbd5e1)); }
.canvas-toggle { width:46px; height:26px; padding:3px; border-radius:999px; background:var(--theme-control-bg,#e5e7eb); }
.canvas-toggle span { display:block; width:18px; height:18px; border-radius:50%; background:var(--theme-surface,#fff); transition:transform .16s ease; }
.canvas-toggle.active { background:var(--theme-accent,#4f6ee8); }
.canvas-toggle.active span { transform:translateX(18px); }
.canvas-toggle-row button:last-child { width:auto; margin-left:auto; }
.canvas-range { grid-column:1 / -1; display:grid; gap:7px; }
.canvas-range>input[type=range] { width:100%; height:28px; margin:0; padding:0!important; border:0!important; appearance:none; background:linear-gradient(to right,var(--theme-accent,#4f6ee8) 0 var(--range-end,100%),var(--theme-control-border,#cbd5e1) var(--range-end,100%) 100%) center/100% 6px no-repeat!important; color:var(--theme-text,var(--qreports-text,#34425e)); }
.canvas-range>input[type=range]::-webkit-slider-runnable-track { height:6px; background:transparent; }
.canvas-range>input[type=range]::-webkit-slider-thumb { appearance:none; width:20px; height:20px; margin-top:-7px; border:0; border-radius:50%; background:var(--theme-accent,#4f6ee8); }
.canvas-range>input[type=range]::-moz-range-track { height:6px; background:transparent; }
.canvas-range>input[type=range]::-moz-range-thumb { width:20px; height:20px; border:0; border-radius:50%; background:var(--theme-accent,#4f6ee8); }
.canvas-range output { justify-self:center; padding:2px 7px; border-radius:6px; background:var(--theme-control-bg,#eef2f7); }
.dual-range { position:relative; min-height:28px; background:linear-gradient(to right,var(--theme-control-border,#cbd5e1) 0 var(--range-start,0%),var(--theme-accent,#4f6ee8) var(--range-start,0%) var(--range-end,100%),var(--theme-control-border,#cbd5e1) var(--range-end,100%) 100%) center/100% 6px no-repeat; border-radius:999px; }
.dual-range input[type=range] { position:absolute; inset:0; width:100%; height:28px; margin:0; padding:0!important; border:0!important; background:transparent!important; color:var(--theme-text,var(--qreports-text,#34425e)); pointer-events:none; appearance:none; }
.dual-range .range-low { z-index:2; }
.dual-range .range-high { z-index:3; }
.dual-range input[type=range]::-webkit-slider-runnable-track { height:6px; background:transparent; }
.dual-range input[type=range]::-webkit-slider-thumb { appearance:none; width:20px; height:20px; margin-top:-7px; border:0; border-radius:50%; background:var(--theme-accent,#4f6ee8); }
.dual-range input[type=range]::-moz-range-track { height:6px; background:transparent; }
.dual-range input[type=range]::-moz-range-progress { background:transparent; }
.dual-range input[type=range]::-moz-range-thumb { width:20px; height:20px; border:0; border-radius:50%; background:var(--theme-accent,#4f6ee8); }
body.presentation-mode { display:flex; flex-direction:column; background:var(--presentation-surface,var(--qreports-surface,#fff)); color:var(--presentation-text,var(--qreports-text,#182230)); }
body.presentation-mode>.app-header,body.presentation-mode>.commandbar,body.presentation-mode .left-panel,body.presentation-mode .right-panel,body.presentation-mode .pane-splitter,body.presentation-mode .statusbar { display:none!important; }
body.presentation-mode>main { display:block!important; flex:1; min-height:0; height:auto; }
body.presentation-mode .workspace,body.presentation-mode .canvas-viewport { display:block; height:100%; }
body.presentation-mode .tile { outline:none!important; }
body.presentation-mode .resize-handle,body.presentation-mode .connection-port,body.presentation-mode .tile-kind { display:none!important; }
#presentationHeader { display:grid; grid-template-columns:auto 1fr auto; gap:12px; align-items:center; padding:10px 14px; background:var(--presentation-header,var(--qreports-surface,#fff)); color:var(--presentation-header-text,var(--qreports-text,#34425e)); border-bottom:1px solid var(--presentation-grid,var(--qreports-border,#ccd5e0)); max-height:45vh; overflow:auto; z-index:50; }
.presentation-title strong,.presentation-title small { display:block; }
.presentation-title small { opacity:.7; font-size:11px; }
#presentationHeader nav,.presentation-actions { display:flex; flex-wrap:wrap; gap:6px; }
#presentationHeader nav button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); border-color:var(--viewer-selected-bg,#4f6ee8); }
body.presentation-tab-navigation #presentationHeader nav { align-self:end; gap:0; }
body.presentation-mode.presentation-tab-navigation:not(.presentation-left-tabs)>#presentationHeader { padding-bottom:0; }
body.presentation-mode.presentation-tab-navigation:not(.presentation-left-tabs)>#presentationHeader nav { align-self:stretch; margin-bottom:-1px; }
body.presentation-tab-navigation #presentationHeader nav button { border-radius:8px 8px 0 0; border-color:var(--presentation-grid,#ccd5e0); border-bottom-color:var(--presentation-grid,#ccd5e0); background:transparent; color:var(--viewer-unselected-color,var(--presentation-header-text,#34425e)); }
body.presentation-tab-navigation #presentationHeader nav button.active { border-bottom-color:var(--presentation-surface,var(--qreports-surface,#fff)); box-shadow:inset 0 -3px var(--viewer-selected-bg,#4f6ee8); }
#presentationPageNav { display:none; }
body.presentation-mode.presentation-left-tabs { display:grid; grid-template-columns:minmax(150px,220px) minmax(0,1fr); grid-template-rows:auto minmax(0,1fr); }
body.presentation-left-tabs>#presentationHeader { grid-column:1 / -1; grid-row:1; }
body.presentation-left-tabs>#presentationPageNav { display:flex; grid-column:1; grid-row:2; min-width:200px; width:auto; flex-direction:column; align-items:stretch; gap:4px; padding:14px 10px; overflow:auto; background:var(--presentation-header,var(--qreports-surface,#fff)); border-right:1px solid var(--presentation-grid,#ccd5e0); }
body.presentation-left-tabs>#presentationPageNav button { width:100%; min-height:38px; text-align:left; white-space:normal; overflow-wrap:anywhere; border:0; border-radius:6px; background:transparent; color:var(--viewer-unselected-color,var(--presentation-header-text,#34425e)); }
body.presentation-left-tabs>#presentationPageNav button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); }
body.presentation-left-tabs>main { grid-column:2; grid-row:2; }
#presentationHeader .presentation-filters { grid-column:1 / -1; margin:0; }
#presentationHeader fieldset { display:flex; flex-wrap:wrap; gap:12px; margin:8px 0; }
#presentationHeader .export-filter,#presentationFiltersPane .export-filter { display:block; min-width:180px; }
#presentationHeader .filter-buttons,#presentationFiltersPane .filter-buttons { display:flex; flex-wrap:wrap; gap:5px; }
#presentationHeader .filter-buttons button.active,#presentationFiltersPane .filter-buttons button.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); }
#presentationHeader .search-multiple>input,#presentationFiltersPane .search-multiple>input { width:100%; padding:8px; border:1px solid var(--qreports-border,#cbd5e1); border-radius:7px; background:var(--qreports-input-bg,#fff); color:inherit; }
#presentationHeader .toggle-filter-row,#presentationFiltersPane .toggle-filter-row { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
#presentationHeader .export-toggle,#presentationFiltersPane .export-toggle { width:48px; height:28px; padding:3px; border-radius:999px; background:var(--viewer-unselected-bg,#fff); color:var(--viewer-unselected-color,#34425e); }
#presentationHeader .export-toggle span,#presentationFiltersPane .export-toggle span { display:block; width:20px; height:20px; border-radius:50%; background:currentColor; transition:transform .15s; }
#presentationHeader .export-toggle.active,#presentationFiltersPane .export-toggle.active { background:var(--viewer-selected-bg,#4f6ee8); color:var(--viewer-selected-color,#fff); }
#presentationHeader .export-toggle.active span,#presentationFiltersPane .export-toggle.active span { transform:translateX(18px); }
body.presentation-mode.presentation-vertical-filters { display:grid; grid-template-columns:0 minmax(0,1fr); grid-template-rows:auto minmax(0,1fr); }
body.presentation-mode.presentation-vertical-filters>#presentationHeader { grid-column:1 / -1; grid-row:1; }
body.presentation-mode.presentation-vertical-filters>main { grid-column:2; grid-row:2; }
body.presentation-mode.presentation-vertical-filters.presentation-filters-open { grid-template-columns:minmax(220px,300px) minmax(0,1fr); }
#presentationFiltersPane { display:none; }
body.presentation-filters-open>#presentationFiltersPane { display:block; grid-column:1; grid-row:2; overflow:auto; padding:12px; background:var(--presentation-surface,var(--qreports-surface,#fff)); color:var(--presentation-text,var(--qreports-text,#182230)); border-right:1px solid var(--presentation-grid,var(--qreports-border,#ccd5e0)); color-scheme:var(--qreports-color-scheme,light); }
#presentationFiltersPane .presentation-filters { color:inherit; }
#presentationFiltersPane .presentation-filters>summary { color:inherit; border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane fieldset { margin:8px 0; min-width:0; color:inherit; border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane legend { color:inherit; }
#presentationFiltersPane .export-filter { max-width:100%; color:var(--presentation-text,var(--qreports-text,#182230)); border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane :is(input:not([type="range"]):not([type="checkbox"]),select) { background:var(--viewer-unselected-bg,var(--presentation-surface,#fff)); color:var(--viewer-unselected-color,var(--presentation-text,#182230)); border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
#presentationFiltersPane button { border-color:var(--presentation-grid,var(--qreports-grid,#ccd5e0)); }
body.presentation-mode.presentation-vertical-filters.presentation-right-filters { grid-template-columns:minmax(0,1fr) 0; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters { grid-template-columns:minmax(200px,260px) 0 minmax(0,1fr); }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters>#presentationPageNav { grid-column:1; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters>main { grid-column:3; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters.presentation-filters-open { grid-template-columns:minmax(200px,260px) minmax(220px,300px) minmax(0,1fr); }
body.presentation-mode.presentation-left-tabs.presentation-filters-open>#presentationFiltersPane { grid-column:2; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters.presentation-right-filters { grid-template-columns:minmax(200px,260px) minmax(0,1fr) 0; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters.presentation-right-filters>main { grid-column:2; }
body.presentation-mode.presentation-left-tabs.presentation-vertical-filters.presentation-right-filters.presentation-filters-open { grid-template-columns:minmax(200px,260px) minmax(0,1fr) minmax(220px,300px); }
body.presentation-mode.presentation-left-tabs.presentation-right-filters.presentation-filters-open>#presentationFiltersPane { grid-column:3; }
body.presentation-mode.presentation-right-filters>main { grid-column:1; }
body.presentation-mode.presentation-right-filters.presentation-filters-open { grid-template-columns:minmax(0,1fr) minmax(220px,300px); }
body.presentation-right-filters.presentation-filters-open>#presentationFiltersPane { grid-column:2; border-right:0; border-left:1px solid var(--presentation-grid,var(--qreports-border,#ccd5e0)); }
@media(max-width:800px){#presentationHeader{grid-template-columns:1fr}.presentation-actions{grid-row:2}#presentationHeader nav{grid-row:3}}
.dual-range input[type=range]::-webkit-slider-thumb { pointer-events:auto; }
.dual-range input[type=range]::-moz-range-thumb { pointer-events:auto; }
