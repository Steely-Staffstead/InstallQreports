(() => {
  const host=window.chrome?.webview;
  const defaults={zoom:1,records:1000,queryShowTabs:false,miniSqlMaxSourceRows:0,miniSqlMaxIntermediateRows:0,miniSqlMaxResultRows:0,miniSqlTimeoutSeconds:0,defaultChartTheme:'Default',defaultChartColors:[],colorPreset:'Custom',defaultSavePath:'',themeRoles:{},defaultCanvasSizeMode:'fit',defaultCanvasPreset:'1280x720',defaultCanvasWidth:1280,defaultCanvasHeight:720};
  const roleDefaults={text:'#182230',accent:'#4f6ee8',surface:'#ffffff',headerBackground:'#eef3f9',headerText:'#344054',grid:'#dce3ec',positive:'#16844a',negative:'#c43d4b'};
  const colorPresets={
    Light:{roles:roleDefaults,chartTheme:'Default'},
    Dark:{roles:{text:'#e8edf7',accent:'#8ca7ff',surface:'#182234',headerBackground:'#101827',headerText:'#f3f6fd',grid:'#3b4b62',positive:'#5bdd9a',negative:'#ff7d89'},chartTheme:'Bright'},
    Midnight:{roles:{text:'#e9f2ff',accent:'#69b8ff',surface:'#142a3b',headerBackground:'#0c1a29',headerText:'#f5f9ff',grid:'#365367',positive:'#63d9b0',negative:'#ff8b91'},chartTheme:'NightOcean'},
    Graphite:{roles:{text:'#eceff3',accent:'#e0ae69',surface:'#292b30',headerBackground:'#1d1f23',headerText:'#f6f7fa',grid:'#50545d',positive:'#89d48d',negative:'#f18e83'},chartTheme:'NightAmber'},
    VioletNight:{roles:{text:'#dce3f2',accent:'#9cdecc',surface:'#172033',headerBackground:'#111827',headerText:'#e9edf7',grid:'#35435c',positive:'#79dcb3',negative:'#f08da3'},chartTheme:'NightViolet'},
    Windows:{roles:{text:'#202b3c',accent:'#0067c0',surface:'#f8fbff',headerBackground:'#e8f1fb',headerText:'#193453',grid:'#cbdceb',positive:'#107c41',negative:'#c42b1c'},chartTheme:'Excel'},
    Ocean:{roles:{text:'#143441',accent:'#007f86',surface:'#f1fbfc',headerBackground:'#d9f1f2',headerText:'#0c5056',grid:'#b9dfe1',positive:'#12805c',negative:'#bd4b55'},chartTheme:'SeaGreen'},
    Forest:{roles:{text:'#273629',accent:'#46744c',surface:'#f7faf5',headerBackground:'#e5eee3',headerText:'#2b4d31',grid:'#cbdac7',positive:'#237344',negative:'#ae4d42'},chartTheme:'EarthTones'},
    Plum:{roles:{text:'#352944',accent:'#7b4baa',surface:'#fbf8ff',headerBackground:'#eee5f7',headerText:'#4d3466',grid:'#dccce9',positive:'#328169',negative:'#bd4969'},chartTheme:'Berry'},
    Sandstone:{roles:{text:'#423226',accent:'#a45b31',surface:'#fffaf4',headerBackground:'#f5e7d7',headerText:'#54331e',grid:'#e7d4bf',positive:'#427547',negative:'#a53d3d'},chartTheme:'EarthTones'},
    Alpine:{roles:{text:'#18332f',accent:'#087f70',surface:'#f3fbf8',headerBackground:'#ddf0e9',headerText:'#174a3d',grid:'#bedbd0',positive:'#13805c',negative:'#b54850'},chartTheme:'SeaGreen'},
    Slate:{roles:{text:'#202d3e',accent:'#456da5',surface:'#f7f9fc',headerBackground:'#e4eaf2',headerText:'#263d59',grid:'#cbd5e2',positive:'#28734f',negative:'#b84d50'},chartTheme:'Muted'},
    Coral:{roles:{text:'#432b31',accent:'#b85465',surface:'#fff9f8',headerBackground:'#fae8e8',headerText:'#663139',grid:'#ebcccf',positive:'#35795c',negative:'#b63d50'},chartTheme:'Pastel'},
    Indigo:{roles:{text:'#292d4d',accent:'#575ab5',surface:'#f8f8ff',headerBackground:'#e8e9f8',headerText:'#34366e',grid:'#d1d3eb',positive:'#2e8069',negative:'#b94b6d'},chartTheme:'Bright'},
    Citrus:{roles:{text:'#333727',accent:'#728d27',surface:'#fcfdf5',headerBackground:'#edf3d5',headerText:'#3b5022',grid:'#d8e3b7',positive:'#397b42',negative:'#ae4a3b'},chartTheme:'EarthTones'}
  };
  const paletteDefaults={Default:["#4f6ee8","#16a085","#e67e22","#8e5bd9","#d64562","#2e86c1","#7d8f29","#a66a3f"],Bright:["#3366cc","#dc3912","#ff9900","#109618","#990099","#0099c6","#dd4477","#66aa00"],Pastel:["#8db3e2","#f4b183","#a9d18e","#d5a6bd","#ffe699","#9dc3e6","#c9c9c9","#b4a7d6"],Muted:["#607d8b","#78909c","#8d6e63","#7e57c2","#5c6bc0","#26a69a","#9e9d24","#ef6c00"],Excel:["#4472c4","#ed7d31","#a5a5a5","#ffc000","#5b9bd5","#70ad47","#264478","#9e480e"],EarthTones:["#6b705c","#a5a58d","#b7b7a4","#cb997e","#ddbea9","#7f5539","#9c6644","#386641"],Berry:["#5b2a86","#8b3a9c","#b94e8f","#d8647a","#e9856f","#9c2c77","#692c70","#3d285d"],SeaGreen:["#006d77","#0a9396","#2a9d8f","#52b788","#74c69d","#95d5b2","#40916c","#1b4332"],Fire:["#7f0000","#b30000","#d7301f","#ef6548","#fc8d59","#fdbb84","#fdd49e","#ffeda0"],Grayscale:["#20242a","#414850","#626b75","#838e99","#a5afb9","#c4cbd2","#dce1e5","#eff1f3"],NightOcean:["#69b8ff","#60ddc8","#f7c978","#b69cff","#f18e9b","#83c7d8","#b6db78","#edaa7a"],NightAmber:["#e0ae69","#84c9b1","#a8b8e9","#df91a6","#bdd47d","#92c7dd","#c7a1db","#e6ba9b"],NightViolet:["#9cdecc","#b4a6ed","#82add8","#d8bb8c","#e49eaf","#9cc5b0","#b5bdda","#d4a8c7"]};
  let settings={...defaults};
  if(!host)try{settings={...defaults,...JSON.parse(localStorage.getItem('qreports-shared-settings')||'{}')};}catch{}
  globalThis.QReportsSettings={get:()=>settings,open,presets:colorPresets,presetLabels:{Light:'Light mode',Dark:'Dark mode',Midnight:'Midnight ocean',Graphite:'Warm graphite',VioletNight:'Violet night',Windows:'Windows mode',Ocean:'Ocean mist',Forest:'Forest',Plum:'Plum twilight',Sandstone:'Warm sandstone',Alpine:'Alpine green',Slate:'Soft slate',Coral:'Coral blush',Indigo:'Indigo dusk',Citrus:'Citrus leaf'}};
  function apply(value){settings={...defaults,...value};const roles={...roleDefaults,...settings.themeRoles};for(const [name,cssName] of Object.entries({accent:'accent',surface:'surface',text:'text',headerBackground:'header',headerText:'header-text',grid:'grid',positive:'positive',negative:'negative'}))document.documentElement.style.setProperty(`--qreports-${cssName}`,roles[name]);const luminance=hex=>{const channels=[1,3,5].map(index=>parseInt(hex.slice(index,index+2),16)/255).map(channel=>channel<=.04045?channel/12.92:((channel+.055)/1.055)**2.4);return .2126*channels[0]+.7152*channels[1]+.0722*channels[2];};for(const name of ['accent','positive','negative'])document.documentElement.style.setProperty(`--qreports-on-${name}`,luminance(roles[name])>.18?'#17213a':'#ffffff');const darkSurface=luminance(roles.surface)<.215,hasTheme=Object.keys(settings.themeRoles||{}).length>0;document.documentElement.style.setProperty('--qreports-color-scheme',darkSurface?'dark':'light');document.documentElement.toggleAttribute('data-qreports-theme',hasTheme&&!darkSurface);document.documentElement.toggleAttribute('data-qreports-query-theme',hasTheme);document.documentElement.toggleAttribute('data-qreports-app-theme',hasTheme);window.dispatchEvent(new CustomEvent('qreports-settings-changed',{detail:settings}));}
  function installCanvasSettings(dialog){
    const group=document.createElement('details');group.className='settings-group';
    group.innerHTML='<summary>Canvas</summary><label>Default canvas size<select name="defaultCanvasSizeMode"><option value="fit">Fit window</option><option value="preset">Preset</option><option value="manual">Manual</option></select></label><label class="settings-canvas-preset">Preset size<select name="defaultCanvasPreset"></select></label><div class="settings-canvas-manual settings-colors"><label>Width (px)<input name="defaultCanvasWidth" type="number" min="320" max="16384" required></label><label>Height (px)<input name="defaultCanvasHeight" type="number" min="240" max="16384" required></label></div><small>Applies to new reports and newly added pages. Existing page sizes are unchanged.</small>';
    const presets=[...document.querySelectorAll('#canvasPreset option')].map(option=>option.value);
    if(!presets.length)presets.push('640x360','800x450','960x540','1280x720','1600x900','1920x1080','2560x1440','3840x2160');
    if(!presets.includes(settings.defaultCanvasPreset))presets.push(settings.defaultCanvasPreset);
    group.querySelector('[name=defaultCanvasPreset]').replaceChildren(...presets.map(size=>new Option(size.replace('x',' × '),size)));
    dialog.querySelectorAll('.settings-group')[1].before(group);
    group.querySelector('[name=defaultCanvasSizeMode]').addEventListener('change',()=>toggleCanvasSizeFields(dialog));
  }
  function toggleCanvasSizeFields(dialog){
    const mode=dialog.querySelector('[name=defaultCanvasSizeMode]').value;
    dialog.querySelector('.settings-canvas-preset').style.display=mode==='preset'?'block':'none';
    dialog.querySelector('.settings-canvas-manual').style.display=mode==='manual'?'grid':'none';
    for(const name of ['defaultCanvasWidth','defaultCanvasHeight'])dialog.querySelector(`[name=${name}]`).disabled=mode!=='manual';
  }
  function open(){
    document.querySelector('#sharedSettingsDialog')?.remove();const dialog=document.createElement('dialog');dialog.id='sharedSettingsDialog';
    dialog.innerHTML='<form method="dialog"><header><h2>Settings</h2><button value="cancel" aria-label="Close">×</button></header><details class="settings-group"><summary>Colors</summary><div class="settings-color-preview" aria-label="Color preview"><div class="settings-preview-card"><div class="settings-preview-heading">Report preview</div><div class="settings-preview-body"><strong class="settings-preview-accent">42,500</strong><p>Sample report text</p><span class="settings-preview-positive">Positive +12%</span> <span class="settings-preview-negative">Negative −8%</span></div></div></div><div class="settings-colors"></div><label>Default chart theme for new canvases<select name="defaultChartTheme"></select></label><div class="settings-chart-preview" aria-label="Chart palette preview"></div><button type="button" class="settings-restore-colors">Restore color defaults</button></details><details class="settings-group"><summary>General</summary><label>Zoom at startup<select name="zoom"><option value="0.75">75%</option><option value="0.9">90%</option><option value="1">100%</option><option value="1.1">110%</option><option value="1.25">125%</option><option value="1.5">150%</option><option value="2">200%</option></select></label><label>Default save folder<input name="defaultSavePath" type="text" placeholder="Choose your preferred folder path"></label></details><details class="settings-group"><summary>Query</summary><label>Default records to return<input name="records" type="number" min="0" max="50000"></label><small>Used for new queries. 0 returns all records. Right-click a query tab to set its own row count.</small></details><details class="settings-group"><summary>MiniSQL limits</summary><small>Limits apply to local MiniSQL queries. 0 disables a limit; existing installations remain unlimited until you set one.</small><label>Maximum rows in each source<input name="miniSqlMaxSourceRows" type="number" min="0" max="10000000" required></label><label>Maximum intermediate rows<input name="miniSqlMaxIntermediateRows" type="number" min="0" max="10000000" required></label><label>Maximum result rows<input name="miniSqlMaxResultRows" type="number" min="0" max="10000000" required></label><label>Query timeout (seconds)<input name="miniSqlTimeoutSeconds" type="number" min="0" max="3600" required></label></details><p class="settings-error"></p><footer><button value="cancel">Cancel</button><button type="button" class="settings-save">Save settings</button></footer></form>';
    installCanvasSettings(dialog);
    const presetLabel=document.createElement('label');presetLabel.textContent='Color combination';
    const presetSelect=document.createElement('select');presetSelect.name='colorPreset';
    presetSelect.replaceChildren(new Option('Custom','Custom'),...Object.keys(colorPresets).map(name=>new Option(({Light:'Light mode',Dark:'Dark mode',Midnight:'Midnight ocean',Graphite:'Warm graphite',VioletNight:'Violet night',Windows:'Windows mode',Ocean:'Ocean mist',Forest:'Forest',Plum:'Plum twilight',Sandstone:'Warm sandstone',Alpine:'Alpine green',Slate:'Soft slate',Coral:'Coral blush',Indigo:'Indigo dusk',Citrus:'Citrus leaf'})[name],name)));
    presetLabel.append(presetSelect);dialog.querySelector('.settings-color-preview').before(presetLabel);
    const presetHelp=document.createElement('small');presetHelp.textContent='Sets the color roles and chart palette for new reports. Existing reports keep their own colors.';presetLabel.after(presetHelp);
    dialog.querySelector('.settings-save').style.background='var(--qreports-accent)';
    [...dialog.querySelectorAll('.settings-group')].find(group=>group.querySelector('summary')?.textContent==='Query')?.querySelector('small')?.insertAdjacentHTML('beforebegin','<label class="settings-checkbox" style="display:flex;align-items:center;gap:8px"><input name="queryShowTabs" type="checkbox" style="width:auto"> Show tabs</label>');
    dialog.querySelector('[name=queryShowTabs]').checked=!!settings.queryShowTabs;
    const roles={...roleDefaults,...settings.themeRoles};Object.entries(roles).forEach(([name,color])=>{const label=document.createElement('label');label.textContent=name.replace(/([A-Z])/g,' $1');const input=document.createElement('input');input.type='color';input.dataset.role=name;input.value=color;label.append(input);dialog.querySelector('.settings-colors').append(label);});
    const paletteNames=['Default','Bright','Pastel','Muted','Excel','EarthTones','Berry','SeaGreen','Fire','Grayscale',...(window.canvasSettingsPalettes||[]).map(item=>item.name),settings.defaultChartTheme];dialog.querySelector('[name=defaultChartTheme]').replaceChildren(...[...new Set(paletteNames)].map(name=>new Option(name,name)));
    const zoomSelect=dialog.querySelector('[name=zoom]');if(![...zoomSelect.options].some(option=>Number(option.value)===settings.zoom))zoomSelect.add(new Option(`${Math.round(settings.zoom*100)}%`,settings.zoom));
    for(const key of ['zoom','records','miniSqlMaxSourceRows','miniSqlMaxIntermediateRows','miniSqlMaxResultRows','miniSqlTimeoutSeconds','defaultChartTheme','defaultSavePath','defaultCanvasSizeMode','defaultCanvasPreset','defaultCanvasWidth','defaultCanvasHeight'])dialog.querySelector(`[name=${key}]`).value=settings[key];
    let restoredColors=false;
    let presetPalette=null;
    const chartColors=()=>{const name=dialog.querySelector('[name=defaultChartTheme]').value;return presetPalette||(restoredColors&&name==='Default'?paletteDefaults.Default:(window.canvasSettingsPalettes||[]).find(item=>item.name===name)?.colors||(name===settings.defaultChartTheme&&settings.defaultChartColors?.length?settings.defaultChartColors:paletteDefaults[name]||paletteDefaults.Default));};
    const activeRoles=()=>Object.fromEntries([...dialog.querySelectorAll('[data-role]')].map(input=>[input.dataset.role,input.value]));
    const findPreset=()=>Object.entries(colorPresets).find(([,preset])=>preset.chartTheme===dialog.querySelector('[name=defaultChartTheme]').value&&Object.entries(preset.roles).every(([role,color])=>activeRoles()[role]?.toLowerCase()===color.toLowerCase()))?.[0]||'Custom';
    const detectedPreset=findPreset();
    presetSelect.value=settings.colorPreset&&settings.colorPreset!=='Custom'&&colorPresets[settings.colorPreset]?settings.colorPreset:detectedPreset;
    function updatePreview(){
      const roles=Object.fromEntries([...dialog.querySelectorAll('[data-role]')].map(input=>[input.dataset.role,input.value]));
      for(const [name,cssName] of Object.entries({accent:'accent',surface:'surface',text:'text',headerBackground:'header',headerText:'header-text',grid:'grid',positive:'positive',negative:'negative'}))dialog.style.setProperty(`--qreports-${cssName}`,roles[name]);
      const surface=parseInt(roles.surface.slice(1,3),16)*.2126+parseInt(roles.surface.slice(3,5),16)*.7152+parseInt(roles.surface.slice(5,7),16)*.0722;
      dialog.style.setProperty('--qreports-color-scheme',surface<128?'dark':'light');
      const swatches=(colors,names)=>colors.map((color,index)=>{const cell=document.createElement('span');cell.className='settings-preview-swatch';const block=document.createElement('span');block.style.background=color;const caption=document.createElement('small');caption.textContent=names?.[index]?.replace(/([A-Z])/g,' $1')||color;cell.append(block,caption);return cell;});
      const card=dialog.querySelector('.settings-preview-card');card.style.background=roles.surface;card.style.color=roles.text;card.style.borderColor=roles.grid;
      const heading=dialog.querySelector('.settings-preview-heading');heading.style.background=roles.headerBackground;heading.style.color=roles.headerText;heading.style.borderColor=roles.grid;
      for(const name of ['accent','positive','negative'])dialog.querySelector('.settings-preview-'+name).style.color=roles[name];
      dialog.querySelector('.settings-chart-preview').replaceChildren(...swatches(chartColors()));
    }
    presetSelect.addEventListener('change',()=>{const preset=colorPresets[presetSelect.value];if(!preset)return;dialog.querySelectorAll('[data-role]').forEach(input=>input.value=preset.roles[input.dataset.role]);dialog.querySelector('[name=defaultChartTheme]').value=preset.chartTheme;presetPalette=paletteDefaults[preset.chartTheme];restoredColors=false;updatePreview();});
    dialog.querySelector('.settings-colors').addEventListener('input',()=>{presetSelect.value='Custom';updatePreview();});
    dialog.querySelector('[name=defaultChartTheme]').addEventListener('change',()=>{restoredColors=false;presetPalette=null;presetSelect.value='Custom';updatePreview();});
    dialog.querySelector('.settings-restore-colors').onclick=()=>{dialog.querySelectorAll('[data-role]').forEach(input=>input.value=roleDefaults[input.dataset.role]);dialog.querySelector('[name=defaultChartTheme]').value='Default';presetSelect.value='Light';presetPalette=paletteDefaults.Default;restoredColors=true;updatePreview();};
    updatePreview();
    dialog.querySelector('.settings-save').onclick=()=>{const form=dialog.querySelector('form');if(!form.reportValidity())return;const values=new FormData(form),next={...settings,zoom:Number(values.get('zoom')),records:Number(values.get('records')),queryShowTabs:form.elements.queryShowTabs.checked,miniSqlMaxSourceRows:Number(values.get('miniSqlMaxSourceRows')),miniSqlMaxIntermediateRows:Number(values.get('miniSqlMaxIntermediateRows')),miniSqlMaxResultRows:Number(values.get('miniSqlMaxResultRows')),miniSqlTimeoutSeconds:Number(values.get('miniSqlTimeoutSeconds')),defaultChartTheme:values.get('defaultChartTheme'),colorPreset:presetSelect.value,defaultSavePath:values.get('defaultSavePath').trim(),themeRoles:Object.fromEntries([...dialog.querySelectorAll('[data-role]')].map(input=>[input.dataset.role,input.value]))};next.defaultCanvasSizeMode=form.elements.defaultCanvasSizeMode.value;next.defaultCanvasPreset=form.elements.defaultCanvasPreset.value;next.defaultCanvasWidth=Number(form.elements.defaultCanvasWidth.value);next.defaultCanvasHeight=Number(form.elements.defaultCanvasHeight.value);next.defaultChartColors=[...chartColors()];if(host){host.postMessage({type:'saveSharedSettings',settings:next});dialog.querySelector('.settings-save').disabled=true;}else {localStorage.setItem('qreports-shared-settings',JSON.stringify(next));apply(next);dialog.close();}};
    toggleCanvasSizeFields(dialog);
    dialog.addEventListener('close',()=>dialog.remove());document.body.append(dialog);dialog.showModal();
  }
  host?.addEventListener('message',event=>{if(event.data.type==='sharedSettings'){apply(event.data.settings);if(event.data.saved)document.querySelector('#sharedSettingsDialog')?.close();}if(['hostError','error'].includes(event.data.type)){const dialog=document.querySelector('#sharedSettingsDialog');if(dialog){dialog.querySelector('.settings-error').textContent=event.data.message;dialog.querySelector('.settings-save').disabled=false;}}});
  document.addEventListener('DOMContentLoaded',()=>{const compact=document.createElement('style');compact.textContent='#sharedSettingsDialog{width:min(744px,92vw);min-width:min(480px,92vw);max-width:96vw;max-height:92vh;resize:both}#sharedSettingsDialog .settings-colors{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:6px 10px!important}#sharedSettingsDialog .settings-colors label{min-width:0;margin:4px 0;font-size:11px}#sharedSettingsDialog .settings-colors input[type=color]{height:38px!important;padding:3px!important}@media(max-width:480px){#sharedSettingsDialog .settings-colors{grid-template-columns:repeat(2,minmax(0,1fr))!important}}';document.head.append(compact);});
  document.addEventListener('DOMContentLoaded',()=>{const style=document.createElement('style');style.textContent='html[data-qreports-theme] body{color:var(--qreports-text)}html[data-qreports-theme] body>header,html[data-qreports-theme] .toolbar{background:var(--qreports-header);color:var(--qreports-header-text)}html[data-qreports-theme] aside{background:var(--qreports-surface)}html[data-qreports-theme] button.primary{background:var(--qreports-accent)}#sharedSettingsDialog{width:min(620px,90vw);max-height:90vh;overflow:auto;border:1px solid var(--qreports-grid);border-radius:14px;padding:20px;color:var(--qreports-text);background:var(--qreports-surface);color-scheme:var(--qreports-color-scheme,light)}#sharedSettingsDialog::backdrop{background:#14253d66}#sharedSettingsDialog header,#sharedSettingsDialog footer{display:flex;justify-content:space-between;align-items:center;gap:12px;background:transparent;color:inherit;padding:0;height:auto}#sharedSettingsDialog h2{margin:0}#sharedSettingsDialog .settings-group{margin:18px 0;padding:14px;background:color-mix(in srgb,var(--qreports-surface) 92%,var(--qreports-header-text));border-radius:9px}#sharedSettingsDialog label{display:block;margin:10px 0;font-size:13px}#sharedSettingsDialog input,#sharedSettingsDialog select{display:block;width:100%;padding:8px;border:1px solid var(--qreports-grid);border-radius:7px;background:var(--qreports-surface);color:var(--qreports-text)}#sharedSettingsDialog .settings-colors{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px}#sharedSettingsDialog input[type=color]{height:56px;padding:4px;cursor:pointer}#sharedSettingsDialog .settings-group>summary{font-weight:600;cursor:pointer;padding:2px 0}#sharedSettingsDialog .settings-group[open]>summary{margin-bottom:12px}#sharedSettingsDialog .settings-role-swatches,#sharedSettingsDialog .settings-chart-preview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:12px 0}#sharedSettingsDialog .settings-preview-swatch{display:flex;flex-direction:column;gap:4px;text-align:center;font-size:11px;overflow-wrap:anywhere}#sharedSettingsDialog .settings-preview-swatch>span{height:40px;border:1px solid #18223022;border-radius:5px}#sharedSettingsDialog .settings-preview-card{border:1px solid;border-radius:8px;overflow:hidden;margin:14px 0}#sharedSettingsDialog .settings-preview-heading{padding:10px 12px;border-bottom:1px solid;font-weight:600}#sharedSettingsDialog .settings-preview-body{padding:12px}#sharedSettingsDialog .settings-preview-accent{font-size:24px}#sharedSettingsDialog .settings-preview-body p{margin:8px 0}.settings-error{color:var(--qreports-negative)}#sharedSettingsDialog .settings-save{background:var(--qreports-accent);color:var(--qreports-on-accent)}#sharedSettingsDialog button:not(.settings-save){background:var(--qreports-surface);color:var(--qreports-text);border-color:var(--qreports-grid)}';document.head.append(style);const button=document.createElement('button');button.type='button';button.dataset.sharedSettings='';button.textContent='⚙ Settings';button.onclick=open;(document.querySelector('.file-actions,.toolbar')||document.querySelector('header'))?.append(button);apply(settings);});
})();
