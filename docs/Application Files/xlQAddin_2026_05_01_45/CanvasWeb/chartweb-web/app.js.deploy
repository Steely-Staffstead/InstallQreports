  function correctFixedChartText(){/* SVGs preserve aspect ratio; keep authored text rotations intact. */}
  function renderChart(){normalize();syncSettings();const chart=$("#chart"),type=window.CanvasChartRenderer.typeName(spec().Kind);chart.innerHTML=window.CanvasChartRenderer.render({data:documentModel.data,measures:documentModel.measures,spec:documentModel.spec,settingsJson:documentModel.settingsJson||"",fallbackField:style().Ycolumn});if(["gauge","treemap"].includes(type))chart.insertAdjacentHTML("beforeend",`<button class="chart-overlay-resize" data-chart-size="${type}" title="Drag to resize chart" aria-label="Resize chart"></button>`);correctFixedChartText(chart);$("#status").textContent=`${documentModel.data.rows.length.toLocaleString()} rows · ${series().length} series`;$("#json").value=JSON.stringify(documentModel,null,2);}
  function render(){renderControls();renderChart();}
  function setType(value){spec().Kind=value;series().forEach((item,index)=>{if(value==="combo")item.Kind=index?"Line":"Bar";else if(["line","area","scatter"].includes(value))item.Kind=value[0].toUpperCase()+value.slice(1);else item.Kind="Bar";});render();}
  function updateOption(key,value,rerender=true){options()[key]=value;if(rerender)renderChart();}
  function beginTitleEdit(){const chart=$("#chart");chart.querySelector(".chart-inline-title")?.remove();const editor=document.createElement("input");editor.className="chart-inline-title";editor.value=style().HeaderText||spec().Name||"Chart";chart.append(editor);editor.focus();editor.select();let done=false;const finish=commit=>{if(done)return;done=true;if(commit&&editor.value.trim()){style().HeaderText=editor.value.trim();style().HeaderTextManual=editor.value.trim();spec().Name=editor.value.trim();setValue("#title",style().HeaderText);}editor.remove();renderChart();};editor.addEventListener("keydown",event=>{if(event.key==="Enter")finish(true);if(event.key==="Escape")finish(false);});editor.addEventListener("blur",()=>finish(true));}
  function showLegendPositionControl(){const chart=$("#chart");chart.querySelector(".chart-direct-popover")?.remove();const popup=document.createElement("div"),positions=[["Top","Top left"],["TopCenter","Top center"],["Right","Right"],["Bottom","Bottom left"],["BottomCenter","Bottom center"],["Left","Left"]];popup.className="chart-direct-popover";popup.innerHTML=`<strong>Legend position</strong><div>${positions.map(([position,label])=>`<button type="button" data-position="${position}" class="${opt("LegendPosition","Bottom")===position?"active":""}">${label}</button>`).join("")}<button type="button" data-hide-legend>Hide legend</button></div>`;chart.append(popup);popup.addEventListener("click",event=>{const hide=event.target.closest("[data-hide-legend]");if(hide){setChecked("#showLegend",false);updateOption("ShowLegend",false);return;}const button=event.target.closest("[data-position]");if(!button)return;setChecked("#showLegend",true);options().ShowLegend=true;setValue("#legendPosition",button.dataset.position);updateOption("LegendPosition",button.dataset.position);});}
  function openOptionGroup(label){const layout=$("#chartLayout");layout.classList.remove("options-collapsed");const details=[...document.querySelectorAll(".options details")].find(item=>item.querySelector("summary")?.textContent.trim()===label);if(!details)return;details.open=true;details.scrollIntoView({behavior:"smooth",block:"start"});}
  function beginTitleDrag(event){if(event.button!==0)return;event.preventDefault();const chart=$("#chart"),rect=chart.getBoundingClientRect(),startX=event.clientX,startY=event.clientY,offsetX=Number(opt("TitleOffsetX",0))||0,offsetY=Number(opt("TitleOffsetY",0))||0;let moved=false;const move=moveEvent=>{const dx=(moveEvent.clientX-startX)*800/rect.width,dy=(moveEvent.clientY-startY)*440/rect.height;if(Math.abs(dx)+Math.abs(dy)<2)return;moved=true;document.body.classList.add("chart-title-dragging");options().TitleOffsetX=Math.max(-360,Math.min(360,Math.round(offsetX+dx)));options().TitleOffsetY=Math.max(-180,Math.min(180,Math.round(offsetY+dy)));renderChart();};const stop=()=>{document.removeEventListener("pointermove",move);document.removeEventListener("pointerup",stop);document.body.classList.remove("chart-title-dragging");if(!moved)return;};document.addEventListener("pointermove",move);document.addEventListener("pointerup",stop,{once:true});}
  function beginLegendDrag(event){if(event.button!==0)return;event.preventDefault();event.stopPropagation();const chart=$("#chart"),rect=chart.getBoundingClientRect(),startX=event.clientX,startY=event.clientY,offsetX=Number(opt("LegendOffsetX",0))||0,offsetY=Number(opt("LegendOffsetY",0))||0;let moved=false;const move=moveEvent=>{const dx=(moveEvent.clientX-startX)*800/rect.width,dy=(moveEvent.clientY-startY)*440/rect.height;if(Math.abs(dx)+Math.abs(dy)<2)return;moved=true;document.body.classList.add("chart-legend-dragging");options().LegendOffsetX=Math.max(-500,Math.min(500,Math.round(offsetX+dx)));options().LegendOffsetY=Math.max(-300,Math.min(300,Math.round(offsetY+dy)));renderChart();};const stop=()=>{document.removeEventListener("pointermove",move);document.removeEventListener("pointerup",stop);document.body.classList.remove("chart-legend-dragging");if(!moved)openOptionGroup("Legend");};document.addEventListener("pointermove",move);document.addEventListener("pointerup",stop,{once:true});}
  function beginDoughnutResize(event){if(event.button!==0)return;event.preventDefault();const kind=event.target.closest("[data-chart-size]")?.dataset.chartSize||"doughnut",settings={pie:["PieRadius","#pieRadius",150,80,205,800],doughnut:["DoughnutRadius","#doughnutRadius",175,80,205,800],gauge:["GaugeScale","#gaugeScale",100,50,135,300],treemap:["TreemapScale","#treemapScale",100,50,125,300]}[kind],key=settings[0],input=settings[1],fallback=settings[2],minimum=settings[3],maximum=settings[4],sensitivity=settings[5],chart=$("#chart"),rect=chart.getBoundingClientRect(),startX=event.clientX,start=Number(opt(key,fallback))||fallback;document.body.classList.add("chart-doughnut-dragging");const move=moveEvent=>{const size=Math.max(minimum,Math.min(maximum,Math.round(start+(moveEvent.clientX-startX)*sensitivity/rect.width)));options()[key]=size;setValue(input,size);renderChart();};const stop=()=>{document.removeEventListener("pointermove",move);document.removeEventListener("pointerup",stop);document.body.classList.remove("chart-doughnut-dragging");};document.addEventListener("pointermove",move);document.addEventListener("pointerup",stop,{once:true});}
  function beginMarginDrag(event,side){if(event.button!==0)return;event.preventDefault();const chart=$("#chart"),rect=chart.getBoundingClientRect(),key={top:"MarginTop",bottom:"MarginBottom",left:"MarginLeft",right:"MarginRight"}[side],input={top:"#marginTop",bottom:"#marginBottom",left:"#marginLeft",right:"#marginRight"}[side],minimum={top:-80,bottom:-80,left:-55,right:-20}[side],maximum=side==="left"||side==="right"?200:140,start=Number(opt(key,0))||0,startX=event.clientX,startY=event.clientY;document.body.classList.add("chart-margin-dragging");const move=moveEvent=>{const raw=side==="left"?start+(moveEvent.clientX-startX)*800/rect.width:side==="right"?start-(moveEvent.clientX-startX)*800/rect.width:side==="top"?start+(moveEvent.clientY-startY)*440/rect.height:start-(moveEvent.clientY-startY)*440/rect.height,value=Math.max(minimum,Math.min(maximum,Math.round(raw)));options()[key]=value;setValue(input,value);renderChart();};const stop=()=>{document.removeEventListener("pointermove",move);document.removeEventListener("pointerup",stop);document.body.classList.remove("chart-margin-dragging");};document.addEventListener("pointermove",move);document.addEventListener("pointerup",stop,{once:true});}

  $("#types").addEventListener("click",event=>{const button=event.target.closest("[data-type]");if(button)setType(button.dataset.type);});$("#chartType").addEventListener("change",event=>setType(event.target.value));
  [["value","Ycolumn"],["category","Xcolumn"],["group","GroupBy"],["subgroup","SubgroupBy"]].forEach(([id,key])=>$("#"+id).addEventListener("change",event=>{style()[key]=event.target.value;if(key==="Ycolumn"){if(!series().length)series().push({Id:uid(),ColumnName:event.target.value,Kind:"Bar"});else{series()[0].ColumnName=event.target.value;series()[0].LegendText=event.target.value;}}render();}));
    $("#title").addEventListener("input",event=>{style().HeaderText=event.target.value;style().HeaderTextManual=event.target.value;spec().Name=event.target.value;renderChart();});$("#background").addEventListener("change",event=>{style().BackgroundColor=event.target.value;renderChart();});
  $("#showTitle").addEventListener("change",event=>updateOption("ShowTitle",event.target.checked));$("#showLegend").addEventListener("change",event=>updateOption("ShowLegend",event.target.checked));$("#showGrid").addEventListener("change",event=>updateOption("ShowGrid",event.target.checked));
  [["paletteName","PaletteName"],["legendTextMode","LegendTextMode"],["legendPosition","LegendPosition"],["categoryOrder","CategoryOrder"],["valueAxisOrder","ValueAxisOrder"],["labelDelimiter","LabelDelimiter"],["labelPosition","LabelPosition"],["barOrientation","BarOrientation"],["barShading","BarShading"],["lineStyle","LineStyle"],["histogramRound","HistogramRoundTo"],["markerType","MarkerType"],["scatterLollipop","ScatterLollipop"],["doughnutCategoryLabels","DoughnutCategoryLabels"],["doughnutGroupLabels","DoughnutGroupLabels"],["doughnutCategoryDirection","DoughnutCategoryDirection"],["doughnutGroupDirection","DoughnutGroupDirection"],["treemapLayout","TreemapLayout"],["treemapCategoryLabels","TreemapCategoryLabels"],["treemapGroupLabels","TreemapGroupLabels"]].forEach(([id,key])=>$("#"+id).addEventListener("change",event=>updateOption(key,event.target.value)));
  $("#titleAlignment").addEventListener("change",event=>{options().TitleOffsetX=0;options().TitleOffsetY=0;updateOption("TitleAlignment",event.target.value);});
  [["categoryFormat","CategoryAxisFormat"],["groupLabelFormat","GroupLabelFormat"],["valueAxisFormat","ValueAxisFormat"],["valueLabelFormat","ValueLabelFormat"]].forEach(([id,key])=>$("#"+id).addEventListener("input",event=>updateOption(key,event.target.value)));
  [["titleSize","TitleSize"],["legendSize","LegendSize"],["categoryAngle","CategoryAxisAngle"],["categorySize","CategoryAxisSize"],["groupLabelSize","GroupLabelSize"],["groupLabelAngle","GroupLabelAngle"],["valueAxisSize","ValueAxisSize"],["valueLabelAngle","ValueLabelAngle"],["valueLabelSize","ValueLabelSize"],["treemapBorder","TreemapBorderWidth"],["barWidth","BarWidthPercent"],["shadingPercent","ShadingPercent"],["lineThickness","LineThickness"],["lineShadePercent","LineShadePercent"],["markerSize","MarkerSize"],["scatterSizeMin","ScatterSizeMin"],["scatterSizeMax","ScatterSizeMax"],["doughnutRadius","DoughnutRadius"],["doughnutHole","DoughnutHolePercent"],["doughnutCategoryOverflow","DoughnutCategoryLabelOverflowPercent"],["pieRadius","PieRadius"]].forEach(([id,key])=>$("#"+id).addEventListener("input",event=>updateOption(key,Number(event.target.value))));
  $("#titleColor").addEventListener("change",event=>updateOption("TitleColor",event.target.value));
  [["categoryMin","CategoryAxisMin"],["categoryMax","CategoryAxisMax"],["valueMin","ValueAxisMin"],["valueMax","ValueAxisMax"]].forEach(([id,key])=>$("#"+id).addEventListener("input",event=>updateOption(key,event.target.value===""?"":Number(event.target.value))));
  [["marginTop","MarginTop"],["marginBottom","MarginBottom"],["marginLeft","MarginLeft"],["marginRight","MarginRight"]].forEach(([id,key])=>$("#"+id).addEventListener("input",event=>updateOption(key,Number(event.target.value)||0)));
  [["showValueLabels","ShowValueLabels"],["labelCategory","LabelShowCategory"],["labelSeries","LabelShowSeriesName"],["labelValue","LabelShowValue"],["showMarkers","ShowMarkers"],["filledMarkers","FilledMarkers"],["scatterRegression","ScatterRegression"],["scatterConnect","ScatterConnectPoints"]].forEach(([id,key])=>$("#"+id).addEventListener("change",event=>updateOption(key,event.target.checked)));
  $("#waterfallLayout").addEventListener("change",event=>updateOption("WaterfallGroupLayout",event.target.value));$("#waterfallTotal").addEventListener("change",event=>updateOption("WaterfallShowTotal",event.target.checked));$("#waterfallCustomColors").addEventListener("change",event=>updateOption("WaterfallUseCustomColors",event.target.checked));[["waterfallIncreaseColor","WaterfallIncreaseColor"],["waterfallDecreaseColor","WaterfallDecreaseColor"],["waterfallTotalColor","WaterfallTotalColor"]].forEach(([id,key])=>$("#"+id).addEventListener("change",event=>updateOption(key,event.target.value)));
  [["bins","bins"],["binSize","binsize"],["gaugeTarget","GaugeTarget"],["gaugeLevel1","GaugeLevel1Pct"],["gaugeLevel2","GaugeLevel2Pct"],["gaugeLevel3","GaugeLevel3Pct"],["gaugeMaximum","GaugeOverTargetPct"],["groupLabelOffset","GroupLabelVerticalPosition"]].forEach(([id,key])=>$("#"+id).addEventListener("input",event=>updateOption(key,Number(event.target.value))));
  $("#useBinSize").addEventListener("change",event=>updateOption("usebinsize",event.target.checked));$("#showOutliers").addEventListener("change",event=>updateOption("BoxplotShowOutliers",event.target.checked));$("#gaugeTargetColumn").addEventListener("change",event=>updateOption("GaugeTargetColumn",event.target.value));$("#scatterSizeField").addEventListener("change",event=>updateOption("ScatterSizeField",event.target.value));
  $("#resetMargins").addEventListener("click",()=>{["Top","Bottom","Left","Right"].forEach(side=>{options()[`Margin${side}`]=0;setValue(`#margin${side}`,0);});renderChart();});
  $("#resetDoughnut").addEventListener("click",()=>{options().DoughnutRadius=175;options().DoughnutHolePercent=38;options().DoughnutCategoryLabelOverflowPercent=30;setValue("#doughnutRadius",175);setValue("#doughnutHole",38);setValue("#doughnutCategoryOverflow",30);renderChart();});
  $("#chart").addEventListener("dblclick",event=>{if(event.target.closest("[data-chart-action='edit-title']"))beginTitleEdit();});$("#chart").addEventListener("click",event=>{if(event.target.closest("[data-chart-action='legend-position']"))return;else if(event.target.closest("[data-chart-action='edit-title']"))openOptionGroup("Title settings");else if(event.target.closest("[data-chart-action='group-label']"))openOptionGroup("Group labels");else if(event.target.closest("[data-chart-action='value-axis'],.value-axis-label"))openOptionGroup("Value axis");else if(event.target.closest("[data-chart-action='category-axis'],.chart-axis-label"))openOptionGroup("Category axis");else if(event.target.closest("svg rect,svg polyline,svg circle,svg polygon,svg path"))openOptionGroup("Data labels");});$("#chart").addEventListener("pointerdown",event=>{const handle=event.target.closest("[data-margin-handle]");if(handle)beginMarginDrag(event,handle.dataset.marginHandle);else if(event.target.closest("[data-chart-action='legend-position']"))beginLegendDrag(event);else if(event.target.closest("[data-chart-size]"))beginDoughnutResize(event);else if(event.target.closest("[data-chart-action='edit-title']"))beginTitleDrag(event);});
  $("#collapseAll").addEventListener("click",()=>document.querySelectorAll(".options details").forEach(details=>details.open=false));$("#hideOptions").addEventListener("click",()=>{$("#chartLayout").classList.add("options-collapsed");correctFixedChartText($("#chart"));});$("#expandOptions").addEventListener("click",()=>{$("#chartLayout").classList.remove("options-collapsed");correctFixedChartText($("#chart"));});$("#hideData").addEventListener("click",()=>{$("#chartLayout").classList.add("data-collapsed");correctFixedChartText($("#chart"));});$("#expandData").addEventListener("click",()=>{$("#chartLayout").classList.remove("data-collapsed");correctFixedChartText($("#chart"));});
  $("#addSeries").addEventListener("click",()=>{const field=names()[0]||"",type=window.CanvasChartRenderer.typeName(spec().Kind),kind=type==="combo"&&series().length?"Line":["line","area","scatter"].includes(type)?type[0].toUpperCase()+type.slice(1):"Bar";series().push({Id:uid(),ColumnName:field,Kind:kind,LegendText:field});render();});
  $("#series").addEventListener("change",event=>{const row=event.target.closest("[data-index]");if(!row)return;const item=series()[+row.dataset.index];if(event.target.matches("[data-series-field]")){item.ColumnName=event.target.value;item.LegendText=event.target.value;}if(event.target.matches("[data-series-kind]"))item.Kind=event.target.value;if(event.target.matches("[data-series-color]"))item.Color=event.target.value;render();});
  $("#series").addEventListener("click",event=>{const row=event.target.closest("[data-index]");if(!row)return;const index=+row.dataset.index;if(event.target.closest("[data-remove-series]")){series().splice(index,1);render();}else if(event.target.closest("[data-theme-color]")){delete series()[index].Color;render();}});
  $("#applyJson").addEventListener("click",()=>{try{documentModel=JSON.parse($("#json").value);hydrated=false;$("#error").textContent="";render();}catch(error){$("#error").textContent=error.message;}});$("#reset").addEventListener("click",()=>{documentModel=sample();hydrated=false;render();});$("#return").addEventListener("click",()=>host?host.postMessage({type:"return",document:documentModel}):$("#error").textContent="Return is available in the desktop host.");
  host?.addEventListener("message",event=>{if(event.data.type==="load"){documentModel=event.data.document;hydrated=false;render();}if(event.data.type==="loadSample"){documentModel=sample();hydrated=false;render();}if(event.data.type==="error")$("#error").textContent=event.data.message;});host?.postMessage({type:"ready"});if(!host){documentModel=sample();hydrated=false;render();}
})();
