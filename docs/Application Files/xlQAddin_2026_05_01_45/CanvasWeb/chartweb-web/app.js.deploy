(() => {
  const host=window.chrome?.webview,$=selector=>document.querySelector(selector),uid=()=>crypto.randomUUID();
  const chartTypes=[
    ["bar","▥","Bar / column"],["stacked","▤","Stacked"],["line","⌁","Line"],["area","▰","Area"],["scatter","⠿","Scatter"],
    ["waterfall","▥","Waterfall"],["histogram","▥","Histogram"],["boxplot","▣","Boxplot"],["treemap","▦","Treemap"],["gauge","◴","Gauge"],
    ["pie","◕","Pie"],["doughnut","◉","Doughnut"]
  ];
  let documentModel=null,hydrated=false;
  const sample=()=>({
    data:{columns:["Category","Region","Segment","Revenue","Cost","Target"],types:["System.String","System.String","System.String","System.Double","System.Double","System.Double"],rows:[
      ["A","North","Retail",120,80,150],["A","South","Wholesale",95,70,150],["B","North","Wholesale",190,100,180],["B","South","Retail",155,120,180],
      ["C","North","Retail",145,92,160],["C","South","Wholesale",175,116,160],["D","North","Wholesale",240,150,220],["D","South","Retail",205,132,220]
    ]},measures:[],spec:{Name:"Sample chart",Kind:"stacked",Style:{Xcolumn:"Category",Ycolumn:"Revenue",HeaderText:"Revenue and cost"},ChartOptions:{},SeriesSpecs:[{ColumnName:"Revenue",Kind:"Bar",LegendText:"Revenue"},{ColumnName:"Cost",Kind:"Bar",LegendText:"Cost"}]},settingsJson:""
  });
  const measureNames=()=>[...(documentModel?.measures||[])].map(m=>m.OutputName||m.outputName||m.Name||m.name).filter(Boolean);
  const names=()=>[...(documentModel?.data?.columns||[]),...measureNames()].filter((x,i,a)=>a.indexOf(x)===i);
  const dimensions=()=>documentModel?.data?.columns||[];
  const spec=()=>documentModel.spec ||= {};
  const style=()=>spec().Style ||= {};
  const axisX=()=>style().AxisXStyle ||= {};
  const axisY=()=>style().AxisYStyle ||= {};
  const valueStyle=()=>style().ValueStyle ||= {};
  const options=()=>spec().ChartOptions ||= {};
  const series=()=>spec().SeriesSpecs ||= [];
  const opt=(key,fallback="")=>options()[key]??fallback;
  const bool=(key,fallback=true)=>{const value=opt(key,fallback);return typeof value==="boolean"?value:/^(true|1|yes|on)$/i.test(String(value));};
  const nullableNumber=value=>value===""||value==null?null:Number(value);
  const fieldOptions=(list,selected,none=true,noneLabel="None")=>`${none?`<option value="">${noneLabel}</option>`:""}${list.map(name=>`<option ${name===selected?"selected":""}>${String(name).replaceAll("&","&amp;").replaceAll("<","&lt;")}</option>`).join("")}`;

  function normalize(){
    documentModel ||= sample();documentModel.data ||= {columns:[],types:[],rows:[]};documentModel.measures ||= [];documentModel.spec ||= {};documentModel.spec.Style ||= {};documentModel.spec.ChartOptions ||= {};documentModel.spec.SeriesSpecs ||= [];
    if(!hydrated){
      let settings={};try{settings=typeof documentModel.settingsJson==="string"&&documentModel.settingsJson.trim()?JSON.parse(documentModel.settingsJson):{};}catch{}
      const ui=settings.ui||{},renderer=settings.renderer||{};
      style().Xcolumn ||= ui.x||"";style().Ycolumn ||= ui.y||"";style().GroupBy ||= ui.group||"";style().SubgroupBy ||= ui.subgroup||"";style().HeaderText ||= settings.name||spec().Name||"Chart";style().BackgroundColor ||= settings.background||"#ffffff";
      Object.entries(renderer).forEach(([key,value])=>{if(options()[key]==null)options()[key]=value;});
      if(!series().length)for(const entry of settings.series||[]){const item=entry.spec||entry,field=item.column||item.ColumnName;if(field)series().push({Id:uid(),ColumnName:field,Kind:item.kind||"Bar",LegendText:item.legend||entry.name||field});}
      if(!spec().Kind)spec().Kind=settings.type||"bar";if(new Set(series().map(item=>String(item.Kind).toLowerCase())).size>1)spec().Kind="combo";
      const inherit=(key,value)=>{if(options()[key]==null&&value!=null&&value!=="")options()[key]=value;},dockMap={0:"Top",1:"Bottom",2:"Left",3:"Right"},orderMap={0:"Natural",1:"AlphabeticalAsc",2:"AlphabeticalDesc",3:"ByYAsc",4:"ByYDesc",5:"AlphabeticalAsc",6:"AlphabeticalDesc"},labels=series()[0]?.Labels||{};
      inherit("PaletteName",style().PaletteName);inherit("LegendPosition",dockMap[style().LgdDock]||style().LgdDock);inherit("LegendSize",style().LgdFSize);inherit("ShowLegend",style().LgdVisible);inherit("CategoryAxisAngle",axisX().Angle??(style().XCatVert?90:null));inherit("CategoryAxisSize",axisX().Labels?.Size??style().XFontSize);inherit("CategoryAxisFormat",axisX().LabelFormatOverride);inherit("CategoryAxisMin",axisX().HardMin);inherit("CategoryAxisMax",axisX().HardMax);inherit("CategoryOrder",orderMap[style().XOrder]||style().XOrder);inherit("ValueAxisSize",axisY().Labels?.Size??style().YFontSize);inherit("ValueAxisFormat",axisY().LabelFormatOverride||valueStyle().Format);inherit("ValueAxisMin",axisY().HardMin??style().YMin);inherit("ValueAxisMax",axisY().HardMax??style().YMax);inherit("ShowValueLabels",labels.Show??valueStyle().Visible);inherit("ValueLabelFormat",labels.Format||valueStyle().Format);inherit("LabelDelimiter",labels.Delimiter);inherit("LabelPosition",labels.Position);inherit("ValueLabelSize",valueStyle().Size);if(labels.Parts!=null){inherit("LabelShowCategory",(+labels.Parts&1)!==0);inherit("LabelShowValue",(+labels.Parts&2)!==0);inherit("LabelShowSeriesName",(+labels.Parts&4)!==0);}hydrated=true;
    }
    if(!series().length&&style().Ycolumn)series().push({Id:uid(),ColumnName:style().Ycolumn,Kind:"Bar",LegendText:style().Ycolumn});
  }

  function syncSettings(){
    let settings={};try{settings=typeof documentModel.settingsJson==="string"&&documentModel.settingsJson.trim()?JSON.parse(documentModel.settingsJson):{};}catch{}
    syncLegacyStyle();settings.name=style().HeaderText||spec().Name||"Chart";settings.type=spec().Kind||"bar";settings.background=typeof style().BackgroundColor==="string"?style().BackgroundColor:"#ffffff";settings.showLegend=bool("ShowLegend",true);settings.showGrid=bool("ShowGrid",true);
    settings.ui={...(settings.ui||{}),x:style().Xcolumn||"None",y:style().Ycolumn||"",group:style().GroupBy||"None",subgroup:style().SubgroupBy||"None"};settings.renderer={...(settings.renderer||{}),...options()};
    settings.series=series().map((item,index)=>({index,name:item.LegendText||item.ColumnName,spec:{column:item.ColumnName,kind:item.Kind||"Bar",legend:item.LegendText||item.ColumnName,...(item.Color?{color:item.Color}:{})}}));documentModel.settingsJson=JSON.stringify(settings);
  }

  function syncLegacyStyle(){
    const x=axisX(),y=axisY(),v=valueStyle(),legendMap={Top:0,TopCenter:0,Bottom:1,BottomCenter:1,Left:2,Right:3},orderMap={Natural:0,AlphabeticalAsc:1,AlphabeticalDesc:2,ByYAsc:3,ByYDesc:4};x.Labels ||= {};y.Labels ||= {};
    x.Angle=Number(opt("CategoryAxisAngle",0));x.Labels.Size=Number(opt("CategoryAxisSize",11));x.LabelFormatOverride=opt("CategoryAxisFormat","Auto");x.HardMin=nullableNumber(opt("CategoryAxisMin",""));x.HardMax=nullableNumber(opt("CategoryAxisMax",""));x.BoundsMode=x.HardMin!=null||x.HardMax!=null?2:0;
    y.Labels.Size=Number(opt("ValueAxisSize",11));y.LabelFormatOverride=opt("ValueAxisFormat","Auto");y.HardMin=nullableNumber(opt("ValueAxisMin",""));y.HardMax=nullableNumber(opt("ValueAxisMax",""));y.BoundsMode=y.HardMin!=null||y.HardMax!=null?2:0;
    v.Visible=bool("ShowValueLabels",false);v.Format=opt("ValueLabelFormat","Auto");v.Size=Number(opt("ValueLabelSize",10));style().ValueFontSize=v.Size;style().XFontSize=x.Labels.Size;style().YFontSize=y.Labels.Size;style().XCatVert=Math.abs(x.Angle)>=80;
    style().LgdVisible=bool("ShowLegend",true);style().LgdDock=legendMap[opt("LegendPosition","Bottom")]??1;style().LgdFSize=Number(opt("LegendSize",11));style().PaletteName=opt("PaletteName","Default");style().XOrder=orderMap[opt("CategoryOrder","Natural")]??0;style().YMin=y.HardMin;style().YMax=y.HardMax;
    const parts=(bool("LabelShowCategory",false)?1:0)|(bool("LabelShowValue",true)?2:0)|(bool("LabelShowSeriesName",false)?4:0);series().forEach(item=>{item.Labels={...(item.Labels||{}),Show:v.Visible,Format:v.Format,Delimiter:opt("LabelDelimiter","Space"),Position:opt("LabelPosition","Auto"),Parts:parts};});
  }

  function setValue(id,value){const element=$(id);if(element)element.value=value??"";}
  function setChecked(id,value){const element=$(id);if(element)element.checked=!!value;}
  function renderTypeOptions(type){
    document.querySelectorAll(".type-options").forEach(element=>element.classList.remove("active"));
    const map={waterfall:["#waterfallOptions"],histogram:["#histogramOptions"],boxplot:["#boxplotOptions"],gauge:["#gaugeOptions"],treemap:["#treemapOptions"],bar:["#barOptions"],stacked:["#barOptions"],line:["#markerOptions"],combo:["#markerOptions"],scatter:["#markerOptions","#scatterOptions"],pie:["#pieOptions"],doughnut:["#doughnutOptions"]};(map[type]||[]).forEach(selector=>$(selector).classList.add("active"));
  }

  function renderControls(){
    normalize();const currentType=window.CanvasChartRenderer.typeName(spec().Kind);if(!$("#gaugeScale")){const label=document.createElement("label");label.innerHTML='Chart size %<input id="gaugeScale" type="number" min="50" max="135" value="100">';$("#gaugeOptions").insertBefore(label,$("#gaugeOptions").children[1]);label.querySelector("input").addEventListener("input",event=>updateOption("GaugeScale",Number(event.target.value)));}if(!$("#treemapScale")){const label=document.createElement("label");label.innerHTML='Chart size %<input id="treemapScale" type="number" min="50" max="125" value="100">';$("#treemapOptions").insertBefore(label,$("#treemapOptions").children[2]);label.querySelector("input").addEventListener("input",event=>updateOption("TreemapScale",Number(event.target.value)));}
    [["#categoryAngle","showCategoryAxis","Show category axis",bool("ShowCategoryAxis",true)],["#valueAxisSize","showValueAxis","Show value axis",bool("ShowValueAxis",true)]].forEach(([anchorId,id,label,checked])=>{if($("#"+id))return;const anchor=$(anchorId)?.closest(".two-cols"),control=document.createElement("label");control.className="check axis-visibility";control.innerHTML=`<input id="${id}" type="checkbox" ${checked?"checked":""}> ${label}`;anchor?.before(control);control.querySelector("input").addEventListener("change",event=>updateOption(id==="showCategoryAxis"?"ShowCategoryAxis":"ShowValueAxis",event.target.checked));});
    if(!$("#valueInterval")){const bounds=$("#valueMin")?.closest(".two-cols"),control=document.createElement("label");control.innerHTML='Grid interval<input id="valueInterval" type="number" min="0" step="any" placeholder="Automatic rounded interval">';bounds?.after(control);control.querySelector("input").addEventListener("input",event=>updateOption("ValueAxisInterval",event.target.value===""?"":Number(event.target.value)));}
    [["Above","Above marker / bar"],["Below","Below marker / bar"],["InsideCenter","Inside / center"]].forEach(([value,label])=>{if(![...$("#labelPosition").options].some(option=>option.value===value))$("#labelPosition").add(new Option(label,value));});
    $("#types").innerHTML=chartTypes.map(([value,icon,label])=>`<button class="type-button ${currentType===value?"active":""}" data-type="${value}"><span>${icon}</span><b>${label}</b></button>`).join("");
    const selectable=currentType==="combo"?[...chartTypes,["combo","⌁","Legacy combo"]]:chartTypes;$("#chartType").innerHTML=selectable.map(([value,,label])=>`<option value="${value}" ${currentType===value?"selected":""}>${label}</option>`).join("");
    $("#value").innerHTML=fieldOptions(names(),style().Ycolumn,false);$("#category").innerHTML=fieldOptions(dimensions(),style().Xcolumn);$("#group").innerHTML=fieldOptions(dimensions(),style().GroupBy);$("#subgroup").innerHTML=fieldOptions(dimensions(),style().SubgroupBy);
    $("#gaugeTargetColumn").innerHTML=fieldOptions(names(),opt("GaugeTargetColumn",""),true,"Fixed value");$("#scatterSizeField").innerHTML=fieldOptions(names(),opt("ScatterSizeField",""),true,"Fixed marker size");
    setValue("#title",style().HeaderText||spec().Name||"Chart");setChecked("#showTitle",bool("ShowTitle",true));setValue("#titleAlignment",opt("TitleAlignment","Left"));setValue("#titleSize",opt("TitleSize",20));setValue("#titleColor",opt("TitleColor","#253653"));setValue("#background",typeof style().BackgroundColor==="string"?style().BackgroundColor:"#ffffff");setChecked("#showLegend",bool("ShowLegend",true));setChecked("#showGrid",bool("ShowGrid",true));setChecked("#showCategoryAxis",bool("ShowCategoryAxis",true));setChecked("#showValueAxis",bool("ShowValueAxis",true));
    setValue("#paletteName",opt("PaletteName","Default"));setValue("#legendTextMode",opt("LegendTextMode","Category"));setValue("#legendPosition",opt("LegendPosition","Bottom"));setValue("#legendSize",opt("LegendSize",11));
    setValue("#categoryAngle",opt("CategoryAxisAngle",0));setValue("#categorySize",opt("CategoryAxisSize",11));setValue("#categoryFormat",opt("CategoryAxisFormat","Auto"));setValue("#categoryOrder",opt("CategoryOrder","Natural"));setValue("#categoryMin",opt("CategoryAxisMin",""));setValue("#categoryMax",opt("CategoryAxisMax",""));setValue("#groupLabelSize",opt("GroupLabelSize",11));setValue("#groupLabelAngle",opt("GroupLabelAngle",0));setValue("#groupLabelFormat",opt("GroupLabelFormat","Auto"));setValue("#groupLabelOffset",opt("GroupLabelVerticalPosition",opt("WaterfallGroupLabelOffset",0)));
    setValue("#valueAxisSize",opt("ValueAxisSize",11));setValue("#valueAxisOrder",opt("ValueAxisOrder","Ascending"));setValue("#valueAxisFormat",opt("ValueAxisFormat","Auto"));setValue("#valueMin",opt("ValueAxisMin",""));setValue("#valueMax",opt("ValueAxisMax",""));setValue("#valueInterval",opt("ValueAxisInterval",""));
    setChecked("#showValueLabels",bool("ShowValueLabels",false));setChecked("#labelCategory",bool("LabelShowCategory",false));setChecked("#labelSeries",bool("LabelShowSeriesName",false));setChecked("#labelValue",bool("LabelShowValue",true));setValue("#labelDelimiter",opt("LabelDelimiter","Space"));setValue("#labelPosition",opt("LabelPosition","Auto"));setValue("#valueLabelFormat",opt("ValueLabelFormat","Auto"));setValue("#valueLabelAngle",opt("ValueLabelAngle",0));setValue("#valueLabelSize",opt("ValueLabelSize",10));
    setValue("#marginTop",opt("MarginTop",0));setValue("#marginBottom",opt("MarginBottom",0));setValue("#marginLeft",opt("MarginLeft",0));setValue("#marginRight",opt("MarginRight",0));
    setValue("#barOrientation",opt("BarOrientation","Column"));setValue("#barWidth",opt("BarWidthPercent",76));setValue("#barShading",opt("BarShading","None"));setValue("#shadingPercent",opt("ShadingPercent",35));setValue("#lineThickness",opt("LineThickness",3));setValue("#lineStyle",opt("LineStyle","Solid"));setValue("#lineShadePercent",opt("LineShadePercent",0));setChecked("#showMarkers",bool("ShowMarkers",true));setChecked("#filledMarkers",bool("FilledMarkers",false));setValue("#markerType",opt("MarkerType","Circle"));setValue("#markerSize",opt("MarkerSize",7));setValue("#scatterSizeMin",opt("ScatterSizeMin",5));setValue("#scatterSizeMax",opt("ScatterSizeMax",18));setChecked("#scatterRegression",bool("ScatterRegression",false));setChecked("#scatterConnect",bool("ScatterConnectPoints",false));setValue("#scatterLollipop",opt("ScatterLollipop","None"));
