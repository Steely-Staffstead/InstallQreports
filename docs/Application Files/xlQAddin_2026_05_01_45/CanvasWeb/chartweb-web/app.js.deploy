    setValue("#waterfallLayout",opt("WaterfallGroupLayout","MiniWaterfall"));setChecked("#waterfallTotal",bool("WaterfallShowTotal",true));setChecked("#waterfallCustomColors",bool("WaterfallUseCustomColors",false));setValue("#waterfallIncreaseColor",opt("WaterfallIncreaseColor","#16a085"));setValue("#waterfallDecreaseColor",opt("WaterfallDecreaseColor","#d64562"));setValue("#waterfallTotalColor",opt("WaterfallTotalColor","#3158b5"));
    setValue("#bins",opt("bins",10));setValue("#histogramRound",opt("HistogramRoundTo",0));setChecked("#useBinSize",bool("usebinsize",false));setValue("#binSize",opt("binsize",1));setChecked("#showOutliers",bool("BoxplotShowOutliers",true));setValue("#treemapLayout",opt("TreemapLayout","Columns"));setValue("#treemapCategoryLabels",opt("TreemapCategoryLabels","Name"));setValue("#treemapGroupLabels",opt("TreemapGroupLabels","Name"));setValue("#treemapGroup2Labels",opt("TreemapGroup2Labels","Name"));setValue("#treemapBorder",opt("TreemapBorderWidth",3));
    setValue("#gaugeTarget",opt("GaugeTarget",100));setValue("#gaugeLevel1",opt("GaugeLevel1Pct",40));setValue("#gaugeLevel2",opt("GaugeLevel2Pct",60));setValue("#gaugeLevel3",opt("GaugeLevel3Pct",80));setValue("#gaugeMaximum",opt("GaugeOverTargetPct",110));
    $("#series").innerHTML=series().map((item,index)=>`<div class="series-row" data-index="${index}"><select data-series-field>${fieldOptions(names(),item.ColumnName,false)}</select><select data-series-kind>${["Bar","Line","Area","Scatter"].map(kind=>`<option ${String(item.Kind).toLowerCase()===kind.toLowerCase()?"selected":""}>${kind}</option>`).join("")}</select><input data-series-color type="color" value="${item.Color||"#5d7fe3"}" title="Override theme color"><button data-theme-color title="Use theme color">↺</button><button data-remove-series title="Remove">×</button></div>`).join("");
    renderTypeOptions(currentType);$("#json").value=JSON.stringify(documentModel,null,2);
