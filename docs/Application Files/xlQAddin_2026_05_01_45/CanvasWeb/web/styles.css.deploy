#headerSettings>summary,#textBodySettings>summary{margin-bottom:12px}.header-emphasis{display:flex;gap:12px;flex-wrap:wrap;margin:4px 0 10px}.header-emphasis label{margin:0}
#filtersPanel .canvas-filter-row select,#filtersPanel .canvas-filter-row input,#filtersPanel .canvas-filter-row button{font-size:11px;padding:6px 8px}#filtersPanel>[data-action="addFilter"],#filtersPanel>[data-action="applyFilters"],#filtersPanel>[data-action="addTileFilter"],#filtersPanel>[data-action="applyTileFilters"]{font-size:11px;padding:6px 9px}
#filtersPanel>[data-action="applyFilters"],#filtersPanel>[data-action="applyTileFilters"]{color:#fff}
.chart-small-multiples{gap:var(--multiple-gap,8px)}
.palette-colors{display:flex;flex-wrap:wrap;gap:7px;margin:8px 0 10px}.palette-color{position:relative;display:inline-block}.palette-color input{width:40px;height:34px;padding:2px}.palette-color button{position:absolute;right:-5px;top:-7px;width:17px;height:17px;padding:0;border-radius:50%;font-size:12px;line-height:14px}.palette-actions{display:flex;gap:6px;flex-wrap:wrap}.palette-actions button{font-size:11px;padding:6px 8px}#canvasThemeProperties{margin:8px 0 18px;padding:10px;border:1px solid #dce3ec;border-radius:8px;background:#f4f7fb}#canvasThemeProperties summary{margin-bottom:11px}
#themeBindings .theme-color-row{margin:14px 0}
#themeBindings .theme-color-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:7px;min-height:30px}
#themeBindings .theme-color-heading>label{margin:0}
#themeBindings .theme-color-toggle{position:relative;display:inline-flex;align-items:center;gap:8px;margin:0;cursor:pointer;flex:none;font-size:12px;color:#344054}
#themeBindings .theme-color-toggle input{position:absolute;width:1px;height:1px;padding:0;margin:0;opacity:0}
#themeBindings .theme-switch-track{display:inline-block;position:relative;width:42px;height:24px;background:#cdd5df;border:1px solid #bdc7d3;border-radius:14px;transition:background .15s}
#themeBindings .theme-switch-track::after{content:'';position:absolute;width:20px;height:20px;left:1px;top:1px;border-radius:50%;background:#fff;box-shadow:0 1px 3px #18223026;transition:transform .15s}
#themeBindings [role=switch]:checked+.theme-switch-track{background:#65c66a;border-color:#65c66a}
#themeBindings [role=switch]:checked+.theme-switch-track::after{transform:translateX(18px)}
#themeBindings [role=switch]:focus-visible+.theme-switch-track{outline:2px solid #4f6ee8;outline-offset:3px}
#themeBindings .theme-color-row>input[type=color]{display:block;width:100%;height:40px;margin:0;padding:4px;border:1px solid #cdd5df;border-radius:8px;background:white}
#themeBindings .theme-color-row>input[type=color]:disabled{opacity:.65;cursor:default}
@media(prefers-reduced-motion:reduce){#themeBindings .theme-switch-track,#themeBindings .theme-switch-track::after{transition:none}}
.toolbar #sourcesMenu button{font-size:inherit}
.manual-source-badge{background:#e5f3ee!important;color:#247254!important;border:1px solid #c7e5d8}
.update-menu-wrap #updateMenu{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;width:320px;padding:6px}
.update-menu-wrap #updateMenu.hidden{display:none}
.update-menu-wrap #updateMenu button{margin:0;min-width:0;height:100%;align-items:flex-start}
@media print {
  body { background:white!important; height:auto!important; overflow:visible!important; }
  body * { visibility:hidden!important; }
  #canvas,#canvas * { visibility:visible!important; }
  .app-header,.toolbar,.left-panel,.right-panel,.pane-splitter,.status-bar { display:none!important; }
  main,.workspace,#canvasViewport { position:static!important; display:block!important; overflow:visible!important; height:auto!important; margin:0!important; padding:0!important; }
  #canvas { position:absolute!important; left:0!important; top:0!important; margin:0!important; transform:none!important; border:0!important; box-shadow:none!important; }
  #canvas .resize-handle,#canvas .graphic-handle,#canvas .alignment-guide,#canvas .selection-box { display:none!important; }
  #canvas .selected { outline:none!important; }
}
.pdf-export-pages { display:none; }
@media print {
  body.pdf-export main { display:none!important; }
  body.pdf-export .pdf-export-pages,body.pdf-export .pdf-export-pages * { visibility:visible!important; }
  body.pdf-export .pdf-export-pages { display:block!important; margin:0; padding:0; }
  .pdf-export-page { position:relative; overflow:hidden; break-after:page; break-inside:avoid; }
  .pdf-export-page:last-child { break-after:auto; }
  .pdf-export-canvas .resize-handle,.pdf-export-canvas .graphic-handle,.pdf-export-canvas .alignment-guide,.pdf-export-canvas .selection-box { display:none!important; }
}
