.tile-line,.connector-object{background:transparent!important;border:0;box-shadow:none;overflow:visible}.tile-rectangle{box-shadow:none;overflow:visible}.tile-line .tile-header,.tile-rectangle .tile-header{display:none}.tile-line .tile-body,.tile-rectangle .tile-body{padding:0;overflow:visible;cursor:move}.graphic-svg{display:block;width:100%;height:100%;overflow:visible}.connector-object{pointer-events:none;min-width:0;min-height:0}.connector-object svg{width:100%;height:100%;overflow:visible}.connector-path{fill:none;pointer-events:stroke}.connector-hit{fill:none;stroke:transparent;stroke-width:14;pointer-events:stroke;cursor:pointer}.connector-endpoint{fill:#fff;stroke:#2878df;stroke-width:2;pointer-events:all;cursor:crosshair}.connector-object.selected .connector-path{filter:drop-shadow(0 0 2px #2878df)}
