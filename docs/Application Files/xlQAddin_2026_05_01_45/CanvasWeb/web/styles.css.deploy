.source-list{display:grid;gap:5px;margin:6px 0}.source-item{display:grid;grid-template-columns:18px 1fr auto;align-items:center;gap:6px;width:100%;padding:7px 9px;text-align:left;background:#fff;border:1px solid #d5dce8;border-radius:7px;color:#263450}.source-item b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-item small{font-size:10px;color:#74819a}.source-item.active{border-color:#6381ee;background:#eef2ff;color:#2446b8}.source-actions{display:flex;gap:5px;margin:0 0 12px}.source-actions button{flex:1;padding:5px 7px;font-size:11px}
