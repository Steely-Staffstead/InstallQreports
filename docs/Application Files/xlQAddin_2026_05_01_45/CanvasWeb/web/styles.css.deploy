.svg-dialog{width:min(760px,92vw);height:min(850px,90vh);min-width:520px;min-height:420px;max-width:96vw;max-height:94vh;resize:both;overflow-x:hidden;overflow-y:auto}.svg-dialog form{min-width:0;max-width:100%}.svg-dialog textarea{width:100%;font-family:Consolas,monospace;resize:vertical}.svg-tool-section{max-width:100%;margin:12px 0;border:1px solid #d7dfec;border-radius:10px;background:#fff}.svg-tool-section>summary{padding:12px 14px;color:#344054;font-weight:700;cursor:pointer;user-select:none}.svg-tool-section[open]>summary{border-bottom:1px solid #e7ebf2}.svg-tool-section>.svg-builder,.svg-tool-section>label,.svg-tool-section>.svg-manual-help,.svg-tool-section>.parameter-tooltip,.svg-tool-section>button{margin:12px 14px}.svg-tool-section>label{display:block}.svg-dialog .svg-preview{display:grid;place-items:center;min-height:180px;margin:12px 0;padding:12px;border:1px solid #d7dfec;border-radius:10px;background:#f8faff}.svg-dialog .svg-preview svg{width:180px;height:180px}.dialog-actions{display:flex;justify-content:flex-end;align-items:center;gap:8px}.dialog-actions .dialog-spacer{flex:1}.danger-button{color:#a33b31;border-color:#e4b7b1}
.parameter-tooltip{margin:6px 0;padding:8px 10px;border:1px solid #aebbe4;border-radius:8px;background:#f2f5ff;color:#344054;font-size:12px;line-height:1.45}.rich-parameter-tooltip{position:relative}
.svg-template-picker{display:grid;gap:6px;margin-top:10px;font-weight:600}.svg-template-description{margin:8px 0 12px;padding:10px 12px;border-left:4px solid #6675e8;border-radius:6px;background:#f2f5ff;color:#475467;line-height:1.4}.svg-builder{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:0;margin:0;background:#fff}.svg-builder fieldset{display:grid;align-content:start;gap:10px;min-width:0;margin:0;padding:12px;border:1px solid #e1e6ef;border-radius:9px;background:#f8faff}.svg-builder fieldset:last-child{grid-column:1/-1;grid-template-columns:repeat(2,minmax(0,1fr))}.svg-builder legend{padding:0 6px;color:#344054;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}.svg-builder label{display:grid;gap:5px;color:#475467;font-size:13px}.svg-builder .svg-theme-colors{grid-column:1/-1;display:flex;align-items:center;gap:8px}.svg-builder .svg-theme-colors input{width:auto;margin:0}.svg-builder [hidden]{display:none!important}.svg-builder input,.svg-builder select{width:100%;min-width:0}.svg-builder input[type=color]{height:42px;padding:4px;cursor:pointer}.svg-builder input[type=color]:disabled{cursor:not-allowed;opacity:.5}.svg-option-help{grid-column:1/-1;margin:0;color:#667085;font-size:12px;line-height:1.4}.svg-manual-help{padding:9px 11px;border-radius:8px;background:#f2f5ff;color:#475467}@media(max-width:620px){.svg-dialog{min-width:300px}.svg-builder{grid-template-columns:1fr}.svg-builder fieldset:last-child{grid-column:auto;grid-template-columns:1fr}}
.tile-svgGraphic .tile-body{position:relative;padding:0!important;overflow:hidden!important;display:block!important;width:100%;height:100%;white-space:normal}
.tile-svgGraphic .tile-header{display:none!important}
.tile-svgGraphic .tile-body svg{position:absolute;inset:0;display:block;width:100%!important;height:100%!important;max-width:none;max-height:none;margin:0}
.svg-graphic-properties{display:grid;gap:10px;min-width:0}
.svg-graphic-properties.hidden{display:none}
.svg-graphic-properties details{border:1px solid #d5dded;border-radius:10px;padding:8px;min-width:0}
.svg-graphic-properties summary{font-weight:700;cursor:pointer}
.svg-graphic-properties details>label,.svg-graphic-properties>label{display:block;margin:8px 0}
.svg-graphic-properties input,.svg-graphic-properties select,.svg-graphic-properties textarea{box-sizing:border-box;width:100%;max-width:100%}
.svg-graphic-properties textarea{font-family:Consolas,monospace;resize:vertical}
.chart-type-control output{display:block;width:100%;margin-top:5px;padding:8px;border:1px solid #cdd5df;border-radius:7px;background:#f3f6f9;color:#475467;text-transform:capitalize}
html[data-qreports-theme] .app-header .brand strong{color:var(--qreports-header-text)}
html[data-qreports-theme] .app-header .brand small{color:var(--qreports-header-text);opacity:.85}
html[data-qreports-theme] .app-header .file-actions button:not(.primary){color:var(--qreports-header-text);border-color:currentColor;background:transparent}
html[data-qreports-theme] .app-header .file-actions button:not(.primary):hover{background:#00000012}
html[data-qreports-theme] .app-header .file-actions button.primary{color:#fff}
.matrix-conditional-cell{display:block;margin:-6px -8px;padding:6px 8px;min-height:100%}
.matrix-conditional-icon{display:inline-block;width:1.3em;margin-right:.25em;text-align:center;font-weight:700;vertical-align:baseline}
