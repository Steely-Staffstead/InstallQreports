:root{font-family:Inter,"Segoe UI",system-ui,sans-serif;color:#182230;background:#edf1f5}*{box-sizing:border-box}body{margin:0;height:100vh;overflow:hidden}button,input,textarea,select{font:inherit}button,.file-button{border:1px solid #cdd5df;border-radius:7px;background:#fff;color:#344054;padding:7px 11px;cursor:pointer}button:hover,.file-button:hover{background:#f3f6f9;border-color:#98a5b3}.hidden{display:none!important}.app-header{height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;color:#fff;background:linear-gradient(110deg,#15253d,#1d4070)}.brand{display:flex;gap:11px;align-items:center}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:#4f8ee8;font-size:20px;font-weight:800}.brand strong,.brand small{display:block}.brand small{color:#cbd9ed}.file-actions{display:flex;gap:7px}.file-actions button{background:#ffffff14;color:#fff;border-color:#ffffff38}.file-actions .primary{background:#4c8de8}.commandbar{height:72px;display:flex;align-items:stretch;padding:6px 14px;background:#fff;border-bottom:1px solid #d7dee7;box-shadow:0 2px 6px #1822300b;z-index:10;position:relative}.command-group{display:flex}.command{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-width:76px;border:0;background:transparent;padding:4px 10px}.command span{font-size:23px;line-height:25px;color:#275c9c}.command b{font-size:12px;font-weight:600}.command.accent span{color:#16844a}.command.danger span{color:#a83b32}.separator{width:1px;background:#e0e5eb;margin:8px}.command-spacer{flex:1}.badge{align-self:center;background:#edf3fb;color:#285a97;border-radius:12px;padding:5px 10px;font-size:12px}.add-menu{position:relative}.menu{position:absolute;top:62px;left:0;display:grid;grid-template-columns:1fr 1fr;width:245px;padding:8px;gap:5px;background:#fff;border:1px solid #d4dce5;border-radius:9px;box-shadow:0 10px 28px #10182830}.menu button{text-align:left;font-size:18px}.menu button span{font-size:13px;margin-left:7px}main{display:grid;grid-template-columns:205px minmax(520px,1fr)285px;height:calc(100vh - 130px)}.left-panel,.right-panel{background:#f9fafb;padding:16px;overflow:auto}.left-panel{border-right:1px solid #d9e0e7}.right-panel{border-left:1px solid #d9e0e7}.panel-title{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#667085;margin-bottom:16px}label{display:block;color:#475467;font-size:12px;margin-bottom:12px}input[type=text],input[type=number],select,textarea{width:100%;margin-top:5px;padding:8px;border:1px solid #cdd5df;border-radius:7px;background:#fff}.section-heading{display:flex;align-items:center;justify-content:space-between;margin:18px 0 8px;font-weight:650}.icon-button{padding:1px 8px;font-size:18px}.page-list{display:grid;gap:5px}.page-item{text-align:left;width:100%}.page-item.active{color:#174e9d;border-color:#8ab4ee;background:#eaf2fd;font-weight:650}.query-summary{margin-top:22px;padding:12px;background:#eef3f9;border-radius:8px;font-size:12px}.query-summary dl{display:grid;grid-template-columns:70px 1fr;gap:6px;margin:10px 0 0}.query-summary dt{color:#667085}.query-summary dd{margin:0;overflow:hidden;text-overflow:ellipsis}.workspace{min-width:0;display:grid;grid-template-rows:1fr 31px}.canvas{position:relative;overflow:auto;min-width:900px;min-height:620px;background-color:#e8edf2;background-image:linear-gradient(#dce3ea 1px,transparent 1px),linear-gradient(90deg,#dce3ea 1px,transparent 1px);background-size:20px 20px}.empty-state{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#738092;gap:7px}.empty-state b{font-size:20px;color:#465466}.empty-state button{margin-top:8px}.tile{position:absolute;display:flex;flex-direction:column;background:#fff;border:1px solid #cbd5e1;border-radius:5px;box-shadow:0 2px 8px #1822301c;overflow:hidden;min-width:100px;min-height:70px}.tile.selected{outline:2px solid #2878df;outline-offset:2px}.tile-header{height:34px;flex:none;display:flex;align-items:center;padding:0 10px;font-size:13px;font-weight:650;background:#f3f6fa;border-bottom:1px solid #dbe2e9;cursor:move;user-select:none}.tile-kind{margin-left:auto;color:#8090a2;font-size:10px;text-transform:uppercase}.tile-body{flex:1;min-height:0;padding:12px;overflow:auto}.tile-card .tile-body{display:grid;place-content:center;text-align:center}.card-value{font-size:30px;font-weight:700;color:#1d4f8f}.tile-text .tile-body{white-space:pre-wrap}.tile-picture .tile-body{padding:0;display:grid;place-items:center;background:#edf1f5}.tile-picture img{width:100%;height:100%;object-fit:contain}.picture-placeholder{color:#8190a0}.data-table{width:100%;border-collapse:collapse;font-size:12px}.data-table th,.data-table td{padding:6px 8px;border-bottom:1px solid #e1e6ec;text-align:left;white-space:nowrap}.data-table th{background:#f5f7fa;position:sticky;top:0}.matrix-label{font-weight:650;background:#f5f7fa}.simple-chart{height:calc(100% - 18px);display:flex;align-items:flex-end;gap:8px;padding:12px}.chart-bar{flex:1;min-width:12px;background:linear-gradient(#4f91e8,#2867bb);border-radius:3px 3px 0 0;position:relative}.chart-bar span{position:absolute;bottom:-18px;left:0;right:0;text-align:center;font-size:9px;overflow:hidden}.statusbar{display:flex;justify-content:space-between;align-items:center;padding:0 12px;font-size:12px;color:#667085;background:#fff;border-top:1px solid #d9e0e7}.property-empty{color:#7b8795;font-size:13px}.property-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 8px}.check{display:flex;gap:7px;align-items:center}.check input{margin:0}input[type=color]{width:100%;height:35px;border:1px solid #cdd5df;border-radius:6px}details{margin-top:22px;border-top:1px solid #dde3e9;padding-top:12px}summary{font-size:12px;font-weight:700;color:#526071;cursor:pointer}#jsonEditor{height:240px;font:11px/1.4 Consolas,monospace}.json-actions{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.file-button input{display:none}.error{color:#b42318;font-size:12px}.busy::after{content:"";position:fixed;inset:130px 0 0;background:#ffffff80;z-index:30}.busy::before{content:"Opening legacy editor…";position:fixed;z-index:31;left:50%;top:50%;transform:translate(-50%,-50%);padding:15px 22px;background:#182a43;color:#fff;border-radius:9px}@media(max-width:1050px){main{grid-template-columns:175px 1fr}.right-panel{display:none}}
.chart-web-surface{position:relative;width:100%;height:100%;min-height:180px}.chart-web-svg{display:block;width:100%;height:100%;font-family:Segoe UI,Arial,sans-serif}.chart-title{fill:#253653;font-size:20px;font-weight:700}.chart-grid{stroke:#dfe5ee}.chart-axis{stroke:#73809a;stroke-width:1.2}.chart-axis-label,.chart-legend{fill:#65718a;font-size:11px}.chart-value-label{fill:#42516b;font-size:10px;font-weight:600}.chart-total,.gauge-value{fill:#253653;font-size:18px;font-weight:700}.treemap-label{fill:#fff;font-size:12px;font-weight:700}.treemap-value{fill:#ffffffd9;font-size:10px}.chart-web-empty{height:100%;display:grid;place-content:center;gap:6px;text-align:center;color:#7a869e}.chart-web-warning{position:absolute;right:8px;bottom:6px;padding:5px 8px;border-radius:5px;background:#fff4ce;color:#725500;font-size:11px}
.chart-data-label{fill:#344054;font-weight:600;paint-order:stroke;stroke:#fff;stroke-width:2px;stroke-linejoin:round}.chart-group-label{fill:#526071;font-size:11px;font-weight:700}.treemap-group-label{fill:#fff;font-size:12px;font-weight:800;paint-order:stroke;stroke:#0005;stroke-width:2px}
.chart-title[data-chart-action]{cursor:move}.chart-legend-control{cursor:pointer}.chart-margin-controls line{stroke:transparent;stroke-width:14;pointer-events:stroke}.chart-margin-controls line[data-margin-handle="left"],.chart-margin-controls line[data-margin-handle="right"]{cursor:ew-resize}.chart-margin-controls line[data-margin-handle="top"],.chart-margin-controls line[data-margin-handle="bottom"]{cursor:ns-resize}.chart-margin-controls line:hover{stroke:#5d7fe3;stroke-opacity:.42;stroke-dasharray:5 4}
