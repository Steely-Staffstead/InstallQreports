const $=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let connections=[],endpoints=[],pending=new Map(),seq=0,lastRaw='',currentEndpoint=null,pathSelection=null,manualJson=false;const expandedConnections=new Set();let resultView={data:{columns:[],rows:[]},sortIndex:-1,sortDirection:0,hidden:new Set(),formats:new Map(),widths:new Map()};
document.addEventListener('DOMContentLoaded',()=>{const base=$('baseUrl'),label=document.createElement('label');label.innerHTML='Comment<textarea id="connectionComment" rows="3" placeholder="Notes about this API connection"></textarea>';base.closest('label').before(label);const selectBase=selectConnection,newBase=newConnection,objectBase=connectionObject;selectConnection=c=>{selectBase(c);$('connectionComment').value=c?.Comment||c?.comment||''};newConnection=()=>{newBase();$('connectionComment').value=''};connectionObject=()=>({...objectBase(),Comment:$('connectionComment').value.trim()})});
function post(type,payload={}){return new Promise((resolve,reject)=>{const requestId=`api-${++seq}`;pending.set(requestId,{resolve,reject});chrome.webview.postMessage({type,requestId,...payload})})}function toast(s){$('toast').textContent=s;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',2200)}
chrome.webview.addEventListener('message',e=>{const m=e.data;if(m.type==='bridgeResult'){const p=pending.get(m.requestId);if(!p)return;pending.delete(m.requestId);if(m.action==='api-run'&&m.result)p.resolve(m.result);else m.result?.ok?p.resolve(m.result):p.reject(new Error(m.result?.error||'Operation failed'))}else if(m.type==='hostError')toast(m.message)});window.addEventListener('DOMContentLoaded',()=>{chrome.webview.postMessage({type:'ready'});bind();setupApiActions();setupExcludedPicker();load()});
function kvRow(v={Enabled:true,Key:'',Value:'',Comment:''}){const row=document.createElement('div');row.className='kv-row';row.innerHTML=`<input type="checkbox" ${v.Enabled!==false?'checked':''}><input placeholder="Key" value="${esc(v.Key)}"><input placeholder="Value" value="${esc(v.Value)}"><button title="Remove">×</button>`;row.lastElementChild.onclick=()=>row.remove();return row}function addRow(id,v){$(id).append(kvRow(v))}function readRows(id){return [...$(id).children].map(r=>({Enabled:r.children[0].checked,Key:r.children[1].value,Value:r.children[2].value,Comment:''})).filter(x=>x.Key||x.Value)}function setRows(id,items){$(id).innerHTML='';(items?.length?items:[{}]).forEach(x=>addRow(id,x))}
async function load(){try{const r=await post('apiBootstrap');connections=r.connections||[];endpoints=r.endpoints||[];renderLibrary();renderConnections();if(!connections.length)newRequest()}catch(e){toast(e.message)}}function renderConnections(){const value=$('connection').value;$('connection').innerHTML=connections.map(c=>`<option>${esc(c.Name)}</option>`).join('');if(connections.some(c=>c.Name===value))$('connection').value=value;else if(connections[0])selectConnection(connections[0])}
function renderLibrary(){const q=$('search').value.trim().toLowerCase();$('libraryList').innerHTML=connections.map(c=>{const connectionMatch=c.Name.toLowerCase().includes(q);const matching=endpoints.filter(e=>e.ConnectionName===c.Name&&(!q||connectionMatch||e.Name.toLowerCase().includes(q)||String(e.RelativePath||'').toLowerCase().includes(q)));if(q&&!connectionMatch&&!matching.length)return'';const open=!!q||expandedConnections.has(c.Name);return`<div class="library-connection ${open?'expanded':''}"><button class="connection-toggle" data-toggle-connection="${esc(c.Name)}"><span class="connection-chevron">${open?'▾':'▸'}</span><span>${esc(c.Name)}</span><small>${matching.length}</small></button><div class="library-endpoints ${open?'':'hidden'}">${matching.map(e=>`<button class="library-endpoint" data-endpoint="${esc(c.Name)}|${esc(e.Name)}"><span class="method">${esc(e.Method)}</span><span>${esc(e.Name)}</span></button>`).join('')}</div></div>`}).join('');document.querySelectorAll('[data-toggle-connection]').forEach(b=>b.onclick=()=>{const name=b.dataset.toggleConnection;expandedConnections.has(name)?expandedConnections.delete(name):expandedConnections.add(name);selectConnection(connections.find(c=>c.Name===name));renderLibrary()});document.querySelectorAll('[data-endpoint]').forEach(b=>{b.onclick=()=>{const [c,n]=b.dataset.endpoint.split('|');expandedConnections.add(c);selectEndpoint(endpoints.find(e=>e.ConnectionName===c&&e.Name===n))};b.oncontextmenu=event=>{event.preventDefault();event.stopPropagation();const [c,n]=b.dataset.endpoint.split('|'),endpoint=endpoints.find(item=>item.ConnectionName===c&&item.Name===n);if(!endpoint)return;selectEndpoint(endpoint);const menu=$('columnMenu');menu.innerHTML='<div class="menu-title">'+esc(endpoint.Name)+'</div><button data-run-api>▶ Run API</button>';menu.style.left=`${Math.min(event.clientX,innerWidth-230)}px`;menu.style.top=`${Math.min(event.clientY,innerHeight-100)}px`;menu.classList.remove('hidden');menu.querySelector('[data-run-api]').onclick=()=>{hideColumnMenu();run()};};})}
function selectConnection(c){if(!c)return;$('connection').value=c.Name;$('connectionName').value=c.Name;$('baseUrl').value=c.BaseUrl||'';$('timeout').value=c.TimeoutSeconds||100;$('defaultHeaders').value=JSON.stringify(c.DefaultHeaders||{},null,2);const a=c.Auth||{};$('authKind').value=a.Kind??0;$('secretRef').value=a.SecretRef||'';$('keyName').value=a.KeyName||'';$('keyLocation').value=a.Location??0;$('workflowSecretRef').value=a.WorkflowSecretRef||'';['singleSecretValue','basicSecretUsername','basicSecretPassword','clientId','clientSecret','workflowUsername','workflowPassword'].forEach(id=>$(id).value='');setWorkflow(a.Workflow||{});toggleAuth()}
function selectEndpoint(e){if(!e)return;currentEndpoint=e;$('connection').value=e.ConnectionName;selectConnection(connections.find(c=>c.Name===e.ConnectionName));$('endpointName').value=e.Name;$('method').value=e.Method||'GET';$('path').value=e.RelativePath||'';setRows('headerRows',e.Headers);setRows('queryRows',e.Query);setRows('formRows',e.FormFields);$('bodyMode').value=e.BodyMode??1;$('rawFormat').value=e.RawFormat??0;$('bodyText').value=e.BodyText||'';$('contentType').value=e.ContentType||'application/json';$('graphql').value=e.GraphQLQuery||'';$('variables').value=e.GraphQLVariables||'';const f=e.Flatten||{};$('flattenPath').value=f.PreferArrayProperty||e.PreferArrayProperty||'value';$('maxRows').value=f.MaxRows||1000;$('postFilter').value=e.PostFilterText||'';$('excluded').value=formatColumnList(e.ExcludedColumns||[]);$('aliases').value=(e.ColumnAliases||[]).map(x=>`${x.SourceName}=${x.AliasName}`).join('\n');setPaging(e.Pagination||{});setLoop(e.LoopSpec||{});toggleBody();document.querySelectorAll('.library-endpoint').forEach(x=>x.classList.toggle('active',x.dataset.endpoint===`${e.ConnectionName}|${e.Name}`))}
function newRequest(){currentEndpoint=null;$('endpointName').value='AdhocEndpoint';$('method').value='GET';$('path').value='';setRows('headerRows');setRows('queryRows');setRows('formRows');$('bodyText').value='';$('graphql').value='';$('variables').value='';$('raw').textContent='';$('grid').innerHTML='';$('submitted').textContent='';$('jsonRequest').textContent='';resultView={data:{columns:[],rows:[]},sortIndex:-1,sortDirection:0,hidden:new Set(),formats:new Map(),widths:new Map()};if(connections[0])selectConnection(connections[0]);toggleBody()}
function newConnection(){currentEndpoint=null;$('connectionName').value='';$('baseUrl').value='';$('timeout').value=100;$('defaultHeaders').value='{}';$('authKind').value=0;$('secretRef').value='';$('keyName').value='';$('keyLocation').value=0;$('workflowSecretRef').value='';setWorkflow({});toggleAuth();$('connectionName').focus()}
function setupApiActions(){$('secrets').onclick=()=>chrome.webview.postMessage({type:'openSecretsWindow'});$('newConnection').onclick=newConnection;$('saveConnection').onclick=async()=>{try{const connection=connectionObject();await post('apiSaveConnection',{connection,secrets:secretValues(connection)});toast('Connection and secure credentials saved');await load();$('connection').value=connection.Name;selectConnection(connections.find(item=>item.Name===connection.Name))}catch(e){toast(e.message)}};$('testToken').onclick=async()=>{try{const connection=connectionObject(),r=await post('apiTestToken',{connection,secrets:secretValues(connection)});toast(r.message)}catch(e){toast(e.message)}};$('duplicateEndpoint').onclick=()=>{const original=$('endpointName').value.trim()||'API';currentEndpoint=null;$('endpointName').value=`${original} copy`;$('endpointName').focus();toast('Choose a connection if needed, then Save API')};$('moveEndpoint').onclick=async()=>{try{if(!currentEndpoint)return toast('Select a saved API first.');const sourceConnection=currentEndpoint.ConnectionName,sourceName=currentEndpoint.Name,target=endpointObject();if(target.ConnectionName===sourceConnection)return toast('Choose a different connection first.');await post('apiSaveEndpoint',{endpoint:target});await post('apiDeleteEndpoint',{connectionName:sourceConnection,name:sourceName});currentEndpoint=target;await load();expandedConnections.add(target.ConnectionName);renderLibrary();selectEndpoint(endpoints.find(item=>item.ConnectionName===target.ConnectionName&&item.Name===target.Name));toast('API moved')}catch(e){toast(e.message)}}}
function objectRows(value){return Object.entries(value||{}).map(([Key,Value])=>({Enabled:true,Key,Value}))}function workflow(){return{TokenUrl:$('tokenUrl').value,GrantType:+$('grantType').value,Scope:$('scope').value,Audience:$('audience').value,ExtraParams:dict(readRows('workflowParamRows')),ExtraHeaders:dict(readRows('workflowHeaderRows')),AccessTokenJsonField:$('tokenPath').value||'access_token',ExpiresInJsonField:$('expiresPath').value||'expires_in',RequestMode:+$('wfRequestMode').value,RequestSpecJson:$('requestSpec').value,TokenJsonPath:$('tokenPath').value,ApplyMode:+$('applyMode').value,BasicUsername:$('basicUsername').value,OutputHeaderName:$('outputHeader').value,OutputPrefix:$('outputPrefix').value,OutputQueryName:$('outputQuery').value}}function setWorkflow(w){$('tokenUrl').value=w.TokenUrl||'';$('grantType').value=w.GrantType??0;$('scope').value=w.Scope||'';$('audience').value=w.Audience||'';$('wfRequestMode').value=w.RequestMode??0;$('requestSpec').value=w.RequestSpecJson||'';$('tokenPath').value=w.TokenJsonPath||w.AccessTokenJsonField||'access_token';$('expiresPath').value=w.ExpiresInJsonField||'expires_in';$('applyMode').value=w.ApplyMode??0;$('basicUsername').value=w.BasicUsername||'';$('outputHeader').value=w.OutputHeaderName||'Authorization';$('outputPrefix').value=w.OutputPrefix??'Bearer ';$('outputQuery').value=w.OutputQueryName||'';setRows('workflowParamRows',objectRows(w.ExtraParams));setRows('workflowHeaderRows',objectRows(w.ExtraHeaders))}
function connectionObject(){let headers={};try{headers=JSON.parse($('defaultHeaders').value||'{}')}catch{throw new Error('Default headers must be valid JSON.');}const name=$('connectionName').value.trim();if(!name)throw new Error('Connection name is required.');const kind=+$('authKind').value,suffix=kind===1?'apikey':kind===2?'func':kind===3?'bearer':kind===5?'basic':'token',secretRef=$('secretRef').value.trim()||(kind&&kind!==4?`conn:${name}:${suffix}`:''),workflowRef=$('workflowSecretRef').value.trim()||(kind===4?`conn:${name}:tokenwf`:'');$('secretRef').value=secretRef;$('workflowSecretRef').value=workflowRef;return{Name:name,BaseUrl:$('baseUrl').value.trim(),TimeoutSeconds:+$('timeout').value||100,DefaultHeaders:headers,Auth:{Kind:kind,KeyName:$('keyName').value,Location:+$('keyLocation').value,SecretRef:secretRef,Workflow:workflow(),WorkflowSecretRef:workflowRef}}}function secretValues(connection){const result={},kind=connection.Auth.Kind,single=$('singleSecretValue').value;if(single&&(kind===1||kind===2||kind===3))result.primary=single;if((kind===5)&&($('basicSecretUsername').value||$('basicSecretPassword').value))result.basic={Username:$('basicSecretUsername').value,Password:$('basicSecretPassword').value};if(kind===4&&['clientId','clientSecret','workflowUsername','workflowPassword'].some(id=>$(id).value))result.workflow={ClientId:$('clientId').value,ClientSecret:$('clientSecret').value,Username:$('workflowUsername').value,Password:$('workflowPassword').value};return result}function paging(){return{Enabled:$('pagingEnabled').checked,Type:+$('pagingType').value,DataProperty:$('dataProperty').value,NextLinkProperty:$('nextLink').value,OffsetParam:$('offsetParam').value,LimitParam:$('limitParam').value,StartOffset:+$('startOffset').value||0,PageSize:+$('pageSize').value||100,MaxPages:+$('maxPages').value||100,IncludePageNumber:false}}function loop(){return{Enabled:$('loopEnabled').checked,Connection:$('loopConnection').value,QueryText:$('loopQuery').value,ValueColumn:$('loopColumn').value,TokenName:$('loopToken').value||'value',MaxRequests:+$('maxRequests').value||0,DelayMs:+$('delayMs').value||0,SkipEmptyValues:true,SkipNoReturn:true,IncludeLoopValueColumn:true,LoopValueColumnName:'__loop_value',IncludeLoopIndexColumn:true,LoopIndexColumnName:'__loop_index'}}function aliases(){return $('aliases').value.split(',').map(x=>x.trim()).filter(Boolean).map(x=>{const i=x.indexOf('=');return{SourceName:i<0?x:x.slice(0,i).trim(),AliasName:i<0?x:x.slice(i+1).trim()}})}
function parseAliases(text){
 const result=[];
 for(const line of String(text||'').split(/\r?\n/)){
  const pattern=/\s*([^=]+?)\s*=\s*([^,]+)(?:,|$)/g;
  let match;
  while((match=pattern.exec(line))!==null){
   const SourceName=match[1].trim(),AliasName=match[2].trim();
   if(SourceName&&AliasName)result.push({SourceName,AliasName});
  }
 }
 return result;
}
function parseColumnList(text,knownColumns=[]){
 const input=String(text||'').trim();
 if(!input)return [];
 if(knownColumns.some(name=>name.toLowerCase()===input.toLowerCase()))return [input];
 const result=[];let value='',quoted=false;
 for(let i=0;i<input.length;i++){
  const char=input[i];
  if(char==='"'&&quoted&&input[i+1]==='"'){value+='"';i++}
  else if(char==='"')quoted=!quoted;
  else if(!quoted&&(char===','||char==='\n')){if(value.trim())result.push(value.trim());value=''}
  else if(char!=='\r'||quoted)value+=char;
 }
 if(value.trim())result.push(value.trim());
 return result;
}
function formatColumnList(columns){return columns.map(name=>/[",\r\n]/.test(name)?`"${name.replace(/"/g,'""')}"`:name).join('\n')}
function endpointObject(){return{Name:$('endpointName').value.trim()||'AdhocEndpoint',ConnectionName:$('connection').value,Method:$('method').value,RelativePath:$('path').value,Headers:readRows('headerRows'),Query:readRows('queryRows'),BodyText:$('bodyText').value,ContentType:$('contentType').value,PreferArrayProperty:$('flattenPath').value,BodyMode:+$('bodyMode').value,RawFormat:+$('rawFormat').value,GraphQLQuery:$('graphql').value,GraphQLVariables:$('variables').value,FormFields:readRows('formRows'),ColumnAliases:parseAliases($('aliases').value),ExcludedColumns:parseColumnList($('excluded').value,availableResponseColumns()),Pagination:paging(),LoopSpec:loop(),Flatten:{PreferArrayProperty:$('flattenPath').value||'value',MaxRows:+$('maxRows').value||1000},PostFilterText:$('postFilter').value}}
function dict(rows){return Object.fromEntries(rows.filter(x=>x.Enabled&&x.Key).map(x=>[x.Key,x.Value]))}function spec(){const e=endpointObject();return{Type:'api',Connection:e.ConnectionName,Name:e.Name,Method:e.Method,Path:e.RelativePath,Headers:dict(e.Headers),Query:dict(e.Query),Body:e.BodyMode===1?e.BodyText:'',ContentType:e.ContentType,BodyMode:e.BodyMode,RawFormat:e.RawFormat,GraphQLQuery:e.GraphQLQuery,GraphQLVariables:e.GraphQLVariables,FormFields:dict(e.FormFields),Flatten:e.Flatten,ColumnAliases:e.ColumnAliases,ExcludedColumns:e.ExcludedColumns,PostFilterText:e.PostFilterText,Pagination:e.Pagination,LoopSpec:e.LoopSpec}}
function requestSpec(){if(!manualJson){const generated=spec();$('jsonRequest').textContent=JSON.stringify(generated,null,2);return generated}const source=$('jsonRequest').textContent.trim();if(!source)throw new Error('Manual JSON request is empty.');try{return JSON.parse(source)}catch(e){throw new Error(`Manual JSON request is invalid: ${e.message}`)}}
function setManualJson(enabled){manualJson=enabled;const editor=$('jsonRequest'),button=$('manualJson');if(enabled&&!editor.textContent.trim())editor.textContent=JSON.stringify(spec(),null,2);editor.contentEditable=enabled?'true':'false';button.classList.toggle('active',enabled);button.textContent=`Manual JSON: ${enabled?'on':'off'}`;if(!enabled)editor.textContent=JSON.stringify(spec(),null,2);document.querySelector('[data-response="jsonRequest"]').click();if(enabled)editor.focus()}
function selectResponse(name){document.querySelector(`[data-response="${name}"]`)?.click()}
function requestPreview(s){const connection=s.BaseUrl?null:connections.find(item=>item.Name===s.Connection),base=String(s.BaseUrl||connection?.BaseUrl||'').replace(/\/$/,''),path=String(s.Path||'').replace(/^\//,''),query=new URLSearchParams(s.Query||{}).toString(),lines=[`${s.Method||'GET'} ${base}${path?`/${path}`:''}${query?`?${query}`:''}`,'','HEADERS','-------'];Object.entries({...connection?.DefaultHeaders,...s.Headers}).forEach(([key,value])=>lines.push(`${key}: ${value}`));if(s.Body||s.GraphQLQuery||Object.keys(s.FormFields||{}).length){lines.push('','BODY','----',s.Body||s.GraphQLQuery||new URLSearchParams(s.FormFields).toString())}return lines.join('\n')}
async function run(){try{$('status').textContent='Sending…';const s=requestSpec();$('submitted').textContent=requestPreview(s);const r=await post('apiRun',{spec:s});if(r.submittedRequest)$('submitted').textContent=r.submittedRequest;lastRaw=r.raw||'';$('raw').textContent=formatMaybe(lastRaw);setResult(r.data);$('responseSummary').textContent=`${r.statusCode||''} ${r.reason||''} · ${(r.data?.rows||[]).length} rows · ${r.durationMs||0} ms${r.pageCount?` · ${r.pageCount} pages`:''}`;$('status').textContent=r.ok===false?'Error':'Ready';selectResponse(r.ok===false?'raw':'grid');if(r.ok===false)toast(r.error||r.reason||'The API request failed.')}catch(e){$('status').textContent='Error';$('responseSummary').textContent=e.message;$('raw').textContent=e.message;selectResponse('raw');toast(e.message)}}
function columnName(column){return typeof column==='string'?column:column?.name||''}function rowValues(row,columns){return Array.isArray(row)?row:columns.map(column=>row?.[columnName(column)])}function formatValue(value,format){if(value==null)return'';const number=Number(value);if(format==='number')return Number.isFinite(number)?number.toLocaleString(undefined,{maximumFractionDigits:2}):value;if(format==='integer')return Number.isFinite(number)?number.toLocaleString(undefined,{maximumFractionDigits:0}):value;if(format==='percent')return Number.isFinite(number)?number.toLocaleString(undefined,{style:'percent',maximumFractionDigits:2}):value;if(format==='excel-date'&&Number.isFinite(number)){const date=new Date(Date.UTC(1899,11,30)+number*86400000);return date.toLocaleDateString()}if(format==='date'){const date=new Date(value);return Number.isNaN(date.valueOf())?value:date.toLocaleDateString()}return value}
function setResult(data){resultView={data:data||{columns:[],rows:[]},sortIndex:-1,sortDirection:0,hidden:new Set(),formats:new Map(),widths:new Map()};renderGrid()}
function renderGrid(){const d=resultView.data,columns=d?.columns||[],source=d?.rows||[];if(!columns.length){$('grid').innerHTML='<p style="padding:14px">No tabular records returned.</p>';return}const indexed=source.map((row,index)=>({row,index}));if(resultView.sortIndex>=0&&resultView.sortDirection)indexed.sort((a,b)=>{const av=rowValues(a.row,columns)[resultView.sortIndex],bv=rowValues(b.row,columns)[resultView.sortIndex],an=Number(av),bn=Number(bv),cmp=Number.isFinite(an)&&Number.isFinite(bn)?an-bn:String(av??'').localeCompare(String(bv??''),undefined,{numeric:true});return cmp*resultView.sortDirection||a.index-b.index});const visible=columns.map((column,index)=>({column,index})).filter(x=>!resultView.hidden.has(x.index));$('grid').innerHTML=`<table><colgroup>${visible.map(x=>`<col style="width:${resultView.widths.get(x.index)||160}px">`).join('')}</colgroup><thead><tr>${visible.map(x=>`<th data-column="${x.index}"><span>${esc(columnName(x.column))}</span>${resultView.sortIndex===x.index&&resultView.sortDirection?`<span class="sort-mark">${resultView.sortDirection===1?'▲':'▼'}</span>`:''}<span class="column-resizer"></span></th>`).join('')}</tr></thead><tbody>${indexed.map(entry=>{const values=rowValues(entry.row,columns);return`<tr>${visible.map(x=>`<td>${esc(formatValue(values[x.index],resultView.formats.get(x.index)||'auto'))}</td>`).join('')}</tr>`}).join('')}</tbody></table>`;document.querySelectorAll('#grid th').forEach(th=>{const index=+th.dataset.column;th.onclick=e=>{if(e.target.classList.contains('column-resizer'))return;if(resultView.sortIndex!==index){resultView.sortIndex=index;resultView.sortDirection=1}else if(resultView.sortDirection===1)resultView.sortDirection=-1;else{resultView.sortIndex=-1;resultView.sortDirection=0}renderGrid()};th.oncontextmenu=e=>{e.preventDefault();showColumnMenu(e,index)};th.querySelector('.column-resizer').onpointerdown=e=>startResultColumnResize(e,index)})}
function startResultColumnResize(event,index){event.stopPropagation();const startX=event.clientX,start=resultView.widths.get(index)||160,target=event.currentTarget,visibleIndexes=(resultView.data.columns||[]).map((_,i)=>i).filter(i=>!resultView.hidden.has(i)),col=$('grid').querySelectorAll('col')[visibleIndexes.indexOf(index)];target.setPointerCapture(event.pointerId);const move=e=>{const width=Math.max(60,Math.min(700,start+e.clientX-startX));resultView.widths.set(index,width);if(col)col.style.width=`${width}px`};const stop=()=>{target.removeEventListener('pointermove',move);target.removeEventListener('pointerup',stop);target.removeEventListener('pointercancel',stop)};target.addEventListener('pointermove',move);target.addEventListener('pointerup',stop);target.addEventListener('pointercancel',stop)}
function csvSet(id,name,add){const values=parseColumnList($(id).value,availableResponseColumns()),key=name.toLowerCase(),filtered=values.filter(x=>x.toLowerCase()!==key);if(add)filtered.push(name);$(id).value=formatColumnList(filtered)}function aliasSet(source,alias){const pairs=parseAliases($('aliases').value).filter(x=>x.SourceName.toLowerCase()!==source.toLowerCase());if(alias)pairs.push({SourceName:source,AliasName:alias});$('aliases').value=pairs.map(x=>`${x.SourceName}=${x.AliasName}`).join('\n')}
function showColumnMenu(event,index){const columns=resultView.data.columns||[],name=columnName(columns[index]),menu=$('columnMenu');menu.innerHTML=`<div class="menu-title">${esc(name)}</div><button data-sort="1">Sort ascending</button><button data-sort="-1">Sort descending</button><button data-sort="0">Clear sorting</button><label>Format<select data-format><option value="auto">Auto</option><option value="number">Number</option><option value="integer">Integer</option><option value="percent">Percent</option><option value="date">Date</option><option value="excel-date">Excel serial date</option><option value="text">Text</option></select></label><button data-exclude>Exclude from API result</button><label>Column alias<input type="text" data-alias placeholder="New column name"><button data-save-alias>Save alias</button></label><hr><div class="menu-title">Visible columns</div>${columns.map((c,i)=>`<label><input type="checkbox" data-visible="${i}" ${resultView.hidden.has(i)?'':'checked'}> ${esc(columnName(c))}</label>`).join('')}`;menu.style.left=`${Math.min(event.clientX,innerWidth-260)}px`;menu.style.top=`${Math.min(event.clientY,innerHeight-420)}px`;menu.classList.remove('hidden');menu.querySelector('[data-format]').value=resultView.formats.get(index)||'auto';menu.querySelector('[data-format]').onchange=e=>{resultView.formats.set(index,e.target.value);renderGrid();hideColumnMenu()};menu.querySelectorAll('[data-sort]').forEach(b=>b.onclick=()=>{const direction=+b.dataset.sort;resultView.sortIndex=direction?index:-1;resultView.sortDirection=direction;renderGrid();hideColumnMenu()});menu.querySelector('[data-exclude]').onclick=()=>{csvSet('excluded',name,true);resultView.hidden.add(index);renderGrid();hideColumnMenu();toast(`${name} added to excluded columns`)};menu.querySelector('[data-save-alias]').onclick=()=>{const alias=menu.querySelector('[data-alias]').value.trim();aliasSet(name,alias);hideColumnMenu();toast(alias?`Alias saved: ${name} → ${alias}`:'Alias removed')};menu.querySelectorAll('[data-visible]').forEach(box=>box.onchange=()=>{const i=+box.dataset.visible;box.checked?resultView.hidden.delete(i):resultView.hidden.add(i);if(resultView.hidden.size===columns.length)resultView.hidden.delete(i);renderGrid()})}function hideColumnMenu(){$('columnMenu').classList.add('hidden')}function formatMaybe(s){try{return JSON.stringify(JSON.parse(s),null,2)}catch{return s}}
function setPaging(p){$('pagingEnabled').checked=!!p.Enabled;$('pagingType').value=p.Type??0;$('dataProperty').value=p.DataProperty||'';$('nextLink').value=p.NextLinkProperty||'@odata.nextLink';$('offsetParam').value=p.OffsetParam||'skip';$('limitParam').value=p.LimitParam||'first';$('startOffset').value=p.StartOffset||0;$('pageSize').value=p.PageSize||100;$('maxPages').value=p.MaxPages||100}function setLoop(l){$('loopEnabled').checked=!!l.Enabled;$('loopConnection').value=l.Connection||'';$('loopQuery').value=l.QueryText||'';$('loopColumn').value=l.ValueColumn||'';$('loopToken').value=l.TokenName||'value';$('maxRequests').value=l.MaxRequests||0;$('delayMs').value=l.DelayMs||0}
function toggleBody(){const m=+$('bodyMode').value;$('rawBody').classList.toggle('hidden',m!==1);$('graphBody').classList.toggle('hidden',m!==2);$('formBody').classList.toggle('hidden',m!==3)}function toggleAuth(){const kind=+$('authKind').value;$('workflow').style.display=kind===4?'block':'none';$('simpleCredentials').style.display=kind>0&&kind!==4?'block':'none';$('singleSecretLabel').style.display=[1,2,3].includes(kind)?'grid':'none';$('basicSecretUsername').parentElement.style.display=kind===5?'grid':'none';$('basicSecretPassword').parentElement.style.display=kind===5?'grid':'none';$('keyName').parentElement.style.display=[1,2].includes(kind)?'grid':'none';$('keyLocation').parentElement.style.display=[1,2].includes(kind)?'grid':'none';$('secretRef').parentElement.style.display=kind>0&&kind!==4?'grid':'none';toggleWorkflowFields()}
function toggleWorkflowFields(){
 const json=+$('wfRequestMode').value===1,apply=+$('applyMode').value,password=+$('grantType').value===1;
 const show=(id,visible)=>$(id).closest('label').style.display=visible?'grid':'none';
 ['tokenUrl','grantType','scope','audience'].forEach(id=>show(id,!json));
 show('requestSpec',json);
 document.querySelector('.token-json-help')?.classList.toggle('hidden',!json);
 show('outputHeader',[0,2,4].includes(apply));show('outputPrefix',[0,2].includes(apply));
 show('outputQuery',apply===3);show('basicUsername',apply===1);
 show('workflowUsername',json||password);show('workflowPassword',json||password);
 $('workflowParamRows').parentElement.style.display=json?'none':'';
 $('workflowHeaderRows').parentElement.style.display=json?'none':'';
}
async function saveCurrentApiConnection(){
 const connection=connectionObject();
 if(connection.Auth.Kind===4&&connection.Auth.Workflow.RequestMode===1){
   const source=connection.Auth.Workflow.RequestSpecJson.trim();
   if(!source)throw new Error('Token request JSON is required in API request JSON mode.');
   try{JSON.parse(source)}catch{throw new Error('Token request JSON must be valid JSON.');}
 }
 await post('apiSaveConnection',{connection,secrets:secretValues(connection)});
 const index=connections.findIndex(item=>item.Name===connection.Name);
 if(index<0)connections.push(connection);else connections[index]=connection;
 return connection;
}
// Authentication belongs to the connection, not the endpoint. Save it before
// saving or executing the API so the bridge receives the workflow on screen.
const runWithSavedAuthenticationBase=run;
run=async function(){try{if(!manualJson&&!requestSpec().BaseUrl)await saveCurrentApiConnection();await runWithSavedAuthenticationBase()}catch(error){$('status').textContent='Error';$('responseSummary').textContent=error.message;toast(error.message)}};
window.addEventListener('DOMContentLoaded',()=>{
 ['wfRequestMode','applyMode','grantType'].forEach(id=>$(id).addEventListener('change',toggleWorkflowFields));
 $('saveEndpoint').onclick=async()=>{try{
   const endpoint=endpointObject(),connection=await saveCurrentApiConnection();
   endpoint.ConnectionName=connection.Name;
   await post('apiSaveEndpoint',{endpoint});await load();
   selectEndpoint(endpoints.find(item=>item.ConnectionName===endpoint.ConnectionName&&item.Name===endpoint.Name)||endpoint);
   toast('API and connection authentication saved');
 }catch(error){toast(error.message)}};
  const note=document.createElement('p');note.className='muted';note.textContent='Authentication is shared by APIs on this connection. Save API and Run also save these connection settings. JSON mode uses the URL, body and headers in the token request JSON; workflow credentials remain available for templates.';
  $('workflow').querySelector('summary').after(note);
  const authInfo=document.createElement('div');authInfo.className='api-info-box';authInfo.innerHTML='<strong>Where authentication is stored</strong><p>Authentication settings are stored with this API connection in the QReports user settings. Secret values are stored separately by Secret Manager; saved APIs contain references, not the secret text.</p>';
  $('auth').prepend(authInfo);
  const jsonInfo=document.createElement('details');jsonInfo.className='api-info-box token-json-help';jsonInfo.innerHTML='<summary>How to configure token request JSON</summary><p>Use <code>Connection</code> to reuse a saved connection, or <code>BaseUrl</code> for a standalone token request. BaseUrl must be a plain absolute HTTP/HTTPS address. Path is appended to it. If both are present, BaseUrl wins and saved headers/authentication are not inherited.</p><pre>{\n  "Type": "api",\n  "BaseUrl": "https://api.example.com/v2/",\n  "Method": "POST",\n  "Path": "token/session",\n  "BodyMode": 1,\n  "ContentType": "application/json",\n  "Body": "{\\"refreshToken\\":\\"{{secret:RefreshToken}}\\"}"\n}</pre><p>Set Token JSON path to the response property containing the token, for example <code>value.token</code>. Keep real keys in Secrets and reference them as <code>{{secret:Name}}</code>.</p>';
  $('requestSpec').closest('label').before(jsonInfo);
  toggleWorkflowFields();
});
function flattenCandidates(value,path='',out=[]){if(Array.isArray(value)){const sample=value.find(item=>item!=null);out.push({path:path||'$',fields:sample&&typeof sample==='object'&&!Array.isArray(sample)?Object.keys(sample):[]});if(sample&&typeof sample==='object')flattenCandidates(sample,path,out)}else if(value&&typeof value==='object'){if(path)out.push({path,fields:Object.keys(value)});for(const [key,child] of Object.entries(value))flattenCandidates(child,path?`${path}.${key}`:key,out)}return [...new Map(out.map(item=>[item.path,item])).values()]}
function openPathPicker(){let value;try{value=JSON.parse(lastRaw)}catch{return toast('Send a request with a JSON response first.')}const candidates=flattenCandidates(value);if(!candidates.length)return toast('No JSON arrays or objects were found.');const current=$('flattenPath').value||candidates[0].path;pathSelection={candidates,selected:candidates.some(x=>x.path===current)?current:candidates[0].path};$('pathList').innerHTML=candidates.map(item=>`<div class="path-group"><label><input type="radio" name="flattenCandidate" value="${esc(item.path)}" ${item.path===pathSelection.selected?'checked':''}> ${esc(item.path)} ${item.fields.length?'[object/array]':''}</label>${item.fields.length?`<div class="path-fields">${item.fields.map(field=>`<label><input type="checkbox" data-path-field="${esc(item.path)}" value="${esc(field)}" checked> ${esc(field)}</label>`).join('')}</div>`:''}</div>`).join('');$('pathList').querySelectorAll('[name=flattenCandidate]').forEach(input=>input.onchange=()=>pathSelection.selected=input.value);$('pathModal').classList.remove('hidden')}
function applyPathPicker(){if(!pathSelection)return;$('flattenPath').value=pathSelection.selected==='$'?'':pathSelection.selected;const group=[...$('pathList').querySelectorAll('.path-group')].find(node=>node.querySelector('[name=flattenCandidate]')?.value===pathSelection.selected),unchecked=group?[...group.querySelectorAll('[data-path-field]:not(:checked)')].map(x=>x.value):[];const selectedFields=group?[...group.querySelectorAll('[data-path-field]:checked')].map(x=>x.value):[];$('excluded').value=formatColumnList(unchecked);$('pathModal').classList.add('hidden');toast(`Flatten path selected${selectedFields.length?` · ${selectedFields.length} columns`:''}`)}
function availableResponseColumns(){const grid=(resultView.data.columns||[]).map(columnName).filter(Boolean);if(grid.length)return [...new Set(grid)];try{const candidates=flattenCandidates(JSON.parse(lastRaw)),wanted=$('flattenPath').value||'$';return [...new Set((candidates.find(item=>item.path===wanted)||candidates.find(item=>item.path==='$')||candidates[0]||{}).fields||[])]}catch{return[]}}
function openExcludedPicker(){const columns=availableResponseColumns();if(!columns.length)return toast('Send a request first to choose response columns.');const excluded=new Set(parseColumnList($('excluded').value,columns)),modal=document.createElement('div');modal.className='modal';modal.innerHTML=`<div class="modal-card path-card"><div class="modal-head"><div><h2>Choose excluded columns</h2><p>Checked columns will be omitted from the API result.</p></div><button type="button" data-close>×</button></div><div class="path-tree">${columns.map(name=>`<label><input type="checkbox" value="${esc(name)}" ${excluded.has(name)?'checked':''}> ${esc(name)}</label>`).join('')}</div><div class="modal-actions"><button type="button" class="primary" data-apply>Apply selection</button><button type="button" data-close>Cancel</button></div></div>`;document.body.append(modal);modal.querySelectorAll('[data-close]').forEach(button=>button.onclick=()=>modal.remove());modal.querySelector('[data-apply]').onclick=()=>{$('excluded').value=formatColumnList([...modal.querySelectorAll('input:checked')].map(input=>input.value));modal.remove();toast('Excluded columns updated')};}
function setupExcludedPicker(){const input=$('excluded');if(!input||$('pickExcluded'))return;const wrap=document.createElement('div');wrap.className='input-button';input.before(wrap);wrap.append(input);wrap.insertAdjacentHTML('beforeend','<button id="pickExcluded" type="button">Choose…</button>');$('pickExcluded').onclick=openExcludedPicker;}
function setupLayout(){const main=$('workspaceMain'),workspace=document.querySelector('.workspace'),saved=JSON.parse(localStorage.getItem('qreports-api-layout')||'{}');if(saved.left)main.style.setProperty('--left-pane',`${saved.left}px`);if(saved.right)main.style.setProperty('--right-pane',`${saved.right}px`);if(saved.response)workspace.style.setProperty('--response-size',`${saved.response}px`);main.classList.toggle('left-hidden',!!saved.leftHidden);main.classList.toggle('right-hidden',!!saved.rightHidden);const persist=()=>localStorage.setItem('qreports-api-layout',JSON.stringify({left:parseFloat(getComputedStyle(main).getPropertyValue('--left-pane'))||260,right:parseFloat(getComputedStyle(main).getPropertyValue('--right-pane'))||280,response:document.querySelector('.response').getBoundingClientRect().height,leftHidden:main.classList.contains('left-hidden'),rightHidden:main.classList.contains('right-hidden')}));$('collapseLeft').onclick=()=>{main.classList.add('left-hidden');persist()};$('collapseRight').onclick=()=>{main.classList.add('right-hidden');persist()};const dragColumn=(handle,side)=>handle.addEventListener('pointerdown',event=>{event.preventDefault();const hidden=side==='left'?main.classList.contains('left-hidden'):main.classList.contains('right-hidden');if(hidden){main.classList.remove(side==='left'?'left-hidden':'right-hidden');persist();return}handle.setPointerCapture(event.pointerId);handle.classList.add('dragging');document.body.classList.add('resizing');const move=e=>{const bounds=main.getBoundingClientRect(),size=side==='left'?e.clientX-bounds.left:bounds.right-e.clientX;main.style.setProperty(side==='left'?'--left-pane':'--right-pane',`${Math.max(170,Math.min(520,size))}px`)};const stop=()=>{handle.classList.remove('dragging');document.body.classList.remove('resizing');handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',stop);handle.removeEventListener('pointercancel',stop);persist()};handle.addEventListener('pointermove',move);handle.addEventListener('pointerup',stop);handle.addEventListener('pointercancel',stop)});dragColumn($('leftResize'),'left');dragColumn($('rightResize'),'right');$('responseResize').addEventListener('pointerdown',event=>{event.preventDefault();const handle=$('responseResize');handle.setPointerCapture(event.pointerId);handle.classList.add('dragging');document.body.classList.add('resizing-rows');const move=e=>{const bounds=workspace.getBoundingClientRect(),head=document.querySelector('.response-head').getBoundingClientRect().height,size=bounds.bottom-e.clientY-head;workspace.style.setProperty('--response-size',`${Math.max(140,Math.min(bounds.height-230,size))}px`)};const stop=()=>{handle.classList.remove('dragging');document.body.classList.remove('resizing-rows');handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',stop);handle.removeEventListener('pointercancel',stop);persist()};handle.addEventListener('pointermove',move);handle.addEventListener('pointerup',stop);handle.addEventListener('pointercancel',stop)})}
function bind(){document.querySelectorAll('#requestTabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#requestTabs button,.request-panels .panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');$(b.dataset.panel).classList.add('active')});document.querySelectorAll('#responseTabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#responseTabs button,.response-panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');$(b.dataset.response).classList.add('active')});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>addRow(b.dataset.add));$('bodyMode').onchange=toggleBody;$('authKind').onchange=toggleAuth;$('search').oninput=renderLibrary;$('connection').onchange=()=>selectConnection(connections.find(c=>c.Name===$('connection').value));$('reload').onclick=load;$('newRequest').onclick=newRequest;$('run').onclick=run;$('secrets').onclick=()=>chrome.webview.postMessage({type:'openConnectionsWindow'});$('formatBody').onclick=()=>{const target=+$('bodyMode').value===2?$('variables'):$('bodyText');try{target.value=JSON.stringify(JSON.parse(target.value),null,2)}catch{toast('The selected body is not valid JSON.')}};$('saveConnection').onclick=async()=>{try{await post('apiSaveConnection',{connection:connectionObject()});toast('Connection saved');await load()}catch(e){toast(e.message)}};$('saveEndpoint').onclick=async()=>{try{await post('apiSaveEndpoint',{endpoint:endpointObject()});toast('API saved');await load()}catch(e){toast(e.message)}};$('deleteConnection').onclick=async()=>{if(!confirm('Delete this API connection and its saved APIs?'))return;await post('apiDeleteConnection',{name:$('connectionName').value});newRequest();await load()};$('deleteEndpoint').onclick=async()=>{if(!confirm('Delete this saved API?'))return;await post('apiDeleteEndpoint',{connectionName:$('connection').value,name:$('endpointName').value});newRequest();await load()};$('testToken').onclick=async()=>{try{const r=await post('apiTestToken',{connection:connectionObject()});toast(r.message)}catch(e){toast(e.message)}};$('pickPath').onclick=openPathPicker;$('applyPath').onclick=applyPathPicker;$('closePath').onclick=$('cancelPath').onclick=()=>$('pathModal').classList.add('hidden');$('returnExcel').onclick=()=>{if(typeof apiReturnOverwritesDefinition!=='undefined'&&apiReturnOverwritesDefinition&&!confirm('The active Excel report definition will be overwritten. Continue?'))return;chrome.webview.postMessage({type:'apiReturnExcel',spec:spec()})};$('close').onclick=()=>chrome.webview.postMessage({type:'closeWindow'});document.addEventListener('pointerdown',event=>{if(!event.target.closest('#columnMenu'))hideColumnMenu()});setRows('queryRows');setRows('headerRows');setRows('formRows');toggleBody();toggleAuth();setupLayout()}
// Output actions and deliberate, same-origin API drill-down navigation.
(() => {
  const history=[];
  let outputMenu=null;
  const back=document.createElement('button');back.id='apiBack';back.textContent='← Back';back.hidden=true;
  $('run').before(back);
  for(const id of ['queryRows','headerRows']){
    const rows=$(id),group=rows.parentElement,details=document.createElement('details'),summary=document.createElement('summary');
    summary.textContent=group.querySelector('h3').textContent;
    group.querySelector('h3').remove();details.append(summary,...group.childNodes);group.append(details);
  }
  function closeMenu(){outputMenu?.remove();outputMenu=null;}
  const responseUrlPattern=/https?:\/\/[^\s<>"']+|(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}(?::\d+)?\/[^\s<>"']*/gi;
  function linkValue(event){const link=event.target.closest('[data-api-url]');if(link)return link.dataset.apiUrl;const selection=window.getSelection()?.toString().trim();const text=selection||event.target.closest('td')?.textContent||'';return text.match(responseUrlPattern)?.[0]||text.match(/^\/[^\s<>"']+$/)?.[0]||'';}
  function drill(url){
    try{
      if(manualJson)throw new Error('Turn Manual JSON off before navigating to a response link.');
      const base=new URL($('baseUrl').value);
      // A bare host/path is an absolute address, not a path below BaseUrl.
      const hostPath=/^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}(?::\d+)?\//i.test(url);
      const target=new URL(hostPath?`${base.protocol}//${url}`:url,base);
      if(!['http:','https:'].includes(target.protocol)||target.origin!==base.origin)throw new Error('Only links on the current API origin can reuse this connection.');
      const prefix=base.pathname.replace(/\/$/,'');
      if(prefix&&target.pathname!==prefix&&!target.pathname.startsWith(prefix+'/'))throw new Error('This link is outside the current API base path.');
      if(!confirm(`Open this GET request for review?\n\n${target.href}\n\nIt will not be sent automatically.`))return;
      history.push({endpoint:structuredClone(endpointObject()),raw:lastRaw,data:structuredClone(resultView.data),submitted:$('submitted').textContent,json:$('jsonRequest').textContent,summary:$('responseSummary').textContent,panel:document.querySelector('.response-panel.active')?.id||'grid'});
      $('method').value='GET';$('path').value=prefix?target.pathname.slice(prefix.length):target.pathname;setRows('queryRows',[...target.searchParams].map(([Key,Value])=>({Enabled:true,Key,Value})));
      $('bodyMode').value='0';toggleBody();setPaging({});setLoop({});
      back.hidden=false;$('status').textContent='Review request, then Send';$('path').focus();
    }catch(error){toast(error.message);}
  }
  back.onclick=()=>{const previous=history.pop();if(!previous)return;selectEndpoint(previous.endpoint);lastRaw=previous.raw;$('raw').textContent=formatMaybe(lastRaw);setResult(previous.data);$('submitted').textContent=previous.submitted;$('jsonRequest').textContent=previous.json;$('responseSummary').textContent=previous.summary;selectResponse(previous.panel);back.hidden=!history.length;$('status').textContent='Ready';};
  for(const id of ['raw','grid']){
    const panel=$(id),observer=new MutationObserver(()=>{
      observer.disconnect();
      for(const element of id==='grid'?panel.querySelectorAll('td'):[panel]){
        if(element.querySelector('[data-api-url]'))continue;
        const text=element.textContent,matches=[...text.matchAll(responseUrlPattern)];if(!matches.length)continue;
        const fragment=document.createDocumentFragment();let offset=0;
        for(const match of matches){fragment.append(document.createTextNode(text.slice(offset,match.index)));const link=document.createElement('a');link.textContent=match[0];link.href=match[0];link.dataset.apiUrl=match[0];link.title='Open as API request for review';link.onclick=event=>{event.preventDefault();drill(link.dataset.apiUrl);};fragment.append(link);offset=match.index+match[0].length;}
        fragment.append(document.createTextNode(text.slice(offset)));element.replaceChildren(fragment);
      }
      observer.observe(panel,{childList:true,subtree:true});
    });
    observer.observe(panel,{childList:true,subtree:true});
  }
  document.addEventListener('pointerdown',event=>{if(!event.target.closest('.api-output-menu'))closeMenu();});
  document.querySelector('.response').addEventListener('contextmenu',event=>{
    const panel=event.target.closest('.response-panel');if(!panel)return;
    // Keep the existing column-specific menu on table headers.
    if(event.target.closest('th'))return;
    event.preventDefault();event.stopPropagation();closeMenu();
    const url=linkValue(event),selection=window.getSelection()?.toString()||event.target.closest('td')?.textContent||'';
    outputMenu=document.createElement('div');outputMenu.className='api-output-menu';
    const add=(label,action)=>{const button=document.createElement('button');button.textContent=label;button.onclick=async()=>{closeMenu();try{await action();}catch(error){toast(error.message);}};outputMenu.append(button);};
    add('Copy details',()=>navigator.clipboard.writeText(selection||panel.innerText));
    add('Copy all',()=>navigator.clipboard.writeText(panel.id==='grid'?JSON.stringify(resultView.data,null,2):panel.textContent));
    add('Clear this view',()=>{if(panel.id==='grid')setResult({columns:[],rows:[]});else{panel.textContent='';if(panel.id==='raw')lastRaw='';}});
    if(url)add('Open as API request…',()=>drill(url));
    document.body.append(outputMenu);const rect=outputMenu.getBoundingClientRect();outputMenu.style.left=`${Math.max(4,Math.min(event.clientX,innerWidth-rect.width-4))}px`;outputMenu.style.top=`${Math.max(4,Math.min(event.clientY,innerHeight-rect.height-4))}px`;
  });
})();
