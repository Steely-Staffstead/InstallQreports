chrome.webview.addEventListener('message',event=>{
  const message=event.data;
  if(message.type==='apiWorkspaceContext')$('returnExcel').textContent=message.returnTarget==='query'?'Return to Query Tool':'Return to Excel';
});
let loopConnectionNames=[];
function syncLoopConnection(){
  if(($('pagingEnabled').checked||$('loopEnabled').checked)&&!$('loopConnection').value.trim())$('loopConnection').value=loopConnectionNames[0]||$('connection').value;
}
$('pagingEnabled').addEventListener('change',syncLoopConnection);
$('loopEnabled').addEventListener('change',syncLoopConnection);
$('connection').addEventListener('change',syncLoopConnection);
$('designLoopQuery').addEventListener('click',async()=>{
  try{
    const result=await post('apiDesignLoopQuery',{query:{connectionName:$('loopConnection').value||$('connection').value,queryText:$('loopQuery').value,previewLimit:1000,measures:[],parameters:[],data:{columns:[],rows:[]}}});
    if(result.query){$('loopConnection').value=result.query.connectionName||$('loopConnection').value;$('loopQuery').value=result.query.queryText||'';}
  }catch(error){if(!/cancel/i.test(error.message))toast(error.message);}
});
const loopList=document.createElement('datalist');loopList.id='loopConnections';document.body.append(loopList);$('loopConnection').setAttribute('list',loopList.id);
post('queryConnections').then(result=>{
  loopConnectionNames=(result.connections||[]).filter(item=>String(item.kind||'').toLowerCase()!=='api').map(item=>item.name);
  loopList.innerHTML=loopConnectionNames.map(name=>`<option value="${esc(name)}"></option>`).join('');syncLoopConnection();
}).catch(()=>{});
