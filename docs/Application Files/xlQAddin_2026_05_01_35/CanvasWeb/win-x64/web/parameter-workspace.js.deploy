let parameters=[],lookupSequence=0,lookups=new Map(),workspaceLoaded=false,readyTimer=null,lookupDesigner=null;
function post(type,payload={}){chrome.webview.postMessage({type,...payload})}
function openInput(){ParameterWeb.openInput({parameters,lookup:parameter=>new Promise((resolve,reject)=>{const requestId=`lookup-${++lookupSequence}`;lookups.set(requestId,{resolve,reject});post('parameterLookup',{requestId,query:{parameters},parameter})}),onDesignLookup:query=>new Promise((resolve,reject)=>{lookupDesigner={resolve,reject};post('parameterDesignLookup',{query})}),onManage:items=>{parameters=items;openInput()},onManagerCancel:()=>openInput(),onApply:(items,refresh)=>{parameters=items;post('parameterApply',{parameters,refresh})},onCancel:()=>post('parameterCancel')})}
chrome.webview.addEventListener('message',event=>{const message=event.data;if(message.type==='loadParameterWorkspace'){if(workspaceLoaded)return;workspaceLoaded=true;clearInterval(readyTimer);document.getElementById('parameterLoading')?.remove();parameters=message.parameters||[];openInput()}else if(message.type==='bridgeResult'&&message.action==='parameter-lookup'){const pending=lookups.get(message.requestId);if(!pending)return;lookups.delete(message.requestId);if(!message.result?.ok)return pending.reject(new Error(message.result?.error||'Lookup failed'));const data=message.result.data||{},columns=data.columns||[],rows=data.rows||[],vi=Math.max(0,columns.findIndex(x=>String(x).toLowerCase()===String(message.result.valueColumn||'').toLowerCase())),di=Math.max(0,columns.findIndex(x=>String(x).toLowerCase()===String(message.result.displayColumn||'').toLowerCase()));pending.resolve(rows.map(row=>({value:row[vi],display:row[di]})))}else if(message.type==='bridgeResult'&&message.action==='edit-query'&&lookupDesigner){const pending=lookupDesigner;lookupDesigner=null;message.result?.ok?pending.resolve(message.result.query):pending.reject(new Error(message.result?.error||'Query designer was cancelled'))}else if(message.type==='hostError')alert(message.message)});
window.addEventListener('DOMContentLoaded',()=>{post('ready');readyTimer=setInterval(()=>{if(workspaceLoaded)clearInterval(readyTimer);else post('ready')},500)});
