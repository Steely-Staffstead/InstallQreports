            ],
            "maxRows": 5000,
            "useFilteredContext": true,
            "bindings": []
          },
          "htmlDocument": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\n  :root{--bg:#f4f8f2;--ink:#203528;--accent:#4d7b55;--grid:#c9d9c5;--soft:#e2ecdf;--positive:#2f7d50;--negative:#b64b4b}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 Segoe UI,system-ui,sans-serif}main{padding:38px}h1{font-size:32px;margin:0 0 5px}.sub{color:#627067;margin:0 0 28px}.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin:20px 0 28px}.kpi,.panel,.stage{background:#fff;border:1px solid var(--grid);border-radius:14px;padding:18px}.kpi b{display:block;font-size:30px}.kpi span,.muted{color:#6b786e}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}.stage h2,.panel h2{font-size:18px;margin:0 0 12px}.card{border-left:5px solid var(--accent);background:#f9fbf8;border-radius:8px;padding:12px;margin:9px 0}.card b{display:block}.value{font-variant-numeric:tabular-nums}.bar{height:11px;background:var(--soft);border-radius:8px;overflow:hidden;margin-top:9px}.bar i{display:block;height:100%;background:var(--accent)}table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden}th,td{text-align:left;padding:12px;border-bottom:1px solid var(--grid)}th{background:var(--soft)}.badge{display:inline-block;padding:3px 9px;border-radius:12px;background:var(--soft);font-size:13px}.positive{color:var(--positive)}.negative{color:var(--negative)}@media(max-width:700px){main{padding:20px}}\n  </style></head><body><main><h1>Tender pipeline</h1><p class=\"sub\">Fictional sample data — replace or extend the embedded table to start working.</p><section class=\"kpis\"><div class=\"kpi\"><b>5</b><span>Active opportunities</span></div><div class=\"kpi\"><b>8.1m</b><span>Total pipeline</span></div><div class=\"kpi\"><b>61%</b><span>Weighted confidence</span></div><div class=\"kpi\"><b>1</b><span>Due this week</span></div></section><section class=\"grid\"><div class=\"stage\"><h2>Lead</h2><div class=\"card\"><b>Service contract North</b><span class=\"muted\">680k · Jon</span></div></div><div class=\"stage\"><h2>Qualification</h2><div class=\"card\"><b>Municipal energy upgrade</b><span class=\"muted\">1.85m · Eva</span></div></div><div class=\"stage\"><h2>Proposal</h2><div class=\"card\"><b>Office refurbishment</b><span class=\"muted\">920k · Jon</span></div></div><div class=\"stage\"><h2>Review / Won</h2><div class=\"card\"><b>Framework agreement 2027</b><span class=\"muted\">3.4m · Sara</span></div><div class=\"card\"><b>School ventilation</b><span class=\"muted\">Won · 1.25m</span></div></div></section></main></body></html>"
        }
      ]
